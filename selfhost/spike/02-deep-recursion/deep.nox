# Aşama 0.8 deneyi: derleyici türü derin özyineleme. `Node` bir AST düğümünü taklit eder (sol çocuk zinciri = derin iç içe ifade).
class Node:
    kid: Node | None
    other: Node | None
    v: int

    def __init__(self, v: int, kid: Node | None) -> None:
        self.v = v
        self.kid = kid
        self.other = None

# İki çocuklu özyinelemeli yürüyüş: LLVM bunu döngüye çeviremez (parser/checker'ın ifade ağacı yürüyüşü gibi).
def sh_depth(n: Node | None) -> int:
    if n is None:
        return 0
    a: int = sh_depth(n.kid)
    b: int = sh_depth(n.other)
    if a > b:
        return a + 1
    return b + 1

# `n` düğümlük zinciri yinelemeli kurar, özyinelemeli yürür, sonra kaldırır (serbest bırakma özyinelemesi dahil).
def sh_chain(n: int) -> int:
    head: Node | None = None
    for i in range(n):
        head = Node(i, head)
    d: int = sh_depth(head)
    head = None
    return d

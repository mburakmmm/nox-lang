# Yeniden üretmek için: scripts/gen_selfhost_parser.py   (güncel mi: --check)
# noxc-nightly Aşama 3: Nox tip denetleyicisi (compiler/typecheck/checker.zig'in portu). Bu dosya ŞABLONDUR: `scripts/gen_selfhost_parser.py` K/T/O/E/SZ yer tutucularını doldurup
# `selfhost/typecheck.nox`u yazar (elle düzenlenen kaynak BU dosyadır).
#
# Durum: 3.2 (kapsam/sembol tabloları). Tip temsili `types.nox` (TypeId/SymbolId, hash-consing). Ad = SymbolId, tip = TypeId; `dict[str, T]` yerine tamsayı anahtarlı düz tablolar
# (R2-G.1/G.2: dize anahtarlı sözlük ≈6× pahalı). Tablolar tek `Ck` nesnesindedir; kapsamlar derleme boyunca yaşar (Zig'in arena'sı gibi; tek tek serbest bırakılmaz).
from ast_schema import Ast, at, dump_module, mk_fail, put
from ast_schema import build_sp_idx, loaded_ast
from parser import pk, pkx, pky, parse_ast, parse_body, sref_eq, sref_len, sref_byte, utf8_bytes
from types import TT, ty_global, tat, sym_hash_step, cls_set_nonarc, cls_set_base, lcg, sym_intern, sym_intern_list, ty_format, ty_mangle, ty_func_begin, ty_func_param, ty_func_end, ty_assignable, fx_fits, fx_signed, ty_mk, ty_list, ty_dict, ty_optional, ty_class, cls_register

# ---- (k1, k2) -> değer tablosu: açık adresleme, ekleme sırası korunur, silme = ölü işareti (yeniden `put` canlandırır) ----
class Map2:
    slots: list[int]
    mask: int
    k1: list[int]
    k2: list[int]
    vv: list[int]
    dead: list[int]
    live: int

    def __init__(self) -> None:
        self.slots = []
        self.mask = 255
        for i in range(256):
            self.slots.append(0)
        self.k1 = []
        self.k2 = []
        self.vv = []
        self.dead = []
        self.live = 0

def m2_hash(k1: int, k2: int) -> int:
    return sym_hash_step(sym_hash_step(1469598103, k1), k2)

# Anahtarın giriş indeksi (ölü olsa da) ya da -1.
def m2_find(m: Map2, k1: int, k2: int) -> int:
    i: int = m2_hash(k1, k2) & m.mask
    while True:
        s: int = m.slots[i]
        if s == 0:
            return -1
        e: int = s - 1
        if m.k1[e] == k1 and m.k2[e] == k2:
            return e
        i = (i + 1) & m.mask
    return -1

# CANLI girişin indeksi ya da -1.
def m2_get(m: Map2, k1: int, k2: int) -> int:
    e: int = m2_find(m, k1, k2)
    if e >= 0 and m.dead[e] == 0:
        return e
    return -1

def m2_grow(m: Map2) -> None:
    cap: int = (m.mask + 1) * 2
    m.mask = cap - 1
    m.slots = []
    for i in range(cap):
        m.slots.append(0)
    for e in range(len(m.k1)):
        j: int = m2_hash(m.k1[e], m.k2[e]) & m.mask
        while m.slots[j] != 0:
            j = (j + 1) & m.mask
        m.slots[j] = e + 1

def m2_put(m: Map2, k1: int, k2: int, v: int) -> None:
    e: int = m2_find(m, k1, k2)
    if e >= 0:
        m.vv[e] = v
        if m.dead[e] != 0:
            m.dead[e] = 0
            m.live = m.live + 1
        return
    i: int = m2_hash(k1, k2) & m.mask
    while m.slots[i] != 0:
        i = (i + 1) & m.mask
    ne: int = len(m.k1)
    m.k1.append(k1)
    m.k2.append(k2)
    m.vv.append(v)
    m.dead.append(0)
    m.slots[i] = ne + 1
    m.live = m.live + 1
    if len(m.k1) * 2 > m.mask + 1:
        m2_grow(m)

def m2_remove(m: Map2, k1: int, k2: int) -> bool:
    e: int = m2_find(m, k1, k2)
    if e >= 0 and m.dead[e] == 0:
        m.dead[e] = 1
        m.live = m.live - 1
        return True
    return False

# ---- denetleyici durumu ----
class Ck:
    tt: TT
    # kapsamlar (Zig `Scope`): `sp` = üst kapsam (-1 yok), `sc` = yakalama kümesi kimliği (-1: kayıt yok; yalnız iç içe `def` kapsamında dolu)
    sp: list[int]
    sc: list[int]
    ncaps: int
    vars: Map2
    caps: Map2
    # modül düzeyi: `module_globals` (ad -> bildirilen tip), `module_int_consts` (ad -> değer)
    globs: Map2
    iconsts: Map2
    top_scope: int
    # `declare_var` uyuşmazlığında önceki tip (hata iletisi için)
    e_prev: int
    # 3.3: işlev tablosu (ad -> indeks), parametre tipi havuzu, dönüş tipi
    fmap: Map2
    afn: Map2
    fpar: list[int]
    fps: list[int]
    fpn: list[int]
    fret: list[int]
    fpnm: list[int]
    # 3.3: tanılama durumu (`Checker.current_line/current_span/diagnostic/diagnostics`)
    cur_line: int
    cur_span: int
    mb: list[int]
    diag_msg: list[int]
    err_code: str
    dcode: list[str]
    dline: list[int]
    dspan: list[int]
    doff: list[int]
    dlen: list[int]
    dbytes: list[int]
    depth: int
    out: list[int]
    o_code: str
    o_msg: list[int]
    why: str
    cv: int
    # 3.4a: sınıf tabloları (sig kimlikleri `fps/fpn/fret/fpnm` dizilerindedir; işlev ve metod imzaları ortak)
    cls_map: Map2
    cls_sym: list[int]
    cls_node: list[int]
    cls_init: list[int]
    cls_fields: Map2
    cls_meths: Map2
    cls_unas: Map2
    sig_empty: int
    # 3.12: import tabloları (Zig `imported_modules`/`module_aliases`/`from_imports`/`from_imports_orig_name`); anahtar (0, sembol)
    imod: Map2
    alias: Map2
    alp: list[int]
    fimp: Map2
    forig: Map2
    # 3.4b: tekli kalıtım — çözülmüş taban sembolü (-1 yok), imza kaydı durumu (0/1 işleniyor/2 tamam), gövde denetlendi bayrağı
    cls_base: list[int]
    cls_regd: list[int]
    cls_chk: list[int]
    # 3.6a: tuple sınıfı eleman tipleri (cls_sym ile 1:1; -1 = normal sınıf) + comprehension derinliği
    tup_s: list[int]
    tup_n: list[int]
    tup_e: list[int]
    comp_depth: int

    def __init__(self, tt: TT) -> None:
        self.tt = tt
        self.sp = []
        self.sc = []
        self.ncaps = 0
        self.vars = Map2()
        self.caps = Map2()
        self.globs = Map2()
        self.iconsts = Map2()
        self.top_scope = -1
        self.e_prev = -1
        self.fmap = Map2()
        self.afn = Map2()
        self.fpar = []
        self.fps = []
        self.fpn = []
        self.fret = []
        self.fpnm = []
        self.cur_line = 0
        self.cur_span = -1
        self.mb = []
        self.diag_msg = []
        self.err_code = ""
        self.dcode = []
        self.dline = []
        self.dspan = []
        self.doff = []
        self.dlen = []
        self.dbytes = []
        self.depth = 0
        self.out = []
        self.o_code = ""
        self.o_msg = []
        self.why = ""
        self.cv = 0
        self.cls_map = Map2()
        self.cls_sym = []
        self.cls_node = []
        self.cls_init = []
        self.cls_fields = Map2()
        self.cls_meths = Map2()
        self.cls_unas = Map2()
        self.sig_empty = -1
        self.imod = Map2()
        self.alias = Map2()
        self.alp = []
        self.fimp = Map2()
        self.forig = Map2()
        self.cls_base = []
        self.cls_regd = []
        self.cls_chk = []
        self.tup_s = []
        self.tup_n = []
        self.tup_e = []
        self.comp_depth = 0

# ---- Scope (Zig `Scope`) ----
def sc_new(ck: Ck, parent: int, has_caps: bool) -> int:
    id: int = len(ck.sp)
    ck.sp.append(parent)
    if has_caps:
        ck.sc.append(ck.ncaps)
        ck.ncaps = ck.ncaps + 1
    else:
        ck.sc.append(-1)
    return id

def sc_declare(ck: Ck, scope: int, sym: int, ty: int) -> None:
    m2_put(ck.vars, scope, sym, ty)

# Yalnızca bu kapsam (üst zincire DÜŞMEZ): TypeId ya da -1.
def sc_lookup_local(ck: Ck, scope: int, sym: int) -> int:
    e: int = m2_get(ck.vars, scope, sym)
    if e < 0:
        return -1
    return ck.vars.vv[e]

# Üst zincire düşer; bulunursa ve kapsamın yakalama kümesi varsa adı (ilk karşılaşmada) yakalama olarak kaydeder (zincirdeki her ara kapsam da kendi kaydını yapar).
def sc_lookup(ck: Ck, scope: int, sym: int) -> int:
    e: int = m2_get(ck.vars, scope, sym)
    if e >= 0:
        return ck.vars.vv[e]
    p: int = ck.sp[scope]
    if p >= 0:
        t: int = sc_lookup(ck, p, sym)
        if t >= 0:
            cs: int = ck.sc[scope]
            if cs >= 0 and m2_get(ck.caps, cs, sym) < 0:
                m2_put(ck.caps, cs, sym, t)
            return t
    return -1

# `lookup` ile aynı zincir, yan etkisiz (yakalama kaydı yok).
def sc_exists(ck: Ck, scope: int, sym: int) -> bool:
    if m2_get(ck.vars, scope, sym) >= 0:
        return True
    p: int = ck.sp[scope]
    if p >= 0:
        return sc_exists(ck, p, sym)
    return False

# `Checker.declareVar` (v1.148.0): aynı kapsamda FARKLI tiple yeniden bildirimi reddeder. 0 = bildirildi, 1 = uyuşmazlık (`ck.e_prev` = önceki tip; ileti 3.13'te biçimlenir).
def declare_var(ck: Ck, scope: int, sym: int, ty: int) -> int:
    tt: TT = ck.tt
    ex: int = sc_lookup_local(ck, scope, sym)
    if ex >= 0:
        both_classes: bool = False
        if tt.tag[ex] == 6 and tt.tag[ty] == 6:
            if tt.xa[ex] == tt.xa[ty]:
                both_classes = True
            elif tt.cnonarc[tt.xa[ex]] == 0 and tt.cnonarc[tt.xa[ty]] == 0:
                both_classes = True
        if ex != ty and not both_classes:
            ck.e_prev = ex
            return 1
    sc_declare(ck, scope, sym, ty)
    return 0

# ---- AST erişimi (düz dizi; bkz. project/selfhost-ast-tasarimi-2026-11.md) ----
def sl_at(a: Ast, node: int, off: int) -> int:
    return pk(a.n[node + off], a.n[node + off + 1])

# Dize başvurusu `v` (paketli) ham bayt aralığı `base[off:off+n]` ile aynı mı.
def sref_is_bytes(a: Ast, v: int, base: int, off: int, n: int) -> bool:
    x: int = pkx(v)
    ln: int = pky(v)
    if x >= 0:
        ln = ln - x
    if ln != n:
        return False
    for i in range(n):
        c: int = 0
        if x >= 0:
            c = at(a.src, x + i)
        else:
            c = a.sb[0 - x - 1 + i]
        if c != tat(base, off + i):
            return False
    return True

# `Checker.stmtsAssignName`: `name`e modülün herhangi bir yerinde (iç içe bloklar, işlev/metot gövdeleri dahil) atama var mı (muhafazakâr: yerel gölgelemeler dahil).
def stmts_assign_name(a: Ast, s: int, base: int, off: int, n: int) -> bool:
    cnt: int = pky(s)
    for i in range(cnt):
        st: int = a.l[pkx(s) + i]
        kn: int = a.n[st + 0]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == 3:
            tg: int = a.n[pay + 0]
            if a.n[tg] == 5 and sref_is_bytes(a, pk(a.n[tg + 1], a.n[tg + 2]), base, off, n):
                return True
        elif tag == 4:
            if stmts_assign_name(a, sl_at(a, pay, 1), base, off, n):
                return True
            ecs: int = sl_at(a, pay, 3)
            for j in range(pky(ecs)):
                ec: int = a.l[pkx(ecs) + j]
                if stmts_assign_name(a, sl_at(a, ec, 1), base, off, n):
                    return True
            if a.n[pay + 5] != -4611686018427387904:
                if stmts_assign_name(a, sl_at(a, pay, 5), base, off, n):
                    return True
        elif tag == 5:
            if stmts_assign_name(a, sl_at(a, pay, 1), base, off, n):
                return True
        elif tag == 6:
            if sref_is_bytes(a, pk(a.n[pay + 0], a.n[pay + 0 + 1]), base, off, n):
                return True
            if stmts_assign_name(a, sl_at(a, pay, 3), base, off, n):
                return True
        elif tag == 13:
            if stmts_assign_name(a, sl_at(a, pay, 0), base, off, n):
                return True
            exs: int = sl_at(a, pay, 2)
            for k in range(pky(exs)):
                ex: int = a.l[pkx(exs) + k]
                if stmts_assign_name(a, sl_at(a, ex, 4), base, off, n):
                    return True
            if a.n[pay + 4] != -4611686018427387904:
                if stmts_assign_name(a, sl_at(a, pay, 4), base, off, n):
                    return True
        elif tag == 21:
            if stmts_assign_name(a, sl_at(a, pay, 3), base, off, n):
                return True
        elif tag == 14:
            if stmts_assign_name(a, sl_at(a, pay, 0), base, off, n):
                return True
        elif tag == 7:
            if stmts_assign_name(a, sl_at(a, pay, 8), base, off, n):
                return True
        elif tag == 8:
            ms: int = sl_at(a, pay, 16)
            for q in range(pky(ms)):
                m: int = a.l[pkx(ms) + q]
                if stmts_assign_name(a, sl_at(a, m, 8), base, off, n):
                    return True
    return False

# =====================================================================================================================
# 3.3 dilim A: skaler tipli ifade/deyimler + kullanıcı işlevleri (Zig `checkStmt/checkExprInner/checkBinary/checkExprExpected/checkFunctionBody/registerFunc`)
# Kapsam dışı HER yapı `CkUnsupported` fırlatır (durum 2): sonuç Zig ile karşılaştırılmaz, farksal test yalnızca desteklenen programlarda tam eşitlik ister. Kapsam büyüdükçe atlanan sayısı 0'a iner.
# =====================================================================================================================
class CkErr(Exception):
    pass

class CkUnsupported(Exception):
    pass

# İşlev gövdesi bağlamı (Zig `FnCtx`in bu dilimde kullanılan alanları). `ret` = -1: modül düzeyi (`expected_return == null`).
class Fx:
    scope: int
    ret: int
    loop: int
    in_async: bool
    self_cls: int
    is_init: bool
    # `awaited_callee`: o an `await` operandı olan çağrının callee düğümü (-1 yok); `ch.send/recv` yalnız bu bağlamda geçerli
    awaited: int
    # `in_lowlevel_depth`: `lowlevel:` iç içe derinliği
    ll_depth: int

    def __init__(self, scope: int, ret: int, in_async: bool) -> None:
        self.awaited = -1
        self.ll_depth = 0
        self.scope = scope
        self.ret = ret
        self.loop = 0
        self.in_async = in_async
        self.self_cls = -1
        self.is_init = False

# `why`: kapsam dışı nedeninin kısa etiketi (işlev adı#sıra); `ck-diff check --why` histogram basar.
def unsup(ck: Ck, why: str) -> CkUnsupported:
    ck.why = why
    return CkUnsupported("")

# ---- ileti oluşturma (`Checker.fail`) ----
def mp(ck: Ck, s: str) -> None:
    bs: list[int] = utf8_bytes(s)
    for i in range(len(bs)):
        ck.mb.append(bs[i])

def mp_int(ck: Ck, v: int) -> None:
    mp(ck, str(v))

def mp_sym(ck: Ck, sym: int) -> None:
    tt: TT = ck.tt
    o: int = tt.so[sym]
    for i in range(tt.sl[sym]):
        ck.mb.append(tt.sb[o + i])

def mp_sref(ck: Ck, a: Ast, v: int) -> None:
    n: int = sref_len(v)
    for i in range(n):
        ck.mb.append(sref_byte(a, v, i))

def mp_type(ck: Ck, ty: int) -> None:
    tt: TT = ck.tt
    tt.out = []
    ty_format(tt, ty)
    for i in range(len(tt.out)):
        ck.mb.append(tt.out[i])

# `Checker.fail`: ileti "line N: ..." öneki (current_line > 0) ile saklanır; hata kodu adı (Zig `TypeError`) dize olarak taşınır.
def mk_fail(ck: Ck, code: str) -> CkErr:
    ck.err_code = code
    out: list[int] = []
    if ck.cur_line > 0:
        pre: str = "line " + str(ck.cur_line) + ": "
        for i in range(len(pre)):
            out.append(ord(pre[i]))
    for j in range(len(ck.mb)):
        out.append(ck.mb[j])
    ck.diag_msg = out
    ck.mb = []
    return CkErr("")

# `Checker.recordDiagnostic`: son `fail` iletisini + konumu tanılama listesine ekler.
def record_diag(ck: Ck, a: Ast) -> None:
    ck.dcode.append(ck.err_code)
    ck.dline.append(ck.cur_line)
    ck.doff.append(len(ck.dbytes))
    ck.dlen.append(len(ck.diag_msg))
    for i in range(len(ck.diag_msg)):
        ck.dbytes.append(ck.diag_msg[i])
    sp: int = ck.cur_span
    for k in range(6):
        if sp >= 0:
            ck.dspan.append(a.n[sp + k])
        else:
            ck.dspan.append(0)

# ---- AST yardımcıları ----
def sym_of(ck: Ck, a: Ast, v: int) -> int:
    x: int = pkx(v)
    if x >= 0:
        return sym_intern(ck.tt, a.src, x, pky(v) - x)
    return sym_intern_list(ck.tt, a.sb, 0 - x - 1, pky(v))

def stmt_at(a: Ast, s: int, i: int) -> int:
    return a.l[pkx(s) + i]

def span_of(a: Ast, node: int) -> int:
    if a.sp_idx_n != len(a.sp_ids) or len(a.sp_idx) != len(a.n) + 1:
        build_sp_idx(a)
    if node >= 0 and node < len(a.sp_idx):
        i: int = a.sp_idx[node]
        if i >= 0:
            return a.sp_vals[i]
    return -1

# ---- tip ifadesi -> TypeId (Zig `typeExprToType`in skaler çekirdeği; kalan dallar 3.4/3.6/3.12'de) ----
def type_expr_to_type(ck: Ck, a: Ast, te: int) -> int:
    tag: int = a.n[te]
    tt: TT = ck.tt
    if tag == 1:
        return type_expr_generic(ck, a, a.n[te + 1])
    if tag == 2:
        fp: int = a.n[te + 1]
        ps: int = sl_at(a, fp, 0)
        tys: list[int] = []
        for i in range(pky(ps)):
            tys.append(type_expr_to_type(ck, a, stmt_at(a, ps, i)))
        ret: int = type_expr_to_type(ck, a, a.n[fp + 2])
        ty_func_begin(tt)
        for k in range(len(tys)):
            ty_func_param(tt, tys[k])
        return ty_func_end(tt, ret)
    if tag == 3:
        inner: int = type_expr_to_type(ck, a, a.n[te + 1])
        if inner == 4 or tt.tag[inner] == 15:
            mp(ck, "'None | None' or a nested Optional is invalid")
            raise mk_fail(ck, "UnknownType")
        return ty_optional(tt, inner)
    if tag == 4:
        # `pkg.mod.Sınıf` tip konumunda: takma ad ikamesi + modülün içe aktarıldığı + mangled sınıfın varlığı
        qsegs: list[int] = subst_alias(ck, seg_syms(ck, a, te, 1))
        qn: int = len(qsegs)
        if qn < 2:
            mp(ck, "invalid qualified type name")
            raise mk_fail(ck, "UnknownType")
        qmod: int = join_syms(ck, qsegs, qn - 1, 46)
        if m2_get(ck.imod, 0, qmod) < 0:
            mp(ck, "unknown module: ")
            mp_sym(ck, qmod)
            raise mk_fail(ck, "UnknownType")
        qms: int = join_syms(ck, qsegs, qn, 95)
        if class_idx(ck, qms) >= 0:
            return ty_class(tt, qms)
        mp(ck, "module '")
        mp_sym(ck, qmod)
        mp(ck, "' has no class named '")
        mp_sym(ck, qsegs[qn - 1])
        mp(ck, "'")
        raise mk_fail(ck, "UnknownType")
    if tag != 0:
        raise unsup(ck, "type_expr_to_type#" + str(tag))
    return simple_type(ck, a, pk(a.n[te + 1], a.n[te + 2]))

# `typeExprToType(.{ .simple = ad })`: skaler adlar, sabit-genişlikli türler, kullanıcı sınıfı (`sizeof/alignof/offsetof` de bunu kullanır).
def simple_type(ck: Ck, a: Ast, v: int) -> int:
    tt: TT = ck.tt
    if sref_eq(a, v, "int"):
        return 0
    if sref_eq(a, v, "float"):
        return 1
    if sref_eq(a, v, "bool"):
        return 2
    if sref_eq(a, v, "str"):
        return 3
    if sref_eq(a, v, "None"):
        return 4
    if sref_eq(a, v, "bytes"):
        # v2.2.77: yerleşik `bytes` (bayt tabanlı işlemler/yeniden yazımlar) Nox denetleyicisinde HENÜZ yok → kapsam dışı
        raise unsup(ck, "type#bytes")
    if sref_eq(a, v, "ptr"):
        return 5
    if sref_eq(a, v, "u8"):
        return 6
    if sref_eq(a, v, "u16"):
        return 7
    if sref_eq(a, v, "u32"):
        return 8
    if sref_eq(a, v, "u64"):
        return 9
    if sref_eq(a, v, "usize"):
        return 10
    if sref_eq(a, v, "i8"):
        return 11
    if sref_eq(a, v, "i16"):
        return 12
    if sref_eq(a, v, "i32"):
        return 13
    if sref_eq(a, v, "i64"):
        return 14
    if sref_eq(a, v, "isize"):
        return 15
    # kullanıcı sınıfı (`self.classes.contains`); from-import/protokol tabloları bu dilimde boştur
    if class_idx(ck, sym_of(ck, a, v)) >= 0:
        return ty_class(tt, sym_of(ck, a, v))
    # `from X import Widget`: çıplak ad, mangled sınıfa çözülür (yerel sınıf her zaman öncelikli)
    fie: int = m2_get(ck.fimp, 0, sym_of(ck, a, v))
    if fie >= 0 and class_idx(ck, ck.fimp.vv[fie]) >= 0:
        return ty_class(tt, ck.fimp.vv[fie])
    if sref_eq(a, v, "__infer"):
        raise unsup(ck, "type_expr_to_type#infer")
    mp(ck, "unknown type: ")
    mp_sref(ck, a, v)
    raise mk_fail(ck, "UnknownType")

# `.generic` tip ifadesi: tuple (sınıf sentezi: kapsam dışı), ptr[T], list/Task/Channel/ThreadHandle/ThreadChannel/TaskLocal, dict[K, V].
def type_expr_generic(ck: Ck, a: Ast, g: int) -> int:
    tt: TT = ck.tt
    gn: int = pk(a.n[g + 0], a.n[g + 0 + 1])
    gargs: int = sl_at(a, g, 2)
    n: int = pky(gargs)
    if sref_eq(a, gn, "tuple"):
        if n == 0:
            fail2(ck, "UnknownType", "'tuple' takes at least one type argument")
        ts: list[int] = []
        for ti in range(n):
            ts.append(type_expr_to_type(ck, a, stmt_at(a, gargs, ti)))
        return instantiate_tuple_class(ck, ts)
    if sref_eq(a, gn, "ptr"):
        if n != 1:
            mp(ck, "'ptr' takes exactly one type argument")
            raise mk_fail(ck, "UnknownType")
        pe: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 0))
        return ty_mk(tt, 17, pe, 0)
    tagk: int = -1
    if sref_eq(a, gn, "list"):
        tagk = 5
    elif sref_eq(a, gn, "Task"):
        tagk = 7
    elif sref_eq(a, gn, "Channel"):
        tagk = 8
    elif sref_eq(a, gn, "ThreadHandle"):
        tagk = 9
    elif sref_eq(a, gn, "ThreadChannel"):
        tagk = 10
    elif sref_eq(a, gn, "TaskLocal"):
        tagk = 11
    if tagk >= 0:
        if n != 1:
            mp(ck, "'")
            mp_sref(ck, a, gn)
            mp(ck, "' takes exactly one type argument")
            raise mk_fail(ck, "UnknownType")
        elem: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 0))
        et: int = tt.tag[elem]
        if tagk == 5 and (et == 7 or et == 8 or et == 9 or et == 10 or et == 11):
            mp(ck, "'list[")
            if et == 7:
                mp(ck, "Task")
            elif et == 8:
                mp(ck, "Channel")
            elif et == 9:
                mp(ck, "ThreadHandle")
            elif et == 10:
                mp(ck, "ThreadChannel")
            else:
                mp(ck, "TaskLocal")
            mp(ck, "[...]]' is not supported: tasks and channels cannot be stored in a list. For tasks use nox.tasks.TaskGroup[T] (it keeps each task in a TaskHandle[T] class), or hold the value in a class field; to gather results use a Channel")
            raise mk_fail(ck, "UnknownType")
        if tagk == 11 and (elem == 0 or elem == 1 or elem == 2):
            mp(ck, "the T of 'TaskLocal[T]' must be a class/str/list/dict (a bare int/float/bool is outside the v1 scope)")
            raise mk_fail(ck, "TypeMismatch")
        return ty_mk(tt, tagk, elem, 0)
    if sref_eq(a, gn, "dict"):
        if n != 2:
            mp(ck, "'dict' takes exactly two type arguments (K, V)")
            raise mk_fail(ck, "UnknownType")
        kt: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 0))
        vt: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 1))
        if kt != 0 and kt != 2 and kt != 3 and kt != 1:
            mp(ck, "the 'dict' key type can only be int/float/bool/str/bytes")
            raise mk_fail(ck, "UnknownType")
        vg: int = tt.tag[vt]
        if vt != 0 and vt != 1 and vt != 2 and vt != 3 and vg != 6 and vg != 5 and vg != 13:
            mp(ck, "the 'dict' value type can only be int/float/bool/str/bytes/class/list/dict")
            raise mk_fail(ck, "UnknownType")
        return ty_dict(tt, kt, vt)
    # `__nox_*` (parser'ın Iterator/Generator → `__nox_Gen[T]` haritası, prelude jenerikleri): kapsam dışı
    if sref_len(gn) >= 5 and sref_byte(a, gn, 0) == 95 and sref_byte(a, gn, 1) == 95 and sref_byte(a, gn, 2) == 110 and sref_byte(a, gn, 3) == 111 and sref_byte(a, gn, 4) == 120:
        raise unsup(ck, "type_expr_generic#prelude")
    # nitelikli jenerik (`mod.Box[int]`): modül çözümlemesi (3.12) kapsam dışı
    for dq in range(sref_len(gn)):
        if sref_byte(a, gn, dq) == 46:
            raise unsup(ck, "type_expr_generic#qualified")
    # kullanıcı jenerik sınıfı: sınıf tabloları bu dilimde boş
    mp(ck, "unknown generic type: ")
    mp_sref(ck, a, gn)
    raise mk_fail(ck, "UnknownType")

# ---- sayısal yardımcılar ----
# `requireSameFixedIntOrNone`: -1 = ikisi de fixed_int değil; aksi halde ortak tür; karışımda hata.
def require_same_fixed(ck: Ck, l: int, r: int) -> int:
    tt: TT = ck.tt
    lk: int = -1
    rk: int = -1
    if tt.tag[l] == 16:
        lk = tt.xa[l]
    if tt.tag[r] == 16:
        rk = tt.xa[r]
    if lk < 0 and rk < 0:
        return -1
    if lk >= 0 and rk >= 0 and lk == rk:
        return lk
    mp(ck, "fixed-width integers do not implicitly mix with other kinds or with int/float — use an explicit conversion")
    raise mk_fail(ck, "TypeMismatch")

def is_numeric_t(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return g == 0 or g == 1 or g == 16

def is_bitwise_t(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return g == 0 or g == 16

def numeric_promote(ck: Ck, l: int, r: int) -> int:
    if not is_numeric_t(ck, l) or not is_numeric_t(ck, r):
        mp(ck, "arithmetic only works on numeric types")
        raise mk_fail(ck, "TypeMismatch")
    k: int = require_same_fixed(ck, l, r)
    if k >= 0:
        return 6 + k
    if l == 1 or r == 1:
        return 1
    return 0

# ---- ifadeler ----
def check_expr(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    ck.depth = ck.depth + 1
    if ck.depth > 500:
        mp(ck, "expression nested too deeply (maximum allowed depth: 500)")
        raise mk_fail(ck, "TooDeeplyNested")
    t: int = check_expr_inner(ck, a, fx, e)
    ck.depth = ck.depth - 1
    return t

def check_expr_inner(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    tag: int = a.n[e]
    if tag == 0:
        return 0
    if tag == 1:
        return 1
    if tag == 2:
        return 2
    if tag == 3:
        return 3
    if tag == 4:
        return 4
    if tag == 5:
        return check_identifier(ck, a, fx, e)
    if tag == 6:
        return check_unary(ck, a, fx, a.n[e + 1])
    if tag == 7:
        return check_binary(ck, a, fx, a.n[e + 1])
    if tag == 8:
        return check_call(ck, a, fx, a.n[e + 1])
    if tag == 11:
        return check_list_lit(ck, a, fx, e)
    if tag == 12:
        return check_dict_lit(ck, a, fx, e)
    if tag == 10:
        return check_index(ck, a, fx, a.n[e + 1])
    if tag == 9:
        return check_attribute(ck, a, fx, a.n[e + 1])
    if tag == 13:
        return check_await(ck, a, fx, e)
    if tag == 14:
        return check_spawn(ck, a, fx, a.n[e + 1])
    if tag == 15:
        return check_generic_construct(ck, a, fx, a.n[e + 1])
    if tag == 18:
        return check_slice(ck, a, fx, a.n[e + 1])
    if tag == 19:
        return check_lambda(ck, a, fx, e, -1)
    if tag == 20:
        return check_tuple_lit(ck, a, fx, e, -1)
    if tag == 16:
        return check_ternary(ck, a, fx, a.n[e + 1], -1)
    if tag == 21:
        return check_list_comp(ck, a, fx, a.n[e + 1], -1)
    if tag == 22:
        return check_dict_comp(ck, a, fx, a.n[e + 1], -1)
    raise unsup(ck, "check_expr_inner#" + str(tag))

# `spawn f(...)`: yalnızca üst-düzey `async def` çağrısı (iç içe async/`obj.metod` sarmalayıcısı kapsam dışı) -> `Task[T]`.
def check_spawn(ck: Ck, a: Ast, fx: Fx, opd: int) -> int:
    if a.n[opd] != 8:
        fail2(ck, "NotCallable", "'spawn' can only wrap a call expression")
    c: int = a.n[opd + 1]
    callee: int = a.n[c + 0]
    if a.n[callee] == 9:
        raise unsup(ck, "spawn#attribute")
    if a.n[callee] != 5:
        fail2(ck, "NotCallable", "'spawn' can only wrap a direct function call")
    nm: int = pk(a.n[callee + 1], a.n[callee + 2])
    sym: int = sym_of(ck, a, nm)
    if m2_get(ck.fmap, 0, sym) < 0:
        sfe: int = m2_get(ck.fimp, 0, sym)
        if sfe >= 0 and m2_get(ck.fmap, 0, ck.fimp.vv[sfe]) >= 0:
            sym = ck.fimp.vv[sfe]
    if m2_get(ck.afn, 0, sym) < 0:
        mp(ck, "'spawn' can only start 'async def' functions: '")
        mp_sym(ck, sym)
        mp(ck, "' is not async")
        raise mk_fail(ck, "TypeMismatch")
    sid: int = ck.fmap.vv[m2_get(ck.fmap, 0, sym)]
    check_args_sig(ck, a, fx, c, sid, sym)
    # list/dict/class argümanları paylaşılır: Zig'in spawn-paylaşım/mutasyon analizleri (SpawnSharedMutation ...) henüz taşınmadı
    for pi in range(ck.fpn[sid]):
        pg: int = ck.tt.tag[ck.fpar[ck.fps[sid] + pi]]
        if pg == 5 or pg == 6 or pg == 13:
            raise unsup(ck, "spawn#shared_arg")
    return ty_mk(ck.tt, 7, ck.fret[sid], 0)

# `checkGenericConstruct`: `Channel[T](kapasite)`, `ThreadChannel[T](kapasite)`, `TaskLocal[T]()`; `ptr[T](adres)` (lowlevel) ve kullanıcı jenerikleri/nitelikli adlar kapsam dışı.
def check_generic_construct(ck: Ck, a: Ast, fx: Fx, g: int) -> int:
    gn: int = pk(a.n[g + 0], a.n[g + 0 + 1])
    targs: int = sl_at(a, g, 2)
    args: int = sl_at(a, g, 4)
    nt: int = pky(targs)
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, gn, "ptr"):
        if fx.ll_depth == 0:
            fail2(ck, "LowlevelRequired", "'ptr' can only be used inside a 'lowlevel:' block")
        if nt != 1:
            fail2(ck, "UnknownType", "'ptr' takes exactly one type argument")
        pelem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "the 'ptr' constructor takes exactly 1 argument (addr: int)")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            fail2(ck, "TypeMismatch", "the argument (addr) of the 'ptr' constructor must be an int")
        return ty_mk(tt, 17, pelem, 0)
    if sref_eq(a, gn, "ThreadChannel"):
        if nt != 1:
            fail2(ck, "UnknownType", "'ThreadChannel' takes exactly one type argument")
        telem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
        tg: int = tt.tag[telem]
        if tg == 9 or tg == 14 or tg == 15:
            fail2(ck, "TypeMismatch", "the 'ThreadChannel' element type can only be int/float/bool/str/None/ptr (and additionally task/channel/list/class/dict on hosted targets)")
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "the 'ThreadChannel' constructor takes exactly 1 argument (capacity: int)")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            fail2(ck, "TypeMismatch", "the argument (capacity) of the 'ThreadChannel' constructor must be an int")
        return ty_mk(tt, 10, telem, 0)
    for dq in range(sref_len(gn)):
        if sref_byte(a, gn, dq) == 46:
            raise unsup(ck, "generic_construct#qualified")
    if sref_eq(a, gn, "TaskLocal"):
        if nt != 1:
            fail2(ck, "UnknownType", "'TaskLocal' takes exactly one type argument")
        lelem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
        if lelem == 0 or lelem == 1 or lelem == 2:
            fail2(ck, "TypeMismatch", "the T of 'TaskLocal[T]' must be a class/str/list/dict (a bare int/float/bool is outside the v1 scope — it requires boxing such as Optional[int])")
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "the 'TaskLocal' constructor takes no arguments")
        return ty_mk(tt, 11, lelem, 0)
    if not sref_eq(a, gn, "Channel"):
        fail_attr(ck, a, gn, "UnknownType", "unknown generic constructor: ", "")
    if nt != 1:
        fail2(ck, "UnknownType", "'Channel' takes exactly one type argument")
    celem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
    if n != 1:
        fail2(ck, "ArgumentCountMismatch", "the 'Channel' constructor takes exactly 1 argument (capacity: int)")
    if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
        fail2(ck, "TypeMismatch", "the argument (capacity) of the 'Channel' constructor must be an int")
    return ty_mk(tt, 8, celem, 0)

# `.await_expr` (Task operandı; Channel/ThreadHandle işlemleri ve `spawn` kapsam dışı)
def check_await(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    if not fx.in_async:
        mp(ck, "'await' can only be used inside an 'async def' body")
        raise mk_fail(ck, "TypeMismatch")
    opd: int = a.n[e + 1]
    saved: int = fx.awaited
    fx.awaited = -1
    if a.n[opd] == 8:
        fx.awaited = a.n[a.n[opd + 1] + 0]
    t: int = -1
    try:
        t = check_expr(ck, a, fx, opd)
    finally:
        fx.awaited = saved
    if ck.tt.tag[t] == 7:
        return ck.tt.xa[t]
    # Task değil: yalnızca `ch.send/recv(...)` (Channel/ThreadChannel) ya da `h.join()` (ThreadHandle) çağrısı olabilir
    if a.n[opd] == 8:
        cal: int = a.n[a.n[opd + 1] + 0]
        if a.n[cal] == 9:
            cat: int = a.n[cal + 1]
            rt: int = check_expr(ck, a, fx, a.n[cat + 0])
            can: int = pk(a.n[cat + 1], a.n[cat + 1 + 1])
            rg: int = ck.tt.tag[rt]
            if (sref_eq(a, can, "send") or sref_eq(a, can, "recv")) and (rg == 8 or rg == 10):
                return t
            if sref_eq(a, can, "join") and rg == 9:
                return t
    mp(ck, "'await' can only be used on a Task value, a Channel.send/recv, a ThreadChannel.send/recv or a ThreadHandle.join() call")
    raise mk_fail(ck, "TypeMismatch")

# `[a, b, ...]`: boş bağlamsız literal tipsiz; elemanlar aynı tipte olmalı.
def check_list_lit(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    n: int = a.n[e + 2]
    if n == 0:
        mp(ck, "the type of an empty list literal cannot be inferred")
        raise mk_fail(ck, "UnknownType")
    st: int = a.n[e + 1]
    first: int = check_expr(ck, a, fx, a.l[st])
    for i in range(1, n):
        t: int = check_expr(ck, a, fx, a.l[st + i])
        if t != first:
            mp(ck, "list elements must have the same type")
            raise mk_fail(ck, "TypeMismatch")
    return ty_list(ck.tt, first)

def dict_key_ok(ck: Ck, t: int) -> bool:
    return t == 0 or t == 2 or t == 3 or t == 1

def dict_value_ok(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return t == 0 or t == 1 or t == 2 or t == 3 or g == 6 or g == 5 or g == 13

def check_dict_lit(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    n: int = a.n[e + 2]
    if n == 0:
        mp(ck, "the type of an empty dict literal cannot be inferred")
        raise mk_fail(ck, "UnknownType")
    st: int = a.n[e + 1]
    p0: int = a.l[st]
    fk: int = check_expr(ck, a, fx, a.n[p0 + 0])
    fv: int = check_expr(ck, a, fx, a.n[p0 + 1])
    if not dict_key_ok(ck, fk):
        mp(ck, "the 'dict' key type can only be int/float/bool/str/bytes")
        raise mk_fail(ck, "TypeMismatch")
    if not dict_value_ok(ck, fv):
        mp(ck, "the 'dict' value type can only be int/float/bool/str/bytes/class/list/dict")
        raise mk_fail(ck, "TypeMismatch")
    for i in range(1, n):
        pp: int = a.l[st + i]
        kt: int = check_expr(ck, a, fx, a.n[pp + 0])
        vt: int = check_expr(ck, a, fx, a.n[pp + 1])
        if kt != fk:
            mp(ck, "dict keys must have the same type")
            raise mk_fail(ck, "TypeMismatch")
        if vt != fv:
            mp(ck, "dict values must have the same type")
            raise mk_fail(ck, "TypeMismatch")
    return ty_dict(ck.tt, fk, fv)

# `requireNotOptional`
def require_not_optional(ck: Ck, t: int, what: str) -> None:
    if ck.tt.tag[t] == 15:
        mp(ck, "an Optional (T | None) value cannot be used for '")
        mp(ck, what)
        mp(ck, "' — narrow it first with 'if ... != None:'")
        raise mk_fail(ck, "OptionalNotNarrowed")

# `checkTupleLit`: `(a, b, ...)` -> sentezlenmiş `tuple__...` sınıfı; beklenen tip varsa elemanlara iletilir.
def check_tuple_lit(ck: Ck, a: Ast, fx: Fx, e: int, expected: int) -> int:
    n: int = a.n[e + 2]
    if n == 0:
        fail2(ck, "TypeMismatch", "an empty tuple is not supported")
    es: int = -1
    if expected >= 0:
        eci: int = class_idx_of_type(ck, expected)
        if is_tuple_cls(ck, eci) and ck.tup_n[eci] == n:
            es = ck.tup_s[eci]
    st: int = a.n[e + 1]
    ts: list[int] = []
    for i in range(n):
        exp_el: int = -1
        if es >= 0:
            exp_el = ck.tup_e[es + i]
        et: int = check_expr_expected(ck, a, fx, a.l[st + i], exp_el)
        if et == 4:
            fail2(ck, "TypeMismatch", "a tuple element must produce a value")
        if es >= 0 and ty_assignable(ck.tt, exp_el, et):
            ts.append(exp_el)
        else:
            ts.append(et)
    return instantiate_tuple_class(ck, ts)

# `checkTernary`: `a if cond else b` (koşul bool, dallar aynı tipte ve desteklenen türde).
def check_ternary(ck: Ck, a: Ast, fx: Fx, t: int, expected: int) -> int:
    ct: int = check_expr(ck, a, fx, a.n[t + 0])
    if ct != 2:
        fail2(ck, "TypeMismatch", "the condition of a ternary expression must be a bool")
    then_t: int = check_expr_expected(ck, a, fx, a.n[t + 1], expected)
    else_t: int = check_expr_expected(ck, a, fx, a.n[t + 2], expected)
    tg: int = ck.tt.tag[then_t]
    if then_t != 0 and then_t != 1 and then_t != 2 and then_t != 3 and tg != 16 and tg != 5 and tg != 13 and tg != 6:
        fail2(ck, "TypeMismatch", "the type of the ternary expression's branches is not supported (it must be int/float/bool/str/list/dict/class)")
    if then_t != else_t:
        fail2(ck, "TypeMismatch", "both branches of a ternary expression MUST have the SAME type (to mix int and float, convert a branch explicitly)")
    return then_t

def check_comp_clauses(ck: Ck, a: Ast, fx: Fx, clauses: int, sv_sym: list[int], sv_prior: list[int]) -> None:
    for i in range(pky(clauses)):
        cl: int = stmt_at(a, clauses, i)
        ctag: int = a.n[cl]
        cpay: int = a.n[cl + 1]
        if ctag == 0:
            elem_t: int = check_for_iterable(ck, a, fx, a.n[cpay + 2])
            vn: int = pk(a.n[cpay + 0], a.n[cpay + 0 + 1])
            vsym: int = sym_of(ck, a, vn)
            sv_sym.append(vsym)
            sv_prior.append(sc_lookup_local(ck, fx.scope, vsym))
            sc_declare(ck, fx.scope, vsym, elem_t)
        elif ctag == 1:
            it: int = check_expr(ck, a, fx, cpay)
            if it != 2:
                fail2(ck, "TypeMismatch", "the comprehension 'if' condition must be a bool")

def restore_comp_scope(ck: Ck, fx: Fx, sv_sym: list[int], sv_prior: list[int]) -> None:
    i: int = len(sv_sym)
    while i > 0:
        i = i - 1
        if sv_prior[i] >= 0:
            sc_declare(ck, fx.scope, sv_sym[i], sv_prior[i])
        else:
            m2_remove(ck.vars, fx.scope, sv_sym[i])

def check_list_comp(ck: Ck, a: Ast, fx: Fx, lc: int, elem_expected: int) -> int:
    sv_sym: list[int] = []
    sv_prior: list[int] = []
    ck.comp_depth = ck.comp_depth + 1
    elem_t: int = -1
    try:
        check_comp_clauses(ck, a, fx, sl_at(a, lc, 1), sv_sym, sv_prior)
        elem_t = check_expr_expected(ck, a, fx, a.n[lc + 0], elem_expected)
    finally:
        ck.comp_depth = ck.comp_depth - 1
    restore_comp_scope(ck, fx, sv_sym, sv_prior)
    if elem_t == 4:
        fail2(ck, "TypeMismatch", "the comprehension element must produce a value")
    return ty_list(ck.tt, elem_t)

def check_dict_comp(ck: Ck, a: Ast, fx: Fx, dc: int, val_expected: int) -> int:
    sv_sym: list[int] = []
    sv_prior: list[int] = []
    ck.comp_depth = ck.comp_depth + 1
    key_t: int = -1
    val_t: int = -1
    try:
        check_comp_clauses(ck, a, fx, sl_at(a, dc, 2), sv_sym, sv_prior)
        key_t = check_expr(ck, a, fx, a.n[dc + 0])
        val_t = check_expr_expected(ck, a, fx, a.n[dc + 1], val_expected)
    finally:
        ck.comp_depth = ck.comp_depth - 1
    restore_comp_scope(ck, fx, sv_sym, sv_prior)
    if not dict_key_ok(ck, key_t):
        fail2(ck, "TypeMismatch", "the 'dict' key type can only be int/float/bool/str/bytes")
    if not dict_value_ok(ck, val_t):
        fail2(ck, "TypeMismatch", "the 'dict' value type can only be int/float/bool/str/bytes/class/list/dict")
    return ty_dict(ck.tt, key_t, val_t)

# `obj[lo:hi:step]` (list/str; bytes için `slice#bytes` kapsam dışı).
def check_slice(ck: Ck, a: Ast, fx: Fx, sl: int) -> int:
    obj_t: int = check_expr(ck, a, fx, a.n[sl + 0])
    require_not_optional(ck, obj_t, "[:]")
    tt: TT = ck.tt
    if tt.tag[obj_t] == 18:
        raise unsup(ck, "slice#bytes")
    if tt.tag[obj_t] != 5 and obj_t != 3:
        fail2(ck, "TypeMismatch", "slicing ('[a:b]') only works on list/str/bytes")
    lo: int = a.n[sl + 1]
    if lo >= 0:
        if check_expr(ck, a, fx, lo) != 0:
            fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
    hi: int = a.n[sl + 2]
    if hi >= 0:
        if check_expr(ck, a, fx, hi) != 0:
            fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
    step: int = a.n[sl + 3]
    if step >= 0:
        if check_expr(ck, a, fx, step) != 0:
            fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
        stag: int = a.n[step]
        if stag == 0 and a.n[step + 1] == 0:
            fail2(ck, "TypeMismatch", "the slice step cannot be zero")
        if stag == 6:
            up: int = a.n[step + 1]
            if a.n[up + 0] == 0 and a.n[a.n[up + 1]] == 0 and a.n[a.n[up + 1] + 1] == 0:
                fail2(ck, "TypeMismatch", "the slice step cannot be zero")
    return obj_t

# `obj[i]`: dict[K]→V, str[int]→str, list[int]→T, tuple[k]→Tk (sınıf `__getitem__` kapsam dışı).
def check_index(ck: Ck, a: Ast, fx: Fx, ip: int) -> int:
    obj_t: int = check_expr(ck, a, fx, a.n[ip + 0])
    require_not_optional(ck, obj_t, "[]")
    tt: TT = ck.tt
    if has_dunder(ck, obj_t, "__getitem__"):
        raise unsup(ck, "check_index#dunder")
    ie: int = a.n[ip + 1]
    tci: int = class_idx_of_type(ck, obj_t)
    if is_tuple_cls(ck, tci):
        itag: int = a.n[ie]
        k: int = 0
        if itag == 0:
            k = a.n[ie + 1]
        elif itag == 6:
            up: int = a.n[ie + 1]
            if a.n[up + 0] == 0 and a.n[a.n[up + 1]] == 0:
                k = 0 - a.n[a.n[up + 1] + 1]
            else:
                fail2(ck, "TypeMismatch", "a tuple index must be a constant int literal")
        else:
            fail2(ck, "TypeMismatch", "a tuple index must be a constant int literal")
        tn: int = ck.tup_n[tci]
        ki: int = k
        if ki < 0:
            ki = ki + tn
        if ki < 0 or ki >= tn:
            mp(ck, "tuple index out of range (the tuple has ")
            mp_int(ck, tn)
            mp(ck, " elements)")
            raise mk_fail(ck, "TypeMismatch")
        return ck.tup_e[ck.tup_s[tci] + ki]
    if tt.tag[obj_t] == 13:
        idx_t: int = check_expr(ck, a, fx, ie)
        if idx_t != tt.xa[obj_t]:
            mp(ck, "the dict index does not match the key type")
            raise mk_fail(ck, "TypeMismatch")
        return tt.xb[obj_t]
    if obj_t == 3:
        it: int = check_expr(ck, a, fx, ie)
        if it != 0:
            mp(ck, "a str index must be an int")
            raise mk_fail(ck, "TypeMismatch")
        return 3
    lt: int = check_expr(ck, a, fx, ie)
    if lt != 0:
        mp(ck, "a list index must be an int")
        raise mk_fail(ck, "TypeMismatch")
    if tt.tag[obj_t] == 5:
        return tt.xa[obj_t]
    mp(ck, "indexing only works on 'list'/'dict'/'str'")
    raise mk_fail(ck, "TypeMismatch")

def check_identifier(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    v: int = pk(a.n[e + 1], a.n[e + 2])
    sym: int = sym_of(ck, a, v)
    t: int = sc_lookup(ck, fx.scope, sym)
    if t >= 0:
        return t
    gi: int = m2_get(ck.globs, 0, sym)
    if gi >= 0:
        return ck.globs.vv[gi]
    # resolveIdentifierAsFunctionValue: üst-düzey (generic/async olmayan) işlev adı bir değer olarak
    fe: int = m2_get(ck.fmap, 0, sym)
    if fe >= 0:
        if m2_get(ck.afn, 0, sym) >= 0:
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "' is an 'async def' function and cannot be used as a value")
            raise mk_fail(ck, "TypeMismatch")
        fi: int = ck.fmap.vv[fe]
        ty_func_begin(ck.tt)
        st: int = ck.fps[fi]
        for i in range(ck.fpn[fi]):
            ty_func_param(ck.tt, ck.fpar[st + i])
        return ty_func_end(ck.tt, ck.fret[fi])
    # `from X import f` ile bağlanan adın değer olarak kullanımı (Zig: mangled işlev yoksa `functions.get(rn).?` null açılımı): kapsam dışı
    if m2_get(ck.fimp, 0, sym) >= 0:
        raise unsup(ck, "check_identifier#fromimport")
    mp(ck, "undefined variable: ")
    mp_sym(ck, sym)
    raise mk_fail(ck, "UndefinedVariable")

def check_unary(ck: Ck, a: Ast, fx: Fx, u: int) -> int:
    op: int = a.n[u + 0]
    t: int = check_expr(ck, a, fx, a.n[u + 1])
    tt: TT = ck.tt
    if op == 0 and has_dunder(ck, t, "__neg__"):
        raise unsup(ck, "check_unary#dunder")
    if op == 2 and has_dunder(ck, t, "__invert__"):
        raise unsup(ck, "check_unary#dunder")
    if op == 0:
        if not is_numeric_t(ck, t):
            mp(ck, "unary '-' can only be applied to numeric types")
            raise mk_fail(ck, "TypeMismatch")
        if tt.tag[t] == 16 and not fx_signed(tt.xa[t]):
            mp(ck, "unary '-' cannot be applied to an unsigned type ('")
            mp_type(ck, t)
            mp(ck, "')")
            raise mk_fail(ck, "TypeMismatch")
        return t
    if op == 1:
        if t != 2:
            mp(ck, "'not' can only be used with bool")
            raise mk_fail(ck, "TypeMismatch")
        return 2
    if not is_bitwise_t(ck, t):
        mp(ck, "unary '~' can only be applied to int/fixed-width integer types (float/bool are not supported — for bool, convert with 'int(...)' first)")
        raise mk_fail(ck, "TypeMismatch")
    if tt.tag[t] == 16:
        return t
    return 0

def check_binary(ck: Ck, a: Ast, fx: Fx, b: int) -> int:
    left: int = a.n[b + 1]
    right: int = a.n[b + 2]
    op: int = a.n[b + 0]
    l: int = check_expr(ck, a, fx, left)
    tt: TT = ck.tt
    r: int = 0
    if op == 0 and tt.tag[l] == 5 and a.n[right] == 11:
        r = check_expr_expected(ck, a, fx, right, l)
    else:
        r = check_expr(ck, a, fx, right)
    # tryOperatorOverload / Optional / liste-sözlük işlemleri bu dilimde kapsam dışı
    if a.n[left] == 4 or a.n[right] == 4:
        raise unsup(ck, "check_binary#1")
    if tt.tag[l] == 6 or tt.tag[r] == 6 or tt.tag[l] == 15 or tt.tag[r] == 15:
        raise unsup(ck, "check_binary#2")
    if op == 0:
        if l == 3 and r == 3:
            return 3
        if tt.tag[l] == 5 and tt.tag[r] == 5:
            if l != r:
                mp(ck, "'+' requires the element types of the two lists to be the same")
                raise mk_fail(ck, "TypeMismatch")
            return l
        return numeric_promote(ck, l, r)
    if op == 1:
        return numeric_promote(ck, l, r)
    if op == 2:
        if tt.tag[l] == 5 and r == 0:
            return l
        if l == 0 and tt.tag[r] == 5:
            return r
        if (l == 3 and r == 0) or (l == 0 and r == 3):
            return 3
        return numeric_promote(ck, l, r)
    if op == 5 or op == 4 or op == 6:
        res: int = numeric_promote(ck, l, r)
        if tt.tag[res] == 16:
            mp(ck, "'%'/'//'/'**' are not supported with fixed-width integer types yet — convert to 'int' first")
            raise mk_fail(ck, "TypeMismatch")
        return res
    if op == 3:
        if not is_numeric_t(ck, l) or not is_numeric_t(ck, r):
            mp(ck, "'/' can only be used with numeric types")
            raise mk_fail(ck, "TypeMismatch")
        require_same_fixed(ck, l, r)
        return 1
    if op == 7 or op == 8:
        require_same_fixed(ck, l, r)
        if is_numeric_t(ck, l) and is_numeric_t(ck, r):
            return 2
        if a.n[b + 5] != 0:
            return 2
        if l == r:
            return 2
        mp(ck, "the compared types do not match")
        raise mk_fail(ck, "TypeMismatch")
    if op == 9 or op == 10 or op == 11 or op == 12:
        if l == 3 and r == 3:
            return 2
        if not is_numeric_t(ck, l) or not is_numeric_t(ck, r):
            mp(ck, "ordering comparisons only work on numeric types or between two strs")
            raise mk_fail(ck, "TypeMismatch")
        require_same_fixed(ck, l, r)
        return 2
    if op == 13 or op == 14:
        if l != 2 or r != 2:
            mp(ck, "'and'/'or' can only be used with bool")
            raise mk_fail(ck, "TypeMismatch")
        return 2
    if op == 20 or op == 21:
        if tt.tag[r] == 5:
            et: int = tt.xa[r]
            eg: int = tt.tag[et]
            if not (et == 0 or et == 1 or et == 2 or et == 3 or eg == 16 or eg == 6 or eg == 5):
                mp(ck, "the list element type is not supported for 'in' (it must be int/float/bool/str/class/list)")
                raise mk_fail(ck, "TypeMismatch")
            require_same_fixed(ck, l, et)
            if not ((is_numeric_t(ck, l) and is_numeric_t(ck, et)) or l == et):
                mp(ck, "the left operand of 'in' does not match the list element type")
                raise mk_fail(ck, "TypeMismatch")
            return 2
        if tt.tag[r] == 13:
            if l != tt.xa[r]:
                mp(ck, "the left operand of 'in' does not match the dict key type")
                raise mk_fail(ck, "TypeMismatch")
            return 2
        if tt.tag[r] == 3:
            if l != 3:
                mp(ck, "only a str can be searched for inside a str with 'in'")
                raise mk_fail(ck, "TypeMismatch")
            return 2
        mp(ck, "'in'/'not in' can only be used on list, dict, str and bytes")
        raise mk_fail(ck, "TypeMismatch")
    if op == 15 or op == 16 or op == 17:
        if l == 2 and r == 2:
            return 2
        if l == 2 or r == 2:
            mp(ck, "'&'/'|'/'^' do not implicitly mix bool with int/fixed-width integers — use an explicit conversion")
            raise mk_fail(ck, "TypeMismatch")
        if not is_bitwise_t(ck, l) or not is_bitwise_t(ck, r):
            mp(ck, "'&'/'|'/'^' can only be used on int/fixed-width integer types (float is not supported)")
            raise mk_fail(ck, "TypeMismatch")
        fk: int = require_same_fixed(ck, l, r)
        if fk >= 0:
            return 6 + fk
        return 0
    # shl / shr
    if not is_bitwise_t(ck, l):
        mp(ck, "the left operand of '<<'/'>>' can only be an int/fixed-width integer (float/bool are not supported — for bool, convert with 'int(...)' first)")
        raise mk_fail(ck, "TypeMismatch")
    if r != 0:
        mp(ck, "the shift amount of '<<'/'>>' must be an 'int'")
        raise mk_fail(ck, "TypeMismatch")
    if tt.tag[l] == 16:
        return l
    return 0

# `checkExprExpected`in skaler dilimi: sabit-genişlikli beklenen tipte tamsayı literali aralık denetimi.
# `constIntValue`: literal / değişmez modül sabiti (yerelde gölgelenmemişse) / bunlardan `- ~ + - * | & ^ << >>` ile kurulu ifade. Değer `ck.cv`de; dönüş: bulundu mu.
def const_int_value(ck: Ck, a: Ast, fx: Fx, e: int, depth: int) -> bool:
    if depth > 32:
        return False
    tag: int = a.n[e]
    if tag == 0:
        ck.cv = a.n[e + 1]
        return True
    if tag == 5:
        sym: int = sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2]))
        if sc_lookup(ck, fx.scope, sym) >= 0:
            if ck.top_scope < 0 or fx.scope != ck.top_scope:
                return False
        ei: int = m2_get(ck.iconsts, 0, sym)
        if ei < 0:
            return False
        ck.cv = ck.iconsts.vv[ei]
        return True
    if tag == 6:
        u: int = a.n[e + 1]
        if not const_int_value(ck, a, fx, a.n[u + 1], depth + 1):
            return False
        v: int = ck.cv
        op: int = a.n[u + 0]
        if op == 0:
            ck.cv = 0 - v
            return True
        if op == 2:
            ck.cv = ~v
            return True
        return False
    if tag == 7:
        b: int = a.n[e + 1]
        if not const_int_value(ck, a, fx, a.n[b + 1], depth + 1):
            return False
        l: int = ck.cv
        if not const_int_value(ck, a, fx, a.n[b + 2], depth + 1):
            return False
        r: int = ck.cv
        bop: int = a.n[b + 0]
        if bop == 0:
            ck.cv = l + r
        elif bop == 1:
            ck.cv = l - r
        elif bop == 2:
            ck.cv = l * r
        elif bop == 16:
            ck.cv = l | r
        elif bop == 15:
            ck.cv = l & r
        elif bop == 17:
            ck.cv = l ^ r
        elif bop == 18:
            if r < 0 or r >= 63:
                return False
            ck.cv = l << r
        elif bop == 19:
            if r < 0 or r >= 63:
                return False
            ck.cv = l >> r
        else:
            return False
        return True
    return False

def check_expr_expected(ck: Ck, a: Ast, fx: Fx, e: int, expected_in: int) -> int:
    tag: int = a.n[e]
    tt: TT = ck.tt
    expected: int = expected_in
    # `y: list[str] | None = []`: Optional'ın taşıdığı list/dict beklenen tip olur
    if expected >= 0 and tt.tag[expected] == 15 and (tag == 11 or tag == 12 or tag == 21 or tag == 22):
        inner: int = tt.xa[expected]
        if tt.tag[inner] == 5 or tt.tag[inner] == 13:
            expected = inner
    if tag == 21 and expected >= 0 and tt.tag[expected] == 5:
        return check_list_comp(ck, a, fx, a.n[e + 1], tt.xa[expected])
    if tag == 22 and expected >= 0 and tt.tag[expected] == 13:
        return check_dict_comp(ck, a, fx, a.n[e + 1], tt.xb[expected])
    if tag == 19:
        return check_lambda(ck, a, fx, e, expected_in)
    if tag == 20:
        return check_tuple_lit(ck, a, fx, e, expected)
    if tag == 16:
        return check_ternary(ck, a, fx, a.n[e + 1], expected)
    if tag == 11 and expected >= 0 and tt.tag[expected] == 5:
        n: int = a.n[e + 2]
        el: int = tt.xa[expected]
        if n == 0:
            return expected
        st: int = a.n[e + 1]
        if tt.tag[el] == 14:
            for i in range(n):
                t: int = check_expr_expected(ck, a, fx, a.l[st + i], el)
                if not ty_assignable(tt, el, t):
                    mp(ck, "the list element does not match the expected function type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
        if tt.tag[el] == 6:
            for j0 in range(n):
                t0: int = check_expr(ck, a, fx, a.l[st + j0])
                if not ty_assignable(tt, el, t0):
                    mp(ck, "the list element does not match the expected class type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
        if tt.tag[el] == 5 or tt.tag[el] == 13:
            for j in range(n):
                t2: int = check_expr_expected(ck, a, fx, a.l[st + j], el)
                if t2 != el:
                    mp(ck, "list elements must have the same type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
    if tag == 12 and expected >= 0 and tt.tag[expected] == 13:
        dn: int = a.n[e + 2]
        if dn == 0:
            return expected
        dv: int = tt.xb[expected]
        if tt.tag[dv] == 5 or tt.tag[dv] == 13:
            dst: int = a.n[e + 1]
            for k in range(dn):
                pr: int = a.l[dst + k]
                kt: int = check_expr(ck, a, fx, a.n[pr + 0])
                if kt != tt.xa[expected]:
                    mp(ck, "dict keys must have the same type")
                    raise mk_fail(ck, "TypeMismatch")
                vt: int = check_expr_expected(ck, a, fx, a.n[pr + 1], dv)
                if vt != dv:
                    mp(ck, "dict values must have the same type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
    if expected >= 0 and tt.tag[expected] == 16:
        kind: int = tt.xa[expected]
        if tag == 0:
            v: int = a.n[e + 1]
            if not fx_fits(kind, v):
                mp(ck, "the value ")
                mp_int(ck, v)
                mp(ck, " does not fit in the range of '")
                mp_type(ck, expected)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            return expected
        # sabit tamsayı ifadeleri (constIntValue): aralığa sığıyorsa örtük kabul
        isneglit: bool = False
        if tag == 6:
            up: int = a.n[e + 1]
            isneglit = a.n[up + 0] == 0 and a.n[a.n[up + 1]] == 0
        if tag == 5 or tag == 7 or (tag == 6 and not isneglit):
            if const_int_value(ck, a, fx, e, 0):
                cvv: int = ck.cv
                if not fx_fits(kind, cvv):
                    mp(ck, "the constant value ")
                    mp_int(ck, cvv)
                    mp(ck, " does not fit in the range of '")
                    mp_type(ck, expected)
                    mp(ck, "'")
                    raise mk_fail(ck, "TypeMismatch")
                check_expr(ck, a, fx, e)
                return expected
        # `x: i8 = -5`: parser bunu unary neg(int_lit 5) olarak üretir
        if isneglit:
            if not fx_signed(kind):
                mp(ck, "a negative value cannot be assigned to the unsigned type '")
                mp_type(ck, expected)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            nv: int = 0 - a.n[a.n[a.n[e + 1] + 1] + 1]
            if not fx_fits(kind, nv):
                mp(ck, "the value ")
                mp_int(ck, nv)
                mp(ck, " does not fit in the range of '")
                mp_type(ck, expected)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            return expected
    return check_expr(ck, a, fx, e)

# ---- çağrılar: yerleşikler (print/len) + kullanıcı işlevi (identifier callee) ----
# `print(a, b, ...)` / `sep=`/`end=` anahtarlı argümanlar (Zig `checkCallInner` print dalı); sınıf (`__str__`) kapsam dışı.
def check_print(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    args: int = sl_at(a, c, 1)
    saw_kw: bool = False
    for i in range(pky(args)):
        arg: int = stmt_at(a, args, i)
        if a.n[arg] == 17:
            saw_kw = True
            k: int = a.n[arg + 1]
            kn: int = pk(a.n[k + 0], a.n[k + 0 + 1])
            if not sref_eq(a, kn, "sep") and not sref_eq(a, kn, "end"):
                mp(ck, "'print' only accepts the 'sep=' and 'end=' keyword arguments")
                raise mk_fail(ck, "TypeMismatch")
            kt: int = check_expr(ck, a, fx, a.n[k + 2])
            if kt != 3:
                mp(ck, "the '")
                mp_sref(ck, a, kn)
                mp(ck, "=' argument of 'print' must be a str")
                raise mk_fail(ck, "TypeMismatch")
        else:
            if saw_kw:
                mp(ck, "positional arguments of 'print' must come before keyword arguments")
                raise mk_fail(ck, "TypeMismatch")
            pt: int = check_expr(ck, a, fx, arg)
            if has_dunder(ck, pt, "__str__"):
                raise unsup(ck, "check_print#dunder")
    return 4

# `len(x)`: str/list/dict/tuple (sınıf `__len__` kapsam dışı).
def check_len(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    args: int = sl_at(a, c, 1)
    if pky(args) != 1:
        mp(ck, "'len' takes exactly 1 argument")
        raise mk_fail(ck, "ArgumentCountMismatch")
    t: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
    g: int = ck.tt.tag[t]
    if is_tuple_cls(ck, class_idx_of_type(ck, t)):
        return 0
    if has_dunder(ck, t, "__len__"):
        raise unsup(ck, "check_len#dunder")
    if t != 3 and g != 5 and g != 13:
        mp(ck, "'len' only works on str/list/dict/bytes/tuple (define `__len__` for classes)")
        raise mk_fail(ck, "TypeMismatch")
    return 0

# ---- yerleşik dönüşüm/ölçü çağrıları (Zig `checkCallInner` yerleşik dalları; 3.10 dilim B) ----
# `FixedIntKind` adı -> tür sırası (u8 0 ... isize 9); değilse -1.
def fixed_kind_of(a: Ast, v: int) -> int:
    if sref_eq(a, v, "u8"):
        return 0
    if sref_eq(a, v, "u16"):
        return 1
    if sref_eq(a, v, "u32"):
        return 2
    if sref_eq(a, v, "u64"):
        return 3
    if sref_eq(a, v, "usize"):
        return 4
    if sref_eq(a, v, "i8"):
        return 5
    if sref_eq(a, v, "i16"):
        return 6
    if sref_eq(a, v, "i32"):
        return 7
    if sref_eq(a, v, "i64"):
        return 8
    if sref_eq(a, v, "isize"):
        return 9
    return -1

# argüman listesinde anahtarlı (`kwarg`) argüman yok mu (Zig `positional == c.args.len`).
def all_positional(a: Ast, args: int) -> bool:
    for i in range(pky(args)):
        if a.n[stmt_at(a, args, i)] == 17:
            return False
    return True

def argc_fail(ck: Ck, a: Ast, cv: int, want: str) -> None:
    mp(ck, "'")
    mp_sref(ck, a, cv)
    mp(ck, "' takes exactly ")
    mp(ck, want)
    raise mk_fail(ck, "ArgumentCountMismatch")

# Bir yerleşik çağrının tek tip-argümanı: çıplak tanımlayıcı olmalı (değişken araması YAPILMAZ).
def builtin_type_arg(ck: Ck, a: Ast, args: int, i: int, msg_a: str, cv: int, msg_b: str) -> int:
    e: int = stmt_at(a, args, i)
    if a.n[e] != 5:
        mp(ck, msg_a)
        if len(msg_b) > 0:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, msg_b)
        raise mk_fail(ck, "TypeMismatch")
    return pk(a.n[e + 1], a.n[e + 2])

# `wasm_call(yol, işlev, argüman)` (wasm32-wasi hedefi dışında).
def check_wasm_call(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    if arg_n(a, c) != 3:
        fail2(ck, "ArgumentCountMismatch", "'wasm_call' takes exactly 3 arguments (path: str, function_name: str, argument: int)")
    if arg_e(ck, a, fx, c, 0) != 3:
        fail2(ck, "TypeMismatch", "argument 1 (path) of 'wasm_call' must be a str")
    if arg_e(ck, a, fx, c, 1) != 3:
        fail2(ck, "TypeMismatch", "argument 2 (function name) of 'wasm_call' must be a str")
    if arg_e(ck, a, fx, c, 2) != 0:
        fail2(ck, "TypeMismatch", "argument 3 (argument) of 'wasm_call' must be an int")
    return 0

# `lowlevel:` dışında ptr ailesi kullanımı (Zig `requireLowlevel`).
def ll_require(ck: Ck, fx: Fx, a: Ast, cv: int) -> None:
    if fx.ll_depth == 0:
        mp(ck, "'")
        mp_sref(ck, a, cv)
        mp(ck, "' can only be used inside a 'lowlevel:' block")
        raise mk_fail(ck, "LowlevelRequired")

def pf_argc(ck: Ck, a: Ast, cv: int, n: int, want: int, tail: str) -> None:
    if n != want:
        mp(ck, "'")
        mp_sref(ck, a, cv)
        if want == 0:
            mp(ck, "' takes no arguments")
        elif want == 1:
            mp(ck, "' takes exactly 1 argument")
            mp(ck, tail)
        else:
            mp(ck, "' takes exactly 2 arguments ")
            mp(ck, tail)
        raise mk_fail(ck, "ArgumentCountMismatch")

def pf_arg_fail(ck: Ck, a: Ast, cv: int, pre: str, post: str) -> None:
    mp(ck, pre)
    mp(ck, "'")
    mp_sref(ck, a, cv)
    mp(ck, post)
    raise mk_fail(ck, "TypeMismatch")

# ptr/lowlevel yerleşikleri (Zig `checkCallInner`, `ptr_from_int` ... `detach`); -1: bu ailenin adı değil.
def check_ptr_builtin(ck: Ck, a: Ast, fx: Fx, c: int, cv: int) -> int:
    args: int = sl_at(a, c, 1)
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, cv, "wasm_call"):
        return check_wasm_call(ck, a, fx, c)
    if sref_eq(a, cv, "ffi_box"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'ffi_box' takes exactly 1 argument (a function value)")
        if tt.tag[arg_e(ck, a, fx, c, 0)] != 14:
            fail2(ck, "TypeMismatch", "'ffi_box' takes a function value")
        return 5
    if sref_eq(a, cv, "ptr_from_int"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        if arg_e(ck, a, fx, c, 0) != 0:
            fail2(ck, "TypeMismatch", "'ptr_from_int' takes an int")
        return 5
    if sref_eq(a, cv, "ptr_to_int"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        xt: int = arg_e(ck, a, fx, c, 0)
        if xt != 5 and tt.tag[xt] != 17:
            fail2(ck, "TypeMismatch", "'ptr_to_int' takes a ptr or ptr[T]")
        return 0
    if sref_eq(a, cv, "ptr_of"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, " (a list variable or field)")
        a0: int = stmt_at(a, args, 0)
        if a.n[a0] != 5 and a.n[a0] != 9:
            fail2(ck, "TypeMismatch", "'ptr_of' can only be applied to a variable or a field — not to the result of an expression (its data pointer would outlive the temporary)")
        lt: int = check_expr(ck, a, fx, a0)
        if tt.tag[lt] != 5:
            fail2(ck, "TypeMismatch", "'ptr_of' takes a list[T]")
        pe: int = tt.xa[lt]
        if pe != 0 and pe != 1 and tt.tag[pe] != 16:
            fail2(ck, "TypeMismatch", "'ptr_of' supports list[int], list[float] and lists of fixed-width integers only")
        return ty_mk(tt, 17, pe, 0)
    if sref_eq(a, cv, "ptr_add"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 2, "(p: ptr, n: int)")
        if arg_e(ck, a, fx, c, 0) != 5:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr")
        if arg_e(ck, a, fx, c, 1) != 0:
            pf_arg_fail(ck, a, cv, "argument 2 (n) of ", "' must be an int")
        return 5
    if sref_eq(a, cv, "ptr_read_int") or sref_eq(a, cv, "ptr_read_float") or sref_eq(a, cv, "ptr_read_bool"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        if arg_e(ck, a, fx, c, 0) != 5:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes a ptr")
            raise mk_fail(ck, "TypeMismatch")
        if sref_eq(a, cv, "ptr_read_int"):
            return 0
        if sref_eq(a, cv, "ptr_read_float"):
            return 1
        return 2
    if sref_eq(a, cv, "ptr_write_int") or sref_eq(a, cv, "ptr_write_float") or sref_eq(a, cv, "ptr_write_bool"):
        ll_require(ck, fx, a, cv)
        wt: int = 0
        wn: str = "an int"
        wl: str = "(p: ptr, v: int)"
        if sref_eq(a, cv, "ptr_write_float"):
            wt = 1
            wn = "a float"
            wl = "(p: ptr, v: float)"
        elif sref_eq(a, cv, "ptr_write_bool"):
            wt = 2
            wn = "a bool"
            wl = "(p: ptr, v: bool)"
        pf_argc(ck, a, cv, n, 2, wl)
        if arg_e(ck, a, fx, c, 0) != 5:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr")
        if arg_e(ck, a, fx, c, 1) != wt:
            pf_arg_fail(ck, a, cv, "argument 2 (v) of ", "' must be " + wn)
        return 4
    if sref_eq(a, cv, "ptr_offset"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 2, "(p: ptr[T], n: int)")
        ot: int = arg_e(ck, a, fx, c, 0)
        if tt.tag[ot] != 17:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr[T]")
        if arg_e(ck, a, fx, c, 1) != 0:
            pf_arg_fail(ck, a, cv, "argument 2 (n) of ", "' must be an int")
        return ot
    if sref_eq(a, cv, "ptr_read") or sref_eq(a, cv, "ptr_read_volatile"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        rt0: int = arg_e(ck, a, fx, c, 0)
        if tt.tag[rt0] != 17:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes a ptr[T]")
            raise mk_fail(ck, "TypeMismatch")
        return tt.xa[rt0]
    if sref_eq(a, cv, "ptr_write") or sref_eq(a, cv, "ptr_write_volatile"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 2, "(p: ptr[T], v: T)")
        wp: int = arg_e(ck, a, fx, c, 0)
        if tt.tag[wp] != 17:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr[T]")
        if arg_e(ck, a, fx, c, 1) != tt.xa[wp]:
            pf_arg_fail(ck, a, cv, "argument 2 (v) of ", "' must have the SAME type as the T of p")
        return 4
    if sref_eq(a, cv, "memory_fence") or sref_eq(a, cv, "compiler_fence"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 0, "")
        return 4
    if sref_eq(a, cv, "detach"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        d0: int = stmt_at(a, args, 0)
        if a.n[d0] != 5:
            fail2(ck, "TypeMismatch", "'detach' can only be applied to a plain local variable — not to a class field or the result of an expression")
        dt: int = check_expr(ck, a, fx, d0)
        dg: int = tt.tag[dt]
        if dg != 5 and dg != 13 and dg != 6 and dt != 3:
            fail2(ck, "TypeMismatch", "'detach' can only be applied to a variable of type list/dict/class/str")
        return 5
    return -1

# -1: `cv` bu dilimin yerleşiklerinden biri değil (normal çağrı yolu sürer); aksi halde sonuç tipi.
def check_builtin_call(ck: Ck, a: Ast, fx: Fx, c: int, cv: int) -> int:
    args: int = sl_at(a, c, 1)
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, cv, "__nox_bind_method"):
        raise unsup(ck, "check_call#bind_method")
    if sref_eq(a, cv, "__nox_str_chars"):
        if n != 1:
            mp(ck, "'__nox_str_chars' (internal) takes exactly 1 argument")
            raise mk_fail(ck, "ArgumentCountMismatch")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 3:
            mp(ck, "'__nox_str_chars' (internal) expects a str")
            raise mk_fail(ck, "TypeMismatch")
        return ty_list(tt, 3)
    if sref_eq(a, cv, "__nox_hash"):
        if n != 1:
            mp(ck, "'__nox_hash' (internal) takes exactly 1 argument")
            raise mk_fail(ck, "ArgumentCountMismatch")
        check_expr(ck, a, fx, stmt_at(a, args, 0))
        return 0
    if sref_eq(a, cv, "super"):
        mp(ck, "'super()' can only be used in the 'super().method(...)' or 'super().__init__(...)' form, directly as the receiver of a method call")
        raise mk_fail(ck, "TypeMismatch")
    # `int(s, taban)` (2 konumsal argüman) prelude'a yönlendirilir (`__nox_int_base`): kapsam dışı
    if sref_eq(a, cv, "int") and n == 2 and all_positional(a, args):
        raise unsup(ck, "check_call#prelude")
    if sref_eq(a, cv, "repr") and m2_get(ck.fmap, 0, sym_of(ck, a, cv)) < 0:
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        rt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if tt.tag[rt] == 14 or rt == 4:
            mp(ck, "'repr' does not work on function/None values")
            raise mk_fail(ck, "TypeMismatch")
        return 3
    if sref_eq(a, cv, "bytes"):
        bsym: int = sym_of(ck, a, cv)
        if m2_get(ck.fmap, 0, bsym) < 0 and class_idx(ck, bsym) < 0:
            raise unsup(ck, "check_call#bytes")
        return -1
    if sref_eq(a, cv, "str"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        st: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if has_dunder(ck, st, "__str__"):
            raise unsup(ck, "check_str#dunder")
        sg: int = tt.tag[st]
        if sg == 5 or sg == 13 or sg == 6:
            return 3
        if st != 0 and st != 1 and st != 3 and st != 2 and sg != 16:
            mp(ck, "'str' works on int/float/str/bool/list/dict/class (for an Optional, narrow out None first)")
            raise mk_fail(ck, "TypeMismatch")
        return 3
    if sref_eq(a, cv, "int"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        it: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if it != 3 and it != 1 and it != 2 and tt.tag[it] != 16:
            mp(ck, "'int' only works on str/float/bool/fixed-width integers")
            raise mk_fail(ck, "TypeMismatch")
        return 0
    if sref_eq(a, cv, "float"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        ft: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ft != 3 and ft != 0 and ft != 1 and ft != 2 and tt.tag[ft] != 16:
            mp(ck, "'float' only works on str/int/float/bool/fixed-width integers")
            raise mk_fail(ck, "TypeMismatch")
        return 1
    fk: int = fixed_kind_of(a, cv)
    if fk >= 0:
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        xt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if xt != 0 and xt != 1 and tt.tag[xt] != 16:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' only works on int/float/fixed-width integer types")
            raise mk_fail(ck, "TypeMismatch")
        return 6 + fk
    if sref_eq(a, cv, "sizeof") or sref_eq(a, cv, "alignof"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        tn: int = builtin_type_arg(ck, a, args, 0, "the argument of ", cv, "' must be a type name (a bare identifier)")
        simple_type(ck, a, tn)
        return 10
    if sref_eq(a, cv, "offsetof"):
        if n != 2:
            mp(ck, "'offsetof' takes exactly 2 arguments (Class, \"field\")")
            raise mk_fail(ck, "ArgumentCountMismatch")
        cn: int = builtin_type_arg(ck, a, args, 0, "argument 1 of 'offsetof' must be a class name (a bare identifier)", cv, "")
        ot: int = simple_type(ck, a, cn)
        if tt.tag[ot] != 6:
            mp(ck, "'offsetof' only works on a class type: ")
            mp_sref(ck, a, cn)
            raise mk_fail(ck, "TypeMismatch")
        fe: int = stmt_at(a, args, 1)
        if a.n[fe] != 3:
            mp(ck, "argument 2 of 'offsetof' can only be a string LITERAL")
            raise mk_fail(ck, "TypeMismatch")
        oci: int = class_idx_of_type(ck, ot)
        if oci < 0:
            mp(ck, "unknown class: ")
            mp_sym(ck, tt.xa[ot])
            raise mk_fail(ck, "UndefinedClass")
        fnm: int = pk(a.n[fe + 1], a.n[fe + 2])
        if m2_get(ck.cls_fields, oci, sym_of(ck, a, fnm)) < 0:
            mp(ck, "class '")
            mp_sym(ck, ck.cls_sym[oci])
            mp(ck, "' has no field '")
            mp_sref(ck, a, fnm)
            mp(ck, "'")
            raise mk_fail(ck, "UndefinedAttribute")
        return 10
    return check_ptr_builtin(ck, a, fx, c, cv)

# Zig'de ayrı yolu olan (prelude yönlendirmesi, ptr/lowlevel ailesi, dahili `__nox_*`) ama bu dilimde taşınmayan ad: kapsam dışı etiketi; "" = yok.
def call_gap_label(ck: Ck, a: Ast, cv: int, fi: int, ci: int) -> str:
    if sref_len(cv) >= 6 and sref_byte(a, cv, 0) == 95 and sref_byte(a, cv, 1) == 95 and sref_byte(a, cv, 2) == 110 and sref_byte(a, cv, 3) == 111 and sref_byte(a, cv, 4) == 120 and sref_byte(a, cv, 5) == 95:
        return "check_call#internal"
    # `adopt(p)`: beklenen-tip bağlamı (`checkExprExpected` dalı) taşınmadı
    if sref_eq(a, cv, "adopt"):
        return "check_call#lowlevel"
    # `tryDesugarPreludeCall`: kullanıcı aynı adlı (prelude-dışı) işlev/sınıf tanımlamadıysa çağrı prelude yardımcılarına yönlendirilir
    prel: bool = False
    if sref_eq(a, cv, "max") or sref_eq(a, cv, "min") or sref_eq(a, cv, "sorted") or sref_eq(a, cv, "sum") or sref_eq(a, cv, "round") or sref_eq(a, cv, "map") or sref_eq(a, cv, "filter") or sref_eq(a, cv, "any") or sref_eq(a, cv, "all"):
        return "check_call#prelude"
    if sref_eq(a, cv, "list") or sref_eq(a, cv, "set") or sref_eq(a, cv, "bool") or sref_eq(a, cv, "next") or sref_eq(a, cv, "zip") or sref_eq(a, cv, "enumerate") or sref_eq(a, cv, "reversed"):
        prel = True
    if sref_eq(a, cv, "hex") or sref_eq(a, cv, "oct") or sref_eq(a, cv, "bin") or sref_eq(a, cv, "pow") or sref_eq(a, cv, "format"):
        prel = True
    if prel and fi < 0 and ci < 0:
        return "check_call#prelude"
    return ""

def check_call(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    callee: int = a.n[c + 0]
    if a.n[callee] == 9:
        return check_method_call(ck, a, fx, c, callee)
    if a.n[callee] != 5:
        raise unsup(ck, "check_call#1")
    cv: int = pk(a.n[callee + 1], a.n[callee + 2])
    if sref_eq(a, cv, "print"):
        return check_print(ck, a, fx, c)
    if sref_eq(a, cv, "len"):
        return check_len(ck, a, fx, c)
    bt: int = check_builtin_call(ck, a, fx, c, cv)
    if bt >= 0:
        return bt
    sym: int = sym_of(ck, a, cv)
    fi: int = m2_get(ck.fmap, 0, sym)
    ci: int = class_idx(ck, sym)
    gap: str = call_gap_label(ck, a, cv, fi, ci)
    if len(gap) > 0:
        raise unsup(ck, gap)
    # yerel değer çağrısı (Zig: önce kapsam): işlev-tipli değer kapsam dışı, diğeri hata
    lt: int = sc_lookup(ck, fx.scope, sym)
    if lt >= 0:
        if ck.tt.tag[lt] == 14:
            check_args_func_type(ck, a, fx, c, lt, sym)
            return ck.tt.xb[lt]
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "' is not a function and cannot be called")
        raise mk_fail(ck, "TypeMismatch")
    if fi < 0 and ci < 0:
        # `from X.Y import foo [as bar]` ile bağlanan çıplak çağrı (yerel tanım her zaman öncelikli)
        fie: int = m2_get(ck.fimp, 0, sym)
        if fie >= 0:
            return resolve_mangled_call(ck, a, fx, c, ck.fimp.vv[fie], 0, sym, ck.fimp.vv[fie])
        mp(ck, "undefined function or class: ")
        mp_sym(ck, sym)
        raise mk_fail(ck, "UndefinedFunction")
    if fi >= 0 and m2_get(ck.afn, 0, sym) >= 0:
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "' is an 'async def' function and can only be started with 'spawn'")
        raise mk_fail(ck, "TypeMismatch")
    if fi >= 0:
        sid: int = ck.fmap.vv[fi]
        check_args_sig(ck, a, fx, c, sid, sym)
        return ck.fret[sid]
    isid: int = ck.cls_init[ci]
    if isid < 0:
        isid = ck.sig_empty
    check_args_sig(ck, a, fx, c, isid, sym)
    return ty_class(ck.tt, sym)

# ---- deyimler ----
def declare_var_checked(ck: Ck, fx: Fx, sym: int, ty: int) -> None:
    if declare_var(ck, fx.scope, sym, ty) != 0:
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "' is already defined in this scope with type '")
        mp_type(ck, ck.e_prev)
        mp(ck, "'; it cannot be redefined with type '")
        mp_type(ck, ty)
        mp(ck, "' (use a different name)")
        raise mk_fail(ck, "TypeMismatch")

def check_block(ck: Ck, a: Ast, fx: Fx, s: int) -> None:
    for i in range(pky(s)):
        check_stmt(ck, a, fx, stmt_at(a, s, i))

def check_stmt(ck: Ck, a: Ast, fx: Fx, st: int) -> None:
    ck.cur_line = a.n[st + 1]
    ck.cur_span = a.n[st + 2]
    kn: int = a.n[st + 0]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    if tag == 0:
        grow_stmt_gate(ck, a, fx, pay)
        check_expr(ck, a, fx, pay)
        return
    if tag == 1:
        nm: int = pk(a.n[pay + 0], a.n[pay + 0 + 1])
        if sref_len(nm) >= 10 and sref_byte(a, nm, 0) == 95 and sref_byte(a, nm, 1) == 95 and sref_byte(a, nm, 2) == 110:
            raise unsup(ck, "check_stmt#1")
        if a.n[pay + 7] != 0:
            raise unsup(ck, "check_stmt#2")
        declared: int = type_expr_to_type(ck, a, a.n[pay + 2])
        value_t: int = check_expr_expected(ck, a, fx, a.n[pay + 3], declared)
        if not ty_assignable(ck.tt, declared, value_t):
            mp(ck, "type mismatch for '")
            mp_sref(ck, a, nm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        declare_var_checked(ck, fx, sym_of(ck, a, nm), declared)
        return
    if tag == 3:
        check_assign(ck, a, fx, pay)
        return
    if tag == 4:
        if a.n[pay + 8] >= 0:
            raise unsup(ck, "check_stmt#3")
        ct: int = check_expr(ck, a, fx, a.n[pay + 0])
        if ct != 2:
            mp(ck, "the 'if' condition must be a bool")
            raise mk_fail(ck, "TypeMismatch")
        check_block(ck, a, fx, sl_at(a, pay, 1))
        ecs: int = sl_at(a, pay, 3)
        for j in range(pky(ecs)):
            ec: int = stmt_at(a, ecs, j)
            ect: int = check_expr(ck, a, fx, a.n[ec + 0])
            if ect != 2:
                mp(ck, "the 'elif' condition must be a bool")
                raise mk_fail(ck, "TypeMismatch")
            check_block(ck, a, fx, sl_at(a, ec, 1))
        if a.n[pay + 5] != -4611686018427387904:
            check_block(ck, a, fx, sl_at(a, pay, 5))
        return
    if tag == 5:
        wt: int = check_expr(ck, a, fx, a.n[pay + 0])
        if wt != 2:
            mp(ck, "the 'while' condition must be a bool")
            raise mk_fail(ck, "TypeMismatch")
        fx.loop = fx.loop + 1
        try:
            check_block(ck, a, fx, sl_at(a, pay, 1))
        finally:
            fx.loop = fx.loop - 1
        return
    if tag == 11:
        if fx.ret < 0:
            mp(ck, "'return' can only be used inside a function/method")
            raise mk_fail(ck, "TypeMismatch")
        if pay >= 0:
            rt: int = check_expr_expected(ck, a, fx, pay, fx.ret)
            if not ty_assignable(ck.tt, fx.ret, rt):
                mp(ck, "return type mismatch")
                raise mk_fail(ck, "TypeMismatch")
        elif fx.ret != 4:
            mp(ck, "the function must return a value")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == 6:
        if a.n[pay + 6] != 0:
            raise unsup(ck, "check_stmt#async_for")
        it: int = a.n[pay + 2]
        elem_t: int = check_for_iterable(ck, a, fx, it)
        vn: int = pk(a.n[pay + 0], a.n[pay + 0 + 1])
        declare_var_checked(ck, fx, sym_of(ck, a, vn), elem_t)
        fx.loop = fx.loop + 1
        try:
            check_block(ck, a, fx, sl_at(a, pay, 3))
        finally:
            fx.loop = fx.loop - 1
        return
    if tag == 17:
        return
    if tag == 18:
        if fx.loop == 0:
            mp(ck, "'break' can only be used inside a 'while'/'for' loop")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == 19:
        if fx.loop == 0:
            mp(ck, "'continue' can only be used inside a 'while'/'for' loop")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == 12:
        rzt: int = check_expr(ck, a, fx, pay)
        if ck.tt.tag[rzt] != 6:
            mp(ck, "'raise' can only take a class instance")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == 20:
        if a.n[pay] != 10:
            mp(ck, "'del' only takes an index target (del d[key])")
            raise mk_fail(ck, "TypeMismatch")
        dip: int = a.n[pay + 1]
        dobj: int = check_expr(ck, a, fx, a.n[dip + 0])
        didx: int = check_expr(ck, a, fx, a.n[dip + 1])
        dg: int = ck.tt.tag[dobj]
        if dg == 13:
            if didx != ck.tt.xa[dobj]:
                mp(ck, "the 'del' key does not match the dict's key type")
                raise mk_fail(ck, "TypeMismatch")
        elif dg == 5:
            if didx != 0:
                mp(ck, "the 'del' list index must be an 'int'")
                raise mk_fail(ck, "TypeMismatch")
        else:
            mp(ck, "'del' only works on list[i] or dict[key]")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == 10:
        mp(ck, "'extern def' is only allowed at module level")
        raise mk_fail(ck, "TypeMismatch")
    if tag == 13:
        check_try(ck, a, fx, pay)
        return
    if tag == 14:
        # gövdede tanımlanan adlar bloktan sonra kapsam dışına alınır (arena blok çıkışında yıkılır)
        before: list[int] = scope_live_names(ck, fx.scope)
        fx.ll_depth = fx.ll_depth + 1
        try:
            check_block(ck, a, fx, sl_at(a, pay, 0))
        finally:
            fx.ll_depth = fx.ll_depth - 1
        for li in range(len(ck.vars.k1)):
            if ck.vars.k1[li] == fx.scope and ck.vars.dead[li] == 0:
                kn2: int = ck.vars.k2[li]
                known: bool = False
                for bi in range(len(before)):
                    if before[bi] == kn2:
                        known = True
                        break
                if not known:
                    m2_remove(ck.vars, fx.scope, kn2)
        return
    if tag == 21:
        if a.n[pay + 5] != 0:
            raise unsup(ck, "check_stmt#async_with")
        check_with(ck, a, fx, pay)
        return
    if tag == 7:
        if pky(sl_at(a, pay, 2)) > 0:
            mp(ck, "a nested function definition CANNOT be generic: ")
            mp_sref(ck, a, pk(a.n[pay + 0], a.n[pay + 0 + 1]))
            raise mk_fail(ck, "TypeMismatch")
        if a.n[pay + 10] != 0:
            raise unsup(ck, "stmt_kind#nested_async")
        if pky(sl_at(a, pay, 11)) > 0 or pky(sl_at(a, pay, 15)) > 0 or a.n[pay + 19] != 0:
            raise unsup(ck, "stmt_kind#nested_features")
        ft: int = check_nested_def(ck, a, fx, pay)
        sc_declare(ck, fx.scope, sym_of(ck, a, pk(a.n[pay + 0], a.n[pay + 0 + 1])), ft)
        return
    if tag == 22:
        check_defer(ck, a, fx, pay)
        return
    raise unsup(ck, "stmt_kind#" + str(tag))

# `checkNestedFuncDef`: gövde, dış kapsamı üst zincir (yakalama kaydıyla) olan yeni kapsamda denetlenir; sonuç işlev tipi.
def check_nested_def(ck: Ck, a: Ast, fx: Fx, fd: int) -> int:
    inner: int = sc_new(ck, fx.scope, True)
    ps: int = sl_at(a, fd, 4)
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        sc_declare(ck, inner, sym_of(ck, a, pk(a.n[p + 0], a.n[p + 0 + 1])), type_expr_to_type(ck, a, a.n[p + 6]))
    ret: int = type_expr_to_type(ck, a, a.n[fd + 6])
    ifx: Fx = Fx(inner, ret, False)
    body: int = sl_at(a, fd, 8)
    check_block(ck, a, ifx, body)
    if ret != 4 and not always_returns(a, body):
        mp(ck, "nested function '")
        mp_sref(ck, a, pk(a.n[fd + 0], a.n[fd + 0 + 1]))
        mp(ck, "' does not return a value on all paths")
        raise mk_fail(ck, "MissingReturn")
    tys: list[int] = []
    for j in range(pky(ps)):
        tys.append(type_expr_to_type(ck, a, a.n[stmt_at(a, ps, j) + 6]))
    ty_func_begin(ck.tt)
    for k in range(len(tys)):
        ty_func_param(ck.tt, tys[k])
    return ty_func_end(ck.tt, ret)

# `checkLambda`: beklenen işlev tipi gerekir; gövde (ifade) `return`/ifade deyimi olarak iç kapsamda denetlenir.
def check_lambda(ck: Ck, a: Ast, fx: Fx, e: int, expected: int) -> int:
    lam: int = a.n[e + 1]
    if expected < 0:
        fail2(ck, "TypeMismatch", "'lambda' can only be used where the expected function type is known (a function-typed parameter/variable/return)")
    tt: TT = ck.tt
    if tt.tag[expected] != 14:
        fail2(ck, "TypeMismatch", "'lambda' can only be used where a function type is expected")
    lps: int = sl_at(a, lam, 0)
    if tt.xc[expected] != pky(lps):
        mp(ck, "the lambda takes ")
        mp_int(ck, pky(lps))
        mp(ck, " parameters but the expected function type takes ")
        mp_int(ck, tt.xc[expected])
        mp(ck, " parameters")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if ck.comp_depth > 0:
        fail2(ck, "TypeMismatch", "'lambda' is not supported inside a comprehension — assign it to a variable first")
    inner: int = sc_new(ck, fx.scope, True)
    for i in range(pky(lps)):
        sc_declare(ck, inner, sym_of(ck, a, pk(a.l[pkx(lps) + i * 2], a.l[pkx(lps) + i * 2 + 1])), tt.fp[tt.xa[expected] + i])
    ret: int = tt.xb[expected]
    ifx: Fx = Fx(inner, ret, False)
    body: int = a.n[lam + 2]
    if ret == 4:
        grow_stmt_gate(ck, a, ifx, body)
        check_expr(ck, a, ifx, body)
    else:
        rt: int = check_expr_expected(ck, a, ifx, body, ret)
        if not ty_assignable(tt, ret, rt):
            mp(ck, "return type mismatch")
            raise mk_fail(ck, "TypeMismatch")
    # modül düzeyindeki lambda yalnız modül-global'lerini yakalayabilir (Zig `closure_infos` HashMap sırası: ≥2 ihlalde sıra taklit edilemez)
    if fx.ret < 0:
        bad: int = 0
        bsym: int = -1
        for ce in range(len(ck.caps.k1)):
            if ck.caps.k1[ce] == ck.sc[inner] and ck.caps.dead[ce] == 0 and m2_get(ck.globs, 0, ck.caps.k2[ce]) < 0:
                bad = bad + 1
                bsym = ck.caps.k2[ce]
        if bad > 1:
            raise unsup(ck, "lambda#captures_order")
        if bad == 1:
            mp(ck, "a module-level lambda cannot capture the local variable '")
            mp_sym(ck, bsym)
            mp(ck, "' defined inside a loop/block — use the lambda inside a function, or define the variable at the top level")
            raise mk_fail(ck, "TypeMismatch")
    return expected

# `checkDeferStmt`: çağrı, `None` dönen sentetik iç içe işlevin gövdesi olarak denetlenir (yakalamalar kapanış gibi).
def check_defer(ck: Ck, a: Ast, fx: Fx, d: int) -> None:
    if fx.ret < 0:
        fail2(ck, "TypeMismatch", "'defer' can only be used inside a function/method")
    ce: int = len(a.n)
    a.n.append(8)
    a.n.append(a.n[d])
    inner: int = sc_new(ck, fx.scope, True)
    ifx: Fx = Fx(inner, 4, False)
    ck.cur_span = -1
    grow_stmt_gate(ck, a, ifx, ce)
    check_expr(ck, a, ifx, ce)

def scope_live_names(ck: Ck, scope: int) -> list[int]:
    out: list[int] = []
    for i in range(len(ck.vars.k1)):
        if ck.vars.k1[i] == scope and ck.vars.dead[i] == 0:
            out.append(ck.vars.k2[i])
    return out

# `checkTry`: try gövdesi, `except [Sınıf [as ad]]` yan tümceleri (noktalı ad kapsam dışı), `finally`.
def check_try(ck: Ck, a: Ast, fx: Fx, t: int) -> None:
    exs: int = sl_at(a, t, 2)
    for q in range(pky(exs)):
        qc: int = a.n[stmt_at(a, exs, q) + 0]
        if qc != -4611686018427387904:
            cn0: int = pk(a.n[stmt_at(a, exs, q) + 0], a.n[stmt_at(a, exs, q) + 0 + 1])
            for dq in range(sref_len(cn0)):
                if sref_byte(a, cn0, dq) == 46:
                    raise unsup(ck, "try#dotted")
    check_block(ck, a, fx, sl_at(a, t, 0))
    for k in range(pky(exs)):
        ec: int = stmt_at(a, exs, k)
        if a.n[ec + 0] == -4611686018427387904:
            check_block(ck, a, fx, sl_at(a, ec, 4))
            continue
        cn: int = pk(a.n[ec + 0], a.n[ec + 0 + 1])
        csym: int = sym_of(ck, a, cn)
        if class_idx(ck, csym) < 0:
            # `from X import Err`: mangled sınıfa çözülür (bind tipi de mangled sınıf)
            cfe: int = m2_get(ck.fimp, 0, csym)
            if cfe >= 0 and class_idx(ck, ck.fimp.vv[cfe]) >= 0:
                csym = ck.fimp.vv[cfe]
        if class_idx(ck, csym) < 0:
            mp(ck, "unknown class: ")
            mp_sref(ck, a, cn)
            raise mk_fail(ck, "UndefinedClass")
        if a.n[ec + 2] != -4611686018427387904:
            bn: int = pk(a.n[ec + 2], a.n[ec + 2 + 1])
            declare_var_checked(ck, fx, sym_of(ck, a, bn), ty_class(ck.tt, csym))
        check_block(ck, a, fx, sl_at(a, ec, 4))
    if a.n[t + 4] != -4611686018427387904:
        check_block(ck, a, fx, sl_at(a, t, 4))

# `checkWith`: `with E as ad:` — `E` bir sınıf örneği; argümansız `__enter__`/`__exit__` (`__exit__ -> None`).
def check_with(ck: Ck, a: Ast, fx: Fx, w: int) -> None:
    ct: int = check_expr(ck, a, fx, a.n[w + 0])
    if ck.tt.tag[ct] != 6:
        mp(ck, "'with' only works on a class instance")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, ct)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, ck.tt.xa[ct])
        raise mk_fail(ck, "UndefinedClass")
    ee: int = m2_get(ck.cls_meths, ci, sym_lit(ck, "__enter__"))
    if ee < 0:
        mp(ck, "class '")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, "' has no '__enter__' method (required for 'with')")
        raise mk_fail(ck, "UndefinedMethod")
    esid: int = ck.cls_meths.vv[ee]
    if ck.fpn[esid] != 0:
        mp(ck, "'")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, ".__enter__' MUST NOT take any arguments")
        raise mk_fail(ck, "TypeMismatch")
    xe: int = m2_get(ck.cls_meths, ci, sym_lit(ck, "__exit__"))
    if xe < 0:
        mp(ck, "class '")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, "' has no '__exit__' method (required for 'with')")
        raise mk_fail(ck, "UndefinedMethod")
    xsid: int = ck.cls_meths.vv[xe]
    if ck.fpn[xsid] != 0:
        mp(ck, "'")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, ".__exit__' MUST NOT take any arguments")
        raise mk_fail(ck, "TypeMismatch")
    if ck.fret[xsid] != 4:
        mp(ck, "'")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, ".__exit__' MUST return None")
        raise mk_fail(ck, "TypeMismatch")
    if a.n[w + 1] != -4611686018427387904:
        bnd: int = pk(a.n[w + 1], a.n[w + 1 + 1])
        declare_var_checked(ck, fx, sym_of(ck, a, bnd), ck.fret[esid])
    check_block(ck, a, fx, sl_at(a, w, 3))

# `checkForIterable`: range(...) / list / str / dict (sınıf yineleyicisi, enumerate/zip kaynaşımı kapsam dışı). Dönüş: eleman tipi.
def check_for_iterable(ck: Ck, a: Ast, fx: Fx, it: int) -> int:
    if a.n[it] == 8:
        c: int = a.n[it + 1]
        callee: int = a.n[c + 0]
        if a.n[callee] == 5:
            cv: int = pk(a.n[callee + 1], a.n[callee + 2])
            if sref_eq(a, cv, "enumerate") or sref_eq(a, cv, "zip"):
                raise unsup(ck, "check_for_iterable#enumerate_zip")
            if sref_eq(a, cv, "range"):
                args: int = sl_at(a, c, 1)
                n: int = pky(args)
                if n < 1 or n > 3:
                    mp(ck, "'range' takes 1, 2 or 3 arguments (stop | start, stop | start, stop, step)")
                    raise mk_fail(ck, "ArgumentCountMismatch")
                for i in range(n):
                    at_: int = check_expr(ck, a, fx, stmt_at(a, args, i))
                    if at_ != 0:
                        mp(ck, "'range' expects an int argument")
                        raise mk_fail(ck, "TypeMismatch")
                if n == 3:
                    sa: int = stmt_at(a, args, 2)
                    if a.n[sa] == 0 and a.n[sa + 1] == 0:
                        mp(ck, "the 'range' step cannot be zero")
                        raise mk_fail(ck, "TypeMismatch")
                return 0
    t: int = check_expr(ck, a, fx, it)
    tt: TT = ck.tt
    g: int = tt.tag[t]
    if g == 6 and (has_dunder(ck, t, "__next__") or has_dunder(ck, t, "__iter__")):
        raise unsup(ck, "check_for_iterable#dunder")
    if g == 5:
        return tt.xa[t]
    if t == 3:
        return 3
    if g == 13:
        return tt.xa[t]
    mp(ck, "'for' cannot iterate over this expression (it must be a list/str/dict/range or a class with `__iter__`)")
    raise mk_fail(ck, "NotIterable")

# ---- sınıf yardımcıları (3.4a) ----
def class_idx(ck: Ck, sym: int) -> int:
    e: int = m2_get(ck.cls_map, 0, sym)
    if e < 0:
        return -1
    return ck.cls_map.vv[e]

def class_idx_of_type(ck: Ck, t: int) -> int:
    if ck.tt.tag[t] != 6:
        return -1
    return class_idx(ck, ck.tt.xa[t])

def sym_lit(ck: Ck, s: str) -> int:
    xs: list[int] = []
    for i in range(len(s)):
        xs.append(ord(s[i]))
    return sym_intern_list(ck.tt, xs, 0, len(xs))

# ---- 3.12 modül sistemi/import (Zig `collectImports`, `substituteAlias`, `resolveMangledCall`, `tryResolveQualifiedCall`, `resolveReExportChains`) ----
# Ham `check` kipi: tek dosya, yükleyici yok (`module_exports` boş, `requirePublic`/`validateModuleExports` işlemsiz); içe aktarılan modülün tanımları hiç yoktur, mangled adlar yalnız dosyada elle tanımlıysa bulunur.
# `segs` öğelerinin ilk `n` tanesini `sep` (46 = '.', 95 = '_') ile birleştirip sembole çevirir (Zig `joinSegments`).
def join_syms(ck: Ck, segs: list[int], n: int, sep: int) -> int:
    tt: TT = ck.tt
    bs: list[int] = []
    for i in range(n):
        if i > 0:
            bs.append(sep)
        o: int = tt.so[segs[i]]
        for j in range(tt.sl[segs[i]]):
            bs.append(tt.sb[o + j])
    return sym_intern_list(tt, bs, 0, len(bs))

# AST dize listesi (2 sözcüklük öğeler: `ImportStmt.segments`, `TypeExpr.qualified`) -> sembol listesi.
def seg_syms(ck: Ck, a: Ast, node: int, off: int) -> list[int]:
    s: int = sl_at(a, node, off)
    out: list[int] = []
    for i in range(pky(s)):
        out.append(sym_of(ck, a, pk(a.l[pkx(s) + i * 2], a.l[pkx(s) + i * 2 + 1])))
    return out

def alias_put(ck: Ck, al: int, segs: list[int]) -> None:
    off: int = len(ck.alp)
    ck.alp.append(len(segs))
    for i in range(len(segs)):
        ck.alp.append(segs[i])
    m2_put(ck.alias, 0, al, off)

# Zig `substituteAlias`: ilk segment bir modül takma adıysa hedef modülün segmentleriyle değiştirilir.
def subst_alias(ck: Ck, segs: list[int]) -> list[int]:
    if len(segs) == 0:
        return segs
    e: int = m2_get(ck.alias, 0, segs[0])
    if e < 0:
        return segs
    off: int = ck.alias.vv[e]
    out: list[int] = []
    for i in range(ck.alp[off]):
        out.append(ck.alp[off + 1 + i])
    for j in range(len(segs) - 1):
        out.append(segs[j + 1])
    return out

# Zig `checkModuleCapabilitiesAllowed` (varsayılan yapılandırma: hosted profil, wasm/mobil/`--deny-capability` yok): yalnız `nox.arch` (`arch_x86_64` yeteneği, yalnız freestanding sağlar) reddedilir.
def check_module_caps(ck: Ck, segs: list[int]) -> None:
    if len(segs) < 2 or segs[0] != sym_lit(ck, "nox"):
        return
    if segs[1] == sym_lit(ck, "arch"):
        mp(ck, "module 'nox.")
        mp_sym(ck, segs[1])
        mp(ck, "' cannot be used in the 'hosted' profile (required capability: 'arch_x86_64' — this profile does not provide it; it is only available in 'freestanding')")
        raise mk_fail(ck, "HostedModuleForbidden")

# Zig `collectImports` (Geçiş 0): `imported_modules`, `module_aliases`, `from_imports`, `from_imports_orig_name`.
def collect_imports(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + 1]
        ck.cur_span = a.n[st + 2]
        kn: int = a.n[st + 0]
        pay: int = a.n[kn + 1]
        if a.n[kn] == 15:
            segs: list[int] = seg_syms(ck, a, pay, 0)
            m2_put(ck.imod, 0, join_syms(ck, segs, len(segs), 46), 1)
            if a.n[pay + 2] != -4611686018427387904:
                alias_put(ck, sym_of(ck, a, pk(a.n[pay + 2], a.n[pay + 2 + 1])), segs)
            check_module_caps(ck, segs)
        elif a.n[kn] == 16:
            fsegs: list[int] = seg_syms(ck, a, pay, 0)
            m2_put(ck.imod, 0, join_syms(ck, fsegs, len(fsegs), 46), 1)
            names: int = sl_at(a, pay, 2)
            for k in range(pky(names)):
                nm: int = a.l[pkx(names) + k]
                nsym: int = sym_of(ck, a, pk(a.n[nm + 0], a.n[nm + 0 + 1]))
                full: list[int] = []
                for q in range(len(fsegs)):
                    full.append(fsegs[q])
                full.append(nsym)
                local: int = nsym
                if a.n[nm + 2] != -4611686018427387904:
                    local = sym_of(ck, a, pk(a.n[nm + 2], a.n[nm + 2 + 1]))
                m2_put(ck.fimp, 0, local, join_syms(ck, full, len(full), 95))
                m2_put(ck.forig, 0, local, nsym)
            check_module_caps(ck, fsegs)

# Birleştirilmiş gövdede `mangled` adlı üst-düzey değişken/sabit bildirimi var mı (Zig `moduleDeclaresVar`).
def module_declares_var(ck: Ck, a: Ast, body: int, ms: int) -> bool:
    for i in range(pky(body)):
        kn: int = a.n[stmt_at(a, body, i) + 0]
        if a.n[kn] == 1:
            vd: int = a.n[kn + 1]
            if sym_of(ck, a, pk(a.n[vd + 0], a.n[vd + 0 + 1])) == ms:
                return True
    return False

def name_resolves(ck: Ck, a: Ast, body: int, ms: int) -> bool:
    return class_idx(ck, ms) >= 0 or m2_get(ck.fmap, 0, ms) >= 0 or module_declares_var(ck, a, body, ms)

# Zig `resolveReExportChains` (idempotent; `registerSignatures`ten önce ve sonra): geçersiz `from_imports` girdilerini, aynı adı gerçekten tanımlayan başka bir `from` deyiminin mangled adıyla düzeltir.
def resolve_reexport(ck: Ck, a: Ast, body: int) -> None:
    ex: Map2 = Map2()
    for i in range(pky(body)):
        kn: int = a.n[stmt_at(a, body, i) + 0]
        if a.n[kn] != 16:
            continue
        pay: int = a.n[kn + 1]
        fsegs: list[int] = seg_syms(ck, a, pay, 0)
        names: int = sl_at(a, pay, 2)
        for k in range(pky(names)):
            nm: int = a.l[pkx(names) + k]
            nsym: int = sym_of(ck, a, pk(a.n[nm + 0], a.n[nm + 0 + 1]))
            if m2_get(ex, 0, nsym) >= 0:
                continue
            full: list[int] = []
            for q in range(len(fsegs)):
                full.append(fsegs[q])
            full.append(nsym)
            ms: int = join_syms(ck, full, len(full), 95)
            if name_resolves(ck, a, body, ms):
                m2_put(ex, 0, nsym, ms)
    fk: list[int] = []
    fv: list[int] = []
    for e in range(len(ck.fimp.k1)):
        if ck.fimp.dead[e] != 0:
            continue
        cur: int = ck.fimp.vv[e]
        if name_resolves(ck, a, body, cur):
            continue
        oe: int = m2_get(ck.forig, 0, ck.fimp.k2[e])
        if oe < 0:
            continue
        ce: int = m2_get(ex, 0, ck.forig.vv[oe])
        if ce < 0:
            continue
        fk.append(ck.fimp.k2[e])
        fv.append(ex.vv[ce])
    for u in range(len(fk)):
        m2_put(ck.fimp, 0, fk[u], fv[u])

# Zig `flattenDottedPath`: yalnız `.identifier`/`.attribute` zinciri ise sembolleri (soldan sağa) `out`a ekler.
def flatten_dotted(ck: Ck, a: Ast, e: int, out: list[int]) -> bool:
    if a.n[e] == 5:
        out.append(sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2])))
        return True
    if a.n[e] == 9:
        at: int = a.n[e + 1]
        if not flatten_dotted(ck, a, a.n[at + 0], out):
            return False
        out.append(sym_of(ck, a, pk(a.n[at + 1], a.n[at + 1 + 1])))
        return True
    return False

# Zig `isVariableInScope`: yerel/parametre/yakalanan ya da modül düzeyi değişken.
def is_variable_in_scope(ck: Ck, fx: Fx, sym: int) -> bool:
    return sc_exists(ck, fx.scope, sym) or m2_get(ck.globs, 0, sym) >= 0

# Zig `resolveMangledCall` (generic işlev/sınıf bu kipte yoktur): mangled ad işlev ya da sınıf mı; değilse `nf_kind` ile bulunamadı iletisi.
# nf_kind 0 (from-import): "'<s1>' could not be imported (the source module has no member named '<s2>')"; 1 (nitelikli çağrı): "module '<s1>' has no member named '<s2>'".
def resolve_mangled_call(ck: Ck, a: Ast, fx: Fx, c: int, ms: int, nf_kind: int, s1: int, s2: int) -> int:
    fe: int = m2_get(ck.fmap, 0, ms)
    if fe >= 0:
        if m2_get(ck.afn, 0, ms) >= 0:
            mp(ck, "'")
            mp_sym(ck, ms)
            mp(ck, "' is an 'async def' function and can only be started with 'spawn'")
            raise mk_fail(ck, "TypeMismatch")
        sid: int = ck.fmap.vv[fe]
        check_args_sig(ck, a, fx, c, sid, ms)
        return ck.fret[sid]
    ci: int = class_idx(ck, ms)
    if ci >= 0:
        isid: int = ck.cls_init[ci]
        if isid < 0:
            isid = ck.sig_empty
        check_args_sig(ck, a, fx, c, isid, ms)
        return ty_class(ck.tt, ms)
    if nf_kind == 0:
        mp(ck, "'")
        mp_sym(ck, s1)
        mp(ck, "' could not be imported (the source module has no member named '")
        mp_sym(ck, s2)
        mp(ck, "')")
    else:
        mp(ck, "module '")
        mp_sym(ck, s1)
        mp(ck, "' has no member named '")
        mp_sym(ck, s2)
        mp(ck, "'")
    raise mk_fail(ck, "UndefinedFunction")

# `matchIntrinsicKind`: `nox.http.serve*` / `nox.thread.start|pool_run` çağrıları (özel çözümleme: kapsam dışı).
def is_intrinsic_call(ck: Ck, segs: list[int]) -> bool:
    if len(segs) != 3 or segs[0] != sym_lit(ck, "nox"):
        return False
    if m2_get(ck.imod, 0, join_syms(ck, segs, 2, 46)) < 0:
        return False
    if segs[1] == sym_lit(ck, "http"):
        for nm in ["serve", "serve_fd", "serve_multicore", "serve_tls", "serve_ws", "serve_ws_tls", "serve_fd_tls", "serve_fd_ws", "serve_fd_ws_tls", "serve_multicore_tls", "serve_multicore_ws", "serve_multicore_ws_tls"]:
            if segs[2] == sym_lit(ck, nm):
                return True
        return False
    if segs[1] == sym_lit(ck, "thread"):
        return segs[2] == sym_lit(ck, "start") or segs[2] == sym_lit(ck, "pool_run")
    return False

# Zig `tryResolveQualifiedCall` (öncesinde `matchIntrinsicKind`): modül-nitelikli çağrı `mod.f(...)`. -1: uygulanmaz (normal metod çağrısı çözümlemesine devam).
def qualified_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    if len(ck.imod.k1) == 0:
        return -1
    raw: list[int] = []
    if not flatten_dotted(ck, a, callee, raw) or len(raw) < 2:
        return -1
    segs: list[int] = subst_alias(ck, raw)
    if is_intrinsic_call(ck, segs):
        raise unsup(ck, "check_call#intrinsic")
    if is_variable_in_scope(ck, fx, raw[0]):
        return -1
    n: int = len(segs)
    mod: int = join_syms(ck, segs, n - 1, 46)
    if m2_get(ck.imod, 0, mod) < 0:
        return -1
    return resolve_mangled_call(ck, a, fx, c, join_syms(ck, segs, n, 95), 1, mod, segs[n - 1])

# `hasDunder`: sınıfta o adlı METOD var mı (sentezlenen tuple sınıfı dunder taşımaz; varsa yeniden yazım gerekir: kapsam dışı).
def has_dunder(ck: Ck, t: int, name: str) -> bool:
    ci: int = class_idx_of_type(ck, t)
    if ci < 0 or is_tuple_cls(ck, ci):
        return False
    return m2_get(ck.cls_meths, ci, sym_lit(ck, name)) >= 0

# imza: params + dönüş + parametre adları (`fpar/fpnm` havuzu); işlev, metod ve `__init__` ortak
def new_sig(ck: Ck, tys: list[int], names: list[int], ret: int) -> int:
    idx: int = len(ck.fps)
    ck.fps.append(len(ck.fpar))
    ck.fpn.append(len(tys))
    ck.fret.append(ret)
    for q in range(len(tys)):
        ck.fpar.append(tys[q])
        ck.fpnm.append(names[q])
    return idx

def is_tuple_cls(ck: Ck, ci: int) -> bool:
    return ci >= 0 and ck.tup_s[ci] >= 0

def mangle_name(ck: Ck, base: str, elems: list[int]) -> int:
    tt: TT = ck.tt
    bs: list[int] = []
    for i in range(len(base)):
        bs.append(ord(base[i]))
    bs.append(95)
    bs.append(95)
    for j in range(len(elems)):
        if j > 0:
            bs.append(95)
        tt.out = []
        ty_mangle(tt, elems[j])
        for k in range(len(tt.out)):
            bs.append(tt.out[k])
    return sym_intern_list(tt, bs, 0, len(bs))

# `instantiateTupleClass`: `tuple[T1, ..., Tn]` -> `tuple__T1_...` sentezlenmiş sınıfı (`f0..f{n-1}` alanları + `__init__`).
def instantiate_tuple_class(ck: Ck, elems: list[int]) -> int:
    sym: int = mangle_name(ck, "tuple", elems)
    if class_idx(ck, sym) >= 0:
        return ty_class(ck.tt, sym)
    ci: int = len(ck.cls_sym)
    ck.cls_sym.append(sym)
    ck.cls_node.append(-1)
    ck.cls_init.append(-1)
    ck.cls_base.append(-1)
    ck.cls_regd.append(2)
    ck.cls_chk.append(1)
    ck.tup_s.append(len(ck.tup_e))
    ck.tup_n.append(len(elems))
    m2_put(ck.cls_map, 0, sym, ci)
    cls_register(ck.tt, sym)
    ptys: list[int] = []
    pnms: list[int] = []
    for i in range(len(elems)):
        et: int = elems[i]
        fsym: int = sym_lit(ck, "f" + str(i))
        m2_put(ck.cls_fields, ci, fsym, et)
        ptys.append(et)
        pnms.append(fsym)
        ck.tup_e.append(et)
    ck.cls_init[ci] = new_sig(ck, ptys, pnms, 4)
    return ty_class(ck.tt, sym)

# `collectClassNames`: ad kaydı + kapsam dışı sınıf özellikleri (kalıtım/dekoratör/sabit/jenerik/enum/mixin)
def collect_class_names(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + 1]
        ck.cur_span = a.n[st + 2]
        kn: int = a.n[st + 0]
        if a.n[kn] != 8:
            continue
        cd: int = a.n[kn + 1]
        nm: int = pk(a.n[cd + 0], a.n[cd + 0 + 1])
        sym: int = sym_of(ck, a, nm)
        if class_idx(ck, sym) >= 0:
            mp(ck, "class already defined: ")
            mp_sym(ck, sym)
            raise mk_fail(ck, "DuplicateDefinition")
        if pky(sl_at(a, cd, 14)) > 0:
            raise unsup(ck, "class#generic")
        if pky(sl_at(a, cd, 8)) > 0 or pky(sl_at(a, cd, 10)) > 0 or pky(sl_at(a, cd, 12)) > 0:
            raise unsup(ck, "class#bases")
        if pky(sl_at(a, cd, 20)) > 0:
            raise unsup(ck, "class#decorators")
        if pky(sl_at(a, cd, 2)) > 0:
            raise unsup(ck, "class#consts")
        if pky(sl_at(a, cd, 22)) > 0:
            raise unsup(ck, "class#enum")
        idx: int = len(ck.cls_sym)
        ck.cls_sym.append(sym)
        ck.cls_node.append(cd)
        ck.cls_init.append(-1)
        ck.cls_base.append(-1)
        ck.cls_regd.append(0)
        ck.cls_chk.append(0)
        ck.tup_s.append(-1)
        ck.tup_n.append(0)
        m2_put(ck.cls_map, 0, sym, idx)
        cls_register(ck.tt, sym)

# `mixin_flatten.run` (tekli taban yolu): sınıflar metin sırasıyla gezilir, taban (yerel ya da `from`-import) önce; ziyaret halindeki sınıfa dönülürse döngü hatası. Çoklu taban/mixin kapsam dışı.
def resolve_cls_pass(ck: Ck, cn: list[int], nsym: int) -> int:
    for j in range(len(cn) - 1, -1, -1):
        if cn[j] == nsym:
            return j
    fe: int = m2_get(ck.fimp, 0, nsym)
    if fe >= 0:
        q: int = ck.fimp.vv[fe]
        for j2 in range(len(cn) - 1, -1, -1):
            if cn[j2] == q:
                return j2
    return -1

def flatten_cls(ck: Ck, cn: list[int], cb: list[int], cl: list[int], done: Map2, vis: Map2, i: int) -> None:
    nm: int = cn[i]
    if m2_get(done, 0, nm) >= 0:
        return
    if m2_get(vis, 0, nm) >= 0:
        last: int = len(cn) - 1
        while cn[last] != nm:
            last = last - 1
        ck.cur_line = cl[last]
        mp(ck, "class '")
        mp_sym(ck, nm)
        mp(ck, "': cyclic base classes")
        raise mk_fail(ck, "TypeMismatch")
    m2_put(vis, 0, nm, 1)
    if cb[i] >= 0:
        j: int = resolve_cls_pass(ck, cn, cb[i])
        if j >= 0:
            flatten_cls(ck, cn, cb, cl, done, vis, j)
    m2_remove(vis, 0, nm)
    m2_put(done, 0, nm, 1)

def check_base_cycles(ck: Ck, a: Ast, body: int) -> None:
    cn: list[int] = []
    cb: list[int] = []
    cl: list[int] = []
    any_base: bool = False
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + 0]
        if a.n[kn] != 8:
            continue
        cd: int = a.n[kn + 1]
        if pky(sl_at(a, cd, 8)) > 0 or pky(sl_at(a, cd, 12)) > 0:
            raise unsup(ck, "class#bases")
        cn.append(sym_of(ck, a, pk(a.n[cd + 0], a.n[cd + 0 + 1])))
        cl.append(a.n[st + 1])
        if a.n[cd + 6] != -4611686018427387904:
            cb.append(sym_of(ck, a, pk(a.n[cd + 6], a.n[cd + 6 + 1])))
            any_base = True
        else:
            cb.append(-1)
    if not any_base:
        return
    done: Map2 = Map2()
    vis: Map2 = Map2()
    for k in range(len(cn)):
        flatten_cls(ck, cn, cb, cl, done, vis, k)

# `ensureClassSignatureRegistered`: taban (yerel sınıfsa) önce kaydedilir; döngüsel kalıtım hatası.
def ensure_class_sig(ck: Ck, a: Ast, idx: int) -> None:
    if ck.cls_regd[idx] == 2:
        return
    if ck.cls_regd[idx] == 1:
        mp(ck, "cyclic inheritance between classes detected: ")
        mp_sym(ck, ck.cls_sym[idx])
        raise mk_fail(ck, "TypeMismatch")
    ck.cls_regd[idx] = 1
    cd: int = ck.cls_node[idx]
    if a.n[cd + 6] != -4611686018427387904:
        bi: int = class_idx(ck, sym_of(ck, a, pk(a.n[cd + 6], a.n[cd + 6 + 1])))
        if bi >= 0:
            ensure_class_sig(ck, a, bi)
    register_class_sigs(ck, a, idx)
    ck.cls_regd[idx] = 2

# `registerClassSignatures` (tekli kalıtım; sabitler/dekoratörler/çoklu taban/jenerik kapsam dışı)
def register_class_sigs(ck: Ck, a: Ast, idx: int) -> None:
    cd: int = ck.cls_node[idx]
    csym: int = ck.cls_sym[idx]
    ms: int = sl_at(a, cd, 16)
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        mn: int = pk(a.n[m + 0], a.n[m + 0 + 1])
        if sref_eq(a, mn, "release") or sref_eq(a, mn, "trace") or sref_eq(a, mn, "gc_free"):
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': the method name '")
            mp_sref(ck, a, mn)
            mp(ck, "' is reserved (the compiler generates a '")
            mp_sym(ck, csym)
            mp(ck, "_")
            mp_sref(ck, a, mn)
            mp(ck, "' function for every class) — rename the method")
            raise mk_fail(ck, "DuplicateDefinition")
    has_base: bool = a.n[cd + 6] != -4611686018427387904
    if has_base:
        # taban adı: yerel sınıf yoksa `from X import Base` geri düşüşü; sonra taban alanları/metodları/`__init__` imzası kopyalanır
        bsym: int = sym_of(ck, a, pk(a.n[cd + 6], a.n[cd + 6 + 1]))
        if class_idx(ck, bsym) < 0:
            bfe: int = m2_get(ck.fimp, 0, bsym)
            if bfe >= 0:
                bsym = ck.fimp.vv[bfe]
        bi: int = class_idx(ck, bsym)
        if bi < 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "' has an unknown base class: ")
            mp_sym(ck, bsym)
            raise mk_fail(ck, "UndefinedClass")
        ck.cls_base[idx] = bsym
        cls_set_base(ck.tt, csym, bsym)
        for e in range(len(ck.cls_fields.k1)):
            if ck.cls_fields.k1[e] == bi and ck.cls_fields.dead[e] == 0:
                m2_put(ck.cls_fields, idx, ck.cls_fields.k2[e], ck.cls_fields.vv[e])
        for e2 in range(len(ck.cls_meths.k1)):
            if ck.cls_meths.k1[e2] == bi and ck.cls_meths.dead[e2] == 0:
                m2_put(ck.cls_meths, idx, ck.cls_meths.k2[e2], ck.cls_meths.vv[e2])
        ck.cls_init[idx] = ck.cls_init[bi]
    fs: int = sl_at(a, cd, 18)
    for j in range(pky(fs)):
        f: int = stmt_at(a, fs, j)
        fsym: int = sym_of(ck, a, pk(a.n[f + 0], a.n[f + 0 + 1]))
        if m2_get(ck.cls_fields, idx, fsym) >= 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': field '")
            mp_sym(ck, fsym)
            if has_base:
                mp(ck, "' is already declared (perhaps in a base class)")
            else:
                mp(ck, "' is already declared")
            raise mk_fail(ck, "DuplicateDefinition")
        ft: int = type_expr_to_type(ck, a, a.n[f + 2])
        m2_put(ck.cls_fields, idx, fsym, ft)
        m2_put(ck.cls_unas, idx, fsym, 1)
        # classHasNonArcFields: bildirilen alan tipi Task/Channel/ThreadHandle/ThreadChannel/TaskLocal
        g: int = ck.tt.tag[ft]
        if g == 7 or g == 8 or g == 9 or g == 10 or g == 11:
            cls_set_nonarc(ck.tt, csym, 1)
    for k in range(pky(ms)):
        m2: int = stmt_at(a, ms, k)
        mname: int = pk(a.n[m2 + 0], a.n[m2 + 0 + 1])
        if pky(sl_at(a, m2, 11)) > 0 or a.n[m2 + 10] != 0 or a.n[m2 + 19] != 0:
            raise unsup(ck, "class#method_features")
        if pky(sl_at(a, m2, 2)) > 0:
            # `extractGenericMethods` ön geçişi jenerik metodları sınıftan çıkarır (kendi tanıları var): kapsam dışı
            raise unsup(ck, "class#generic_method")
        ps: int = sl_at(a, m2, 4)
        p0n: int = 0
        if pky(ps) > 0:
            p0: int = stmt_at(a, ps, 0)
            p0n = pk(a.n[p0 + 0], a.n[p0 + 0 + 1])
        if pky(ps) == 0 or not sref_eq(a, p0n, "self"):
            mp(ck, "method '")
            mp_sym(ck, csym)
            mp(ck, ".")
            mp_sref(ck, a, mname)
            mp(ck, "' must take 'self' as its first parameter")
            raise mk_fail(ck, "TypeMismatch")
        p0t: int = a.n[stmt_at(a, ps, 0) + 6]
        self_ok: bool = a.n[p0t] == 0 and sym_of(ck, a, pk(a.n[p0t + 1], a.n[p0t + 2])) == csym
        if not self_ok:
            mp(ck, "inside method '")
            mp_sym(ck, csym)
            mp(ck, ".")
            mp_sref(ck, a, mname)
            mp(ck, "', the type of 'self' must be '")
            mp_sym(ck, csym)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        tys: list[int] = []
        pnames: list[int] = []
        for q in range(1, pky(ps)):
            pn: int = stmt_at(a, ps, q)
            if a.n[pn + 8] >= 0 or a.n[pn + 2] != 0 or a.n[pn + 3] != 0 or a.n[pn + 4] != 0 or a.n[pn + 5] != 0:
                raise unsup(ck, "class#method_param_features")
            tys.append(type_expr_to_type(ck, a, a.n[pn + 6]))
            pnames.append(sym_of(ck, a, pk(a.n[pn + 0], a.n[pn + 0 + 1])))
        ret: int = type_expr_to_type(ck, a, a.n[m2 + 6])
        if sref_eq(a, mname, "__del__"):
            if len(tys) != 0 or ret != 4:
                mp(ck, "'")
                mp_sym(ck, csym)
                mp(ck, ".__del__' must be `def __del__(self) -> None:` (no other parameters, no return value, not async)")
                raise mk_fail(ck, "TypeMismatch")
        sid: int = new_sig(ck, tys, pnames, ret)
        if sref_eq(a, mname, "__init__"):
            ck.cls_init[idx] = sid
        else:
            msym: int = sym_of(ck, a, mname)
            ie: int = m2_get(ck.cls_meths, idx, msym)
            if ie >= 0 and not sig_eq_ignoring_self(ck, ck.cls_meths.vv[ie], sid):
                mp(ck, "method '")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sref(ck, a, mname)
                mp(ck, "' does not match the signature in the base class (an override requires an exact signature match)")
                raise mk_fail(ck, "TypeMismatch")
            m2_put(ck.cls_meths, idx, msym, sid)

# `funcSigEqlIgnoringSelf`: parametre tipleri (self hariç) ve dönüş tipi TypeId eşitliği (hash-consing ⇒ `types.eql`).
def sig_eq_ignoring_self(ck: Ck, s1: int, s2: int) -> bool:
    if ck.fpn[s1] != ck.fpn[s2]:
        return False
    for i in range(ck.fpn[s1]):
        if ck.fpar[ck.fps[s1] + i] != ck.fpar[ck.fps[s2] + i]:
            return False
    return ck.fret[s1] == ck.fret[s2]

# `ensureClassBodyChecked`: taban gövdesi önce denetlenir, çıkarsanan alanlar türetilene (yoksa) kopyalanır.
def ensure_class_checked(ck: Ck, a: Ast, idx: int) -> None:
    if ck.cls_chk[idx] != 0:
        return
    ck.cls_chk[idx] = 1
    bsym: int = ck.cls_base[idx]
    if bsym >= 0:
        bi: int = class_idx(ck, bsym)
        if bi >= 0:
            ensure_class_checked(ck, a, bi)
            for e in range(len(ck.cls_fields.k1)):
                if ck.cls_fields.k1[e] == bi and ck.cls_fields.dead[e] == 0 and m2_get(ck.cls_fields, idx, ck.cls_fields.k2[e]) < 0:
                    m2_put(ck.cls_fields, idx, ck.cls_fields.k2[e], ck.cls_fields.vv[e])
    check_class(ck, a, idx)

# `checkClassBody` (tekli kalıtım)
def check_class(ck: Ck, a: Ast, idx: int) -> None:
    cd: int = ck.cls_node[idx]
    ms: int = sl_at(a, cd, 16)
    before: int = len(ck.dcode)
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        if sref_eq(a, pk(a.n[m + 0], a.n[m + 0 + 1]), "__init__"):
            check_method_guarded(ck, a, idx, m, True)
    if len(ck.dcode) == before:
        nun: int = 0
        usym: int = -1
        for e in range(len(ck.cls_unas.k1)):
            if ck.cls_unas.k1[e] == idx and ck.cls_unas.dead[e] == 0:
                nun = nun + 1
                usym = ck.cls_unas.k2[e]
        if nun > 1:
            # Zig HashMap yineleme sırası (tanı sırası) taklit edilemez: ≥2 atanmamış alan kapsam dışı
            raise unsup(ck, "class#unassigned_multi")
        if nun == 1:
            mp(ck, "class '")
            mp_sym(ck, ck.cls_sym[idx])
            mp(ck, "': the declared field '")
            mp_sym(ck, usym)
            mp(ck, "' is never assigned in __init__")
            mk_fail(ck, "UnassignedField")
            record_diag(ck, a)
    for j in range(pky(ms)):
        m2: int = stmt_at(a, ms, j)
        if not sref_eq(a, pk(a.n[m2 + 0], a.n[m2 + 0 + 1]), "__init__"):
            check_method_guarded(ck, a, idx, m2, False)

def check_method_guarded(ck: Ck, a: Ast, idx: int, m: int, is_init: bool) -> None:
    try:
        check_method_body(ck, a, idx, m, is_init)
    except CkErr:
        ck.depth = 0
        record_diag(ck, a)

# `checkMethodBody`
def check_method_body(ck: Ck, a: Ast, idx: int, m: int, is_init: bool) -> None:
    scope: int = sc_new(ck, -1, False)
    ps: int = sl_at(a, m, 4)
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        pt: int = type_expr_to_type(ck, a, a.n[p + 6])
        sc_declare(ck, scope, sym_of(ck, a, pk(a.n[p + 0], a.n[p + 0 + 1])), pt)
    ret: int = type_expr_to_type(ck, a, a.n[m + 6])
    fx: Fx = Fx(scope, ret, False)
    fx.self_cls = idx
    fx.is_init = is_init
    body: int = sl_at(a, m, 8)
    check_block(ck, a, fx, body)
    if ret != 4 and not always_returns(a, body):
        mp(ck, "method '")
        mp_sym(ck, ck.cls_sym[idx])
        mp(ck, ".")
        mp_sref(ck, a, pk(a.n[m + 0], a.n[m + 0 + 1]))
        mp(ck, "' does not return a value on all paths")
        raise mk_fail(ck, "MissingReturn")

# `checkAttribute`: örnek alanı okuması (sınıf sabiti/property/enum kapsam dışı)
def check_attribute(ck: Ck, a: Ast, fx: Fx, at: int) -> int:
    obj_t: int = check_expr(ck, a, fx, a.n[at + 0])
    attr: int = pk(a.n[at + 1], a.n[at + 1 + 1])
    require_not_optional_sref(ck, obj_t, a, attr)
    if ck.tt.tag[obj_t] != 6:
        mp(ck, "'.")
        mp_sref(ck, a, attr)
        mp(ck, "' can only be used on class instances")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, obj_t)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, ck.tt.xa[obj_t])
        raise mk_fail(ck, "UndefinedClass")
    asym: int = sym_of(ck, a, attr)
    fe: int = m2_get(ck.cls_fields, ci, asym)
    if fe >= 0:
        return ck.cls_fields.vv[fe]
    # `nesne.metod` değer olarak (bağlı metod: Zig `bound_method_fixup` ile yeniden yazılır) kapsam dışı
    if m2_get(ck.cls_meths, ci, asym) >= 0:
        raise unsup(ck, "attr#bound_method")
    mp(ck, "class '")
    mp_sym(ck, ck.cls_sym[ci])
    mp(ck, "' has no field '")
    mp_sref(ck, a, attr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedAttribute")

def require_not_optional_sref(ck: Ck, t: int, a: Ast, what: int) -> None:
    if ck.tt.tag[t] == 15:
        mp(ck, "an Optional (T | None) value cannot be used for '")
        mp_sref(ck, a, what)
        mp(ck, "' — narrow it first with 'if ... != None:'")
        raise mk_fail(ck, "OptionalNotNarrowed")

# kök tanımlayıcı (a.b.c → a) `nox` mu (stdlib niteliklı çağrı: kapsam dışı)
def dotted_root_is(ck: Ck, a: Ast, e: int, name: str) -> bool:
    cur: int = e
    while a.n[cur] == 9:
        cur = a.n[a.n[cur + 1] + 0]
    if a.n[cur] != 5:
        return False
    return sref_eq(a, pk(a.n[cur + 1], a.n[cur + 2]), name)

# argüman denetimi (checkArgs/checkArgsDecl çekirdeği): imza kimliği `sid`, ileti adı `nm` (SymbolId)
def check_args_sig(ck: Ck, a: Ast, fx: Fx, c: int, sid: int, nm: int) -> None:
    args: int = sl_at(a, c, 1)
    n: int = pky(args)
    for i in range(n):
        if a.n[stmt_at(a, args, i)] == 17:
            raise unsup(ck, "check_args_sig#kwarg")
    np: int = ck.fpn[sid]
    st: int = ck.fps[sid]
    # extern imzalarında parametre adı yoktur (-1): Zig `expandCallArgs` yalnızca `def` bildirimi olan işlevlerde "argument 'x' is missing" üretir
    if n < np and ck.fpnm[st + n] >= 0:
        mp(ck, "in the call to '")
        mp_sym(ck, nm)
        mp(ck, "', argument '")
        mp_sym(ck, ck.fpnm[st + n])
        mp(ck, "' is missing")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if np != n:
        mp(ck, "'")
        mp_sym(ck, nm)
        mp(ck, "' expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, n)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    for i2 in range(np):
        ae: int = stmt_at(a, args, i2)
        pt: int = ck.fpar[st + i2]
        at_: int = check_expr_expected(ck, a, fx, ae, pt)
        if not ty_assignable(ck.tt, pt, at_):
            sp: int = span_of(a, ae)
            if sp >= 0:
                ck.cur_span = sp
            mp(ck, "type mismatch for argument '")
            mp_sym(ck, nm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")

# func-tipli alan çağrısı: `checkArgs(ft.func.params, ...)`
def check_args_func_type(ck: Ck, a: Ast, fx: Fx, c: int, ft: int, nm: int) -> None:
    args: int = sl_at(a, c, 1)
    n: int = pky(args)
    tt: TT = ck.tt
    np: int = tt.xc[ft]
    if np != n:
        mp(ck, "'")
        mp_sym(ck, nm)
        mp(ck, "' expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, n)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    for i in range(np):
        ae: int = stmt_at(a, args, i)
        pt: int = tt.fp[tt.xa[ft] + i]
        at_: int = check_expr_expected(ck, a, fx, ae, pt)
        if not ty_assignable(tt, pt, at_):
            sp: int = span_of(a, ae)
            if sp >= 0:
                ck.cur_span = sp
            mp(ck, "type mismatch for argument '")
            mp_sym(ck, nm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")

# ---- yerleşik list/dict metotları (`checkCall`in `.attribute` dalı; str/Task/Channel/... 3.10'un devamı) ----
def fail2(ck: Ck, code: str, msg: str) -> None:
    mp(ck, msg)
    raise mk_fail(ck, code)

def fail_attr(ck: Ck, a: Ast, attr: int, code: str, pre: str, post: str) -> None:
    mp(ck, pre)
    mp_sref(ck, a, attr)
    mp(ck, post)
    raise mk_fail(ck, code)

def is_plain_field_chain(a: Ast, e: int) -> bool:
    if a.n[e] == 5:
        return True
    if a.n[e] == 9:
        return is_plain_field_chain(a, a.n[a.n[e + 1] + 0])
    return False

# `checkGrowableListRecv`: append/insert alıcısı çıplak ad ya da `ad.alan[.alan...]` (kök sınıf örneği)
def check_growable_recv(ck: Ck, a: Ast, fx: Fx, obj: int, what: str, example: str) -> None:
    ok: bool = False
    if a.n[obj] == 5:
        ok = True
    elif a.n[obj] == 9:
        base: int = a.n[a.n[obj + 1] + 0]
        if is_plain_field_chain(a, base):
            bt: int = check_expr(ck, a, fx, base)
            ok = ck.tt.tag[bt] == 6
    if not ok:
        fail2(ck, "TypeMismatch", "'" + what + "' can only be called on a variable or on 'name.field[.field...]' (e.g. '" + example + "', 'self.items.append(v)')")

# `tryCheckExtendStmt` / `tryCheckElementGrowStmt` (ifade deyimi olarak `xs.extend(ys)`, `xs[i].append/insert/extend(..)`): deyim yeniden yazılır → kapsam dışı
def grow_stmt_gate(ck: Ck, a: Ast, fx: Fx, e: int) -> None:
    if a.n[e] != 8:
        return
    callee: int = a.n[a.n[e + 1] + 0]
    if a.n[callee] != 9:
        return
    at: int = a.n[callee + 1]
    attr: int = pk(a.n[at + 1], a.n[at + 1 + 1])
    obj: int = a.n[at + 0]
    is_ext: bool = sref_eq(a, attr, "extend")
    if not (is_ext or sref_eq(a, attr, "append") or sref_eq(a, attr, "insert")):
        return
    if is_ext:
        et: int = check_expr(ck, a, fx, obj)
        if ck.tt.tag[et] == 5:
            raise unsup(ck, "list_extend")
    if a.n[obj] == 10:
        it: int = check_expr(ck, a, fx, obj)
        if ck.tt.tag[it] == 5:
            raise unsup(ck, "elem_grow")

# `requireListElemComparable`
def require_list_elem_comparable(ck: Ck, a: Ast, et: int, xt: int, attr: int) -> None:
    g: int = ck.tt.tag[et]
    if not (g == 0 or g == 1 or g == 2 or g == 3 or g == 16 or g == 6 or g == 5):
        fail_attr(ck, a, attr, "TypeMismatch", "the list element type is not supported for '", "' (it must be int/float/bool/str/class/list)")
    x: int = require_same_fixed(ck, xt, et)
    if not ((is_numeric_t(ck, xt) and is_numeric_t(ck, et)) or xt == et):
        fail_attr(ck, a, attr, "TypeMismatch", "the argument of '", "' does not match the list element type")

def check_list_method(ck: Ck, a: Ast, fx: Fx, c: int, obj: int, attr: int, obj_t: int) -> int:
    tt: TT = ck.tt
    args: int = sl_at(a, c, 1)
    n: int = pky(args)
    el: int = tt.xa[obj_t]
    if sref_eq(a, attr, "append"):
        check_growable_recv(ck, a, fx, obj, "append", "xs.append(v)")
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'append' takes exactly 1 argument")
        vt: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 0), el)
        if not ty_assignable(tt, el, vt):
            fail2(ck, "TypeMismatch", "the argument of 'append' does not match the list's element type")
        return 4
    if sref_eq(a, attr, "sort"):
        if n != 0:
            for si in range(n):
                sa: int = stmt_at(a, args, si)
                okkw: bool = False
                if a.n[sa] == 17:
                    skn: int = pk(a.n[a.n[sa + 1] + 0], a.n[a.n[sa + 1] + 0 + 1])
                    okkw = sref_eq(a, skn, "key") or sref_eq(a, skn, "reverse")
                if not okkw:
                    fail2(ck, "ArgumentCountMismatch", "'sort' only takes the 'key=' and 'reverse=' keyword arguments")
            raise unsup(ck, "list_sort_kwargs")
        if el != 0 and el != 1 and el != 3:
            fail2(ck, "TypeMismatch", "'sort' can only be called on list[int]/list[float]/list[str]")
        return 4
    if sref_eq(a, attr, "pop"):
        if n > 1:
            fail2(ck, "ArgumentCountMismatch", "'pop' takes 0 or 1 (index) arguments")
        if n == 1:
            it: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
            if it != 0:
                fail2(ck, "TypeMismatch", "the index of 'pop' must be an 'int'")
        return el
    if sref_eq(a, attr, "reverse") or sref_eq(a, attr, "clear"):
        if n != 0:
            fail_attr(ck, a, attr, "ArgumentCountMismatch", "'", "' takes no arguments")
        return 4
    if sref_eq(a, attr, "copy"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'copy' takes no arguments")
        return obj_t
    if sref_eq(a, attr, "insert"):
        check_growable_recv(ck, a, fx, obj, "insert", "xs.insert(i, v)")
        if n != 2:
            fail2(ck, "ArgumentCountMismatch", "'insert' takes exactly 2 arguments (index, value)")
        ix: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ix != 0:
            fail2(ck, "TypeMismatch", "the index of 'insert' must be an 'int'")
        iv: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 1), el)
        if not ty_assignable(tt, el, iv):
            fail2(ck, "TypeMismatch", "the value of 'insert' does not match the list's element type")
        return 4
    if sref_eq(a, attr, "extend"):
        fail2(ck, "TypeMismatch", "'extend' can only be used as an expression statement (xs.extend(ys)); it produces no value")
    if sref_eq(a, attr, "remove") or sref_eq(a, attr, "index") or sref_eq(a, attr, "count"):
        if n != 1:
            fail_attr(ck, a, attr, "ArgumentCountMismatch", "'", "' takes exactly 1 argument")
        xt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        require_list_elem_comparable(ck, a, el, xt, attr)
        if sref_eq(a, attr, "remove"):
            return 4
        return 0
    fail_attr(ck, a, attr, "UndefinedMethod", "list has no method '", "' (append/extend/insert/pop/remove/clear/index/count/sort/reverse/copy)")
    return 4

def check_dict_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    tt: TT = ck.tt
    args: int = sl_at(a, c, 1)
    n: int = pky(args)
    k0: int = tt.xa[obj_t]
    v0: int = tt.xb[obj_t]
    if sref_eq(a, attr, "items"):
        raise unsup(ck, "dict_items")
    if sref_eq(a, attr, "contains"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'contains' takes exactly 1 argument")
        kt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if kt != k0:
            fail2(ck, "TypeMismatch", "the argument of 'contains' does not match the dict's key type")
        return 2
    if sref_eq(a, attr, "len"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'len' takes no arguments")
        return 0
    if sref_eq(a, attr, "keys"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'keys' takes no arguments")
        return ty_list(tt, k0)
    if sref_eq(a, attr, "values"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'values' takes no arguments")
        return ty_list(tt, v0)
    if sref_eq(a, attr, "get") or sref_eq(a, attr, "pop"):
        if n < 1 or n > 2:
            fail_attr(ck, a, attr, "ArgumentCountMismatch", "'", "' takes 1 or 2 arguments (key[, default])")
        gk: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if gk != k0:
            fail_attr(ck, a, attr, "TypeMismatch", "the key of '", "' does not match the dict's key type")
        if n == 2:
            gd: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 1), v0)
            if not ty_assignable(tt, v0, gd):
                fail_attr(ck, a, attr, "TypeMismatch", "the default value of '", "' does not match the dict's value type")
            return v0
        if sref_eq(a, attr, "pop"):
            return v0
        return ty_optional(tt, v0)
    if sref_eq(a, attr, "setdefault"):
        if n != 2:
            fail2(ck, "ArgumentCountMismatch", "'setdefault' takes exactly 2 arguments (key, default)")
        sk: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if sk != k0:
            fail2(ck, "TypeMismatch", "the key of 'setdefault' does not match the dict's key type")
        sd: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 1), v0)
        if not ty_assignable(tt, v0, sd):
            fail2(ck, "TypeMismatch", "the default value of 'setdefault' does not match the dict's value type")
        return v0
    if sref_eq(a, attr, "clear"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'clear' takes no arguments")
        return 4
    if sref_eq(a, attr, "copy"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'copy' takes no arguments")
        return obj_t
    if sref_eq(a, attr, "update"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'update' takes exactly 1 argument")
        ut: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ut != obj_t:
            fail2(ck, "TypeMismatch", "the argument of 'update' must be of the same dict[K, V] type")
        return 4
    fail_attr(ck, a, attr, "UndefinedMethod", "dict has no method '", "' (contains/len/keys/values/get/pop/setdefault/clear/copy/update)")
    return 4

# ---- Task/Channel/TaskLocal/ThreadHandle/ThreadChannel/str yerleşik metotları (Zig `checkCallInner` `.attribute` dalı; 3.10 dilim C) ----
def arg_n(a: Ast, c: int) -> int:
    return pky(sl_at(a, c, 1))

def arg_e(ck: Ck, a: Ast, fx: Fx, c: int, i: int) -> int:
    return check_expr(ck, a, fx, stmt_at(a, sl_at(a, c, 1), i))

def check_task_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int) -> int:
    n: int = arg_n(a, c)
    if sref_eq(a, attr, "cancel"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'cancel' takes no arguments")
        return 4
    if sref_eq(a, attr, "is_done"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'is_done' takes no arguments")
        return 2
    if sref_eq(a, attr, "wait"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'wait' takes exactly 1 argument (timeout in milliseconds)")
        if arg_e(ck, a, fx, c, 0) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait' must be an int (milliseconds)")
        return 2
    if sref_eq(a, attr, "wait_any"):
        if n != 2:
            fail2(ck, "ArgumentCountMismatch", "'wait_any' takes 2 arguments (another Task, timeout in milliseconds)")
        if ck.tt.tag[arg_e(ck, a, fx, c, 0)] != 7:
            fail2(ck, "TypeMismatch", "the first argument of 'wait_any' must be a Task")
        if arg_e(ck, a, fx, c, 1) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait_any' must be an int (milliseconds)")
        return 0
    fail_attr(ck, a, attr, "UndefinedMethod", "Task has no method '", "' (only cancel, is_done, wait and wait_any)")
    return 4

def check_channel_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    elem: int = ck.tt.xa[obj_t]
    if sref_eq(a, attr, "send"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'send' takes exactly 1 argument")
        if not ty_assignable(ck.tt, elem, arg_e(ck, a, fx, c, 0)):
            fail2(ck, "TypeMismatch", "the argument of 'send' does not match the channel's element type")
        return 4
    if sref_eq(a, attr, "recv"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'recv' takes no arguments")
        return elem
    if sref_eq(a, attr, "wait"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'wait' takes exactly 1 argument (timeout in milliseconds)")
        if arg_e(ck, a, fx, c, 0) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait' must be an int (milliseconds)")
        return 2
    if sref_eq(a, attr, "wait_any"):
        if n < 2 or n > 4:
            fail2(ck, "ArgumentCountMismatch", "'wait_any' takes 1 to 3 other channels and a timeout in milliseconds")
        for i in range(n - 1):
            if ck.tt.tag[arg_e(ck, a, fx, c, i)] != 8:
                fail2(ck, "TypeMismatch", "the channel arguments of 'wait_any' must be Channels")
        if arg_e(ck, a, fx, c, n - 1) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait_any' must be an int (milliseconds)")
        return 0
    fail_attr(ck, a, attr, "UndefinedMethod", "Channel has no method '", "' (only send/recv/wait/wait_any)")
    return 4

def check_task_local_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    elem: int = ck.tt.xa[obj_t]
    if sref_eq(a, attr, "get"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'get' takes no arguments")
        return ty_optional(ck.tt, elem)
    if sref_eq(a, attr, "set"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'set' takes exactly 1 argument")
        if not ty_assignable(ck.tt, elem, arg_e(ck, a, fx, c, 0)):
            fail2(ck, "TypeMismatch", "the argument of 'set' does not match the TaskLocal's element type")
        return 4
    if sref_eq(a, attr, "clear"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'clear' takes no arguments")
        return 4
    fail_attr(ck, a, attr, "UndefinedMethod", "TaskLocal has no method '", "' (only get/set/clear)")
    return 4

def check_thread_handle_method(ck: Ck, a: Ast, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    if sref_eq(a, attr, "join"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'join' takes no arguments")
        return ck.tt.xa[obj_t]
    if sref_eq(a, attr, "cancel"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'cancel' takes no arguments")
        return 4
    fail_attr(ck, a, attr, "UndefinedMethod", "ThreadHandle has no method '", "' (only join and cancel)")
    return 4

def check_thread_channel_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    elem: int = ck.tt.xa[obj_t]
    if sref_eq(a, attr, "send"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'send' takes exactly 1 argument")
        if not ty_assignable(ck.tt, elem, arg_e(ck, a, fx, c, 0)):
            fail2(ck, "TypeMismatch", "the argument of 'send' does not match the channel's element type")
        return 4
    if sref_eq(a, attr, "recv"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'recv' takes no arguments")
        return elem
    fail_attr(ck, a, attr, "UndefinedMethod", "ThreadChannel has no method '", "' (only send/recv)")
    return 4

# `str` metodları (Zig `checkStrMethod`): çekirdek imza tablosu; `__nox_str_<m>` prelude işlevi tanımlıysa yönlendirme (kapsam dışı).
def check_str_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int) -> int:
    tt: TT = ck.tt
    n: int = arg_n(a, c)
    pxs: list[int] = []
    pfx: str = "__nox_str_"
    for i in range(len(pfx)):
        pxs.append(ord(pfx[i]))
    for j in range(sref_len(attr)):
        pxs.append(sref_byte(a, attr, j))
    if m2_get(ck.fmap, 0, sym_intern_list(tt, pxs, 0, len(pxs))) >= 0:
        raise unsup(ck, "str#prelude")
    np: int = -1
    p0: int = 3
    p1: int = 3
    ret: int = 3
    opt: bool = False
    if sref_eq(a, attr, "upper") or sref_eq(a, attr, "lower") or sref_eq(a, attr, "casefold") or sref_eq(a, attr, "strip") or sref_eq(a, attr, "lstrip") or sref_eq(a, attr, "rstrip"):
        np = 0
    elif sref_eq(a, attr, "isdigit") or sref_eq(a, attr, "isalpha") or sref_eq(a, attr, "isalnum") or sref_eq(a, attr, "isspace") or sref_eq(a, attr, "isupper") or sref_eq(a, attr, "islower") or sref_eq(a, attr, "isdecimal") or sref_eq(a, attr, "isnumeric"):
        np = 0
        ret = 2
    elif sref_eq(a, attr, "startswith") or sref_eq(a, attr, "endswith"):
        np = 1
        ret = 2
    elif sref_eq(a, attr, "find") or sref_eq(a, attr, "count") or sref_eq(a, attr, "index"):
        np = 1
        ret = 0
    elif sref_eq(a, attr, "replace"):
        np = 2
    elif sref_eq(a, attr, "zfill"):
        np = 1
        p0 = 0
    elif sref_eq(a, attr, "ljust") or sref_eq(a, attr, "rjust") or sref_eq(a, attr, "center"):
        np = 2
        p0 = 0
        opt = True
    elif sref_eq(a, attr, "split"):
        np = 1
        ret = ty_list(tt, 3)
        opt = True
    elif sref_eq(a, attr, "join"):
        np = 1
        p0 = ty_list(tt, 3)
    if np < 0:
        fail_attr(ck, a, attr, "UndefinedMethod", "str has no method '", "' (upper/lower/strip/lstrip/rstrip/split/join/replace/startswith/endswith/find/index/count/isdigit/isalpha/isalnum/isspace/isupper/islower/ljust/rjust/center/zfill)")
    minn: int = np
    if opt:
        minn = np - 1
    if n < minn or n > np:
        mp(ck, "str.")
        mp_sref(ck, a, attr)
        mp(ck, " expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, n)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    args: int = sl_at(a, c, 1)
    for k in range(n):
        pt: int = p0
        if k == 1:
            pt = p1
        at: int = check_expr_expected(ck, a, fx, stmt_at(a, args, k), pt)
        if not ty_assignable(tt, pt, at):
            mp(ck, "str.")
            mp_sref(ck, a, attr)
            mp(ck, " argument ")
            mp_int(ck, k + 1)
            mp(ck, " has a mismatched type")
            raise mk_fail(ck, "TypeMismatch")
    return ret

# `super().metod(...)` / `super().__init__(...)` (Zig `checkCall` `.attribute` kolu, `isSuperCallExpr`)
def check_super_call(ck: Ck, a: Ast, fx: Fx, c: int, attr: int) -> int:
    if fx.self_cls < 0:
        fail2(ck, "TypeMismatch", "'super()' can only be used inside a method body")
    bsym: int = ck.cls_base[fx.self_cls]
    if bsym < 0:
        mp(ck, "class '")
        mp_sym(ck, ck.cls_sym[fx.self_cls])
        mp(ck, "' has no base class, so 'super()' cannot be used")
        raise mk_fail(ck, "TypeMismatch")
    bi: int = class_idx(ck, bsym)
    asym: int = sym_of(ck, a, attr)
    if sref_eq(a, attr, "__init__"):
        isid: int = ck.cls_init[bi]
        if isid < 0:
            isid = ck.sig_empty
        check_args_sig(ck, a, fx, c, isid, asym)
        return 4
    me: int = m2_get(ck.cls_meths, bi, asym)
    if me >= 0:
        sid: int = ck.cls_meths.vv[me]
        check_args_sig(ck, a, fx, c, sid, asym)
        return ck.fret[sid]
    mp(ck, "base class '")
    mp_sym(ck, bsym)
    mp(ck, "' has no method '")
    mp_sref(ck, a, attr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedMethod")

# `obj.metod(...)` (sınıf örneği + list/dict/str/Task/Channel/TaskLocal/ThreadHandle/ThreadChannel yerleşikleri)
def check_method_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    at: int = a.n[callee + 1]
    obj: int = a.n[at + 0]
    attr: int = pk(a.n[at + 1], a.n[at + 1 + 1])
    qc: int = qualified_call(ck, a, fx, c, callee)
    if qc >= 0:
        return qc
    # `Taban.metod(self, ...)` Zig'de `mixin_flatten` ön geçişiyle `super().metod(...)`e yeniden yazılır: kapsam dışı
    if fx.self_cls >= 0 and a.n[obj] == 5:
        ecd: int = ck.cls_node[fx.self_cls]
        if a.n[ecd + 6] != -4611686018427387904 and sym_of(ck, a, pk(a.n[obj + 1], a.n[obj + 2])) == sym_of(ck, a, pk(a.n[ecd + 6], a.n[ecd + 6 + 1])):
            eargs: int = sl_at(a, c, 1)
            if pky(eargs) >= 1:
                e0: int = stmt_at(a, eargs, 0)
                if a.n[e0] == 5 and sref_eq(a, pk(a.n[e0 + 1], a.n[e0 + 2]), "self"):
                    raise unsup(ck, "class#explicit_base_call")
    if a.n[obj] == 8:
        oc: int = a.n[obj + 1]
        ocal: int = a.n[oc + 0]
        if a.n[ocal] == 5 and sref_eq(a, pk(a.n[ocal + 1], a.n[ocal + 2]), "super") and pky(sl_at(a, oc, 1)) == 0:
            return check_super_call(ck, a, fx, c, attr)
    obj_t: int = check_expr(ck, a, fx, obj)
    require_not_optional_sref(ck, obj_t, a, attr)
    tt: TT = ck.tt
    g: int = tt.tag[obj_t]
    if g == 5:
        return check_list_method(ck, a, fx, c, obj, attr, obj_t)
    if g == 13:
        return check_dict_method(ck, a, fx, c, attr, obj_t)
    if g == 7:
        return check_task_method(ck, a, fx, c, attr)
    if (g == 8 or g == 10) and (sref_eq(a, attr, "send") or sref_eq(a, attr, "recv")) and callee != fx.awaited:
        mp(ck, "'")
        mp_sref(ck, a, attr)
        mp(ck, "' suspends the task: write 'await ch.")
        mp_sref(ck, a, attr)
        mp(ck, "(...)'")
        raise mk_fail(ck, "TypeMismatch")
    if g == 8:
        return check_channel_method(ck, a, fx, c, attr, obj_t)
    if g == 11:
        return check_task_local_method(ck, a, fx, c, attr, obj_t)
    if g == 9:
        return check_thread_handle_method(ck, a, c, attr, obj_t)
    if g == 10:
        return check_thread_channel_method(ck, a, fx, c, attr, obj_t)
    if g == 3:
        return check_str_method(ck, a, fx, c, attr)
    if g != 6:
        mp(ck, "a method call is only valid on class instances")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, obj_t)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, tt.xa[obj_t])
        raise mk_fail(ck, "UndefinedClass")
    asym: int = sym_of(ck, a, attr)
    me: int = m2_get(ck.cls_meths, ci, asym)
    if me >= 0:
        sid: int = ck.cls_meths.vv[me]
        check_args_sig(ck, a, fx, c, sid, asym)
        return ck.fret[sid]
    fe: int = m2_get(ck.cls_fields, ci, asym)
    if fe >= 0:
        ft: int = ck.cls_fields.vv[fe]
        if tt.tag[ft] == 14:
            check_args_func_type(ck, a, fx, c, ft, asym)
            return tt.xb[ft]
        mp(ck, "'")
        mp_sref(ck, a, attr)
        mp(ck, "' is not a function and cannot be called")
        raise mk_fail(ck, "TypeMismatch")
    mp(ck, "class '")
    mp_sym(ck, ck.cls_sym[ci])
    mp(ck, "' has no method '")
    mp_sref(ck, a, attr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedMethod")

# `checkAssign` — alan hedefi (`self.x = v` / `self.x: T = v` / `obj.x = v`)
def check_assign_attr(ck: Ck, a: Ast, fx: Fx, asg: int, tg: int) -> None:
    at: int = a.n[tg + 1]
    obj: int = a.n[at + 0]
    attr: int = pk(a.n[at + 1], a.n[at + 1 + 1])
    asym: int = sym_of(ck, a, attr)
    tt: TT = ck.tt
    # `Sınıf.ad = v`: sınıf adı gölgelenmemişse sınıf özniteliği ataması (bu dilimde sabitsiz: her zaman hata)
    if a.n[obj] == 5:
        osym: int = sym_of(ck, a, pk(a.n[obj + 1], a.n[obj + 2]))
        oci: int = class_idx(ck, osym)
        if oci >= 0 and sc_lookup(ck, fx.scope, osym) < 0 and m2_get(ck.globs, 0, osym) < 0:
            mp(ck, "'")
            mp_sym(ck, osym)
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "' cannot be assigned: it is not a class attribute (class attributes are declared in the class body as 'NAME: T = literal')")
            raise mk_fail(ck, "TypeMismatch")
    obj_t: int = check_expr(ck, a, fx, obj)
    require_not_optional_sref(ck, obj_t, a, attr)
    if tt.tag[obj_t] != 6:
        mp(ck, "'.")
        mp_sref(ck, a, attr)
        mp(ck, "' can only be used on class instances")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, obj_t)
    is_self: bool = a.n[obj] == 5 and sref_eq(a, pk(a.n[obj + 1], a.n[obj + 2]), "self")
    fe: int = m2_get(ck.cls_fields, ci, asym)
    existing: int = -1
    if fe >= 0:
        existing = ck.cls_fields.vv[fe]
    ann: int = a.n[asg + 2]
    if ann >= 0:
        declared: int = type_expr_to_type(ck, a, ann)
        if existing >= 0:
            if existing != declared:
                mp(ck, "the annotation of '")
                mp_sym(ck, ck.cls_sym[ci])
                mp(ck, ".")
                mp_sref(ck, a, attr)
                mp(ck, "' does not match the declared field type")
                raise mk_fail(ck, "TypeMismatch")
        elif not (is_self and fx.is_init):
            mp(ck, "in class '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, "', field '")
            mp_sref(ck, a, attr)
            mp(ck, "' can only be defined in __init__ with 'self.")
            mp_sref(ck, a, attr)
            mp(ck, ": T = ...'")
            raise mk_fail(ck, "UndefinedAttribute")
        vt: int = check_expr_expected(ck, a, fx, a.n[asg + 1], declared)
        if not ty_assignable(tt, declared, vt):
            mp(ck, "type mismatch for '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        if existing < 0:
            m2_put(ck.cls_fields, ci, asym, declared)
        else:
            m2_remove(ck.cls_unas, ci, asym)
        return
    value_t: int = check_expr_expected(ck, a, fx, a.n[asg + 1], existing)
    if existing >= 0:
        if not ty_assignable(tt, existing, value_t):
            mp(ck, "type mismatch for '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        m2_remove(ck.cls_unas, ci, asym)
    else:
        if not (is_self and fx.is_init):
            mp(ck, "in class '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, "', field '")
            mp_sref(ck, a, attr)
            mp(ck, "' can only be defined in __init__ with 'self.")
            mp_sref(ck, a, attr)
            mp(ck, " = ...'")
            raise mk_fail(ck, "UndefinedAttribute")
        m2_put(ck.cls_fields, ci, asym, value_t)

# `checkAssign` — indeks hedefi (`xs[i] = v` / `d[k] = v`)
def check_assign_index(ck: Ck, a: Ast, fx: Fx, asg: int, tg: int) -> None:
    ip: int = a.n[tg + 1]
    obj_t: int = check_expr(ck, a, fx, a.n[ip + 0])
    require_not_optional(ck, obj_t, "[]")
    tt: TT = ck.tt
    if has_dunder(ck, obj_t, "__setitem__"):
        raise unsup(ck, "check_assign_index#dunder")
    if tt.tag[obj_t] == 5:
        kt: int = check_expr(ck, a, fx, a.n[ip + 1])
        if kt != 0:
            mp(ck, "the list index must be an 'int'")
            raise mk_fail(ck, "TypeMismatch")
        el: int = tt.xa[obj_t]
        vt: int = check_expr_expected(ck, a, fx, a.n[asg + 1], el)
        if not ty_assignable(tt, el, vt):
            mp(ck, "type mismatch in indexed assignment: it does not match the list's element type")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tt.tag[obj_t] != 13:
        mp(ck, "indexed assignment only works on 'list'/'dict'")
        raise mk_fail(ck, "TypeMismatch")
    kt2: int = check_expr(ck, a, fx, a.n[ip + 1])
    if kt2 != tt.xa[obj_t]:
        mp(ck, "the dict index does not match the key type")
        raise mk_fail(ck, "TypeMismatch")
    dv: int = tt.xb[obj_t]
    vt2: int = check_expr_expected(ck, a, fx, a.n[asg + 1], dv)
    if not ty_assignable(tt, dv, vt2):
        mp(ck, "the dict value does not match the value type")
        raise mk_fail(ck, "TypeMismatch")

# `checkAssign`in identifier hedefi; `_ = ifade` at-gitsin atamasını da içerir.
def check_assign(ck: Ck, a: Ast, fx: Fx, asg: int) -> None:
    tg: int = a.n[asg + 0]
    if a.n[tg] == 9:
        check_assign_attr(ck, a, fx, asg, tg)
        return
    if a.n[tg] == 10:
        check_assign_index(ck, a, fx, asg, tg)
        return
    if a.n[tg] != 5:
        raise unsup(ck, "check_assign#1")
    nv: int = pk(a.n[tg + 1], a.n[tg + 2])
    sym: int = sym_of(ck, a, nv)
    if sref_eq(a, nv, "_") and a.n[asg + 2] < 0 and sc_lookup(ck, fx.scope, sym) < 0 and m2_get(ck.globs, 0, sym) < 0:
        check_expr(ck, a, fx, a.n[asg + 1])
        return
    existing: int = sc_lookup_local(ck, fx.scope, sym)
    if existing < 0:
        if ck.sp[fx.scope] >= 0 and sc_exists(ck, ck.sp[fx.scope], sym):
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "' is a variable captured from OUTSIDE the nested function and can only be READ (assignment is not supported)")
            raise mk_fail(ck, "TypeMismatch")
        # modül global'i denenir
        gi: int = m2_get(ck.globs, 0, sym)
        if gi < 0:
            mp(ck, "undefined variable: ")
            mp_sym(ck, sym)
            mp(ck, " (give the type on first assignment: `")
            mp_sym(ck, sym)
            mp(ck, ": <type> = ...`)")
            raise mk_fail(ck, "UndefinedVariable")
        existing = ck.globs.vv[gi]
    value_t: int = check_expr_expected(ck, a, fx, a.n[asg + 1], existing)
    if not ty_assignable(ck.tt, existing, value_t):
        mp(ck, "type mismatch for '")
        mp_sym(ck, sym)
        mp(ck, "'")
        raise mk_fail(ck, "TypeMismatch")

# `alwaysReturns`
def always_returns(a: Ast, s: int) -> bool:
    n: int = pky(s)
    if n == 0:
        return False
    st: int = stmt_at(a, s, n - 1)
    kn: int = a.n[a.n[st + 0]]
    pay: int = a.n[a.n[st + 0] + 1]
    if kn == 11 or kn == 12:
        return True
    if kn == 4:
        if a.n[pay + 5] == -4611686018427387904:
            return False
        if not always_returns(a, sl_at(a, pay, 1)):
            return False
        ecs: int = sl_at(a, pay, 3)
        for j in range(pky(ecs)):
            if not always_returns(a, sl_at(a, stmt_at(a, ecs, j), 1)):
                return False
        return always_returns(a, sl_at(a, pay, 5))
    if kn == 13:
        if a.n[pay + 4] != -4611686018427387904:
            if always_returns(a, sl_at(a, pay, 4)):
                return True
        if not always_returns(a, sl_at(a, pay, 0)):
            return False
        exs: int = sl_at(a, pay, 2)
        for k in range(pky(exs)):
            if not always_returns(a, sl_at(a, stmt_at(a, exs, k), 4)):
                return False
        return pky(exs) > 0 or a.n[pay + 4] != -4611686018427387904
    if kn == 21:
        return always_returns(a, sl_at(a, pay, 3))
    if kn == 14:
        return always_returns(a, sl_at(a, pay, 0))
    return False

def sref_eq_ref(a: Ast, u: int, v: int) -> bool:
    if sref_len(u) != sref_len(v):
        return False
    for i in range(sref_len(u)):
        if sref_byte(a, u, i) != sref_byte(a, v, i):
            return False
    return True

# ---- `extern def` (Zig `registerExternFunc`; dekoratörlü biçimler kapsam dışı) ----
# `isFfiSafeType`
def ffi_safe_type(ck: Ck, t: int) -> bool:
    tt: TT = ck.tt
    g: int = tt.tag[t]
    if t <= 5 or g == 16 or g == 17:
        return True
    if g == 13:
        return tt.xa[t] == 3 and tt.xb[t] == 3
    if g == 14:
        base: int = tt.xa[t]
        for i in range(tt.xc[t]):
            pg: int = tt.fp[base + i]
            if not (pg == 0 or pg == 1 or pg == 2 or pg == 5 or tt.tag[pg] == 16):
                return False
        rg: int = tt.xb[t]
        return rg == 0 or rg == 1 or rg == 2 or rg == 5 or rg == 4 or tt.tag[rg] == 16
    return False

def register_extern(ck: Ck, a: Ast, ed: int) -> None:
    nm: int = pk(a.n[ed + 0], a.n[ed + 0 + 1])
    ps: int = sl_at(a, ed, 2)
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if a.n[p + 8] >= 0:
            mp(ck, "'extern def ")
            mp_sref(ck, a, nm)
            mp(ck, "': parameter '")
            mp_sref(ck, a, pk(a.n[p + 0], a.n[p + 0 + 1]))
            mp(ck, "' cannot have a default value")
            raise mk_fail(ck, "TypeMismatch")
    sym: int = sym_of(ck, a, nm)
    if m2_get(ck.fmap, 0, sym) >= 0:
        mp(ck, "function already defined: ")
        mp_sref(ck, a, nm)
        raise mk_fail(ck, "DuplicateDefinition")
    needs_rt: bool = a.n[ed + 7] != 0
    tys: list[int] = []
    pnames: list[int] = []
    for q in range(pky(ps)):
        pq: int = stmt_at(a, ps, q)
        pt: int = type_expr_to_type(ck, a, a.n[pq + 6])
        pg: int = ck.tt.tag[pt]
        lst_ok: bool = pg == 5 and (ck.tt.xa[pt] == 3 or ck.tt.xa[pt] == 0)
        rt_fixed: bool = needs_rt and pg == 5 and ck.tt.tag[ck.tt.xa[pt]] == 16
        if not ffi_safe_type(ck, pt) and not lst_ok and not rt_fixed and not (needs_rt and pg == 6):
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': parameter '")
            mp_sref(ck, a, pk(a.n[pq + 0], a.n[pq + 0 + 1]))
            mp(ck, "' has an unsupported type (only int/float/bool/str/None/list[str]/list[int] can cross the C ABI boundary in v0.1)")
            raise mk_fail(ck, "TypeMismatch")
        tys.append(pt)
        pnames.append(-1)
    ret: int = type_expr_to_type(ck, a, a.n[ed + 4])
    rg2: int = ck.tt.tag[ret]
    rlst: bool = rg2 == 5 and (ck.tt.xa[ret] == 3 or ck.tt.xa[ret] == 0)
    if not ffi_safe_type(ck, ret) and not rlst and rg2 != 6:
        mp(ck, "extern function '")
        mp_sref(ck, a, nm)
        mp(ck, "': the return type is unsupported (only int/float/bool/str/None/list[str]/list[int]/class can cross the C ABI boundary in v0.1)")
        raise mk_fail(ck, "TypeMismatch")
    # `@ffi.*`/`@capability.requires` dekoratörleri kapsam dışı
    if pky(sl_at(a, ed, 10)) > 0:
        raise unsup(ck, "extern#decorators")
    rts: int = sl_at(a, ed, 8)
    for r in range(pky(rts)):
        rn: int = pk(a.l[pkx(rts) + r * 2], a.l[pkx(rts) + r * 2 + 1])
        found: bool = False
        for f in range(pky(ps)):
            fp: int = stmt_at(a, ps, f)
            if sref_eq_ref(a, pk(a.n[fp + 0], a.n[fp + 0 + 1]), rn):
                found = True
        if not found:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': 'retains/@ffi.escape(\"")
            mp_sref(ck, a, rn)
            mp(ck, "\")' names an unknown parameter")
            raise mk_fail(ck, "UnknownRetainedParam")
    m2_put(ck.fmap, 0, sym, new_sig(ck, tys, pnames, ret))

# `registerFunc` (skaler dilim): varsayılan/variadik/dekoratörlü/jenerik/async işlevler kapsam dışı.
def register_func(ck: Ck, a: Ast, fd: int) -> None:
    nm: int = pk(a.n[fd + 0], a.n[fd + 0 + 1])
    ps: int = sl_at(a, fd, 4)
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if a.n[p + 8] >= 0 or a.n[p + 2] != 0 or a.n[p + 3] != 0 or a.n[p + 4] != 0 or a.n[p + 5] != 0:
            raise unsup(ck, "register_func#1")
    if pky(sl_at(a, fd, 2)) > 0 or pky(sl_at(a, fd, 11)) > 0 or pky(sl_at(a, fd, 15)) > 0:
        raise unsup(ck, "register_func#2")
    if sref_eq(a, nm, "main"):
        mp(ck, "'main' is a reserved name: Nox has no 'def main()' convention, top-level statements are already the program's entry point — define this function under another name")
        raise mk_fail(ck, "DuplicateDefinition")
    sym: int = sym_of(ck, a, nm)
    if m2_get(ck.fmap, 0, sym) >= 0:
        mp(ck, "function already defined: ")
        mp_sym(ck, sym)
        raise mk_fail(ck, "DuplicateDefinition")
    tys: list[int] = []
    pnames: list[int] = []
    for k in range(pky(ps)):
        pk_node: int = stmt_at(a, ps, k)
        tys.append(type_expr_to_type(ck, a, a.n[pk_node + 6]))
        pnames.append(sym_of(ck, a, pk(a.n[pk_node + 0], a.n[pk_node + 0 + 1])))
    ret: int = type_expr_to_type(ck, a, a.n[fd + 6])
    if a.n[fd + 10] != 0:
        # `isSpawnParamSafeType` (hosted profil, varsayılan): thread_handle(9)/func(14)/optional(15) kapanış paketlemesinden geçemez
        for k2 in range(len(tys)):
            tg: int = ck.tt.tag[tys[k2]]
            if tg == 9 or tg == 14 or tg == 15:
                mp(ck, "'async def ")
                mp_sym(ck, sym)
                mp(ck, "': parameter '")
                mp_sym(ck, pnames[k2])
                mp(ck, "' has an unsupported type (only int/float/bool/str/None/Task[T]/Channel[T]/ThreadChannel[T] parameters can be packed, and additionally list/class/dict on hosted targets)")
                raise mk_fail(ck, "TypeMismatch")
        m2_put(ck.afn, 0, sym, 1)
    m2_put(ck.fmap, 0, sym, new_sig(ck, tys, pnames, ret))

# `checkFunctionBody`
def check_function_body(ck: Ck, a: Ast, fd: int) -> None:
    gl: int = sl_at(a, fd, 17)
    for gi in range(pky(gl)):
        gv: int = pk(a.l[pkx(gl) + gi * 2], a.l[pkx(gl) + gi * 2 + 1])
        gs: int = sym_of(ck, a, gv)
        if m2_get(ck.globs, 0, gs) < 0:
            mp(ck, "'global ")
            mp_sym(ck, gs)
            mp(ck, "': there is no module-level variable named '")
            mp_sym(ck, gs)
            mp(ck, "' (declare it at module level with a type: '")
            mp_sym(ck, gs)
            mp(ck, ": <type> = ...')")
            raise mk_fail(ck, "UndefinedVariable")
    scope: int = sc_new(ck, -1, False)
    ps: int = sl_at(a, fd, 4)
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        pt: int = type_expr_to_type(ck, a, a.n[p + 6])
        sc_declare(ck, scope, sym_of(ck, a, pk(a.n[p + 0], a.n[p + 0 + 1])), pt)
    ret: int = type_expr_to_type(ck, a, a.n[fd + 6])
    fx: Fx = Fx(scope, ret, a.n[fd + 10] != 0)
    body: int = sl_at(a, fd, 8)
    check_block(ck, a, fx, body)
    if ret != 4 and not always_returns(a, body):
        mp(ck, "function '")
        mp_sref(ck, a, pk(a.n[fd + 0], a.n[fd + 0 + 1]))
        mp(ck, "' does not return a value on all paths")
        raise mk_fail(ck, "MissingReturn")

# `collectModuleGlobals`: üst-düzey `var_decl`ların bildirilen tipleri (+ değişmez tamsayı sabitleri). `__infer` bildirimleri terfi etmez.
def collect_module_globals(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + 1]
        ck.cur_span = a.n[st + 2]
        kn: int = a.n[st + 0]
        if a.n[kn] != 1:
            continue
        v: int = a.n[kn + 1]
        te: int = a.n[v + 2]
        if a.n[te] == 0 and sref_eq(a, pk(a.n[te + 1], a.n[te + 2]), "__infer"):
            continue
        declared: int = type_expr_to_type(ck, a, te)
        nm: int = pk(a.n[v + 0], a.n[v + 0 + 1])
        sym: int = sym_of(ck, a, nm)
        m2_put(ck.globs, 0, sym, declared)
        if declared == 0:
            val: int = a.n[v + 3]
            if a.n[val] == 0:
                m2_put(ck.iconsts, 0, sym, a.n[val + 1])
            elif a.n[val] == 6:
                up: int = a.n[val + 1]
                if a.n[up + 0] == 0 and a.n[a.n[up + 1]] == 0:
                    m2_put(ck.iconsts, 0, sym, 0 - a.n[a.n[up + 1] + 1])
    # yeniden atanan (modülün herhangi bir yerinde, muhafazakâr) adlar sabit değildir
    for e in range(len(ck.iconsts.k1)):
        if ck.iconsts.dead[e] == 0:
            nsym: int = ck.iconsts.k2[e]
            tt: TT = ck.tt
            if stmts_assign_name_sym(a, body, tt, nsym):
                ck.iconsts.dead[e] = 1
                ck.iconsts.live = ck.iconsts.live - 1

# `stmts_assign_name`in SymbolId ile çağrılan biçimi (bayt aralığına çevirir).
def stmts_assign_name_sym(a: Ast, body: int, tt: TT, sym: int) -> bool:
    xs: list[int] = []
    o: int = tt.so[sym]
    for i in range(tt.sl[sym]):
        xs.append(tt.sb[o + i])
    return stmts_assign_name_ints(a, body, xs)

def sref_is_ints(a: Ast, v: int, xs: list[int]) -> bool:
    x: int = pkx(v)
    ln: int = pky(v)
    if x >= 0:
        ln = ln - x
    if ln != len(xs):
        return False
    for i in range(ln):
        if sref_byte(a, v, i) != xs[i]:
            return False
    return True

def stmts_assign_name_ints(a: Ast, s: int, xs: list[int]) -> bool:
    cnt: int = pky(s)
    for i in range(cnt):
        st: int = a.l[pkx(s) + i]
        kn: int = a.n[st + 0]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == 3:
            tg: int = a.n[pay + 0]
            if a.n[tg] == 5 and sref_is_ints(a, pk(a.n[tg + 1], a.n[tg + 2]), xs):
                return True
        elif tag == 4:
            if stmts_assign_name_ints(a, sl_at(a, pay, 1), xs):
                return True
            ecs: int = sl_at(a, pay, 3)
            for j in range(pky(ecs)):
                if stmts_assign_name_ints(a, sl_at(a, a.l[pkx(ecs) + j], 1), xs):
                    return True
            if a.n[pay + 5] != -4611686018427387904:
                if stmts_assign_name_ints(a, sl_at(a, pay, 5), xs):
                    return True
        elif tag == 5:
            if stmts_assign_name_ints(a, sl_at(a, pay, 1), xs):
                return True
        elif tag == 6:
            if sref_is_ints(a, pk(a.n[pay + 0], a.n[pay + 0 + 1]), xs):
                return True
            if stmts_assign_name_ints(a, sl_at(a, pay, 3), xs):
                return True
        elif tag == 7:
            if stmts_assign_name_ints(a, sl_at(a, pay, 8), xs):
                return True
        elif tag == 8:
            cms: int = sl_at(a, pay, 16)
            for q in range(pky(cms)):
                if stmts_assign_name_ints(a, sl_at(a, a.l[pkx(cms) + q], 8), xs):
                    return True
        elif tag == 13:
            if stmts_assign_name_ints(a, sl_at(a, pay, 0), xs):
                return True
            exs: int = sl_at(a, pay, 2)
            for k in range(pky(exs)):
                if stmts_assign_name_ints(a, sl_at(a, a.l[pkx(exs) + k], 4), xs):
                    return True
            if a.n[pay + 4] != -4611686018427387904:
                if stmts_assign_name_ints(a, sl_at(a, pay, 4), xs):
                    return True
        elif tag == 21:
            if stmts_assign_name_ints(a, sl_at(a, pay, 3), xs):
                return True
        elif tag == 14:
            if stmts_assign_name_ints(a, sl_at(a, pay, 0), xs):
                return True
    return False

# `nonlocal_desugar` kapısı: herhangi bir (iç içe) `def` `nonlocal` bildiriyorsa Zig sahip işlevin değişkenini hücreye (`__nl_x[0]`) çevirir: kapsam dışı.
def stmts_have_nonlocal(a: Ast, s: int) -> bool:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        kn: int = a.n[st + 0]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == 7:
            if pky(sl_at(a, pay, 15)) > 0 or stmts_have_nonlocal(a, sl_at(a, pay, 8)):
                return True
        elif tag == 8:
            ms: int = sl_at(a, pay, 16)
            for q in range(pky(ms)):
                m: int = stmt_at(a, ms, q)
                if pky(sl_at(a, m, 15)) > 0 or stmts_have_nonlocal(a, sl_at(a, m, 8)):
                    return True
        elif tag == 4:
            if stmts_have_nonlocal(a, sl_at(a, pay, 1)):
                return True
            ecs: int = sl_at(a, pay, 3)
            for j in range(pky(ecs)):
                if stmts_have_nonlocal(a, sl_at(a, a.l[pkx(ecs) + j], 1)):
                    return True
            if a.n[pay + 5] != -4611686018427387904 and stmts_have_nonlocal(a, sl_at(a, pay, 5)):
                return True
        elif tag == 5:
            if stmts_have_nonlocal(a, sl_at(a, pay, 1)):
                return True
        elif tag == 6:
            if stmts_have_nonlocal(a, sl_at(a, pay, 3)):
                return True
        elif tag == 13:
            if stmts_have_nonlocal(a, sl_at(a, pay, 0)):
                return True
            exs: int = sl_at(a, pay, 2)
            for k in range(pky(exs)):
                if stmts_have_nonlocal(a, sl_at(a, a.l[pkx(exs) + k], 4)):
                    return True
            if a.n[pay + 4] != -4611686018427387904 and stmts_have_nonlocal(a, sl_at(a, pay, 4)):
                return True
        elif tag == 21:
            if stmts_have_nonlocal(a, sl_at(a, pay, 3)):
                return True
        elif tag == 14:
            if stmts_have_nonlocal(a, sl_at(a, pay, 0)):
                return True
    return False

# `Checker.checkModule` (skaler dilim). Dönüş: 0 = kabul, 1 = tanılama/hata (ayrıntı `nox_ck_diag_*`/`o_*`), 2 = kapsam dışı.
def check_module(ck: Ck, a: Ast, body: int) -> int:
    ck.cur_line = 0
    ck.cur_span = -1
    ck.o_code = ""
    ck.o_msg = []
    # kapsam dışı üst-düzey deyim türleri (import/sınıf/protokol/extern/takma ad ...): bu geçişler henüz taşınmadı
    for i in range(pky(body)):
        kn: int = a.n[a.n[stmt_at(a, body, i) + 0]]
        if kn == 9 or kn == 2:
            ck.why = "toplevel#" + str(kn)
            return 2
    if stmts_have_nonlocal(a, body):
        ck.why = "nonlocal"
        return 2
    try:
        ck.sig_empty = new_sig(ck, [], [], 4)
        collect_imports(ck, a, body)
        check_base_cycles(ck, a, body)
        collect_class_names(ck, a, body)
        resolve_reexport(ck, a, body)
        # registerSignatures
        for j in range(pky(body)):
            st: int = stmt_at(a, body, j)
            ck.cur_line = a.n[st + 1]
            ck.cur_span = a.n[st + 2]
            kn2: int = a.n[st + 0]
            if a.n[kn2] == 7:
                register_func(ck, a, a.n[kn2 + 1])
            elif a.n[kn2] == 10:
                register_extern(ck, a, a.n[kn2 + 1])
            elif a.n[kn2] == 8:
                ensure_class_sig(ck, a, class_idx(ck, sym_of(ck, a, pk(a.n[a.n[kn2 + 1] + 0], a.n[a.n[kn2 + 1] + 0 + 1]))))
        resolve_reexport(ck, a, body)
        collect_module_globals(ck, a, body)
    except CkUnsupported:
        return 2
    except CkErr:
        ck.o_code = ck.err_code
        ck.o_msg = ck.diag_msg
        return 1
    ck.top_scope = sc_new(ck, -1, False)
    top: Fx = Fx(ck.top_scope, -1, True)
    for k in range(pky(body)):
        st3: int = stmt_at(a, body, k)
        ck.cur_line = a.n[st3 + 1]
        ck.cur_span = a.n[st3 + 2]
        kn3: int = a.n[st3 + 0]
        try:
            if a.n[kn3] == 7:
                check_function_body(ck, a, a.n[kn3 + 1])
            elif a.n[kn3] == 10 or a.n[kn3] == 15 or a.n[kn3] == 16:
                pass
            elif a.n[kn3] == 8:
                ensure_class_checked(ck, a, class_idx(ck, sym_of(ck, a, pk(a.n[a.n[kn3 + 1] + 0], a.n[a.n[kn3 + 1] + 0 + 1]))))
            else:
                check_stmt(ck, a, top, st3)
        except CkUnsupported:
            return 2
        except CkErr:
            ck.depth = 0
            record_diag(ck, a)
    if len(ck.dcode) > 0:
        ck.o_code = ck.dcode[0]
        for m in range(ck.dlen[0]):
            ck.o_msg.append(ck.dbytes[ck.doff[0] + m])
        return 1
    return 0

# ---- Zig <-> Nox test köprüsü (noxc-nightly `ck-diff`) ----
CG: Ck = Ck(ty_global())

def nox_ck_reset() -> int:
    global CG
    CG = Ck(ty_global())
    return 0

def nox_ck_scope_new(parent: int, has_caps: int) -> int:
    return sc_new(CG, parent, has_caps != 0)

def nox_ck_declare(scope: int, sym: int, ty: int) -> int:
    sc_declare(CG, scope, sym, ty)
    return 0

def nox_ck_lookup_local(scope: int, sym: int) -> int:
    return sc_lookup_local(CG, scope, sym)

def nox_ck_lookup(scope: int, sym: int) -> int:
    return sc_lookup(CG, scope, sym)

def nox_ck_exists(scope: int, sym: int) -> int:
    if sc_exists(CG, scope, sym):
        return 1
    return 0

def nox_ck_declare_var(scope: int, sym: int, ty: int) -> int:
    return declare_var(CG, scope, sym, ty)

def nox_ck_set_nonarc(sym: int, flag: int) -> int:
    cls_set_nonarc(CG.tt, sym, flag)
    return 0

# Kapsamın yakalama sayısı ve i. yakalama (0: sembol, 1: tip), ekleme sırasıyla.
def nox_ck_caps_n(scope: int) -> int:
    cs: int = CG.sc[scope]
    if cs < 0:
        return 0
    n: int = 0
    for e in range(len(CG.caps.k1)):
        if CG.caps.k1[e] == cs and CG.caps.dead[e] == 0:
            n = n + 1
    return n

def nox_ck_cap(scope: int, i: int, which: int) -> int:
    cs: int = CG.sc[scope]
    n: int = 0
    for e in range(len(CG.caps.k1)):
        if CG.caps.k1[e] == cs and CG.caps.dead[e] == 0:
            if n == i:
                if which == 0:
                    return CG.caps.k2[e]
                return CG.caps.vv[e]
            n = n + 1
    return -1

# Modül düzeyi tablolar. which: 0 = module_globals, 1 = module_int_consts. Değerler: tip kimliği / tamsayı.
def ck_tab(which: int) -> Map2:
    if which == 0:
        return CG.globs
    return CG.iconsts

def nox_ck_tab_put(which: int, sym: int, v: int) -> int:
    m2_put(ck_tab(which), 0, sym, v)
    return 0

# Var mı: 1/0 (değer ayrı çağrıyla).
def nox_ck_tab_has(which: int, sym: int) -> int:
    if m2_get(ck_tab(which), 0, sym) >= 0:
        return 1
    return 0

def nox_ck_tab_get(which: int, sym: int) -> int:
    m: Map2 = ck_tab(which)
    e: int = m2_get(m, 0, sym)
    if e < 0:
        return 0
    return m.vv[e]

def nox_ck_tab_remove(which: int, sym: int) -> int:
    if m2_remove(ck_tab(which), 0, sym):
        return 1
    return 0

def nox_ck_tab_live(which: int) -> int:
    return ck_tab(which).live

# `stmtsAssignName(son ayrıştırılan modülün gövdesi, ad)`; ad: `base[off:off+n]` baytları (`types.nox` `nox_ty_names` tamponu değil; çağıran `base` verir).
def nox_ck_assigns_name(base: int, off: int, n: int) -> int:
    if stmts_assign_name(parse_ast(), parse_body(), base, off, n):
        return 1
    return 0

def nox_ck_mem() -> int:
    c: Ck = CG
    return (len(c.sp) * 2 + len(c.vars.k1) * 4 + len(c.vars.slots) + len(c.caps.k1) * 4 + len(c.caps.slots) + len(c.globs.k1) * 4 + len(c.globs.slots) + len(c.iconsts.k1) * 4 + len(c.iconsts.slots)) * 8

# ---- ölçüm (ck-bench): Zig `selfhost_ck_diff.zig` `benchZig` ile AYNI iş yükü ve sağlama toplamı ----
# ns kapsam zinciri (i. kapsamın üstü i-1; i % 4 == 3 olanlar yakalamalı), nn ad, m işlem (%70 lookup, %30 declare).
def nox_ck_bench(seed: int, ns: int, nn: int, m: int) -> int:
    ck: Ck = Ck(ty_global())
    for i in range(ns):
        par: int = i - 1
        sc_new(ck, par, i % 4 == 3)
    x: int = seed & 2147483647
    acc: int = 0
    for j in range(m):
        x = lcg(x)
        op: int = (x >> 6) % 10
        x = lcg(x)
        s: int = (x >> 4) % ns
        x = lcg(x)
        sym: int = (x >> 4) % nn
        if op < 7:
            acc = acc + sc_lookup(ck, s, sym) + 1
        else:
            x = lcg(x)
            sc_declare(ck, s, sym, (x >> 4) % 5)
    return acc + len(ck.caps.k1)

# ---- 3.3: `check` farksal köprüsü ----
# Zig'den düz-dizi olarak itilen (`ast_schema.G`) birleşik modülü denetler (`ck-diff checkm`).
def nox_ck_check_loaded(body_start: int, body_len: int) -> int:
    global CG
    CG = Ck(ty_global())
    try:
        return check_module(CG, loaded_ast(), pk(body_start, body_len))
    except Exception:
        return -1

def nox_ck_check() -> int:
    global CG
    CG = Ck(ty_global())
    # beklenmeyen (CkErr/CkUnsupported dışı) çalışma hatası sessizce 0 dönmesin: -1 = iç hata
    try:
        return check_module(CG, parse_ast(), parse_body())
    except Exception:
        return -1

# Metin alma: which 0 = sonuç kodu adı, 1 = sonuç iletisi, 2 = i. tanılamanın kodu, 3 = i. tanılamanın iletisi. Dönüş: bayt sayısı (veri `nox_ck_out_buffer`).
def nox_ck_text(which: int, i: int) -> int:
    ck: Ck = CG
    ck.out = []
    if which == 0:
        for k in range(len(ck.o_code)):
            ck.out.append(ord(ck.o_code[k]))
    elif which == 1:
        for k2 in range(len(ck.o_msg)):
            ck.out.append(ck.o_msg[k2])
    elif which == 4:
        for k5 in range(len(ck.why)):
            ck.out.append(ord(ck.why[k5]))
    elif which == 2:
        for k3 in range(len(ck.dcode[i])):
            ck.out.append(ord(ck.dcode[i][k3]))
    else:
        for k4 in range(ck.dlen[i]):
            ck.out.append(ck.dbytes[ck.doff[i] + k4])
    return len(ck.out)

def nox_ck_out_buffer() -> int:
    xs: list[int] = CG.out
    p: int = 0
    lowlevel:
        p = ptr_to_int(ptr_of(xs))
    return p

def nox_ck_diag_n() -> int:
    return len(CG.dcode)

# field 0 = satır, 1..6 = span (start_byte, end_byte, start_line, start_col, end_line, end_col)
def nox_ck_diag_int(i: int, field: int) -> int:
    if field == 0:
        return CG.dline[i]
    return CG.dspan[i * 6 + field - 1]

# noxc-nightly Aşama 1: Nox lexer'ı (compiler/lexer/lexer.zig'in birebir portu). Bu dosya ŞABLONDUR: `scripts/gen_selfhost_lexer.py` K-yer tutucularını (token türü sayıları), anahtar sözcük işlevini ve
# Unicode tablolarını üretip `selfhost/lexer.nox`u yazar (elle düzenlenen kaynak BU dosyadır).
#
# Veri sınırı (düz sayı arabelleği): Zig, kaynak baytlarının adresini ve uzunluğunu verir; `nox_lex_run(base, n, want_trivia)` token başına 5 tamsayı yazar
# [kind, line, col, start_byte, end_byte] ve token sayısını (hata ise negatif kod) döner. `nox_lex_buffer()` arabelleğin adresini verir.
# Hata kodları: 1 UnexpectedCharacter, 2 UnterminatedString, 3 InconsistentIndentation, 4 TabsNotAllowed (Zig `LexError` ile aynı adlar).

class Lx:
    base: int
    n: int
    out: list[int]
    trivia: list[int]
    want_trivia: bool
    err_line: int
    err_col: int
    err_byte: int
    kind: int

    def __init__(self, base: int, n: int, want_trivia: bool) -> None:
        self.base = base
        self.n = n
        self.out = []
        self.trivia = []
        self.want_trivia = want_trivia
        self.err_line = 0
        self.err_col = 0
        self.err_byte = 0
        self.kind = 0

{{UNI_TABLES}}

G_OUT: list[int] = []
G_TRIVIA: list[int] = []
G_ERR_LINE: int = 0
G_ERR_COL: int = 0
G_ERR_BYTE: int = 0

# `base` adresindeki `i`. bayt (`lowlevel` içinde yalnızca ham okuma; sınıf kurma/`list[Sınıf]` burada yok).
def at(base: int, i: int) -> int:
    c: int = 0
    lowlevel:
        c = int(ptr_read(ptr_offset(ptr[u8](base), i)))
    return c

def peek(base: int, n: int, i: int) -> int:
    if i >= n:
        return 0
    return at(base, i)

def is_digit(c: int) -> bool:
    return c >= 48 and c <= 57

def is_hex(c: int) -> bool:
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)

def is_istart(c: int) -> bool:
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

def is_icont(c: int) -> bool:
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 or (c >= 48 and c <= 57)

# (lo, hi) çiftlerinden oluşan düz tabloda ikili arama (Zig `unicode_ident.inRanges`).
def in_ranges(tbl: list[int], cp: int) -> bool:
    lo: int = 0
    hi: int = len(tbl) // 2
    while lo < hi:
        mid: int = lo + (hi - lo) // 2
        if cp < tbl[mid * 2]:
            hi = mid
        elif cp > tbl[mid * 2 + 1]:
            lo = mid + 1
        else:
            return True
    return False

# `base[i..]` bir Unicode tanımlayıcı karakteriyle başlıyorsa UTF-8 bayt uzunluğu, yoksa 0 (Zig `uniIdentLen`; `std.unicode` doğrulamasıyla aynı: aşırı uzun/yedek/aralık dışı = 0).
def uni_len(base: int, n: int, i: int, is_start: bool) -> int:
    b0: int = at(base, i)
    ln: int = 0
    if b0 < 128:
        ln = 1
    elif b0 >= 194 and b0 <= 223:
        ln = 2
    elif b0 >= 224 and b0 <= 239:
        ln = 3
    elif b0 >= 240 and b0 <= 244:
        ln = 4
    else:
        return 0
    if i + ln > n:
        return 0
    cp: int = b0
    if ln == 2:
        b1: int = at(base, i + 1)
        if (b1 & 192) != 128:
            return 0
        cp = ((b0 & 31) << 6) | (b1 & 63)
    elif ln == 3:
        c1: int = at(base, i + 1)
        c2: int = at(base, i + 2)
        if (c1 & 192) != 128 or (c2 & 192) != 128:
            return 0
        cp = ((b0 & 15) << 12) | ((c1 & 63) << 6) | (c2 & 63)
        if cp < 2048:
            return 0
        if cp >= 55296 and cp <= 57343:
            return 0
    elif ln == 4:
        d1: int = at(base, i + 1)
        d2: int = at(base, i + 2)
        d3: int = at(base, i + 3)
        if (d1 & 192) != 128 or (d2 & 192) != 128 or (d3 & 192) != 128:
            return 0
        cp = ((b0 & 7) << 18) | ((d1 & 63) << 12) | ((d2 & 63) << 6) | (d3 & 63)
        if cp < 65536 or cp > 1114111:
            return 0
    ok: bool = False
    if is_start:
        ok = in_ranges(UNI_START, cp)
    else:
        ok = in_ranges(UNI_CONT, cp)
    if ok:
        return ln
    return 0

{{KEYWORD_FN}}

# Not: liste büyürken yeniden tahsis edilebildiğinden (yerel bir takma ad bayatlar) token arabelleğine HER ZAMAN `st.out` alanı üzerinden eklenir.
def emit(st: Lx, kind: int, line: int, col: int, start: int, end: int) -> None:
    st.out.append(kind)
    st.out.append(line)
    st.out.append(col)
    st.out.append(start)
    st.out.append(end)

# Trivia kaydı (formatter): [tür (0 yorum, 1 boş satır), satır, sonda mı (yalnızca yorum), başlangıç, bitiş]; yalnızca `want_trivia` iken yazılır.
def emit_trivia(st: Lx, kind: int, line: int, trailing: int, start: int, end: int) -> None:
    st.trivia.append(kind)
    st.trivia.append(line)
    st.trivia.append(trailing)
    st.trivia.append(start)
    st.trivia.append(end)

# Yorum metninin sonundaki CRLF `\r`si yorumun parçası değildir (Zig `trimCr`).
def trim_cr_end(base: int, start: int, end: int) -> int:
    if end > start and at(base, end - 1) == 13:
        return end - 1
    return end

# Hata konumu (Zig `posSpan`): sütun = bayt - satır_başı + 1.
def fail(st: Lx, code: int, line: int, byte: int, line_start: int) -> int:
    st.err_line = line
    st.err_col = byte - line_start + 1
    st.err_byte = byte
    return code

# Sayı: `i0`dan başlar, bitiş indeksini döner; `st.kind` int_lit/float_lit (Zig sayı dalı).
def scan_number(st: Lx, i0: int) -> int:
    base: int = st.base
    n: int = st.n
    i: int = i0
    st.kind = {{K:int_lit}}
    if at(base, i) == 48 and i + 2 < n:
        c1: int = at(base, i + 1)
        if (c1 == 120 or c1 == 88 or c1 == 98 or c1 == 66 or c1 == 111 or c1 == 79) and is_hex(at(base, i + 2)):
            i = i + 2
            while i < n and (is_hex(at(base, i)) or at(base, i) == 95):
                i = i + 1
            return i
    while i < n and (is_digit(at(base, i)) or (at(base, i) == 95 and i + 1 < n and is_digit(at(base, i + 1)))):
        i = i + 1
    if i < n and at(base, i) == 46 and i + 1 < n and is_digit(at(base, i + 1)):
        st.kind = {{K:float_lit}}
        i = i + 1
        while i < n and (is_digit(at(base, i)) or (at(base, i) == 95 and i + 1 < n and is_digit(at(base, i + 1)))):
            i = i + 1
    if i < n and (at(base, i) == 101 or at(base, i) == 69):
        j: int = i + 1
        if j < n and (at(base, j) == 43 or at(base, j) == 45):
            j = j + 1
        if j < n and is_digit(at(base, j)):
            st.kind = {{K:float_lit}}
            while j < n and is_digit(at(base, j)):
                j = j + 1
            i = j
    return i

# f-string: `start` `f"`/`F'` önekinin konumu; kapanış tırnağından sonraki indeksi ya da -1 (`st.err_*` dolu, kod `st.kind`te) döner.
def scan_fstring(st: Lx, start: int, line: int, line_start: int) -> int:
    base: int = st.base
    n: int = st.n
    quote: int = at(base, start + 1)
    i: int = start + 2
    brace_depth: int = 0
    nested_quote: int = 0
    while i < n:
        ch: int = at(base, i)
        if nested_quote != 0:
            if ch == 92 and i + 1 < n:
                i = i + 2
                continue
            if ch == nested_quote:
                nested_quote = 0
            i = i + 1
            continue
        if brace_depth == 0:
            if ch == quote:
                break
            if ch == 92 and i + 1 < n:
                i = i + 2
                continue
            if ch == 123:
                if peek(base, n, i + 1) == 123:
                    i = i + 2
                    continue
                brace_depth = 1
                i = i + 1
                continue
            if ch == 125:
                if peek(base, n, i + 1) == 125:
                    i = i + 2
                    continue
                st.kind = fail(st, 1, line, i, line_start)
                return -1
            i = i + 1
            continue
        if ch == 39 or ch == 34:
            if ch == quote:
                st.kind = fail(st, 1, line, i, line_start)
                return -1
            nested_quote = ch
            i = i + 1
            continue
        if ch == 123:
            brace_depth = brace_depth + 1
            i = i + 1
            continue
        if ch == 125:
            brace_depth = brace_depth - 1
            i = i + 1
            continue
        i = i + 1
    if i >= n or brace_depth != 0 or nested_quote != 0:
        st.kind = fail(st, 2, line, start, line_start)
        return -1
    return i + 1

# Ana tarayıcı: 0 = tamam, aksi halde hata kodu (`st.err_line/err_col` dolu). Zig `tokenizeImpl` ile aynı durum makinesi.
def lex(st: Lx) -> int:
    base: int = st.base
    n: int = st.n
    indent_stack: list[int] = [0]
    i: int = 0
    line: int = 1
    line_start: int = 0
    paren: int = 0
    at_line_start: bool = True
    line_has_content: bool = False
    while i < n:
        if at_line_start and paren == 0:
            indent: int = 0
            while i < n and (at(base, i) == 32 or at(base, i) == 9):
                if at(base, i) == 9:
                    return fail(st, 4, line, i, line_start)
                indent = indent + 1
                i = i + 1
            if i >= n or at(base, i) == 10 or at(base, i) == 13 or at(base, i) == 35:
                if st.want_trivia:
                    if i < n and at(base, i) == 35:
                        comment_start: int = i
                        while i < n and at(base, i) != 10:
                            i = i + 1
                        emit_trivia(st, 0, line, 0, comment_start, trim_cr_end(base, comment_start, i))
                    else:
                        emit_trivia(st, 1, line, 0, 0, 0)
                        while i < n and at(base, i) != 10:
                            i = i + 1
                else:
                    while i < n and at(base, i) != 10:
                        i = i + 1
                if i < n:
                    i = i + 1
                    line = line + 1
                    line_start = i
                continue
            top: int = indent_stack[len(indent_stack) - 1]
            if indent > top:
                indent_stack.append(indent)
                emit(st, {{K:indent}}, line, 1, i, i)
            elif indent < top:
                while indent_stack[len(indent_stack) - 1] > indent:
                    indent_stack.pop()
                    emit(st, {{K:dedent}}, line, 1, i, i)
                if indent_stack[len(indent_stack) - 1] != indent:
                    return fail(st, 3, line, i, line_start)
            at_line_start = False

        c: int = at(base, i)
        col: int = i - line_start + 1

        if c == 32 or c == 9:
            i = i + 1
            continue
        if c == 13:
            i = i + 1
            continue
        if c == 35:
            tcs: int = i
            while i < n and at(base, i) != 10:
                i = i + 1
            if st.want_trivia:
                emit_trivia(st, 0, line, 1, tcs, trim_cr_end(base, tcs, i))
            continue
        if c == 10:
            i = i + 1
            if paren == 0:
                if line_has_content:
                    emit(st, {{K:newline}}, line, col, i - 1, i - 1)
                    line_has_content = False
                at_line_start = True
            line = line + 1
            line_start = i
            continue
        if c == 92 and i + 1 < n and at(base, i + 1) == 10:
            i = i + 2
            line = line + 1
            line_start = i
            continue
        if c == 92 and i + 2 < n and at(base, i + 1) == 13 and at(base, i + 2) == 10:
            i = i + 3
            line = line + 1
            line_start = i
            continue

        line_has_content = True

        if is_digit(c):
            start: int = i
            i = scan_number(st, i)
            emit(st, st.kind, line, col, start, i)
            continue

        if (c == 102 or c == 70) and i + 1 < n and (at(base, i + 1) == 39 or at(base, i + 1) == 34):
            fstart: int = i
            fend: int = scan_fstring(st, fstart, line, line_start)
            if fend < 0:
                return st.kind
            i = fend
            emit(st, {{K:fstring_lit}}, line, col, fstart, i)
            continue

        is_raw_prefix: bool = (c == 114 or c == 82) and i + 1 < n and (at(base, i + 1) == 39 or at(base, i + 1) == 34)
        if (not is_raw_prefix) and (is_istart(c) or (c >= 128 and uni_len(base, n, i, True) > 0)):
            wstart: int = i
            while i < n:
                d: int = at(base, i)
                if is_icont(d):
                    i = i + 1
                elif d >= 128:
                    m: int = uni_len(base, n, i, False)
                    if m == 0:
                        break
                    i = i + m
                else:
                    break
            kw: int = kw_lookup(base, wstart, i)
            if kw >= 0:
                emit(st, kw, line, col, wstart, i)
            else:
                emit(st, {{K:identifier}}, line, col, wstart, i)
            continue

        raw_off: int = 0
        if (c == 114 or c == 82) and i + 1 < n and (at(base, i + 1) == 39 or at(base, i + 1) == 34):
            raw_off = 1
        sc: int = at(base, i + raw_off)
        if (sc == 39 or sc == 34) and i + raw_off + 2 < n and at(base, i + raw_off + 1) == sc and at(base, i + raw_off + 2) == sc:
            sstart: int = i
            start_line: int = line
            start_line_start: int = line_start
            i = i + raw_off + 3
            closed: bool = False
            while i < n:
                if at(base, i) == 92 and i + 1 < n:
                    if at(base, i + 1) == 10:
                        line = line + 1
                        line_start = i + 2
                    i = i + 2
                    continue
                if at(base, i) == 10:
                    line = line + 1
                    line_start = i + 1
                    i = i + 1
                    continue
                if at(base, i) == sc and i + 2 < n and at(base, i + 1) == sc and at(base, i + 2) == sc:
                    i = i + 3
                    closed = True
                    break
                i = i + 1
            if not closed:
                return fail(st, 2, start_line, sstart, start_line_start)
            emit(st, {{K:string_lit}}, start_line, col, sstart, i)
            continue

        if sc == 39 or sc == 34:
            qstart: int = i
            i = i + raw_off + 1
            while i < n and at(base, i) != sc:
                if at(base, i) == 92 and i + 1 < n:
                    i = i + 2
                else:
                    i = i + 1
            if i >= n:
                return fail(st, 2, line, qstart, line_start)
            i = i + 1
            emit(st, {{K:string_lit}}, line, col, qstart, i)
            continue

        # İşleçler ve noktalama (sık görülenler önce; Zig `switch (c)` ile aynı dallar).
        if c == 40:
            paren = paren + 1
            emit(st, {{K:l_paren}}, line, col, i, i + 1)
            i = i + 1
        elif c == 41:
            paren = paren - 1
            emit(st, {{K:r_paren}}, line, col, i, i + 1)
            i = i + 1
        elif c == 44:
            emit(st, {{K:comma}}, line, col, i, i + 1)
            i = i + 1
        elif c == 58:
            if paren == 0 and i + 1 < n and at(base, i + 1) == 61 and not (i + 2 < n and at(base, i + 2) == 61):
                emit(st, {{K:colon_assign}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:colon}}, line, col, i, i + 1)
                i = i + 1
        elif c == 46:
            if i + 2 < n and at(base, i + 1) == 46 and at(base, i + 2) == 46:
                emit(st, {{K:ellipsis}}, line, col, i, i + 3)
                i = i + 3
            else:
                emit(st, {{K:dot}}, line, col, i, i + 1)
                i = i + 1
        elif c == 61:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:eq_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:assign}}, line, col, i, i + 1)
                i = i + 1
        elif c == 91:
            paren = paren + 1
            emit(st, {{K:l_bracket}}, line, col, i, i + 1)
            i = i + 1
        elif c == 93:
            paren = paren - 1
            emit(st, {{K:r_bracket}}, line, col, i, i + 1)
            i = i + 1
        elif c == 123:
            paren = paren + 1
            emit(st, {{K:l_brace}}, line, col, i, i + 1)
            i = i + 1
        elif c == 125:
            paren = paren - 1
            emit(st, {{K:r_brace}}, line, col, i, i + 1)
            i = i + 1
        elif c == 59:
            if paren != 0:
                st.err_line = 0
                st.err_col = 0
                st.err_byte = 0
                return 1
            emit(st, {{K:semicolon}}, line, col, i, i + 1)
            i = i + 1
        elif c == 43:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:plus_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:plus}}, line, col, i, i + 1)
                i = i + 1
        elif c == 45:
            if peek(base, n, i + 1) == 62:
                emit(st, {{K:arrow}}, line, col, i, i + 2)
                i = i + 2
            elif peek(base, n, i + 1) == 61:
                emit(st, {{K:minus_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:minus}}, line, col, i, i + 1)
                i = i + 1
        elif c == 42:
            if peek(base, n, i + 1) == 42:
                if peek(base, n, i + 2) == 61:
                    emit(st, {{K:star_star_eq}}, line, col, i, i + 3)
                    i = i + 3
                else:
                    emit(st, {{K:star_star}}, line, col, i, i + 2)
                    i = i + 2
            elif peek(base, n, i + 1) == 61:
                emit(st, {{K:star_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:star}}, line, col, i, i + 1)
                i = i + 1
        elif c == 47:
            if peek(base, n, i + 1) == 47:
                if peek(base, n, i + 2) == 61:
                    emit(st, {{K:slash_slash_eq}}, line, col, i, i + 3)
                    i = i + 3
                else:
                    emit(st, {{K:slash_slash}}, line, col, i, i + 2)
                    i = i + 2
            elif peek(base, n, i + 1) == 61:
                emit(st, {{K:slash_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:slash}}, line, col, i, i + 1)
                i = i + 1
        elif c == 37:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:percent_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:percent}}, line, col, i, i + 1)
                i = i + 1
        elif c == 124:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:pipe_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:pipe}}, line, col, i, i + 1)
                i = i + 1
        elif c == 38:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:amp_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:amp}}, line, col, i, i + 1)
                i = i + 1
        elif c == 94:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:caret_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:caret}}, line, col, i, i + 1)
                i = i + 1
        elif c == 126:
            emit(st, {{K:tilde}}, line, col, i, i + 1)
            i = i + 1
        elif c == 64:
            emit(st, {{K:at_sign}}, line, col, i, i + 1)
            i = i + 1
        elif c == 33:
            if peek(base, n, i + 1) == 61:
                emit(st, {{K:not_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                return fail(st, 1, line, i, line_start)
        elif c == 60:
            if peek(base, n, i + 1) == 60:
                if peek(base, n, i + 2) == 61:
                    emit(st, {{K:lt_lt_eq}}, line, col, i, i + 3)
                    i = i + 3
                else:
                    emit(st, {{K:lt_lt}}, line, col, i, i + 2)
                    i = i + 2
            elif peek(base, n, i + 1) == 61:
                emit(st, {{K:lt_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:lt}}, line, col, i, i + 1)
                i = i + 1
        elif c == 62:
            if peek(base, n, i + 1) == 62:
                if peek(base, n, i + 2) == 61:
                    emit(st, {{K:gt_gt_eq}}, line, col, i, i + 3)
                    i = i + 3
                else:
                    emit(st, {{K:gt_gt}}, line, col, i, i + 2)
                    i = i + 2
            elif peek(base, n, i + 1) == 61:
                emit(st, {{K:gt_eq}}, line, col, i, i + 2)
                i = i + 2
            else:
                emit(st, {{K:gt}}, line, col, i, i + 1)
                i = i + 1
        else:
            return fail(st, 1, line, i, line_start)

    if line_has_content:
        emit(st, {{K:newline}}, line, 1, i, i)
    while len(indent_stack) > 1:
        indent_stack.pop()
        emit(st, {{K:dedent}}, line, 1, i, i)
    emit(st, {{K:eof}}, line, 1, i, i)

    # `protocol` yalnızca bir satırın ilk belirteci ve ardından bir ad geldiğinde anahtar sözcüktür; başka yerde sıradan tanımlayıcı (Zig sonrası geçiş).
    count: int = len(st.out) // 5
    for ti in range(count):
        if st.out[ti * 5] != {{K:kw_protocol}}:
            continue
        at_start: bool = ti == 0
        if ti > 0:
            pk: int = st.out[(ti - 1) * 5]
            at_start = pk == {{K:newline}} or pk == {{K:indent}} or pk == {{K:dedent}}
        next_is_name: bool = ti + 1 < count and st.out[(ti + 1) * 5] == {{K:identifier}}
        if not (at_start and next_is_name):
            st.out[ti * 5] = {{K:identifier}}
    return 0

# --- Zig'e açılan C ABI (her `def` dış bağlantılı simgedir) ---

# `base` adresinde `n` baytlık kaynağı tarar. Token sayısı (≥ 1: en az `eof`) ya da `-hata_kodu` döner. Sonuç `nox_lex_buffer()`ta kalır.
def nox_lex_run(base: int, n: int, want_trivia: int) -> int:
    global G_OUT, G_TRIVIA, G_ERR_LINE, G_ERR_COL, G_ERR_BYTE
    st: Lx = Lx(base, n, want_trivia != 0)
    code: int = lex(st)
    G_OUT = st.out
    G_TRIVIA = st.trivia
    G_ERR_LINE = st.err_line
    G_ERR_COL = st.err_col
    G_ERR_BYTE = st.err_byte
    if code != 0:
        return 0 - code
    return len(st.out) // 5

# Son `nox_lex_run`ın token arabelleğinin adresi (token başına 5 `i64`: kind, line, col, start, end). Bir sonraki çağrıya kadar geçerlidir.
def nox_lex_buffer() -> int:
    xs: list[int] = G_OUT
    a: int = 0
    lowlevel:
        a = ptr_to_int(ptr_of(xs))
    return a

# Son çalıştırmanın trivia kaydı sayısı ve arabellek adresi (kayıt başına 5 `i64`; `want_trivia = 0` ise 0).
def nox_lex_trivia_count() -> int:
    return len(G_TRIVIA) // 5

def nox_lex_trivia_buffer() -> int:
    xs: list[int] = G_TRIVIA
    a: int = 0
    lowlevel:
        a = ptr_to_int(ptr_of(xs))
    return a

def nox_lex_err_line() -> int:
    return G_ERR_LINE

def nox_lex_err_col() -> int:
    return G_ERR_COL

# Hata konumunun bayt ofseti (Zig `posSpan`: start_byte = bayt, end_byte = bayt + 1).
def nox_lex_err_byte() -> int:
    return G_ERR_BYTE

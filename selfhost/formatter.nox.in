# noxc-nightly Aşama 2.13: Nox biçimlendirici (compiler/fmt/formatter.zig'in birebir portu; Nox lexer + Nox parser AST'si üzerinde). Bu dosya ŞABLONDUR:
# `scripts/gen_selfhost_parser.py` K/T/O/E/SZ yer tutucularını doldurup `selfhost/formatter.nox`u yazar (elle düzenlenen kaynak BU dosyadır).
{{FROM_AST}}
from lexer import Lx, lex
from parser import P, pk, pkx, pky, sref_len, sref_byte, sref_eq, sref_eq2, parse_module_body, ErrUnexpected, ErrNumber, ErrRecursion

class Pr:
    a: Ast
    # R2-E.5 (v2.2.59): çıktı tamponu bayt başına 1 B (`list[u8]`); önceden `list[int]` (8 B/bayt) idi — büyük çıktıda sayfa hatası/bant genişliği maliyeti.
    out: list[u8]
    tr: list[int]
    ti: int
    ntr: int
    last_blank: bool
    in_fstring: int

    def __init__(self, a: Ast, tr: list[int]) -> None:
        self.a = a
        self.out = []
        self.tr = tr
        self.ti = 0
        self.ntr = len(tr) // 5
        self.last_blank = True
        self.in_fstring = 0

# --- yazma yardımcıları ---
# R2-F (v2.2.55): dize tek toplu kopya (önceden karakter başına `append(ord(s[i]))`). Tüm `w(pr, ...)` argümanları ASCII'dir (literaller ve `str(float)`), bu yüzden bayt dizisi birebir aynıdır;
# ASCII dışı bir argüman artık kod noktası değil UTF-8 baytları yazar (doğru olan budur).
extern def nox_u8list_extend_from_str(out: list[u8], s: str) -> None from "zig-out/lib/noxrt.o" with_rt

def w(pr: Pr, s: str) -> None:
    nox_u8list_extend_from_str(pr.out, s)

def wb(pr: Pr, c: int) -> None:
    pr.out.append(u8(c))

# Paketli dize başvurusunu yazar.
# R2-F (v2.2.55): kaynak metin aralığı (yorumlar, tanımlayıcılar, sayılar) bayt başına `append` yerine tek toplu kopya (`nox_list_extend_from_bytes`; çalışma zamanı ilkeli).
extern def nox_u8list_extend_from_bytes(out: list[u8], base: int, n: int) -> None from "zig-out/lib/noxrt.o" with_rt

def ws(pr: Pr, v: int) -> None:
    a: Ast = pr.a
    n: int = sref_len(v)
    x: int = pkx(v)
    if x >= 0:
        nox_u8list_extend_from_bytes(pr.out, a.src + x, n)
        return
    for i in range(n):
        wb(pr, sref_byte(a, v, i))

def wint(pr: Pr, v: int) -> None:
    if v < 0:
        wb(pr, 45)
        if v == -9223372036854775807 - 1:
            w(pr, "9223372036854775808")
            return
        v = 0 - v
    if v == 0:
        wb(pr, 48)
        return
    digits: list[int] = []
    while v > 0:
        digits.append(48 + v % 10)
        v = v // 10
    k: int = len(digits) - 1
    while k >= 0:
        wb(pr, digits[k])
        k = k - 1

def indent_to(pr: Pr, depth: int) -> None:
    for i in range(depth):
        w(pr, "    ")

def hex2(pr: Pr, c: int) -> None:
    d1: int = c >> 4
    d2: int = c & 15
    if d1 < 10:
        wb(pr, 48 + d1)
    else:
        wb(pr, 87 + d1)
    if d2 < 10:
        wb(pr, 48 + d2)
    else:
        wb(pr, 87 + d2)

# Kontrol baytı kaçışı; yazdıysa True.
def write_control_escape(pr: Pr, c: int) -> bool:
    if c == 13:
        w(pr, "\\r")
        return True
    if c <= 8 or c == 11 or c == 12 or (c >= 14 and c <= 31) or c == 127:
        w(pr, "\\x")
        hex2(pr, c)
        return True
    return False

# --- düğüm erişimi ---
def sref_at(a: Ast, node: int, off: int) -> int:
    return pk(a.n[node + off], a.n[node + off + 1])

# `opt(str)` alanı: yoksa -1.
def opt_at(a: Ast, node: int, off: int) -> int:
    x: int = a.n[node + off]
    if x == {{NONE}}:
        return -1
    return pk(x, a.n[node + off + 1])

def sl_at(a: Ast, node: int, off: int) -> int:
    return pk(a.n[node + off], a.n[node + off + 1])

def sl_len(s: int) -> int:
    return pky(s)

def sl_get(a: Ast, s: int, i: int) -> int:
    return a.l[pkx(s) + i]

def sl_from(s: int, k: int) -> int:
    n: int = pky(s)
    if k > n:
        k = n
    return pk(pkx(s) + k, n - k)

def sl_head(s: int, k: int) -> int:
    return pk(pkx(s), k)

def s_kind(a: Ast, st: int) -> int:
    return a.n[st + {{O:Stmt.kind}}]

def s_tag(a: Ast, st: int) -> int:
    return a.n[a.n[st + {{O:Stmt.kind}}]]

def s_pay(a: Ast, st: int) -> int:
    return a.n[a.n[st + {{O:Stmt.kind}}] + 1]

def s_line(a: Ast, st: int) -> int:
    return a.n[st + {{O:Stmt.line}}]

def etag(a: Ast, e: int) -> int:
    return a.n[e]

def starts_with(a: Ast, v: int, pre: str) -> bool:
    n: int = len(pre)
    if sref_len(v) < n:
        return False
    for i in range(n):
        if sref_byte(a, v, i) != ord(pre[i]):
            return False
    return True

# Son `_`ten sonraki ondalık sayı; yoksa/geçersizse -1.
def last_us_int(a: Ast, v: int) -> int:
    n: int = sref_len(v)
    us: int = -1
    for i in range(n):
        if sref_byte(a, v, i) == 95:
            us = i
    if us < 0 or us + 1 >= n:
        return -1
    acc: int = 0
    for j in range(us + 1, n):
        c: int = sref_byte(a, v, j)
        if c < 48 or c > 57:
            return -1
        if acc > 922337203685477579:
            return -1
        acc = acc * 10 + (c - 48)
    return acc

# --- trivia ---
def emit_leading_trivia(pr: Pr, depth: int, upto_line: int) -> None:
    a: Ast = pr.a
    while pr.ti < pr.ntr and pr.tr[pr.ti * 5 + 1] < upto_line:
        b: int = pr.ti * 5
        if pr.tr[b] == 1:
            if not pr.last_blank:
                wb(pr, 10)
                pr.last_blank = True
        else:
            indent_to(pr, depth)
            nox_u8list_extend_from_bytes(pr.out, a.src + pr.tr[b + 3], pr.tr[b + 4] - pr.tr[b + 3])
            wb(pr, 10)
            pr.last_blank = False
        pr.ti = pr.ti + 1

def emit_remaining_trivia(pr: Pr) -> None:
    emit_leading_trivia(pr, 0, 4294967295)

def line(pr: Pr, source_line: int) -> None:
    a: Ast = pr.a
    if pr.ti < pr.ntr:
        b: int = pr.ti * 5
        if pr.tr[b] == 0 and pr.tr[b + 2] != 0 and pr.tr[b + 1] == source_line:
            w(pr, "  ")
            nox_u8list_extend_from_bytes(pr.out, a.src + pr.tr[b + 3], pr.tr[b + 4] - pr.tr[b + 3])
            pr.ti = pr.ti + 1
    wb(pr, 10)
    pr.last_blank = False

# Satır sonu + `last_was_blank = false` (Zig'de `writeAll("...\n")` + bayrak).
def nl(pr: Pr) -> None:
    wb(pr, 10)
    pr.last_blank = False

# --- öncelikler ---
def bin_prec(op: int) -> int:
    if op == {{E:BinaryOp.or_}}:
        return 1
    if op == {{E:BinaryOp.and_}}:
        return 2
    if op == {{E:BinaryOp.eq}} or op == {{E:BinaryOp.ne}} or op == {{E:BinaryOp.lt}} or op == {{E:BinaryOp.le}} or op == {{E:BinaryOp.gt}} or op == {{E:BinaryOp.ge}} or op == {{E:BinaryOp.in_}} or op == {{E:BinaryOp.not_in}}:
        return 4
    if op == {{E:BinaryOp.bit_or}}:
        return 5
    if op == {{E:BinaryOp.bit_xor}}:
        return 6
    if op == {{E:BinaryOp.bit_and}}:
        return 7
    if op == {{E:BinaryOp.shl}} or op == {{E:BinaryOp.shr}}:
        return 8
    if op == {{E:BinaryOp.add}} or op == {{E:BinaryOp.sub}}:
        return 9
    if op == {{E:BinaryOp.mul}} or op == {{E:BinaryOp.div}} or op == {{E:BinaryOp.floordiv}} or op == {{E:BinaryOp.mod}}:
        return 10
    return 12

def unary_prec(op: int) -> int:
    if op == {{E:UnaryOp.not_}}:
        return 3
    return 11

def bin_op_str(op: int) -> str:
    if op == {{E:BinaryOp.add}}:
        return "+"
    if op == {{E:BinaryOp.sub}}:
        return "-"
    if op == {{E:BinaryOp.mul}}:
        return "*"
    if op == {{E:BinaryOp.div}}:
        return "/"
    if op == {{E:BinaryOp.floordiv}}:
        return "//"
    if op == {{E:BinaryOp.mod}}:
        return "%"
    if op == {{E:BinaryOp.pow}}:
        return "**"
    if op == {{E:BinaryOp.eq}}:
        return "=="
    if op == {{E:BinaryOp.ne}}:
        return "!="
    if op == {{E:BinaryOp.lt}}:
        return "<"
    if op == {{E:BinaryOp.le}}:
        return "<="
    if op == {{E:BinaryOp.gt}}:
        return ">"
    if op == {{E:BinaryOp.ge}}:
        return ">="
    if op == {{E:BinaryOp.and_}}:
        return "and"
    if op == {{E:BinaryOp.or_}}:
        return "or"
    if op == {{E:BinaryOp.bit_and}}:
        return "&"
    if op == {{E:BinaryOp.bit_or}}:
        return "|"
    if op == {{E:BinaryOp.bit_xor}}:
        return "^"
    if op == {{E:BinaryOp.shl}}:
        return "<<"
    if op == {{E:BinaryOp.shr}}:
        return ">>"
    if op == {{E:BinaryOp.in_}}:
        return "in"
    return "not in"

def is_aug_op(op: int) -> bool:
    return op == {{E:BinaryOp.add}} or op == {{E:BinaryOp.sub}} or op == {{E:BinaryOp.mul}} or op == {{E:BinaryOp.div}} or op == {{E:BinaryOp.floordiv}} or op == {{E:BinaryOp.mod}} or op == {{E:BinaryOp.pow}} or op == {{E:BinaryOp.bit_and}} or op == {{E:BinaryOp.bit_or}} or op == {{E:BinaryOp.bit_xor}} or op == {{E:BinaryOp.shl}} or op == {{E:BinaryOp.shr}}

# --- tuple açma geri çevirme yardımcıları ---
# `__nox_tup_N_K: __infer = ...` ise K, değilse -1.
def tuple_temp_count(a: Ast, st: int) -> int:
    if s_tag(a, st) != {{T:StmtKind.var_decl}}:
        return -1
    v: int = s_pay(a, st)
    name: int = sref_at(a, v, {{O:VarDecl.name}})
    if not starts_with(a, name, "__nox_tup_"):
        return -1
    te: int = a.n[v + {{O:VarDecl.type_expr}}]
    if a.n[te] != {{T:TypeExpr.simple}} or not sref_eq(a, pk(a.n[te + 1], a.n[te + 2]), "__infer"):
        return -1
    return last_us_int(a, name)

def is_unpack_read(a: Ast, st: int, tmp: int) -> bool:
    tag: int = s_tag(a, st)
    val: int = -1
    if tag == {{T:StmtKind.var_decl}}:
        val = a.n[s_pay(a, st) + {{O:VarDecl.value}}]
    elif tag == {{T:StmtKind.assign}}:
        val = a.n[s_pay(a, st) + {{O:Assign.value}}]
    else:
        return False
    if a.n[val] != {{T:Expr.attribute}}:
        return False
    o: int = a.n[a.n[val + 1] + {{O:Attribute.obj}}]
    if a.n[o] != {{T:Expr.identifier}}:
        return False
    return sref_eq2(a, pk(a.n[o + 1], a.n[o + 2]), tmp)

def is_unpack_sequence(a: Ast, rest: int, tmp: int, k: int) -> bool:
    if sl_len(rest) < k:
        return False
    for i in range(k):
        if not is_unpack_read(a, sl_get(a, rest, i), tmp):
            return False
    return True

# `for` gövdesindeki gizli tuple değişkeni: K ya da -1 (gövde dilimi `body`).
def for_unpack_count(a: Ast, var_name: int, body: int) -> int:
    if not starts_with(a, var_name, "__nox_tup_"):
        return -1
    k: int = last_us_int(a, var_name)
    if k < 0:
        return -1
    if sl_len(body) < k or not is_unpack_sequence(a, body, var_name, k):
        return -1
    for i in range(k):
        if s_tag(a, sl_get(a, body, i)) != {{T:StmtKind.var_decl}}:
            return -1
    return k

# R2-F (v2.2.53): üretilmiş enum kurucusu adı `Sınıf__Varyant` biçimindedir; `__` içermeyen ad eşleşemez. Önceki deyimlerin tamamını tarayan `is_generic_enum_ctor`
# (her `def` için O(önceki deyim sayısı)) yalnızca bu ucuz ön denetimi geçen adlarda çağrılır — çıktı bayt-eşdeğer.
def name_has_dunder(a: Ast, name: int) -> bool:
    n: int = sref_len(name)
    for j in range(n - 1):
        if sref_byte(a, name, j) == 95 and sref_byte(a, name, j + 1) == 95:
            return True
    return False

def is_generic_enum_ctor(a: Ast, prev: int, name: int) -> bool:
    for i in range(sl_len(prev)):
        st: int = sl_get(a, prev, i)
        if s_tag(a, st) != {{T:StmtKind.class_def}}:
            continue
        c: int = s_pay(a, st)
        nvar: int = a.n[c + {{O:ClassDef.enum_variants}} + 1]
        ntp: int = a.n[c + {{O:ClassDef.type_params}} + 1]
        if nvar == 0 or ntp == 0:
            continue
        cname: int = sref_at(a, c, {{O:ClassDef.name}})
        cn: int = sref_len(cname)
        if sref_len(name) < cn:
            continue
        ok: bool = True
        for j in range(cn):
            if sref_byte(a, name, j) != sref_byte(a, cname, j):
                ok = False
                break
        if not ok:
            continue
        if sref_len(name) < cn + 2 or sref_byte(a, name, cn) != 95 or sref_byte(a, name, cn + 1) != 95:
            continue
        rest: int = pk(0, 0)
        rlen: int = sref_len(name) - cn - 2
        vs: int = a.n[c + {{O:ClassDef.enum_variants}}]
        for vi in range(nvar):
            vn: int = sref_at(a, a.l[vs + vi], {{O:EnumVariant.name}})
            if sref_len(vn) != rlen:
                continue
            same: bool = True
            for q in range(rlen):
                if sref_byte(a, vn, q) != sref_byte(a, name, cn + 2 + q):
                    same = False
                    break
            if same:
                return True
    return False

# --- deyimler ---
def print_stmts(pr: Pr, stmts: int, depth: int) -> None:
    a: Ast = pr.a
    n: int = sl_len(stmts)
    i: int = 0
    while i < n:
        st: int = sl_get(a, stmts, i)
        tag: int = s_tag(a, st)
        if tag == {{T:StmtKind.var_decl}}:
            v0: int = s_pay(a, st)
            if a.n[v0 + {{O:VarDecl.class_attr}}] >= 0 or a.n[v0 + {{O:VarDecl.is_match_temp}}] != 0:
                i = i + 1
                continue
        if tag == {{T:StmtKind.if_stmt}} and a.n[s_pay(a, st) + {{O:IfStmt.is_else_tail}}] != 0:
            i = i + 1
            continue
        if tag == {{T:StmtKind.func_def}} and name_has_dunder(a, sref_at(a, s_pay(a, st), {{O:FuncDef.name}})) and is_generic_enum_ctor(a, sl_head(stmts, i), sref_at(a, s_pay(a, st), {{O:FuncDef.name}})):
            i = i + 1
            continue
        emit_leading_trivia(pr, depth, s_line(a, st))
        if tag == {{T:StmtKind.var_decl}}:
            vd: int = s_pay(a, st)
            uo: int = a.n[vd + {{O:VarDecl.unpack_origin}}]
            if uo >= 0:
                indent_to(pr, depth)
                print_unpack_targets(pr, sl_at(a, uo, {{O:UnpackOrigin.targets}}))
                w(pr, " = ")
                print_rhs_list(pr, a.n[uo + {{O:UnpackOrigin.rhs}}])
                line(pr, s_line(a, st))
                i = i + 1 + a.n[uo + {{O:UnpackOrigin.skip}}]
                continue
        k: int = tuple_temp_count(a, st)
        if k >= 0:
            tname: int = sref_at(a, s_pay(a, st), {{O:VarDecl.name}})
            if i + k < n and is_unpack_sequence(a, sl_from(stmts, i + 1), tname, k):
                indent_to(pr, depth)
                for j in range(k):
                    if j > 0:
                        w(pr, ", ")
                    t: int = sl_get(a, stmts, i + 1 + j)
                    if s_tag(a, t) == {{T:StmtKind.var_decl}}:
                        ws(pr, sref_at(a, s_pay(a, t), {{O:VarDecl.name}}))
                    else:
                        print_expr(pr, a.n[s_pay(a, t) + {{O:Assign.target}}])
                w(pr, " = ")
                print_rhs_list(pr, a.n[s_pay(a, st) + {{O:VarDecl.value}}])
                line(pr, s_line(a, st))
                i = i + 1 + k
                continue
        print_stmt(pr, st, depth)
        i = i + 1

# `a, b = <değer>` sağ tarafı: çok öğeli tuple ise virgülle, değilse tek ifade.
def print_rhs_list(pr: Pr, rhs: int) -> None:
    a: Ast = pr.a
    if a.n[rhs] == {{T:Expr.tuple_lit}} and a.n[rhs + 2] > 1:
        for j in range(a.n[rhs + 2]):
            if j > 0:
                w(pr, ", ")
            print_expr(pr, a.l[a.n[rhs + 1] + j])
    else:
        print_expr(pr, rhs)

def print_match_pattern(pr: Pr, c: int) -> None:
    a: Ast = pr.a
    if a.n[c + {{O:MatchCase.wildcard}}] != 0:
        w(pr, "_")
        return
    cap: int = opt_at(a, c, {{O:MatchCase.capture}})
    if cap != -1:
        ws(pr, cap)
        return
    scs: int = sl_at(a, c, {{O:MatchCase.scalars}})
    if sl_len(scs) > 0:
        for i in range(sl_len(scs)):
            if i > 0:
                w(pr, " | ")
            print_expr(pr, sl_get(a, scs, i))
        return
    path: int = sl_at(a, c, {{O:MatchCase.path}})
    for pi in range(sl_len(path)):
        if pi > 0:
            w(pr, ".")
        ws(pr, pk(a.l[pkx(path) + pi * 2], a.l[pkx(path) + pi * 2 + 1]))
    if a.n[c + {{O:MatchCase.has_parens}}] == 0:
        return
    w(pr, "(")
    args: int = sl_at(a, c, {{O:MatchCase.args}})
    for ai in range(sl_len(args)):
        arg: int = sl_get(a, args, ai)
        if ai > 0:
            w(pr, ", ")
        kw: int = opt_at(a, arg, {{O:MatchPatternArg.keyword}})
        if kw != -1:
            ws(pr, kw)
            w(pr, "=")
        sub: int = a.n[arg + {{O:MatchPatternArg.sub}}]
        lit: int = a.n[arg + {{O:MatchPatternArg.literal}}]
        if sub >= 0:
            print_match_pattern(pr, sub)
        elif lit >= 0:
            print_expr(pr, lit)
        else:
            bd: int = opt_at(a, arg, {{O:MatchPatternArg.bind}})
            if bd == -1:
                w(pr, "_")
            else:
                ws(pr, bd)
    w(pr, ")")

def print_match(pr: Pr, f: int, mo: int, line_no: int, depth: int) -> None:
    a: Ast = pr.a
    indent_to(pr, depth)
    w(pr, "match ")
    print_expr(pr, a.n[mo + {{O:MatchOrigin.subject}}])
    w(pr, ":")
    line(pr, line_no)
    cases: int = sl_at(a, mo, {{O:MatchOrigin.cases}})
    for i in range(sl_len(cases)):
        c: int = sl_get(a, cases, i)
        body: int = pk(0, 0)
        if a.n[c + {{O:MatchCase.wildcard}}] != 0:
            eb: int = sl_at(a, f, {{O:IfStmt.else_body}})
            if a.n[f + {{O:IfStmt.else_body}}] == {{NONE}}:
                body = pk(0, 0)
            else:
                body = eb
        elif i == 0:
            body = sl_at(a, f, {{O:IfStmt.then_body}})
        else:
            ec: int = a.l[a.n[f + {{O:IfStmt.elif_clauses}}] + i - 1]
            body = sl_at(a, ec, {{O:ElifClause.body}})
        emit_leading_trivia(pr, depth + 1, a.n[c + {{O:MatchCase.line}}])
        indent_to(pr, depth + 1)
        w(pr, "case ")
        print_match_pattern(pr, c)
        g: int = a.n[c + {{O:MatchCase.guard}}]
        if g >= 0:
            w(pr, " if ")
            print_expr(pr, g)
        w(pr, ":")
        line(pr, a.n[c + {{O:MatchCase.line}}])
        pfx: int = a.n[c + {{O:MatchCase.prefix}}]
        print_stmts(pr, sl_from(body, pfx), depth + 2)

def print_enum(pr: Pr, c: int, line_no: int, depth: int) -> None:
    a: Ast = pr.a
    indent_to(pr, depth)
    w(pr, "enum ")
    ws(pr, sref_at(a, c, {{O:ClassDef.name}}))
    tps: int = sl_at(a, c, {{O:ClassDef.type_params}})
    if sl_len(tps) > 0:
        w(pr, "[")
        for i in range(sl_len(tps)):
            if i > 0:
                w(pr, ", ")
            ws(pr, pk(a.l[pkx(tps) + i * 2], a.l[pkx(tps) + i * 2 + 1]))
        w(pr, "]")
    w(pr, ":")
    line(pr, line_no)
    doc: int = opt_at(a, c, {{O:ClassDef.doc}})
    if doc != -1:
        indent_to(pr, depth + 1)
        w(pr, "\"\"\"")
        ws(pr, doc)
        w(pr, "\"\"\"\n")
        pr.last_blank = False
    vars_: int = sl_at(a, c, {{O:ClassDef.enum_variants}})
    for vi in range(sl_len(vars_)):
        v: int = sl_get(a, vars_, vi)
        emit_leading_trivia(pr, depth + 1, a.n[v + {{O:EnumVariant.line}}])
        indent_to(pr, depth + 1)
        ws(pr, sref_at(a, v, {{O:EnumVariant.name}}))
        if a.n[v + {{O:EnumVariant.has_parens}}] != 0:
            w(pr, "(")
            fs: int = sl_at(a, v, {{O:EnumVariant.fields}})
            for fi in range(sl_len(fs)):
                fd: int = sl_get(a, fs, fi)
                if fi > 0:
                    w(pr, ", ")
                ws(pr, sref_at(a, fd, {{O:FieldDecl.name}}))
                w(pr, ": ")
                print_type(pr, a.n[fd + {{O:FieldDecl.type_expr}}])
            w(pr, ")")
        line(pr, a.n[v + {{O:EnumVariant.line}}])
    methods: int = sl_at(a, c, {{O:ClassDef.methods}})
    for mi in range(sl_len(methods)):
        m: int = sl_get(a, methods, mi)
        mname: int = sref_at(a, m, {{O:FuncDef.name}})
        if sref_eq(a, mname, "__init__"):
            continue
        is_variant: bool = False
        for vj in range(sl_len(vars_)):
            if sref_eq2(a, sref_at(a, sl_get(a, vars_, vj), {{O:EnumVariant.name}}), mname):
                is_variant = True
        if is_variant:
            continue
        wb(pr, 10)
        pr.last_blank = True
        print_func_def_no_leading(pr, m, depth + 1)

def print_stmt(pr: Pr, st: int, depth: int) -> None:
    a: Ast = pr.a
    tag: int = s_tag(a, st)
    pay: int = s_pay(a, st)
    sline: int = s_line(a, st)
    if tag == {{T:StmtKind.expr_stmt}}:
        e: int = pay
        indent_to(pr, depth)
        et: int = a.n[e]
        done: bool = False
        if et == {{T:Expr.string_lit}}:
            sv: int = pk(a.n[e + 1], a.n[e + 2])
            has_tq: bool = False
            has_bs: bool = False
            sn: int = sref_len(sv)
            for q in range(sn):
                if sref_byte(a, sv, q) == 92:
                    has_bs = True
                if q + 2 < sn and sref_byte(a, sv, q) == 34 and sref_byte(a, sv, q + 1) == 34 and sref_byte(a, sv, q + 2) == 34:
                    has_tq = True
            if not has_tq and not has_bs:
                w(pr, "\"\"\"")
                ws(pr, sv)
                w(pr, "\"\"\"")
                done = True
        if not done and et == {{T:Expr.call}}:
            cp: int = a.n[e + 1]
            callee: int = a.n[cp + {{O:Call.callee}}]
            if a.n[callee] == {{T:Expr.identifier}} and a.n[cp + {{O:Call.args}} + 1] == 1:
                cn: int = pk(a.n[callee + 1], a.n[callee + 2])
                is_y: bool = sref_eq(a, cn, "__nox_yield")
                if is_y or sref_eq(a, cn, "__nox_yield_from"):
                    if is_y:
                        w(pr, "yield ")
                    else:
                        w(pr, "yield from ")
                    print_expr(pr, a.l[a.n[cp + {{O:Call.args}}]])
                    done = True
        if not done:
            print_expr(pr, e)
        line(pr, sline)
        return
    if tag == {{T:StmtKind.var_decl}}:
        indent_to(pr, depth)
        if a.n[pay + {{O:VarDecl.infer_assign}}] != 0:
            ws(pr, sref_at(a, pay, {{O:VarDecl.name}}))
            w(pr, " := ")
            print_expr(pr, a.n[pay + {{O:VarDecl.value}}])
            line(pr, sline)
            return
        ws(pr, sref_at(a, pay, {{O:VarDecl.name}}))
        w(pr, ": ")
        print_type(pr, a.n[pay + {{O:VarDecl.type_expr}}])
        w(pr, " = ")
        print_expr(pr, a.n[pay + {{O:VarDecl.value}}])
        line(pr, sline)
        return
    if tag == {{T:StmtKind.assign}}:
        indent_to(pr, depth)
        print_expr(pr, a.n[pay + {{O:Assign.target}}])
        ann: int = a.n[pay + {{O:Assign.ann}}]
        if ann >= 0:
            w(pr, ": ")
            print_type(pr, ann)
        val: int = a.n[pay + {{O:Assign.value}}]
        aug: bool = False
        if a.n[val] == {{T:Expr.binary}}:
            bp: int = a.n[val + 1]
            if a.n[bp + {{O:Binary.is_form}}] != 0 and is_aug_op(a.n[bp + {{O:Binary.op}}]):
                aug = True
                w(pr, " ")
                w(pr, bin_op_str(a.n[bp + {{O:Binary.op}}]))
                w(pr, "= ")
                print_expr(pr, a.n[bp + {{O:Binary.right}}])
        if not aug:
            w(pr, " = ")
            print_expr(pr, val)
        line(pr, sline)
        return
    if tag == {{T:StmtKind.if_stmt}}:
        mo: int = a.n[pay + {{O:IfStmt.match_origin}}]
        if mo >= 0:
            print_match(pr, pay, mo, sline, depth)
            return
        cond: int = a.n[pay + {{O:IfStmt.cond}}]
        then_b: int = sl_at(a, pay, {{O:IfStmt.then_body}})
        if a.n[pay + {{O:IfStmt.is_assert}}] != 0 and a.n[cond] == {{T:Expr.unary}} and sl_len(then_b) == 1:
            s0: int = sl_get(a, then_b, 0)
            if s_tag(a, s0) == {{T:StmtKind.raise_stmt}} and a.n[s_pay(a, s0)] == {{T:Expr.call}}:
                rc: int = a.n[s_pay(a, s0) + 1]
                indent_to(pr, depth)
                w(pr, "assert ")
                print_expr(pr, a.n[a.n[cond + 1] + {{O:Unary.operand}}])
                rargs: int = sl_at(a, rc, {{O:Call.args}})
                if sl_len(rargs) == 1:
                    r0: int = sl_get(a, rargs, 0)
                    if not (a.n[r0] == {{T:Expr.string_lit}} and sref_eq(a, pk(a.n[r0 + 1], a.n[r0 + 2]), "assertion failed")):
                        w(pr, ", ")
                        print_expr(pr, r0)
                line(pr, sline)
                return
        indent_to(pr, depth)
        w(pr, "if ")
        print_expr(pr, cond)
        w(pr, ":")
        line(pr, sline)
        print_stmts(pr, then_b, depth + 1)
        els: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        for ei in range(sl_len(els)):
            ec: int = sl_get(a, els, ei)
            indent_to(pr, depth)
            w(pr, "elif ")
            print_expr(pr, a.n[ec + {{O:ElifClause.cond}}])
            w(pr, ":\n")
            pr.last_blank = False
            print_stmts(pr, sl_at(a, ec, {{O:ElifClause.body}}), depth + 1)
        if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
            indent_to(pr, depth)
            w(pr, "else:\n")
            pr.last_blank = False
            print_stmts(pr, sl_at(a, pay, {{O:IfStmt.else_body}}), depth + 1)
        return
    if tag == {{T:StmtKind.while_stmt}}:
        indent_to(pr, depth)
        w(pr, "while ")
        print_expr(pr, a.n[pay + {{O:WhileStmt.cond}}])
        w(pr, ":")
        line(pr, sline)
        eo: int = a.n[pay + {{O:WhileStmt.else_origin}}]
        if eo >= 0:
            print_stmts(pr, sl_at(a, eo, {{O:LoopElseOrigin.body}}), depth + 1)
            print_loop_else(pr, sl_at(a, eo, {{O:LoopElseOrigin.else_body}}), depth)
        else:
            print_stmts(pr, sl_at(a, pay, {{O:WhileStmt.body}}), depth + 1)
        return
    if tag == {{T:StmtKind.for_stmt}}:
        fbody: int = sl_at(a, pay, {{O:ForStmt.body}})
        has_else: bool = False
        else_body: int = pk(0, 0)
        feo: int = a.n[pay + {{O:ForStmt.else_origin}}]
        if feo >= 0:
            fbody = sl_at(a, feo, {{O:LoopElseOrigin.body}})
            else_body = sl_at(a, feo, {{O:LoopElseOrigin.else_body}})
            has_else = True
        indent_to(pr, depth)
        vname: int = sref_at(a, pay, {{O:ForStmt.var_name}})
        fk: int = for_unpack_count(a, vname, fbody)
        is_async: bool = a.n[pay + {{O:ForStmt.is_async}}] != 0
        if fk >= 0:
            if is_async:
                w(pr, "async ")
            w(pr, "for ")
            for j in range(fk):
                if j > 0:
                    w(pr, ", ")
                ws(pr, sref_at(a, s_pay(a, sl_get(a, fbody, j)), {{O:VarDecl.name}}))
            w(pr, " in ")
            print_expr(pr, a.n[pay + {{O:ForStmt.iterable}}])
            w(pr, ":")
            line(pr, sline)
            print_stmts(pr, sl_from(fbody, fk), depth + 1)
            if has_else:
                print_loop_else(pr, else_body, depth)
            return
        if is_async:
            w(pr, "async ")
        w(pr, "for ")
        ws(pr, vname)
        w(pr, " in ")
        print_expr(pr, a.n[pay + {{O:ForStmt.iterable}}])
        w(pr, ":")
        line(pr, sline)
        print_stmts(pr, fbody, depth + 1)
        if has_else:
            print_loop_else(pr, else_body, depth)
        return
    if tag == {{T:StmtKind.func_def}}:
        print_func_def(pr, pay, depth, sline)
        return
    if tag == {{T:StmtKind.class_def}}:
        print_class(pr, pay, sline, depth)
        return
    if tag == {{T:StmtKind.protocol_def}}:
        indent_to(pr, depth)
        w(pr, "protocol ")
        ws(pr, sref_at(a, pay, {{O:ProtocolDef.name}}))
        w(pr, ":")
        line(pr, sline)
        pms: int = sl_at(a, pay, {{O:ProtocolDef.methods}})
        for mi in range(sl_len(pms)):
            if mi > 0:
                wb(pr, 10)
                pr.last_blank = True
            print_func_def_no_leading(pr, sl_get(a, pms, mi), depth + 1)
        return
    if tag == {{T:StmtKind.extern_def}}:
        print_decorators(pr, sl_at(a, pay, {{O:ExternDef.decorators}}), depth)
        indent_to(pr, depth)
        w(pr, "extern def ")
        ws(pr, sref_at(a, pay, {{O:ExternDef.name}}))
        w(pr, "(")
        print_params(pr, sl_at(a, pay, {{O:ExternDef.params}}))
        w(pr, ") -> ")
        print_type(pr, a.n[pay + {{O:ExternDef.return_type}}])
        w(pr, " from \"")
        ws(pr, sref_at(a, pay, {{O:ExternDef.from_lib}}))
        w(pr, "\"")
        if a.n[pay + {{O:ExternDef.needs_rt}}] != 0:
            w(pr, " with_rt")
        rts: int = sl_at(a, pay, {{O:ExternDef.retains}})
        if sl_len(rts) > 0:
            w(pr, " retains(")
            for ri in range(sl_len(rts)):
                if ri != 0:
                    w(pr, ", ")
                ws(pr, pk(a.l[pkx(rts) + ri * 2], a.l[pkx(rts) + ri * 2 + 1]))
            w(pr, ")")
        line(pr, sline)
        return
    if tag == {{T:StmtKind.return_stmt}}:
        indent_to(pr, depth)
        if pay >= 0:
            w(pr, "return ")
            print_expr(pr, pay)
        else:
            w(pr, "return")
        line(pr, sline)
        return
    if tag == {{T:StmtKind.raise_stmt}}:
        indent_to(pr, depth)
        e2: int = pay
        done2: bool = False
        if a.n[e2] == {{T:Expr.identifier}} and starts_with(a, pk(a.n[e2 + 1], a.n[e2 + 2]), "__nox_exc_"):
            w(pr, "raise")
            done2 = True
        elif a.n[e2] == {{T:Expr.call}}:
            cp2: int = a.n[e2 + 1]
            if a.n[cp2 + {{O:Call.raise_from}}] != 0 and a.n[cp2 + {{O:Call.args}} + 1] == 2:
                w(pr, "raise ")
                print_expr(pr, a.l[a.n[cp2 + {{O:Call.args}}]])
                w(pr, " from ")
                print_expr(pr, a.l[a.n[cp2 + {{O:Call.args}}] + 1])
                done2 = True
        if not done2:
            w(pr, "raise ")
            print_expr(pr, e2)
        line(pr, sline)
        return
    if tag == {{T:StmtKind.try_stmt}}:
        print_try(pr, pay, sline, depth)
        return
    if tag == {{T:StmtKind.lowlevel_stmt}}:
        indent_to(pr, depth)
        w(pr, "lowlevel:")
        line(pr, sline)
        print_stmts(pr, sl_at(a, pay, {{O:LowLevelStmt.body}}), depth + 1)
        return
    if tag == {{T:StmtKind.import_stmt}}:
        indent_to(pr, depth)
        w(pr, "import ")
        segs: int = sl_at(a, pay, {{O:ImportStmt.segments}})
        for si in range(sl_len(segs)):
            if si > 0:
                w(pr, ".")
            ws(pr, pk(a.l[pkx(segs) + si * 2], a.l[pkx(segs) + si * 2 + 1]))
        al: int = opt_at(a, pay, {{O:ImportStmt.alias}})
        if al != -1:
            w(pr, " as ")
            ws(pr, al)
        line(pr, sline)
        return
    if tag == {{T:StmtKind.from_import_stmt}}:
        indent_to(pr, depth)
        w(pr, "from ")
        segs2: int = sl_at(a, pay, {{O:FromImportStmt.segments}})
        for si2 in range(sl_len(segs2)):
            if si2 > 0:
                w(pr, ".")
            ws(pr, pk(a.l[pkx(segs2) + si2 * 2], a.l[pkx(segs2) + si2 * 2 + 1]))
        w(pr, " import ")
        names: int = sl_at(a, pay, {{O:FromImportStmt.names}})
        for ni in range(sl_len(names)):
            nm: int = sl_get(a, names, ni)
            if ni > 0:
                w(pr, ", ")
            ws(pr, sref_at(a, nm, {{O:FromImportName.name}}))
            al2: int = opt_at(a, nm, {{O:FromImportName.alias}})
            if al2 != -1:
                w(pr, " as ")
                ws(pr, al2)
        line(pr, sline)
        return
    if tag == {{T:StmtKind.type_alias}}:
        indent_to(pr, depth)
        w(pr, "type ")
        ws(pr, sref_at(a, pay, {{O:TypeAliasStmt.name}}))
        w(pr, " = ")
        print_type(pr, a.n[pay + {{O:TypeAliasStmt.target}}])
        line(pr, sline)
        return
    if tag == {{T:StmtKind.pass_stmt}}:
        indent_to(pr, depth)
        w(pr, "pass")
        line(pr, sline)
        return
    if tag == {{T:StmtKind.del_stmt}}:
        indent_to(pr, depth)
        w(pr, "del ")
        print_expr(pr, pay)
        line(pr, sline)
        return
    if tag == {{T:StmtKind.break_stmt}}:
        indent_to(pr, depth)
        w(pr, "break")
        line(pr, sline)
        return
    if tag == {{T:StmtKind.continue_stmt}}:
        indent_to(pr, depth)
        w(pr, "continue")
        line(pr, sline)
        return
    if tag == {{T:StmtKind.with_stmt}}:
        indent_to(pr, depth)
        if a.n[pay + {{O:WithStmt.is_async}}] != 0:
            w(pr, "async ")
        w(pr, "with ")
        print_expr(pr, a.n[pay + {{O:WithStmt.ctx_expr}}])
        bnd: int = opt_at(a, pay, {{O:WithStmt.binding}})
        if bnd != -1:
            w(pr, " as ")
            ws(pr, bnd)
        w(pr, ":")
        line(pr, sline)
        print_stmts(pr, sl_at(a, pay, {{O:WithStmt.body}}), depth + 1)
        return
    if tag == {{T:StmtKind.defer_stmt}}:
        indent_to(pr, depth)
        w(pr, "defer ")
        print_call_node(pr, a.n[pay + {{O:DeferStmt.call}}])
        line(pr, sline)
        return

def print_call_node(pr: Pr, call: int) -> None:
    print_expr(pr, mk_Expr_call(pr.a, call))

def print_try(pr: Pr, t0: int, sline: int, depth: int) -> None:
    a: Ast = pr.a
    try_body: int = sl_at(a, t0, {{O:TryStmt.try_body}})
    excepts: int = sl_at(a, t0, {{O:TryStmt.except_clauses}})
    fin_x: int = a.n[t0 + {{O:TryStmt.finally_body}}]
    fin: int = sl_at(a, t0, {{O:TryStmt.finally_body}})
    has_else: bool = False
    else_body: int = pk(0, 0)
    eo: int = a.n[t0 + {{O:TryStmt.else_origin}}]
    if eo >= 0:
        try_body = sl_at(a, eo, {{O:TryElseOrigin.try_body}})
        excepts = sl_at(a, eo, {{O:TryElseOrigin.except_clauses}})
        fin_x = a.n[eo + {{O:TryElseOrigin.finally_body}}]
        fin = sl_at(a, eo, {{O:TryElseOrigin.finally_body}})
        else_body = sl_at(a, eo, {{O:TryElseOrigin.else_body}})
        has_else = True
    indent_to(pr, depth)
    w(pr, "try:")
    line(pr, sline)
    print_stmts(pr, try_body, depth + 1)
    ci: int = 0
    n: int = sl_len(excepts)
    while ci < n:
        ec: int = sl_get(a, excepts, ci)
        indent_to(pr, depth)
        ec_body: int = sl_at(a, ec, {{O:ExceptClause.body}})
        ec_cn: int = opt_at(a, ec, {{O:ExceptClause.class_name}})
        group_end: int = ci + 1
        while group_end < n and ec_cn != -1:
            g: int = sl_get(a, excepts, group_end)
            if opt_at(a, g, {{O:ExceptClause.class_name}}) == -1:
                break
            if a.n[g + {{O:ExceptClause.body}}] != pkx(ec_body) or a.n[g + {{O:ExceptClause.body}} + 1] != pky(ec_body):
                break
            group_end = group_end + 1
        ec_bind: int = opt_at(a, ec, {{O:ExceptClause.bind_name}})
        synth_bind: bool = a.n[ec + {{O:ExceptClause.synth_bind}}] != 0
        if group_end > ci + 1:
            w(pr, "except (")
            gi: int = ci
            while gi < group_end:
                if gi > ci:
                    w(pr, ", ")
                ws(pr, opt_at(a, sl_get(a, excepts, gi), {{O:ExceptClause.class_name}}))
                gi = gi + 1
            w(pr, ")")
            if ec_bind != -1 and not synth_bind:
                w(pr, " as ")
                ws(pr, ec_bind)
            w(pr, ":\n")
            ci = group_end - 1
        elif ec_cn != -1 and a.n[ec + {{O:ExceptClause.synth_class}}] == 0:
            w(pr, "except ")
            ws(pr, ec_cn)
            if ec_bind != -1 and not synth_bind:
                w(pr, " as ")
                ws(pr, ec_bind)
            w(pr, ":\n")
        else:
            w(pr, "except:\n")
        pr.last_blank = False
        print_stmts(pr, ec_body, depth + 1)
        ci = ci + 1
    if has_else:
        print_loop_else(pr, else_body, depth)
    if fin_x != {{NONE}}:
        indent_to(pr, depth)
        w(pr, "finally:\n")
        pr.last_blank = False
        print_stmts(pr, fin, depth + 1)

def print_name_list(pr: Pr, lst: int) -> None:
    a: Ast = pr.a
    for i in range(sl_len(lst)):
        if i > 0:
            w(pr, ", ")
        ws(pr, pk(a.l[pkx(lst) + i * 2], a.l[pkx(lst) + i * 2 + 1]))

def print_class(pr: Pr, c: int, sline: int, depth: int) -> None:
    a: Ast = pr.a
    if a.n[c + {{O:ClassDef.enum_variants}} + 1] > 0:
        print_enum(pr, c, sline, depth)
        return
    print_decorators(pr, sl_at(a, c, {{O:ClassDef.decorators}}), depth)
    indent_to(pr, depth)
    w(pr, "class ")
    ws(pr, sref_at(a, c, {{O:ClassDef.name}}))
    tps: int = sl_at(a, c, {{O:ClassDef.type_params}})
    base: int = opt_at(a, c, {{O:ClassDef.base}})
    if base != -1:
        w(pr, "(")
        ws(pr, base)
        bas: int = sl_at(a, c, {{O:ClassDef.base_args}})
        if sl_len(bas) > 0:
            w(pr, "[")
            for i in range(sl_len(bas)):
                if i > 0:
                    w(pr, ", ")
                print_type(pr, sl_get(a, bas, i))
            w(pr, "]")
        ebs: int = sl_at(a, c, {{O:ClassDef.extra_bases}})
        for j in range(sl_len(ebs)):
            w(pr, ", ")
            ws(pr, pk(a.l[pkx(ebs) + j * 2], a.l[pkx(ebs) + j * 2 + 1]))
        w(pr, ")")
    # R1-P1.12 (v2.2.50): parser yalnızca `class Ad(Taban)[T]` sırasını kabul eder; tip parametreleri tabandan SONRA yazılır (önceden `class Ad[T](Taban)` → çıktı yeniden ayrışmıyordu).
    if sl_len(tps) > 0:
        w(pr, "[")
        print_name_list(pr, tps)
        w(pr, "]")
    w(pr, ":")
    line(pr, sline)
    doc: int = opt_at(a, c, {{O:ClassDef.doc}})
    if doc != -1:
        indent_to(pr, depth + 1)
        w(pr, "\"\"\"")
        ws(pr, doc)
        w(pr, "\"\"\"\n")
        pr.last_blank = False
    consts: int = sl_at(a, c, {{O:ClassDef.consts}})
    for ki in range(sl_len(consts)):
        kd: int = sl_get(a, consts, ki)
        emit_leading_trivia(pr, depth + 1, a.n[kd + {{O:ConstDecl.line}}])
        indent_to(pr, depth + 1)
        ws(pr, sref_at(a, kd, {{O:ConstDecl.name}}))
        w(pr, ": ")
        print_type(pr, a.n[kd + {{O:ConstDecl.type_expr}}])
        w(pr, " = ")
        print_expr(pr, a.n[kd + {{O:ConstDecl.value}}])
        line(pr, a.n[kd + {{O:ConstDecl.line}}])
    fields: int = sl_at(a, c, {{O:ClassDef.fields}})
    for fi in range(sl_len(fields)):
        fd: int = sl_get(a, fields, fi)
        emit_leading_trivia(pr, depth + 1, a.n[fd + {{O:FieldDecl.line}}])
        indent_to(pr, depth + 1)
        ws(pr, sref_at(a, fd, {{O:FieldDecl.name}}))
        w(pr, ": ")
        print_type(pr, a.n[fd + {{O:FieldDecl.type_expr}}])
        line(pr, a.n[fd + {{O:FieldDecl.line}}])
    methods: int = sl_at(a, c, {{O:ClassDef.methods}})
    nfc: int = sl_len(fields) + sl_len(consts)
    for mi in range(sl_len(methods)):
        if mi > 0 or nfc > 0:
            wb(pr, 10)
            pr.last_blank = True
        print_func_def_no_leading(pr, sl_get(a, methods, mi), depth + 1)
    if doc == -1 and sl_len(fields) == 0 and sl_len(consts) == 0 and sl_len(methods) == 0:
        indent_to(pr, depth + 1)
        w(pr, "pass")
        line(pr, sline)

def print_decorators(pr: Pr, decos: int, depth: int) -> None:
    a: Ast = pr.a
    for di in range(sl_len(decos)):
        dec: int = sl_get(a, decos, di)
        indent_to(pr, depth)
        w(pr, "@")
        ws(pr, sref_at(a, dec, {{O:Decorator.name}}))
        args: int = sl_at(a, dec, {{O:Decorator.args}})
        if sl_len(args) > 0:
            w(pr, "(")
            for i in range(sl_len(args)):
                if i > 0:
                    w(pr, ", ")
                print_expr(pr, sl_get(a, args, i))
            w(pr, ")")
        wb(pr, 10)
        pr.last_blank = False

def print_func_def(pr: Pr, fd: int, depth: int, source_line: int) -> None:
    a: Ast = pr.a
    print_decorators(pr, sl_at(a, fd, {{O:FuncDef.decorators}}), depth)
    indent_to(pr, depth)
    print_func_header(pr, fd)
    line(pr, source_line)
    print_decl_list(pr, "nonlocal ", sl_at(a, fd, {{O:FuncDef.nonlocals}}), depth + 1)
    print_decl_list(pr, "global ", sl_at(a, fd, {{O:FuncDef.globals}}), depth + 1)
    print_stmts(pr, sl_at(a, fd, {{O:FuncDef.body}}), depth + 1)

# R1-P1.12 (v2.2.50): metodun (varsa ilk dekoratörün) ÖNÜNDEKİ yorum/boş satır trivia'sı metodun önüne basılır (Zig `emitMethodLeadingTrivia` ile aynı).
def emit_method_leading_trivia(pr: Pr, fd: int, depth: int) -> None:
    a: Ast = pr.a
    start: int = a.n[fd + {{O:FuncDef.line}}]
    decos: int = sl_at(a, fd, {{O:FuncDef.decorators}})
    if sl_len(decos) > 0:
        dl: int = a.n[sl_get(a, decos, 0) + {{O:Decorator.line}}]
        if dl != 0 and (start == 0 or dl < start):
            start = dl
    if start == 0:
        return
    pr.last_blank = True
    emit_leading_trivia(pr, depth, start)

def print_func_def_no_leading(pr: Pr, fd: int, depth: int) -> None:
    a: Ast = pr.a
    emit_method_leading_trivia(pr, fd, depth)
    print_decorators(pr, sl_at(a, fd, {{O:FuncDef.decorators}}), depth)
    indent_to(pr, depth)
    print_func_header(pr, fd)
    wb(pr, 10)
    pr.last_blank = False
    print_decl_list(pr, "nonlocal ", sl_at(a, fd, {{O:FuncDef.nonlocals}}), depth + 1)
    print_decl_list(pr, "global ", sl_at(a, fd, {{O:FuncDef.globals}}), depth + 1)
    print_stmts(pr, sl_at(a, fd, {{O:FuncDef.body}}), depth + 1)

def print_decl_list(pr: Pr, kw: str, lst: int, depth: int) -> None:
    if sl_len(lst) == 0:
        return
    indent_to(pr, depth)
    w(pr, kw)
    print_name_list(pr, lst)
    wb(pr, 10)
    pr.last_blank = False

def print_unpack_targets(pr: Pr, targets: int) -> None:
    a: Ast = pr.a
    for j in range(sl_len(targets)):
        t: int = sl_get(a, targets, j)
        if j > 0:
            w(pr, ", ")
        if a.n[t + {{O:UnpackTarget.nested}}] != {{NONE}}:
            nested: int = sl_at(a, t, {{O:UnpackTarget.nested}})
            w(pr, "(")
            print_unpack_targets(pr, nested)
            if sl_len(nested) == 1:
                w(pr, ",")
            w(pr, ")")
        else:
            if a.n[t + {{O:UnpackTarget.star}}] != 0:
                w(pr, "*")
            print_expr(pr, a.n[t + {{O:UnpackTarget.expr}}])

def print_spread_items(pr: Pr, e: int, first: list[int]) -> None:
    a: Ast = pr.a
    t: int = a.n[e]
    if t == {{T:Expr.binary}} and a.n[a.n[e + 1] + {{O:Binary.spread}}] != 0:
        bp: int = a.n[e + 1]
        print_spread_items(pr, a.n[bp + {{O:Binary.left}}], first)
        print_spread_items(pr, a.n[bp + {{O:Binary.right}}], first)
    elif t == {{T:Expr.list_lit}}:
        for i in range(a.n[e + 2]):
            if first[0] == 0:
                w(pr, ", ")
            first[0] = 0
            print_expr(pr, a.l[a.n[e + 1] + i])
    else:
        if first[0] == 0:
            w(pr, ", ")
        first[0] = 0
        w(pr, "*")
        print_expr(pr, e)

def print_spread_list(pr: Pr, e: int) -> None:
    w(pr, "[")
    first: list[int] = [1]
    print_spread_items(pr, e, first)
    w(pr, "]")

def print_spread_dict(pr: Pr, args: int) -> None:
    a: Ast = pr.a
    w(pr, "{")
    first: bool = True
    for i in range(sl_len(args)):
        op: int = sl_get(a, args, i)
        if a.n[op] == {{T:Expr.dict_lit}}:
            for j in range(a.n[op + 2]):
                p: int = a.l[a.n[op + 1] + j]
                if not first:
                    w(pr, ", ")
                first = False
                print_expr(pr, a.n[p + {{O:DictPair.key}}])
                w(pr, ": ")
                print_expr(pr, a.n[p + {{O:DictPair.value}}])
        else:
            if not first:
                w(pr, ", ")
            first = False
            w(pr, "**")
            print_expr(pr, op)
    w(pr, "}")

def print_loop_else(pr: Pr, body: int, depth: int) -> None:
    indent_to(pr, depth)
    w(pr, "else:\n")
    pr.last_blank = False
    print_stmts(pr, body, depth + 1)

def print_func_header(pr: Pr, fd: int) -> None:
    a: Ast = pr.a
    if a.n[fd + {{O:FuncDef.is_async}}] != 0:
        w(pr, "async ")
    w(pr, "def ")
    ws(pr, sref_at(a, fd, {{O:FuncDef.name}}))
    tps: int = sl_at(a, fd, {{O:FuncDef.type_params}})
    if sl_len(tps) > 0:
        w(pr, "[")
        print_name_list(pr, tps)
        w(pr, "]")
    w(pr, "(")
    print_params(pr, sl_at(a, fd, {{O:FuncDef.params}}))
    if a.n[fd + {{O:FuncDef.ret_omitted}}] != 0:
        w(pr, "):")
    else:
        w(pr, ") -> ")
        print_type(pr, a.n[fd + {{O:FuncDef.return_type}}])
        w(pr, ":")

def print_params(pr: Pr, params: int) -> None:
    a: Ast = pr.a
    n: int = sl_len(params)
    star_printed: bool = False
    for qi in range(n):
        if a.n[sl_get(a, params, qi) + {{O:Param.variadic}}] != 0:
            star_printed = True
    for idx in range(n):
        p: int = sl_get(a, params, idx)
        if idx > 0:
            w(pr, ", ")
        if idx > 0 and a.n[sl_get(a, params, idx - 1) + {{O:Param.pos_only}}] != 0 and a.n[p + {{O:Param.pos_only}}] == 0:
            w(pr, "/, ")
        if a.n[p + {{O:Param.kw_only}}] != 0 and not star_printed:
            w(pr, "*, ")
            star_printed = True
        pname: int = sref_at(a, p, {{O:Param.name}})
        if a.n[p + {{O:Param.self_inferred}}] != 0:
            ws(pr, pname)
            continue
        te: int = a.n[p + {{O:Param.type_expr}}]
        if a.n[p + {{O:Param.var_kw}}] != 0 and a.n[te] == {{T:TypeExpr.generic}}:
            gp: int = a.n[te + 1]
            if a.n[gp + {{O:Generic.args}} + 1] == 2:
                w(pr, "**")
                ws(pr, pname)
                w(pr, ": ")
                print_type(pr, a.l[a.n[gp + {{O:Generic.args}}] + 1])
                continue
        if a.n[p + {{O:Param.variadic}}] != 0 and a.n[te] == {{T:TypeExpr.generic}}:
            gp2: int = a.n[te + 1]
            if a.n[gp2 + {{O:Generic.args}} + 1] == 1:
                w(pr, "*")
                ws(pr, pname)
                w(pr, ": ")
                print_type(pr, a.l[a.n[gp2 + {{O:Generic.args}}]])
                continue
        ws(pr, pname)
        w(pr, ": ")
        print_type(pr, te)
        dv: int = a.n[p + {{O:Param.default}}]
        if dv >= 0:
            w(pr, " = ")
            print_expr(pr, dv)
    if n > 0 and a.n[sl_get(a, params, n - 1) + {{O:Param.pos_only}}] != 0:
        w(pr, ", /")

def print_type(pr: Pr, t: int) -> None:
    a: Ast = pr.a
    tag: int = a.n[t]
    if tag == {{T:TypeExpr.simple}}:
        ws(pr, pk(a.n[t + 1], a.n[t + 2]))
        return
    if tag == {{T:TypeExpr.generic}}:
        g: int = a.n[t + 1]
        gn: int = sref_at(a, g, {{O:Generic.name}})
        if sref_eq(a, gn, "__nox_Set"):
            w(pr, "set")
        elif sref_eq(a, gn, "__nox_Gen"):
            w(pr, "Iterator")
        elif sref_eq(a, gn, "__nox_GenS"):
            w(pr, "Generator")
        else:
            ws(pr, gn)
        w(pr, "[")
        gargs: int = sl_at(a, g, {{O:Generic.args}})
        for i in range(sl_len(gargs)):
            if i > 0:
                w(pr, ", ")
            print_type(pr, sl_get(a, gargs, i))
        w(pr, "]")
        return
    if tag == {{T:TypeExpr.func_type}}:
        ft: int = a.n[t + 1]
        w(pr, "(")
        fps: int = sl_at(a, ft, {{O:FuncTypeExpr.params}})
        for j in range(sl_len(fps)):
            if j > 0:
                w(pr, ", ")
            print_type(pr, sl_get(a, fps, j))
        w(pr, ") -> ")
        print_type(pr, a.n[ft + {{O:FuncTypeExpr.return_type}}])
        return
    if tag == {{T:TypeExpr.optional}}:
        print_type(pr, a.n[t + 1])
        w(pr, " | None")
        return
    # qualified
    qs: int = a.n[t + 1]
    qn: int = a.n[t + 2]
    for k in range(qn):
        if k > 0:
            w(pr, ".")
        ws(pr, pk(a.l[qs + k * 2], a.l[qs + k * 2 + 1]))

# --- ifadeler ---
def print_expr(pr: Pr, e: int) -> None:
    print_expr_at(pr, e, 0, 0)

def print_fstring(pr: Pr, e: int) -> None:
    w(pr, "f\"")
    print_fpieces(pr, e)
    w(pr, "\"")

def print_fpieces(pr: Pr, e: int) -> None:
    a: Ast = pr.a
    if a.n[e] == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        if a.n[bp + {{O:Binary.fstring}}] != 0 and a.n[bp + {{O:Binary.op}}] == {{E:BinaryOp.add}}:
            print_fpieces(pr, a.n[bp + {{O:Binary.left}}])
            print_fpiece(pr, a.n[bp + {{O:Binary.right}}])
            return
    print_fpiece(pr, e)

def print_fpiece(pr: Pr, pc: int) -> None:
    a: Ast = pr.a
    t: int = a.n[pc]
    if t == {{T:Expr.string_lit}}:
        v: int = pk(a.n[pc + 1], a.n[pc + 2])
        for i in range(sref_len(v)):
            c: int = sref_byte(a, v, i)
            if c == 123:
                w(pr, "{{")
            elif c == 125:
                w(pr, "}}")
            elif c == 34:
                w(pr, "\\\"")
            elif c == 92:
                w(pr, "\\\\")
            elif c == 10:
                w(pr, "\\n")
            elif c == 9:
                w(pr, "\\t")
            elif not write_control_escape(pr, c):
                wb(pr, c)
        return
    if t == {{T:Expr.call}}:
        cl: int = a.n[pc + 1]
        w(pr, "{")
        pr.in_fstring = pr.in_fstring + 1
        nargs: int = a.n[cl + {{O:Call.args}} + 1]
        if nargs > 0:
            print_expr(pr, a.l[a.n[cl + {{O:Call.args}}]])
        pr.in_fstring = pr.in_fstring - 1
        if nargs == 2:
            a1: int = a.l[a.n[cl + {{O:Call.args}}] + 1]
            if a.n[a1] == {{T:Expr.string_lit}}:
                w(pr, ":")
                ws(pr, pk(a.n[a1 + 1], a.n[a1 + 2]))
        w(pr, "}")
        return
    w(pr, "{")
    pr.in_fstring = pr.in_fstring + 1
    print_expr(pr, pc)
    pr.in_fstring = pr.in_fstring - 1
    w(pr, "}")

def print_chain_left(pr: Pr, e: int) -> None:
    a: Ast = pr.a
    if a.n[e] == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        r: int = a.n[bp + {{O:Binary.right}}]
        if a.n[bp + {{O:Binary.is_form}}] != 0 and a.n[bp + {{O:Binary.op}}] == {{E:BinaryOp.and_}} and a.n[r] == {{T:Expr.binary}}:
            rp: int = a.n[r + 1]
            print_chain_left(pr, a.n[bp + {{O:Binary.left}}])
            w(pr, " ")
            w(pr, bin_op_str(a.n[rp + {{O:Binary.op}}]))
            w(pr, " ")
            print_expr_at(pr, a.n[rp + {{O:Binary.right}}], bin_prec(a.n[rp + {{O:Binary.op}}]), 1)
            return
    print_expr_at(pr, e, bin_prec({{E:BinaryOp.lt}}), 0)

# `side`: 0 = gevşek, 1 = sıkı.
def print_expr_at(pr: Pr, e: int, ctx_prec: int, side: int) -> None:
    a: Ast = pr.a
    t: int = a.n[e]
    if t == {{T:Expr.binary}}:
        b: int = a.n[e + 1]
        if a.n[b + {{O:Binary.spread}}] != 0:
            print_spread_list(pr, e)
            return
        if a.n[b + {{O:Binary.fstring}}] != 0:
            print_fstring(pr, e)
            return
        op: int = a.n[b + {{O:Binary.op}}]
        left: int = a.n[b + {{O:Binary.left}}]
        right: int = a.n[b + {{O:Binary.right}}]
        is_form: bool = a.n[b + {{O:Binary.is_form}}] != 0
        if is_form and op == {{E:BinaryOp.and_}} and a.n[right] == {{T:Expr.binary}}:
            rp: int = a.n[right + 1]
            lt_p: int = bin_prec({{E:BinaryOp.lt}})
            need_chain: bool = lt_p < ctx_prec or (lt_p == ctx_prec and side == 1)
            if need_chain:
                w(pr, "(")
            print_chain_left(pr, left)
            w(pr, " ")
            w(pr, bin_op_str(a.n[rp + {{O:Binary.op}}]))
            w(pr, " ")
            print_expr_at(pr, a.n[rp + {{O:Binary.right}}], bin_prec(a.n[rp + {{O:Binary.op}}]), 1)
            if need_chain:
                w(pr, ")")
            return
        my_prec: int = bin_prec(op)
        need_parens: bool = my_prec < ctx_prec or (my_prec == ctx_prec and side == 1)
        if need_parens:
            w(pr, "(")
        left_side: int = 0
        right_side: int = 1
        if op == {{E:BinaryOp.pow}}:
            left_side = 1
            right_side = 0
        elif my_prec == bin_prec({{E:BinaryOp.lt}}):
            left_side = 1
        print_expr_at(pr, left, my_prec, left_side)
        if is_form and a.n[right] == {{T:Expr.none_lit}} and (op == {{E:BinaryOp.eq}} or op == {{E:BinaryOp.ne}}):
            if op == {{E:BinaryOp.eq}}:
                w(pr, " is None")
            else:
                w(pr, " is not None")
            if need_parens:
                w(pr, ")")
            return
        w(pr, " ")
        w(pr, bin_op_str(op))
        w(pr, " ")
        print_expr_at(pr, right, my_prec, right_side)
        if need_parens:
            w(pr, ")")
        return
    if t == {{T:Expr.kwarg}}:
        k: int = a.n[e + 1]
        kn: int = sref_at(a, k, {{O:Kwarg.name}})
        if sref_eq(a, kn, "*") or sref_eq(a, kn, "**"):
            ws(pr, kn)
            print_expr(pr, a.n[k + {{O:Kwarg.value}}])
            return
        ws(pr, kn)
        w(pr, "=")
        print_expr(pr, a.n[k + {{O:Kwarg.value}}])
        return
    if t == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        need: bool = ctx_prec > 0
        if need:
            w(pr, "(")
        print_expr_at(pr, a.n[tp + {{O:Ternary.then_expr}}], 1, 0)
        w(pr, " if ")
        print_expr_at(pr, a.n[tp + {{O:Ternary.cond}}], 1, 0)
        w(pr, " else ")
        print_expr_at(pr, a.n[tp + {{O:Ternary.else_expr}}], 0, 0)
        if need:
            w(pr, ")")
        return
    if t == {{T:Expr.unary}}:
        u: int = a.n[e + 1]
        uop: int = a.n[u + {{O:Unary.op}}]
        up: int = unary_prec(uop)
        need_u: bool = up < ctx_prec or (up == ctx_prec and side == 1)
        if need_u:
            w(pr, "(")
        if uop == {{E:UnaryOp.neg}}:
            w(pr, "-")
        elif uop == {{E:UnaryOp.not_}}:
            w(pr, "not ")
        else:
            w(pr, "~")
        print_expr_at(pr, a.n[u + {{O:Unary.operand}}], up, 0)
        if need_u:
            w(pr, ")")
        return
    # R1-P1.12 (v2.2.50): son-ek bağlamında (ctx_prec >= 13) `(await t).x` / `(spawn f()).x`; lambda herhangi bir operatör bağlamında parantezlenir (Zig `printExprAt` ile aynı).
    if t == {{T:Expr.await_expr}} or t == {{T:Expr.spawn_expr}}:
        need_a: bool = ctx_prec >= 13
        if need_a:
            w(pr, "(")
        print_primary(pr, e)
        if need_a:
            w(pr, ")")
        return
    if t == {{T:Expr.lambda}}:
        need_l: bool = ctx_prec > 0
        if need_l:
            w(pr, "(")
        print_primary(pr, e)
        if need_l:
            w(pr, ")")
        return
    print_primary(pr, e)

def print_primary(pr: Pr, e: int) -> None:
    a: Ast = pr.a
    t: int = a.n[e]
    if t == {{T:Expr.int_lit}}:
        wint(pr, a.n[e + 1])
        return
    if t == {{T:Expr.float_lit}}:
        print_float(pr, a.n[e + 1])
        return
    if t == {{T:Expr.bool_lit}}:
        if a.n[e + 1] != 0:
            w(pr, "True")
        else:
            w(pr, "False")
        return
    if t == {{T:Expr.string_lit}}:
        print_string_lit(pr, pk(a.n[e + 1], a.n[e + 2]))
        return
    if t == {{T:Expr.bytes_lit}}:
        print_bytes_lit(pr, pk(a.n[e + 1], a.n[e + 2]))
        return
    if t == {{T:Expr.none_lit}}:
        w(pr, "None")
        return
    if t == {{T:Expr.identifier}}:
        ws(pr, pk(a.n[e + 1], a.n[e + 2]))
        return
    if t == {{T:Expr.call}}:
        print_call_expr(pr, e)
        return
    if t == {{T:Expr.attribute}}:
        ap: int = a.n[e + 1]
        print_expr_at(pr, a.n[ap + {{O:Attribute.obj}}], 13, 0)
        w(pr, ".")
        ws(pr, sref_at(a, ap, {{O:Attribute.attr}}))
        return
    if t == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        w(pr, "[")
        print_expr(pr, a.n[lc + {{O:ListComp.elem}}])
        print_comp_clauses(pr, sl_at(a, lc, {{O:ListComp.clauses}}))
        w(pr, "]")
        return
    if t == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        w(pr, "{")
        print_expr(pr, a.n[dc + {{O:DictComp.key}}])
        w(pr, ": ")
        print_expr(pr, a.n[dc + {{O:DictComp.value}}])
        print_comp_clauses(pr, sl_at(a, dc, {{O:DictComp.clauses}}))
        w(pr, "}")
        return
    if t == {{T:Expr.lambda}}:
        lm: int = a.n[e + 1]
        w(pr, "lambda")
        lps: int = sl_at(a, lm, {{O:Lambda.params}})
        for i in range(sl_len(lps)):
            if i == 0:
                w(pr, " ")
            else:
                w(pr, ", ")
            ws(pr, pk(a.l[pkx(lps) + i * 2], a.l[pkx(lps) + i * 2 + 1]))
        w(pr, ": ")
        print_expr(pr, a.n[lm + {{O:Lambda.body}}])
        return
    if t == {{T:Expr.slice}}:
        sp: int = a.n[e + 1]
        print_expr_at(pr, a.n[sp + {{O:Slice.obj}}], 13, 0)
        w(pr, "[")
        lo: int = a.n[sp + {{O:Slice.lo}}]
        hi: int = a.n[sp + {{O:Slice.hi}}]
        step: int = a.n[sp + {{O:Slice.step}}]
        if lo >= 0:
            print_expr(pr, lo)
        w(pr, ":")
        if hi >= 0:
            print_expr(pr, hi)
        if step >= 0:
            w(pr, ":")
            print_expr(pr, step)
        w(pr, "]")
        return
    if t == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        print_expr_at(pr, a.n[ip + {{O:Index.obj}}], 13, 0)
        w(pr, "[")
        print_expr(pr, a.n[ip + {{O:Index.index}}])
        w(pr, "]")
        return
    if t == {{T:Expr.list_lit}}:
        w(pr, "[")
        print_expr_list(pr, a.n[e + 1], a.n[e + 2])
        w(pr, "]")
        return
    if t == {{T:Expr.tuple_lit}}:
        w(pr, "(")
        print_expr_list(pr, a.n[e + 1], a.n[e + 2])
        if a.n[e + 2] == 1:
            w(pr, ",")
        w(pr, ")")
        return
    if t == {{T:Expr.dict_lit}}:
        w(pr, "{")
        for i in range(a.n[e + 2]):
            p: int = a.l[a.n[e + 1] + i]
            if i > 0:
                w(pr, ", ")
            print_expr(pr, a.n[p + {{O:DictPair.key}}])
            w(pr, ": ")
            print_expr(pr, a.n[p + {{O:DictPair.value}}])
        w(pr, "}")
        return
    if t == {{T:Expr.await_expr}}:
        w(pr, "await ")
        print_expr_at(pr, a.n[e + 1], unary_prec({{E:UnaryOp.neg}}), 0)
        return
    if t == {{T:Expr.spawn_expr}}:
        w(pr, "spawn ")
        print_expr_at(pr, a.n[e + 1], unary_prec({{E:UnaryOp.neg}}), 0)
        return
    # generic_construct
    g: int = a.n[e + 1]
    ws(pr, sref_at(a, g, {{O:GenericConstruct.name}}))
    w(pr, "[")
    tas: int = sl_at(a, g, {{O:GenericConstruct.type_args}})
    for i in range(sl_len(tas)):
        if i > 0:
            w(pr, ", ")
        print_type(pr, sl_get(a, tas, i))
    w(pr, "](")
    gas: int = sl_at(a, g, {{O:GenericConstruct.args}})
    print_expr_list(pr, pkx(gas), sl_len(gas))
    w(pr, ")")

def print_expr_list(pr: Pr, start: int, n: int) -> None:
    a: Ast = pr.a
    for i in range(n):
        if i > 0:
            w(pr, ", ")
        print_expr(pr, a.l[start + i])

def print_call_expr(pr: Pr, e: int) -> None:
    a: Ast = pr.a
    c: int = a.n[e + 1]
    if a.n[c + {{O:Call.fstring}}] != 0:
        print_fstring(pr, e)
        return
    callee: int = a.n[c + {{O:Call.callee}}]
    args: int = sl_at(a, c, {{O:Call.args}})
    nargs: int = sl_len(args)
    if a.n[callee] == {{T:Expr.identifier}} and nargs == 1 and sref_eq(a, pk(a.n[callee + 1], a.n[callee + 2]), "__nox_yield_expr"):
        w(pr, "yield")
        a0: int = sl_get(a, args, 0)
        if a.n[a0] != {{T:Expr.none_lit}}:
            w(pr, " ")
            print_expr(pr, a0)
        return
    if a.n[c + {{O:Call.spread_lit}}] != 0:
        if a.n[callee] == {{T:Expr.attribute}} and sref_eq(a, sref_at(a, a.n[callee + 1], {{O:Attribute.attr}}), "copy"):
            w(pr, "[*")
            print_expr(pr, a.n[a.n[callee + 1] + {{O:Attribute.obj}}])
            w(pr, "]")
            return
        if a.n[callee] == {{T:Expr.identifier}}:
            print_spread_dict(pr, args)
            return
    if a.n[c + {{O:Call.set_lit}}] != 0 and nargs == 1:
        w(pr, "{")
        a0b: int = sl_get(a, args, 0)
        if a.n[a0b] == {{T:Expr.list_lit}}:
            print_expr_list(pr, a.n[a0b + 1], a.n[a0b + 2])
        elif a.n[a0b] == {{T:Expr.list_comp}}:
            lc: int = a.n[a0b + 1]
            print_expr(pr, a.n[lc + {{O:ListComp.elem}}])
            print_comp_clauses(pr, sl_at(a, lc, {{O:ListComp.clauses}}))
        w(pr, "}")
        return
    print_expr_at(pr, callee, 13, 0)
    w(pr, "(")
    if nargs == 1:
        a1: int = sl_get(a, args, 0)
        if a.n[a1] == {{T:Expr.list_comp}} and a.n[a.n[a1 + 1] + {{O:ListComp.is_genexpr}}] != 0:
            lc2: int = a.n[a1 + 1]
            print_expr(pr, a.n[lc2 + {{O:ListComp.elem}}])
            print_comp_clauses(pr, sl_at(a, lc2, {{O:ListComp.clauses}}))
            w(pr, ")")
            return
    print_expr_list(pr, pkx(args), nargs)
    w(pr, ")")

def print_comp_clauses(pr: Pr, clauses: int) -> None:
    a: Ast = pr.a
    for i in range(sl_len(clauses)):
        cl: int = sl_get(a, clauses, i)
        if a.n[cl] == {{T:CompClause.for_clause}}:
            fc: int = a.n[cl + 1]
            w(pr, " for ")
            ws(pr, sref_at(a, fc, {{O:CompForClause.var_name}}))
            w(pr, " in ")
            print_expr_at(pr, a.n[fc + {{O:CompForClause.iterable}}], 1, 0)
        else:
            w(pr, " if ")
            print_expr_at(pr, a.n[cl + 1], 1, 0)

def float_from_bits(bits: int) -> float:
    tmp: list[int] = [bits]
    out: float = 0.0
    lowlevel:
        pp: ptr[float] = ptr[float](ptr_to_int(ptr_of(tmp)))
        out = ptr_read(pp)
    return out

# Zig `{d}`/`{e}` en kısa gidiş-dönüş basamakları: Nox `str(float)` aynı basamakları Python biçiminde verir; üssü Zig biçimine çevirir.
def print_float(pr: Pr, bits: int) -> None:
    v: float = float_from_bits(bits)
    s: str = str(v)
    mag: float = v
    if mag < 0.0:
        mag = 0.0 - mag
    sci: bool = mag != 0.0 and (mag >= 1.0e16 or mag < 1.0e-4)
    epos: int = -1
    for i in range(len(s)):
        if s[i] == "e":
            epos = i
    if not sci or epos < 0:
        w(pr, s)
        has_dot: bool = False
        for j in range(len(s)):
            if s[j] == ".":
                has_dot = True
        if not has_dot:
            w(pr, ".0")
        return
    mant_dot: bool = False
    for k in range(epos):
        wb(pr, ord(s[k]))
        if s[k] == ".":
            mant_dot = True
    if not mant_dot:
        w(pr, ".0")
    wb(pr, 101)
    k2: int = epos + 1
    if k2 < len(s) and s[k2] == "+":
        k2 = k2 + 1
    elif k2 < len(s) and s[k2] == "-":
        wb(pr, 45)
        k2 = k2 + 1
    while k2 + 1 < len(s) and s[k2] == "0":
        k2 = k2 + 1
    while k2 < len(s):
        wb(pr, ord(s[k2]))
        k2 = k2 + 1

def print_string_lit(pr: Pr, v: int) -> None:
    a: Ast = pr.a
    n: int = sref_len(v)
    if pr.in_fstring > 0:
        w(pr, "'")
        for i in range(n):
            c: int = sref_byte(a, v, i)
            if c == 39:
                w(pr, "\\'")
            elif c == 92:
                w(pr, "\\\\")
            elif c == 10:
                w(pr, "\\n")
            elif c == 9:
                w(pr, "\\t")
            elif not write_control_escape(pr, c):
                wb(pr, c)
        w(pr, "'")
        return
    w(pr, "\"")
    for j in range(n):
        c2: int = sref_byte(a, v, j)
        if c2 == 34:
            w(pr, "\\\"")
        elif c2 == 92:
            w(pr, "\\\\")
        elif c2 == 10:
            w(pr, "\\n")
        elif c2 == 9:
            w(pr, "\\t")
        elif not write_control_escape(pr, c2):
            wb(pr, c2)
    w(pr, "\"")

# v2.2.77: `b"..."` — yazdırılabilir ASCII olduğu gibi; `\\ \" \n \t \r` kaçışlı; diğer baytlar `\xHH` (Zig `printBytesLit`).
def print_bytes_lit(pr: Pr, v: int) -> None:
    a: Ast = pr.a
    n: int = sref_len(v)
    w(pr, "b\"")
    for i in range(n):
        c: int = sref_byte(a, v, i)
        if c == 34:
            w(pr, "\\\"")
        elif c == 92:
            w(pr, "\\\\")
        elif c == 10:
            w(pr, "\\n")
        elif c == 9:
            w(pr, "\\t")
        elif c == 13:
            w(pr, "\\r")
        elif (c >= 32 and c <= 33) or (c >= 35 and c <= 91) or (c >= 93 and c <= 126):
            wb(pr, c)
        else:
            w(pr, "\\x")
            wb(pr, hex_lower(c >> 4))
            wb(pr, hex_lower(c & 15))
    w(pr, "\"")

def hex_lower(d: int) -> int:
    if d < 10:
        return 48 + d
    return 87 + d

# --- giriş noktaları ---
G_OUT: list[u8] = []
G_MEM: int = 0

def print_module(pr: Pr, body: int) -> None:
    print_stmts(pr, body, 0)
    emit_remaining_trivia(pr)

# Dönüş: 0 tamam; 1..4 sözcük hatası; 10..12 ayrıştırma hatası. Çıktı `nox_fmt_out_buffer`/`nox_fmt_len`.
def nox_fmt_run(base: int, n: int) -> int:
    global G_OUT, G_MEM
    lx: Lx = Lx(base, n, True)
    code: int = lex(lx)
    if code != 0:
        return code
    a: Ast = Ast(base, n)
    tr: list[int] = lx.trivia
    p: P = P(a, lx.out)
    body: int = 0
    try:
        body = parse_module_body(p)
    except ErrUnexpected:
        return 10
    except ErrNumber:
        return 11
    except ErrRecursion:
        return 12
    pr: Pr = Pr(a, tr)
    print_module(pr, body)
    G_OUT = pr.out
    G_MEM = (len(a.n) + len(a.l) + len(a.sb) + len(a.sp_ids) + len(a.sp_vals) + len(lx.out) + len(tr)) * 8 + len(pr.out)
    return 0

def nox_fmt_len() -> int:
    return len(G_OUT)

def nox_fmt_out_buffer() -> int:
    xs: list[u8] = G_OUT
    q: int = 0
    lowlevel:
        q = ptr_to_int(ptr_of(xs))
    return q

# Son biçimlendirmenin canlı verisi (bayt): AST tabloları + token/trivia arabelleği + çıktı.
def nox_fmt_mem() -> int:
    return G_MEM

def d_Stmt(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "kind=")
    d_StmtKind(a, a.n[id + 0])
    put(a, " ")
    put(a, "line=")
    put_int(a, a.n[id + 1])
    put(a, " ")
    put(a, "span=")
    d_Span(a, a.n[id + 2])
    put(a, "}")

def mk_Stmt(a: Ast, kind: int, line: int, span: int) -> int:
    id: int = len(a.n)
    a.n.append(kind)
    a.n.append(line)
    a.n.append(span)
    return id

def d_ModuleExports(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "module=")
    put_str(a, a.n[id + 0], a.n[(id + 0) + 1])
    put(a, " ")
    put(a, "names=")
    s218: int = a.n[id + 2]
    n219: int = a.n[(id + 2) + 1]
    put(a, "[")
    for i220 in range(n219):
        if i220 > 0:
            put(a, " ")
        put_str(a, a.l[s218 + i220 * 2], a.l[(s218 + i220 * 2) + 1])
    put(a, "]")
    put(a, "}")

def mk_ModuleExports(a: Ast, module_0: int, module_1: int, names_0: int, names_1: int) -> int:
    id: int = len(a.n)
    a.n.append(module_0)
    a.n.append(module_1)
    a.n.append(names_0)
    a.n.append(names_1)
    return id

# Modül dökümü (Zig `dumpModuleFull`): `{body=[...] exports=[...]}` + satır sonu. Kökler: gövde (l içinde başlangıç, uzunluk) ve exports (başlangıç, uzunluk).
def dump_module(a: Ast, body_start: int, body_len: int, exp_start: int, exp_len: int) -> None:
    put(a, "{body=[")
    for i in range(body_len):
        put(a, "\n")
        d_Stmt(a, a.l[body_start + i])
    put(a, "] exports=[")
    for i in range(exp_len):
        if i > 0:
            put(a, " ")
        d_ModuleExports(a, a.l[exp_start + i])
    put(a, "]}\n")

G: Ast = Ast(0, 0)

# Yüklenen (Zig'den itilen) AST: tip denetleyicisi birleşik modül farksalında (`ck-diff checkm`) bunu okur.
def loaded_ast() -> Ast:
    return G

# --- Zig <-> Nox test köprüsü: Zig `ast.Module`ünü aynı kodlamayla düz dizilere çevirip bu işlevlerle yükler ---
def nox_ast_reset(src: int, src_len: int) -> int:
    global G
    G = Ast(src, src_len)
    return 0

def nox_ast_push_n(v: int) -> int:
    G.n.append(v)
    return 0

def nox_ast_push_l(v: int) -> int:
    G.l.append(v)
    return 0

def nox_ast_push_sb(v: int) -> int:
    G.sb.append(v)
    return 0

def nox_ast_push_sp(id: int, span: int) -> int:
    G.sp_ids.append(id)
    G.sp_vals.append(span)
    return 0

def nox_ast_dump(body_start: int, body_len: int, exp_start: int, exp_len: int) -> int:
    dump_module(G, body_start, body_len, exp_start, exp_len)
    return len(G.o)

def nox_ast_out_buffer() -> int:
    xs: list[int] = G.o
    p: int = 0
    lowlevel:
        p = ptr_to_int(ptr_of(xs))
    return p


# ÜRETİLMİŞ DOSYA: elle DÜZENLEMEYİN. Kaynak: `noxc ast --schema` (compiler/parser/ast.zig'nin yansıması) → scripts/gen_selfhost_ast.py.
# Yeniden üretmek için: scripts/gen_selfhost_ast.py   (güncel mi: --check)

# Düz-dizi AST (docs: project/selfhost-ast-tasarimi-2026-11.md): düğüm tablosu `n` (tamsayılar), liste tablosu `l`, sentezlenmiş dize baytları `sb`, ifade span'leri `sp` (düğüm kimliği -> Span düğümü),
# yazıcı çıktısı `o` (bayt). Dize alanı iki tamsayıdır (x, y): x >= 0 ise kaynak metin [x, y); x < 0 ise `sb[-x-1 : -x-1+y]`.
# `opt(str)`/`opt(slice)` yokluğu x == -4611686018427387904; düğüm başvurusunun yokluğu -1.

class Ast:
    src: int
    src_len: int
    n: list[int]
    l: list[int]
    sb: list[int]
    sp_ids: list[int]
    sp_vals: list[int]
    sp_idx: list[int]
    sp_idx_n: int
    o: list[int]

    def __init__(self, src: int, src_len: int) -> None:
        self.src = src
        self.src_len = src_len
        self.n = []
        self.l = []
        self.sb = []
        self.sp_ids = []
        self.sp_vals = []
        self.sp_idx = []
        self.sp_idx_n = -1
        self.o = []

# --- çıktı yardımcıları (Zig `ast_dump_full.zig` ile aynı kaçışlama) ---
def at(base: int, i: int) -> int:
    c: int = 0
    lowlevel:
        c = int(ptr_read(ptr_offset(ptr[u8](base), i)))
    return c

def put(a: Ast, s: str) -> None:
    for i in range(len(s)):
        a.o.append(ord(s[i]))

def put_int(a: Ast, v: int) -> None:
    if v < 0:
        a.o.append(45)
        # -9223372036854775808 için güvenli: işareti ayrı basıp mutlak değeri bölme/mod ile üretmeden önce iki parçaya böl
        if v == -9223372036854775807 - 1:
            put(a, "9223372036854775808")
            return
        v = 0 - v
    if v == 0:
        a.o.append(48)
        return
    digits: list[int] = []
    while v > 0:
        digits.append(48 + v % 10)
        v = v // 10
    k: int = len(digits) - 1
    while k >= 0:
        a.o.append(digits[k])
        k = k - 1

def put_bool(a: Ast, v: int) -> None:
    if v != 0:
        put(a, "true")
    else:
        put(a, "false")

def put_hex16(a: Ast, v: int) -> None:
    k: int = 15
    while k >= 0:
        d: int = (v >> (k * 4)) & 15
        if d < 10:
            a.o.append(48 + d)
        else:
            a.o.append(87 + d)
        k = k - 1

def put_f64(a: Ast, v: int) -> None:
    put(a, "f64:0x")
    put_hex16(a, v)

# Tek bayt (0..255) dize içinde: Zig `str` kaçışlaması.
def put_byte_escaped(a: Ast, c: int) -> None:
    if c == 34:
        put(a, "\\\"")
    elif c == 92:
        put(a, "\\\\")
    elif c == 10:
        put(a, "\\n")
    elif c == 13:
        put(a, "\\r")
    elif c == 9:
        put(a, "\\t")
    elif c < 32 or c == 127:
        put(a, "\\u00")
        d1: int = c >> 4
        d2: int = c & 15
        if d1 < 10:
            a.o.append(48 + d1)
        else:
            a.o.append(87 + d1)
        if d2 < 10:
            a.o.append(48 + d2)
        else:
            a.o.append(87 + d2)
    else:
        a.o.append(c)

def put_str(a: Ast, x: int, y: int) -> None:
    a.o.append(34)
    if x >= 0:
        for i in range(x, y):
            put_byte_escaped(a, at(a.src, i))
    else:
        base: int = 0 - x - 1
        for i in range(y):
            put_byte_escaped(a, a.sb[base + i])
    a.o.append(34)

# R1-P2.1 (v2.2.52): düğüm kimliği -> sp tablosu konumu yoğun dizini (ilk eşleşme kazanır); önceki doğrusal tarama dökümde O(düğüm x span) idi.
def build_sp_idx(a: Ast) -> None:
    a.sp_idx = []
    for k in range(len(a.n) + 1):
        a.sp_idx.append(-1)
    for i in range(len(a.sp_ids)):
        sid: int = a.sp_ids[i]
        if sid >= 0 and sid < len(a.sp_idx) and a.sp_idx[sid] == -1:
            a.sp_idx[sid] = i
    a.sp_idx_n = len(a.sp_ids)

def put_span_suffix(a: Ast, id: int) -> None:
    if a.sp_idx_n != len(a.sp_ids) or len(a.sp_idx) != len(a.n) + 1:
        build_sp_idx(a)
    if id >= 0 and id < len(a.sp_idx):
        i: int = a.sp_idx[id]
        if i >= 0:
            sp: int = a.sp_vals[i]
            put(a, "@")
            put_int(a, a.n[sp + 2])
            put(a, ":")
            put_int(a, a.n[sp + 3])
            put(a, "-")
            put_int(a, a.n[sp + 4])
            put(a, ":")
            put_int(a, a.n[sp + 5])
            put(a, "/")
            put_int(a, a.n[sp + 0])
            put(a, "-")
            put_int(a, a.n[sp + 1])
            return

def d_UnaryOp(a: Ast, v: int) -> None:
    if v == 0:
        put(a, ".neg")
        return
    if v == 1:
        put(a, ".not_")
        return
    if v == 2:
        put(a, ".invert")
        return
    put(a, ".?")

def d_BinaryOp(a: Ast, v: int) -> None:
    if v == 0:
        put(a, ".add")
        return
    if v == 1:
        put(a, ".sub")
        return
    if v == 2:
        put(a, ".mul")
        return
    if v == 3:
        put(a, ".div")
        return
    if v == 4:
        put(a, ".floordiv")
        return
    if v == 5:
        put(a, ".mod")
        return
    if v == 6:
        put(a, ".pow")
        return
    if v == 7:
        put(a, ".eq")
        return
    if v == 8:
        put(a, ".ne")
        return
    if v == 9:
        put(a, ".lt")
        return
    if v == 10:
        put(a, ".le")
        return
    if v == 11:
        put(a, ".gt")
        return
    if v == 12:
        put(a, ".ge")
        return
    if v == 13:
        put(a, ".and_")
        return
    if v == 14:
        put(a, ".or_")
        return
    if v == 15:
        put(a, ".bit_and")
        return
    if v == 16:
        put(a, ".bit_or")
        return
    if v == 17:
        put(a, ".bit_xor")
        return
    if v == 18:
        put(a, ".shl")
        return
    if v == 19:
        put(a, ".shr")
        return
    if v == 20:
        put(a, ".in_")
        return
    if v == 21:
        put(a, ".not_in")
        return
    put(a, ".?")

def d_Span(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "start_byte=")
    put_int(a, a.n[id + 0])
    put(a, " ")
    put(a, "end_byte=")
    put_int(a, a.n[id + 1])
    put(a, " ")
    put(a, "start_line=")
    put_int(a, a.n[id + 2])
    put(a, " ")
    put(a, "start_col=")
    put_int(a, a.n[id + 3])
    put(a, " ")
    put(a, "end_line=")
    put_int(a, a.n[id + 4])
    put(a, " ")
    put(a, "end_col=")
    put_int(a, a.n[id + 5])
    put(a, "}")

def mk_Span(a: Ast, start_byte: int, end_byte: int, start_line: int, start_col: int, end_line: int, end_col: int) -> int:
    id: int = len(a.n)
    a.n.append(start_byte)
    a.n.append(end_byte)
    a.n.append(start_line)
    a.n.append(start_col)
    a.n.append(end_line)
    a.n.append(end_col)
    return id

def d_TypeExpr(a: Ast, id: int) -> None:
    tag: int = a.n[id]
    if tag == 0:
        put(a, "(simple")
        put(a, " ")
        put_str(a, a.n[id + 1], a.n[(id + 1) + 1])
        put(a, ")")
        return
    if tag == 1:
        put(a, "(generic")
        put(a, " ")
        d_Generic(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 2:
        put(a, "(func_type")
        put(a, " ")
        d_FuncTypeExpr(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 3:
        put(a, "(optional")
        put(a, " ")
        d_TypeExpr(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 4:
        put(a, "(qualified")
        put(a, " ")
        s1: int = a.n[id + 1]
        n2: int = a.n[(id + 1) + 1]
        put(a, "[")
        for i3 in range(n2):
            if i3 > 0:
                put(a, " ")
            put_str(a, a.l[s1 + i3 * 2], a.l[(s1 + i3 * 2) + 1])
        put(a, "]")
        put(a, ")")
        return
    put(a, "(?)")

def mk_TypeExpr_simple(a: Ast, v0: int, v1: int) -> int:
    id: int = len(a.n)
    a.n.append(0)
    a.n.append(v0)
    a.n.append(v1)
    return id

def mk_TypeExpr_generic(a: Ast, v0: int) -> int:
    id: int = len(a.n)
    a.n.append(1)
    a.n.append(v0)
    return id

def mk_TypeExpr_func_type(a: Ast, v0: int) -> int:
    id: int = len(a.n)
    a.n.append(2)
    a.n.append(v0)
    return id

def mk_TypeExpr_optional(a: Ast, v0: int) -> int:
    id: int = len(a.n)
    a.n.append(3)
    a.n.append(v0)
    return id

def mk_TypeExpr_qualified(a: Ast, v0: int, v1: int) -> int:
    id: int = len(a.n)
    a.n.append(4)
    a.n.append(v0)
    a.n.append(v1)
    return id

def d_Generic(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "name=")
    put_str(a, a.n[id + 0], a.n[(id + 0) + 1])
    put(a, " ")
    put(a, "args=")
    s4: int = a.n[id + 2]
    n5: int = a.n[(id + 2) + 1]
    put(a, "[")
    for i6 in range(n5):
        if i6 > 0:
            put(a, " ")
        d_TypeExpr(a, a.l[s4 + i6 * 1])
    put(a, "]")
    put(a, "}")

def mk_Generic(a: Ast, name_0: int, name_1: int, args_0: int, args_1: int) -> int:
    id: int = len(a.n)
    a.n.append(name_0)
    a.n.append(name_1)
    a.n.append(args_0)
    a.n.append(args_1)
    return id

def d_FuncTypeExpr(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "params=")
    s7: int = a.n[id + 0]
    n8: int = a.n[(id + 0) + 1]
    put(a, "[")
    for i9 in range(n8):
        if i9 > 0:
            put(a, " ")
        d_TypeExpr(a, a.l[s7 + i9 * 1])
    put(a, "]")
    put(a, " ")
    put(a, "return_type=")
    d_TypeExpr(a, a.n[id + 2])
    put(a, "}")

def mk_FuncTypeExpr(a: Ast, params_0: int, params_1: int, return_type: int) -> int:
    id: int = len(a.n)
    a.n.append(params_0)
    a.n.append(params_1)
    a.n.append(return_type)
    return id

def d_Param(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "name=")
    put_str(a, a.n[id + 0], a.n[(id + 0) + 1])
    put(a, " ")
    put(a, "variadic=")
    put_bool(a, a.n[id + 2])
    put(a, " ")
    put(a, "var_kw=")
    put_bool(a, a.n[id + 3])
    put(a, " ")
    put(a, "kw_only=")
    put_bool(a, a.n[id + 4])
    put(a, " ")
    put(a, "pos_only=")
    put_bool(a, a.n[id + 5])
    put(a, " ")
    put(a, "type_expr=")
    d_TypeExpr(a, a.n[id + 6])
    put(a, " ")
    put(a, "self_inferred=")
    put_bool(a, a.n[id + 7])
    put(a, " ")
    put(a, "default=")
    v10: int = a.n[id + 8]
    if v10 < 0:
        put(a, "null")
    else:
        d_Expr(a, a.n[id + 8])
    put(a, "}")

def mk_Param(a: Ast, name_0: int, name_1: int, variadic: int, var_kw: int, kw_only: int, pos_only: int, type_expr: int, self_inferred: int, default: int) -> int:
    id: int = len(a.n)
    a.n.append(name_0)
    a.n.append(name_1)
    a.n.append(variadic)
    a.n.append(var_kw)
    a.n.append(kw_only)
    a.n.append(pos_only)
    a.n.append(type_expr)
    a.n.append(self_inferred)
    a.n.append(default)
    return id

def d_Kwarg(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "name=")
    put_str(a, a.n[id + 0], a.n[(id + 0) + 1])
    put(a, " ")
    put(a, "value=")
    d_Expr(a, a.n[id + 2])
    put_span_suffix(a, a.n[id + 2])
    put(a, "}")

def mk_Kwarg(a: Ast, name_0: int, name_1: int, value: int) -> int:
    id: int = len(a.n)
    a.n.append(name_0)
    a.n.append(name_1)
    a.n.append(value)
    return id

def d_Ternary(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "cond=")
    d_Expr(a, a.n[id + 0])
    put_span_suffix(a, a.n[id + 0])
    put(a, " ")
    put(a, "then_expr=")
    d_Expr(a, a.n[id + 1])
    put_span_suffix(a, a.n[id + 1])
    put(a, " ")
    put(a, "else_expr=")
    d_Expr(a, a.n[id + 2])
    put_span_suffix(a, a.n[id + 2])
    put(a, "}")

def mk_Ternary(a: Ast, cond: int, then_expr: int, else_expr: int) -> int:
    id: int = len(a.n)
    a.n.append(cond)
    a.n.append(then_expr)
    a.n.append(else_expr)
    return id

def d_Slice(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "obj=")
    d_Expr(a, a.n[id + 0])
    put_span_suffix(a, a.n[id + 0])
    put(a, " ")
    put(a, "lo=")
    v11: int = a.n[id + 1]
    if v11 < 0:
        put(a, "null")
    else:
        d_Expr(a, a.n[id + 1])
        put_span_suffix(a, a.n[id + 1])
    put(a, " ")
    put(a, "hi=")
    v12: int = a.n[id + 2]
    if v12 < 0:
        put(a, "null")
    else:
        d_Expr(a, a.n[id + 2])
        put_span_suffix(a, a.n[id + 2])
    put(a, " ")
    put(a, "step=")
    v13: int = a.n[id + 3]
    if v13 < 0:
        put(a, "null")
    else:
        d_Expr(a, a.n[id + 3])
        put_span_suffix(a, a.n[id + 3])
    put(a, "}")

def mk_Slice(a: Ast, obj: int, lo: int, hi: int, step: int) -> int:
    id: int = len(a.n)
    a.n.append(obj)
    a.n.append(lo)
    a.n.append(hi)
    a.n.append(step)
    return id

def d_CompForClause(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "var_name=")
    put_str(a, a.n[id + 0], a.n[(id + 0) + 1])
    put(a, " ")
    put(a, "iterable=")
    d_Expr(a, a.n[id + 2])
    put(a, "}")

def mk_CompForClause(a: Ast, var_name_0: int, var_name_1: int, iterable: int) -> int:
    id: int = len(a.n)
    a.n.append(var_name_0)
    a.n.append(var_name_1)
    a.n.append(iterable)
    return id

def d_CompClause(a: Ast, id: int) -> None:
    tag: int = a.n[id]
    if tag == 0:
        put(a, "(for_clause")
        put(a, " ")
        d_CompForClause(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 1:
        put(a, "(if_clause")
        put(a, " ")
        d_Expr(a, a.n[id + 1])
        put(a, ")")
        return
    put(a, "(?)")

def mk_CompClause_for_clause(a: Ast, v0: int) -> int:
    id: int = len(a.n)
    a.n.append(0)
    a.n.append(v0)
    return id

def mk_CompClause_if_clause(a: Ast, v0: int) -> int:
    id: int = len(a.n)
    a.n.append(1)
    a.n.append(v0)
    return id

def d_Lambda(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "params=")
    s14: int = a.n[id + 0]
    n15: int = a.n[(id + 0) + 1]
    put(a, "[")
    for i16 in range(n15):
        if i16 > 0:
            put(a, " ")
        put_str(a, a.l[s14 + i16 * 2], a.l[(s14 + i16 * 2) + 1])
    put(a, "]")
    put(a, " ")
    put(a, "body=")
    d_Expr(a, a.n[id + 2])
    put_span_suffix(a, a.n[id + 2])
    put(a, "}")

def mk_Lambda(a: Ast, params_0: int, params_1: int, body: int) -> int:
    id: int = len(a.n)
    a.n.append(params_0)
    a.n.append(params_1)
    a.n.append(body)
    return id

def d_ListComp(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "elem=")
    d_Expr(a, a.n[id + 0])
    put_span_suffix(a, a.n[id + 0])
    put(a, " ")
    put(a, "clauses=")
    s17: int = a.n[id + 1]
    n18: int = a.n[(id + 1) + 1]
    put(a, "[")
    for i19 in range(n18):
        if i19 > 0:
            put(a, " ")
        d_CompClause(a, a.l[s17 + i19 * 1])
    put(a, "]")
    put(a, " ")
    put(a, "result_type=")
    v20: int = a.n[id + 3]
    if v20 < 0:
        put(a, "null")
    else:
        d_TypeExpr(a, a.n[id + 3])
    put(a, " ")
    put(a, "is_genexpr=")
    put_bool(a, a.n[id + 4])
    put(a, "}")

def mk_ListComp(a: Ast, elem: int, clauses_0: int, clauses_1: int, result_type: int, is_genexpr: int) -> int:
    id: int = len(a.n)
    a.n.append(elem)
    a.n.append(clauses_0)
    a.n.append(clauses_1)
    a.n.append(result_type)
    a.n.append(is_genexpr)
    return id

def d_DictComp(a: Ast, id: int) -> None:
    put(a, "{")
    put(a, "key=")
    d_Expr(a, a.n[id + 0])
    put_span_suffix(a, a.n[id + 0])
    put(a, " ")
    put(a, "value=")
    d_Expr(a, a.n[id + 1])
    put_span_suffix(a, a.n[id + 1])
    put(a, " ")
    put(a, "clauses=")
    s21: int = a.n[id + 2]
    n22: int = a.n[(id + 2) + 1]
    put(a, "[")
    for i23 in range(n22):
        if i23 > 0:
            put(a, " ")
        d_CompClause(a, a.l[s21 + i23 * 1])
    put(a, "]")
    put(a, " ")
    put(a, "result_type=")
    v24: int = a.n[id + 4]
    if v24 < 0:
        put(a, "null")
    else:
        d_TypeExpr(a, a.n[id + 4])
    put(a, "}")

def mk_DictComp(a: Ast, key: int, value: int, clauses_0: int, clauses_1: int, result_type: int) -> int:
    id: int = len(a.n)
    a.n.append(key)
    a.n.append(value)
    a.n.append(clauses_0)
    a.n.append(clauses_1)
    a.n.append(result_type)
    return id

def d_Expr(a: Ast, id: int) -> None:
    tag: int = a.n[id]
    if tag == 0:
        put(a, "(int_lit")
        put(a, " ")
        put_int(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 1:
        put(a, "(float_lit")
        put(a, " ")
        put_f64(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 2:
        put(a, "(bool_lit")
        put(a, " ")
        put_bool(a, a.n[id + 1])
        put(a, ")")
        return
    if tag == 3:
        put(a, "(string_lit")
        put(a, " ")
        put_str(a, a.n[id + 1], a.n[(id + 1) + 1])
        put(a, ")")
        return
    if tag == 4:
        put(a, "(none_lit")
        put(a, ")")
        return
    if tag == 5:
        put(a, "(identifier")
        put(a, " ")
        put_str(a, a.n[id + 1], a.n[(id + 1) + 1])

from ast_schema import build_sp_idx, loaded_ast
from parser import pk, pkx, pky, syn, parse_ast, parse_body, sref_eq, sref_len, sref_byte, utf8_bytes
from types import TT, ty_global, tat, sym_hash_step, cls_set_nonarc, cls_set_base, cls_add_mixin, lcg, sym_intern, sym_intern_list, ty_format, ty_mangle, ty_func_begin, ty_func_param, ty_func_end, ty_assignable, fx_fits, fx_signed, ty_mk, ty_list, ty_dict, ty_optional, ty_class, cls_register, is_subclass

# ---- (k1, k2) -> değer tablosu: açık adresleme, ekleme sırası korunur, silme = ölü işareti (yeniden `put` canlandırır) ----
class Map2:
    slots: list[int]
    mask: int
    k1: list[int]
    k2: list[int]
    vv: list[int]
    dead: list[int]
    live: int

    def __init__(self) -> None:
        self.slots = []
        self.mask = 255
        for i in range(256):
            self.slots.append(0)
        self.k1 = []
        self.k2 = []
        self.vv = []
        self.dead = []
        self.live = 0

def m2_hash(k1: int, k2: int) -> int:
    return sym_hash_step(sym_hash_step(1469598103, k1), k2)

# Anahtarın giriş indeksi (ölü olsa da) ya da -1.
def m2_find(m: Map2, k1: int, k2: int) -> int:
    i: int = m2_hash(k1, k2) & m.mask
    while True:
        s: int = m.slots[i]
        if s == 0:
            return -1
        e: int = s - 1
        if m.k1[e] == k1 and m.k2[e] == k2:
            return e
        i = (i + 1) & m.mask
    return -1

# CANLI girişin indeksi ya da -1.
def m2_get(m: Map2, k1: int, k2: int) -> int:
    e: int = m2_find(m, k1, k2)
    if e >= 0 and m.dead[e] == 0:
        return e
    return -1

def m2_grow(m: Map2) -> None:
    cap: int = (m.mask + 1) * 2
    m.mask = cap - 1
    m.slots = []
    for i in range(cap):
        m.slots.append(0)
    for e in range(len(m.k1)):
        j: int = m2_hash(m.k1[e], m.k2[e]) & m.mask
        while m.slots[j] != 0:
            j = (j + 1) & m.mask
        m.slots[j] = e + 1

def m2_put(m: Map2, k1: int, k2: int, v: int) -> None:
    e: int = m2_find(m, k1, k2)
    if e >= 0:
        m.vv[e] = v
        if m.dead[e] != 0:
            m.dead[e] = 0
            m.live = m.live + 1
        return
    i: int = m2_hash(k1, k2) & m.mask
    while m.slots[i] != 0:
        i = (i + 1) & m.mask
    ne: int = len(m.k1)
    m.k1.append(k1)
    m.k2.append(k2)
    m.vv.append(v)
    m.dead.append(0)
    m.slots[i] = ne + 1
    m.live = m.live + 1
    if len(m.k1) * 2 > m.mask + 1:
        m2_grow(m)

def m2_remove(m: Map2, k1: int, k2: int) -> bool:
    e: int = m2_find(m, k1, k2)
    if e >= 0 and m.dead[e] == 0:
        m.dead[e] = 1
        m.live = m.live - 1
        return True
    return False


# ---- Scope (Zig `Scope`) ----
def sc_new(ck: Ck, parent: int, has_caps: bool) -> int:
    id: int = len(ck.sp)
    ck.sp.append(parent)
    if has_caps:
        ck.sc.append(ck.ncaps)
        ck.ncaps = ck.ncaps + 1
    else:
        ck.sc.append(-1)
    return id

def sc_declare(ck: Ck, scope: int, sym: int, ty: int) -> None:
    m2_put(ck.vars, scope, sym, ty)

# Yalnızca bu kapsam (üst zincire DÜŞMEZ): TypeId ya da -1.
def sc_lookup_local(ck: Ck, scope: int, sym: int) -> int:
    e: int = m2_get(ck.vars, scope, sym)
    if e < 0:
        return -1
    return ck.vars.vv[e]

# Üst zincire düşer; bulunursa ve kapsamın yakalama kümesi varsa adı (ilk karşılaşmada) yakalama olarak kaydeder (zincirdeki her ara kapsam da kendi kaydını yapar).
def sc_lookup(ck: Ck, scope: int, sym: int) -> int:
    e: int = m2_get(ck.vars, scope, sym)
    if e >= 0:
        return ck.vars.vv[e]
    p: int = ck.sp[scope]
    if p >= 0:
        t: int = sc_lookup(ck, p, sym)
        if t >= 0:
            cs: int = ck.sc[scope]
            if cs >= 0 and m2_get(ck.caps, cs, sym) < 0:
                m2_put(ck.caps, cs, sym, t)
            return t
    return -1

# `lookup` ile aynı zincir, yan etkisiz (yakalama kaydı yok).
def sc_exists(ck: Ck, scope: int, sym: int) -> bool:
    if m2_get(ck.vars, scope, sym) >= 0:
        return True
    p: int = ck.sp[scope]
    if p >= 0:
        return sc_exists(ck, p, sym)
    return False

# `Checker.declareVar` (v1.148.0): aynı kapsamda FARKLI tiple yeniden bildirimi reddeder. 0 = bildirildi, 1 = uyuşmazlık (`ck.e_prev` = önceki tip; ileti 3.13'te biçimlenir).
def declare_var(ck: Ck, scope: int, sym: int, ty: int) -> int:
    tt: TT = ck.tt
    ex: int = sc_lookup_local(ck, scope, sym)
    if ex >= 0:
        both_classes: bool = False
        if tt.tag[ex] == 6 and tt.tag[ty] == 6:
            if tt.xa[ex] == tt.xa[ty]:
                both_classes = True
            elif tt.cnonarc[tt.xa[ex]] == 0 and tt.cnonarc[tt.xa[ty]] == 0:
                both_classes = True
        if ex != ty and not both_classes:
            ck.e_prev = ex
            return 1
    sc_declare(ck, scope, sym, ty)
    return 0

# ---- AST erişimi (düz dizi; bkz. project/selfhost-ast-tasarimi-2026-11.md) ----
def sl_at(a: Ast, node: int, off: int) -> int:
    return pk(a.n[node + off], a.n[node + off + 1])

# Dize başvurusu `v` (paketli) ham bayt aralığı `base[off:off+n]` ile aynı mı.
def sref_is_bytes(a: Ast, v: int, base: int, off: int, n: int) -> bool:
    x: int = pkx(v)
    ln: int = pky(v)
    if x >= 0:
        ln = ln - x
    if ln != n:
        return False
    for i in range(n):
        c: int = 0
        if x >= 0:
            c = at(a.src, x + i)
        else:
            c = a.sb[0 - x - 1 + i]
        if c != tat(base, off + i):
            return False
    return True

# `Checker.stmtsAssignName`: `name`e modülün herhangi bir yerinde (iç içe bloklar, işlev/metot gövdeleri dahil) atama var mı (muhafazakâr: yerel gölgelemeler dahil).
def stmts_assign_name(a: Ast, s: int, base: int, off: int, n: int) -> bool:
    cnt: int = pky(s)
    for i in range(cnt):
        st: int = a.l[pkx(s) + i]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}}:
            tg: int = a.n[pay + {{O:Assign.target}}]
            if a.n[tg] == {{T:Expr.identifier}} and sref_is_bytes(a, pk(a.n[tg + 1], a.n[tg + 2]), base, off, n):
                return True
        elif tag == {{T:StmtKind.if_stmt}}:
            if stmts_assign_name(a, sl_at(a, pay, {{O:IfStmt.then_body}}), base, off, n):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                ec: int = a.l[pkx(ecs) + j]
                if stmts_assign_name(a, sl_at(a, ec, {{O:ElifClause.body}}), base, off, n):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                if stmts_assign_name(a, sl_at(a, pay, {{O:IfStmt.else_body}}), base, off, n):
                    return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if stmts_assign_name(a, sl_at(a, pay, {{O:WhileStmt.body}}), base, off, n):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if sref_is_bytes(a, pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1]), base, off, n):
                return True
            if stmts_assign_name(a, sl_at(a, pay, {{O:ForStmt.body}}), base, off, n):
                return True
        elif tag == {{T:StmtKind.try_stmt}}:
            if stmts_assign_name(a, sl_at(a, pay, {{O:TryStmt.try_body}}), base, off, n):
                return True
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                ex: int = a.l[pkx(exs) + k]
                if stmts_assign_name(a, sl_at(a, ex, {{O:ExceptClause.body}}), base, off, n):
                    return True
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                if stmts_assign_name(a, sl_at(a, pay, {{O:TryStmt.finally_body}}), base, off, n):
                    return True
        elif tag == {{T:StmtKind.with_stmt}}:
            if stmts_assign_name(a, sl_at(a, pay, {{O:WithStmt.body}}), base, off, n):
                return True
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if stmts_assign_name(a, sl_at(a, pay, {{O:LowLevelStmt.body}}), base, off, n):
                return True
        elif tag == {{T:StmtKind.func_def}}:
            if stmts_assign_name(a, sl_at(a, pay, {{O:FuncDef.body}}), base, off, n):
                return True
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for q in range(pky(ms)):
                m: int = a.l[pkx(ms) + q]
                if stmts_assign_name(a, sl_at(a, m, {{O:FuncDef.body}}), base, off, n):
                    return True
    return False

# =====================================================================================================================
# 3.3 dilim A: skaler tipli ifade/deyimler + kullanıcı işlevleri (Zig `checkStmt/checkExprInner/checkBinary/checkExprExpected/checkFunctionBody/registerFunc`)
# Kapsam dışı HER yapı `CkUnsupported` fırlatır (durum 2): sonuç Zig ile karşılaştırılmaz, farksal test yalnızca desteklenen programlarda tam eşitlik ister. Kapsam büyüdükçe atlanan sayısı 0'a iner.
# =====================================================================================================================
class CkErr(Exception):
    pass

class CkUnsupported(Exception):
    pass

# İşlev gövdesi bağlamı (Zig `FnCtx`in bu dilimde kullanılan alanları). `ret` = -1: modül düzeyi (`expected_return == null`).
class Fx:
    scope: int
    ret: int
    loop: int
    in_async: bool
    self_cls: int
    is_init: bool
    # `awaited_callee`: o an `await` operandı olan çağrının callee düğümü (-1 yok); `ch.send/recv` yalnız bu bağlamda geçerli
    awaited: int
    # `in_lowlevel_depth`: `lowlevel:` iç içe derinliği
    ll_depth: int
    infer_lines: Map2
    narrowed: Map2
    cls_alias: int
    fn_path: str
    async_locals: Map2
    async_cap_s: Map2
    async_cap_n: Map2
    async_cap_pool: list[int]

    def __init__(self, scope: int, ret: int, in_async: bool) -> None:
        self.awaited = -1
        self.ll_depth = 0
        self.scope = scope
        self.ret = ret
        self.loop = 0
        self.in_async = in_async
        self.self_cls = -1
        self.is_init = False
        self.infer_lines = Map2()
        self.narrowed = Map2()
        self.cls_alias = -1
        self.fn_path = ""
        self.async_locals = Map2()
        self.async_cap_s = Map2()
        self.async_cap_n = Map2()
        self.async_cap_pool = []

# `why`: kapsam dışı nedeninin kısa etiketi (işlev adı#sıra); `ck-diff check --why` histogram basar.
def unsup(ck: Ck, why: str) -> CkUnsupported:
    ck.why = why
    return CkUnsupported("")

# ---- ileti oluşturma (`Checker.fail`) ----
def mp(ck: Ck, s: str) -> None:
    bs: list[int] = utf8_bytes(s)
    for i in range(len(bs)):
        ck.mb.append(bs[i])

def mp_int(ck: Ck, v: int) -> None:
    mp(ck, str(v))

def mp_sym(ck: Ck, sym: int) -> None:
    tt: TT = ck.tt
    o: int = tt.so[sym]
    for i in range(tt.sl[sym]):
        ck.mb.append(tt.sb[o + i])

def mp_sref(ck: Ck, a: Ast, v: int) -> None:
    n: int = sref_len(v)
    for i in range(n):
        ck.mb.append(sref_byte(a, v, i))

def mp_type(ck: Ck, ty: int) -> None:
    tt: TT = ck.tt
    tt.out = []
    ty_format(tt, ty)
    for i in range(len(tt.out)):
        ck.mb.append(tt.out[i])

# `Checker.fail`: ileti "line N: ..." öneki (current_line > 0) ile saklanır; hata kodu adı (Zig `TypeError`) dize olarak taşınır.
def mk_fail(ck: Ck, code: str) -> CkErr:
    ck.err_code = code
    out: list[int] = []
    if ck.cur_line > 0:
        pre: str = "line " + str(ck.cur_line) + ": "
        for i in range(len(pre)):
            out.append(ord(pre[i]))
    for j in range(len(ck.mb)):
        out.append(ck.mb[j])
    ck.diag_msg = out
    ck.mb = []
    return CkErr("")

# `Checker.recordDiagnostic`: son `fail` iletisini + konumu tanılama listesine ekler.
def record_diag(ck: Ck, a: Ast) -> None:
    if ck.synth_follow:
        return
    ck.dcode.append(ck.err_code)
    ck.dline.append(ck.cur_line)
    ck.doff.append(len(ck.dbytes))
    ck.dlen.append(len(ck.diag_msg))
    for i in range(len(ck.diag_msg)):
        ck.dbytes.append(ck.diag_msg[i])
    sp: int = ck.cur_span
    for k in range(6):
        if sp >= 0:
            ck.dspan.append(a.n[sp + k])
        else:
            ck.dspan.append(0)

# ---- AST yardımcıları ----
def sym_of(ck: Ck, a: Ast, v: int) -> int:
    x: int = pkx(v)
    if x >= 0:
        return sym_intern(ck.tt, a.src, x, pky(v) - x)
    return sym_intern_list(ck.tt, a.sb, 0 - x - 1, pky(v))

def stmt_at(a: Ast, s: int, i: int) -> int:
    return a.l[pkx(s) + i]

def span_of(a: Ast, node: int) -> int:
    if a.sp_idx_n != len(a.sp_ids) or len(a.sp_idx) != len(a.n) + 1:
        build_sp_idx(a)
    if node >= 0 and node < len(a.sp_idx):
        i: int = a.sp_idx[node]
        if i >= 0:
            return a.sp_vals[i]
    return -1

# ---- tip ifadesi -> TypeId (Zig `typeExprToType`in skaler çekirdeği; kalan dallar 3.4/3.6/3.12'de) ----
def type_expr_to_type(ck: Ck, a: Ast, te: int) -> int:
    tag: int = a.n[te]
    tt: TT = ck.tt
    if tag == {{T:TypeExpr.generic}}:
        return type_expr_generic(ck, a, a.n[te + 1])
    if tag == {{T:TypeExpr.func_type}}:
        fp: int = a.n[te + 1]
        ps: int = sl_at(a, fp, {{O:FuncTypeExpr.params}})
        tys: list[int] = []
        for i in range(pky(ps)):
            tys.append(type_expr_to_type(ck, a, stmt_at(a, ps, i)))
        ret: int = type_expr_to_type(ck, a, a.n[fp + {{O:FuncTypeExpr.return_type}}])
        ty_func_begin(tt)
        for k in range(len(tys)):
            ty_func_param(tt, tys[k])
        return ty_func_end(tt, ret)
    if tag == {{T:TypeExpr.optional}}:
        inner: int = type_expr_to_type(ck, a, a.n[te + 1])
        if inner == 4 or tt.tag[inner] == 15:
            mp(ck, "'None | None' or a nested Optional is invalid")
            raise mk_fail(ck, "UnknownType")
        return ty_optional(tt, inner)
    if tag == {{T:TypeExpr.qualified}}:
        # `pkg.mod.Sınıf` tip konumunda: takma ad ikamesi + modülün içe aktarıldığı + mangled sınıfın varlığı
        qsegs: list[int] = subst_alias(ck, seg_syms(ck, a, te, 1))
        qn: int = len(qsegs)
        if qn < 2:
            mp(ck, "invalid qualified type name")
            raise mk_fail(ck, "UnknownType")
        qmod: int = join_syms(ck, qsegs, qn - 1, 46)
        if m2_get(ck.imod, 0, qmod) < 0:
            mp(ck, "unknown module: ")
            mp_sym(ck, qmod)
            raise mk_fail(ck, "UnknownType")
        qms: int = join_syms(ck, qsegs, qn, 95)
        if class_idx(ck, qms) >= 0:
            return ty_class(tt, qms)
        mp(ck, "module '")
        mp_sym(ck, qmod)
        mp(ck, "' has no class named '")
        mp_sym(ck, qsegs[qn - 1])
        mp(ck, "'")
        raise mk_fail(ck, "UnknownType")
    if tag != {{T:TypeExpr.simple}}:
        raise unsup(ck, "type_expr_to_type#" + str(tag))
    return simple_type(ck, a, pk(a.n[te + 1], a.n[te + 2]))

# `typeExprToType(.{ .simple = ad })`: skaler adlar, sabit-genişlikli türler, kullanıcı sınıfı (`sizeof/alignof/offsetof` de bunu kullanır).
def simple_type(ck: Ck, a: Ast, v: int) -> int:
    tt: TT = ck.tt
    if sref_eq(a, v, "int"):
        return 0
    if sref_eq(a, v, "float"):
        return 1
    if sref_eq(a, v, "bool"):
        return 2
    if sref_eq(a, v, "str"):
        return 3
    if sref_eq(a, v, "None"):
        return 4
    if sref_eq(a, v, "bytes"):
        return ty_mk(tt, 18, 0, 0)
    if sref_eq(a, v, "ptr"):
        return 5
    if sref_eq(a, v, "u8"):
        return 6
    if sref_eq(a, v, "u16"):
        return 7
    if sref_eq(a, v, "u32"):
        return 8
    if sref_eq(a, v, "u64"):
        return 9
    if sref_eq(a, v, "usize"):
        return 10
    if sref_eq(a, v, "i8"):
        return 11
    if sref_eq(a, v, "i16"):
        return 12
    if sref_eq(a, v, "i32"):
        return 13
    if sref_eq(a, v, "i64"):
        return 14
    if sref_eq(a, v, "isize"):
        return 15
    # kullanıcı sınıfı (`self.classes.contains`); from-import/protokol tabloları bu dilimde boştur
    if class_idx(ck, sym_of(ck, a, v)) >= 0:
        return ty_class(tt, sym_of(ck, a, v))
    # `from X import Widget`: çıplak ad, mangled sınıfa çözülür (yerel sınıf her zaman öncelikli)
    fie: int = m2_get(ck.fimp, 0, sym_of(ck, a, v))
    if fie >= 0 and class_idx(ck, ck.fimp.vv[fie]) >= 0:
        return ty_class(tt, ck.fimp.vv[fie])
    psym_t: int = sym_of(ck, a, v)
    if m2_get(ck.proto_defs, 0, psym_t) >= 0:
        return ensure_protocol_base(ck, a, psym_t)
    if sref_eq(a, v, "__infer"):
        raise unsup(ck, "type_expr_to_type#infer")
    mp(ck, "unknown type: ")
    mp_sref(ck, a, v)
    raise mk_fail(ck, "UnknownType")

# `.generic` tip ifadesi: tuple (sınıf sentezi: kapsam dışı), ptr[T], list/Task/Channel/ThreadHandle/ThreadChannel/TaskLocal, dict[K, V].
def type_expr_generic(ck: Ck, a: Ast, g: int) -> int:
    tt: TT = ck.tt
    gn: int = pk(a.n[g + {{O:Generic.name}}], a.n[g + {{O:Generic.name}} + 1])
    gargs: int = sl_at(a, g, {{O:Generic.args}})
    n: int = pky(gargs)
    if sref_eq(a, gn, "tuple"):
        if n == 0:
            fail2(ck, "UnknownType", "'tuple' takes at least one type argument")
        ts: list[int] = []
        for ti in range(n):
            ts.append(type_expr_to_type(ck, a, stmt_at(a, gargs, ti)))
        return instantiate_tuple_class(ck, ts)
    if sref_eq(a, gn, "ptr"):
        if n != 1:
            mp(ck, "'ptr' takes exactly one type argument")
            raise mk_fail(ck, "UnknownType")
        pe: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 0))
        return ty_mk(tt, 17, pe, 0)
    tagk: int = -1
    if sref_eq(a, gn, "list"):
        tagk = 5
    elif sref_eq(a, gn, "Task"):
        tagk = 7
    elif sref_eq(a, gn, "Channel"):
        tagk = 8
    elif sref_eq(a, gn, "ThreadHandle"):
        tagk = 9
    elif sref_eq(a, gn, "ThreadChannel"):
        tagk = 10
    elif sref_eq(a, gn, "TaskLocal"):
        tagk = 11
    if tagk >= 0:
        if n != 1:
            mp(ck, "'")
            mp_sref(ck, a, gn)
            mp(ck, "' takes exactly one type argument")
            raise mk_fail(ck, "UnknownType")
        elem: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 0))
        et: int = tt.tag[elem]
        if tagk == 5 and (et == 7 or et == 8 or et == 9 or et == 10 or et == 11):
            mp(ck, "'list[")
            if et == 7:
                mp(ck, "Task")
            elif et == 8:
                mp(ck, "Channel")
            elif et == 9:
                mp(ck, "ThreadHandle")
            elif et == 10:
                mp(ck, "ThreadChannel")
            else:
                mp(ck, "TaskLocal")
            mp(ck, "[...]]' is not supported: tasks and channels cannot be stored in a list. For tasks use nox.tasks.TaskGroup[T] (it keeps each task in a TaskHandle[T] class), or hold the value in a class field; to gather results use a Channel")
            raise mk_fail(ck, "UnknownType")
        if tagk == 11 and (elem == 0 or elem == 1 or elem == 2):
            mp(ck, "the T of 'TaskLocal[T]' must be a class/str/list/dict (a bare int/float/bool is outside the v1 scope)")
            raise mk_fail(ck, "TypeMismatch")
        return ty_mk(tt, tagk, elem, 0)
    if sref_eq(a, gn, "dict"):
        if n != 2:
            mp(ck, "'dict' takes exactly two type arguments (K, V)")
            raise mk_fail(ck, "UnknownType")
        kt: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 0))
        vt: int = type_expr_to_type(ck, a, stmt_at(a, gargs, 1))
        if not dict_key_ok(ck, kt):
            mp(ck, "the 'dict' key type can only be int/float/bool/str/bytes")
            raise mk_fail(ck, "UnknownType")
        if not dict_value_ok(ck, vt):
            mp(ck, "the 'dict' value type can only be int/float/bool/str/bytes/class/list/dict")
            raise mk_fail(ck, "UnknownType")
        return ty_dict(tt, kt, vt)
    gcd: int = lookup_generic_class(ck, a, gn)
    if gcd >= 0:
        bound: list[int] = []
        for gi in range(n):
            bound.append(type_expr_to_type(ck, a, stmt_at(a, gargs, gi)))
        return instantiate_generic_class(ck, a, gcd, bound)
    mp(ck, "unknown generic type: ")
    mp_sref(ck, a, gn)
    raise mk_fail(ck, "UnknownType")

# ---- sayısal yardımcılar ----
# `requireSameFixedIntOrNone`: -1 = ikisi de fixed_int değil; aksi halde ortak tür; karışımda hata.
def require_same_fixed(ck: Ck, l: int, r: int) -> int:
    tt: TT = ck.tt
    lk: int = -1
    rk: int = -1
    if tt.tag[l] == 16:
        lk = tt.xa[l]
    if tt.tag[r] == 16:
        rk = tt.xa[r]
    if lk < 0 and rk < 0:
        return -1
    if lk >= 0 and rk >= 0 and lk == rk:
        return lk
    mp(ck, "fixed-width integers do not implicitly mix with other kinds or with int/float — use an explicit conversion")
    raise mk_fail(ck, "TypeMismatch")

def is_numeric_t(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return g == 0 or g == 1 or g == 16

def is_bitwise_t(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return g == 0 or g == 16

def numeric_promote(ck: Ck, l: int, r: int) -> int:
    if not is_numeric_t(ck, l) or not is_numeric_t(ck, r):
        mp(ck, "arithmetic only works on numeric types")
        raise mk_fail(ck, "TypeMismatch")
    k: int = require_same_fixed(ck, l, r)
    if k >= 0:
        return 6 + k
    if l == 1 or r == 1:
        return 1
    return 0

# ---- ifadeler ----
def check_expr(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    ck.depth = ck.depth + 1
    if ck.depth > 500:
        mp(ck, "expression nested too deeply (maximum allowed depth: 500)")
        raise mk_fail(ck, "TooDeeplyNested")
    t: int = check_expr_inner(ck, a, fx, e)
    ck.depth = ck.depth - 1
    return t

def check_expr_inner(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    tag: int = a.n[e]
    if tag == {{T:Expr.int_lit}}:
        return 0
    if tag == {{T:Expr.float_lit}}:
        return 1
    if tag == {{T:Expr.bool_lit}}:
        return 2
    if tag == {{T:Expr.string_lit}}:
        return 3
    if tag == {{T:Expr.bytes_lit}}:
        return ty_mk(ck.tt, 18, 0, 0)
    if tag == {{T:Expr.none_lit}}:
        return 4
    if tag == {{T:Expr.identifier}}:
        return check_identifier(ck, a, fx, e)
    if tag == {{T:Expr.unary}}:
        return check_unary(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.binary}}:
        return check_binary(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.call}}:
        return check_call(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.list_lit}}:
        return check_list_lit(ck, a, fx, e)
    if tag == {{T:Expr.dict_lit}}:
        return check_dict_lit(ck, a, fx, e)
    if tag == {{T:Expr.index}}:
        return check_index(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.attribute}}:
        return check_attribute(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.await_expr}}:
        return check_await(ck, a, fx, e)
    if tag == {{T:Expr.spawn_expr}}:
        return check_spawn(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.generic_construct}}:
        return check_generic_construct(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.slice}}:
        return check_slice(ck, a, fx, a.n[e + 1])
    if tag == {{T:Expr.lambda}}:
        return check_lambda(ck, a, fx, e, -1)
    if tag == {{T:Expr.tuple_lit}}:
        return check_tuple_lit(ck, a, fx, e, -1)
    if tag == {{T:Expr.ternary}}:
        return check_ternary(ck, a, fx, a.n[e + 1], -1)
    if tag == {{T:Expr.list_comp}}:
        return check_list_comp(ck, a, fx, a.n[e + 1], -1)
    if tag == {{T:Expr.dict_comp}}:
        return check_dict_comp(ck, a, fx, a.n[e + 1], -1)
    raise unsup(ck, "check_expr_inner#" + str(tag))

# `spawn f(...)`: yalnızca üst-düzey `async def` çağrısı (iç içe async/`obj.metod` sarmalayıcısı kapsam dışı) -> `Task[T]`.
def find_method_def(ck: Ck, a: Ast, cls_sym: int, attr_sym: int) -> int:
    cur: int = cls_sym
    while cur >= 0:
        ci: int = class_idx(ck, cur)
        if ci < 0:
            return -1
        cd: int = ck.cls_node[ci]
        if cd >= 0:
            ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
            for i in range(pky(ms)):
                m: int = stmt_at(a, ms, i)
                if sym_of(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])) == attr_sym:
                    return m
        cur = ck.cls_base[ci]
    return -1

def resolve_spawn_attr_callee(ck: Ck, a: Ast, fx: Fx, c: int, at: int) -> None:
    raw_segs: list[int] = []
    callee_e: int = a.n[c + {{O:Call.callee}}]
    if flatten_dotted(ck, a, callee_e, raw_segs) and len(raw_segs) >= 2:
        segs: list[int] = subst_alias(ck, raw_segs)
        mod_sym: int = join_syms(ck, segs, len(segs) - 1, 46)
        if m2_get(ck.imod, 0, mod_sym) >= 0:
            msym: int = join_syms(ck, segs, len(segs), 95)
            a.n[c + {{O:Call.callee}}] = mk_ident_node(a, sym_to_str(ck, msym))
            return
    recv_t: int = check_expr(ck, a, fx, a.n[at + {{O:Attribute.obj}}])
    if ck.tt.tag[recv_t] != 6:
        fail2(ck, "NotCallable", "'spawn' can only wrap a function or a method call on a class instance")
    cls_sym: int = ck.tt.xa[recv_t]
    attr_sr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    attr_sym: int = sym_of(ck, a, attr_sr)
    md: int = find_method_def(ck, a, cls_sym, attr_sym)
    if md < 0:
        mp(ck, "class '")
        mp_sym(ck, cls_sym)
        mp(ck, "' has no method '")
        mp_sym(ck, attr_sym)
        mp(ck, "'")
        raise mk_fail(ck, "UndefinedMethod")
    mps: int = sl_at(a, md, {{O:FuncDef.params}})
    mpn: int = pky(mps)
    cargs: int = sl_at(a, c, {{O:Call.args}})
    can: int = pky(cargs)
    if mpn == 0 or can != mpn - 1:
        exp_n: int = 0
        if mpn > 0:
            exp_n = mpn - 1
        mp(ck, "'")
        mp_sym(ck, cls_sym)
        mp(ck, ".")
        mp_sym(ck, attr_sym)
        mp(ck, "' expects ")
        mp_int(ck, exp_n)
        mp(ck, " arguments, ")
        mp_int(ck, can)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    thunk_str: str = "__spawn_" + sym_to_str(ck, cls_sym) + "_" + sym_to_str(ck, attr_sym)
    thunk_sym: int = sym_lit(ck, thunk_str)
    if m2_get(ck.fmap, 0, thunk_sym) < 0:
        cls_sr: int = syn(a, sym_to_str(ck, cls_sym))
        self_sr: int = syn(a, "__self")
        pids: list[int] = [mk_Param(a, pkx(self_sr), pky(self_sr), 0, 0, 0, 0, mk_TypeExpr_simple(a, pkx(cls_sr), pky(cls_sr)), 0, {{NONE}})]
        iargs: list[int] = []
        for i in range(1, mpn):
            p: int = stmt_at(a, mps, i)
            pids.append(mk_Param(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1], 0, 0, 0, 0, a.n[p + {{O:Param.type_expr}}], 0, {{NONE}}))
            iargs.append(mk_Expr_identifier(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]))
        iasl: int = ast_expr_list(a, iargs)
        invoke: int = mk_attr_call_node(a, mk_Expr_identifier(a, pkx(self_sr), pky(self_sr)), sym_to_str(ck, attr_sym), iasl)
        ret_te: int = a.n[md + {{O:FuncDef.return_type}}]
        returns_none: bool = a.n[ret_te] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[ret_te + 1], a.n[ret_te + 2]), "None")
        bk: int = mk_StmtKind_return_stmt(a, invoke)
        if returns_none:
            bk = mk_StmtKind_expr_stmt(a, invoke)
        bsl: int = ast_stmt_list(a, [mk_Stmt(a, bk, ck.cur_line, -1)])
        psl: int = ast_stmt_list(a, pids)
        tsr: int = syn(a, thunk_str)
        fd: int = mk_FuncDef(a, pkx(tsr), pky(tsr), 0, 0, pkx(psl), pky(psl), ret_te, 0, pkx(bsl), pky(bsl), 1, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, ck.cur_line)
        register_func(ck, a, fd)
        check_function_body(ck, a, fd)
    new_args: list[int] = [a.n[at + {{O:Attribute.obj}}]]
    for i in range(can):
        new_args.append(a.l[pkx(cargs) + i])
    nasl: int = ast_expr_list(a, new_args)
    a.n[c + {{O:Call.args}}] = pkx(nasl)
    a.n[c + {{O:Call.args}} + 1] = pky(nasl)
    a.n[c + {{O:Call.callee}}] = mk_ident_node(a, thunk_str)

def check_spawn(ck: Ck, a: Ast, fx: Fx, opd: int) -> int:
    if a.n[opd] != {{T:Expr.call}}:
        fail2(ck, "NotCallable", "'spawn' can only wrap a call expression")
    c: int = a.n[opd + 1]
    callee: int = a.n[c + {{O:Call.callee}}]
    if a.n[callee] == {{T:Expr.attribute}}:
        resolve_spawn_attr_callee(ck, a, fx, c, a.n[callee + 1])
        callee = a.n[c + {{O:Call.callee}}]
    if a.n[callee] != {{T:Expr.identifier}}:
        fail2(ck, "NotCallable", "'spawn' can only wrap a direct function call")
    nm: int = pk(a.n[callee + 1], a.n[callee + 2])
    sym: int = sym_of(ck, a, nm)
    ale: int = m2_get(fx.async_locals, 0, sym)
    if ale >= 0:
        lifted_sym: int = fx.async_locals.vv[ale]
        cs_e: int = m2_get(fx.async_cap_s, 0, sym)
        cn_e: int = m2_get(fx.async_cap_n, 0, sym)
        cargs_al: int = sl_at(a, c, {{O:Call.args}})
        n_al_args: list[int] = []
        if cs_e >= 0 and cn_e >= 0:
            st_c: int = fx.async_cap_s.vv[cs_e]
            n_c: int = fx.async_cap_n.vv[cn_e]
            for ci_a in range(n_c):
                n_al_args.append(mk_ident_node(a, sym_to_str(ck, fx.async_cap_pool[st_c + ci_a])))
        for ai_a in range(pky(cargs_al)):
            n_al_args.append(stmt_at(a, cargs_al, ai_a))
        nasl_a: int = ast_expr_list(a, n_al_args)
        a.n[c + {{O:Call.args}}] = pkx(nasl_a)
        a.n[c + {{O:Call.args}} + 1] = pky(nasl_a)
        a.n[c + {{O:Call.callee}}] = mk_ident_node(a, sym_to_str(ck, lifted_sym))
        sym = lifted_sym
    if m2_get(ck.fmap, 0, sym) < 0:
        sfe: int = m2_get(ck.fimp, 0, sym)
        if sfe >= 0 and m2_get(ck.fmap, 0, ck.fimp.vv[sfe]) >= 0:
            sym = ck.fimp.vv[sfe]
    if m2_get(ck.afn, 0, sym) < 0:
        mp(ck, "'spawn' can only start 'async def' functions: '")
        mp_sym(ck, sym)
        mp(ck, "' is not async")
        raise mk_fail(ck, "TypeMismatch")
    sid: int = ck.fmap.vv[m2_get(ck.fmap, 0, sym)]
    ck.in_spawn_op = True
    try:
        check_args_sig(ck, a, fx, c, sid, sym)
    finally:
        ck.in_spawn_op = False
    return ty_mk(ck.tt, 7, ck.fret[sid], 0)

# `checkGenericConstruct`: `Channel[T](kapasite)`, `ThreadChannel[T](kapasite)`, `TaskLocal[T]()`; `ptr[T](adres)` (lowlevel) ve kullanıcı jenerikleri/nitelikli adlar kapsam dışı.
def check_generic_construct(ck: Ck, a: Ast, fx: Fx, g: int) -> int:
    gn: int = pk(a.n[g + {{O:GenericConstruct.name}}], a.n[g + {{O:GenericConstruct.name}} + 1])
    targs: int = sl_at(a, g, {{O:GenericConstruct.type_args}})
    args: int = sl_at(a, g, {{O:GenericConstruct.args}})
    nt: int = pky(targs)
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, gn, "ptr"):
        if fx.ll_depth == 0:
            fail2(ck, "LowlevelRequired", "'ptr' can only be used inside a 'lowlevel:' block")
        if nt != 1:
            fail2(ck, "UnknownType", "'ptr' takes exactly one type argument")
        pelem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "the 'ptr' constructor takes exactly 1 argument (addr: int)")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            fail2(ck, "TypeMismatch", "the argument (addr) of the 'ptr' constructor must be an int")
        return ty_mk(tt, 17, pelem, 0)
    if sref_eq(a, gn, "ThreadChannel"):
        if nt != 1:
            fail2(ck, "UnknownType", "'ThreadChannel' takes exactly one type argument")
        telem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
        tg: int = tt.tag[telem]
        if tg == 9 or tg == 14 or tg == 15:
            fail2(ck, "TypeMismatch", "the 'ThreadChannel' element type can only be int/float/bool/str/None/ptr (and additionally task/channel/list/class/dict on hosted targets)")
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "the 'ThreadChannel' constructor takes exactly 1 argument (capacity: int)")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            fail2(ck, "TypeMismatch", "the argument (capacity) of the 'ThreadChannel' constructor must be an int")
        return ty_mk(tt, 10, telem, 0)
    gfd: int = lookup_generic_func(ck, a, gn)
    if gfd >= 0:
        gf_sym: int = sym_of(ck, a, pk(a.n[gfd + {{O:FuncDef.name}}], a.n[gfd + {{O:FuncDef.name}} + 1]))
        gf_tps: int = sl_at(a, gfd, {{O:FuncDef.type_params}})
        gf_ntp: int = pky(gf_tps)
        if nt != gf_ntp:
            mp(ck, "'")
            mp_sref(ck, a, gn)
            mp(ck, "' takes ")
            mp_int(ck, gf_ntp)
            mp(ck, " type argument(s), ")
            mp_int(ck, nt)
            mp(ck, " given")
            raise mk_fail(ck, "ArgumentCountMismatch")
        gf_ps: int = sl_at(a, gfd, {{O:FuncDef.params}})
        gf_needs_exp: bool = n < pky(gf_ps)
        for gfi in range(n):
            if a.n[stmt_at(a, args, gfi)] == {{T:Expr.kwarg}}:
                gf_needs_exp = True
        if not gf_needs_exp:
            for gfp_i in range(pky(gf_ps)):
                if a.n[stmt_at(a, gf_ps, gfp_i) + {{O:Param.variadic}}] != 0 or a.n[stmt_at(a, gf_ps, gfp_i) + {{O:Param.var_kw}}] != 0:
                    gf_needs_exp = True
        if gf_needs_exp:
            mp(ck, "a call with explicit type arguments ('")
            mp_sref(ck, a, gn)
            mp(ck, "[...]') must pass every argument positionally (no defaults, keywords or *args)")
            raise mk_fail(ck, "ArgumentCountMismatch")
        gf_exp: list[int] = []
        for gfei in range(nt):
            gf_exp.append(type_expr_to_type(ck, a, stmt_at(a, targs, gfei)))
        return instantiate_generic_func(ck, a, fx, gfd, gf_sym, args, gf_exp, True)
    gcd: int = lookup_generic_class(ck, a, gn)
    if gcd >= 0:
        bound: list[int] = []
        for gi in range(nt):
            bound.append(type_expr_to_type(ck, a, stmt_at(a, targs, gi)))
        ct: int = instantiate_generic_class(ck, a, gcd, bound)
        ci: int = class_idx_of_type(ck, ct)
        isid: int = ck.cls_init[ci]
        if isid < 0:
            isid = ck.sig_empty
        check_args_slice(ck, a, fx, args, isid, sym_of(ck, a, gn), True)
        return ct
    if sref_eq(a, gn, "TaskLocal"):
        if nt != 1:
            fail2(ck, "UnknownType", "'TaskLocal' takes exactly one type argument")
        lelem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
        if lelem == 0 or lelem == 1 or lelem == 2:
            fail2(ck, "TypeMismatch", "the T of 'TaskLocal[T]' must be a class/str/list/dict (a bare int/float/bool is outside the v1 scope — it requires boxing such as Optional[int])")
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "the 'TaskLocal' constructor takes no arguments")
        return ty_mk(tt, 11, lelem, 0)
    if not sref_eq(a, gn, "Channel"):
        fail_attr(ck, a, gn, "UnknownType", "unknown generic constructor: ", "")
    if nt != 1:
        fail2(ck, "UnknownType", "'Channel' takes exactly one type argument")
    celem: int = type_expr_to_type(ck, a, stmt_at(a, targs, 0))
    if n != 1:
        fail2(ck, "ArgumentCountMismatch", "the 'Channel' constructor takes exactly 1 argument (capacity: int)")
    if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
        fail2(ck, "TypeMismatch", "the argument (capacity) of the 'Channel' constructor must be an int")
    return ty_mk(tt, 8, celem, 0)

# `.await_expr` (Task operandı; Channel/ThreadHandle işlemleri ve `spawn` kapsam dışı)
def check_await(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    if not fx.in_async:
        mp(ck, "'await' can only be used inside an 'async def' body")
        raise mk_fail(ck, "TypeMismatch")
    opd: int = a.n[e + 1]
    saved: int = fx.awaited
    fx.awaited = -1
    if a.n[opd] == {{T:Expr.call}}:
        fx.awaited = a.n[a.n[opd + 1] + {{O:Call.callee}}]
    t: int = -1
    try:
        t = check_expr(ck, a, fx, opd)
    finally:
        fx.awaited = saved
    drop_path_narrows(ck, fx)
    if ck.tt.tag[t] == 7:
        return ck.tt.xa[t]
    # Task değil: yalnızca `ch.send/recv(...)` (Channel/ThreadChannel) ya da `h.join()` (ThreadHandle) çağrısı olabilir
    if a.n[opd] == {{T:Expr.call}}:
        cal: int = a.n[a.n[opd + 1] + {{O:Call.callee}}]
        if a.n[cal] == {{T:Expr.attribute}}:
            cat: int = a.n[cal + 1]
            rt: int = check_expr(ck, a, fx, a.n[cat + {{O:Attribute.obj}}])
            can: int = pk(a.n[cat + {{O:Attribute.attr}}], a.n[cat + {{O:Attribute.attr}} + 1])
            rg: int = ck.tt.tag[rt]
            if (sref_eq(a, can, "send") or sref_eq(a, can, "recv")) and (rg == 8 or rg == 10):
                return t
            if sref_eq(a, can, "join") and rg == 9:
                return t
    mp(ck, "'await' can only be used on a Task value, a Channel.send/recv, a ThreadChannel.send/recv or a ThreadHandle.join() call")
    raise mk_fail(ck, "TypeMismatch")

# `[a, b, ...]`: boş bağlamsız literal tipsiz; elemanlar aynı tipte olmalı.
def check_list_lit(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    n: int = a.n[e + 2]
    if n == 0:
        mp(ck, "the type of an empty list literal cannot be inferred")
        raise mk_fail(ck, "UnknownType")
    st: int = a.n[e + 1]
    first: int = check_expr(ck, a, fx, a.l[st])
    for i in range(1, n):
        t: int = check_expr(ck, a, fx, a.l[st + i])
        if t != first:
            mp(ck, "list elements must have the same type")
            raise mk_fail(ck, "TypeMismatch")
    return ty_list(ck.tt, first)

def dict_key_ok(ck: Ck, t: int) -> bool:
    return t == 0 or t == 2 or t == 3 or t == 1 or ck.tt.tag[t] == 18

def dict_value_ok(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return t == 0 or t == 1 or t == 2 or t == 3 or g == 18 or g == 6 or g == 5 or g == 13

def check_dict_lit(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    n: int = a.n[e + 2]
    if n == 0:
        mp(ck, "the type of an empty dict literal cannot be inferred")
        raise mk_fail(ck, "UnknownType")
    st: int = a.n[e + 1]
    p0: int = a.l[st]
    fk: int = check_expr(ck, a, fx, a.n[p0 + {{O:DictPair.key}}])
    fv: int = check_expr(ck, a, fx, a.n[p0 + {{O:DictPair.value}}])
    if not dict_key_ok(ck, fk):
        mp(ck, "the 'dict' key type can only be int/float/bool/str/bytes")
        raise mk_fail(ck, "TypeMismatch")
    if not dict_value_ok(ck, fv):
        mp(ck, "the 'dict' value type can only be int/float/bool/str/bytes/class/list/dict")
        raise mk_fail(ck, "TypeMismatch")
    for i in range(1, n):
        pp: int = a.l[st + i]
        kt: int = check_expr(ck, a, fx, a.n[pp + {{O:DictPair.key}}])
        vt: int = check_expr(ck, a, fx, a.n[pp + {{O:DictPair.value}}])
        if kt != fk:
            mp(ck, "dict keys must have the same type")
            raise mk_fail(ck, "TypeMismatch")
        if vt != fv:
            mp(ck, "dict values must have the same type")
            raise mk_fail(ck, "TypeMismatch")
    return ty_dict(ck.tt, fk, fv)

# `requireNotOptional`
def require_not_optional(ck: Ck, t: int, what: str) -> None:
    if ck.tt.tag[t] == 15:
        mp(ck, "an Optional (T | None) value cannot be used for '")
        mp(ck, what)
        mp(ck, "' — narrow it first with 'if ... != None:'")
        raise mk_fail(ck, "OptionalNotNarrowed")

# `checkTupleLit`: `(a, b, ...)` -> sentezlenmiş `tuple__...` sınıfı; beklenen tip varsa elemanlara iletilir.
def check_tuple_lit(ck: Ck, a: Ast, fx: Fx, e: int, expected: int) -> int:
    n: int = a.n[e + 2]
    if n == 0:
        fail2(ck, "TypeMismatch", "an empty tuple is not supported")
    es: int = -1
    if expected >= 0:
        eci: int = class_idx_of_type(ck, expected)
        if is_tuple_cls(ck, eci) and ck.tup_n[eci] == n:
            es = ck.tup_s[eci]
    st: int = a.n[e + 1]
    ts: list[int] = []
    for i in range(n):
        exp_el: int = -1
        if es >= 0:
            exp_el = ck.tup_e[es + i]
        et: int = check_expr_expected(ck, a, fx, a.l[st + i], exp_el)
        if et == 4:
            fail2(ck, "TypeMismatch", "a tuple element must produce a value")
        if es >= 0 and ty_assignable(ck.tt, exp_el, et):
            ts.append(exp_el)
        else:
            ts.append(et)
    return instantiate_tuple_class(ck, ts)

# `checkTernary`: `a if cond else b` (koşul bool, dallar aynı tipte ve desteklenen türde).
def check_ternary(ck: Ck, a: Ast, fx: Fx, t: int, expected: int) -> int:
    cond_e: int = a.n[t + {{O:Ternary.cond}}]
    ct: int = check_expr(ck, a, fx, cond_e)
    if ct != 2:
        fail2(ck, "TypeMismatch", "the condition of a ternary expression must be a bool")
    tk: list[int] = []
    tt_n: list[int] = []
    ek: list[int] = []
    et_n: list[int] = []
    collect_narrows(ck, a, fx, cond_e, True, tk, tt_n)
    collect_narrows(ck, a, fx, cond_e, False, ek, et_n)
    tsav: list[int] = apply_narrows(fx, tk, tt_n)
    then_t: int = -1
    try:
        then_t = check_expr_expected(ck, a, fx, a.n[t + {{O:Ternary.then_expr}}], expected)
    finally:
        restore_narrows(fx, tk, tsav)
    esav: list[int] = apply_narrows(fx, ek, et_n)
    else_t: int = -1
    try:
        else_t = check_expr_expected(ck, a, fx, a.n[t + {{O:Ternary.else_expr}}], expected)
    finally:
        restore_narrows(fx, ek, esav)
    tg: int = ck.tt.tag[then_t]
    if then_t != 0 and then_t != 1 and then_t != 2 and then_t != 3 and tg != 16 and tg != 5 and tg != 13 and tg != 6:
        fail2(ck, "TypeMismatch", "the type of the ternary expression's branches is not supported (it must be int/float/bool/str/list/dict/class)")
    if then_t != else_t:
        fail2(ck, "TypeMismatch", "both branches of a ternary expression MUST have the SAME type (to mix int and float, convert a branch explicitly)")
    return then_t

def check_comp_clauses(ck: Ck, a: Ast, fx: Fx, clauses: int, sv_sym: list[int], sv_prior: list[int]) -> None:
    for i in range(pky(clauses)):
        cl: int = stmt_at(a, clauses, i)
        ctag: int = a.n[cl]
        cpay: int = a.n[cl + 1]
        if ctag == {{T:CompClause.for_clause}}:
            elem_t: int = check_for_iterable(ck, a, fx, a.n[cpay + {{O:CompForClause.iterable}}])
            vn: int = pk(a.n[cpay + {{O:CompForClause.var_name}}], a.n[cpay + {{O:CompForClause.var_name}} + 1])
            vsym: int = sym_of(ck, a, vn)
            sv_sym.append(vsym)
            sv_prior.append(sc_lookup_local(ck, fx.scope, vsym))
            sc_declare(ck, fx.scope, vsym, elem_t)
        elif ctag == {{T:CompClause.if_clause}}:
            it: int = check_expr(ck, a, fx, cpay)
            if it != 2:
                fail2(ck, "TypeMismatch", "the comprehension 'if' condition must be a bool")

def restore_comp_scope(ck: Ck, fx: Fx, sv_sym: list[int], sv_prior: list[int]) -> None:
    i: int = len(sv_sym)
    while i > 0:
        i = i - 1
        if sv_prior[i] >= 0:
            sc_declare(ck, fx.scope, sv_sym[i], sv_prior[i])
        else:
            m2_remove(ck.vars, fx.scope, sv_sym[i])

def check_list_comp(ck: Ck, a: Ast, fx: Fx, lc: int, elem_expected: int) -> int:
    sv_sym: list[int] = []
    sv_prior: list[int] = []
    ck.comp_depth = ck.comp_depth + 1
    elem_t: int = -1
    try:
        check_comp_clauses(ck, a, fx, sl_at(a, lc, {{O:ListComp.clauses}}), sv_sym, sv_prior)
        elem_t = check_expr_expected(ck, a, fx, a.n[lc + {{O:ListComp.elem}}], elem_expected)
    finally:
        ck.comp_depth = ck.comp_depth - 1
    restore_comp_scope(ck, fx, sv_sym, sv_prior)
    if elem_t == 4:
        fail2(ck, "TypeMismatch", "the comprehension element must produce a value")
    return ty_list(ck.tt, elem_t)

def check_dict_comp(ck: Ck, a: Ast, fx: Fx, dc: int, val_expected: int) -> int:
    sv_sym: list[int] = []
    sv_prior: list[int] = []
    ck.comp_depth = ck.comp_depth + 1
    key_t: int = -1
    val_t: int = -1
    try:
        check_comp_clauses(ck, a, fx, sl_at(a, dc, {{O:DictComp.clauses}}), sv_sym, sv_prior)
        key_t = check_expr(ck, a, fx, a.n[dc + {{O:DictComp.key}}])
        val_t = check_expr_expected(ck, a, fx, a.n[dc + {{O:DictComp.value}}], val_expected)
    finally:
        ck.comp_depth = ck.comp_depth - 1
    restore_comp_scope(ck, fx, sv_sym, sv_prior)
    if not dict_key_ok(ck, key_t):
        fail2(ck, "TypeMismatch", "the 'dict' key type can only be int/float/bool/str/bytes")
    if not dict_value_ok(ck, val_t):
        fail2(ck, "TypeMismatch", "the 'dict' value type can only be int/float/bool/str/bytes/class/list/dict")
    return ty_dict(ck.tt, key_t, val_t)

# `obj[lo:hi:step]` (list/str/bytes).
def check_slice(ck: Ck, a: Ast, fx: Fx, sl: int) -> int:
    obj_t: int = check_expr(ck, a, fx, a.n[sl + {{O:Slice.obj}}])
    require_not_optional(ck, obj_t, "[:]")
    tt: TT = ck.tt
    if tt.tag[obj_t] == 18:
        if a.n[sl + {{O:Slice.step}}] >= 0:
            fail2(ck, "TypeMismatch", "bytes slices do not support a step")
        blo: int = a.n[sl + {{O:Slice.lo}}]
        if blo >= 0:
            if check_expr(ck, a, fx, blo) != 0:
                fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
        bhi: int = a.n[sl + {{O:Slice.hi}}]
        if bhi >= 0:
            if check_expr(ck, a, fx, bhi) != 0:
                fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
        lo_e: int = blo if blo >= 0 else mk_Expr_int_lit(a, 0)
        hi_e: int = bhi if bhi >= 0 else mk_Expr_int_lit(a, 9223372036854775807)
        return check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_slice", [a.n[sl + {{O:Slice.obj}}], lo_e, hi_e]))
    if tt.tag[obj_t] != 5 and obj_t != 3:
        fail2(ck, "TypeMismatch", "slicing ('[a:b]') only works on list/str/bytes")
    lo: int = a.n[sl + {{O:Slice.lo}}]
    if lo >= 0:
        if check_expr(ck, a, fx, lo) != 0:
            fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
    hi: int = a.n[sl + {{O:Slice.hi}}]
    if hi >= 0:
        if check_expr(ck, a, fx, hi) != 0:
            fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
    step: int = a.n[sl + {{O:Slice.step}}]
    if step >= 0:
        if check_expr(ck, a, fx, step) != 0:
            fail2(ck, "TypeMismatch", "slice bounds/step must be 'int'")
        stag: int = a.n[step]
        if stag == {{T:Expr.int_lit}} and a.n[step + 1] == 0:
            fail2(ck, "TypeMismatch", "the slice step cannot be zero")
        if stag == {{T:Expr.unary}}:
            up: int = a.n[step + 1]
            if a.n[up + {{O:Unary.op}}] == {{E:UnaryOp.neg}} and a.n[a.n[up + {{O:Unary.operand}}]] == {{T:Expr.int_lit}} and a.n[a.n[up + {{O:Unary.operand}}] + 1] == 0:
                fail2(ck, "TypeMismatch", "the slice step cannot be zero")
    return obj_t

# `obj[i]`: dict[K]→V, str[int]→str, list[int]→T, tuple[k]→Tk (sınıf `__getitem__` kapsam dışı).
def check_index(ck: Ck, a: Ast, fx: Fx, ip: int) -> int:
    obj_t: int = check_expr(ck, a, fx, a.n[ip + {{O:Index.obj}}])
    require_not_optional(ck, obj_t, "[]")
    tt: TT = ck.tt
    ie: int = a.n[ip + {{O:Index.index}}]
    if has_dunder(ck, obj_t, "__getitem__"):
        return check_expr(ck, a, fx, mk_dunder_call(a, a.n[ip + {{O:Index.obj}}], "__getitem__", [ie]))
    tci: int = class_idx_of_type(ck, obj_t)
    if is_tuple_cls(ck, tci):
        itag: int = a.n[ie]
        k: int = 0
        if itag == {{T:Expr.int_lit}}:
            k = a.n[ie + 1]
        elif itag == {{T:Expr.unary}}:
            up: int = a.n[ie + 1]
            if a.n[up + {{O:Unary.op}}] == {{E:UnaryOp.neg}} and a.n[a.n[up + {{O:Unary.operand}}]] == {{T:Expr.int_lit}}:
                k = 0 - a.n[a.n[up + {{O:Unary.operand}}] + 1]
            else:
                fail2(ck, "TypeMismatch", "a tuple index must be a constant int literal")
        else:
            fail2(ck, "TypeMismatch", "a tuple index must be a constant int literal")
        tn: int = ck.tup_n[tci]
        ki: int = k
        if ki < 0:
            ki = ki + tn
        if ki < 0 or ki >= tn:
            mp(ck, "tuple index out of range (the tuple has ")
            mp_int(ck, tn)
            mp(ck, " elements)")
            raise mk_fail(ck, "TypeMismatch")
        return ck.tup_e[ck.tup_s[tci] + ki]
    if tt.tag[obj_t] == 13:
        idx_t: int = check_expr(ck, a, fx, ie)
        if idx_t != tt.xa[obj_t]:
            mp(ck, "the dict index does not match the key type")
            raise mk_fail(ck, "TypeMismatch")
        return tt.xb[obj_t]
    if obj_t == 3:
        it: int = check_expr(ck, a, fx, ie)
        if it != 0:
            mp(ck, "a str index must be an int")
            raise mk_fail(ck, "TypeMismatch")
        return 3
    if tt.tag[obj_t] == 18:
        bit: int = check_expr(ck, a, fx, ie)
        if bit != 0:
            fail2(ck, "TypeMismatch", "a bytes index must be an int")
        return check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_index", [a.n[ip + {{O:Index.obj}}], ie]))
    lt: int = check_expr(ck, a, fx, ie)
    if lt != 0:
        mp(ck, "a list index must be an int")
        raise mk_fail(ck, "TypeMismatch")
    if tt.tag[obj_t] == 5:
        return tt.xa[obj_t]
    mp(ck, "indexing only works on 'list'/'dict'/'str'")
    raise mk_fail(ck, "TypeMismatch")

def check_identifier(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    v: int = pk(a.n[e + 1], a.n[e + 2])
    sym: int = sym_of(ck, a, v)
    ne: int = m2_get(fx.narrowed, 0, sym)
    if ne >= 0:
        return fx.narrowed.vv[ne]
    t: int = sc_lookup(ck, fx.scope, sym)
    if t >= 0:
        return t
    gi: int = m2_get(ck.globs, 0, sym)
    if gi >= 0:
        return ck.globs.vv[gi]
    if m2_get(ck.gfn, 0, sym) >= 0:
        mp(ck, "the generic function '")
        mp_sym(ck, sym)
        mp(ck, "' cannot be used as a value (it can only be called)")
        raise mk_fail(ck, "TypeMismatch")
    # resolveIdentifierAsFunctionValue: üst-düzey (generic/async olmayan) işlev adı bir değer olarak
    fe: int = m2_get(ck.fmap, 0, sym)
    if fe >= 0:
        if m2_get(ck.afn, 0, sym) >= 0:
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "' is an 'async def' function and cannot be used as a value")
            raise mk_fail(ck, "TypeMismatch")
        fi: int = ck.fmap.vv[fe]
        ty_func_begin(ck.tt)
        st: int = ck.fps[fi]
        for i in range(ck.fpn[fi]):
            ty_func_param(ck.tt, ck.fpar[st + i])
        return ty_func_end(ck.tt, ck.fret[fi])
    fe: int = m2_get(ck.fimp, 0, sym)
    if fe >= 0:
        mn_sym: int = ck.fimp.vv[fe]
        mfi: int = m2_get(ck.fmap, 0, mn_sym)
        if mfi < 0:
            raise unsup(ck, "check_identifier#fromimport")
        rfi: int = ck.fmap.vv[mfi]
        if m2_get(ck.afn, 0, mn_sym) >= 0:
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "' is an 'async def' function and cannot be used as a value")
            raise mk_fail(ck, "TypeMismatch")
        ty_func_begin(ck.tt)
        st2: int = ck.fps[rfi]
        for i2 in range(ck.fpn[rfi]):
            ty_func_param(ck.tt, ck.fpar[st2 + i2])
        return ty_func_end(ck.tt, ck.fret[rfi])
    mp(ck, "undefined variable: ")
    mp_sym(ck, sym)
    raise mk_fail(ck, "UndefinedVariable")

def check_unary(ck: Ck, a: Ast, fx: Fx, u: int) -> int:
    op: int = a.n[u + {{O:Unary.op}}]
    opnd: int = a.n[u + {{O:Unary.operand}}]
    t: int = check_expr(ck, a, fx, opnd)
    tt: TT = ck.tt
    if op == {{E:UnaryOp.neg}} and has_dunder(ck, t, "__neg__"):
        return check_expr(ck, a, fx, mk_dunder_call(a, opnd, "__neg__", []))
    if op == {{E:UnaryOp.invert}} and has_dunder(ck, t, "__invert__"):
        return check_expr(ck, a, fx, mk_dunder_call(a, opnd, "__invert__", []))
    if op == {{E:UnaryOp.neg}}:
        if not is_numeric_t(ck, t):
            mp(ck, "unary '-' can only be applied to numeric types")
            raise mk_fail(ck, "TypeMismatch")
        if tt.tag[t] == 16 and not fx_signed(tt.xa[t]):
            mp(ck, "unary '-' cannot be applied to an unsigned type ('")
            mp_type(ck, t)
            mp(ck, "')")
            raise mk_fail(ck, "TypeMismatch")
        return t
    if op == {{E:UnaryOp.not_}}:
        if t != 2:
            mp(ck, "'not' can only be used with bool")
            raise mk_fail(ck, "TypeMismatch")
        return 2
    if not is_bitwise_t(ck, t):
        mp(ck, "unary '~' can only be applied to int/fixed-width integer types (float/bool are not supported — for bool, convert with 'int(...)' first)")
        raise mk_fail(ck, "TypeMismatch")
    if tt.tag[t] == 16:
        return t
    return 0

def dunder_base(op: int) -> str:
    if op == {{E:BinaryOp.add}}:
        return "add"
    if op == {{E:BinaryOp.sub}}:
        return "sub"
    if op == {{E:BinaryOp.mul}}:
        return "mul"
    if op == {{E:BinaryOp.div}}:
        return "truediv"
    if op == {{E:BinaryOp.floordiv}}:
        return "floordiv"
    if op == {{E:BinaryOp.mod}}:
        return "mod"
    if op == {{E:BinaryOp.pow}}:
        return "pow"
    if op == {{E:BinaryOp.bit_and}}:
        return "and"
    if op == {{E:BinaryOp.bit_or}}:
        return "or"
    if op == {{E:BinaryOp.bit_xor}}:
        return "xor"
    if op == {{E:BinaryOp.shl}}:
        return "lshift"
    if op == {{E:BinaryOp.shr}}:
        return "rshift"
    return ""

def dunder_class_ok(ck: Ck, t: int) -> bool:
    if ck.tt.tag[t] != 6:
        return False
    return not is_tuple_cls(ck, class_idx_of_type(ck, t))

def try_operator_overload(ck: Ck, a: Ast, fx: Fx, b: int, left: int, right: int, op: int, l: int, r: int) -> int:
    if a.n[left] == {{T:Expr.none_lit}} or a.n[right] == {{T:Expr.none_lit}}:
        return -1
    if op == {{E:BinaryOp.in_}} or op == {{E:BinaryOp.not_in}}:
        if not has_dunder(ck, r, "__contains__"):
            return -1
        rt: int = check_expr(ck, a, fx, mk_dunder_call(a, right, "__contains__", [left]))
        if rt != 2:
            fail2(ck, "TypeMismatch", "'__contains__' must return bool")
        return 2
    lc: bool = dunder_class_ok(ck, l)
    rc: bool = dunder_class_ok(ck, r)
    if not lc and not rc:
        return -1
    base: str = dunder_base(op)
    if len(base) > 0:
        fwd: str = "__" + base + "__"
        if lc and has_dunder(ck, l, fwd):
            return check_expr(ck, a, fx, mk_dunder_call(a, left, fwd, [right]))
        refl: str = "__r" + base + "__"
        if rc and has_dunder(ck, r, refl):
            return check_expr(ck, a, fx, mk_dunder_call(a, right, refl, [left]))
        return -1
    dname: str = ""
    if op == {{E:BinaryOp.eq}}:
        dname = "__eq__"
    elif op == {{E:BinaryOp.ne}}:
        dname = "__ne__"
    elif op == {{E:BinaryOp.lt}}:
        dname = "__lt__"
    elif op == {{E:BinaryOp.le}}:
        dname = "__le__"
    elif op == {{E:BinaryOp.gt}}:
        dname = "__gt__"
    elif op == {{E:BinaryOp.ge}}:
        dname = "__ge__"
    else:
        return -1
    if lc and has_dunder(ck, l, dname):
        rt2: int = check_expr(ck, a, fx, mk_dunder_call(a, left, dname, [right]))
        if rt2 != 2:
            mp(ck, "'")
            mp(ck, dname)
            mp(ck, "' must return bool")
            raise mk_fail(ck, "TypeMismatch")
        return 2
    if op == {{E:BinaryOp.ne}} and lc and has_dunder(ck, l, "__eq__"):
        rt3: int = check_expr(ck, a, fx, mk_dunder_call(a, left, "__eq__", [right]))
        if rt3 != 2:
            fail2(ck, "TypeMismatch", "'__eq__' must return bool")
        return 2
    rname: str = ""
    if op == {{E:BinaryOp.lt}}:
        rname = "__gt__"
    elif op == {{E:BinaryOp.le}}:
        rname = "__ge__"
    elif op == {{E:BinaryOp.gt}}:
        rname = "__lt__"
    elif op == {{E:BinaryOp.ge}}:
        rname = "__le__"
    if len(rname) > 0 and rc and has_dunder(ck, r, rname):
        rt4: int = check_expr(ck, a, fx, mk_dunder_call(a, right, rname, [left]))
        if rt4 != 2:
            mp(ck, "'")
            mp(ck, rname)
            mp(ck, "' must return bool")
            raise mk_fail(ck, "TypeMismatch")
        return 2
    return -1

def path_key_str(ck: Ck, a: Ast, e: int, depth: int) -> str:
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        return sref_str(a, pk(a.n[e + 1], a.n[e + 2]))
    if tag == {{T:Expr.attribute}}:
        if depth >= 4:
            return ""
        at: int = a.n[e + 1]
        base: str = path_key_str(ck, a, a.n[at + {{O:Attribute.obj}}], depth + 1)
        if len(base) == 0:
            return ""
        return base + "." + sref_str(a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
    return ""

def path_type(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    ks: str = path_key_str(ck, a, e, 0)
    if len(ks) == 0:
        return -1
    ksam: int = sym_lit(ck, ks)
    ne: int = m2_get(fx.narrowed, 0, ksam)
    if ne >= 0:
        return fx.narrowed.vv[ne]
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        return sc_lookup_local(ck, fx.scope, ksam)
    if tag == {{T:Expr.attribute}}:
        at: int = a.n[e + 1]
        ot: int = path_type(ck, a, fx, a.n[at + {{O:Attribute.obj}}])
        if ot < 0 or ck.tt.tag[ot] != 6:
            return -1
        ci: int = class_idx_of_type(ck, ot)
        if ci < 0:
            return -1
        asym: int = sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
        fe: int = m2_get(ck.cls_fields, ci, asym)
        if fe >= 0:
            return ck.cls_fields.vv[fe]
    return -1

def may_run_user_code(ck: Ck, a: Ast, e: int) -> bool:
    if e < 0:
        return False
    tag: int = a.n[e]
    if tag <= {{T:Expr.identifier}}:
        return False
    if tag == {{T:Expr.unary}}:
        return may_run_user_code(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}])
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        return may_run_user_code(ck, a, a.n[bp + {{O:Binary.left}}]) or may_run_user_code(ck, a, a.n[bp + {{O:Binary.right}}])
    if tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        cal: int = a.n[cp + {{O:Call.callee}}]
        if a.n[cal] == {{T:Expr.identifier}}:
            csym: int = sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2]))
            if not call_keeps_narrows_sym(ck, csym):
                return True
        elif a.n[cal] == {{T:Expr.attribute}}:
            at: int = a.n[cal + 1]
            asym: int = sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
            if m2_get(ck.fe_def, 0, asym) >= 0 or may_run_user_code(ck, a, a.n[at + {{O:Attribute.obj}}]):
                return True
        else:
            return True
        cas: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cas)):
            if may_run_user_code(ck, a, stmt_at(a, cas, i)):
                return True
        return False
    if tag == {{T:Expr.attribute}}:
        at2: int = a.n[e + 1]
        asym2: int = sym_of(ck, a, pk(a.n[at2 + {{O:Attribute.attr}}], a.n[at2 + {{O:Attribute.attr}} + 1]))
        return m2_get(ck.props, ck.tt.xa[0], asym2) >= 0 or may_run_user_code(ck, a, a.n[at2 + {{O:Attribute.obj}}])
    if tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        return may_run_user_code(ck, a, a.n[ip + {{O:Index.obj}}]) or may_run_user_code(ck, a, a.n[ip + {{O:Index.index}}])
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, e, 1)
        for i2 in range(pky(el)):
            if may_run_user_code(ck, a, stmt_at(a, el, i2)):
                return True
        return False
    if tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, e, 1)
        for i3 in range(pky(dl)):
            dp: int = a.l[pkx(dl) + i3]
            if may_run_user_code(ck, a, a.n[dp + {{O:DictPair.key}}]) or may_run_user_code(ck, a, a.n[dp + {{O:DictPair.value}}]):
                return True
        return False
    if tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        return may_run_user_code(ck, a, a.n[tp + {{O:Ternary.cond}}]) or may_run_user_code(ck, a, a.n[tp + {{O:Ternary.then_expr}}]) or may_run_user_code(ck, a, a.n[tp + {{O:Ternary.else_expr}}])
    if tag == {{T:Expr.kwarg}}:
        return may_run_user_code(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}])
    if tag == {{T:Expr.generic_construct}}:
        return True
    return True

def collect_narrows(ck: Ck, a: Ast, fx: Fx, cond: int, positive: bool, out_k: list[int], out_t: list[int]) -> None:
    tag: int = a.n[cond]
    if tag == {{T:Expr.unary}}:
        up: int = a.n[cond + 1]
        if a.n[up + {{O:Unary.op}}] == {{E:UnaryOp.not_}}:
            collect_narrows(ck, a, fx, a.n[up + {{O:Unary.operand}}], not positive, out_k, out_t)
        return
    if tag != {{T:Expr.binary}}:
        return
    bp: int = a.n[cond + 1]
    op: int = a.n[bp + {{O:Binary.op}}]
    left: int = a.n[bp + {{O:Binary.left}}]
    right: int = a.n[bp + {{O:Binary.right}}]
    if op == {{E:BinaryOp.and_}}:
        if positive:
            lk: list[int] = []
            lt: list[int] = []
            collect_narrows(ck, a, fx, left, True, lk, lt)
            ruc: bool = may_run_user_code(ck, a, right)
            for i in range(len(lk)):
                ks: str = sym_to_str(ck, lk[i])
                has_dot: bool = False
                for j in range(len(ks)):
                    if ks[j] == ".":
                        has_dot = True
                        break
                if ruc and has_dot:
                    continue
                out_k.append(lk[i])
                out_t.append(lt[i])
            collect_narrows(ck, a, fx, right, True, out_k, out_t)
        return
    if op == {{E:BinaryOp.or_}}:
        if not positive:
            lk2: list[int] = []
            lt2: list[int] = []
            collect_narrows(ck, a, fx, left, False, lk2, lt2)
            ruc2: bool = may_run_user_code(ck, a, right)
            for i2 in range(len(lk2)):
                ks2: str = sym_to_str(ck, lk2[i2])
                has_dot2: bool = False
                for j2 in range(len(ks2)):
                    if ks2[j2] == ".":
                        has_dot2 = True
                        break
                if ruc2 and has_dot2:
                    continue
                out_k.append(lk2[i2])
                out_t.append(lt2[i2])
            collect_narrows(ck, a, fx, right, False, out_k, out_t)
        return
    if op != {{E:BinaryOp.eq}} and op != {{E:BinaryOp.ne}}:
        return
    narrows_then: bool = (op == {{E:BinaryOp.ne}})
    if positive != narrows_then:
        return
    target_e: int = -1
    if a.n[right] == {{T:Expr.none_lit}}:
        target_e = left
    elif a.n[left] == {{T:Expr.none_lit}}:
        target_e = right
    if target_e < 0:
        return
    if a.n[target_e] == {{T:Expr.identifier}}:
        nsym: int = sym_of(ck, a, pk(a.n[target_e + 1], a.n[target_e + 2]))
        vt: int = sc_lookup_local(ck, fx.scope, nsym)
        if vt >= 0 and ck.tt.tag[vt] == 15:
            out_k.append(nsym)
            out_t.append(ck.tt.xa[vt])
        return
    if a.n[target_e] == {{T:Expr.attribute}}:
        pks: str = path_key_str(ck, a, target_e, 0)
        if len(pks) == 0:
            return
        pt: int = path_type(ck, a, fx, target_e)
        if pt >= 0 and ck.tt.tag[pt] == 15:
            in_t: int = ck.tt.xa[pt]
            ig: int = ck.tt.tag[in_t]
            if ig == 6 or ig == 5 or ig == 13 or ig == 3:
                out_k.append(sym_lit(ck, pks))
                out_t.append(in_t)

def apply_narrows(fx: Fx, ks: list[int], ts: list[int]) -> list[int]:
    saved: list[int] = []
    for i in range(len(ks)):
        e: int = m2_get(fx.narrowed, 0, ks[i])
        saved.append(fx.narrowed.vv[e] if e >= 0 else -1)
        m2_put(fx.narrowed, 0, ks[i], ts[i])
    return saved

def restore_narrows(fx: Fx, ks: list[int], saved: list[int]) -> None:
    for i in range(len(ks)):
        if saved[i] >= 0:
            m2_put(fx.narrowed, 0, ks[i], saved[i])
        else:
            m2_remove(fx.narrowed, 0, ks[i])

def drop_path_narrows(ck: Ck, fx: Fx) -> None:
    if fx.narrowed.live == 0:
        return
    for e in range(len(fx.narrowed.k1)):
        if fx.narrowed.dead[e] == 0:
            ks: str = sym_to_str(ck, fx.narrowed.k2[e])
            for j in range(len(ks)):
                if ks[j] == ".":
                    fx.narrowed.dead[e] = 1
                    fx.narrowed.live = fx.narrowed.live - 1
                    break

def invalidate_narrow_prefix(ck: Ck, fx: Fx, key: str) -> None:
    if fx.narrowed.live == 0:
        return
    kn: int = len(key)
    for e in range(len(fx.narrowed.k1)):
        if fx.narrowed.dead[e] == 0:
            ks: str = sym_to_str(ck, fx.narrowed.k2[e])
            if ks == key or (len(ks) > kn and ks[:kn] == key and ks[kn] == "."):
                fx.narrowed.dead[e] = 1
                fx.narrowed.live = fx.narrowed.live - 1

def invalidate_narrows_by_field(ck: Ck, fx: Fx, field: str) -> None:
    if fx.narrowed.live == 0:
        return
    for e in range(len(fx.narrowed.k1)):
        if fx.narrowed.dead[e] == 0:
            ks: str = sym_to_str(ck, fx.narrowed.k2[e])
            dot: int = -1
            for j in range(len(ks)):
                if ks[j] == ".":
                    dot = j
                    break
            if dot < 0:
                continue
            rest: str = ks[dot + 1:]
            seg_start: int = 0
            hit: bool = False
            for k in range(len(rest) + 1):
                if k == len(rest) or rest[k] == ".":
                    if rest[seg_start:k] == field:
                        hit = True
                        break
                    seg_start = k + 1
            if hit:
                fx.narrowed.dead[e] = 1
                fx.narrowed.live = fx.narrowed.live - 1

def call_keeps_narrows_sym(ck: Ck, sym: int) -> bool:
    s: str = sym_to_str(ck, sym)
    for p in ["len", "str", "int", "float", "bool", "print", "abs", "min", "max", "round", "sum", "repr", "ord", "chr", "range"]:
        if s == p:
            return True
    return False

def check_binary(ck: Ck, a: Ast, fx: Fx, b: int) -> int:
    left: int = a.n[b + {{O:Binary.left}}]
    right: int = a.n[b + {{O:Binary.right}}]
    op: int = a.n[b + {{O:Binary.op}}]
    l: int = check_expr(ck, a, fx, left)
    tt: TT = ck.tt
    rk: list[int] = []
    rt_l: list[int] = []
    if op == {{E:BinaryOp.and_}} or op == {{E:BinaryOp.or_}}:
        collect_narrows(ck, a, fx, left, op == {{E:BinaryOp.and_}}, rk, rt_l)
    rsav: list[int] = apply_narrows(fx, rk, rt_l)
    r: int = 0
    if op == {{E:BinaryOp.add}} and tt.tag[l] == 5 and a.n[right] == {{T:Expr.list_lit}}:
        r = check_expr_expected(ck, a, fx, right, l)
    else:
        r = check_expr(ck, a, fx, right)
    restore_narrows(fx, rk, rsav)
    ov_t: int = try_operator_overload(ck, a, fx, b, left, right, op, l, r)
    if ov_t >= 0:
        return ov_t
    if op == {{E:BinaryOp.add}}:
        if l == 3 and r == 3:
            return 3
        if tt.tag[l] == 18 and tt.tag[r] == 18:
            return l
        if tt.tag[l] == 5 and tt.tag[r] == 5:
            if l != r:
                mp(ck, "'+' requires the element types of the two lists to be the same")
                raise mk_fail(ck, "TypeMismatch")
            return l
        return numeric_promote(ck, l, r)
    if op == {{E:BinaryOp.sub}}:
        return numeric_promote(ck, l, r)
    if op == {{E:BinaryOp.mul}}:
        if tt.tag[l] == 5 and r == 0:
            return l
        if l == 0 and tt.tag[r] == 5:
            return r
        if (l == 3 and r == 0) or (l == 0 and r == 3):
            return 3
        return numeric_promote(ck, l, r)
    if op == {{E:BinaryOp.mod}} or op == {{E:BinaryOp.floordiv}} or op == {{E:BinaryOp.pow}}:
        res: int = numeric_promote(ck, l, r)
        if tt.tag[res] == 16:
            mp(ck, "'%'/'//'/'**' are not supported with fixed-width integer types yet — convert to 'int' first")
            raise mk_fail(ck, "TypeMismatch")
        return res
    if op == {{E:BinaryOp.div}}:
        if not is_numeric_t(ck, l) or not is_numeric_t(ck, r):
            mp(ck, "'/' can only be used with numeric types")
            raise mk_fail(ck, "TypeMismatch")
        require_same_fixed(ck, l, r)
        return 1
    if op == {{E:BinaryOp.eq}} or op == {{E:BinaryOp.ne}}:
        require_same_fixed(ck, l, r)
        if is_numeric_t(ck, l) and is_numeric_t(ck, r):
            return 2
        if a.n[b + {{O:Binary.opt_eq}}] != 0:
            return 2
        if (tt.tag[l] == 15 or tt.tag[r] == 15) and l != 4 and r != 4:
            li: int = tt.xa[l] if tt.tag[l] == 15 else l
            ri: int = tt.xa[r] if tt.tag[r] == 15 else r
            if li == ri:
                return 2
        if l == r:
            return 2
        if (tt.tag[l] == 15 and r == 4) or (l == 4 and tt.tag[r] == 15):
            return 2
        mp(ck, "the compared types do not match")
        raise mk_fail(ck, "TypeMismatch")
    if op == {{E:BinaryOp.lt}} or op == {{E:BinaryOp.le}} or op == {{E:BinaryOp.gt}} or op == {{E:BinaryOp.ge}}:
        if (l == 3 and r == 3) or (tt.tag[l] == 18 and tt.tag[r] == 18):
            return 2
        if not is_numeric_t(ck, l) or not is_numeric_t(ck, r):
            mp(ck, "ordering comparisons only work on numeric types or between two strs")
            raise mk_fail(ck, "TypeMismatch")
        require_same_fixed(ck, l, r)
        return 2
    if op == {{E:BinaryOp.and_}} or op == {{E:BinaryOp.or_}}:
        if l != 2 or r != 2:
            mp(ck, "'and'/'or' can only be used with bool")
            raise mk_fail(ck, "TypeMismatch")
        return 2
    if op == {{E:BinaryOp.in_}} or op == {{E:BinaryOp.not_in}}:
        if tt.tag[r] == 5:
            et: int = tt.xa[r]
            eg: int = tt.tag[et]
            if not (et == 0 or et == 1 or et == 2 or et == 3 or eg == 16 or eg == 6 or eg == 5):
                mp(ck, "the list element type is not supported for 'in' (it must be int/float/bool/str/class/list)")
                raise mk_fail(ck, "TypeMismatch")
            require_same_fixed(ck, l, et)
            if not ((is_numeric_t(ck, l) and is_numeric_t(ck, et)) or l == et):
                mp(ck, "the left operand of 'in' does not match the list element type")
                raise mk_fail(ck, "TypeMismatch")
            return 2
        if tt.tag[r] == 13:
            if l != tt.xa[r]:
                mp(ck, "the left operand of 'in' does not match the dict key type")
                raise mk_fail(ck, "TypeMismatch")
            return 2
        if tt.tag[r] == 3:
            if l != 3:
                mp(ck, "only a str can be searched for inside a str with 'in'")
                raise mk_fail(ck, "TypeMismatch")
            return 2
        if tt.tag[r] == 18:
            if l == 0:
                rt_b: int = check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_contains_byte", [a.n[b + {{O:Binary.right}}], a.n[b + {{O:Binary.left}}]]))
                if rt_b != 2:
                    fail2(ck, "TypeMismatch", "internal: __nox_bytes_contains_byte must return bool")
            elif tt.tag[l] != 18:
                fail2(ck, "TypeMismatch", "only a bytes value or an int (0..255) can be searched for inside bytes with 'in'")
            return 2
        mp(ck, "'in'/'not in' can only be used on list, dict, str and bytes")
        raise mk_fail(ck, "TypeMismatch")
    if op == {{E:BinaryOp.bit_and}} or op == {{E:BinaryOp.bit_or}} or op == {{E:BinaryOp.bit_xor}}:
        if l == 2 and r == 2:
            return 2
        if l == 2 or r == 2:
            mp(ck, "'&'/'|'/'^' do not implicitly mix bool with int/fixed-width integers — use an explicit conversion")
            raise mk_fail(ck, "TypeMismatch")
        if not is_bitwise_t(ck, l) or not is_bitwise_t(ck, r):
            mp(ck, "'&'/'|'/'^' can only be used on int/fixed-width integer types (float is not supported)")
            raise mk_fail(ck, "TypeMismatch")
        fk: int = require_same_fixed(ck, l, r)
        if fk >= 0:
            return 6 + fk
        return 0
    # shl / shr
    if not is_bitwise_t(ck, l):
        mp(ck, "the left operand of '<<'/'>>' can only be an int/fixed-width integer (float/bool are not supported — for bool, convert with 'int(...)' first)")
        raise mk_fail(ck, "TypeMismatch")
    if r != 0:
        mp(ck, "the shift amount of '<<'/'>>' must be an 'int'")
        raise mk_fail(ck, "TypeMismatch")
    if tt.tag[l] == 16:
        return l
    return 0

# `checkExprExpected`in skaler dilimi: sabit-genişlikli beklenen tipte tamsayı literali aralık denetimi.
# `constIntValue`: literal / değişmez modül sabiti (yerelde gölgelenmemişse) / bunlardan `- ~ + - * | & ^ << >>` ile kurulu ifade. Değer `ck.cv`de; dönüş: bulundu mu.
def const_int_value(ck: Ck, a: Ast, fx: Fx, e: int, depth: int) -> bool:
    if depth > 32:
        return False
    tag: int = a.n[e]
    if tag == {{T:Expr.int_lit}}:
        ck.cv = a.n[e + 1]
        return True
    if tag == {{T:Expr.identifier}}:
        sym: int = sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2]))
        if sc_lookup(ck, fx.scope, sym) >= 0:
            if ck.top_scope < 0 or fx.scope != ck.top_scope:
                return False
        ei: int = m2_get(ck.iconsts, 0, sym)
        if ei < 0:
            return False
        ck.cv = ck.iconsts.vv[ei]
        return True
    if tag == {{T:Expr.unary}}:
        u: int = a.n[e + 1]
        if not const_int_value(ck, a, fx, a.n[u + {{O:Unary.operand}}], depth + 1):
            return False
        v: int = ck.cv
        op: int = a.n[u + {{O:Unary.op}}]
        if op == {{E:UnaryOp.neg}}:
            ck.cv = 0 - v
            return True
        if op == {{E:UnaryOp.invert}}:
            ck.cv = ~v
            return True
        return False
    if tag == {{T:Expr.binary}}:
        b: int = a.n[e + 1]
        if not const_int_value(ck, a, fx, a.n[b + {{O:Binary.left}}], depth + 1):
            return False
        l: int = ck.cv
        if not const_int_value(ck, a, fx, a.n[b + {{O:Binary.right}}], depth + 1):
            return False
        r: int = ck.cv
        bop: int = a.n[b + {{O:Binary.op}}]
        if bop == {{E:BinaryOp.add}}:
            ck.cv = l + r
        elif bop == {{E:BinaryOp.sub}}:
            ck.cv = l - r
        elif bop == {{E:BinaryOp.mul}}:
            ck.cv = l * r
        elif bop == {{E:BinaryOp.bit_or}}:
            ck.cv = l | r
        elif bop == {{E:BinaryOp.bit_and}}:
            ck.cv = l & r
        elif bop == {{E:BinaryOp.bit_xor}}:
            ck.cv = l ^ r
        elif bop == {{E:BinaryOp.shl}}:
            if r < 0 or r >= 63:
                return False
            ck.cv = l << r
        elif bop == {{E:BinaryOp.shr}}:
            if r < 0 or r >= 63:
                return False
            ck.cv = l >> r
        else:
            return False
        return True
    return False

def check_expr_expected(ck: Ck, a: Ast, fx: Fx, e: int, expected_in: int) -> int:
    tag: int = a.n[e]
    tt: TT = ck.tt
    expected: int = expected_in
    # fonksiyon tipli yerellerin kutusu (`__nox_FnBox[F] | None`): değer (özellikle lambda) `F` beklenen tipiyle denetlenir, kutulama atamada yapılır
    if expected >= 0:
        bt_f: int = expected
        if tt.tag[bt_f] == 15:
            bt_f = tt.xa[bt_f]
        if tt.tag[bt_f] == 6:
            tsym_f: int = tt.xa[bt_f]
            tstr_f: str = sym_to_str(ck, tsym_f)
            if len(tstr_f) >= 13 and tstr_f[:13] == "__nox_FnBox__":
                ci_fb: int = class_idx(ck, tsym_f)
                if ci_fb >= 0 and ck.gcls_tn[ci_fb] == 1:
                    inner_fb: int = ck.gcls_te[ck.gcls_ts[ci_fb]]
                    if tt.tag[inner_fb] == 14:
                        expected = inner_fb
    # `y: list[str] | None = []`: Optional'ın taşıdığı list/dict beklenen tip olur
    if expected >= 0 and tt.tag[expected] == 15 and (tag == {{T:Expr.list_lit}} or tag == {{T:Expr.dict_lit}} or tag == {{T:Expr.list_comp}} or tag == {{T:Expr.dict_comp}}):
        inner: int = tt.xa[expected]
        if tt.tag[inner] == 5 or tt.tag[inner] == 13:
            expected = inner
    if tag == {{T:Expr.call}}:
        ac: int = a.n[e + 1]
        acal: int = a.n[ac + {{O:Call.callee}}]
        if a.n[acal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[acal + 1], a.n[acal + 2]), "adopt"):
            ll_require(ck, fx, a, pk(a.n[acal + 1], a.n[acal + 2]))
            aargs: int = sl_at(a, ac, {{O:Call.args}})
            if pky(aargs) != 1:
                fail2(ck, "ArgumentCountMismatch", "'adopt' takes exactly 1 argument")
            pt_a: int = check_expr(ck, a, fx, stmt_at(a, aargs, 0))
            if pt_a != 5:
                fail2(ck, "TypeMismatch", "'adopt' takes a ptr")
            if expected_in < 0:
                fail2(ck, "UnknownType", "'adopt' can only be used in a context whose expected type is known (var_decl/return/assignment/argument)")
            return expected_in
    if ck.generic_origin.live > 0 and expected >= 0 and tt.tag[expected] == 6:
        ge_t: int = try_generic_enum_expected(ck, a, fx, e, expected)
        if ge_t >= 0:
            return ge_t
    if tag == {{T:Expr.list_comp}} and expected >= 0 and tt.tag[expected] == 5:
        return check_list_comp(ck, a, fx, a.n[e + 1], tt.xa[expected])
    if tag == {{T:Expr.dict_comp}} and expected >= 0 and tt.tag[expected] == 13:
        return check_dict_comp(ck, a, fx, a.n[e + 1], tt.xb[expected])
    if tag == {{T:Expr.lambda}}:
        return check_lambda(ck, a, fx, e, expected)
    if tag == {{T:Expr.tuple_lit}}:
        return check_tuple_lit(ck, a, fx, e, expected)
    if tag == {{T:Expr.ternary}}:
        return check_ternary(ck, a, fx, a.n[e + 1], expected)
    if tag == {{T:Expr.list_lit}} and expected >= 0 and tt.tag[expected] == 5:
        n: int = a.n[e + 2]
        el: int = tt.xa[expected]
        if n == 0:
            return expected
        st: int = a.n[e + 1]
        if tt.tag[el] == 14:
            for i in range(n):
                t: int = check_expr_expected(ck, a, fx, a.l[st + i], el)
                if not assignable_or_coerce(ck, a, el, t):
                    mp(ck, "the list element does not match the expected function type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
        if tt.tag[el] == 6:
            for j0 in range(n):
                t0: int = check_expr(ck, a, fx, a.l[st + j0])
                if not assignable_or_coerce(ck, a, el, t0):
                    mp(ck, "the list element does not match the expected class type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
        if tt.tag[el] == 5 or tt.tag[el] == 13:
            for j in range(n):
                t2: int = check_expr_expected(ck, a, fx, a.l[st + j], el)
                if t2 != el:
                    mp(ck, "list elements must have the same type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
    if tag == {{T:Expr.dict_lit}} and expected >= 0 and tt.tag[expected] == 13:
        dn: int = a.n[e + 2]
        if dn == 0:
            return expected
        dv: int = tt.xb[expected]
        if tt.tag[dv] == 5 or tt.tag[dv] == 13:
            dst: int = a.n[e + 1]
            for k in range(dn):
                pr: int = a.l[dst + k]
                kt: int = check_expr(ck, a, fx, a.n[pr + {{O:DictPair.key}}])
                if kt != tt.xa[expected]:
                    mp(ck, "dict keys must have the same type")
                    raise mk_fail(ck, "TypeMismatch")
                vt: int = check_expr_expected(ck, a, fx, a.n[pr + {{O:DictPair.value}}], dv)
                if vt != dv:
                    mp(ck, "dict values must have the same type")
                    raise mk_fail(ck, "TypeMismatch")
            return expected
    if expected >= 0 and tt.tag[expected] == 16:
        kind: int = tt.xa[expected]
        if tag == {{T:Expr.int_lit}}:
            v: int = a.n[e + 1]
            if not fx_fits(kind, v):
                mp(ck, "the value ")
                mp_int(ck, v)
                mp(ck, " does not fit in the range of '")
                mp_type(ck, expected)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            return expected
        # sabit tamsayı ifadeleri (constIntValue): aralığa sığıyorsa örtük kabul
        isneglit: bool = False
        if tag == {{T:Expr.unary}}:
            up: int = a.n[e + 1]
            isneglit = a.n[up + {{O:Unary.op}}] == {{E:UnaryOp.neg}} and a.n[a.n[up + {{O:Unary.operand}}]] == {{T:Expr.int_lit}}
        if tag == {{T:Expr.identifier}} or tag == {{T:Expr.binary}} or (tag == {{T:Expr.unary}} and not isneglit):
            if const_int_value(ck, a, fx, e, 0):
                cvv: int = ck.cv
                if not fx_fits(kind, cvv):
                    mp(ck, "the constant value ")
                    mp_int(ck, cvv)
                    mp(ck, " does not fit in the range of '")
                    mp_type(ck, expected)
                    mp(ck, "'")
                    raise mk_fail(ck, "TypeMismatch")
                check_expr(ck, a, fx, e)
                return expected
        # `x: i8 = -5`: parser bunu unary neg(int_lit 5) olarak üretir
        if isneglit:
            if not fx_signed(kind):
                mp(ck, "a negative value cannot be assigned to the unsigned type '")
                mp_type(ck, expected)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            nv: int = 0 - a.n[a.n[a.n[e + 1] + {{O:Unary.operand}}] + 1]
            if not fx_fits(kind, nv):
                mp(ck, "the value ")
                mp_int(ck, nv)
                mp(ck, " does not fit in the range of '")
                mp_type(ck, expected)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            return expected
    return check_expr(ck, a, fx, e)

# ---- çağrılar: yerleşikler (print/len) + kullanıcı işlevi (identifier callee) ----
# `print(a, b, ...)` / `sep=`/`end=` anahtarlı argümanlar (Zig `checkCallInner` print dalı); sınıf (`__str__`) kapsam dışı.
def check_print(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    saw_kw: bool = False
    for i in range(pky(args)):
        arg: int = stmt_at(a, args, i)
        if a.n[arg] == {{T:Expr.kwarg}}:
            saw_kw = True
            k: int = a.n[arg + 1]
            kn: int = pk(a.n[k + {{O:Kwarg.name}}], a.n[k + {{O:Kwarg.name}} + 1])
            if not sref_eq(a, kn, "sep") and not sref_eq(a, kn, "end"):
                mp(ck, "'print' only accepts the 'sep=' and 'end=' keyword arguments")
                raise mk_fail(ck, "TypeMismatch")
            kt: int = check_expr(ck, a, fx, a.n[k + {{O:Kwarg.value}}])
            if kt != 3:
                mp(ck, "the '")
                mp_sref(ck, a, kn)
                mp(ck, "=' argument of 'print' must be a str")
                raise mk_fail(ck, "TypeMismatch")
        else:
            if saw_kw:
                mp(ck, "positional arguments of 'print' must come before keyword arguments")
                raise mk_fail(ck, "TypeMismatch")
            pt: int = check_expr(ck, a, fx, arg)
            if ck.tt.tag[pt] == 18:
                check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_repr", [arg]))
            if has_dunder(ck, pt, "__str__"):
                check_expr(ck, a, fx, mk_dunder_call(a, arg, "__str__", []))
    return 4

# `len(x)`: str/list/dict/tuple (sınıf `__len__` kapsam dışı).
def check_len(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    if pky(args) != 1:
        mp(ck, "'len' takes exactly 1 argument")
        raise mk_fail(ck, "ArgumentCountMismatch")
    t: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
    g: int = ck.tt.tag[t]
    if is_tuple_cls(ck, class_idx_of_type(ck, t)):
        return 0
    if has_dunder(ck, t, "__len__"):
        rt_l: int = check_expr(ck, a, fx, mk_dunder_call(a, stmt_at(a, args, 0), "__len__", []))
        if rt_l != 0:
            fail2(ck, "TypeMismatch", "'__len__' must return an int")
        return 0
    if g == 18:
        return check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_len", [stmt_at(a, args, 0)]))
    if t != 3 and g != 5 and g != 13:
        mp(ck, "'len' only works on str/list/dict/bytes/tuple (define `__len__` for classes)")
        raise mk_fail(ck, "TypeMismatch")
    return 0

# ---- yerleşik dönüşüm/ölçü çağrıları (Zig `checkCallInner` yerleşik dalları; 3.10 dilim B) ----
# `FixedIntKind` adı -> tür sırası (u8 0 ... isize 9); değilse -1.
def fixed_kind_of(a: Ast, v: int) -> int:
    if sref_eq(a, v, "u8"):
        return 0
    if sref_eq(a, v, "u16"):
        return 1
    if sref_eq(a, v, "u32"):
        return 2
    if sref_eq(a, v, "u64"):
        return 3
    if sref_eq(a, v, "usize"):
        return 4
    if sref_eq(a, v, "i8"):
        return 5
    if sref_eq(a, v, "i16"):
        return 6
    if sref_eq(a, v, "i32"):
        return 7
    if sref_eq(a, v, "i64"):
        return 8
    if sref_eq(a, v, "isize"):
        return 9
    return -1

# argüman listesinde anahtarlı (`kwarg`) argüman yok mu (Zig `positional == c.args.len`).
def all_positional(a: Ast, args: int) -> bool:
    for i in range(pky(args)):
        if a.n[stmt_at(a, args, i)] == {{T:Expr.kwarg}}:
            return False
    return True

def argc_fail(ck: Ck, a: Ast, cv: int, want: str) -> None:
    mp(ck, "'")
    mp_sref(ck, a, cv)
    mp(ck, "' takes exactly ")
    mp(ck, want)
    raise mk_fail(ck, "ArgumentCountMismatch")

# Bir yerleşik çağrının tek tip-argümanı: çıplak tanımlayıcı olmalı (değişken araması YAPILMAZ).
def builtin_type_arg(ck: Ck, a: Ast, args: int, i: int, msg_a: str, cv: int, msg_b: str) -> int:
    e: int = stmt_at(a, args, i)
    if a.n[e] != {{T:Expr.identifier}}:
        mp(ck, msg_a)
        if len(msg_b) > 0:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, msg_b)
        raise mk_fail(ck, "TypeMismatch")
    return pk(a.n[e + 1], a.n[e + 2])

# `wasm_call(yol, işlev, argüman)` (wasm32-wasi hedefi dışında).
def check_wasm_call(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    if arg_n(a, c) != 3:
        fail2(ck, "ArgumentCountMismatch", "'wasm_call' takes exactly 3 arguments (path: str, function_name: str, argument: int)")
    if arg_e(ck, a, fx, c, 0) != 3:
        fail2(ck, "TypeMismatch", "argument 1 (path) of 'wasm_call' must be a str")
    if arg_e(ck, a, fx, c, 1) != 3:
        fail2(ck, "TypeMismatch", "argument 2 (function name) of 'wasm_call' must be a str")
    if arg_e(ck, a, fx, c, 2) != 0:
        fail2(ck, "TypeMismatch", "argument 3 (argument) of 'wasm_call' must be an int")
    return 0

# `lowlevel:` dışında ptr ailesi kullanımı (Zig `requireLowlevel`).
def ll_require(ck: Ck, fx: Fx, a: Ast, cv: int) -> None:
    if fx.ll_depth == 0:
        mp(ck, "'")
        mp_sref(ck, a, cv)
        mp(ck, "' can only be used inside a 'lowlevel:' block")
        raise mk_fail(ck, "LowlevelRequired")

def pf_argc(ck: Ck, a: Ast, cv: int, n: int, want: int, tail: str) -> None:
    if n != want:
        mp(ck, "'")
        mp_sref(ck, a, cv)
        if want == 0:
            mp(ck, "' takes no arguments")
        elif want == 1:
            mp(ck, "' takes exactly 1 argument")
            mp(ck, tail)
        else:
            mp(ck, "' takes exactly 2 arguments ")
            mp(ck, tail)
        raise mk_fail(ck, "ArgumentCountMismatch")

def pf_arg_fail(ck: Ck, a: Ast, cv: int, pre: str, post: str) -> None:
    mp(ck, pre)
    mp(ck, "'")
    mp_sref(ck, a, cv)
    mp(ck, post)
    raise mk_fail(ck, "TypeMismatch")

# ptr/lowlevel yerleşikleri (Zig `checkCallInner`, `ptr_from_int` ... `detach`); -1: bu ailenin adı değil.
def check_ptr_builtin(ck: Ck, a: Ast, fx: Fx, c: int, cv: int) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, cv, "wasm_call"):
        return check_wasm_call(ck, a, fx, c)
    if sref_eq(a, cv, "ffi_box"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'ffi_box' takes exactly 1 argument (a function value)")
        if tt.tag[arg_e(ck, a, fx, c, 0)] != 14:
            fail2(ck, "TypeMismatch", "'ffi_box' takes a function value")
        return 5
    if sref_eq(a, cv, "ptr_from_int"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        if arg_e(ck, a, fx, c, 0) != 0:
            fail2(ck, "TypeMismatch", "'ptr_from_int' takes an int")
        return 5
    if sref_eq(a, cv, "ptr_to_int"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        xt: int = arg_e(ck, a, fx, c, 0)
        if xt != 5 and tt.tag[xt] != 17:
            fail2(ck, "TypeMismatch", "'ptr_to_int' takes a ptr or ptr[T]")
        return 0
    if sref_eq(a, cv, "ptr_of"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, " (a list variable or field)")
        a0: int = stmt_at(a, args, 0)
        if a.n[a0] != {{T:Expr.identifier}} and a.n[a0] != {{T:Expr.attribute}}:
            fail2(ck, "TypeMismatch", "'ptr_of' can only be applied to a variable or a field — not to the result of an expression (its data pointer would outlive the temporary)")
        lt: int = check_expr(ck, a, fx, a0)
        if tt.tag[lt] != 5:
            fail2(ck, "TypeMismatch", "'ptr_of' takes a list[T]")
        pe: int = tt.xa[lt]
        if pe != 0 and pe != 1 and tt.tag[pe] != 16:
            fail2(ck, "TypeMismatch", "'ptr_of' supports list[int], list[float] and lists of fixed-width integers only")
        return ty_mk(tt, 17, pe, 0)
    if sref_eq(a, cv, "ptr_add"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 2, "(p: ptr, n: int)")
        if arg_e(ck, a, fx, c, 0) != 5:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr")
        if arg_e(ck, a, fx, c, 1) != 0:
            pf_arg_fail(ck, a, cv, "argument 2 (n) of ", "' must be an int")
        return 5
    if sref_eq(a, cv, "ptr_read_int") or sref_eq(a, cv, "ptr_read_float") or sref_eq(a, cv, "ptr_read_bool"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        if arg_e(ck, a, fx, c, 0) != 5:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes a ptr")
            raise mk_fail(ck, "TypeMismatch")
        if sref_eq(a, cv, "ptr_read_int"):
            return 0
        if sref_eq(a, cv, "ptr_read_float"):
            return 1
        return 2
    if sref_eq(a, cv, "ptr_write_int") or sref_eq(a, cv, "ptr_write_float") or sref_eq(a, cv, "ptr_write_bool"):
        ll_require(ck, fx, a, cv)
        wt: int = 0
        wn: str = "an int"
        wl: str = "(p: ptr, v: int)"
        if sref_eq(a, cv, "ptr_write_float"):
            wt = 1
            wn = "a float"
            wl = "(p: ptr, v: float)"
        elif sref_eq(a, cv, "ptr_write_bool"):
            wt = 2
            wn = "a bool"
            wl = "(p: ptr, v: bool)"
        pf_argc(ck, a, cv, n, 2, wl)
        if arg_e(ck, a, fx, c, 0) != 5:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr")
        if arg_e(ck, a, fx, c, 1) != wt:
            pf_arg_fail(ck, a, cv, "argument 2 (v) of ", "' must be " + wn)
        return 4
    if sref_eq(a, cv, "ptr_offset"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 2, "(p: ptr[T], n: int)")
        ot: int = arg_e(ck, a, fx, c, 0)
        if tt.tag[ot] != 17:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr[T]")
        if arg_e(ck, a, fx, c, 1) != 0:
            pf_arg_fail(ck, a, cv, "argument 2 (n) of ", "' must be an int")
        return ot
    if sref_eq(a, cv, "ptr_read") or sref_eq(a, cv, "ptr_read_volatile"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        rt0: int = arg_e(ck, a, fx, c, 0)
        if tt.tag[rt0] != 17:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes a ptr[T]")
            raise mk_fail(ck, "TypeMismatch")
        return tt.xa[rt0]
    if sref_eq(a, cv, "ptr_write") or sref_eq(a, cv, "ptr_write_volatile"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 2, "(p: ptr[T], v: T)")
        wp: int = arg_e(ck, a, fx, c, 0)
        if tt.tag[wp] != 17:
            pf_arg_fail(ck, a, cv, "argument 1 (p) of ", "' must be a ptr[T]")
        if arg_e(ck, a, fx, c, 1) != tt.xa[wp]:
            pf_arg_fail(ck, a, cv, "argument 2 (v) of ", "' must have the SAME type as the T of p")
        return 4
    if sref_eq(a, cv, "memory_fence") or sref_eq(a, cv, "compiler_fence"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 0, "")
        return 4
    if sref_eq(a, cv, "detach"):
        ll_require(ck, fx, a, cv)
        pf_argc(ck, a, cv, n, 1, "")
        d0: int = stmt_at(a, args, 0)
        if a.n[d0] != {{T:Expr.identifier}}:
            fail2(ck, "TypeMismatch", "'detach' can only be applied to a plain local variable — not to a class field or the result of an expression")
        dt: int = check_expr(ck, a, fx, d0)
        dg: int = tt.tag[dt]
        if dg != 5 and dg != 13 and dg != 6 and dt != 3:
            fail2(ck, "TypeMismatch", "'detach' can only be applied to a variable of type list/dict/class/str")
        return 5
    return -1

def check_bind_method(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    if pky(args) != 2 or a.n[stmt_at(a, args, 1)] != {{T:Expr.string_lit}}:
        fail2(ck, "ArgumentCountMismatch", "'__nox_bind_method' (internal) takes exactly (object, \"name\")")
    a1: int = stmt_at(a, args, 1)
    asr: int = pk(a.n[a1 + 1], a.n[a1 + 2])
    astr: str = sref_str(a, asr)
    asym: int = sym_lit(ck, astr)
    obj_t: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
    require_not_optional(ck, obj_t, astr)
    if ck.tt.tag[obj_t] != 6:
        mp(ck, "'.")
        mp(ck, astr)
        mp(ck, "' can only be used on class instances")
        raise mk_fail(ck, "TypeMismatch")
    csym: int = ck.tt.xa[obj_t]
    ci: int = class_idx(ck, csym)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, csym)
        raise mk_fail(ck, "UndefinedClass")
    fe: int = m2_get(ck.cls_fields, ci, asym)
    if fe >= 0:
        return ck.cls_fields.vv[fe]
    if ck.props.live > 0 and find_property(ck, ci, asym) >= 0:
        return check_expr(ck, a, fx, mk_dunder_call(a, stmt_at(a, args, 0), astr, []))
    me: int = m2_get(ck.cls_meths, ci, asym)
    if me >= 0:
        msid: int = ck.cls_meths.vv[me]
        cd: int = ck.cls_node[ci]
        if cd >= 0:
            ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
            for i in range(pky(ms)):
                m: int = stmt_at(a, ms, i)
                if a.n[m + {{O:FuncDef.is_async}}] != 0 and sref_eq(a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1]), astr):
                    mp(ck, "the 'async' method '")
                    mp_sym(ck, csym)
                    mp(ck, ".")
                    mp(ck, astr)
                    mp(ck, "' cannot be used as a bound value")
                    raise mk_fail(ck, "TypeMismatch")
        own_sym: int = csym
        oe: int = m2_get(ck.cls_meth_owners, ci, asym)
        if oe >= 0:
            own_sym = ck.cls_meth_owners.vv[oe]
        check_capability_call(ck, sym_lit(ck, sym_to_str(ck, own_sym) + "." + astr))
        ty_func_begin(ck.tt)
        st: int = ck.fps[msid]
        for j in range(ck.fpn[msid]):
            ty_func_param(ck.tt, ck.fpar[st + j])
        return ty_func_end(ck.tt, ck.fret[msid])
    mp(ck, "class '")
    mp_sym(ck, csym)
    mp(ck, "' has no field '")
    mp(ck, astr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedAttribute")

# -1: `cv` bu dilimin yerleşiklerinden biri değil (normal çağrı yolu sürer); aksi halde sonuç tipi.
def check_builtin_call(ck: Ck, a: Ast, fx: Fx, c: int, cv: int) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, cv, "__nox_bind_method"):
        return check_bind_method(ck, a, fx, c)
    if sref_eq(a, cv, "adopt"):
        ll_require(ck, fx, a, cv)
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'adopt' takes exactly 1 argument")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 5:
            fail2(ck, "TypeMismatch", "'adopt' takes a ptr")
        fail2(ck, "UnknownType", "'adopt' can only be used in a context whose expected type is known (var_decl/return/assignment/argument)")
    if sref_eq(a, cv, "__nox_str_chars"):
        if n != 1:
            mp(ck, "'__nox_str_chars' (internal) takes exactly 1 argument")
            raise mk_fail(ck, "ArgumentCountMismatch")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 3:
            mp(ck, "'__nox_str_chars' (internal) expects a str")
            raise mk_fail(ck, "TypeMismatch")
        return ty_list(tt, 3)
    if sref_eq(a, cv, "__nox_hash"):
        if n != 1:
            mp(ck, "'__nox_hash' (internal) takes exactly 1 argument")
            raise mk_fail(ck, "ArgumentCountMismatch")
        check_expr(ck, a, fx, stmt_at(a, args, 0))
        return 0
    rbt: int = check_reflect_builtin(ck, a, fx, c, cv)
    if rbt >= 0:
        return rbt
    if sref_eq(a, cv, "super"):
        mp(ck, "'super()' can only be used in the 'super().method(...)' or 'super().__init__(...)' form, directly as the receiver of a method call")
        raise mk_fail(ck, "TypeMismatch")
    if sref_eq(a, cv, "repr") and m2_get(ck.fmap, 0, sym_of(ck, a, cv)) < 0:
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        rt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if tt.tag[rt] == 14 or rt == 4:
            mp(ck, "'repr' does not work on function/None values")
            raise mk_fail(ck, "TypeMismatch")
        if tt.tag[rt] == 18:
            return check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_repr", [stmt_at(a, args, 0)]))
        return 3
    if sref_eq(a, cv, "bytes"):
        bsym: int = sym_of(ck, a, cv)
        if m2_get(ck.fmap, 0, bsym) < 0 and class_idx(ck, bsym) < 0:
            if n == 0:
                return ty_mk(tt, 18, 0, 0)
            if n != 1:
                fail2(ck, "ArgumentCountMismatch", "'bytes' takes 0 or 1 argument")
            a0_b: int = stmt_at(a, args, 0)
            at_b: int = check_expr(ck, a, fx, a0_b)
            if tt.tag[at_b] == 18:
                return at_b
            if tt.tag[at_b] == 5 and tt.xa[at_b] == 0:
                return check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_new_ints", [a0_b]))
            if tt.tag[at_b] == 5 and tt.tag[tt.xa[at_b]] == 16:
                return check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_new", [a0_b]))
            if at_b == 3:
                fail2(ck, "TypeMismatch", "'bytes' cannot take a str: use s.encode()")
            fail2(ck, "TypeMismatch", "'bytes' takes a list[int]/list[u8] or a bytes value")
        return -1
    if sref_eq(a, cv, "str"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        st: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if has_dunder(ck, st, "__str__"):
            rt_s: int = check_expr(ck, a, fx, mk_dunder_call(a, stmt_at(a, args, 0), "__str__", []))
            if rt_s != 3:
                fail2(ck, "TypeMismatch", "'__str__' must return a str")
            return 3
        sg: int = tt.tag[st]
        if sg == 5 or sg == 13 or sg == 6:
            return 3
        if st != 0 and st != 1 and st != 3 and st != 2 and sg != 16:
            mp(ck, "'str' works on int/float/str/bool/list/dict/class (for an Optional, narrow out None first)")
            raise mk_fail(ck, "TypeMismatch")
        return 3
    if sref_eq(a, cv, "int"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        it: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if it != 3 and it != 1 and it != 2 and tt.tag[it] != 16:
            mp(ck, "'int' only works on str/float/bool/fixed-width integers")
            raise mk_fail(ck, "TypeMismatch")
        return 0
    if sref_eq(a, cv, "float"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        ft: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ft != 3 and ft != 0 and ft != 1 and ft != 2 and tt.tag[ft] != 16:
            mp(ck, "'float' only works on str/int/float/bool/fixed-width integers")
            raise mk_fail(ck, "TypeMismatch")
        return 1
    fk: int = fixed_kind_of(a, cv)
    if fk >= 0:
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        xt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if xt != 0 and xt != 1 and tt.tag[xt] != 16:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' only works on int/float/fixed-width integer types")
            raise mk_fail(ck, "TypeMismatch")
        return 6 + fk
    if sref_eq(a, cv, "sizeof") or sref_eq(a, cv, "alignof"):
        if n != 1:
            argc_fail(ck, a, cv, "1 argument")
        tn: int = builtin_type_arg(ck, a, args, 0, "the argument of ", cv, "' must be a type name (a bare identifier)")
        simple_type(ck, a, tn)
        return 10
    if sref_eq(a, cv, "offsetof"):
        if n != 2:
            mp(ck, "'offsetof' takes exactly 2 arguments (Class, \"field\")")
            raise mk_fail(ck, "ArgumentCountMismatch")
        cn: int = builtin_type_arg(ck, a, args, 0, "argument 1 of 'offsetof' must be a class name (a bare identifier)", cv, "")
        ot: int = simple_type(ck, a, cn)
        if tt.tag[ot] != 6:
            mp(ck, "'offsetof' only works on a class type: ")
            mp_sref(ck, a, cn)
            raise mk_fail(ck, "TypeMismatch")
        fe: int = stmt_at(a, args, 1)
        if a.n[fe] != {{T:Expr.string_lit}}:
            mp(ck, "argument 2 of 'offsetof' can only be a string LITERAL")
            raise mk_fail(ck, "TypeMismatch")
        oci: int = class_idx_of_type(ck, ot)
        if oci < 0:
            mp(ck, "unknown class: ")
            mp_sym(ck, tt.xa[ot])
            raise mk_fail(ck, "UndefinedClass")
        fnm: int = pk(a.n[fe + 1], a.n[fe + 2])
        if m2_get(ck.cls_fields, oci, sym_of(ck, a, fnm)) < 0:
            mp(ck, "class '")
            mp_sym(ck, ck.cls_sym[oci])
            mp(ck, "' has no field '")
            mp_sref(ck, a, fnm)
            mp(ck, "'")
            raise mk_fail(ck, "UndefinedAttribute")
        return 10
    return check_ptr_builtin(ck, a, fx, c, cv)

def sref_starts_with(a: Ast, sr: int, pfx: str) -> bool:
    if sref_len(sr) < len(pfx):
        return False
    for i in range(len(pfx)):
        if sref_byte(a, sr, i) != ord(pfx[i]):
            return False
    return True

# `__nox_reflect_*` metadata yerleşikleri (Zig `checkReflectMetaIntrinsic` + inline dallar). -1: değil.
def check_reflect_builtin(ck: Ck, a: Ast, fx: Fx, c: int, cv: int) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    tt: TT = ck.tt
    if sref_eq(a, cv, "__nox_reflect_decorator_count"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'__nox_reflect_decorator_count' takes no arguments")
        return 0
    if sref_eq(a, cv, "__nox_reflect_decorator_target_name") or sref_eq(a, cv, "__nox_reflect_decorator_name") or sref_eq(a, cv, "__nox_reflect_decorator_arg_count") or sref_eq(a, cv, "__nox_reflect_decorator_is_handler") or sref_eq(a, cv, "__nox_reflect_decorator_handler"):
        if n != 1:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes exactly 1 argument (i: int)")
            raise mk_fail(ck, "ArgumentCountMismatch")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            mp(ck, "the argument of '")
            mp_sref(ck, a, cv)
            mp(ck, "' must be an int")
            raise mk_fail(ck, "TypeMismatch")
        if sref_eq(a, cv, "__nox_reflect_decorator_arg_count"):
            return 0
        if sref_eq(a, cv, "__nox_reflect_decorator_is_handler"):
            return 2
        if sref_eq(a, cv, "__nox_reflect_decorator_handler"):
            ctx_s: int = sym_lit(ck, "Context")
            ctx_e: int = m2_get(ck.fimp, 0, ctx_s)
            if ctx_e >= 0:
                ctx_s = ck.fimp.vv[ctx_e]
            hr_s: int = sym_lit(ck, "HttpResponse")
            hr_e: int = m2_get(ck.fimp, 0, hr_s)
            if hr_e >= 0:
                hr_s = ck.fimp.vv[hr_e]
            ty_func_begin(tt)
            ty_func_param(tt, ty_class(tt, ctx_s))
            return ty_func_end(tt, ty_class(tt, hr_s))
        return 3
    if sref_eq(a, cv, "__nox_reflect_decorator_arg") or sref_eq(a, cv, "__nox_reflect_decorator_arg_kind") or sref_eq(a, cv, "__nox_reflect_decorator_arg_int") or sref_eq(a, cv, "__nox_reflect_decorator_arg_bool") or sref_eq(a, cv, "__nox_reflect_decorator_arg_list_len"):
        if n != 2:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes exactly 2 arguments (i: int, j: int)")
            raise mk_fail(ck, "ArgumentCountMismatch")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            mp(ck, "argument 1 (i) of '")
            mp_sref(ck, a, cv)
            mp(ck, "' must be an int")
            raise mk_fail(ck, "TypeMismatch")
        if check_expr(ck, a, fx, stmt_at(a, args, 1)) != 0:
            mp(ck, "argument 2 (j) of '")
            mp_sref(ck, a, cv)
            mp(ck, "' must be an int")
            raise mk_fail(ck, "TypeMismatch")
        if sref_eq(a, cv, "__nox_reflect_decorator_arg"):
            return 3
        if sref_eq(a, cv, "__nox_reflect_decorator_arg_bool"):
            return 2
        return 0
    if sref_eq(a, cv, "__nox_reflect_decorator_arg_list_item"):
        if n != 3:
            fail2(ck, "ArgumentCountMismatch", "'__nox_reflect_decorator_arg_list_item' takes exactly 3 arguments (i: int, j: int, k: int)")
        if check_expr(ck, a, fx, stmt_at(a, args, 0)) != 0:
            fail2(ck, "TypeMismatch", "argument 1 (i) of '__nox_reflect_decorator_arg_list_item' must be an int")
        if check_expr(ck, a, fx, stmt_at(a, args, 1)) != 0:
            fail2(ck, "TypeMismatch", "argument 2 (j) of '__nox_reflect_decorator_arg_list_item' must be an int")
        if check_expr(ck, a, fx, stmt_at(a, args, 2)) != 0:
            fail2(ck, "TypeMismatch", "argument 3 (k) of '__nox_reflect_decorator_arg_list_item' must be an int")
        return 3
    m_argc: int = -1
    m_ret: int = 0
    if sref_eq(a, cv, "__nox_reflect_class_count"):
        m_argc = 0
    elif sref_eq(a, cv, "__nox_reflect_decorator_param_count") or sref_eq(a, cv, "__nox_reflect_decorator_kind") or sref_eq(a, cv, "__nox_reflect_class_init_param_count"):
        m_argc = 1
    elif sref_eq(a, cv, "__nox_reflect_decorator_return_type") or sref_eq(a, cv, "__nox_reflect_decorator_owner") or sref_eq(a, cv, "__nox_reflect_class_name"):
        m_argc = 1
        m_ret = 3
    elif sref_eq(a, cv, "__nox_reflect_decorator_param_name") or sref_eq(a, cv, "__nox_reflect_decorator_param_type") or sref_eq(a, cv, "__nox_reflect_class_init_param_name") or sref_eq(a, cv, "__nox_reflect_class_init_param_type"):
        m_argc = 2
        m_ret = 3
    if m_argc >= 0:
        if n != m_argc:
            mp(ck, "'")
            mp_sref(ck, a, cv)
            mp(ck, "' takes exactly ")
            mp_int(ck, m_argc)
            mp(ck, " arguments")
            raise mk_fail(ck, "ArgumentCountMismatch")
        for mi in range(n):
            if check_expr(ck, a, fx, stmt_at(a, args, mi)) != 0:
                mp(ck, "'")
                mp_sref(ck, a, cv)
                mp(ck, "' argument ")
                mp_int(ck, mi + 1)
                mp(ck, " must be an int")
                raise mk_fail(ck, "TypeMismatch")
        return m_ret
    return -1

# Zig'de ayrı yolu olan (ptr/lowlevel ailesi, dahili `__nox_*` kapıları) ama bu dilimde taşınmayan ad: kapsam dışı etiketi; "" = yok.
def call_gap_label(ck: Ck, a: Ast, cv: int, fi: int, gfi: int, ci: int) -> str:
    if sref_eq(a, cv, "__nox_match_check") or sref_eq(a, cv, "__nox_payload") or sref_eq(a, cv, "__nox_match_unreachable"):
        return "check_call#internal"
    return ""

def index_expr_to_type_expr(ck: Ck, a: Ast, e: int) -> int:
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        return mk_TypeExpr_simple(a, a.n[e + 1], a.n[e + 2])
    if tag == {{T:Expr.none_lit}}:
        nsr: int = syn(a, "None")
        return mk_TypeExpr_simple(a, pkx(nsr), pky(nsr))
    if tag == {{T:Expr.attribute}}:
        segs: list[int] = []
        if not flatten_dotted(ck, a, e, segs) or len(segs) < 2:
            return -1
        st: int = len(a.l)
        for i in range(len(segs)):
            sr: int = ast_str_sym(ck, a, segs[i])
            a.l.append(pkx(sr))
            a.l.append(pky(sr))
        return mk_TypeExpr_qualified(a, st, len(segs))
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        inner: int = index_expr_to_type_expr(ck, a, a.n[ix + {{O:Index.index}}])
        if inner < 0:
            return -1
        arg_ids: list[int] = [inner]
        asl: int = list_put_slice(a, arg_ids)
        obj: int = a.n[ix + {{O:Index.obj}}]
        if a.n[obj] == {{T:Expr.identifier}}:
            return mk_TypeExpr_generic(a, mk_Generic(a, a.n[obj + 1], a.n[obj + 2], pkx(asl), pky(asl)))
        if a.n[obj] == {{T:Expr.attribute}}:
            qsegs: list[int] = []
            if not flatten_dotted(ck, a, obj, qsegs) or len(qsegs) < 2:
                return -1
            qsr: int = ast_str_sym(ck, a, join_syms(ck, qsegs, len(qsegs), 46))
            return mk_TypeExpr_generic(a, mk_Generic(a, pkx(qsr), pky(qsr), pkx(asl), pky(asl)))
        return -1
    return -1

def try_qual_generic_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    ix: int = a.n[callee + 1]
    obj: int = a.n[ix + {{O:Index.obj}}]
    if a.n[obj] != {{T:Expr.attribute}}:
        return -1
    raw: list[int] = []
    if not flatten_dotted(ck, a, obj, raw) or len(raw) < 2:
        return -1
    if is_variable_in_scope(ck, fx, raw[0]):
        return -1
    segs: list[int] = subst_alias(ck, raw)
    n: int = len(segs)
    mod: int = join_syms(ck, segs, n - 1, 46)
    if m2_get(ck.imod, 0, mod) < 0:
        return -1
    mangled: int = join_syms(ck, segs, n, 95)
    ge: int = m2_get(ck.gcls, 0, mangled)
    gfe: int = m2_get(ck.gfn, 0, mangled)
    if ge < 0 and gfe < 0:
        return -1
    te: int = index_expr_to_type_expr(ck, a, a.n[ix + {{O:Index.index}}])
    if te < 0:
        return -1
    t: int = type_expr_to_type(ck, a, te)
    bnd: list[int] = [t]
    if gfe >= 0:
        gfd: int = ck.gfn.vv[gfe]
        gf_tps: int = sl_at(a, gfd, {{O:FuncDef.type_params}})
        gf_ntp: int = pky(gf_tps)
        if gf_ntp != 1:
            mp(ck, "'")
            mp_sym(ck, mangled)
            mp(ck, "' takes ")
            mp_int(ck, gf_ntp)
            mp(ck, " type argument(s), 1 given")
            raise mk_fail(ck, "ArgumentCountMismatch")
        cargs: int = sl_at(a, c, {{O:Call.args}})
        gf_ps: int = sl_at(a, gfd, {{O:FuncDef.params}})
        gf_needs_exp: bool = pky(cargs) < pky(gf_ps)
        for ci2 in range(pky(cargs)):
            if a.n[stmt_at(a, cargs, ci2)] == {{T:Expr.kwarg}}:
                gf_needs_exp = True
        if not gf_needs_exp:
            for pi2 in range(pky(gf_ps)):
                if a.n[stmt_at(a, gf_ps, pi2) + {{O:Param.variadic}}] != 0 or a.n[stmt_at(a, gf_ps, pi2) + {{O:Param.var_kw}}] != 0:
                    gf_needs_exp = True
        if gf_needs_exp:
            mp(ck, "a call with explicit type arguments ('")
            mp_sym(ck, mangled)
            mp(ck, "[...]') must pass every argument positionally (no defaults, keywords or *args)")
            raise mk_fail(ck, "ArgumentCountMismatch")
        return instantiate_generic_func(ck, a, fx, gfd, mangled, cargs, bnd, True)
    ct: int = instantiate_generic_class(ck, a, ck.gcls.vv[ge], bnd)
    msym: int = ck.tt.xa[ct]
    ci: int = class_idx(ck, msym)
    isid: int = ck.cls_init[ci]
    if isid < 0:
        isid = ck.sig_empty
    check_args_slice(ck, a, fx, sl_at(a, c, {{O:Call.args}}), isid, mangled, False)
    return ct

def generic_enum_name(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    if ck.gcls.live == 0:
        return -1
    if a.n[e] == {{T:Expr.identifier}}:
        nm: int = sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2]))
        if sc_lookup(ck, fx.scope, nm) >= 0 or m2_get(ck.globs, 0, nm) >= 0:
            return -1
        ge: int = m2_get(ck.gcls, 0, nm)
        if ge >= 0 and pky(sl_at(a, ck.gcls.vv[ge], {{O:ClassDef.enum_variants}})) > 0:
            return nm
        fe: int = m2_get(ck.fimp, 0, nm)
        if fe >= 0:
            ge2: int = m2_get(ck.gcls, 0, ck.fimp.vv[fe])
            if ge2 >= 0 and pky(sl_at(a, ck.gcls.vv[ge2], {{O:ClassDef.enum_variants}})) > 0:
                return ck.fimp.vv[fe]
        return -1
    if a.n[e] != {{T:Expr.attribute}}:
        return -1
    raw: list[int] = []
    if not flatten_dotted(ck, a, e, raw) or len(raw) < 2:
        return -1
    if sc_lookup(ck, fx.scope, raw[0]) >= 0 or m2_get(ck.globs, 0, raw[0]) >= 0:
        return -1
    segs: list[int] = subst_alias(ck, raw)
    mod: int = join_syms(ck, segs, len(segs) - 1, 46)
    if m2_get(ck.imod, 0, mod) < 0:
        return -1
    mangled: int = join_syms(ck, segs, len(segs), 95)
    ge3: int = m2_get(ck.gcls, 0, mangled)
    if ge3 >= 0 and pky(sl_at(a, ck.gcls.vv[ge3], {{O:ClassDef.enum_variants}})) > 0:
        return mangled
    return -1

def try_generic_enum_expected(ck: Ck, a: Ast, fx: Fx, e: int, expected: int) -> int:
    exp_sym: int = ck.tt.xa[expected]
    oe: int = m2_get(ck.generic_origin, 0, exp_sym)
    if oe < 0:
        return -1
    origin: int = ck.generic_origin.vv[oe]
    obj_e: int = -1
    vsr: int = 0
    cargs: int = -1
    tag: int = a.n[e]
    if tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        cal: int = a.n[cp + {{O:Call.callee}}]
        if a.n[cal] != {{T:Expr.attribute}}:
            return -1
        at: int = a.n[cal + 1]
        obj_e = a.n[at + {{O:Attribute.obj}}]
        vsr = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
        cargs = sl_at(a, cp, {{O:Call.args}})
    elif tag == {{T:Expr.attribute}}:
        at2: int = a.n[e + 1]
        obj_e = a.n[at2 + {{O:Attribute.obj}}]
        vsr = pk(a.n[at2 + {{O:Attribute.attr}}], a.n[at2 + {{O:Attribute.attr}} + 1])
    else:
        return -1
    ename: int = generic_enum_name(ck, a, fx, obj_e)
    if ename != origin:
        return -1
    gcd: int = ck.gcls.vv[m2_get(ck.gcls, 0, ename)]
    ev: int = find_enum_variant(a, gcd, vsr)
    if ev < 0:
        return -1
    if tag == {{T:Expr.attribute}} and pky(sl_at(a, ev, {{O:EnumVariant.fields}})) != 0:
        return -1
    eci: int = class_idx(ck, exp_sym)
    if eci < 0:
        return -1
    targs: list[int] = []
    for ti in range(ck.gcls_tn[eci]):
        targs.append(ck.gcls_te[ck.gcls_ts[eci] + ti])
    fn_sym: int = sym_lit(ck, sym_to_str(ck, ename) + "__" + sref_str(a, vsr))
    gfe: int = m2_get(ck.gfn, 0, fn_sym)
    if gfe < 0:
        return -1
    if cargs < 0:
        esl: int = list_put_slice(a, [])
        cargs = esl
    return instantiate_generic_func(ck, a, fx, ck.gfn.vv[gfe], fn_sym, cargs, targs, True)

def try_resolve_generic_enum_call(ck: Ck, a: Ast, fx: Fx, c: int) -> None:
    cal: int = a.n[c + {{O:Call.callee}}]
    if a.n[cal] != {{T:Expr.attribute}}:
        return
    at: int = a.n[cal + 1]
    ename: int = generic_enum_name(ck, a, fx, a.n[at + {{O:Attribute.obj}}])
    if ename < 0:
        return
    gcd: int = ck.gcls.vv[m2_get(ck.gcls, 0, ename)]
    vsr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    if find_enum_variant(a, gcd, vsr) < 0:
        mp(ck, "enum '")
        mp_sym(ck, ename)
        mp(ck, "' has no variant '")
        mp_sref(ck, a, vsr)
        mp(ck, "'")
        raise mk_fail(ck, "UndefinedAttribute")
    fsr: int = ast_str_sym(ck, a, sym_lit(ck, sym_to_str(ck, ename) + "__" + sref_str(a, vsr)))
    a.n[c + {{O:Call.callee}}] = mk_Expr_identifier(a, pkx(fsr), pky(fsr))

def ensure_static_inst(ck: Ck, a: Ast, owner_sym: int, recv_sym: int, msym: int, fd: int, is_cls: bool) -> int:
    mstr: str = ("__cls_" + sym_to_str(ck, recv_sym) if is_cls else "__static_" + sym_to_str(ck, owner_sym)) + "_" + sym_to_str(ck, msym)
    msym_out: int = sym_lit(ck, mstr)
    if m2_get(ck.fmap, 0, msym_out) >= 0:
        return msym_out
    msr: int = ast_str_sym(ck, a, msym_out)
    empty_bnd: Map2 = Map2()
    nb: int = subst_stmts(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), empty_bnd)
    conc: int = mk_FuncDef(a, pkx(msr), pky(msr), 0, 0, a.n[fd + {{O:FuncDef.params}}], a.n[fd + {{O:FuncDef.params}} + 1], a.n[fd + {{O:FuncDef.return_type}}], a.n[fd + {{O:FuncDef.ret_omitted}}], pkx(nb), pky(nb), a.n[fd + {{O:FuncDef.is_async}}], 0, 0, {{NONE}}, 0, 0, 0, 0, 0, a.n[fd + {{O:FuncDef.allow_await}}], a.n[fd + {{O:FuncDef.line}}])
    register_func(ck, a, conc)
    if is_cls:
        m2_put(ck.cls_alias_by_fn, 0, msym_out, recv_sym)
    sv_cl: int = ck.cur_line
    sv_cs: int = ck.cur_span
    try:
        check_function_body(ck, a, conc)
    finally:
        ck.cur_line = sv_cl
        ck.cur_span = sv_cs
    return msym_out

def try_resolve_static_method_call(ck: Ck, a: Ast, fx: Fx, c: int) -> None:
    if ck.static_names.live == 0:
        return
    cal: int = a.n[c + {{O:Call.callee}}]
    if a.n[cal] != {{T:Expr.attribute}}:
        return
    at: int = a.n[cal + 1]
    attr_sr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    asym: int = sym_of(ck, a, attr_sr)
    if m2_get(ck.static_names, 0, asym) < 0:
        return
    obj: int = a.n[at + {{O:Attribute.obj}}]
    if a.n[obj] == {{T:Expr.call}}:
        oc: int = a.n[a.n[obj + 1] + {{O:Call.callee}}]
        if a.n[oc] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[oc + 1], a.n[oc + 2]), "super"):
            return
    recv_ci: int = receiver_class_name(ck, a, fx, obj)
    recv_eff: bool = False
    if recv_ci < 0:
        ot: int = check_expr(ck, a, fx, obj)
        if ck.tt.tag[ot] != 6:
            return
        recv_ci = class_idx_of_type(ck, ot)
        if recv_ci < 0:
            return
        recv_eff = expr_has_effects(a, obj)
    recv_sym: int = ck.cls_sym[recv_ci]
    cur: int = recv_ci
    while cur >= 0:
        csym: int = ck.cls_sym[cur]
        se: int = m2_get(ck.static_meths, csym, asym)
        if se >= 0:
            if recv_eff:
                mp(ck, "call the static/class method '")
                mp_sref(ck, a, attr_sr)
                mp(ck, "' through the class name ('")
                mp_sym(ck, recv_sym)
                mp(ck, ".")
                mp_sref(ck, a, attr_sr)
                mp(ck, "(...)'): the receiver expression has side effects and would not be evaluated")
                raise mk_fail(ck, "TypeMismatch")
            fd: int = ck.static_meths.vv[se]
            owner_sym: int = ck.static_owner.vv[m2_get(ck.static_owner, csym, asym)]
            is_cls: bool = ck.static_is_cls.vv[m2_get(ck.static_is_cls, csym, asym)] != 0
            mangled: int = ensure_static_inst(ck, a, owner_sym, recv_sym, asym, fd, is_cls)
            msr: int = ast_str_sym(ck, a, mangled)
            a.n[c + {{O:Call.callee}}] = mk_Expr_identifier(a, pkx(msr), pky(msr))
            return
        bsym: int = ck.cls_base[cur]
        cur = class_idx(ck, bsym) if bsym >= 0 else -1

class MPat:
    wild: bool
    lit: bool
    name: str
    has_args: bool
    kws: list[str]
    args: list[int]

    def __init__(self) -> None:
        self.wild = False
        self.lit = False
        self.name = ""
        self.has_args = False
        self.kws = []
        self.args = []

def parse_mpat(src: str, pos: list[int], pool: list[MPat]) -> int:
    idx: int = len(pool)
    node: MPat = MPat()
    pool.append(node)
    n: int = len(src)
    if pos[0] < n and src[pos[0]] == "_":
        pos[0] = pos[0] + 1
        node.wild = True
        return idx
    if pos[0] < n and src[pos[0]] == "#":
        pos[0] = pos[0] + 1
        node.lit = True
        return idx
    st: int = pos[0]
    while pos[0] < n and src[pos[0]] != "(" and src[pos[0]] != "," and src[pos[0]] != ")" and src[pos[0]] != "=":
        pos[0] = pos[0] + 1
    node.name = src[st:pos[0]]
    if pos[0] < n and src[pos[0]] == "(":
        pos[0] = pos[0] + 1
        node.has_args = True
        while pos[0] < n and src[pos[0]] != ")":
            kw: str = ""
            q: int = pos[0]
            while q < n and src[q] != "(" and src[q] != "," and src[q] != ")" and src[q] != "=":
                q = q + 1
            if q < n and src[q] == "=":
                kw = src[pos[0]:q]
                pos[0] = q + 1
            node.kws.append(kw)
            node.args.append(parse_mpat(src, pos, pool))
            if pos[0] < n and src[pos[0]] == ",":
                pos[0] = pos[0] + 1
        if pos[0] < n and src[pos[0]] == ")":
            pos[0] = pos[0] + 1
    return idx

def mpat_columns(a: Ast, pat_id: int, ev: int, pool: list[MPat]) -> list[int]:
    vfs: int = sl_at(a, ev, {{O:EnumVariant.fields}})
    nf: int = pky(vfs)
    wild_id: int = len(pool)
    wn: MPat = MPat()
    wn.wild = True
    pool.append(wn)
    cols: list[int] = []
    for _i in range(nf):
        cols.append(wild_id)
    pat: MPat = pool[pat_id]
    if not pat.has_args:
        return cols
    for i in range(len(pat.args)):
        kw: str = pat.kws[i]
        idx: int = i if len(kw) == 0 and i < nf else -1
        if len(kw) > 0:
            for j in range(nf):
                fd: int = stmt_at(a, vfs, j)
                if sref_str(a, pk(a.n[fd + {{O:FieldDecl.name}}], a.n[fd + {{O:FieldDecl.name}} + 1])) == kw:
                    idx = j
                    break
        if idx >= 0:
            cols[idx] = pat.args[i]
    return cols

def enum_cd_of_class(ck: Ck, a: Ast, csym: int) -> int:
    ci: int = class_idx(ck, csym)
    if ci >= 0:
        cd: int = ck.cls_node[ci]
        if pky(sl_at(a, cd, {{O:ClassDef.enum_variants}})) > 0:
            return cd
    oe: int = m2_get(ck.generic_origin, 0, csym)
    if oe >= 0:
        ge: int = m2_get(ck.gcls, 0, ck.generic_origin.vv[oe])
        if ge >= 0:
            gcd: int = ck.gcls.vv[ge]
            if pky(sl_at(a, gcd, {{O:ClassDef.enum_variants}})) > 0:
                return gcd
    return -1

def matrix_exhaustive(ck: Ck, a: Ast, rows: list[list[int]], col_types: list[int], pool: list[MPat]) -> bool:
    if len(rows) == 0:
        return False
    if len(col_types) == 0:
        return True
    t0: int = col_types[0]
    ecd: int = -1
    if t0 >= 0 and ck.tt.tag[t0] == 6:
        ecd = enum_cd_of_class(ck, a, ck.tt.xa[t0])
    if ecd >= 0:
        cname: int = ck.tt.xa[t0]
        cci: int = class_idx(ck, cname)
        evs: int = sl_at(a, ecd, {{O:ClassDef.enum_variants}})
        for vi in range(pky(evs)):
            ev: int = stmt_at(a, evs, vi)
            vnm: str = sref_str(a, pk(a.n[ev + {{O:EnumVariant.name}}], a.n[ev + {{O:EnumVariant.name}} + 1]))
            vfs: int = sl_at(a, ev, {{O:EnumVariant.fields}})
            spec: list[list[int]] = []
            for ri in range(len(rows)):
                r: list[int] = rows[ri]
                hd: MPat = pool[r[0]]
                cols: list[int] = []
                if hd.wild:
                    wild_id: int = len(pool)
                    wn: MPat = MPat()
                    wn.wild = True
                    pool.append(wn)
                    for _fi in range(pky(vfs)):
                        cols.append(wild_id)
                elif not hd.lit and hd.name == vnm:
                    cols = mpat_columns(a, r[0], ev, pool)
                else:
                    continue
                for rk in range(1, len(r)):
                    cols.append(r[rk])
                spec.append(cols)
            nt: list[int] = []
            for fi2 in range(pky(vfs)):
                fd2: int = stmt_at(a, vfs, fi2)
                fnm2: str = sref_str(a, pk(a.n[fd2 + {{O:FieldDecl.name}}], a.n[fd2 + {{O:FieldDecl.name}} + 1]))
                ft_id: int = -1
                if cci >= 0:
                    fe: int = m2_get(ck.cls_fields, cci, sym_lit(ck, "_" + vnm + "_" + fnm2))
                    if fe >= 0:
                        ft_id = ck.cls_fields.vv[fe]
                nt.append(ft_id)
            for ci2 in range(1, len(col_types)):
                nt.append(col_types[ci2])
            if not matrix_exhaustive(ck, a, spec, nt, pool):
                return False
        return True
    rest: list[list[int]] = []
    for ri2 in range(len(rows)):
        r2: list[int] = rows[ri2]
        if pool[r2[0]].wild:
            nr: list[int] = []
            for rk2 in range(1, len(r2)):
                nr.append(r2[rk2])
            rest.append(nr)
    nt2: list[int] = []
    for ci3 in range(1, len(col_types)):
        nt2.append(col_types[ci3])
    return matrix_exhaustive(ck, a, rest, nt2, pool)

def enum_def_of(ck: Ck, a: Ast, fx: Fx, subj: int, enum_e: int, what: str) -> int:
    gnm: int = generic_enum_name(ck, a, fx, enum_e)
    if gnm >= 0:
        gcd: int = ck.gcls.vv[m2_get(ck.gcls, 0, gnm)]
        gst: int = check_expr(ck, a, fx, subj)
        if ck.tt.tag[gst] != 6:
            mp(ck, "match subject must be an enum value of '")
            mp_sym(ck, gnm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        gs: int = ck.tt.xa[gst]
        oe: int = m2_get(ck.generic_origin, 0, gs)
        if oe < 0 or ck.generic_origin.vv[oe] != gnm:
            mp(ck, "match subject has type '")
            mp_sym(ck, gs)
            mp(ck, "' but the pattern belongs to enum '")
            mp_sym(ck, gnm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        return gcd
    eci: int = receiver_class_name(ck, a, fx, enum_e)
    if eci < 0:
        mp(ck, what)
        mp(ck, ": the pattern's enum is not a known class")
        raise mk_fail(ck, "UndefinedClass")
    esym: int = ck.cls_sym[eci]
    cd: int = ck.cls_node[eci]
    if pky(sl_at(a, cd, {{O:ClassDef.enum_variants}})) == 0:
        mp(ck, what)
        mp(ck, ": '")
        mp_sym(ck, esym)
        mp(ck, "' is a class, not an enum")
        raise mk_fail(ck, "TypeMismatch")
    st: int = check_expr(ck, a, fx, subj)
    if ck.tt.tag[st] != 6:
        mp(ck, "match subject must be an enum value of '")
        mp_sym(ck, esym)
        mp(ck, "'")
        raise mk_fail(ck, "TypeMismatch")
    if ck.tt.xa[st] != esym:
        mp(ck, "match subject has type '")
        mp_sym(ck, ck.tt.xa[st])
        mp(ck, "' but the pattern belongs to enum '")
        mp_sym(ck, esym)
        mp(ck, "'")
        raise mk_fail(ck, "TypeMismatch")
    return cd

def try_enum_intrinsic(ck: Ck, a: Ast, fx: Fx, c: int, cv: int) -> int:
    if not sref_eq(a, cv, "__nox_match_check") and not sref_eq(a, cv, "__nox_payload") and not sref_eq(a, cv, "__nox_match_unreachable"):
        return -1
    cargs: int = sl_at(a, c, {{O:Call.args}})
    nargs: int = pky(cargs)
    if sref_eq(a, cv, "__nox_match_check"):
        if nargs != 4 or a.n[stmt_at(a, cargs, 2)] != {{T:Expr.string_lit}} or a.n[stmt_at(a, cargs, 3)] != {{T:Expr.int_lit}}:
            return -1
        cd: int = enum_def_of(ck, a, fx, stmt_at(a, cargs, 0), stmt_at(a, cargs, 1), "case pattern")
        vsr: int = pk(a.n[stmt_at(a, cargs, 2) + 1], a.n[stmt_at(a, cargs, 2) + 2])
        ev: int = find_enum_variant(a, cd, vsr)
        if ev < 0:
            mp(ck, "enum '")
            mp_sref(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
            mp(ck, "' has no variant '")
            mp_sref(ck, a, vsr)
            mp(ck, "'")
            raise mk_fail(ck, "UndefinedAttribute")
        n: int = a.n[stmt_at(a, cargs, 3) + 1]
        nf: int = pky(sl_at(a, ev, {{O:EnumVariant.fields}}))
        if n >= 0 and n != nf:
            mp(ck, "variant '")
            mp_sref(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
            mp(ck, ".")
            mp_sref(ck, a, vsr)
            mp(ck, "' has ")
            mp_int(ck, nf)
            mp(ck, " field(s), the pattern binds ")
            mp_int(ck, n)
            mp(ck, " (use `_` to ignore a field)")
            raise mk_fail(ck, "ArgumentCountMismatch")
        return 0
    if sref_eq(a, cv, "__nox_payload"):
        if nargs != 5 or a.n[stmt_at(a, cargs, 2)] != {{T:Expr.string_lit}} or a.n[stmt_at(a, cargs, 3)] != {{T:Expr.int_lit}} or a.n[stmt_at(a, cargs, 4)] != {{T:Expr.string_lit}}:
            return -1
        cd2: int = enum_def_of(ck, a, fx, stmt_at(a, cargs, 0), stmt_at(a, cargs, 1), "case pattern")
        vsr2: int = pk(a.n[stmt_at(a, cargs, 2) + 1], a.n[stmt_at(a, cargs, 2) + 2])
        ev2: int = find_enum_variant(a, cd2, vsr2)
        if ev2 < 0:
            mp(ck, "enum '")
            mp_sref(ck, a, pk(a.n[cd2 + {{O:ClassDef.name}}], a.n[cd2 + {{O:ClassDef.name}} + 1]))
            mp(ck, "' has no variant '")
            mp_sref(ck, a, vsr2)
            mp(ck, "'")
            raise mk_fail(ck, "UndefinedAttribute")
        idx: int = a.n[stmt_at(a, cargs, 3) + 1]
        vfs2: int = sl_at(a, ev2, {{O:EnumVariant.fields}})
        fld: int = -1
        if idx >= 0:
            if idx < pky(vfs2):
                fld = stmt_at(a, vfs2, idx)
        else:
            fsr: int = pk(a.n[stmt_at(a, cargs, 4) + 1], a.n[stmt_at(a, cargs, 4) + 2])
            for fi in range(pky(vfs2)):
                f0: int = stmt_at(a, vfs2, fi)
                if sref_eq_ref(a, pk(a.n[f0 + {{O:FieldDecl.name}}], a.n[f0 + {{O:FieldDecl.name}} + 1]), fsr):
                    fld = f0
                    break
        if fld < 0:
            mp(ck, "variant '")
            mp_sref(ck, a, pk(a.n[cd2 + {{O:ClassDef.name}}], a.n[cd2 + {{O:ClassDef.name}} + 1]))
            mp(ck, ".")
            mp_sref(ck, a, vsr2)
            mp(ck, "' has no field '")
            mp_sref(ck, a, pk(a.n[stmt_at(a, cargs, 4) + 1], a.n[stmt_at(a, cargs, 4) + 2]))
            mp(ck, "'")
            raise mk_fail(ck, "UndefinedAttribute")
        slot_sr: int = syn(a, "_" + sref_str(a, vsr2) + "_" + sref_str(a, pk(a.n[fld + {{O:FieldDecl.name}}], a.n[fld + {{O:FieldDecl.name}} + 1])))
        return check_expr(ck, a, fx, mk_Expr_attribute(a, mk_Attribute(a, stmt_at(a, cargs, 0), pkx(slot_sr), pky(slot_sr))))
    if nargs != 3 or a.n[stmt_at(a, cargs, 2)] != {{T:Expr.string_lit}}:
        return -1
    cd3: int = enum_def_of(ck, a, fx, stmt_at(a, cargs, 0), stmt_at(a, cargs, 1), "match")
    subj_t: int = check_expr(ck, a, fx, stmt_at(a, cargs, 0))
    subj_ci: int = class_idx_of_type(ck, subj_t) if ck.tt.tag[subj_t] == 6 else -1
    enc: str = sref_str(a, pk(a.n[stmt_at(a, cargs, 2) + 1], a.n[stmt_at(a, cargs, 2) + 2]))
    pool: list[MPat] = []
    rows: list[int] = []
    if len(enc) > 0:
        st_p: int = 0
        for i in range(len(enc) + 1):
            if i == len(enc) or enc[i] == ";":
                pos: list[int] = [0]
                rows.append(parse_mpat(enc[st_p:i], pos, pool))
                st_p = i + 1
    missing: list[str] = []
    partial: list[str] = []
    evs3: int = sl_at(a, cd3, {{O:ClassDef.enum_variants}})
    for vi in range(pky(evs3)):
        ev3: int = stmt_at(a, evs3, vi)
        vnm3: str = sref_str(a, pk(a.n[ev3 + {{O:EnumVariant.name}}], a.n[ev3 + {{O:EnumVariant.name}} + 1]))
        has_row: bool = False
        spec_rows: list[list[int]] = []
        for ri in range(len(rows)):
            if pool[rows[ri]].name == vnm3:
                has_row = True
                spec_rows.append(mpat_columns(a, rows[ri], ev3, pool))
        if not has_row:
            missing.append(vnm3)
            continue
        vfs3: int = sl_at(a, ev3, {{O:EnumVariant.fields}})
        vtypes: list[int] = []
        for fi3 in range(pky(vfs3)):
            fd3: int = stmt_at(a, vfs3, fi3)
            fnm3: str = sref_str(a, pk(a.n[fd3 + {{O:FieldDecl.name}}], a.n[fd3 + {{O:FieldDecl.name}} + 1]))
            ft3: int = -1
            if subj_ci >= 0:
                fe3: int = m2_get(ck.cls_fields, subj_ci, sym_lit(ck, "_" + vnm3 + "_" + fnm3))
                if fe3 >= 0:
                    ft3 = ck.cls_fields.vv[fe3]
            vtypes.append(ft3)
        if not matrix_exhaustive(ck, a, spec_rows, vtypes, pool):
            partial.append(vnm3)
    if len(missing) > 0:
        mp(ck, "non-exhaustive match on enum '")
        mp_sref(ck, a, pk(a.n[cd3 + {{O:ClassDef.name}}], a.n[cd3 + {{O:ClassDef.name}} + 1]))
        mp(ck, "': missing variant(s) ")
        for mi in range(len(missing)):
            if mi > 0:
                mp(ck, ", ")
            mp(ck, missing[mi])
        mp(ck, " (add the missing case(s) or a `case _:`)")
        raise mk_fail(ck, "TypeMismatch")
    if len(partial) > 0:
        mp(ck, "non-exhaustive match on enum '")
        mp_sref(ck, a, pk(a.n[cd3 + {{O:ClassDef.name}}], a.n[cd3 + {{O:ClassDef.name}} + 1]))
        mp(ck, "': variant(s) ")
        for pi in range(len(partial)):
            if pi > 0:
                mp(ck, ", ")
            mp(ck, partial[pi])
        mp(ck, " are only partly covered (a literal, nested pattern or guard can fail; add a plain case for them or a `case _:`)")
        raise mk_fail(ck, "TypeMismatch")
    return 0

def rn_expr(a: Ast, e: int, from_s: str, to_sr: int) -> None:
    if e < 0:
        return
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        if sref_eq(a, pk(a.n[e + 1], a.n[e + 2]), from_s):
            a.n[e + 1] = pkx(to_sr)
            a.n[e + 2] = pky(to_sr)
        return
    if tag < {{T:Expr.identifier}}:
        return
    if tag == {{T:Expr.unary}}:
        rn_expr(a, a.n[a.n[e + 1] + {{O:Unary.operand}}], from_s, to_sr)
    elif tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        rn_expr(a, a.n[bp + {{O:Binary.left}}], from_s, to_sr)
        rn_expr(a, a.n[bp + {{O:Binary.right}}], from_s, to_sr)
    elif tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        rn_expr(a, a.n[cp + {{O:Call.callee}}], from_s, to_sr)
        cas: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cas)):
            rn_expr(a, stmt_at(a, cas, i), from_s, to_sr)
    elif tag == {{T:Expr.attribute}}:
        rn_expr(a, a.n[a.n[e + 1] + {{O:Attribute.obj}}], from_s, to_sr)
    elif tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        rn_expr(a, a.n[ip + {{O:Index.obj}}], from_s, to_sr)
        rn_expr(a, a.n[ip + {{O:Index.index}}], from_s, to_sr)
    elif tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, e, 1)
        for i2 in range(pky(el)):
            rn_expr(a, stmt_at(a, el, i2), from_s, to_sr)
    elif tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, e, 1)
        for i3 in range(pky(dl)):
            dp: int = a.l[pkx(dl) + i3]
            rn_expr(a, a.n[dp + {{O:DictPair.key}}], from_s, to_sr)
            rn_expr(a, a.n[dp + {{O:DictPair.value}}], from_s, to_sr)
    elif tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        rn_expr(a, a.n[e + 1], from_s, to_sr)
    elif tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        rn_expr(a, a.n[tp + {{O:Ternary.cond}}], from_s, to_sr)
        rn_expr(a, a.n[tp + {{O:Ternary.then_expr}}], from_s, to_sr)
        rn_expr(a, a.n[tp + {{O:Ternary.else_expr}}], from_s, to_sr)
    elif tag == {{T:Expr.kwarg}}:
        rn_expr(a, a.n[a.n[e + 1] + {{O:Kwarg.value}}], from_s, to_sr)
    elif tag == {{T:Expr.slice}}:
        sp: int = a.n[e + 1]
        rn_expr(a, a.n[sp + {{O:Slice.obj}}], from_s, to_sr)
        rn_expr(a, a.n[sp + {{O:Slice.lo}}], from_s, to_sr)
        rn_expr(a, a.n[sp + {{O:Slice.hi}}], from_s, to_sr)
        rn_expr(a, a.n[sp + {{O:Slice.step}}], from_s, to_sr)
    elif tag == {{T:Expr.lambda}}:
        rn_expr(a, a.n[a.n[e + 1] + {{O:Lambda.body}}], from_s, to_sr)

def rn_stmts(a: Ast, body: int, from_s: str, to_sr: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            rn_expr(a, pay, from_s, to_sr)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                rn_expr(a, pay, from_s, to_sr)
        elif tag == {{T:StmtKind.var_decl}}:
            if sref_eq(a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1]), from_s):
                a.n[pay + {{O:VarDecl.name}}] = pkx(to_sr)
                a.n[pay + {{O:VarDecl.name}} + 1] = pky(to_sr)
            rn_expr(a, a.n[pay + {{O:VarDecl.value}}], from_s, to_sr)
        elif tag == {{T:StmtKind.assign}}:
            rn_expr(a, a.n[pay + {{O:Assign.target}}], from_s, to_sr)
            rn_expr(a, a.n[pay + {{O:Assign.value}}], from_s, to_sr)
        elif tag == {{T:StmtKind.if_stmt}}:
            rn_expr(a, a.n[pay + {{O:IfStmt.cond}}], from_s, to_sr)
            rn_stmts(a, sl_at(a, pay, {{O:IfStmt.then_body}}), from_s, to_sr)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                ec: int = stmt_at(a, ecs, ei)
                rn_expr(a, a.n[ec + {{O:ElifClause.cond}}], from_s, to_sr)
                rn_stmts(a, sl_at(a, ec, {{O:ElifClause.body}}), from_s, to_sr)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                rn_stmts(a, sl_at(a, pay, {{O:IfStmt.else_body}}), from_s, to_sr)
        elif tag == {{T:StmtKind.while_stmt}}:
            rn_expr(a, a.n[pay + {{O:WhileStmt.cond}}], from_s, to_sr)
            rn_stmts(a, sl_at(a, pay, {{O:WhileStmt.body}}), from_s, to_sr)
        elif tag == {{T:StmtKind.for_stmt}}:
            rn_expr(a, a.n[pay + {{O:ForStmt.iterable}}], from_s, to_sr)
            rn_stmts(a, sl_at(a, pay, {{O:ForStmt.body}}), from_s, to_sr)

def rename_conflicting_match_bindings(ck: Ck, a: Ast, fx: Fx, st: int, pay: int) -> None:
    mo: int = a.n[pay + {{O:IfStmt.match_origin}}]
    if mo < 0:
        return
    cases: int = sl_at(a, mo, {{O:MatchOrigin.cases}})
    ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
    n_arms: int = 1 + pky(ecs)
    nc: int = pky(cases)
    if nc < n_arms:
        n_arms = nc
    name_arms: Map2 = Map2()
    any_dup: bool = False
    for ai in range(n_arms):
        arm: int = sl_at(a, pay, {{O:IfStmt.then_body}}) if ai == 0 else sl_at(a, stmt_at(a, ecs, ai - 1), {{O:ElifClause.body}})
        mc: int = stmt_at(a, cases, ai)
        pre: int = a.n[mc + {{O:MatchCase.prefix}}]
        if pky(arm) < pre:
            pre = pky(arm)
        for pi in range(pre):
            ps: int = stmt_at(a, arm, pi)
            kn: int = a.n[ps + {{O:Stmt.kind}}]
            if a.n[kn] != {{T:StmtKind.var_decl}}:
                continue
            vp: int = a.n[kn + 1]
            vte: int = a.n[vp + {{O:VarDecl.type_expr}}]
            if not (a.n[vte] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[vte + 1], a.n[vte + 2]), "__infer")):
                continue
            vsym: int = sym_of(ck, a, pk(a.n[vp + {{O:VarDecl.name}}], a.n[vp + {{O:VarDecl.name}} + 1]))
            ne: int = m2_get(name_arms, 0, vsym)
            if ne >= 0:
                if name_arms.vv[ne] != ai:
                    any_dup = True
            else:
                m2_put(name_arms, 0, vsym, ai)
    if not any_dup:
        return
    seen: Map2 = Map2()
    for i in range(n_arms):
        body: int = sl_at(a, pay, {{O:IfStmt.then_body}}) if i == 0 else sl_at(a, stmt_at(a, ecs, i - 1), {{O:ElifClause.body}})
        mc2: int = stmt_at(a, cases, i)
        pre2: int = a.n[mc2 + {{O:MatchCase.prefix}}]
        if pky(body) < pre2:
            pre2 = pky(body)
        for pi2 in range(pre2):
            ps2: int = stmt_at(a, body, pi2)
            kn2: int = a.n[ps2 + {{O:Stmt.kind}}]
            if a.n[kn2] != {{T:StmtKind.var_decl}}:
                continue
            vp2: int = a.n[kn2 + 1]
            vte2: int = a.n[vp2 + {{O:VarDecl.type_expr}}]
            if not (a.n[vte2] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[vte2 + 1], a.n[vte2 + 2]), "__infer")):
                continue
            vsr: int = pk(a.n[vp2 + {{O:VarDecl.name}}], a.n[vp2 + {{O:VarDecl.name}} + 1])
            vsym2: int = sym_of(ck, a, vsr)
            t: int = check_expr(ck, a, fx, a.n[vp2 + {{O:VarDecl.value}}])
            se: int = m2_get(seen, 0, vsym2)
            if se >= 0:
                if seen.vv[se] == t:
                    continue
                new_s: str = sref_str(a, vsr) + "__arm" + str(i)
                rn_stmts(a, body, sref_str(a, vsr), syn(a, new_s))
                m2_put(seen, 0, sym_lit(ck, new_s), t)
            else:
                m2_put(seen, 0, vsym2, t)

def check_call(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    t: int = check_call_inner(ck, a, fx, c)
    cal: int = a.n[c + {{O:Call.callee}}]
    if a.n[cal] != {{T:Expr.identifier}} or not call_keeps_narrows_sym(ck, sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2]))):
        drop_path_narrows(ck, fx)
    return t

def check_call_inner(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    callee: int = a.n[c + {{O:Call.callee}}]
    if len(ck.gm_names.k1) > 0 and (a.n[callee] == {{T:Expr.attribute}} or a.n[callee] == {{T:Expr.index}}):
        gmt: int = try_resolve_generic_method_call(ck, a, fx, c, callee)
        if gmt >= 0:
            return gmt
    if ck.gcls.live > 0:
        try_resolve_generic_enum_call(ck, a, fx, c)
        callee = a.n[c + {{O:Call.callee}}]
    if ck.static_names.live > 0:
        try_resolve_static_method_call(ck, a, fx, c)
        callee = a.n[c + {{O:Call.callee}}]
    if fx.cls_alias >= 0 and a.n[callee] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[callee + 1], a.n[callee + 2]), "cls") and sc_lookup(ck, fx.scope, sym_lit(ck, "cls")) < 0:
        csr: int = ast_str_sym(ck, a, fx.cls_alias)
        a.n[c + {{O:Call.callee}}] = mk_Expr_identifier(a, pkx(csr), pky(csr))
        callee = a.n[c + {{O:Call.callee}}]
    if a.n[callee] == {{T:Expr.attribute}}:
        return check_method_call(ck, a, fx, c, callee)
    if a.n[callee] == {{T:Expr.index}}:
        qt: int = try_qual_generic_call(ck, a, fx, c, callee)
        if qt >= 0:
            return qt
        cip: int = a.n[callee + 1]
        cobj_t: int = check_expr(ck, a, fx, a.n[cip + {{O:Index.obj}}])
        require_not_optional(ck, cobj_t, "[]")
        if ck.tt.tag[cobj_t] != 5:
            fail2(ck, "NotCallable", "this expression is not callable")
        cidx_t: int = check_expr(ck, a, fx, a.n[cip + {{O:Index.index}}])
        if cidx_t != 0:
            fail2(ck, "TypeMismatch", "the list index must be an 'int'")
        cel_t: int = ck.tt.xa[cobj_t]
        if ck.tt.tag[cel_t] != 14:
            fail2(ck, "NotCallable", "this expression is not callable")
        check_args_func_type(ck, a, fx, c, cel_t, sym_lit(ck, "<list element>"))
        return ck.tt.xb[cel_t]
    if a.n[callee] == {{T:Expr.call}}:
        ic: int = a.n[callee + 1]
        ical: int = a.n[ic + {{O:Call.callee}}]
        iargs: int = sl_at(a, ic, {{O:Call.args}})
        if a.n[ical] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[ical + 1], a.n[ical + 2]), "__nox_get") and pky(iargs) == 1:
            ct_g: int = check_expr(ck, a, fx, callee)
            if ck.tt.tag[ct_g] != 14:
                fail2(ck, "NotCallable", "this expression is not callable")
            check_args_func_type(ck, a, fx, c, ct_g, sym_lit(ck, "<generator local>"))
            return ck.tt.xb[ct_g]
        fail2(ck, "NotCallable", "this expression is not callable")
    if a.n[callee] != {{T:Expr.identifier}}:
        fail2(ck, "NotCallable", "this expression is not callable")
    cv: int = pk(a.n[callee + 1], a.n[callee + 2])
    csym_al: int = sym_of(ck, a, cv)
    if m2_get(fx.async_locals, 0, csym_al) >= 0 and sc_lookup(ck, fx.scope, csym_al) < 0:
        mp(ck, "'")
        mp_sym(ck, csym_al)
        mp(ck, "' is a nested 'async def': start it with 'spawn ")
        mp_sym(ck, csym_al)
        mp(ck, "(...)' (an async function is never called directly)")
        raise mk_fail(ck, "TypeMismatch")
    et_r: int = try_enum_intrinsic(ck, a, fx, c, cv)
    if et_r >= 0:
        return et_r
    pt_r: int = try_desugar_prelude_call(ck, a, fx, c, callee)
    if pt_r >= 0:
        return pt_r
    cv = pk(a.n[callee + 1], a.n[callee + 2])
    if sref_eq(a, cv, "print"):
        return check_print(ck, a, fx, c)
    if sref_eq(a, cv, "len"):
        return check_len(ck, a, fx, c)
    bt: int = check_builtin_call(ck, a, fx, c, cv)
    if bt >= 0:
        return bt
    sym: int = sym_of(ck, a, cv)
    fi: int = m2_get(ck.fmap, 0, sym)
    gfi: int = m2_get(ck.gfn, 0, sym)
    ci: int = class_idx(ck, sym)
    gap: str = call_gap_label(ck, a, cv, fi, gfi, ci)
    if len(gap) > 0:
        raise unsup(ck, gap)
    # yerel değer çağrısı (Zig: önce kapsam): işlev-tipli değer kapsam dışı, diğeri hata
    lt: int = sc_lookup(ck, fx.scope, sym)
    if lt >= 0:
        if ck.tt.tag[lt] == 14:
            check_args_func_type(ck, a, fx, c, lt, sym)
            return ck.tt.xb[lt]
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "' is not a function and cannot be called")
        raise mk_fail(ck, "TypeMismatch")
    if gfi >= 0:
        check_capability_call(ck, sym)
        return instantiate_generic_func(ck, a, fx, ck.gfn.vv[gfi], sym, sl_at(a, c, {{O:Call.args}}), [], False)
    if fi < 0 and ci < 0:
        # `from X.Y import foo [as bar]` ile bağlanan çıplak çağrı (yerel tanım her zaman öncelikli)
        fie: int = m2_get(ck.fimp, 0, sym)
        if fie >= 0:
            return resolve_mangled_call(ck, a, fx, c, ck.fimp.vv[fie], 0, sym, ck.fimp.vv[fie])
        mp(ck, "undefined function or class: ")
        mp_sym(ck, sym)
        raise mk_fail(ck, "UndefinedFunction")
    if fi >= 0 and m2_get(ck.afn, 0, sym) >= 0:
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "' is an 'async def' function and can only be started with 'spawn'")
        raise mk_fail(ck, "TypeMismatch")
    if fi >= 0:
        sid: int = ck.fmap.vv[fi]
        if m2_get(ck.ext_err_kind, 0, sym) >= 0:
            check_extern_errors_call(ck, a, sym)
        if m2_get(ck.ext_cb_idx, 0, sym) >= 0:
            check_extern_callback_args(ck, a, fx, sid, c, sym)
        else:
            check_args_sig(ck, a, fx, c, sid, sym)
        check_capability_call(ck, sym)
        return ck.fret[sid]
    isid: int = ck.cls_init[ci]
    if isid < 0:
        isid = ck.sig_empty
    check_args_sig(ck, a, fx, c, isid, sym)
    return ty_class(ck.tt, sym)

# ---- deyimler ----
def declare_var_checked(ck: Ck, fx: Fx, sym: int, ty: int) -> None:
    if declare_var(ck, fx.scope, sym, ty) != 0:
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "' is already defined in this scope with type '")
        mp_type(ck, ck.e_prev)
        mp(ck, "'; it cannot be redefined with type '")
        mp_type(ck, ty)
        mp(ck, "' (use a different name)")
        raise mk_fail(ck, "TypeMismatch")

def check_block(ck: Ck, a: Ast, fx: Fx, s: int) -> None:
    for i in range(pky(s)):
        check_stmt(ck, a, fx, stmt_at(a, s, i))

def check_walrus_decl(ck: Ck, a: Ast, fx: Fx, pay: int, nm: int, sym: int) -> None:
    if fx.scope == ck.top_scope and fx.ret < 0:
        mp(ck, "':=' can only be used inside a function or method; at module level write the type: '")
        mp_sref(ck, a, nm)
        mp(ck, ": <type> = ...'")
        raise mk_fail(ck, "TypeMismatch")
    val: int = a.n[pay + {{O:VarDecl.value}}]
    vt: int = a.n[val]
    if vt == {{T:Expr.none_lit}}:
        mp(ck, "cannot infer the type of '")
        mp_sref(ck, a, nm)
        mp(ck, "' from 'None'; write the type: '")
        mp_sref(ck, a, nm)
        mp(ck, ": <type> | None = None'")
        raise mk_fail(ck, "TypeMismatch")
    if vt == {{T:Expr.list_lit}} and a.n[val + 2] == 0:
        mp(ck, "cannot infer the element type of '")
        mp_sref(ck, a, nm)
        mp(ck, "' from an empty list; write the type: '")
        mp_sref(ck, a, nm)
        mp(ck, ": list[<type>] = []'")
        raise mk_fail(ck, "TypeMismatch")
    if vt == {{T:Expr.dict_lit}} and a.n[val + 2] == 0:
        mp(ck, "cannot infer the key/value types of '")
        mp_sref(ck, a, nm)
        mp(ck, "' from an empty dict; write the type: '")
        mp_sref(ck, a, nm)
        mp(ck, ": dict[<key>, <value>] = {}'")
        raise mk_fail(ck, "TypeMismatch")
    t: int = check_expr(ck, a, fx, val)
    if t == 4:
        mp(ck, "the value for '")
        mp_sref(ck, a, nm)
        mp(ck, "' does not produce a type (a call that returns None cannot be assigned)")
        raise mk_fail(ck, "TypeMismatch")
    declare_var_checked(ck, fx, sym, t)
    if m2_get(fx.infer_lines, 0, sym) < 0:
        m2_put(fx.infer_lines, 0, sym, ck.cur_line)

def parse_trailing_int_sref(a: Ast, sr: int) -> int:
    n: int = sref_len(sr)
    i: int = n - 1
    while i >= 0 and sref_byte(a, sr, i) != 95:
        i = i - 1
    if i < 0 or i + 1 >= n:
        return 0
    acc: int = 0
    for j in range(i + 1, n):
        b: int = sref_byte(a, sr, j)
        if b < 48 or b > 57:
            return 0
        acc = acc * 10 + (b - 48)
    return acc

def check_infer_var_decl(ck: Ck, a: Ast, fx: Fx, pay: int, nm: int, sym: int) -> None:
    nm_s: str = sref_str(a, nm)
    is_tup: bool = len(nm_s) >= 10 and nm_s[:10] == "__nox_tup_"
    val_e: int = a.n[pay + {{O:VarDecl.value}}]
    t: int = -1
    if is_tup and parse_trailing_int_sref(a, nm) == 2 and a.n[val_e] == {{T:Expr.call}}:
        vc: int = a.n[val_e + 1]
        vcal: int = a.n[vc + {{O:Call.callee}}]
        vargs: int = sl_at(a, vc, {{O:Call.args}})
        if a.n[vcal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[vcal + 1], a.n[vcal + 2]), "divmod") and pky(vargs) == 2 and m2_get(ck.fmap, 0, sym_lit(ck, "divmod")) < 0:
            da0: int = stmt_at(a, vargs, 0)
            da1: int = stmt_at(a, vargs, 1)
            if a.n[da0] != {{T:Expr.kwarg}} and a.n[da1] != {{T:Expr.kwarg}}:
                dt: int = numeric_promote(ck, check_expr(ck, a, fx, da0), check_expr(ck, a, fx, da1))
                t = instantiate_tuple_class(ck, [dt, dt])
    if t < 0:
        t = check_expr(ck, a, fx, val_e)
    if t == 4:
        mp(ck, "the value for '")
        mp_sref(ck, a, nm)
        mp(ck, "' does not produce a type")
        raise mk_fail(ck, "TypeMismatch")
    if is_tup:
        want: int = parse_trailing_int_sref(a, nm)
        ci: int = class_idx_of_type(ck, t)
        if ck.tt.tag[t] != 6 or not is_tuple_cls(ck, ci):
            fail2(ck, "TypeMismatch", "tuple unpacking: the right-hand side must be a tuple")
        have: int = ck.tup_n[ci]
        if have != want:
            mp(ck, "tuple unpacking: there are ")
            mp_int(ck, want)
            mp(ck, " targets but the value has ")
            mp_int(ck, have)
            mp(ck, " elements")
            raise mk_fail(ck, "TypeMismatch")
    declared: int = t
    ex: int = sc_lookup_local(ck, fx.scope, sym)
    if ex >= 0 and ty_assignable(ck.tt, ex, t):
        declared = ex
    declare_var_checked(ck, fx, sym, declared)

def is_synthetic_unpack_read(a: Ast, tag: int, pay: int) -> bool:
    val: int = -1
    if tag == {{T:StmtKind.var_decl}}:
        val = a.n[pay + {{O:VarDecl.value}}]
    elif tag == {{T:StmtKind.assign}}:
        val = a.n[pay + {{O:Assign.value}}]
    if val < 0 or a.n[val] != {{T:Expr.attribute}}:
        return False
    obj: int = a.n[a.n[val + 1] + {{O:Attribute.obj}}]
    if a.n[obj] != {{T:Expr.identifier}}:
        return False
    os: str = sref_str(a, pk(a.n[obj + 1], a.n[obj + 2]))
    return len(os) >= 10 and os[:10] == "__nox_tup_"

def is_duplicable_expr(a: Ast, e: int) -> bool:
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}} or tag == {{T:Expr.int_lit}} or tag == {{T:Expr.float_lit}} or tag == {{T:Expr.bool_lit}} or tag == {{T:Expr.string_lit}}:
        return True
    if tag == {{T:Expr.attribute}}:
        return is_duplicable_expr(a, a.n[a.n[e + 1] + {{O:Attribute.obj}}])
    if tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        return is_duplicable_expr(a, a.n[ip + {{O:Index.obj}}]) and is_duplicable_expr(a, a.n[ip + {{O:Index.index}}])
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        return is_duplicable_expr(a, a.n[bp + {{O:Binary.left}}]) and is_duplicable_expr(a, a.n[bp + {{O:Binary.right}}])
    if tag == {{T:Expr.unary}}:
        return is_duplicable_expr(a, a.n[a.n[e + 1] + {{O:Unary.operand}}])
    return False

def ast_expr_list(a: Ast, items: list[int]) -> int:
    st: int = len(a.l)
    for it in items:
        a.l.append(it)
    return pk(st, len(items))

def ast_stmt_list(a: Ast, items: list[int]) -> int:
    st: int = len(a.l)
    for it in items:
        a.l.append(it)
    return pk(st, len(items))

def mk_ident_node(a: Ast, s: str) -> int:
    sr: int = syn(a, s)
    return mk_Expr_identifier(a, pkx(sr), pky(sr))

def mk_attr_call_node(a: Ast, obj_e: int, attr_s: str, arg_list: int) -> int:
    asr: int = syn(a, attr_s)
    cal: int = mk_Expr_attribute(a, mk_Attribute(a, obj_e, pkx(asr), pky(asr)))
    return mk_Expr_call(a, mk_Call(a, cal, pkx(arg_list), pky(arg_list), 0, 0, 0, 0, 0, 0))

def try_check_element_grow_stmt(ck: Ck, a: Ast, fx: Fx, e: int) -> bool:
    if a.n[e] != {{T:Expr.call}}:
        return False
    c: int = a.n[e + 1]
    cal: int = a.n[c + {{O:Call.callee}}]
    if a.n[cal] != {{T:Expr.attribute}}:
        return False
    at: int = a.n[cal + 1]
    attr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    if not (sref_eq(a, attr, "append") or sref_eq(a, attr, "insert") or sref_eq(a, attr, "extend")):
        return False
    obj: int = a.n[at + {{O:Attribute.obj}}]
    if a.n[obj] != {{T:Expr.index}}:
        return False
    recv_t: int = check_expr(ck, a, fx, obj)
    if ck.tt.tag[recv_t] != 5:
        return False
    if not is_duplicable_expr(a, obj):
        mp(ck, "'")
        mp_sref(ck, a, attr)
        mp(ck, "' can only be called on an element through an index expression without side effects (e.g. 'group[key].append(v)'); assign it to a variable first")
        raise mk_fail(ck, "TypeMismatch")
    ck.ext_cnt = ck.ext_cnt + 1
    tmp_name: str = "__nox_el_" + str(ck.ext_cnt)
    tsr: int = syn(a, tmp_name)
    te: int = type_to_type_expr(ck, a, recv_t)
    s0: int = mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, obj, 0, 0, 0, 0)), ck.cur_line, ck.cur_span)
    s1: int = mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, tmp_name), sref_str(a, attr), sl_at(a, c, {{O:Call.args}}))), ck.cur_line, ck.cur_span)
    s2: int = mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, obj, mk_ident_node(a, tmp_name), {{NONE}})), ck.cur_line, ck.cur_span)
    tb: int = ast_stmt_list(a, [s0, s1, s2])
    ifp: int = mk_IfStmt(a, mk_Expr_bool_lit(a, 1), pkx(tb), pky(tb), 0, 0, 0, 0, 0, -1, 0)
    synth: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, ifp), ck.cur_line, ck.cur_span)
    check_stmt(ck, a, fx, synth)
    return True

def try_check_extend_stmt(ck: Ck, a: Ast, fx: Fx, e: int) -> bool:
    if a.n[e] != {{T:Expr.call}}:
        return False
    c: int = a.n[e + 1]
    cal: int = a.n[c + {{O:Call.callee}}]
    if a.n[cal] != {{T:Expr.attribute}}:
        return False
    at: int = a.n[cal + 1]
    attr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    if not sref_eq(a, attr, "extend"):
        return False
    obj: int = a.n[at + {{O:Attribute.obj}}]
    obj_t: int = check_expr(ck, a, fx, obj)
    if ck.tt.tag[obj_t] != 5:
        return False
    check_growable_recv(ck, a, fx, obj, "extend", "xs.extend(ys)")
    args: int = sl_at(a, c, {{O:Call.args}})
    if pky(args) != 1:
        fail2(ck, "ArgumentCountMismatch", "'extend' takes exactly 1 argument")
    ot: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 0), obj_t)
    if ot != obj_t:
        fail2(ck, "TypeMismatch", "the argument of 'extend' must be of the same list[T] type")
    ck.ext_cnt = ck.ext_cnt + 1
    vname: str = "__nox_ext_" + str(ck.ext_cnt)
    vsr: int = syn(a, vname)
    a0: int = stmt_at(a, args, 0)
    atag: int = a.n[a0]
    fresh: bool = (atag == {{T:Expr.call}} or atag == {{T:Expr.list_lit}} or atag == {{T:Expr.binary}} or atag == {{T:Expr.ternary}} or atag == {{T:Expr.slice}} or atag == {{T:Expr.list_comp}} or atag == {{T:Expr.dict_comp}})
    iterable: int = a0
    if not fresh:
        iterable = mk_attr_call_node(a, a0, "copy", pk(0, 0))
    al: int = ast_expr_list(a, [mk_ident_node(a, vname)])
    sb0: int = mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, obj, "append", al)), ck.cur_line, ck.cur_span)
    fbody: int = ast_stmt_list(a, [sb0])
    fp: int = mk_ForStmt(a, pkx(vsr), pky(vsr), iterable, pkx(fbody), pky(fbody), 0, 0, -1)
    synth: int = mk_Stmt(a, mk_StmtKind_for_stmt(a, fp), ck.cur_line, ck.cur_span)
    check_stmt(ck, a, fx, synth)
    return True

def check_stmt(ck: Ck, a: Ast, fx: Fx, st: int) -> None:
    ck.cur_line = a.n[st + {{O:Stmt.line}}]
    ck.cur_span = a.n[st + {{O:Stmt.span}}]
    kn: int = a.n[st + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    ck.synth_follow = is_synthetic_unpack_read(a, tag, pay)
    if tag == {{T:StmtKind.expr_stmt}}:
        if try_check_element_grow_stmt(ck, a, fx, pay):
            return
        if try_check_extend_stmt(ck, a, fx, pay):
            return
        check_expr(ck, a, fx, pay)
        return
    if tag == {{T:StmtKind.var_decl}}:
        nm: int = pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1])
        sym_vd: int = sym_of(ck, a, nm)
        if a.n[pay + {{O:VarDecl.infer_assign}}] != 0:
            check_walrus_decl(ck, a, fx, pay, nm, sym_vd)
            return
        vte: int = a.n[pay + {{O:VarDecl.type_expr}}]
        if a.n[vte] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[vte + 1], a.n[vte + 2]), "__infer"):
            check_infer_var_decl(ck, a, fx, pay, nm, sym_vd)
            return
        declared: int = type_expr_to_type(ck, a, vte)
        value_t: int = check_expr_expected(ck, a, fx, a.n[pay + {{O:VarDecl.value}}], declared)
        if not assignable_or_coerce(ck, a, declared, value_t):
            mp(ck, "type mismatch for '")
            mp_sref(ck, a, nm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        declare_var_checked(ck, fx, sym_vd, declared)
        return
    if tag == {{T:StmtKind.assign}}:
        check_assign(ck, a, fx, pay)
        return
    if tag == {{T:StmtKind.if_stmt}}:
        if a.n[pay + {{O:IfStmt.match_origin}}] >= 0:
            rename_conflicting_match_bindings(ck, a, fx, st, pay)
        ct: int = check_expr(ck, a, fx, a.n[pay + {{O:IfStmt.cond}}])
        if ct != 2:
            mp(ck, "the 'if' condition must be a bool")
            raise mk_fail(ck, "TypeMismatch")
        tk: list[int] = []
        tt_n: list[int] = []
        ek: list[int] = []
        et_n: list[int] = []
        collect_narrows(ck, a, fx, a.n[pay + {{O:IfStmt.cond}}], True, tk, tt_n)
        collect_narrows(ck, a, fx, a.n[pay + {{O:IfStmt.cond}}], False, ek, et_n)
        tsav: list[int] = apply_narrows(fx, tk, tt_n)
        try:
            check_block(ck, a, fx, sl_at(a, pay, {{O:IfStmt.then_body}}))
        finally:
            restore_narrows(fx, tk, tsav)
        ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        for j in range(pky(ecs)):
            ec: int = stmt_at(a, ecs, j)
            ect: int = check_expr(ck, a, fx, a.n[ec + {{O:ElifClause.cond}}])
            if ect != 2:
                mp(ck, "the 'elif' condition must be a bool")
                raise mk_fail(ck, "TypeMismatch")
            check_block(ck, a, fx, sl_at(a, ec, {{O:ElifClause.body}}))
        if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
            esav: list[int] = apply_narrows(fx, ek, et_n)
            try:
                check_block(ck, a, fx, sl_at(a, pay, {{O:IfStmt.else_body}}))
            finally:
                restore_narrows(fx, ek, esav)
        return
    if tag == {{T:StmtKind.while_stmt}}:
        wt: int = check_expr(ck, a, fx, a.n[pay + {{O:WhileStmt.cond}}])
        if wt != 2:
            mp(ck, "the 'while' condition must be a bool")
            raise mk_fail(ck, "TypeMismatch")
        wk: list[int] = []
        wt_n: list[int] = []
        collect_narrows(ck, a, fx, a.n[pay + {{O:WhileStmt.cond}}], True, wk, wt_n)
        wsav: list[int] = apply_narrows(fx, wk, wt_n)
        fx.loop = fx.loop + 1
        try:
            check_block(ck, a, fx, sl_at(a, pay, {{O:WhileStmt.body}}))
        finally:
            fx.loop = fx.loop - 1
            restore_narrows(fx, wk, wsav)
        return
    if tag == {{T:StmtKind.return_stmt}}:
        if fx.ret < 0:
            mp(ck, "'return' can only be used inside a function/method")
            raise mk_fail(ck, "TypeMismatch")
        if pay >= 0:
            rt: int = check_expr_expected(ck, a, fx, pay, fx.ret)
            if not assignable_or_coerce(ck, a, fx.ret, rt):
                mp(ck, "return type mismatch")
                raise mk_fail(ck, "TypeMismatch")
        elif fx.ret != 4:
            mp(ck, "the function must return a value")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == {{T:StmtKind.for_stmt}}:
        is_af: bool = a.n[pay + {{O:ForStmt.is_async}}] != 0
        if is_af and not fx.in_async:
            fail2(ck, "TypeMismatch", "'async for' can only be used inside an 'async def' body or at the top level")
        if not is_af and try_fuse_enumerate_zip_for(ck, a, fx, pay):
            return
        it: int = a.n[pay + {{O:ForStmt.iterable}}]
        ck.lazy_for_iter = -1
        elem_t: int = check_for_iterable(ck, a, fx, it)
        if is_af and ck.lazy_for_iter < 0:
            fail2(ck, "TypeMismatch", "'async for' needs an async iterator (an 'AsyncIterator[T]' returned by an async generator)")
        if ck.lazy_for_iter >= 0:
            lzt: int = ck.lazy_for_iter
            ck.lazy_for_iter = -1
            check_lazy_for(ck, a, fx, pay, lzt)
            return
        vn: int = pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1])
        declare_var_checked(ck, fx, sym_of(ck, a, vn), elem_t)
        fx.loop = fx.loop + 1
        try:
            check_block(ck, a, fx, sl_at(a, pay, {{O:ForStmt.body}}))
        finally:
            fx.loop = fx.loop - 1
        return
    if tag == {{T:StmtKind.pass_stmt}}:
        return
    if tag == {{T:StmtKind.break_stmt}}:
        if fx.loop == 0:
            mp(ck, "'break' can only be used inside a 'while'/'for' loop")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == {{T:StmtKind.continue_stmt}}:
        if fx.loop == 0:
            mp(ck, "'continue' can only be used inside a 'while'/'for' loop")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == {{T:StmtKind.raise_stmt}}:
        rzt: int = check_expr(ck, a, fx, pay)
        if ck.tt.tag[rzt] != 6:
            mp(ck, "'raise' can only take a class instance")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == {{T:StmtKind.del_stmt}}:
        if a.n[pay] != {{T:Expr.index}}:
            mp(ck, "'del' only takes an index target (del d[key])")
            raise mk_fail(ck, "TypeMismatch")
        dip: int = a.n[pay + 1]
        dobj: int = check_expr(ck, a, fx, a.n[dip + {{O:Index.obj}}])
        didx: int = check_expr(ck, a, fx, a.n[dip + {{O:Index.index}}])
        dg: int = ck.tt.tag[dobj]
        if dg == 13:
            if didx != ck.tt.xa[dobj]:
                mp(ck, "the 'del' key does not match the dict's key type")
                raise mk_fail(ck, "TypeMismatch")
        elif dg == 5:
            if didx != 0:
                mp(ck, "the 'del' list index must be an 'int'")
                raise mk_fail(ck, "TypeMismatch")
        else:
            mp(ck, "'del' only works on list[i] or dict[key]")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == {{T:StmtKind.extern_def}}:
        mp(ck, "'extern def' is only allowed at module level")
        raise mk_fail(ck, "TypeMismatch")
    if tag == {{T:StmtKind.try_stmt}}:
        check_try(ck, a, fx, pay)
        return
    if tag == {{T:StmtKind.lowlevel_stmt}}:
        # gövdede tanımlanan adlar bloktan sonra kapsam dışına alınır (arena blok çıkışında yıkılır)
        before: list[int] = scope_live_names(ck, fx.scope)
        fx.ll_depth = fx.ll_depth + 1
        try:
            check_block(ck, a, fx, sl_at(a, pay, {{O:LowLevelStmt.body}}))
        finally:
            fx.ll_depth = fx.ll_depth - 1
        for li in range(len(ck.vars.k1)):
            if ck.vars.k1[li] == fx.scope and ck.vars.dead[li] == 0:
                kn2: int = ck.vars.k2[li]
                known: bool = False
                for bi in range(len(before)):
                    if before[bi] == kn2:
                        known = True
                        break
                if not known:
                    m2_remove(ck.vars, fx.scope, kn2)
        return
    if tag == {{T:StmtKind.with_stmt}}:
        if a.n[pay + {{O:WithStmt.is_async}}] != 0:
            check_async_with(ck, a, fx, pay)
            return
        check_with(ck, a, fx, pay)
        return
    if tag == {{T:StmtKind.func_def}}:
        if pky(sl_at(a, pay, {{O:FuncDef.type_params}})) > 0:
            mp(ck, "a nested function definition CANNOT be generic: ")
            mp_sref(ck, a, pk(a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1]))
            raise mk_fail(ck, "TypeMismatch")
        if a.n[pay + {{O:FuncDef.is_async}}] != 0:
            hoist_nested_async(ck, a, fx, st, pay)
            return
        ft: int = check_nested_def(ck, a, fx, pay)
        sc_declare(ck, fx.scope, sym_of(ck, a, pk(a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1])), ft)
        return
    if tag == {{T:StmtKind.defer_stmt}}:
        check_defer(ck, a, fx, pay)
        return
    raise unsup(ck, "stmt_kind#" + str(tag))

# `checkNestedFuncDef`: gövde, dış kapsamı üst zincir (yakalama kaydıyla) olan yeni kapsamda denetlenir; sonuç işlev tipi.
def check_nested_def(ck: Ck, a: Ast, fx: Fx, fd: int) -> int:
    inner: int = sc_new(ck, fx.scope, True)
    ck.last_nested_cap_id = ck.sc[inner]
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        sc_declare(ck, inner, sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])), type_expr_to_type(ck, a, a.n[p + {{O:Param.type_expr}}]))
    ret: int = type_expr_to_type(ck, a, a.n[fd + {{O:FuncDef.return_type}}])
    in_async: bool = a.n[fd + {{O:FuncDef.allow_await}}] != 0 or a.n[fd + {{O:FuncDef.is_async}}] != 0
    ifx: Fx = Fx(inner, ret, in_async)
    body: int = sl_at(a, fd, {{O:FuncDef.body}})
    check_block(ck, a, ifx, body)
    if ret != 4 and not always_returns(a, body):
        mp(ck, "nested function '")
        mp_sref(ck, a, pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1]))
        mp(ck, "' does not return a value on all paths")
        raise mk_fail(ck, "MissingReturn")
    tys: list[int] = []
    for j in range(pky(ps)):
        tys.append(type_expr_to_type(ck, a, a.n[stmt_at(a, ps, j) + {{O:Param.type_expr}}]))
    ty_func_begin(ck.tt)
    for k in range(len(tys)):
        ty_func_param(ck.tt, tys[k])
    return ty_func_end(ck.tt, ret)

# `checkLambda`: beklenen işlev tipi gerekir; gövde (ifade) `return`/ifade deyimi olarak iç kapsamda denetlenir.
def check_lambda(ck: Ck, a: Ast, fx: Fx, e: int, expected: int) -> int:
    lam: int = a.n[e + 1]
    if expected < 0:
        fail2(ck, "TypeMismatch", "'lambda' can only be used where the expected function type is known (a function-typed parameter/variable/return)")
    tt: TT = ck.tt
    if tt.tag[expected] != 14:
        fail2(ck, "TypeMismatch", "'lambda' can only be used where a function type is expected")
    lps: int = sl_at(a, lam, {{O:Lambda.params}})
    if tt.xc[expected] != pky(lps):
        mp(ck, "the lambda takes ")
        mp_int(ck, pky(lps))
        mp(ck, " parameters but the expected function type takes ")
        mp_int(ck, tt.xc[expected])
        mp(ck, " parameters")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if ck.comp_depth > 0:
        fail2(ck, "TypeMismatch", "'lambda' is not supported inside a comprehension — assign it to a variable first")
    inner: int = sc_new(ck, fx.scope, True)
    for i in range(pky(lps)):
        sc_declare(ck, inner, sym_of(ck, a, pk(a.l[pkx(lps) + i * 2], a.l[pkx(lps) + i * 2 + 1])), tt.fp[tt.xa[expected] + i])
    ret: int = tt.xb[expected]
    ifx: Fx = Fx(inner, ret, False)
    body: int = a.n[lam + {{O:Lambda.body}}]
    if ret == 4:
        if not try_check_extend_stmt(ck, a, ifx, body) and not try_check_element_grow_stmt(ck, a, ifx, body):
            check_expr(ck, a, ifx, body)
    else:
        rt: int = check_expr_expected(ck, a, ifx, body, ret)
        if not ty_assignable(tt, ret, rt):
            mp(ck, "return type mismatch")
            raise mk_fail(ck, "TypeMismatch")
    # modül düzeyindeki lambda yalnız modül-global'lerini yakalayabilir (Zig `closure_infos` HashMap sırası: ≥2 ihlalde sıra taklit edilemez)
    if fx.ret < 0:
        bad: int = 0
        bsym: int = -1
        for ce in range(len(ck.caps.k1)):
            if ck.caps.k1[ce] == ck.sc[inner] and ck.caps.dead[ce] == 0 and m2_get(ck.globs, 0, ck.caps.k2[ce]) < 0:
                bad = bad + 1
                bsym = ck.caps.k2[ce]
        if bad > 1:
            raise unsup(ck, "lambda#captures_order")
        if bad == 1:
            mp(ck, "a module-level lambda cannot capture the local variable '")
            mp_sym(ck, bsym)
            mp(ck, "' defined inside a loop/block — use the lambda inside a function, or define the variable at the top level")
            raise mk_fail(ck, "TypeMismatch")
    return expected

# `checkDeferStmt`: çağrı, `None` dönen sentetik iç içe işlevin gövdesi olarak denetlenir (yakalamalar kapanış gibi).
def check_defer(ck: Ck, a: Ast, fx: Fx, d: int) -> None:
    if fx.ret < 0:
        fail2(ck, "TypeMismatch", "'defer' can only be used inside a function/method")
    ce: int = len(a.n)
    a.n.append({{T:Expr.call}})
    a.n.append(a.n[d])
    inner: int = sc_new(ck, fx.scope, True)
    ifx: Fx = Fx(inner, 4, False)
    ck.cur_span = -1
    if not try_check_extend_stmt(ck, a, ifx, ce) and not try_check_element_grow_stmt(ck, a, ifx, ce):
        check_expr(ck, a, ifx, ce)

def scope_live_names(ck: Ck, scope: int) -> list[int]:
    out: list[int] = []
    for i in range(len(ck.vars.k1)):
        if ck.vars.k1[i] == scope and ck.vars.dead[i] == 0:
            out.append(ck.vars.k2[i])
    return out

# `checkTry`: try gövdesi, `except [Sınıf [as ad]]` yan tümceleri (noktalı ad kapsam dışı), `finally`.
def check_try(ck: Ck, a: Ast, fx: Fx, t: int) -> None:
    check_block(ck, a, fx, sl_at(a, t, {{O:TryStmt.try_body}}))
    exs: int = sl_at(a, t, {{O:TryStmt.except_clauses}})
    for q in range(pky(exs)):
        ecq: int = stmt_at(a, exs, q)
        qc: int = a.n[ecq + {{O:ExceptClause.class_name}}]
        if qc != {{NONE}}:
            cn0: int = pk(a.n[ecq + {{O:ExceptClause.class_name}}], a.n[ecq + {{O:ExceptClause.class_name}} + 1])
            has_dot: bool = False
            for dq in range(sref_len(cn0)):
                if sref_byte(a, cn0, dq) == 46:
                    has_dot = True
                    break
            if has_dot:
                dstr: str = sref_str(a, cn0)
                segs_d: list[int] = []
                cur_s: int = 0
                for di in range(len(dstr) + 1):
                    if di == len(dstr) or dstr[di] == ".":
                        segs_d.append(sym_lit(ck, dstr[cur_s:di]))
                        cur_s = di + 1
                exp_d: list[int] = subst_alias(ck, segs_d)
                m_str: str = sym_to_str(ck, exp_d[0])
                for mi in range(1, len(exp_d)):
                    m_str = m_str + "_" + sym_to_str(ck, exp_d[mi])
                msym_d: int = sym_lit(ck, m_str)
                if class_idx(ck, msym_d) < 0:
                    mp(ck, "unknown class: ")
                    mp(ck, dstr)
                    mp(ck, " (is the module imported?)")
                    raise mk_fail(ck, "UndefinedClass")
                msr_d: int = ast_str_sym(ck, a, msym_d)
                a.n[ecq + {{O:ExceptClause.class_name}}] = pkx(msr_d)
                a.n[ecq + {{O:ExceptClause.class_name}} + 1] = pky(msr_d)
    for k in range(pky(exs)):
        ec: int = stmt_at(a, exs, k)
        if a.n[ec + {{O:ExceptClause.class_name}}] == {{NONE}}:
            check_block(ck, a, fx, sl_at(a, ec, {{O:ExceptClause.body}}))
            continue
        cn: int = pk(a.n[ec + {{O:ExceptClause.class_name}}], a.n[ec + {{O:ExceptClause.class_name}} + 1])
        csym: int = sym_of(ck, a, cn)
        if class_idx(ck, csym) < 0:
            # `from X import Err`: mangled sınıfa çözülür (bind tipi de mangled sınıf)
            cfe: int = m2_get(ck.fimp, 0, csym)
            if cfe >= 0 and class_idx(ck, ck.fimp.vv[cfe]) >= 0:
                csym = ck.fimp.vv[cfe]
        if class_idx(ck, csym) < 0:
            mp(ck, "unknown class: ")
            mp_sref(ck, a, cn)
            raise mk_fail(ck, "UndefinedClass")
        if a.n[ec + {{O:ExceptClause.bind_name}}] != {{NONE}}:
            bn: int = pk(a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1])
            declare_var_checked(ck, fx, sym_of(ck, a, bn), ty_class(ck.tt, csym))
        check_block(ck, a, fx, sl_at(a, ec, {{O:ExceptClause.body}}))
    if a.n[t + {{O:TryStmt.finally_body}}] != {{NONE}}:
        check_block(ck, a, fx, sl_at(a, t, {{O:TryStmt.finally_body}}))

# `checkWith`: `with E as ad:` — `E` bir sınıf örneği; argümansız `__enter__`/`__exit__` (`__exit__ -> None`).
def check_with(ck: Ck, a: Ast, fx: Fx, w: int) -> None:
    ct: int = check_expr(ck, a, fx, a.n[w + {{O:WithStmt.ctx_expr}}])
    if ck.tt.tag[ct] != 6:
        mp(ck, "'with' only works on a class instance")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, ct)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, ck.tt.xa[ct])
        raise mk_fail(ck, "UndefinedClass")
    ee: int = m2_get(ck.cls_meths, ci, sym_lit(ck, "__enter__"))
    if ee < 0:
        mp(ck, "class '")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, "' has no '__enter__' method (required for 'with')")
        raise mk_fail(ck, "UndefinedMethod")
    esid: int = ck.cls_meths.vv[ee]
    if ck.fpn[esid] != 0:
        mp(ck, "'")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, ".__enter__' MUST NOT take any arguments")
        raise mk_fail(ck, "TypeMismatch")
    xe: int = m2_get(ck.cls_meths, ci, sym_lit(ck, "__exit__"))
    if xe < 0:
        mp(ck, "class '")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, "' has no '__exit__' method (required for 'with')")
        raise mk_fail(ck, "UndefinedMethod")
    xsid: int = ck.cls_meths.vv[xe]
    if ck.fpn[xsid] != 0:
        mp(ck, "'")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, ".__exit__' MUST NOT take any arguments")
        raise mk_fail(ck, "TypeMismatch")
    if ck.fret[xsid] != 4:
        mp(ck, "'")
        mp_sym(ck, ck.cls_sym[ci])
        mp(ck, ".__exit__' MUST return None")
        raise mk_fail(ck, "TypeMismatch")
    if a.n[w + {{O:WithStmt.binding}}] != {{NONE}}:
        bnd: int = pk(a.n[w + {{O:WithStmt.binding}}], a.n[w + {{O:WithStmt.binding}} + 1])
        declare_var_checked(ck, fx, sym_of(ck, a, bnd), ck.fret[esid])
    check_block(ck, a, fx, sl_at(a, w, {{O:WithStmt.body}}))

def try_fuse_enumerate_zip_for(ck: Ck, a: Ast, fx: Fx, f: int) -> bool:
    it: int = a.n[f + {{O:ForStmt.iterable}}]
    if a.n[it] != {{T:Expr.call}}:
        return False
    c: int = a.n[it + 1]
    cal: int = a.n[c + {{O:Call.callee}}]
    if a.n[cal] != {{T:Expr.identifier}}:
        return False
    cv: int = pk(a.n[cal + 1], a.n[cal + 2])
    is_enum: bool = sref_eq(a, cv, "enumerate")
    is_zip: bool = sref_eq(a, cv, "zip")
    if not is_enum and not is_zip:
        return False
    csym: int = sym_of(ck, a, cv)
    if m2_get(ck.fmap, 0, csym) >= 0 or class_idx(ck, csym) >= 0 or sc_lookup(ck, fx.scope, csym) >= 0 or m2_get(ck.globs, 0, csym) >= 0:
        return False
    cargs: int = sl_at(a, c, {{O:Call.args}})
    nc: int = pky(cargs)
    for ai in range(nc):
        if a.n[stmt_at(a, cargs, ai)] == {{T:Expr.kwarg}}:
            return False
    nsrc: int = 1 if is_enum else nc
    if is_enum and nc != 1 and nc != 2:
        return False
    if is_zip and nc != 2 and nc != 3:
        return False
    nnames: int = 2 if is_enum else nc
    vnsr: int = pk(a.n[f + {{O:ForStmt.var_name}}], a.n[f + {{O:ForStmt.var_name}} + 1])
    vns: str = sref_str(a, vnsr)
    fbody: int = sl_at(a, f, {{O:ForStmt.body}})
    if len(vns) < 10 or vns[:10] != "__nox_tup_" or pky(fbody) < nnames:
        return False
    if parse_trailing_int_sref(a, vnsr) != nnames:
        return False
    names: list[int] = []
    for k in range(nnames):
        st: int = stmt_at(a, fbody, k)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.var_decl}}:
            return False
        vd: int = a.n[kn + 1]
        val: int = a.n[vd + {{O:VarDecl.value}}]
        if a.n[val] != {{T:Expr.attribute}}:
            return False
        obj: int = a.n[a.n[val + 1] + {{O:Attribute.obj}}]
        if a.n[obj] != {{T:Expr.identifier}} or not sref_eq(a, pk(a.n[obj + 1], a.n[obj + 2]), vns):
            return False
        names.append(pk(a.n[vd + {{O:VarDecl.name}}], a.n[vd + {{O:VarDecl.name}} + 1]))
    try:
        for k2 in range(nsrc):
            t2: int = check_expr(ck, a, fx, stmt_at(a, cargs, k2))
            if ck.tt.tag[t2] != 5:
                return False
        if is_enum and nc == 2:
            if check_expr(ck, a, fx, stmt_at(a, cargs, 1)) != 0:
                return False
    except CkErr:
        return False
    ck.ext_cnt = ck.ext_cnt + 1
    fid: int = ck.ext_cnt
    inf_sr: int = syn(a, "__infer")
    inf_te: int = mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr))
    outer: list[int] = []
    src_names: list[str] = []
    for k3 in range(nsrc):
        snm: str = "__nox_fs_" + str(fid) + "_" + str(k3)
        src_names.append(snm)
        ssr: int = syn(a, snm)
        outer.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(ssr), pky(ssr), inf_te, stmt_at(a, cargs, k3), 0, 0, 0, 0)), ck.cur_line, ck.cur_span))
    n_name: str = "__nox_fn_" + str(fid)
    n_expr: int = mk_ident_call(a, "len", [mk_ident_node(a, src_names[0])])
    for k4 in range(1, nsrc):
        l_k: int = mk_ident_call(a, "len", [mk_ident_node(a, src_names[k4])])
        cond_k: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, n_expr, l_k, 0, 0, 0, 0))
        l_k2: int = mk_ident_call(a, "len", [mk_ident_node(a, src_names[k4])])
        tern: int = mk_Expr_ternary(a, mk_Ternary(a, cond_k, n_expr, l_k2))
        tmp_m: str = "__nox_fm_" + str(fid) + "_" + str(k4)
        tsr_m: int = syn(a, tmp_m)
        outer.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr_m), pky(tsr_m), inf_te, tern, 0, 0, 0, 0)), ck.cur_line, ck.cur_span))
        n_expr = mk_ident_node(a, tmp_m)
    nsr_f: int = syn(a, n_name)
    outer.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(nsr_f), pky(nsr_f), inf_te, n_expr, 0, 0, 0, 0)), ck.cur_line, ck.cur_span))
    k_name: str = "__nox_fk_" + str(fid)
    ksr: int = syn(a, k_name)
    inner_stmts: list[int] = []
    for j in range(nnames):
        v_j: int = 0
        if is_enum and j == 0:
            if nc == 2:
                v_j = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.add}}, mk_ident_node(a, k_name), stmt_at(a, cargs, 1), 0, 0, 0, 0))
            else:
                v_j = mk_ident_node(a, k_name)
        else:
            si: int = 0 if is_enum else j
            v_j = mk_Expr_index(a, mk_Index(a, mk_ident_node(a, src_names[si]), mk_ident_node(a, k_name)))
        inner_stmts.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(names[j]), pky(names[j]), inf_te, v_j, 0, 0, 0, 0)), ck.cur_line, ck.cur_span))
    for j2 in range(nnames, pky(fbody)):
        inner_stmts.append(stmt_at(a, fbody, j2))
    ib: int = ast_stmt_list(a, inner_stmts)
    rng: int = mk_ident_call(a, "range", [mk_ident_node(a, n_name)])
    outer.append(mk_Stmt(a, mk_StmtKind_for_stmt(a, mk_ForStmt(a, pkx(ksr), pky(ksr), rng, pkx(ib), pky(ib), 0, 0, -1)), ck.cur_line, ck.cur_span))
    ob: int = ast_stmt_list(a, outer)
    ifp: int = mk_IfStmt(a, mk_Expr_bool_lit(a, 1), pkx(ob), pky(ob), 0, 0, 0, 0, 0, -1, 0)
    synth: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, ifp), ck.cur_line, ck.cur_span)
    check_stmt(ck, a, fx, synth)
    return True

def check_async_with(ck: Ck, a: Ast, fx: Fx, w: int) -> None:
    if not fx.in_async:
        fail2(ck, "TypeMismatch", "'async with' can only be used inside an 'async def' body or at the top level")
    ck.ext_cnt = ck.ext_cnt + 1
    mgr_name: str = "__nox_am_" + str(ck.ext_cnt)
    msr: int = syn(a, mgr_name)
    inf_sr: int = syn(a, "__infer")
    inf_te: int = mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr))
    enter_c: int = mk_attr_call_node(a, mk_ident_node(a, mgr_name), "__aenter__", pk(0, 0))
    exit_c: int = mk_attr_call_node(a, mk_ident_node(a, mgr_name), "__aexit__", pk(0, 0))
    vd0: int = mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(msr), pky(msr), inf_te, a.n[w + {{O:WithStmt.ctx_expr}}], 0, 0, 0, 0)), ck.cur_line, ck.cur_span)
    s1: int = -1
    if a.n[w + {{O:WithStmt.binding}}] != {{NONE}}:
        s1 = mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, a.n[w + {{O:WithStmt.binding}}], a.n[w + {{O:WithStmt.binding}} + 1], inf_te, enter_c, 0, 0, 0, 0)), ck.cur_line, ck.cur_span)
    else:
        s1 = mk_Stmt(a, mk_StmtKind_expr_stmt(a, enter_c), ck.cur_line, ck.cur_span)
    wbody: int = sl_at(a, w, {{O:WithStmt.body}})
    fin_sl: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_expr_stmt(a, exit_c), ck.cur_line, ck.cur_span)])
    ts2: int = mk_Stmt(a, mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(wbody), pky(wbody), 0, 0, pkx(fin_sl), pky(fin_sl), 0)), ck.cur_line, ck.cur_span)
    ob: int = ast_stmt_list(a, [vd0, s1, ts2])
    ifp: int = mk_IfStmt(a, mk_Expr_bool_lit(a, 1), pkx(ob), pky(ob), 0, 0, {{NONE}}, 0, 0, -1, 0)
    synth: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, ifp), ck.cur_line, ck.cur_span)
    check_stmt(ck, a, fx, synth)

def hoist_nested_async(ck: Ck, a: Ast, fx: Fx, st: int, fd: int) -> None:
    if pky(sl_at(a, fd, {{O:FuncDef.type_params}})) > 0:
        mp(ck, "a nested function definition CANNOT be generic: ")
        mp_sref(ck, a, pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1]))
        raise mk_fail(ck, "TypeMismatch")
    _ = check_nested_def(ck, a, fx, fd)
    cap_id: int = ck.last_nested_cap_id
    fn_sr: int = pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1])
    fn_sym: int = sym_of(ck, a, fn_sr)
    fn_str: str = sym_to_str(ck, fn_sym)
    cap_syms: list[int] = []
    cap_tys: list[int] = []
    cap_strs: list[str] = []
    for ci in range(len(ck.caps.k1)):
        if ck.caps.k1[ci] == cap_id and ck.caps.dead[ci] == 0:
            cs: int = ck.caps.k2[ci]
            ct: int = ck.caps.vv[ci]
            cap_syms.append(cs)
            cap_tys.append(ct)
            cap_strs.append(sym_to_str(ck, cs))
    n_caps: int = len(cap_syms)
    for si in range(n_caps):
        for sj in range(si + 1, n_caps):
            if cap_strs[sj] < cap_strs[si]:
                ts: str = cap_strs[si]
                cap_strs[si] = cap_strs[sj]
                cap_strs[sj] = ts
                tsy: int = cap_syms[si]
                cap_syms[si] = cap_syms[sj]
                cap_syms[sj] = tsy
                tty: int = cap_tys[si]
                cap_tys[si] = cap_tys[sj]
                cap_tys[sj] = tty
    pids: list[int] = []
    cap_start: int = len(fx.async_cap_pool)
    for k in range(n_caps):
        tg: int = ck.tt.tag[cap_tys[k]]
        if tg != 0 and tg != 1 and tg != 2 and tg != 3 and tg != 4 and tg != 16:
            mp(ck, "the nested 'async def' ")
            mp(ck, fn_str)
            mp(ck, " captures '")
            mp(ck, cap_strs[k])
            mp(ck, "', whose type cannot be shared with a task: a nested 'async def' may only capture int, float, bool, str and None values from the enclosing function — pass '")
            mp(ck, cap_strs[k])
            mp(ck, "' as a parameter instead")
            raise mk_fail(ck, "TypeMismatch")
        csr: int = syn(a, cap_strs[k])
        pids.append(mk_Param(a, pkx(csr), pky(csr), 0, 0, 0, 0, type_to_type_expr(ck, a, cap_tys[k]), 0, {{NONE}}))
        fx.async_cap_pool.append(cap_syms[k])
    fps: int = sl_at(a, fd, {{O:FuncDef.params}})
    for pi in range(pky(fps)):
        pids.append(stmt_at(a, fps, pi))
    psl: int = ast_stmt_list(a, pids)
    ck.nested_async_cnt = ck.nested_async_cnt + 1
    lifted_str: str = "__nested_async_" + fx.fn_path + "__" + fn_str + "_" + str(ck.nested_async_cnt)
    lsr: int = syn(a, lifted_str)
    cbody: int = subst_stmts(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), Map2())
    concrete: int = mk_FuncDef(a, pkx(lsr), pky(lsr), 0, 0, pkx(psl), pky(psl), a.n[fd + {{O:FuncDef.return_type}}], a.n[fd + {{O:FuncDef.ret_omitted}}], pkx(cbody), pky(cbody), 1, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, a.n[fd + {{O:FuncDef.allow_await}}], a.n[fd + {{O:FuncDef.line}}])
    register_func(ck, a, concrete)
    check_function_body(ck, a, concrete)
    lifted_sym: int = sym_lit(ck, lifted_str)
    m2_put(fx.async_locals, 0, fn_sym, lifted_sym)
    m2_put(fx.async_cap_s, 0, fn_sym, cap_start)
    m2_put(fx.async_cap_n, 0, fn_sym, n_caps)
    a.n[st + {{O:Stmt.kind}}] = mk_StmtKind_pass_stmt(a)

def is_fresh_cleanup_gen_call(ck: Ck, a: Ast, fx: Fx, e: int) -> bool:
    if ck.cleanup_gens.live == 0 or a.n[e] != {{T:Expr.call}}:
        return False
    cal: int = a.n[a.n[e + 1] + {{O:Call.callee}}]
    if a.n[cal] == {{T:Expr.identifier}}:
        return m2_get(ck.cleanup_gens, 0, sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2]))) >= 0
    if a.n[cal] == {{T:Expr.attribute}}:
        at: int = a.n[cal + 1]
        sv_c: int = len(ck.mb)
        sv_l: int = ck.cur_line
        sv_s: int = ck.cur_span
        ot: int = -1
        try:
            ot = check_expr(ck, a, fx, a.n[at + {{O:Attribute.obj}}])
        except CkErr:
            ck.mb = ck.mb[:sv_c]
            ck.cur_line = sv_l
            ck.cur_span = sv_s
            return False
        if ck.tt.tag[ot] != 6:
            return False
        key: str = sym_to_str(ck, ck.tt.xa[ot]) + "." + sym_to_str(ck, sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])))
        return m2_get(ck.cleanup_gens, 0, sym_lit(ck, key)) >= 0
    return False

def check_lazy_for(ck: Ck, a: Ast, fx: Fx, f: int, it_t: int) -> None:
    ck.ext_cnt = ck.ext_cnt + 1
    eid: int = ck.ext_cnt
    it_name: str = "__nox_lz_" + str(eid)
    nx_name: str = "__nox_lzv_" + str(eid)
    itsr: int = syn(a, it_name)
    nxsr: int = syn(a, nx_name)
    inf_sr: int = syn(a, "__infer")
    inf_te: int = mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr))
    fbody: int = sl_at(a, f, {{O:ForStmt.body}})
    then_stmts: list[int] = []
    then_stmts.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, a.n[f + {{O:ForStmt.var_name}}], a.n[f + {{O:ForStmt.var_name}} + 1], inf_te, mk_ident_node(a, nx_name), 0, 0, 0, 0)), ck.cur_line, ck.cur_span))
    for i in range(pky(fbody)):
        then_stmts.append(stmt_at(a, fbody, i))
    tb: int = ast_stmt_list(a, then_stmts)
    eb: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_break_stmt(a), ck.cur_line, ck.cur_span)])
    cond: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.ne}}, mk_ident_node(a, nx_name), mk_Expr_none_lit(a), 0, 0, 0, 0))
    inner_if: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, cond, pkx(tb), pky(tb), 0, 0, pkx(eb), pky(eb), 0, -1, 0)), ck.cur_line, ck.cur_span)
    nx_call: int = mk_attr_call_node(a, mk_ident_node(a, it_name), "__next__", pk(0, 0))
    lb: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(nxsr), pky(nxsr), inf_te, nx_call, 0, 0, 0, 0)), ck.cur_line, ck.cur_span), inner_if])
    wh: int = mk_Stmt(a, mk_StmtKind_while_stmt(a, mk_WhileStmt(a, mk_Expr_bool_lit(a, 1), pkx(lb), pky(lb), -1)), ck.cur_line, ck.cur_span)
    loop_st: int = wh
    if is_fresh_cleanup_gen_call(ck, a, fx, a.n[f + {{O:ForStmt.iterable}}]):
        cc_call: int = mk_attr_call_node(a, mk_ident_node(a, it_name), "close", pk(0, 0))
        fin_sl: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_expr_stmt(a, cc_call), ck.cur_line, ck.cur_span)])
        gs_sl: int = ast_stmt_list(a, [wh])
        loop_st = mk_Stmt(a, mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(gs_sl), pky(gs_sl), 0, 0, pkx(fin_sl), pky(fin_sl), 0)), ck.cur_line, ck.cur_span)
    it_te: int = type_to_type_expr(ck, a, it_t)
    ob: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(itsr), pky(itsr), it_te, a.n[f + {{O:ForStmt.iterable}}], 0, 0, 0, 0)), ck.cur_line, ck.cur_span), loop_st])
    ifp: int = mk_IfStmt(a, mk_Expr_bool_lit(a, 1), pkx(ob), pky(ob), 0, 0, 0, 0, 0, -1, 0)
    synth: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, ifp), ck.cur_line, ck.cur_span)
    check_stmt(ck, a, fx, synth)

# `checkForIterable`: range(...) / list / str / dict / sınıf yineleyicisi. Dönüş: eleman tipi.
def check_for_iterable(ck: Ck, a: Ast, fx: Fx, it: int) -> int:
    if a.n[it] == {{T:Expr.call}}:
        c: int = a.n[it + 1]
        callee: int = a.n[c + {{O:Call.callee}}]
        if a.n[callee] == {{T:Expr.identifier}}:
            cv: int = pk(a.n[callee + 1], a.n[callee + 2])
            if sref_eq(a, cv, "range"):
                args: int = sl_at(a, c, {{O:Call.args}})
                n: int = pky(args)
                if n < 1 or n > 3:
                    mp(ck, "'range' takes 1, 2 or 3 arguments (stop | start, stop | start, stop, step)")
                    raise mk_fail(ck, "ArgumentCountMismatch")
                for i in range(n):
                    at_: int = check_expr(ck, a, fx, stmt_at(a, args, i))
                    if at_ != 0:
                        mp(ck, "'range' expects an int argument")
                        raise mk_fail(ck, "TypeMismatch")
                if n == 3:
                    sa: int = stmt_at(a, args, 2)
                    if a.n[sa] == {{T:Expr.int_lit}} and a.n[sa + 1] == 0:
                        mp(ck, "the 'range' step cannot be zero")
                        raise mk_fail(ck, "TypeMismatch")
                return 0
    t: int = check_expr(ck, a, fx, it)
    tt: TT = ck.tt
    if tt.tag[t] == 6:
        ci_nx: int = class_idx_of_type(ck, t)
        if ci_nx >= 0 and not is_tuple_cls(ck, ci_nx):
            nxe: int = m2_get(ck.cls_meths, ci_nx, sym_lit(ck, "__next__"))
            if nxe >= 0:
                nxsid: int = ck.cls_meths.vv[nxe]
                nxret: int = ck.fret[nxsid]
                if ck.fpn[nxsid] == 0 and tt.tag[nxret] == 15:
                    ck.lazy_for_iter = t
                    return tt.xa[nxret]
    if has_dunder(ck, t, "__iter__"):
        t = check_expr(ck, a, fx, mk_dunder_call(a, it, "__iter__", []))
    g: int = tt.tag[t]
    if g == 5:
        return tt.xa[t]
    if t == 3:
        return 3
    if g == 18:
        check_expr(ck, a, fx, mk_ident_call(a, "__nox_bytes_ints", [it]))
        return 0
    if g == 13:
        return tt.xa[t]
    mp(ck, "'for' cannot iterate over this expression (it must be a list/str/dict/range or a class with `__iter__`)")
    raise mk_fail(ck, "NotIterable")

# ---- sınıf yardımcıları (3.4a) ----
def class_idx(ck: Ck, sym: int) -> int:
    e: int = m2_get(ck.cls_map, 0, sym)
    if e < 0:
        return -1
    return ck.cls_map.vv[e]

def class_idx_of_type(ck: Ck, t: int) -> int:
    if ck.tt.tag[t] != 6:
        return -1
    return class_idx(ck, ck.tt.xa[t])

def sym_lit(ck: Ck, s: str) -> int:
    xs: list[int] = []
    for i in range(len(s)):
        xs.append(ord(s[i]))
    return sym_intern_list(ck.tt, xs, 0, len(xs))

# ---- 3.12 modül sistemi/import (Zig `collectImports`, `substituteAlias`, `resolveMangledCall`, `tryResolveQualifiedCall`, `resolveReExportChains`) ----
# Ham `check` kipi: tek dosya, yükleyici yok (`module_exports` boş, `requirePublic`/`validateModuleExports` işlemsiz); içe aktarılan modülün tanımları hiç yoktur, mangled adlar yalnız dosyada elle tanımlıysa bulunur.
# `segs` öğelerinin ilk `n` tanesini `sep` (46 = '.', 95 = '_') ile birleştirip sembole çevirir (Zig `joinSegments`).
def join_syms(ck: Ck, segs: list[int], n: int, sep: int) -> int:
    tt: TT = ck.tt
    bs: list[int] = []
    for i in range(n):
        if i > 0:
            bs.append(sep)
        o: int = tt.so[segs[i]]
        for j in range(tt.sl[segs[i]]):
            bs.append(tt.sb[o + j])
    return sym_intern_list(tt, bs, 0, len(bs))

# AST dize listesi (2 sözcüklük öğeler: `ImportStmt.segments`, `TypeExpr.qualified`) -> sembol listesi.
def seg_syms(ck: Ck, a: Ast, node: int, off: int) -> list[int]:
    s: int = sl_at(a, node, off)
    out: list[int] = []
    for i in range(pky(s)):
        out.append(sym_of(ck, a, pk(a.l[pkx(s) + i * 2], a.l[pkx(s) + i * 2 + 1])))
    return out

def alias_put(ck: Ck, al: int, segs: list[int]) -> None:
    off: int = len(ck.alp)
    ck.alp.append(len(segs))
    for i in range(len(segs)):
        ck.alp.append(segs[i])
    m2_put(ck.alias, 0, al, off)

# Zig `substituteAlias`: ilk segment bir modül takma adıysa hedef modülün segmentleriyle değiştirilir.
def subst_alias(ck: Ck, segs: list[int]) -> list[int]:
    if len(segs) == 0:
        return segs
    e: int = m2_get(ck.alias, 0, segs[0])
    if e < 0:
        return segs
    off: int = ck.alias.vv[e]
    out: list[int] = []
    for i in range(ck.alp[off]):
        out.append(ck.alp[off + 1 + i])
    for j in range(len(segs) - 1):
        out.append(segs[j + 1])
    return out

# Zig `checkModuleCapabilitiesAllowed` (varsayılan yapılandırma: hosted profil, wasm/mobil/`--deny-capability` yok): yalnız `nox.arch` (`arch_x86_64` yeteneği, yalnız freestanding sağlar) reddedilir.
def check_module_caps(ck: Ck, segs: list[int]) -> None:
    if len(segs) < 2 or segs[0] != sym_lit(ck, "nox"):
        return
    if segs[1] == sym_lit(ck, "arch"):
        mp(ck, "module 'nox.")
        mp_sym(ck, segs[1])
        mp(ck, "' cannot be used in the 'hosted' profile (required capability: 'arch_x86_64' — this profile does not provide it; it is only available in 'freestanding')")
        raise mk_fail(ck, "HostedModuleForbidden")

# Zig `collectImports` (Geçiş 0): `imported_modules`, `module_aliases`, `from_imports`, `from_imports_orig_name`.
def collect_imports(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        pay: int = a.n[kn + 1]
        if a.n[kn] == {{T:StmtKind.import_stmt}}:
            segs: list[int] = seg_syms(ck, a, pay, {{O:ImportStmt.segments}})
            m2_put(ck.imod, 0, join_syms(ck, segs, len(segs), 46), 1)
            if a.n[pay + {{O:ImportStmt.alias}}] != {{NONE}}:
                alias_put(ck, sym_of(ck, a, pk(a.n[pay + {{O:ImportStmt.alias}}], a.n[pay + {{O:ImportStmt.alias}} + 1])), segs)
            check_module_caps(ck, segs)
        elif a.n[kn] == {{T:StmtKind.from_import_stmt}}:
            fsegs: list[int] = seg_syms(ck, a, pay, {{O:FromImportStmt.segments}})
            m2_put(ck.imod, 0, join_syms(ck, fsegs, len(fsegs), 46), 1)
            names: int = sl_at(a, pay, {{O:FromImportStmt.names}})
            for k in range(pky(names)):
                nm: int = a.l[pkx(names) + k]
                nsym: int = sym_of(ck, a, pk(a.n[nm + {{O:FromImportName.name}}], a.n[nm + {{O:FromImportName.name}} + 1]))
                full: list[int] = []
                for q in range(len(fsegs)):
                    full.append(fsegs[q])
                full.append(nsym)
                local: int = nsym
                if a.n[nm + {{O:FromImportName.alias}}] != {{NONE}}:
                    local = sym_of(ck, a, pk(a.n[nm + {{O:FromImportName.alias}}], a.n[nm + {{O:FromImportName.alias}} + 1]))
                m2_put(ck.fimp, 0, local, join_syms(ck, full, len(full), 95))
                m2_put(ck.forig, 0, local, nsym)
            check_module_caps(ck, fsegs)

# Birleştirilmiş gövdede `mangled` adlı üst-düzey değişken/sabit bildirimi var mı (Zig `moduleDeclaresVar`).
def module_declares_var(ck: Ck, a: Ast, body: int, ms: int) -> bool:
    for i in range(pky(body)):
        kn: int = a.n[stmt_at(a, body, i) + {{O:Stmt.kind}}]
        if a.n[kn] == {{T:StmtKind.var_decl}}:
            vd: int = a.n[kn + 1]
            if sym_of(ck, a, pk(a.n[vd + {{O:VarDecl.name}}], a.n[vd + {{O:VarDecl.name}} + 1])) == ms:
                return True
    return False

def name_resolves(ck: Ck, a: Ast, body: int, ms: int) -> bool:
    return class_idx(ck, ms) >= 0 or m2_get(ck.fmap, 0, ms) >= 0 or module_declares_var(ck, a, body, ms)

# Zig `resolveReExportChains` (idempotent; `registerSignatures`ten önce ve sonra): geçersiz `from_imports` girdilerini, aynı adı gerçekten tanımlayan başka bir `from` deyiminin mangled adıyla düzeltir.
def resolve_reexport(ck: Ck, a: Ast, body: int) -> None:
    ex: Map2 = Map2()
    for i in range(pky(body)):
        kn: int = a.n[stmt_at(a, body, i) + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.from_import_stmt}}:
            continue
        pay: int = a.n[kn + 1]
        fsegs: list[int] = seg_syms(ck, a, pay, {{O:FromImportStmt.segments}})
        names: int = sl_at(a, pay, {{O:FromImportStmt.names}})
        for k in range(pky(names)):
            nm: int = a.l[pkx(names) + k]
            nsym: int = sym_of(ck, a, pk(a.n[nm + {{O:FromImportName.name}}], a.n[nm + {{O:FromImportName.name}} + 1]))
            if m2_get(ex, 0, nsym) >= 0:
                continue
            full: list[int] = []
            for q in range(len(fsegs)):
                full.append(fsegs[q])
            full.append(nsym)
            ms: int = join_syms(ck, full, len(full), 95)
            if name_resolves(ck, a, body, ms):
                m2_put(ex, 0, nsym, ms)
    fk: list[int] = []
    fv: list[int] = []
    for e in range(len(ck.fimp.k1)):
        if ck.fimp.dead[e] != 0:
            continue
        cur: int = ck.fimp.vv[e]
        if name_resolves(ck, a, body, cur):
            continue
        oe: int = m2_get(ck.forig, 0, ck.fimp.k2[e])
        if oe < 0:
            continue
        ce: int = m2_get(ex, 0, ck.forig.vv[oe])
        if ce < 0:
            continue
        fk.append(ck.fimp.k2[e])
        fv.append(ex.vv[ce])
    for u in range(len(fk)):
        m2_put(ck.fimp, 0, fk[u], fv[u])

# Zig `flattenDottedPath`: yalnız `.identifier`/`.attribute` zinciri ise sembolleri (soldan sağa) `out`a ekler.
def flatten_dotted(ck: Ck, a: Ast, e: int, out: list[int]) -> bool:
    if a.n[e] == {{T:Expr.identifier}}:
        out.append(sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2])))
        return True
    if a.n[e] == {{T:Expr.attribute}}:
        at: int = a.n[e + 1]
        if not flatten_dotted(ck, a, a.n[at + {{O:Attribute.obj}}], out):
            return False
        out.append(sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])))
        return True
    return False

# Zig `isVariableInScope`: yerel/parametre/yakalanan ya da modül düzeyi değişken.
def is_variable_in_scope(ck: Ck, fx: Fx, sym: int) -> bool:
    return sc_exists(ck, fx.scope, sym) or m2_get(ck.globs, 0, sym) >= 0

# Zig `resolveMangledCall` (generic işlev/sınıf bu kipte yoktur): mangled ad işlev ya da sınıf mı; değilse `nf_kind` ile bulunamadı iletisi.
# nf_kind 0 (from-import): "'<s1>' could not be imported (the source module has no member named '<s2>')"; 1 (nitelikli çağrı): "module '<s1>' has no member named '<s2>'".
def resolve_mangled_call(ck: Ck, a: Ast, fx: Fx, c: int, ms: int, nf_kind: int, s1: int, s2: int) -> int:
    gfe: int = m2_get(ck.gfn, 0, ms)
    if gfe >= 0:
        check_capability_call(ck, ms)
        return instantiate_generic_func(ck, a, fx, ck.gfn.vv[gfe], ms, sl_at(a, c, {{O:Call.args}}), [], False)
    fe: int = m2_get(ck.fmap, 0, ms)
    if fe >= 0:
        if m2_get(ck.afn, 0, ms) >= 0:
            mp(ck, "'")
            mp_sym(ck, ms)
            mp(ck, "' is an 'async def' function and can only be started with 'spawn'")
            raise mk_fail(ck, "TypeMismatch")
        sid: int = ck.fmap.vv[fe]
        check_args_sig(ck, a, fx, c, sid, ms)
        check_capability_call(ck, ms)
        return ck.fret[sid]
    ci: int = class_idx(ck, ms)
    if ci >= 0:
        isid: int = ck.cls_init[ci]
        if isid < 0:
            isid = ck.sig_empty
        check_args_sig(ck, a, fx, c, isid, ms)
        return ty_class(ck.tt, ms)
    if nf_kind == 0:
        mp(ck, "'")
        mp_sym(ck, s1)
        mp(ck, "' could not be imported (the source module has no member named '")
        mp_sym(ck, s2)
        mp(ck, "')")
    else:
        mp(ck, "module '")
        mp_sym(ck, s1)
        mp(ck, "' has no member named '")
        mp_sym(ck, s2)
        mp(ck, "'")
    raise mk_fail(ck, "UndefinedFunction")

# `matchIntrinsicKind`: `nox.http.serve*` / `nox.thread.start|pool_run` çağrıları (özel çözümleme: kapsam dışı).
def is_intrinsic_call(ck: Ck, segs: list[int]) -> bool:
    if len(segs) != 3 or segs[0] != sym_lit(ck, "nox"):
        return False
    if m2_get(ck.imod, 0, join_syms(ck, segs, 2, 46)) < 0:
        return False
    if segs[1] == sym_lit(ck, "http"):
        for nm in ["serve", "serve_fd", "serve_multicore", "serve_tls", "serve_ws", "serve_ws_tls", "serve_fd_tls", "serve_fd_ws", "serve_fd_ws_tls", "serve_multicore_tls", "serve_multicore_ws", "serve_multicore_ws_tls"]:
            if segs[2] == sym_lit(ck, nm):
                return True
        return False
    if segs[1] == sym_lit(ck, "thread"):
        return segs[2] == sym_lit(ck, "start") or segs[2] == sym_lit(ck, "pool_run")
    return False

def is_thread_transfer_safe_type(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return g != 9 and g != 14 and g != 15

def is_http_handler_factory(ck: Ck, nsym: int) -> bool:
    if m2_get(ck.afn, 0, nsym) >= 0:
        return False
    fi: int = m2_get(ck.fmap, 0, nsym)
    if fi < 0:
        return False
    sid: int = ck.fmap.vv[fi]
    if ck.fpn[sid] != 0:
        return False
    rt: int = ck.fret[sid]
    tt: TT = ck.tt
    if tt.tag[rt] != 14 or tt.xc[rt] != 1:
        return False
    p0: int = tt.fp[tt.xa[rt]]
    r0: int = tt.xb[rt]
    return tt.tag[p0] == 6 and tt.xa[p0] == sym_lit(ck, "nox_http_HttpRequest") and tt.tag[r0] == 6 and tt.xa[r0] == sym_lit(ck, "nox_http_HttpResponse")

def validate_named_http_handler(ck: Ck, fn_label: str, hsym: int) -> None:
    if m2_get(ck.afn, 0, hsym) >= 0:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' ('")
        mp_sym(ck, hsym)
        mp(ck, "') CANNOT be an 'async def' (the connection handler already runs synchronously in its own fiber)")
        raise mk_fail(ck, "TypeMismatch")
    fi: int = m2_get(ck.fmap, 0, hsym)
    if fi < 0:
        mp(ck, "undefined function: ")
        mp_sym(ck, hsym)
        raise mk_fail(ck, "UndefinedFunction")
    sid: int = ck.fmap.vv[fi]
    if ck.fpn[sid] != 1:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' must take EXACTLY one parameter (an HttpRequest)")
        raise mk_fail(ck, "TypeMismatch")
    p0: int = ck.fpar[ck.fps[sid]]
    if ck.tt.tag[p0] != 6 or ck.tt.xa[p0] != sym_lit(ck, "nox_http_HttpRequest"):
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': the parameter of 'handle' must be 'HttpRequest'")
        raise mk_fail(ck, "TypeMismatch")
    r0: int = ck.fret[sid]
    if ck.tt.tag[r0] != 6 or ck.tt.xa[r0] != sym_lit(ck, "nox_http_HttpResponse"):
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' must return an 'HttpResponse'")
        raise mk_fail(ck, "TypeMismatch")

def validate_http_handler(ck: Ck, a: Ast, fx: Fx, fn_label: str, he: int, allow_closure: bool) -> None:
    if a.n[he] == {{T:Expr.identifier}}:
        hsym: int = sym_of(ck, a, pk(a.n[he + 1], a.n[he + 2]))
        if sc_lookup(ck, fx.scope, hsym) < 0:
            if not allow_closure and is_http_handler_factory(ck, hsym):
                return
            validate_named_http_handler(ck, fn_label, hsym)
            return
    if not allow_closure:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' must be a plain function name (a closure handler is NOT supported in this variant: in the default build the multicore workers use a SEPARATE RuntimeState, so a closure from the main runtime cannot be passed to them; pass a FACTORY instead: a top-level function with no parameters that returns the handler closure, called once per worker)")
        raise mk_fail(ck, "NotCallable")
    t: int = check_expr(ck, a, fx, he)
    tt: TT = ck.tt
    if tt.tag[t] != 14:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' must be a function name or a closure of type '(HttpRequest) -> HttpResponse'")
        raise mk_fail(ck, "NotCallable")
    if tt.xc[t] != 1:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' must take EXACTLY one parameter (an HttpRequest)")
        raise mk_fail(ck, "TypeMismatch")
    p0: int = tt.fp[tt.xa[t]]
    if tt.tag[p0] != 6 or tt.xa[p0] != sym_lit(ck, "nox_http_HttpRequest"):
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': the parameter of 'handle' must be 'HttpRequest'")
        raise mk_fail(ck, "TypeMismatch")
    r0: int = tt.xb[t]
    if tt.tag[r0] != 6 or tt.xa[r0] != sym_lit(ck, "nox_http_HttpResponse"):
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'handle' must return an 'HttpResponse'")
        raise mk_fail(ck, "TypeMismatch")

def validate_ws_handler(ck: Ck, a: Ast, fn_label: str, he: int) -> None:
    if a.n[he] != {{T:Expr.identifier}}:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'ws_handle' must be a plain function name (methods/lambdas are not supported yet)")
        raise mk_fail(ck, "NotCallable")
    hsym: int = sym_of(ck, a, pk(a.n[he + 1], a.n[he + 2]))
    if m2_get(ck.afn, 0, hsym) >= 0:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'ws_handle' ('")
        mp_sym(ck, hsym)
        mp(ck, "') CANNOT be an 'async def' (the WS session already runs synchronously in its own fiber)")
        raise mk_fail(ck, "TypeMismatch")
    fi: int = m2_get(ck.fmap, 0, hsym)
    if fi < 0:
        mp(ck, "undefined function: ")
        mp_sym(ck, hsym)
        raise mk_fail(ck, "UndefinedFunction")
    sid: int = ck.fmap.vv[fi]
    if ck.fpn[sid] != 1:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'ws_handle' must take EXACTLY one parameter (a WebSocketServerConn)")
        raise mk_fail(ck, "TypeMismatch")
    p0: int = ck.fpar[ck.fps[sid]]
    if ck.tt.tag[p0] != 6 or ck.tt.xa[p0] != sym_lit(ck, "nox_websocket_WebSocketServerConn"):
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': the parameter of 'ws_handle' must be 'WebSocketServerConn'")
        raise mk_fail(ck, "TypeMismatch")
    if ck.fret[sid] != 4:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'ws_handle' must return 'None'")
        raise mk_fail(ck, "TypeMismatch")

def check_http_serve_base(ck: Ck, a: Ast, fx: Fx, c: int, fn_label: str, first_arg: str, is_multicore: bool) -> int:
    cargs: int = sl_at(a, c, {{O:Call.args}})
    nargs: int = pky(cargs)
    if not is_multicore:
        if nargs != 2 and nargs != 3:
            mp(ck, "'")
            mp(ck, fn_label)
            mp(ck, "' takes 2 or 3 arguments: (")
            mp(ck, first_arg)
            mp(ck, ", handle[, max_connections])")
            raise mk_fail(ck, "ArgumentCountMismatch")
        if check_expr(ck, a, fx, stmt_at(a, cargs, 0)) != 0:
            mp(ck, "'")
            mp(ck, fn_label)
            mp(ck, "': '")
            mp(ck, first_arg)
            mp(ck, "' must be an 'int'")
            raise mk_fail(ck, "TypeMismatch")
        if nargs == 3 and check_expr(ck, a, fx, stmt_at(a, cargs, 2)) != 0:
            mp(ck, "'")
            mp(ck, fn_label)
            mp(ck, "': 'max_connections' must be an 'int'")
            raise mk_fail(ck, "TypeMismatch")
        validate_http_handler(ck, a, fx, fn_label, stmt_at(a, cargs, 1), True)
        return 4
    if nargs != 3 and nargs != 4:
        mp(ck, "'nox.http.serve_multicore' takes 3 or 4 arguments: (port, handle, num_threads[, max_connections])")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if check_expr(ck, a, fx, stmt_at(a, cargs, 0)) != 0:
        mp(ck, "'nox.http.serve_multicore': 'port' must be an 'int'")
        raise mk_fail(ck, "TypeMismatch")
    if check_expr(ck, a, fx, stmt_at(a, cargs, 2)) != 0:
        mp(ck, "'nox.http.serve_multicore': 'num_threads' must be an 'int'")
        raise mk_fail(ck, "TypeMismatch")
    if nargs == 4 and a.n[stmt_at(a, cargs, 3)] != {{T:Expr.int_lit}}:
        mp(ck, "'nox.http.serve_multicore': 'max_connections' must be a constant integer (not a VARIABLE/expression — it is embedded in ALL worker functions at compile time)")
        raise mk_fail(ck, "TypeMismatch")
    validate_http_handler(ck, a, fx, "nox.http.serve_multicore", stmt_at(a, cargs, 1), False)
    return 4

def check_http_serve_generic(ck: Ck, a: Ast, fx: Fx, c: int, name: str, is_multicore: bool, want_ws: bool, want_tls: bool) -> int:
    fn_label: str = "nox.http." + name
    nxt: int = 2
    nt_idx: int = -1
    if is_multicore:
        nt_idx = nxt
        nxt = nxt + 1
    ws_idx: int = -1
    if want_ws:
        ws_idx = nxt
        nxt = nxt + 1
    cert_idx: int = -1
    key_idx: int = -1
    if want_tls:
        cert_idx = nxt
        key_idx = nxt + 1
        nxt = nxt + 2
    min_args: int = nxt
    max_args: int = nxt + 1
    cargs: int = sl_at(a, c, {{O:Call.args}})
    nargs: int = pky(cargs)
    if nargs != min_args and nargs != max_args:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "' takes ")
        mp_int(ck, min_args)
        mp(ck, " or ")
        mp_int(ck, max_args)
        mp(ck, " arguments")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if check_expr(ck, a, fx, stmt_at(a, cargs, 0)) != 0:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': '")
        mp(ck, "port" if is_multicore else "port/fd")
        mp(ck, "' must be an 'int'")
        raise mk_fail(ck, "TypeMismatch")
    if nt_idx >= 0 and check_expr(ck, a, fx, stmt_at(a, cargs, nt_idx)) != 0:
        mp(ck, "'")
        mp(ck, fn_label)
        mp(ck, "': 'num_threads' must be an 'int'")
        raise mk_fail(ck, "TypeMismatch")
    if nargs == max_args:
        max_e: int = stmt_at(a, cargs, max_args - 1)
        if is_multicore:
            if a.n[max_e] != {{T:Expr.int_lit}}:
                mp(ck, "'")
                mp(ck, fn_label)
                mp(ck, "': 'max_connections' must be a constant integer (it is embedded in the worker functions at compile time)")
                raise mk_fail(ck, "TypeMismatch")
        elif check_expr(ck, a, fx, max_e) != 0:
            mp(ck, "'")
            mp(ck, fn_label)
            mp(ck, "': 'max_connections' must be an 'int'")
            raise mk_fail(ck, "TypeMismatch")
    if cert_idx >= 0:
        if check_expr(ck, a, fx, stmt_at(a, cargs, cert_idx)) != 3:
            mp(ck, "'")
            mp(ck, fn_label)
            mp(ck, "': 'cert_path' must be a 'str'")
            raise mk_fail(ck, "TypeMismatch")
        if check_expr(ck, a, fx, stmt_at(a, cargs, key_idx)) != 3:
            mp(ck, "'")
            mp(ck, fn_label)
            mp(ck, "': 'key_path' must be a 'str'")
            raise mk_fail(ck, "TypeMismatch")
    validate_http_handler(ck, a, fx, fn_label, stmt_at(a, cargs, 1), not is_multicore)
    if ws_idx >= 0:
        validate_ws_handler(ck, a, fn_label, stmt_at(a, cargs, ws_idx))
    return 4

def check_thread_start(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    cargs: int = sl_at(a, c, {{O:Call.args}})
    if pky(cargs) != 2:
        mp(ck, "'nox.thread.start' takes exactly 2 arguments: (entry, arg)")
        raise mk_fail(ck, "ArgumentCountMismatch")
    e0: int = stmt_at(a, cargs, 0)
    if a.n[e0] != {{T:Expr.identifier}}:
        mp(ck, "'nox.thread.start': 'entry' must be a plain function name (methods/lambdas are not supported yet)")
        raise mk_fail(ck, "NotCallable")
    esym: int = sym_of(ck, a, pk(a.n[e0 + 1], a.n[e0 + 2]))
    fi: int = m2_get(ck.fmap, 0, esym)
    if fi < 0:
        mp(ck, "undefined function: ")
        mp_sym(ck, esym)
        raise mk_fail(ck, "UndefinedFunction")
    if m2_get(ck.afn, 0, esym) < 0:
        mp(ck, "'nox.thread.start': 'entry' ('")
        mp_sym(ck, esym)
        mp(ck, "') MUST be an 'async def' (it runs as the single top-level task of its own independent thread)")
        raise mk_fail(ck, "TypeMismatch")
    sid: int = ck.fmap.vv[fi]
    if ck.fpn[sid] != 1:
        mp(ck, "'nox.thread.start': 'entry' must take EXACTLY one parameter")
        raise mk_fail(ck, "TypeMismatch")
    p0: int = ck.fpar[ck.fps[sid]]
    if not is_thread_transfer_safe_type(ck, p0):
        mp(ck, "'nox.thread.start': the parameter type of 'entry' is not safe across threads (only int/float/bool/str/None/ptr, and additionally task/channel/list/class/dict on hosted targets)")
        raise mk_fail(ck, "TypeMismatch")
    if not is_thread_transfer_safe_type(ck, ck.fret[sid]):
        mp(ck, "'nox.thread.start': the return type of 'entry' is not safe across threads (only int/float/bool/str/None/ptr, and additionally task/channel/list/class/dict on hosted targets)")
        raise mk_fail(ck, "TypeMismatch")
    arg_t: int = check_expr(ck, a, fx, stmt_at(a, cargs, 1))
    if not assignable_or_coerce(ck, a, p0, arg_t):
        mp(ck, "'nox.thread.start': the type of 'arg' does not match the parameter type of 'entry'")
        raise mk_fail(ck, "TypeMismatch")
    return ty_mk(ck.tt, 9, ck.fret[sid], 0)

def check_thread_pool_run(ck: Ck, a: Ast, fx: Fx, c: int) -> int:
    cargs: int = sl_at(a, c, {{O:Call.args}})
    if pky(cargs) != 2:
        mp(ck, "'nox.thread.pool_run' takes exactly 2 arguments: (num_workers, entry)")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if check_expr(ck, a, fx, stmt_at(a, cargs, 0)) != 0:
        mp(ck, "'nox.thread.pool_run': 'num_workers' must be an int")
        raise mk_fail(ck, "TypeMismatch")
    e1: int = stmt_at(a, cargs, 1)
    if a.n[e1] != {{T:Expr.identifier}}:
        mp(ck, "'nox.thread.pool_run': 'entry' must be a plain function name (methods/lambdas are not supported yet)")
        raise mk_fail(ck, "NotCallable")
    esym: int = sym_of(ck, a, pk(a.n[e1 + 1], a.n[e1 + 2]))
    fi: int = m2_get(ck.fmap, 0, esym)
    if fi < 0:
        mp(ck, "undefined function: ")
        mp_sym(ck, esym)
        raise mk_fail(ck, "UndefinedFunction")
    if m2_get(ck.afn, 0, esym) < 0:
        mp(ck, "'nox.thread.pool_run': 'entry' ('")
        mp_sym(ck, esym)
        mp(ck, "') MUST be an 'async def' (it runs as the single top-level task of the pool's single driver worker)")
        raise mk_fail(ck, "TypeMismatch")
    sid: int = ck.fmap.vv[fi]
    if ck.fpn[sid] != 0:
        mp(ck, "'nox.thread.pool_run': 'entry' must take ZERO parameters")
        raise mk_fail(ck, "TypeMismatch")
    if ck.fret[sid] != 4:
        mp(ck, "'nox.thread.pool_run': 'entry' must not return anything (-> None)")
        raise mk_fail(ck, "TypeMismatch")
    return 4

def check_intrinsic_call(ck: Ck, a: Ast, fx: Fx, c: int, segs: list[int]) -> int:
    if segs[1] == sym_lit(ck, "thread"):
        if segs[2] == sym_lit(ck, "start"):
            return check_thread_start(ck, a, fx, c)
        return check_thread_pool_run(ck, a, fx, c)
    nm: str = sym_to_str(ck, segs[2])
    if nm == "serve":
        return check_http_serve_base(ck, a, fx, c, "nox.http.serve", "port", False)
    if nm == "serve_fd":
        return check_http_serve_base(ck, a, fx, c, "nox.http.serve_fd", "fd", False)
    if nm == "serve_multicore":
        return check_http_serve_base(ck, a, fx, c, "nox.http.serve_multicore", "port", True)
    is_mc: bool = nm == "serve_multicore_tls" or nm == "serve_multicore_ws" or nm == "serve_multicore_ws_tls"
    want_ws: bool = nm == "serve_ws" or nm == "serve_ws_tls" or nm == "serve_fd_ws" or nm == "serve_fd_ws_tls" or nm == "serve_multicore_ws" or nm == "serve_multicore_ws_tls"
    want_tls: bool = nm == "serve_tls" or nm == "serve_ws_tls" or nm == "serve_fd_tls" or nm == "serve_fd_ws_tls" or nm == "serve_multicore_tls" or nm == "serve_multicore_ws_tls"
    return check_http_serve_generic(ck, a, fx, c, nm, is_mc, want_ws, want_tls)

# Zig `tryResolveQualifiedCall` (öncesinde `matchIntrinsicKind`): modül-nitelikli çağrı `mod.f(...)`. -1: uygulanmaz (normal metod çağrısı çözümlemesine devam).
def qualified_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    if len(ck.imod.k1) == 0:
        return -1
    raw: list[int] = []
    if not flatten_dotted(ck, a, callee, raw) or len(raw) < 2:
        return -1
    segs: list[int] = subst_alias(ck, raw)
    if is_intrinsic_call(ck, segs):
        return check_intrinsic_call(ck, a, fx, c, segs)
    if is_variable_in_scope(ck, fx, raw[0]):
        return -1
    n: int = len(segs)
    mod: int = join_syms(ck, segs, n - 1, 46)
    if m2_get(ck.imod, 0, mod) < 0:
        return -1
    return resolve_mangled_call(ck, a, fx, c, join_syms(ck, segs, n, 95), 1, mod, segs[n - 1])

# `hasDunder`: sınıfta o adlı METOD var mı (sentezlenen tuple sınıfı dunder taşımaz; varsa yeniden yazım gerekir: kapsam dışı).
def has_dunder(ck: Ck, t: int, name: str) -> bool:
    ci: int = class_idx_of_type(ck, t)
    if ci < 0 or is_tuple_cls(ck, ci):
        return False
    return m2_get(ck.cls_meths, ci, sym_lit(ck, name)) >= 0

# imza: params + dönüş + parametre adları (`fpar/fpnm` havuzu); işlev, metod ve `__init__` ortak
def new_sig(ck: Ck, tys: list[int], names: list[int], ret: int) -> int:
    idx: int = len(ck.fps)
    ck.fps.append(len(ck.fpar))
    ck.fpn.append(len(tys))
    ck.fret.append(ret)
    ck.fdecl.append(-1)
    for q in range(len(tys)):
        ck.fpar.append(tys[q])
        ck.fpnm.append(names[q])
    return idx

def is_tuple_cls(ck: Ck, ci: int) -> bool:
    return ci >= 0 and ck.tup_s[ci] >= 0

def mangle_name(ck: Ck, base: str, elems: list[int]) -> int:
    tt: TT = ck.tt
    bs: list[int] = []
    for i in range(len(base)):
        bs.append(ord(base[i]))
    bs.append(95)
    bs.append(95)
    for j in range(len(elems)):
        if j > 0:
            bs.append(95)
        tt.out = []
        ty_mangle(tt, elems[j])
        for k in range(len(tt.out)):
            bs.append(tt.out[k])
    return sym_intern_list(tt, bs, 0, len(bs))

# `instantiateTupleClass`: `tuple[T1, ..., Tn]` -> `tuple__T1_...` sentezlenmiş sınıfı (`f0..f{n-1}` alanları + `__init__`).
def instantiate_tuple_class(ck: Ck, elems: list[int]) -> int:
    sym: int = mangle_name(ck, "tuple", elems)
    if class_idx(ck, sym) >= 0:
        return ty_class(ck.tt, sym)
    ci: int = len(ck.cls_sym)
    ck.cls_sym.append(sym)
    ck.cls_node.append(-1)
    ck.cls_init.append(-1)
    ck.cls_base.append(-1)
    ck.cls_regd.append(2)
    ck.cls_chk.append(1)
    ck.tup_s.append(len(ck.tup_e))
    ck.tup_n.append(len(elems))
    ck.cls_synth.append(1)
    ck.gcls_ts.append(-1)
    ck.gcls_tn.append(0)
    m2_put(ck.cls_map, 0, sym, ci)
    cls_register(ck.tt, sym)
    ptys: list[int] = []
    pnms: list[int] = []
    for i in range(len(elems)):
        et: int = elems[i]
        fsym: int = sym_lit(ck, "f" + str(i))
        m2_put(ck.cls_fields, ci, fsym, et)
        ptys.append(et)
        pnms.append(fsym)
        ck.tup_e.append(et)
    ck.cls_init[ci] = new_sig(ck, ptys, pnms, 4)
    return ty_class(ck.tt, sym)

# ---- 3.6b: AST klonlama / tip ikamesi ve jenerik sınıflar (Zig `typeToTypeExpr` / `substitute*` / `instantiateGenericClass` / `resolveGenericBases`) ----
def sref_str(a: Ast, sr: int) -> str:
    n: int = sref_len(sr)
    out: str = ""
    for i in range(n):
        out = out + chr(sref_byte(a, sr, i))
    return out

def ast_str_sym(ck: Ck, a: Ast, sym: int) -> int:
    tt: TT = ck.tt
    off: int = len(a.sb)
    o: int = tt.so[sym]
    n: int = tt.sl[sym]
    for i in range(n):
        a.sb.append(tt.sb[o + i])
    return pk(0 - off - 1, n)

def list_put_slice(a: Ast, ids: list[int]) -> int:
    st: int = len(a.l)
    for i in range(len(ids)):
        a.l.append(ids[i])
    return pk(st, len(ids))

def fx_name_str(k: int) -> str:
    if k == 0:
        return "u8"
    if k == 1:
        return "u16"
    if k == 2:
        return "u32"
    if k == 3:
        return "u64"
    if k == 4:
        return "usize"
    if k == 5:
        return "i8"
    if k == 6:
        return "i16"
    if k == 7:
        return "i32"
    if k == 8:
        return "i64"
    return "isize"

def type_to_type_expr(ck: Ck, a: Ast, t: int) -> int:
    tt: TT = ck.tt
    tag: int = tt.tag[t]
    if tag == 0:
        sr: int = syn(a, "int")
        return mk_TypeExpr_simple(a, pkx(sr), pky(sr))
    if tag == 1:
        sr1: int = syn(a, "float")
        return mk_TypeExpr_simple(a, pkx(sr1), pky(sr1))
    if tag == 2:
        sr2: int = syn(a, "bool")
        return mk_TypeExpr_simple(a, pkx(sr2), pky(sr2))
    if tag == 3:
        sr3: int = syn(a, "str")
        return mk_TypeExpr_simple(a, pkx(sr3), pky(sr3))
    if tag == 18:
        sr18: int = syn(a, "bytes")
        return mk_TypeExpr_simple(a, pkx(sr18), pky(sr18))
    if tag == 4:
        sr4: int = syn(a, "None")
        return mk_TypeExpr_simple(a, pkx(sr4), pky(sr4))
    if tag == 12:
        sr12: int = syn(a, "ptr")
        return mk_TypeExpr_simple(a, pkx(sr12), pky(sr12))
    if tag == 16:
        sr16: int = syn(a, fx_name_str(tt.xa[t]))
        return mk_TypeExpr_simple(a, pkx(sr16), pky(sr16))
    if tag == 6:
        sr6: int = ast_str_sym(ck, a, tt.xa[t])
        return mk_TypeExpr_simple(a, pkx(sr6), pky(sr6))
    if tag == 15:
        return mk_TypeExpr_optional(a, type_to_type_expr(ck, a, tt.xa[t]))
    if tag == 14:
        pids: list[int] = []
        pa: int = tt.xa[t]
        for i in range(tt.xc[t]):
            pids.append(type_to_type_expr(ck, a, tt.fp[pa + i]))
        psl: int = list_put_slice(a, pids)
        rte: int = type_to_type_expr(ck, a, tt.xb[t])
        return mk_TypeExpr_func_type(a, mk_FuncTypeExpr(a, pkx(psl), pky(psl), rte))
    if tag == 13:
        dids: list[int] = [type_to_type_expr(ck, a, tt.xa[t]), type_to_type_expr(ck, a, tt.xb[t])]
        dsl: int = list_put_slice(a, dids)
        dsr: int = syn(a, "dict")
        return mk_TypeExpr_generic(a, mk_Generic(a, pkx(dsr), pky(dsr), pkx(dsl), pky(dsl)))
    gnm: str = "ptr"
    if tag == 5:
        gnm = "list"
    elif tag == 7:
        gnm = "Task"
    elif tag == 8:
        gnm = "Channel"
    elif tag == 9:
        gnm = "ThreadHandle"
    elif tag == 10:
        gnm = "ThreadChannel"
    elif tag == 11:
        gnm = "TaskLocal"
    eids: list[int] = [type_to_type_expr(ck, a, tt.xa[t])]
    esl: int = list_put_slice(a, eids)
    gsr: int = syn(a, gnm)
    return mk_TypeExpr_generic(a, mk_Generic(a, pkx(gsr), pky(gsr), pkx(esl), pky(esl)))

def subst_type_expr(ck: Ck, a: Ast, te: int, bnd: Map2) -> int:
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        sym: int = sym_of(ck, a, pk(a.n[te + 1], a.n[te + 2]))
        be: int = m2_get(bnd, 0, sym)
        if be >= 0:
            return type_to_type_expr(ck, a, bnd.vv[be])
        return te
    if tag == {{T:TypeExpr.generic}}:
        g: int = a.n[te + 1]
        gargs: int = sl_at(a, g, {{O:Generic.args}})
        ids: list[int] = []
        for i in range(pky(gargs)):
            ids.append(subst_type_expr(ck, a, stmt_at(a, gargs, i), bnd))
        nsl: int = list_put_slice(a, ids)
        return mk_TypeExpr_generic(a, mk_Generic(a, a.n[g + {{O:Generic.name}}], a.n[g + {{O:Generic.name}} + 1], pkx(nsl), pky(nsl)))
    if tag == {{T:TypeExpr.func_type}}:
        ft: int = a.n[te + 1]
        fps: int = sl_at(a, ft, {{O:FuncTypeExpr.params}})
        pids: list[int] = []
        for j in range(pky(fps)):
            pids.append(subst_type_expr(ck, a, stmt_at(a, fps, j), bnd))
        psl: int = list_put_slice(a, pids)
        ret: int = subst_type_expr(ck, a, a.n[ft + {{O:FuncTypeExpr.return_type}}], bnd)
        return mk_TypeExpr_func_type(a, mk_FuncTypeExpr(a, pkx(psl), pky(psl), ret))
    if tag == {{T:TypeExpr.optional}}:
        return mk_TypeExpr_optional(a, subst_type_expr(ck, a, a.n[te + 1], bnd))
    return te

def subst_exprs(ck: Ck, a: Ast, sl: int, bnd: Map2) -> int:
    ids: list[int] = []
    for i in range(pky(sl)):
        ids.append(subst_expr(ck, a, stmt_at(a, sl, i), bnd))
    return list_put_slice(a, ids)

def subst_comp_clauses(ck: Ck, a: Ast, sl: int, bnd: Map2) -> int:
    ids: list[int] = []
    for i in range(pky(sl)):
        cl: int = stmt_at(a, sl, i)
        ctag: int = a.n[cl]
        cpay: int = a.n[cl + 1]
        if ctag == {{T:CompClause.for_clause}}:
            nit: int = subst_expr(ck, a, a.n[cpay + {{O:CompForClause.iterable}}], bnd)
            ids.append(mk_CompClause_for_clause(a, mk_CompForClause(a, a.n[cpay + {{O:CompForClause.var_name}}], a.n[cpay + {{O:CompForClause.var_name}} + 1], nit)))
        else:
            ids.append(mk_CompClause_if_clause(a, subst_expr(ck, a, cpay, bnd)))
    return list_put_slice(a, ids)

def te_to_index_expr(ck: Ck, a: Ast, te: int) -> int:
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        return mk_Expr_identifier(a, a.n[te + 1], a.n[te + 2])
    if tag == {{T:TypeExpr.generic}}:
        g: int = a.n[te + 1]
        gargs: int = sl_at(a, g, {{O:Generic.args}})
        if pky(gargs) != 1:
            return -1
        inner: int = te_to_index_expr(ck, a, stmt_at(a, gargs, 0))
        if inner < 0:
            return -1
        obj: int = mk_Expr_identifier(a, a.n[g + {{O:Generic.name}}], a.n[g + {{O:Generic.name}} + 1])
        return mk_Expr_index(a, mk_Index(a, obj, inner))
    return -1

def subst_type_arg_expr(ck: Ck, a: Ast, e: int, bnd: Map2) -> int:
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        be: int = m2_get(bnd, 0, sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2])))
        if be < 0:
            return e
        res: int = te_to_index_expr(ck, a, type_to_type_expr(ck, a, bnd.vv[be]))
        if res >= 0:
            return res
        return e
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        if a.n[a.n[ix + {{O:Index.obj}}]] != {{T:Expr.identifier}}:
            return e
        return mk_Expr_index(a, mk_Index(a, a.n[ix + {{O:Index.obj}}], subst_type_arg_expr(ck, a, a.n[ix + {{O:Index.index}}], bnd)))
    return e

def subst_expr(ck: Ck, a: Ast, e: int, bnd: Map2) -> int:
    tag: int = a.n[e]
    if tag == {{T:Expr.int_lit}} or tag == {{T:Expr.float_lit}} or tag == {{T:Expr.bool_lit}} or tag == {{T:Expr.string_lit}} or tag == {{T:Expr.bytes_lit}} or tag == {{T:Expr.none_lit}} or tag == {{T:Expr.identifier}}:
        return e
    if tag == {{T:Expr.unary}}:
        u: int = a.n[e + 1]
        return mk_Expr_unary(a, mk_Unary(a, a.n[u + {{O:Unary.op}}], subst_expr(ck, a, a.n[u + {{O:Unary.operand}}], bnd)))
    if tag == {{T:Expr.kwarg}}:
        k: int = a.n[e + 1]
        return mk_Expr_kwarg(a, mk_Kwarg(a, a.n[k + {{O:Kwarg.name}}], a.n[k + {{O:Kwarg.name}} + 1], subst_expr(ck, a, a.n[k + {{O:Kwarg.value}}], bnd)))
    if tag == {{T:Expr.ternary}}:
        t: int = a.n[e + 1]
        return mk_Expr_ternary(a, mk_Ternary(a, subst_expr(ck, a, a.n[t + {{O:Ternary.cond}}], bnd), subst_expr(ck, a, a.n[t + {{O:Ternary.then_expr}}], bnd), subst_expr(ck, a, a.n[t + {{O:Ternary.else_expr}}], bnd)))
    if tag == {{T:Expr.binary}}:
        b: int = a.n[e + 1]
        return mk_Expr_binary(a, mk_Binary(a, a.n[b + {{O:Binary.op}}], subst_expr(ck, a, a.n[b + {{O:Binary.left}}], bnd), subst_expr(ck, a, a.n[b + {{O:Binary.right}}], bnd), a.n[b + {{O:Binary.is_form}}], a.n[b + {{O:Binary.fstring}}], a.n[b + {{O:Binary.opt_eq}}], a.n[b + {{O:Binary.spread}}]))
    if tag == {{T:Expr.call}}:
        c: int = a.n[e + 1]
        orig_cal: int = a.n[c + {{O:Call.callee}}]
        cal: int = subst_expr(ck, a, orig_cal, bnd)
        cargs: int = sl_at(a, c, {{O:Call.args}})
        na: list[int] = []
        for ai in range(pky(cargs)):
            na.append(subst_expr(ck, a, stmt_at(a, cargs, ai), bnd))
        if a.n[orig_cal] == {{T:Expr.identifier}} and len(na) >= 1 and a.n[na[0]] == {{T:Expr.identifier}}:
            fnm: int = pk(a.n[orig_cal + 1], a.n[orig_cal + 2])
            if sref_eq(a, fnm, "sizeof") or sref_eq(a, fnm, "alignof") or sref_eq(a, fnm, "offsetof"):
                asym: int = sym_of(ck, a, pk(a.n[na[0] + 1], a.n[na[0] + 2]))
                be: int = m2_get(bnd, 0, asym)
                if be >= 0:
                    te: int = type_to_type_expr(ck, a, bnd.vv[be])
                    if a.n[te] == {{T:TypeExpr.simple}}:
                        na[0] = mk_Expr_identifier(a, a.n[te + 1], a.n[te + 2])
        if a.n[cal] == {{T:Expr.index}}:
            cix: int = a.n[cal + 1]
            cobj: int = a.n[cix + {{O:Index.obj}}]
            if a.n[cobj] == {{T:Expr.attribute}}:
                cat: int = a.n[cobj + 1]
                cattr: int = pk(a.n[cat + {{O:Attribute.attr}}], a.n[cat + {{O:Attribute.attr}} + 1])
                if m2_get(ck.gm_names, 0, sym_of(ck, a, cattr)) >= 0:
                    cal = mk_Expr_index(a, mk_Index(a, cobj, subst_type_arg_expr(ck, a, a.n[cix + {{O:Index.index}}], bnd)))
        asl: int = list_put_slice(a, na)
        return mk_Expr_call(a, mk_Call(a, cal, pkx(asl), pky(asl), a.n[c + {{O:Call.fstring}}], a.n[c + {{O:Call.set_lit}}], a.n[c + {{O:Call.eval_order}}], a.n[c + {{O:Call.eval_order}} + 1], a.n[c + {{O:Call.raise_from}}], a.n[c + {{O:Call.spread_lit}}]))
    if tag == {{T:Expr.attribute}}:
        at_: int = a.n[e + 1]
        return mk_Expr_attribute(a, mk_Attribute(a, subst_expr(ck, a, a.n[at_ + {{O:Attribute.obj}}], bnd), a.n[at_ + {{O:Attribute.attr}}], a.n[at_ + {{O:Attribute.attr}} + 1]))
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        return mk_Expr_index(a, mk_Index(a, subst_expr(ck, a, a.n[ix + {{O:Index.obj}}], bnd), subst_expr(ck, a, a.n[ix + {{O:Index.index}}], bnd)))
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        nel: int = subst_expr(ck, a, a.n[lc + {{O:ListComp.elem}}], bnd)
        lcsl: int = subst_comp_clauses(ck, a, sl_at(a, lc, {{O:ListComp.clauses}}), bnd)
        return mk_Expr_list_comp(a, mk_ListComp(a, nel, pkx(lcsl), pky(lcsl), -1, a.n[lc + {{O:ListComp.is_genexpr}}]))
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        dk: int = subst_expr(ck, a, a.n[dc + {{O:DictComp.key}}], bnd)
        dv: int = subst_expr(ck, a, a.n[dc + {{O:DictComp.value}}], bnd)
        dcsl: int = subst_comp_clauses(ck, a, sl_at(a, dc, {{O:DictComp.clauses}}), bnd)
        return mk_Expr_dict_comp(a, mk_DictComp(a, dk, dv, pkx(dcsl), pky(dcsl), -1))
    if tag == {{T:Expr.lambda}}:
        lam: int = a.n[e + 1]
        return mk_Expr_lambda(a, mk_Lambda(a, a.n[lam + {{O:Lambda.params}}], a.n[lam + {{O:Lambda.params}} + 1], subst_expr(ck, a, a.n[lam + {{O:Lambda.body}}], bnd)))
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[e + 1]
        nobj: int = subst_expr(ck, a, a.n[sl + {{O:Slice.obj}}], bnd)
        nlo: int = -1
        if a.n[sl + {{O:Slice.lo}}] >= 0:
            nlo = subst_expr(ck, a, a.n[sl + {{O:Slice.lo}}], bnd)
        nhi: int = -1
        if a.n[sl + {{O:Slice.hi}}] >= 0:
            nhi = subst_expr(ck, a, a.n[sl + {{O:Slice.hi}}], bnd)
        nst: int = -1
        if a.n[sl + {{O:Slice.step}}] >= 0:
            nst = subst_expr(ck, a, a.n[sl + {{O:Slice.step}}], bnd)
        return mk_Expr_slice(a, mk_Slice(a, nobj, nlo, nhi, nst))
    if tag == {{T:Expr.list_lit}}:
        lsl: int = subst_exprs(ck, a, pk(a.n[e + 1], a.n[e + 2]), bnd)
        return mk_Expr_list_lit(a, pkx(lsl), pky(lsl))
    if tag == {{T:Expr.tuple_lit}}:
        tsl: int = subst_exprs(ck, a, pk(a.n[e + 1], a.n[e + 2]), bnd)
        return mk_Expr_tuple_lit(a, pkx(tsl), pky(tsl))
    if tag == {{T:Expr.dict_lit}}:
        dp_st: int = a.n[e + 1]
        dp_n: int = a.n[e + 2]
        dp_ids: list[int] = []
        for di in range(dp_n):
            pr: int = a.l[dp_st + di]
            dp_ids.append(mk_DictPair(a, subst_expr(ck, a, a.n[pr + {{O:DictPair.key}}], bnd), subst_expr(ck, a, a.n[pr + {{O:DictPair.value}}], bnd)))
        dpsl: int = list_put_slice(a, dp_ids)
        return mk_Expr_dict_lit(a, pkx(dpsl), pky(dpsl))
    if tag == {{T:Expr.await_expr}}:
        return mk_Expr_await_expr(a, subst_expr(ck, a, a.n[e + 1], bnd))
    if tag == {{T:Expr.spawn_expr}}:
        return mk_Expr_spawn_expr(a, subst_expr(ck, a, a.n[e + 1], bnd))
    gc: int = a.n[e + 1]
    gta: int = sl_at(a, gc, {{O:GenericConstruct.type_args}})
    gtids: list[int] = []
    for gti in range(pky(gta)):
        gtids.append(subst_type_expr(ck, a, stmt_at(a, gta, gti), bnd))
    gtsl: int = list_put_slice(a, gtids)
    gasl: int = subst_exprs(ck, a, sl_at(a, gc, {{O:GenericConstruct.args}}), bnd)
    return mk_Expr_generic_construct(a, mk_GenericConstruct(a, a.n[gc + {{O:GenericConstruct.name}}], a.n[gc + {{O:GenericConstruct.name}} + 1], pkx(gtsl), pky(gtsl), pkx(gasl), pky(gasl), {{NONE}}, 0))

def subst_stmts(ck: Ck, a: Ast, sl: int, bnd: Map2) -> int:
    ids: list[int] = []
    for i in range(pky(sl)):
        ids.append(subst_stmt(ck, a, stmt_at(a, sl, i), bnd))
    return list_put_slice(a, ids)

def subst_stmt(ck: Ck, a: Ast, s: int, bnd: Map2) -> int:
    kn: int = a.n[s + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    ln: int = a.n[s + {{O:Stmt.line}}]
    nkn: int = -1
    if tag == {{T:StmtKind.expr_stmt}}:
        nkn = mk_StmtKind_expr_stmt(a, subst_expr(ck, a, pay, bnd))
    elif tag == {{T:StmtKind.var_decl}}:
        nte: int = subst_type_expr(ck, a, a.n[pay + {{O:VarDecl.type_expr}}], bnd)
        nval: int = subst_expr(ck, a, a.n[pay + {{O:VarDecl.value}}], bnd)
        nkn = mk_StmtKind_var_decl(a, mk_VarDecl(a, a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1], nte, nval, a.n[pay + {{O:VarDecl.class_attr}}], a.n[pay + {{O:VarDecl.is_match_temp}}], a.n[pay + {{O:VarDecl.unpack_origin}}], a.n[pay + {{O:VarDecl.infer_assign}}]))
    elif tag == {{T:StmtKind.assign}}:
        ntg: int = subst_expr(ck, a, a.n[pay + {{O:Assign.target}}], bnd)
        nav: int = subst_expr(ck, a, a.n[pay + {{O:Assign.value}}], bnd)
        nann: int = a.n[pay + {{O:Assign.ann}}]
        if nann >= 0:
            nann = subst_type_expr(ck, a, nann, bnd)
        nkn = mk_StmtKind_assign(a, mk_Assign(a, ntg, nav, nann))
    elif tag == {{T:StmtKind.if_stmt}}:
        nc: int = subst_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}], bnd)
        ntb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), bnd)
        ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        eids: list[int] = []
        for ei in range(pky(ecs)):
            ec: int = stmt_at(a, ecs, ei)
            ecc: int = subst_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}], bnd)
            ecb: int = subst_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}), bnd)
            eids.append(mk_ElifClause(a, ecc, pkx(ecb), pky(ecb)))
        ecsl: int = list_put_slice(a, eids)
        neb0: int = {{NONE}}
        neb1: int = 0
        if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
            neb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), bnd)
            neb0 = pkx(neb)
            neb1 = pky(neb)
        nkn = mk_StmtKind_if_stmt(a, mk_IfStmt(a, nc, pkx(ntb), pky(ntb), pkx(ecsl), pky(ecsl), neb0, neb1, a.n[pay + {{O:IfStmt.is_assert}}], a.n[pay + {{O:IfStmt.match_origin}}], a.n[pay + {{O:IfStmt.is_else_tail}}]))
    elif tag == {{T:StmtKind.while_stmt}}:
        wc: int = subst_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}], bnd)
        wb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), bnd)
        nkn = mk_StmtKind_while_stmt(a, mk_WhileStmt(a, wc, pkx(wb), pky(wb), a.n[pay + {{O:WhileStmt.else_origin}}]))
    elif tag == {{T:StmtKind.for_stmt}}:
        fit: int = subst_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}], bnd)
        fb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), bnd)
        nkn = mk_StmtKind_for_stmt(a, mk_ForStmt(a, a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1], fit, pkx(fb), pky(fb), a.n[pay + {{O:ForStmt.hoist}}], a.n[pay + {{O:ForStmt.is_async}}], a.n[pay + {{O:ForStmt.else_origin}}]))
    elif tag == {{T:StmtKind.del_stmt}}:
        nkn = mk_StmtKind_del_stmt(a, subst_expr(ck, a, pay, bnd))
    elif tag == {{T:StmtKind.func_def}}:
        fps: int = sl_at(a, pay, {{O:FuncDef.params}})
        pids: list[int] = []
        for pi in range(pky(fps)):
            p: int = stmt_at(a, fps, pi)
            pids.append(mk_Param(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1], a.n[p + {{O:Param.variadic}}], a.n[p + {{O:Param.var_kw}}], a.n[p + {{O:Param.kw_only}}], a.n[p + {{O:Param.pos_only}}], subst_type_expr(ck, a, a.n[p + {{O:Param.type_expr}}], bnd), a.n[p + {{O:Param.self_inferred}}], a.n[p + {{O:Param.default}}]))
        psl: int = list_put_slice(a, pids)
        fret: int = subst_type_expr(ck, a, a.n[pay + {{O:FuncDef.return_type}}], bnd)
        fbody: int = subst_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), bnd)
        nkn = mk_StmtKind_func_def(a, mk_FuncDef(a, a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1], a.n[pay + {{O:FuncDef.type_params}}], a.n[pay + {{O:FuncDef.type_params}} + 1], pkx(psl), pky(psl), fret, a.n[pay + {{O:FuncDef.ret_omitted}}], pkx(fbody), pky(fbody), a.n[pay + {{O:FuncDef.is_async}}], a.n[pay + {{O:FuncDef.decorators}}], a.n[pay + {{O:FuncDef.decorators}} + 1], a.n[pay + {{O:FuncDef.link_name}}], a.n[pay + {{O:FuncDef.link_name}} + 1], a.n[pay + {{O:FuncDef.nonlocals}}], a.n[pay + {{O:FuncDef.nonlocals}} + 1], a.n[pay + {{O:FuncDef.globals}}], a.n[pay + {{O:FuncDef.globals}} + 1], a.n[pay + {{O:FuncDef.allow_await}}], a.n[pay + {{O:FuncDef.line}}]))
    elif tag == {{T:StmtKind.return_stmt}}:
        rv: int = -1
        if pay >= 0:
            rv = subst_expr(ck, a, pay, bnd)
        nkn = mk_StmtKind_return_stmt(a, rv)
    elif tag == {{T:StmtKind.raise_stmt}}:
        nkn = mk_StmtKind_raise_stmt(a, subst_expr(ck, a, pay, bnd))
    elif tag == {{T:StmtKind.try_stmt}}:
        tb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), bnd)
        txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
        xids: list[int] = []
        for xi in range(pky(txs)):
            xc: int = stmt_at(a, txs, xi)
            xb: int = subst_stmts(ck, a, sl_at(a, xc, {{O:ExceptClause.body}}), bnd)
            xids.append(mk_ExceptClause(a, a.n[xc + {{O:ExceptClause.class_name}}], a.n[xc + {{O:ExceptClause.class_name}} + 1], a.n[xc + {{O:ExceptClause.bind_name}}], a.n[xc + {{O:ExceptClause.bind_name}} + 1], pkx(xb), pky(xb), a.n[xc + {{O:ExceptClause.synth_bind}}], a.n[xc + {{O:ExceptClause.synth_class}}]))
        xsl: int = list_put_slice(a, xids)
        nfb0: int = {{NONE}}
        nfb1: int = 0
        if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
            nfb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), bnd)
            nfb0 = pkx(nfb)
            nfb1 = pky(nfb)
        nkn = mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(tb), pky(tb), pkx(xsl), pky(xsl), nfb0, nfb1, a.n[pay + {{O:TryStmt.else_origin}}]))
    elif tag == {{T:StmtKind.lowlevel_stmt}}:
        llb: int = subst_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), bnd)
        nkn = mk_StmtKind_lowlevel_stmt(a, mk_LowLevelStmt(a, pkx(llb), pky(llb)))
    elif tag == {{T:StmtKind.with_stmt}}:
        wcx: int = subst_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}], bnd)
        wb2: int = subst_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), bnd)
        nkn = mk_StmtKind_with_stmt(a, mk_WithStmt(a, wcx, a.n[pay + {{O:WithStmt.binding}}], a.n[pay + {{O:WithStmt.binding}} + 1], pkx(wb2), pky(wb2), a.n[pay + {{O:WithStmt.is_async}}], a.n[pay + {{O:WithStmt.uid}}]))
    elif tag == {{T:StmtKind.defer_stmt}}:
        dc_: int = a.n[pay + {{O:DeferStmt.call}}]
        dcal: int = subst_expr(ck, a, a.n[dc_ + {{O:Call.callee}}], bnd)
        dasl: int = subst_exprs(ck, a, sl_at(a, dc_, {{O:Call.args}}), bnd)
        nkn = mk_StmtKind_defer_stmt(a, mk_DeferStmt(a, mk_Call(a, dcal, pkx(dasl), pky(dasl), a.n[dc_ + {{O:Call.fstring}}], a.n[dc_ + {{O:Call.set_lit}}], a.n[dc_ + {{O:Call.eval_order}}], a.n[dc_ + {{O:Call.eval_order}} + 1], a.n[dc_ + {{O:Call.raise_from}}], a.n[dc_ + {{O:Call.spread_lit}}])))
    else:
        return s
    return mk_Stmt(a, nkn, ln, -1)

def mangle_name_sym(ck: Ck, base_sym: int, elems: list[int]) -> int:
    tt: TT = ck.tt
    bs: list[int] = []
    bo: int = tt.so[base_sym]
    for i in range(tt.sl[base_sym]):
        bs.append(tt.sb[bo + i])
    bs.append(95)
    bs.append(95)
    for j in range(len(elems)):
        if j > 0:
            bs.append(95)
        tt.out = []
        ty_mangle(tt, elems[j])
        for k in range(len(tt.out)):
            bs.append(tt.out[k])
    return sym_intern_list(tt, bs, 0, len(bs))

# Zig `qualifiedGenericBase`: `mod.Box` / `pkg.mod.Box` -> takma ad ikamesi + modül kontrolü -> `mod_Box` sembolü (-1: nokta yok).
def qualified_generic_base(ck: Ck, a: Ast, gn: int) -> int:
    n: int = sref_len(gn)
    has_dot: bool = False
    for i in range(n):
        if sref_byte(a, gn, i) == 46:
            has_dot = True
            break
    if not has_dot:
        return -1
    segs: list[int] = []
    cur: list[int] = []
    for j in range(n):
        b: int = sref_byte(a, gn, j)
        if b == 46:
            segs.append(sym_intern_list(ck.tt, cur, 0, len(cur)))
            cur = []
        else:
            cur.append(b)
    segs.append(sym_intern_list(ck.tt, cur, 0, len(cur)))
    resolved: list[int] = subst_alias(ck, segs)
    if len(resolved) < 2:
        return -1
    mod: int = join_syms(ck, resolved, len(resolved) - 1, 46)
    if m2_get(ck.imod, 0, mod) < 0:
        mp(ck, "unknown module: ")
        mp_sym(ck, mod)
        raise mk_fail(ck, "UnknownType")
    return join_syms(ck, resolved, len(resolved), 95)

def lookup_generic_class(ck: Ck, a: Ast, gn: int) -> int:
    sym: int = sym_of(ck, a, gn)
    ge: int = m2_get(ck.gcls, 0, sym)
    if ge >= 0:
        return ck.gcls.vv[ge]
    fe: int = m2_get(ck.fimp, 0, sym)
    if fe >= 0:
        ge2: int = m2_get(ck.gcls, 0, ck.fimp.vv[fe])
        if ge2 >= 0:
            return ck.gcls.vv[ge2]
    qsym: int = qualified_generic_base(ck, a, gn)
    if qsym >= 0:
        ge3: int = m2_get(ck.gcls, 0, qsym)
        if ge3 >= 0:
            return ck.gcls.vv[ge3]
    return -1

# Zig `instantiateGenericClass` (L11819): tip parametrelerini + sınıf adını somut mangled sınıfa bağlayarak alan/metod/gövdeleri klonlar.
def instantiate_generic_class(ck: Ck, a: Ast, gcd: int, bound: list[int]) -> int:
    gnm: int = pk(a.n[gcd + {{O:ClassDef.name}}], a.n[gcd + {{O:ClassDef.name}} + 1])
    gsym: int = sym_of(ck, a, gnm)
    tps: int = sl_at(a, gcd, {{O:ClassDef.type_params}})
    ntp: int = pky(tps)
    if len(bound) != ntp:
        mp(ck, "'")
        mp_sym(ck, gsym)
        mp(ck, "' expects ")
        mp_int(ck, ntp)
        mp(ck, " type arguments, ")
        mp_int(ck, len(bound))
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    mangled_sym: int = mangle_name_sym(ck, gsym, bound)
    if class_idx(ck, mangled_sym) >= 0:
        return ty_class(ck.tt, mangled_sym)
    bnd: Map2 = Map2()
    for i in range(ntp):
        tpsym: int = sym_of(ck, a, pk(a.l[pkx(tps) + i * 2], a.l[pkx(tps) + i * 2 + 1]))
        m2_put(bnd, 0, tpsym, bound[i])
    mty: int = ty_class(ck.tt, mangled_sym)
    m2_put(bnd, 0, gsym, mty)
    fs: int = sl_at(a, gcd, {{O:ClassDef.fields}})
    fids: list[int] = []
    for fi in range(pky(fs)):
        f: int = stmt_at(a, fs, fi)
        fte: int = subst_type_expr(ck, a, a.n[f + {{O:FieldDecl.type_expr}}], bnd)
        fids.append(mk_FieldDecl(a, a.n[f + {{O:FieldDecl.name}}], a.n[f + {{O:FieldDecl.name}} + 1], fte, a.n[f + {{O:FieldDecl.line}}]))
    fsl: int = list_put_slice(a, fids)
    ms: int = sl_at(a, gcd, {{O:ClassDef.methods}})
    mids: list[int] = []
    def_gms: list[int] = []
    for mi in range(pky(ms)):
        m: int = stmt_at(a, ms, mi)
        is_gm: bool = pky(sl_at(a, m, {{O:FuncDef.type_params}})) > 0
        mps: int = sl_at(a, m, {{O:FuncDef.params}})
        pids: list[int] = []
        for pi in range(pky(mps)):
            p: int = stmt_at(a, mps, pi)
            pids.append(mk_Param(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1], a.n[p + {{O:Param.variadic}}], a.n[p + {{O:Param.var_kw}}], a.n[p + {{O:Param.kw_only}}], a.n[p + {{O:Param.pos_only}}], subst_type_expr(ck, a, a.n[p + {{O:Param.type_expr}}], bnd), a.n[p + {{O:Param.self_inferred}}], a.n[p + {{O:Param.default}}]))
        psl: int = list_put_slice(a, pids)
        mret: int = subst_type_expr(ck, a, a.n[m + {{O:FuncDef.return_type}}], bnd)
        mbody: int = subst_stmts(ck, a, sl_at(a, m, {{O:FuncDef.body}}), bnd)
        tp0: int = 0
        tp1: int = 0
        if is_gm:
            tp0 = a.n[m + {{O:FuncDef.type_params}}]
            tp1 = a.n[m + {{O:FuncDef.type_params}} + 1]
        cm: int = mk_FuncDef(a, a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1], tp0, tp1, pkx(psl), pky(psl), mret, a.n[m + {{O:FuncDef.ret_omitted}}], pkx(mbody), pky(mbody), a.n[m + {{O:FuncDef.is_async}}], a.n[m + {{O:FuncDef.decorators}}], a.n[m + {{O:FuncDef.decorators}} + 1], a.n[m + {{O:FuncDef.link_name}}], a.n[m + {{O:FuncDef.link_name}} + 1], a.n[m + {{O:FuncDef.nonlocals}}], a.n[m + {{O:FuncDef.nonlocals}} + 1], a.n[m + {{O:FuncDef.globals}}], a.n[m + {{O:FuncDef.globals}} + 1], a.n[m + {{O:FuncDef.allow_await}}], a.n[m + {{O:FuncDef.line}}])
        if is_gm:
            def_gms.append(cm)
        else:
            mids.append(cm)
    msl: int = list_put_slice(a, mids)
    msr: int = ast_str_sym(ck, a, mangled_sym)
    ev_s: int = sl_at(a, gcd, {{O:ClassDef.enum_variants}})
    ccd: int = mk_ClassDef(a, pkx(msr), pky(msr), 0, 0, {{NONE}}, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, 0, 0, 0, pkx(msl), pky(msl), pkx(fsl), pky(fsl), 0, 0, pkx(ev_s), pky(ev_s))
    if pky(ev_s) > 0:
        m2_put(ck.generic_origin, 0, mangled_sym, gsym)
    ci: int = len(ck.cls_sym)
    ck.cls_sym.append(mangled_sym)
    ck.cls_node.append(ccd)
    ck.cls_init.append(-1)
    ck.cls_base.append(-1)
    ck.cls_regd.append(0)
    ck.cls_chk.append(0)
    ck.tup_s.append(-1)
    ck.tup_n.append(0)
    ck.cls_synth.append(1)
    ck.gcls_ts.append(len(ck.gcls_te))
    ck.gcls_tn.append(len(bound))
    for bi in range(len(bound)):
        ck.gcls_te.append(bound[bi])
    m2_put(ck.cls_map, 0, mangled_sym, ci)
    cls_register(ck.tt, mangled_sym)
    ensure_class_sig(ck, a, ci)
    if gsym == sym_lit(ck, "nox_ffi_Callback") and len(bound) == 1 and ck.tt.tag[bound[0]] == 14:
        if m2_get(ck.cls_fields, ci, sym_lit(ck, "fn")) >= 0 and m2_get(ck.cls_fields, ci, sym_lit(ck, "box")) >= 0:
            m2_put(ck.ffi_cb_cls, 0, mangled_sym, bound[0])
    for gmi in range(len(def_gms)):
        gm: int = def_gms[gmi]
        gmn: int = pk(a.n[gm + {{O:FuncDef.name}}], a.n[gm + {{O:FuncDef.name}} + 1])
        gmsym: int = sym_of(ck, a, gmn)
        if pky(sl_at(a, gm, {{O:FuncDef.decorators}})) > 0 or a.n[gm + {{O:FuncDef.is_async}}] != 0 or a.n[gm + {{O:FuncDef.allow_await}}] != 0:
            raise unsup(ck, "class#method_features")
        gm_ps: int = sl_at(a, gm, {{O:FuncDef.params}})
        if pky(sl_at(a, gm, {{O:FuncDef.type_params}})) != 1:
            mp(ck, "generic method '")
            mp_sym(ck, gsym)
            mp(ck, ".")
            mp_sref(ck, a, gmn)
            mp(ck, "' can take a single type parameter")
            raise mk_fail(ck, "TypeMismatch")
        if sref_len(gmn) >= 2 and sref_byte(a, gmn, 0) == 95 and sref_byte(a, gmn, 1) == 95:
            mp(ck, "special method '")
            mp_sym(ck, gsym)
            mp(ck, ".")
            mp_sref(ck, a, gmn)
            mp(ck, "' cannot be generic")
            raise mk_fail(ck, "TypeMismatch")
        m2_put(ck.gmeth, mangled_sym, gmsym, gm)
        m2_put(ck.gm_names, 0, gmsym, 1)
    if ck.defer_cls_body:
        ck.pending_inst.append(ci)
    else:
        ensure_class_checked(ck, a, ci)
    return mty

def is_tp_in_slice(ck: Ck, a: Ast, sym: int, tps: int) -> bool:
    for i in range(pky(tps)):
        if sym_of(ck, a, pk(a.l[pkx(tps) + i * 2], a.l[pkx(tps) + i * 2 + 1])) == sym:
            return True
    return False

def sym_has_prefix_dunder(ck: Ck, a: Ast, cls_sym: int, gn: int) -> bool:
    tt: TT = ck.tt
    gl: int = sref_len(gn)
    cl: int = tt.sl[cls_sym]
    if cl <= gl + 2:
        return False
    co: int = tt.so[cls_sym]
    for i in range(gl):
        if tt.sb[co + i] != sref_byte(a, gn, i):
            return False
    return tt.sb[co + gl] == 95 and tt.sb[co + gl + 1] == 95

def unify_type_expr(ck: Ck, a: Ast, te: int, actual: int, tps: int, bnd: Map2, fn_sym: int) -> None:
    tag: int = a.n[te]
    tt: TT = ck.tt
    if tag == {{T:TypeExpr.simple}}:
        nr: int = pk(a.n[te + 1], a.n[te + 2])
        sym: int = sym_of(ck, a, nr)
        if is_tp_in_slice(ck, a, sym, tps):
            be: int = m2_get(bnd, 0, sym)
            if be >= 0:
                if bnd.vv[be] != actual:
                    mp(ck, "in the call to '")
                    mp_sym(ck, fn_sym)
                    mp(ck, "', the type parameter '")
                    mp_sref(ck, a, nr)
                    mp(ck, "' resolved to conflicting types")
                    raise mk_fail(ck, "TypeMismatch")
            else:
                if m2_get(ck.proto_defs, 0, sym) >= 0:
                    satisfies_protocol(ck, actual, sym, fn_sym)
                m2_put(bnd, 0, sym, actual)
            return
        declared: int = type_expr_to_type(ck, a, te)
        if not ty_assignable(tt, declared, actual):
            mp(ck, "type mismatch for argument '")
            mp_sym(ck, fn_sym)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tag == {{T:TypeExpr.generic}}:
        g: int = a.n[te + 1]
        gn: int = pk(a.n[g + {{O:Generic.name}}], a.n[g + {{O:Generic.name}} + 1])
        gargs: int = sl_at(a, g, {{O:Generic.args}})
        n: int = pky(gargs)
        if sref_eq(a, gn, "list") and n == 1:
            if tt.tag[actual] != 5:
                mp(ck, "type mismatch for argument '")
                mp_sym(ck, fn_sym)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            unify_type_expr(ck, a, stmt_at(a, gargs, 0), tt.xa[actual], tps, bnd, fn_sym)
            return
        if sref_eq(a, gn, "dict") and n == 2:
            if tt.tag[actual] != 13:
                mp(ck, "type mismatch for argument '")
                mp_sym(ck, fn_sym)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            unify_type_expr(ck, a, stmt_at(a, gargs, 0), tt.xa[actual], tps, bnd, fn_sym)
            unify_type_expr(ck, a, stmt_at(a, gargs, 1), tt.xb[actual], tps, bnd, fn_sym)
            return
        if sref_eq(a, gn, "ptr") and n == 1:
            if tt.tag[actual] != 17:
                mp(ck, "type mismatch for argument '")
                mp_sym(ck, fn_sym)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            unify_type_expr(ck, a, stmt_at(a, gargs, 0), tt.xa[actual], tps, bnd, fn_sym)
            return
        if tt.tag[actual] == 6:
            ci: int = class_idx(ck, tt.xa[actual])
            if ci >= 0 and ck.gcls_tn[ci] == n and sym_has_prefix_dunder(ck, a, tt.xa[actual], gn):
                for gi in range(n):
                    unify_type_expr(ck, a, stmt_at(a, gargs, gi), ck.gcls_te[ck.gcls_ts[ci] + gi], tps, bnd, fn_sym)
                return
        mp(ck, "unknown generic type: ")
        mp_sref(ck, a, gn)
        raise mk_fail(ck, "UnknownType")
    if tag == {{T:TypeExpr.func_type}}:
        ft: int = a.n[te + 1]
        fps: int = sl_at(a, ft, {{O:FuncTypeExpr.params}})
        if tt.tag[actual] != 14 or tt.xc[actual] != pky(fps):
            mp(ck, "in the call to '")
            mp_sym(ck, fn_sym)
            mp(ck, "', the function-typed argument does not match the expected signature")
            raise mk_fail(ck, "TypeMismatch")
        pa: int = tt.xa[actual]
        for fi in range(pky(fps)):
            unify_type_expr(ck, a, stmt_at(a, fps, fi), tt.fp[pa + fi], tps, bnd, fn_sym)
        unify_type_expr(ck, a, a.n[ft + {{O:FuncTypeExpr.return_type}}], tt.xb[actual], tps, bnd, fn_sym)
        return
    if tag == {{T:TypeExpr.optional}}:
        inner_te: int = a.n[te + 1]
        if tt.tag[actual] == 15:
            unify_type_expr(ck, a, inner_te, tt.xa[actual], tps, bnd, fn_sym)
        elif actual != 4:
            unify_type_expr(ck, a, inner_te, actual, tps, bnd, fn_sym)
        return
    declared_q: int = type_expr_to_type(ck, a, te)
    if not ty_assignable(tt, declared_q, actual):
        mp(ck, "type mismatch for argument '")
        mp_sym(ck, fn_sym)
        mp(ck, "'")
        raise mk_fail(ck, "TypeMismatch")

def infer_lambda_ret(ck: Ck, a: Ast, fx: Fx, e: int, ptypes: list[int]) -> int:
    lam: int = a.n[e + 1]
    isc: int = sc_new(ck, fx.scope, True)
    lps: int = sl_at(a, lam, {{O:Lambda.params}})
    for i in range(pky(lps)):
        sc_declare(ck, isc, sym_of(ck, a, pk(a.l[pkx(lps) + i * 2], a.l[pkx(lps) + i * 2 + 1])), ptypes[i])
    ifx: Fx = Fx(isc, 4, False)
    return check_expr(ck, a, ifx, a.n[lam + {{O:Lambda.body}}])

def check_lambda_args_against(ck: Ck, a: Ast, fx: Fx, sid: int, args: int) -> None:
    np: int = ck.fpn[sid]
    st: int = ck.fps[sid]
    for i in range(pky(args)):
        arg: int = stmt_at(a, args, i)
        if a.n[arg] == {{T:Expr.lambda}} and i < np:
            check_lambda(ck, a, fx, arg, ck.fpar[st + i])

def lookup_generic_func(ck: Ck, a: Ast, gn: int) -> int:
    sym: int = sym_of(ck, a, gn)
    ge: int = m2_get(ck.gfn, 0, sym)
    if ge >= 0:
        return ck.gfn.vv[ge]
    fe: int = m2_get(ck.fimp, 0, sym)
    if fe >= 0:
        ge2: int = m2_get(ck.gfn, 0, ck.fimp.vv[fe])
        if ge2 >= 0:
            return ck.gfn.vv[ge2]
    qsym: int = qualified_generic_base(ck, a, gn)
    if qsym >= 0:
        ge3: int = m2_get(ck.gfn, 0, qsym)
        if ge3 >= 0:
            return ck.gfn.vv[ge3]
    return -1

def instantiate_generic_func(ck: Ck, a: Ast, fx: Fx, gfd: int, fn_sym: int, args: int, explicit: list[int], has_exp: bool) -> int:
    na: int = pky(args)
    ps: int = sl_at(a, gfd, {{O:FuncDef.params}})
    np: int = pky(ps)
    has_kw: bool = False
    for ki in range(na):
        if a.n[stmt_at(a, args, ki)] == {{T:Expr.kwarg}}:
            has_kw = True
    if has_kw or na < np or any_variadic(a, ps):
        args = expand_call_args(ck, a, ps, args, fn_sym)
        na = pky(args)
    if na != np:
        mp(ck, "'")
        mp_sym(ck, fn_sym)
        mp(ck, "' expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, na)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    tps: int = sl_at(a, gfd, {{O:FuncDef.type_params}})
    ntp: int = pky(tps)
    bnd: Map2 = Map2()
    if has_exp:
        for ei in range(ntp):
            tpsym: int = sym_of(ck, a, pk(a.l[pkx(tps) + ei * 2], a.l[pkx(tps) + ei * 2 + 1]))
            m2_put(bnd, 0, tpsym, explicit[ei])
    for pi in range(np):
        p: int = stmt_at(a, ps, pi)
        pte: int = a.n[p + {{O:Param.type_expr}}]
        if a.n[pte] == {{T:TypeExpr.func_type}}:
            continue
        arg: int = stmt_at(a, args, pi)
        at_: int = -1
        is_emp: bool = ((a.n[arg] == {{T:Expr.list_lit}} and a.n[arg + 2] == 0) or (a.n[arg] == {{T:Expr.dict_lit}} and a.n[arg + 2] == 0)) and not mentions_protocol(ck, a, pte)
        if is_emp:
            sv_c: int = len(ck.mb)
            sv_l: int = ck.cur_line
            sv_s: int = ck.cur_span
            try:
                at_ = type_expr_to_type(ck, a, pte)
            except CkErr:
                ck.mb = ck.mb[:sv_c]
                ck.cur_line = sv_l
                ck.cur_span = sv_s
                at_ = -1
        if at_ < 0 and has_exp:
            sv_c2: int = len(ck.mb)
            sv_l2: int = ck.cur_line
            sv_s2: int = ck.cur_span
            sub_pt: int = -1
            try:
                sub_te: int = subst_type_expr(ck, a, pte, bnd)
                sub_pt = type_expr_to_type(ck, a, sub_te)
            except CkErr:
                ck.mb = ck.mb[:sv_c2]
                ck.cur_line = sv_l2
                ck.cur_span = sv_s2
                sub_pt = -1
            if sub_pt >= 0:
                at_ = check_expr_expected(ck, a, fx, arg, sub_pt)
        if at_ < 0:
            at_ = check_expr(ck, a, fx, arg)
        unify_type_expr(ck, a, pte, at_, tps, bnd, fn_sym)
    for pi2 in range(np):
        p2: int = stmt_at(a, ps, pi2)
        pte2: int = a.n[p2 + {{O:Param.type_expr}}]
        if a.n[pte2] != {{T:TypeExpr.func_type}}:
            continue
        arg2: int = stmt_at(a, args, pi2)
        act: int = -1
        if a.n[arg2] == {{T:Expr.lambda}}:
            lam: int = a.n[arg2 + 1]
            ft: int = a.n[pte2 + 1]
            fps: int = sl_at(a, ft, {{O:FuncTypeExpr.params}})
            lps: int = sl_at(a, lam, {{O:Lambda.params}})
            if pky(lps) != pky(fps):
                mp(ck, "the lambda takes ")
                mp_int(ck, pky(lps))
                mp(ck, " parameters, '")
                mp_sym(ck, fn_sym)
                mp(ck, "' expects a function with ")
                mp_int(ck, pky(fps))
                mp(ck, " parameters")
                raise mk_fail(ck, "ArgumentCountMismatch")
            ptypes: list[int] = []
            for li in range(pky(fps)):
                lsv_c: int = len(ck.mb)
                lsv_l: int = ck.cur_line
                lsv_s: int = ck.cur_span
                lsub: int = subst_type_expr(ck, a, stmt_at(a, fps, li), bnd)
                lpt: int = -1
                try:
                    lpt = type_expr_to_type(ck, a, lsub)
                except CkErr:
                    ck.mb = ck.mb[:lsv_c]
                    ck.cur_line = lsv_l
                    ck.cur_span = lsv_s
                    mp(ck, "in the call to '")
                    mp_sym(ck, fn_sym)
                    mp(ck, "', the lambda parameter type could not be inferred — first pass an argument that binds the type parameter (e.g. a list)")
                    raise mk_fail(ck, "TypeMismatch")
                ptypes.append(lpt)
            lret: int = infer_lambda_ret(ck, a, fx, arg2, ptypes)
            ty_func_begin(ck.tt)
            for pti in range(len(ptypes)):
                ty_func_param(ck.tt, ptypes[pti])
            act = ty_func_end(ck.tt, lret)
        else:
            act = check_expr(ck, a, fx, arg2)
        unify_type_expr(ck, a, pte2, act, tps, bnd, fn_sym)
    bound: list[int] = []
    for ti in range(ntp):
        tpr: int = pk(a.l[pkx(tps) + ti * 2], a.l[pkx(tps) + ti * 2 + 1])
        be: int = m2_get(bnd, 0, sym_of(ck, a, tpr))
        if be < 0:
            mp(ck, "for '")
            mp_sym(ck, fn_sym)
            mp(ck, "', the type parameter '")
            mp_sref(ck, a, tpr)
            mp(ck, "' could not be inferred (only inference from argument types is supported)")
            raise mk_fail(ck, "TypeMismatch")
        bound.append(bnd.vv[be])
    mangled_sym: int = mangle_name_sym(ck, fn_sym, bound)
    fe: int = m2_get(ck.fmap, 0, mangled_sym)
    if fe >= 0:
        csid: int = ck.fmap.vv[fe]
        check_lambda_args_against(ck, a, fx, csid, args)
        return ck.fret[csid]
    pids: list[int] = []
    for pi3 in range(np):
        p3: int = stmt_at(a, ps, pi3)
        pids.append(mk_Param(a, a.n[p3 + {{O:Param.name}}], a.n[p3 + {{O:Param.name}} + 1], a.n[p3 + {{O:Param.variadic}}], a.n[p3 + {{O:Param.var_kw}}], a.n[p3 + {{O:Param.kw_only}}], a.n[p3 + {{O:Param.pos_only}}], subst_type_expr(ck, a, a.n[p3 + {{O:Param.type_expr}}], bnd), a.n[p3 + {{O:Param.self_inferred}}], a.n[p3 + {{O:Param.default}}]))
    psl: int = list_put_slice(a, pids)
    cret: int = subst_type_expr(ck, a, a.n[gfd + {{O:FuncDef.return_type}}], bnd)
    cbody: int = subst_stmts(ck, a, sl_at(a, gfd, {{O:FuncDef.body}}), bnd)
    msr: int = ast_str_sym(ck, a, mangled_sym)
    conc: int = mk_FuncDef(a, pkx(msr), pky(msr), 0, 0, pkx(psl), pky(psl), cret, a.n[gfd + {{O:FuncDef.ret_omitted}}], pkx(cbody), pky(cbody), a.n[gfd + {{O:FuncDef.is_async}}], 0, 0, {{NONE}}, 0, 0, 0, a.n[gfd + {{O:FuncDef.globals}}], a.n[gfd + {{O:FuncDef.globals}} + 1], a.n[gfd + {{O:FuncDef.allow_await}}], a.n[gfd + {{O:FuncDef.line}}])
    register_func(ck, a, conc)
    check_function_body(ck, a, conc)
    sid: int = ck.fmap.vv[m2_get(ck.fmap, 0, mangled_sym)]
    check_lambda_args_against(ck, a, fx, sid, args)
    return ck.fret[sid]

def extract_generic_methods(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.class_def}}:
            continue
        cd: int = a.n[kn + 1]
        if pky(sl_at(a, cd, {{O:ClassDef.type_params}})) > 0:
            continue
        ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
        has_gm: bool = False
        for j in range(pky(ms)):
            m: int = stmt_at(a, ms, j)
            if pky(sl_at(a, m, {{O:FuncDef.type_params}})) > 0:
                has_gm = True
                break
        if not has_gm:
            continue
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        csym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
        for k in range(pky(ms)):
            m2: int = stmt_at(a, ms, k)
            tps: int = sl_at(a, m2, {{O:FuncDef.type_params}})
            if pky(tps) == 0:
                continue
            mn: int = pk(a.n[m2 + {{O:FuncDef.name}}], a.n[m2 + {{O:FuncDef.name}} + 1])
            msym: int = sym_of(ck, a, mn)
            if pky(sl_at(a, m2, {{O:FuncDef.decorators}})) > 0 or a.n[m2 + {{O:FuncDef.is_async}}] != 0 or a.n[m2 + {{O:FuncDef.allow_await}}] != 0:
                raise unsup(ck, "class#method_features")
            mps: int = sl_at(a, m2, {{O:FuncDef.params}})
            if pky(tps) != 1:
                mp(ck, "generic method '")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "' can take a single type parameter (v1: `obj.method[T](...)` with a single type argument)")
                raise mk_fail(ck, "TypeMismatch")
            if sref_len(mn) >= 2 and sref_byte(a, mn, 0) == 95 and sref_byte(a, mn, 1) == 95:
                mp(ck, "special method '")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "' cannot be generic")
                raise mk_fail(ck, "TypeMismatch")
            if m2_get(ck.gmeth, csym, msym) >= 0:
                mp(ck, "generic method '")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "' is already defined")
                raise mk_fail(ck, "DuplicateDefinition")
            m2_put(ck.gmeth, csym, msym, m2)
            m2_put(ck.gm_names, 0, msym, 1)

def try_resolve_generic_method_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    explicit: bool = a.n[callee] == {{T:Expr.index}}
    at_e: int = callee
    if explicit:
        ix: int = a.n[callee + 1]
        if a.n[a.n[ix + {{O:Index.obj}}]] != {{T:Expr.attribute}}:
            return -1
        at_e = a.n[ix + {{O:Index.obj}}]
    elif a.n[callee] != {{T:Expr.attribute}}:
        return -1
    at_: int = a.n[at_e + 1]
    attr: int = pk(a.n[at_ + {{O:Attribute.attr}}], a.n[at_ + {{O:Attribute.attr}} + 1])
    asym: int = sym_of(ck, a, attr)
    if m2_get(ck.gm_names, 0, asym) < 0:
        return -1
    obj: int = a.n[at_ + {{O:Attribute.obj}}]
    if a.n[obj] == {{T:Expr.call}}:
        oc: int = a.n[obj + 1]
        ocal: int = a.n[oc + {{O:Call.callee}}]
        if a.n[ocal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[ocal + 1], a.n[ocal + 2]), "super"):
            return -1
    recv_t: int = check_expr(ck, a, fx, obj)
    if ck.tt.tag[recv_t] != 6:
        return -1
    cur: int = ck.tt.xa[recv_t]
    def_sym: int = -1
    gm: int = -1
    while cur >= 0:
        ge: int = m2_get(ck.gmeth, cur, asym)
        if ge >= 0:
            def_sym = cur
            gm = ck.gmeth.vv[ge]
            break
        ci: int = class_idx(ck, cur)
        if ci < 0:
            break
        cur = ck.cls_base[ci]
    if def_sym < 0:
        return -1
    args: int = sl_at(a, c, {{O:Call.args}})
    na: int = pky(args)
    for ki in range(na):
        if a.n[stmt_at(a, args, ki)] == {{T:Expr.kwarg}}:
            raise unsup(ck, "check_args_sig#kwarg")
    ps: int = sl_at(a, gm, {{O:FuncDef.params}})
    if pky(ps) != na + 1:
        mp(ck, "'")
        mp_sym(ck, def_sym)
        mp(ck, ".")
        mp_sym(ck, asym)
        mp(ck, "' expects ")
        mp_int(ck, pky(ps) - 1)
        mp(ck, " arguments, ")
        mp_int(ck, na)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    tps: int = sl_at(a, gm, {{O:FuncDef.type_params}})
    tpr: int = pk(a.l[pkx(tps)], a.l[pkx(tps) + 1])
    tpsym: int = sym_of(ck, a, tpr)
    bnd: Map2 = Map2()
    if explicit:
        ix2: int = a.n[callee + 1]
        te: int = index_expr_to_type_expr(ck, a, a.n[ix2 + {{O:Index.index}}])
        if te < 0:
            mp(ck, "the type argument of '")
            mp_sym(ck, def_sym)
            mp(ck, ".")
            mp_sym(ck, asym)
            mp(ck, "' could not be resolved (only a type name or a single-argument generic type)")
            raise mk_fail(ck, "TypeMismatch")
        m2_put(bnd, 0, tpsym, type_expr_to_type(ck, a, te))
    else:
        for pi in range(na):
            p: int = stmt_at(a, ps, pi + 1)
            pte: int = a.n[p + {{O:Param.type_expr}}]
            arg: int = stmt_at(a, args, pi)
            at_t: int = -1
            is_emp: bool = ((a.n[arg] == {{T:Expr.list_lit}} and a.n[arg + 2] == 0) or (a.n[arg] == {{T:Expr.dict_lit}} and a.n[arg + 2] == 0)) and not mentions_protocol(ck, a, pte)
            if is_emp:
                sv_c: int = len(ck.mb)
                sv_l: int = ck.cur_line
                sv_s: int = ck.cur_span
                try:
                    at_t = type_expr_to_type(ck, a, pte)
                except CkErr:
                    ck.mb = ck.mb[:sv_c]
                    ck.cur_line = sv_l
                    ck.cur_span = sv_s
                    at_t = -1
            if at_t < 0:
                at_t = check_expr(ck, a, fx, arg)
            unify_type_expr(ck, a, pte, at_t, tps, bnd, asym)
    be: int = m2_get(bnd, 0, tpsym)
    if be < 0:
        mp(ck, "for '")
        mp_sym(ck, def_sym)
        mp(ck, ".")
        mp_sym(ck, asym)
        mp(ck, "', the type parameter '")
        mp_sref(ck, a, tpr)
        mp(ck, "' could not be inferred (write `obj.")
        mp_sym(ck, asym)
        mp(ck, "[Type](...)` explicitly)")
        raise mk_fail(ck, "TypeMismatch")
    bound: int = bnd.vv[be]
    mangled_m: int = mangle_name_sym(ck, asym, [bound])
    def_ci: int = class_idx(ck, def_sym)
    me: int = m2_get(ck.cls_meths, def_ci, mangled_m)
    sid: int = -1
    if me >= 0:
        sid = ck.cls_meths.vv[me]
    else:
        pids: list[int] = []
        for pi2 in range(pky(ps)):
            p2: int = stmt_at(a, ps, pi2)
            pids.append(mk_Param(a, a.n[p2 + {{O:Param.name}}], a.n[p2 + {{O:Param.name}} + 1], a.n[p2 + {{O:Param.variadic}}], a.n[p2 + {{O:Param.var_kw}}], a.n[p2 + {{O:Param.kw_only}}], a.n[p2 + {{O:Param.pos_only}}], subst_type_expr(ck, a, a.n[p2 + {{O:Param.type_expr}}], bnd), a.n[p2 + {{O:Param.self_inferred}}], a.n[p2 + {{O:Param.default}}]))
        psl: int = list_put_slice(a, pids)
        cret: int = subst_type_expr(ck, a, a.n[gm + {{O:FuncDef.return_type}}], bnd)
        cbody: int = subst_stmts(ck, a, sl_at(a, gm, {{O:FuncDef.body}}), bnd)
        msr: int = ast_str_sym(ck, a, mangled_m)
        conc: int = mk_FuncDef(a, pkx(msr), pky(msr), 0, 0, pkx(psl), pky(psl), cret, a.n[gm + {{O:FuncDef.ret_omitted}}], pkx(cbody), pky(cbody), a.n[gm + {{O:FuncDef.is_async}}], 0, 0, {{NONE}}, 0, 0, 0, a.n[gm + {{O:FuncDef.globals}}], a.n[gm + {{O:FuncDef.globals}} + 1], a.n[gm + {{O:FuncDef.allow_await}}], a.n[gm + {{O:FuncDef.line}}])
        stys: list[int] = []
        snms: list[int] = []
        for pi3 in range(pky(psl) - 1):
            sp_n: int = stmt_at(a, psl, pi3 + 1)
            stys.append(type_expr_to_type(ck, a, a.n[sp_n + {{O:Param.type_expr}}]))
            snms.append(sym_of(ck, a, pk(a.n[sp_n + {{O:Param.name}}], a.n[sp_n + {{O:Param.name}} + 1])))
        sret: int = type_expr_to_type(ck, a, cret)
        sid = new_sig(ck, stys, snms, sret)
        ck.fdecl[sid] = pk(pkx(psl) + 1, pky(psl) - 1)
        for sci in range(len(ck.cls_sym)):
            if is_subclass(ck.tt, ck.cls_sym[sci], def_sym):
                m2_put(ck.cls_meths, sci, mangled_m, sid)
        sv_cl: int = ck.cur_line
        sv_cs: int = ck.cur_span
        try:
            check_method_body(ck, a, def_ci, conc, False)
        finally:
            ck.cur_line = sv_cl
            ck.cur_span = sv_cs
    check_args_sig(ck, a, fx, c, sid, mangled_m)
    return ck.fret[sid]

def extract_static_methods(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.class_def}}:
            continue
        cd: int = a.n[kn + 1]
        ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
        touched: bool = False
        for mi in range(pky(ms)):
            m: int = stmt_at(a, ms, mi)
            ds: int = sl_at(a, m, {{O:FuncDef.decorators}})
            for di in range(pky(ds)):
                d: int = stmt_at(a, ds, di)
                dn: str = sref_str(a, pk(a.n[d + {{O:Decorator.name}}], a.n[d + {{O:Decorator.name}} + 1]))
                if dn == "staticmethod" or dn == "classmethod" or dn == "property" or (len(dn) > 7 and dn[len(dn) - 7:] == ".setter"):
                    touched = True
                    break
            if touched:
                break
        if not touched:
            continue
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        csym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
        if pky(sl_at(a, cd, {{O:ClassDef.type_params}})) > 0:
            mp(ck, "'@staticmethod'/'@classmethod'/'@property' are not supported in generic classes: ")
            mp_sym(ck, csym)
            raise mk_fail(ck, "TypeMismatch")
        kept: list[int] = []
        for mi2 in range(pky(ms)):
            m2: int = stmt_at(a, ms, mi2)
            ds2: int = sl_at(a, m2, {{O:FuncDef.decorators}})
            kind: int = 0
            setter_of: str = ""
            others: int = 0
            for di2 in range(pky(ds2)):
                d2: int = stmt_at(a, ds2, di2)
                dn2: str = sref_str(a, pk(a.n[d2 + {{O:Decorator.name}}], a.n[d2 + {{O:Decorator.name}} + 1]))
                if dn2 == "staticmethod":
                    kind = 1
                elif dn2 == "classmethod":
                    kind = 2
                elif dn2 == "property":
                    kind = 3
                elif len(dn2) > 7 and dn2[len(dn2) - 7:] == ".setter":
                    kind = 4
                    setter_of = dn2[:len(dn2) - 7]
                else:
                    others = others + 1
            if kind == 0:
                kept.append(m2)
                continue
            mnm: int = pk(a.n[m2 + {{O:FuncDef.name}}], a.n[m2 + {{O:FuncDef.name}} + 1])
            msym: int = sym_of(ck, a, mnm)
            if others > 0 or pky(ds2) > 1:
                mp(ck, "'")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sym(ck, msym)
                mp(ck, "': '@staticmethod'/'@classmethod'/'@property' cannot be combined with other decorators")
                raise mk_fail(ck, "TypeMismatch")
            if pky(sl_at(a, m2, {{O:FuncDef.type_params}})) > 0:
                mp(ck, "'")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sym(ck, msym)
                mp(ck, "' cannot be generic")
                raise mk_fail(ck, "TypeMismatch")
            if kind == 1 or kind == 2:
                mps: int = sl_at(a, m2, {{O:FuncDef.params}})
                if kind == 2:
                    if pky(mps) == 0 or not sref_eq(a, pk(a.n[stmt_at(a, mps, 0) + {{O:Param.name}}], a.n[stmt_at(a, mps, 0) + {{O:Param.name}} + 1]), "cls"):
                        mp(ck, "'@classmethod' '")
                        mp_sym(ck, csym)
                        mp(ck, ".")
                        mp_sym(ck, msym)
                        mp(ck, "' must take 'cls' as its first parameter")
                        raise mk_fail(ck, "TypeMismatch")
                elif pky(mps) > 0:
                    p0sr: int = pk(a.n[stmt_at(a, mps, 0) + {{O:Param.name}}], a.n[stmt_at(a, mps, 0) + {{O:Param.name}} + 1])
                    if sref_eq(a, p0sr, "self") or sref_eq(a, p0sr, "cls"):
                        mp(ck, "'@staticmethod' '")
                        mp_sym(ck, csym)
                        mp(ck, ".")
                        mp_sym(ck, msym)
                        mp(ck, "' cannot take '")
                        mp_sref(ck, a, p0sr)
                        mp(ck, "' as a parameter")
                        raise mk_fail(ck, "TypeMismatch")
                if m2_get(ck.static_meths, csym, msym) >= 0:
                    mp(ck, "method '")
                    mp_sym(ck, csym)
                    mp(ck, ".")
                    mp_sym(ck, msym)
                    mp(ck, "' is already defined")
                    raise mk_fail(ck, "DuplicateDefinition")
                for mi3 in range(pky(ms)):
                    mo: int = stmt_at(a, ms, mi3)
                    if pky(sl_at(a, mo, {{O:FuncDef.decorators}})) == 0 and sym_of(ck, a, pk(a.n[mo + {{O:FuncDef.name}}], a.n[mo + {{O:FuncDef.name}} + 1])) == msym:
                        mp(ck, "method '")
                        mp_sym(ck, csym)
                        mp(ck, ".")
                        mp_sym(ck, msym)
                        mp(ck, "' is already defined")
                        raise mk_fail(ck, "DuplicateDefinition")
                a.n[m2 + {{O:FuncDef.decorators}}] = 0
                a.n[m2 + {{O:FuncDef.decorators}} + 1] = 0
                if kind == 2:
                    a.n[m2 + {{O:FuncDef.params}}] = pkx(mps) + 1
                    a.n[m2 + {{O:FuncDef.params}} + 1] = pky(mps) - 1
                m2_put(ck.static_meths, csym, msym, m2)
                m2_put(ck.static_owner, csym, msym, csym)
                m2_put(ck.static_is_cls, csym, msym, 1 if kind == 2 else 0)
                m2_put(ck.static_names, 0, msym, 1)
            elif kind == 3:
                a.n[m2 + {{O:FuncDef.decorators}}] = 0
                a.n[m2 + {{O:FuncDef.decorators}} + 1] = 0
                if m2_get(ck.props, csym, msym) < 0:
                    m2_put(ck.props, csym, msym, 0)
                kept.append(m2)
            else:
                a.n[m2 + {{O:FuncDef.decorators}}] = 0
                a.n[m2 + {{O:FuncDef.decorators}} + 1] = 0
                mps4: int = sl_at(a, m2, {{O:FuncDef.params}})
                if pky(mps4) != 2:
                    mp(ck, "the setter '")
                    mp_sym(ck, csym)
                    mp(ck, ".")
                    mp_sym(ck, msym)
                    mp(ck, "' must take (self, value)")
                    raise mk_fail(ck, "TypeMismatch")
                ssym: int = sym_lit(ck, "__setprop_" + setter_of)
                ssr: int = ast_str_sym(ck, a, ssym)
                a.n[m2 + {{O:FuncDef.name}}] = pkx(ssr)
                a.n[m2 + {{O:FuncDef.name}} + 1] = pky(ssr)
                m2_put(ck.props, csym, sym_lit(ck, setter_of), 1)
                kept.append(m2)
        for pe in range(len(ck.props.k1)):
            if ck.props.k1[pe] == csym and ck.props.dead[pe] == 0:
                psym_p: int = ck.props.k2[pe]
                has_g: bool = False
                for ki in range(len(kept)):
                    km: int = kept[ki]
                    if sym_of(ck, a, pk(a.n[km + {{O:FuncDef.name}}], a.n[km + {{O:FuncDef.name}} + 1])) == psym_p:
                        has_g = True
                        break
                if not has_g:
                    mp(ck, "property '")
                    mp_sym(ck, csym)
                    mp(ck, ".")
                    mp_sym(ck, psym_p)
                    mp(ck, "' has a setter but no '@property' getter")
                    raise mk_fail(ck, "TypeMismatch")
        ksl: int = list_put_slice(a, kept)
        a.n[cd + {{O:ClassDef.methods}}] = pkx(ksl)
        a.n[cd + {{O:ClassDef.methods}} + 1] = pky(ksl)

# `resolveGenericBases`: `class Sub(Base[int]):` -> somut `Base__int` tabanı (`defer_cls_body = True` ile gövde sonra denetlenir).
def resolve_generic_bases(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.class_def}}:
            continue
        cd: int = a.n[kn + 1]
        basl: int = sl_at(a, cd, {{O:ClassDef.base_args}})
        if pky(basl) == 0:
            continue
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        csym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
        if pky(sl_at(a, cd, {{O:ClassDef.type_params}})) > 0:
            mp(ck, "a generic class ('")
            mp_sym(ck, csym)
            mp(ck, "') cannot have a base class (generic + inheritance is not supported in v1)")
            raise mk_fail(ck, "TypeMismatch")
        if pky(sl_at(a, cd, {{O:ClassDef.extra_bases}})) > 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': a concrete generic base ('")
            mp_sref(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1]))
            mp(ck, "[...]') cannot be combined with other base classes")
            raise mk_fail(ck, "TypeMismatch")
        te: int = mk_TypeExpr_generic(a, mk_Generic(a, a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1], pkx(basl), pky(basl)))
        ck.defer_cls_body = True
        t: int = -1
        try:
            t = type_expr_to_type(ck, a, te)
        finally:
            ck.defer_cls_body = False
        if ck.tt.tag[t] != 6:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': base '")
            mp_sref(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1]))
            mp(ck, "[...]' is not a class")
            raise mk_fail(ck, "TypeMismatch")
        bsr: int = ast_str_sym(ck, a, ck.tt.xa[t])
        a.n[cd + {{O:ClassDef.base}}] = pkx(bsr)
        a.n[cd + {{O:ClassDef.base}} + 1] = pky(bsr)
        a.n[cd + {{O:ClassDef.base_args}}] = 0
        a.n[cd + {{O:ClassDef.base_args}} + 1] = 0

def check_pending_inst(ck: Ck, a: Ast) -> None:
    i: int = 0
    while i < len(ck.pending_inst):
        ensure_class_checked(ck, a, ck.pending_inst[i])
        i = i + 1
    ck.pending_inst = []

# `collectClassNames`: ad kaydı + kapsam dışı sınıf özellikleri (kalıtım/dekoratör/sabit/enum/mixin) + jenerik sınıf şablonları
def collect_class_names(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.class_def}}:
            continue
        cd: int = a.n[kn + 1]
        nm: int = pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1])
        sym: int = sym_of(ck, a, nm)
        if class_idx(ck, sym) >= 0 or m2_get(ck.gcls, 0, sym) >= 0:
            mp(ck, "class already defined: ")
            mp_sym(ck, sym)
            raise mk_fail(ck, "DuplicateDefinition")
        if pky(sl_at(a, cd, {{O:ClassDef.type_params}})) > 0:
            if a.n[cd + {{O:ClassDef.base}}] != {{NONE}}:
                mp(ck, "a generic class ('")
                mp_sym(ck, sym)
                mp(ck, "') cannot have a base class (generic + inheritance is not supported in v1)")
                raise mk_fail(ck, "TypeMismatch")
            gms: int = sl_at(a, cd, {{O:ClassDef.methods}})
            for gi in range(pky(gms)):
                gm: int = stmt_at(a, gms, gi)
                gds: int = sl_at(a, gm, {{O:FuncDef.decorators}})
                for gdi in range(pky(gds)):
                    gd0: int = stmt_at(a, gds, gdi)
                    gdn: int = pk(a.n[gd0 + {{O:Decorator.name}}], a.n[gd0 + {{O:Decorator.name}} + 1])
                    is_st: bool = sref_eq(a, gdn, "staticmethod") or sref_eq(a, gdn, "classmethod") or sref_eq(a, gdn, "property")
                    if not is_st and sref_len(gdn) > 7:
                        dl: int = sref_len(gdn)
                        if sref_byte(a, gdn, dl - 7) == 46 and sref_byte(a, gdn, dl - 6) == 115 and sref_byte(a, gdn, dl - 5) == 101 and sref_byte(a, gdn, dl - 4) == 116 and sref_byte(a, gdn, dl - 3) == 116 and sref_byte(a, gdn, dl - 2) == 101 and sref_byte(a, gdn, dl - 1) == 114:
                            is_st = True
                    if is_st:
                        mp(ck, "'@staticmethod'/'@classmethod'/'@property' are not supported in generic classes: ")
                        mp_sym(ck, sym)
                        raise mk_fail(ck, "TypeMismatch")
            m2_put(ck.gcls, 0, sym, cd)
            continue
        idx: int = len(ck.cls_sym)
        ck.cls_sym.append(sym)
        ck.cls_node.append(cd)
        ck.cls_init.append(-1)
        ck.cls_base.append(-1)
        ck.cls_regd.append(0)
        ck.cls_chk.append(0)
        ck.tup_s.append(-1)
        ck.tup_n.append(0)
        ck.cls_synth.append(0)
        ck.gcls_ts.append(-1)
        ck.gcls_tn.append(0)
        m2_put(ck.cls_map, 0, sym, idx)
        cls_register(ck.tt, sym)

# `mixin_flatten.run` (tekli taban yolu): sınıflar metin sırasıyla gezilir, taban (yerel ya da `from`-import) önce; ziyaret halindeki sınıfa dönülürse döngü hatası. Çoklu taban/mixin kapsam dışı.
def resolve_cls_pass(ck: Ck, cn: list[int], nsym: int) -> int:
    for j in range(len(cn) - 1, -1, -1):
        if cn[j] == nsym:
            return j
    fe: int = m2_get(ck.fimp, 0, nsym)
    if fe >= 0:
        q: int = ck.fimp.vv[fe]
        for j2 in range(len(cn) - 1, -1, -1):
            if cn[j2] == q:
                return j2
    return -1

def flatten_cls(ck: Ck, cn: list[int], cb: list[int], cl: list[int], done: Map2, vis: Map2, i: int) -> None:
    nm: int = cn[i]
    if m2_get(done, 0, nm) >= 0:
        return
    if m2_get(vis, 0, nm) >= 0:
        last: int = len(cn) - 1
        while cn[last] != nm:
            last = last - 1
        ck.cur_line = cl[last]
        mp(ck, "class '")
        mp_sym(ck, nm)
        mp(ck, "': cyclic base classes")
        raise mk_fail(ck, "TypeMismatch")
    m2_put(vis, 0, nm, 1)
    if cb[i] >= 0:
        j: int = resolve_cls_pass(ck, cn, cb[i])
        if j >= 0:
            flatten_cls(ck, cn, cb, cl, done, vis, j)
    m2_remove(vis, 0, nm)
    m2_put(done, 0, nm, 1)

def check_base_cycles(ck: Ck, a: Ast, body: int) -> None:
    cn: list[int] = []
    cb: list[int] = []
    cl: list[int] = []
    any_base: bool = False
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.class_def}}:
            continue
        cd: int = a.n[kn + 1]
        cn.append(sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1])))
        cl.append(a.n[st + {{O:Stmt.line}}])
        if a.n[cd + {{O:ClassDef.base}}] != {{NONE}}:
            cb.append(sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1])))
            any_base = True
        else:
            cb.append(-1)
    if not any_base:
        return
    done: Map2 = Map2()
    vis: Map2 = Map2()
    for k in range(len(cn)):
        flatten_cls(ck, cn, cb, cl, done, vis, k)

# `ensureClassSignatureRegistered`: taban (yerel sınıfsa) önce kaydedilir; döngüsel kalıtım hatası.
def ensure_class_sig(ck: Ck, a: Ast, idx: int) -> None:
    if ck.cls_regd[idx] == 2:
        return
    if ck.cls_regd[idx] == 1:
        mp(ck, "cyclic inheritance between classes detected: ")
        mp_sym(ck, ck.cls_sym[idx])
        raise mk_fail(ck, "TypeMismatch")
    ck.cls_regd[idx] = 1
    cd: int = ck.cls_node[idx]
    if a.n[cd + {{O:ClassDef.base}}] != {{NONE}}:
        bi: int = class_idx(ck, sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1])))
        if bi >= 0:
            ensure_class_sig(ck, a, bi)
    register_class_sigs(ck, a, idx)
    ck.cls_regd[idx] = 2

# `registerClassSignatures` (tekli kalıtım; sabitler/dekoratörler/çoklu taban/jenerik kapsam dışı)
def register_class_sigs(ck: Ck, a: Ast, idx: int) -> None:
    cd: int = ck.cls_node[idx]
    csym: int = ck.cls_sym[idx]
    ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        if pky(sl_at(a, m, {{O:FuncDef.type_params}})) > 0:
            continue
        mn: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
        if sref_eq(a, mn, "release") or sref_eq(a, mn, "trace") or sref_eq(a, mn, "gc_free"):
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': the method name '")
            mp_sref(ck, a, mn)
            mp(ck, "' is reserved (the compiler generates a '")
            mp_sym(ck, csym)
            mp(ck, "_")
            mp_sref(ck, a, mn)
            mp(ck, "' function for every class) — rename the method")
            raise mk_fail(ck, "DuplicateDefinition")
    has_base: bool = a.n[cd + {{O:ClassDef.base}}] != {{NONE}}
    if has_base:
        # taban adı: yerel sınıf yoksa `from X import Base` geri düşüşü; sonra taban alanları/metodları/`__init__` imzası kopyalanır
        bsym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1]))
        if class_idx(ck, bsym) < 0:
            bfe: int = m2_get(ck.fimp, 0, bsym)
            if bfe >= 0:
                bsym = ck.fimp.vv[bfe]
        bi: int = class_idx(ck, bsym)
        if bi < 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "' has an unknown base class: ")
            mp_sym(ck, bsym)
            raise mk_fail(ck, "UndefinedClass")
        ck.cls_base[idx] = bsym
        cls_set_base(ck.tt, csym, bsym)
        for e in range(len(ck.cls_fields.k1)):
            if ck.cls_fields.k1[e] == bi and ck.cls_fields.dead[e] == 0:
                m2_put(ck.cls_fields, idx, ck.cls_fields.k2[e], ck.cls_fields.vv[e])
        for e2 in range(len(ck.cls_meths.k1)):
            if ck.cls_meths.k1[e2] == bi and ck.cls_meths.dead[e2] == 0:
                m2_put(ck.cls_meths, idx, ck.cls_meths.k2[e2], ck.cls_meths.vv[e2])
                oe_m: int = m2_get(ck.cls_meth_owners, bi, ck.cls_meths.k2[e2])
                if oe_m >= 0:
                    m2_put(ck.cls_meth_owners, idx, ck.cls_meths.k2[e2], ck.cls_meth_owners.vv[oe_m])
        ck.cls_init[idx] = ck.cls_init[bi]
        for e3 in range(len(ck.cls_consts_ty.k1)):
            if ck.cls_consts_ty.k1[e3] == bi and ck.cls_consts_ty.dead[e3] == 0:
                ks_b: int = ck.cls_consts_ty.k2[e3]
                m2_put(ck.cls_consts_ty, idx, ks_b, ck.cls_consts_ty.vv[e3])
                oe_b: int = m2_get(ck.cls_consts_owner, bi, ks_b)
                if oe_b >= 0:
                    m2_put(ck.cls_consts_owner, idx, ks_b, ck.cls_consts_owner.vv[oe_b])
                pe_b: int = m2_get(ck.cls_consts_prom, bi, ks_b)
                if pe_b >= 0:
                    m2_put(ck.cls_consts_prom, idx, ks_b, ck.cls_consts_prom.vv[pe_b])
    mxs_sl: int = sl_at(a, cd, {{O:ClassDef.mixins}})
    for mxi in range(pky(mxs_sl)):
        mxsym: int = sym_of(ck, a, pk(a.l[pkx(mxs_sl) + mxi * 2], a.l[pkx(mxs_sl) + mxi * 2 + 1]))
        cls_add_mixin(ck.tt, csym, mxsym)
    saw_repr_c: bool = False
    saw_packed: bool = False
    c_decs: int = sl_at(a, cd, {{O:ClassDef.decorators}})
    for cdi in range(pky(c_decs)):
        cdec: int = stmt_at(a, c_decs, cdi)
        cdn: int = pk(a.n[cdec + {{O:Decorator.name}}], a.n[cdec + {{O:Decorator.name}} + 1])
        cargs: int = sl_at(a, cdec, {{O:Decorator.args}})
        if sref_eq(a, cdn, "repr"):
            if pky(cargs) != 1 or a.n[stmt_at(a, cargs, 0)] != {{T:Expr.string_lit}}:
                mp(ck, "@repr only supports a single \"C\" string argument: class ")
                mp_sym(ck, csym)
                raise mk_fail(ck, "TypeMismatch")
            ca0: int = stmt_at(a, cargs, 0)
            if not sref_eq(a, pk(a.n[ca0 + 1], a.n[ca0 + 2]), "C"):
                mp(ck, "@repr only supports a single \"C\" string argument: class ")
                mp_sym(ck, csym)
                raise mk_fail(ck, "TypeMismatch")
            saw_repr_c = True
        elif sref_eq(a, cdn, "packed"):
            if pky(cargs) != 0:
                mp(ck, "@packed takes no arguments: class ")
                mp_sym(ck, csym)
                raise mk_fail(ck, "TypeMismatch")
            saw_packed = True
        else:
            parse_decorator_args(ck, a, cdec, csym)
    lmode: int = 2 if saw_packed else (1 if saw_repr_c else 0)
    m2_put(ck.cls_layout, 0, idx, lmode)
    if has_base:
        bl_e: int = m2_get(ck.cls_layout, 0, class_idx(ck, ck.cls_base[idx]))
        blmode: int = ck.cls_layout.vv[bl_e] if bl_e >= 0 else 0
        if lmode != blmode:
            mp(ck, "the @repr/@packed state of class '")
            mp_sym(ck, csym)
            mp(ck, "' does not match its base class '")
            mp_sym(ck, ck.cls_base[idx])
            mp(ck, "' (ALL classes in a class hierarchy must share the same layout mode)")
            raise mk_fail(ck, "TypeMismatch")
    kds: int = sl_at(a, cd, {{O:ClassDef.consts}})
    fs: int = sl_at(a, cd, {{O:ClassDef.fields}})
    saved_line_k: int = ck.cur_line
    for ki in range(pky(kds)):
        kd: int = stmt_at(a, kds, ki)
        kline: int = a.n[kd + {{O:ConstDecl.line}}]
        if kline != 0:
            ck.cur_line = kline
        knm: int = pk(a.n[kd + {{O:ConstDecl.name}}], a.n[kd + {{O:ConstDecl.name}} + 1])
        ksym: int = sym_of(ck, a, knm)
        k_decl: int = type_expr_to_type(ck, a, a.n[kd + {{O:ConstDecl.type_expr}}])
        kval: int = a.n[kd + {{O:ConstDecl.value}}]
        kvt: int = a.n[kval]
        lit_t: int = -1
        if kvt == {{T:Expr.int_lit}}:
            lit_t = 0
        elif kvt == {{T:Expr.float_lit}}:
            lit_t = 1
        elif kvt == {{T:Expr.bool_lit}}:
            lit_t = 2
        elif kvt == {{T:Expr.string_lit}}:
            lit_t = 3
        elif kvt == {{T:Expr.unary}}:
            kup: int = a.n[kval + 1]
            if a.n[kup + {{O:Unary.op}}] == {{E:UnaryOp.neg}}:
                kuop: int = a.n[a.n[kup + {{O:Unary.operand}}]]
                if kuop == {{T:Expr.int_lit}}:
                    lit_t = 0
                elif kuop == {{T:Expr.float_lit}}:
                    lit_t = 1
        if lit_t < 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': the value of constant '")
            mp_sref(ck, a, knm)
            mp(ck, "' must be a constant literal (int/float/bool/str)")
            raise mk_fail(ck, "TypeMismatch")
        if not ty_assignable(ck.tt, k_decl, lit_t):
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': the value of constant '")
            mp_sref(ck, a, knm)
            mp(ck, "' does not match its declared type")
            raise mk_fail(ck, "TypeMismatch")
        if k_decl != 0 and k_decl != 1 and k_decl != 2 and k_decl != 3:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': constant '")
            mp_sref(ck, a, knm)
            mp(ck, "' must be int, float, bool or str")
            raise mk_fail(ck, "TypeMismatch")
        same_k: int = 0
        for ki2 in range(pky(kds)):
            kd2: int = stmt_at(a, kds, ki2)
            knm2: int = pk(a.n[kd2 + {{O:ConstDecl.name}}], a.n[kd2 + {{O:ConstDecl.name}} + 1])
            if sref_eq_ref(a, knm2, knm):
                same_k = same_k + 1
        if same_k > 1:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': constant '")
            mp_sref(ck, a, knm)
            mp(ck, "' is declared twice")
            raise mk_fail(ck, "DuplicateDefinition")
        for fj in range(pky(fs)):
            fd_k: int = stmt_at(a, fs, fj)
            fnm_k: int = pk(a.n[fd_k + {{O:FieldDecl.name}}], a.n[fd_k + {{O:FieldDecl.name}} + 1])
            if sref_eq_ref(a, fnm_k, knm):
                mp(ck, "class '")
                mp_sym(ck, csym)
                mp(ck, "': '")
                mp_sref(ck, a, knm)
                mp(ck, "' is both a field and a constant")
                raise mk_fail(ck, "DuplicateDefinition")
        kown: int = csym
        if a.n[kd + {{O:ConstDecl.owner}}] != {{NONE}}:
            kown = sym_of(ck, a, pk(a.n[kd + {{O:ConstDecl.owner}}], a.n[kd + {{O:ConstDecl.owner}} + 1]))
        m2_put(ck.cls_consts_ty, idx, ksym, k_decl)
        m2_put(ck.cls_consts_owner, idx, ksym, kown)
        m2_put(ck.cls_consts_prom, idx, ksym, a.n[kd + {{O:ConstDecl.promoted}}])
    ck.cur_line = saved_line_k
    for j in range(pky(fs)):
        f: int = stmt_at(a, fs, j)
        fsym: int = sym_of(ck, a, pk(a.n[f + {{O:FieldDecl.name}}], a.n[f + {{O:FieldDecl.name}} + 1]))
        if m2_get(ck.cls_fields, idx, fsym) >= 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': field '")
            mp_sym(ck, fsym)
            if has_base:
                mp(ck, "' is already declared (perhaps in a base class)")
            else:
                mp(ck, "' is already declared")
            raise mk_fail(ck, "DuplicateDefinition")
        ft: int = type_expr_to_type(ck, a, a.n[f + {{O:FieldDecl.type_expr}}])
        m2_put(ck.cls_fields, idx, fsym, ft)
        m2_put(ck.cls_unas, idx, fsym, 1)
        # classHasNonArcFields: bildirilen alan tipi Task/Channel/ThreadHandle/ThreadChannel/TaskLocal
        g: int = ck.tt.tag[ft]
        if ck.cls_synth[idx] == 0 and (g == 7 or g == 8 or g == 9 or g == 10 or g == 11):
            cls_set_nonarc(ck.tt, csym, 1)
    for k in range(pky(ms)):
        m2: int = stmt_at(a, ms, k)
        if pky(sl_at(a, m2, {{O:FuncDef.type_params}})) > 0:
            continue
        mname: int = pk(a.n[m2 + {{O:FuncDef.name}}], a.n[m2 + {{O:FuncDef.name}} + 1])
        ps: int = sl_at(a, m2, {{O:FuncDef.params}})
        p0n: int = 0
        if pky(ps) > 0:
            p0: int = stmt_at(a, ps, 0)
            p0n = pk(a.n[p0 + {{O:Param.name}}], a.n[p0 + {{O:Param.name}} + 1])
        if pky(ps) == 0 or not sref_eq(a, p0n, "self"):
            mp(ck, "method '")
            mp_sym(ck, csym)
            mp(ck, ".")
            mp_sref(ck, a, mname)
            mp(ck, "' must take 'self' as its first parameter")
            raise mk_fail(ck, "TypeMismatch")
        p0t: int = a.n[stmt_at(a, ps, 0) + {{O:Param.type_expr}}]
        self_ok: bool = a.n[p0t] == {{T:TypeExpr.simple}} and sym_of(ck, a, pk(a.n[p0t + 1], a.n[p0t + 2])) == csym
        if not self_ok:
            mp(ck, "inside method '")
            mp_sym(ck, csym)
            mp(ck, ".")
            mp_sref(ck, a, mname)
            mp(ck, "', the type of 'self' must be '")
            mp_sym(ck, csym)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        tys: list[int] = []
        pnames: list[int] = []
        for q in range(1, pky(ps)):
            pn: int = stmt_at(a, ps, q)
            tys.append(type_expr_to_type(ck, a, a.n[pn + {{O:Param.type_expr}}]))
            pnames.append(sym_of(ck, a, pk(a.n[pn + {{O:Param.name}}], a.n[pn + {{O:Param.name}} + 1])))
        ret: int = type_expr_to_type(ck, a, a.n[m2 + {{O:FuncDef.return_type}}])
        validate_param_defaults(ck, a, mname, ps, 1, False)
        if sref_eq(a, mname, "__del__"):
            if len(tys) != 0 or ret != 4 or a.n[m2 + {{O:FuncDef.is_async}}] != 0:
                mp(ck, "'")
                mp_sym(ck, csym)
                mp(ck, ".__del__' must be `def __del__(self) -> None:` (no other parameters, no return value, not async)")
                raise mk_fail(ck, "TypeMismatch")
        sid: int = new_sig(ck, tys, pnames, ret)
        ck.fdecl[sid] = pk(pkx(ps) + 1, pky(ps) - 1)
        if sref_eq(a, mname, "__init__"):
            ck.cls_init[idx] = sid
        else:
            msym: int = sym_of(ck, a, mname)
            ie: int = m2_get(ck.cls_meths, idx, msym)
            if ie >= 0 and not sig_eq_ignoring_self(ck, ck.cls_meths.vv[ie], sid):
                mp(ck, "method '")
                mp_sym(ck, csym)
                mp(ck, ".")
                mp_sref(ck, a, mname)
                mp(ck, "' does not match the signature in the base class (an override requires an exact signature match)")
                raise mk_fail(ck, "TypeMismatch")
            m2_put(ck.cls_meths, idx, msym, sid)
            m2_put(ck.cls_meth_owners, idx, msym, csym)
            m_decs: int = sl_at(a, m2, {{O:FuncDef.decorators}})
            mstr_q: str = sym_to_str(ck, csym) + "." + sref_str(a, mname)
            for mdi in range(pky(m_decs)):
                mdec: int = stmt_at(a, m_decs, mdi)
                mdn: int = pk(a.n[mdec + {{O:Decorator.name}}], a.n[mdec + {{O:Decorator.name}} + 1])
                if sref_eq(a, mdn, "capability.requires"):
                    register_capability_decorator(ck, a, sym_lit(ck, mstr_q), sl_at(a, mdec, {{O:Decorator.args}}))
                else:
                    parse_decorator_args(ck, a, mdec, sym_lit(ck, mstr_q))

# `funcSigEqlIgnoringSelf`: parametre tipleri (self hariç) ve dönüş tipi TypeId eşitliği (hash-consing ⇒ `types.eql`).
def sig_eq_ignoring_self(ck: Ck, s1: int, s2: int) -> bool:
    if ck.fpn[s1] != ck.fpn[s2]:
        return False
    for i in range(ck.fpn[s1]):
        if ck.fpar[ck.fps[s1] + i] != ck.fpar[ck.fps[s2] + i]:
            return False
    return ck.fret[s1] == ck.fret[s2]

# `ensureClassBodyChecked`: taban gövdesi önce denetlenir, çıkarsanan alanlar türetilene (yoksa) kopyalanır.
def ensure_class_checked(ck: Ck, a: Ast, idx: int) -> None:
    if ck.cls_chk[idx] != 0:
        return
    ck.cls_chk[idx] = 1
    bsym: int = ck.cls_base[idx]
    if bsym >= 0:
        bi: int = class_idx(ck, bsym)
        if bi >= 0:
            ensure_class_checked(ck, a, bi)
            for e in range(len(ck.cls_fields.k1)):
                if ck.cls_fields.k1[e] == bi and ck.cls_fields.dead[e] == 0 and m2_get(ck.cls_fields, idx, ck.cls_fields.k2[e]) < 0:
                    m2_put(ck.cls_fields, idx, ck.cls_fields.k2[e], ck.cls_fields.vv[e])
    check_class(ck, a, idx)

def is_mixin_init_sref(a: Ast, sr: int) -> bool:
    s: str = sref_str(a, sr)
    return len(s) > 11 and s[:11] == "__nox_init_"

def validate_mixin_compat(ck: Ck, a: Ast, idx: int) -> None:
    cd: int = ck.cls_node[idx]
    mxs: int = sl_at(a, cd, {{O:ClassDef.mixins}})
    if pky(mxs) == 0:
        return
    csym: int = ck.cls_sym[idx]
    for i in range(pky(mxs)):
        msym: int = sym_of(ck, a, pk(a.l[pkx(mxs) + i * 2], a.l[pkx(mxs) + i * 2 + 1]))
        mi: int = class_idx(ck, msym)
        if mi < 0:
            continue
        for e in range(len(ck.cls_meths.k1)):
            if ck.cls_meths.k1[e] == mi and ck.cls_meths.dead[e] == 0:
                mn_sym: int = ck.cls_meths.k2[e]
                mn_str: str = sym_to_str(ck, mn_sym)
                if len(mn_str) >= 6 and mn_str[:6] == "__nox_":
                    continue
                ce: int = m2_get(ck.cls_meths, idx, mn_sym)
                if ce < 0:
                    continue
                if not sig_eq_ignoring_self(ck, ck.cls_meths.vv[ce], ck.cls_meths.vv[e]):
                    mp(ck, "class '")
                    mp_sym(ck, csym)
                    mp(ck, "': method '")
                    mp_sym(ck, mn_sym)
                    mp(ck, "' has a different signature in its base '")
                    mp_sym(ck, msym)
                    mp(ck, "' than in the class itself; a mixin type must be able to call the shared method")
                    raise mk_fail(ck, "TypeMismatch")
        for e2 in range(len(ck.cls_fields.k1)):
            if ck.cls_fields.k1[e2] == mi and ck.cls_fields.dead[e2] == 0:
                fn_sym: int = ck.cls_fields.k2[e2]
                fe: int = m2_get(ck.cls_fields, idx, fn_sym)
                if fe < 0:
                    continue
                if ck.cls_fields.vv[fe] != ck.cls_fields.vv[e2]:
                    mp(ck, "class '")
                    mp_sym(ck, csym)
                    mp(ck, "': field '")
                    mp_sym(ck, fn_sym)
                    mp(ck, "' has a different type in its base '")
                    mp_sym(ck, msym)
                    mp(ck, "' than in the class itself")
                    raise mk_fail(ck, "TypeMismatch")

# `checkClassBody` (tekli + mixin kalıtım)
def check_class(ck: Ck, a: Ast, idx: int) -> None:
    cd: int = ck.cls_node[idx]
    ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
    before: int = len(ck.dcode)
    for i0 in range(pky(ms)):
        m0: int = stmt_at(a, ms, i0)
        if pky(sl_at(a, m0, {{O:FuncDef.type_params}})) == 0 and is_mixin_init_sref(a, pk(a.n[m0 + {{O:FuncDef.name}}], a.n[m0 + {{O:FuncDef.name}} + 1])):
            check_method_guarded(ck, a, idx, m0, True)
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        if pky(sl_at(a, m, {{O:FuncDef.type_params}})) == 0 and sref_eq(a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1]), "__init__"):
            check_method_guarded(ck, a, idx, m, True)
    if len(ck.dcode) == before and pky(sl_at(a, cd, {{O:ClassDef.enum_variants}})) == 0:
        nun: int = 0
        usym: int = -1
        for e in range(len(ck.cls_unas.k1)):
            if ck.cls_unas.k1[e] == idx and ck.cls_unas.dead[e] == 0:
                nun = nun + 1
                usym = ck.cls_unas.k2[e]
        if nun > 1:
            # Zig HashMap yineleme sırası (tanı sırası) taklit edilemez: ≥2 atanmamış alan kapsam dışı
            raise unsup(ck, "class#unassigned_multi")
        if nun == 1:
            mp(ck, "class '")
            mp_sym(ck, ck.cls_sym[idx])
            mp(ck, "': the declared field '")
            mp_sym(ck, usym)
            mp(ck, "' is never assigned in __init__")
            mk_fail(ck, "UnassignedField")
            record_diag(ck, a)
    for j in range(pky(ms)):
        m2: int = stmt_at(a, ms, j)
        mn2: int = pk(a.n[m2 + {{O:FuncDef.name}}], a.n[m2 + {{O:FuncDef.name}} + 1])
        if pky(sl_at(a, m2, {{O:FuncDef.type_params}})) == 0 and not sref_eq(a, mn2, "__init__") and not is_mixin_init_sref(a, mn2):
            check_method_guarded(ck, a, idx, m2, False)
    try:
        validate_mixin_compat(ck, a, idx)
    except CkErr:
        record_diag(ck, a)

def check_method_guarded(ck: Ck, a: Ast, idx: int, m: int, is_init: bool) -> None:
    try:
        check_method_body(ck, a, idx, m, is_init)
    except CkErr:
        ck.depth = 0
        record_diag(ck, a)

# `checkMethodBody`
def check_method_body(ck: Ck, a: Ast, idx: int, m: int, is_init: bool) -> None:
    scope: int = sc_new(ck, -1, False)
    ps: int = sl_at(a, m, {{O:FuncDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        pt: int = type_expr_to_type(ck, a, a.n[p + {{O:Param.type_expr}}])
        sc_declare(ck, scope, sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])), pt)
    ret: int = type_expr_to_type(ck, a, a.n[m + {{O:FuncDef.return_type}}])
    fx: Fx = Fx(scope, ret, a.n[m + {{O:FuncDef.is_async}}] != 0 or a.n[m + {{O:FuncDef.allow_await}}] != 0)
    fx.self_cls = idx
    fx.is_init = is_init
    fx.fn_path = sym_to_str(ck, ck.cls_sym[idx]) + "_" + sym_to_str(ck, sym_of(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])))
    body: int = sl_at(a, m, {{O:FuncDef.body}})
    check_block(ck, a, fx, body)
    if ret != 4 and not always_returns(a, body):
        mp(ck, "method '")
        mp_sym(ck, ck.cls_sym[idx])
        mp(ck, ".")
        mp_sref(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1]))
        mp(ck, "' does not return a value on all paths")
        raise mk_fail(ck, "MissingReturn")

# `checkAttribute`: örnek alanı okuması (sınıf sabiti/property/enum kapsam dışı)
def receiver_class_name(ck: Ck, a: Ast, fx: Fx, e: int) -> int:
    if a.n[e] == {{T:Expr.attribute}}:
        raw: list[int] = []
        if not flatten_dotted(ck, a, e, raw) or len(raw) < 2:
            return -1
        if sc_lookup(ck, fx.scope, raw[0]) >= 0 or m2_get(ck.globs, 0, raw[0]) >= 0:
            return -1
        segs: list[int] = subst_alias(ck, raw)
        mod: int = join_syms(ck, segs, len(segs) - 1, 46)
        if m2_get(ck.imod, 0, mod) < 0:
            return -1
        mangled: int = join_syms(ck, segs, len(segs), 95)
        return class_idx(ck, mangled)
    if a.n[e] != {{T:Expr.identifier}}:
        return -1
    nm: int = sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2]))
    if fx.cls_alias >= 0 and sref_eq(a, pk(a.n[e + 1], a.n[e + 2]), "cls") and sc_lookup(ck, fx.scope, nm) < 0:
        return class_idx(ck, fx.cls_alias)
    if sc_lookup(ck, fx.scope, nm) >= 0 or m2_get(ck.globs, 0, nm) >= 0:
        return -1
    ci: int = class_idx(ck, nm)
    if ci >= 0:
        return ci
    fe: int = m2_get(ck.fimp, 0, nm)
    if fe >= 0:
        return class_idx(ck, ck.fimp.vv[fe])
    return -1

def find_enum_variant(a: Ast, cd: int, attr: int) -> int:
    evs: int = sl_at(a, cd, {{O:ClassDef.enum_variants}})
    for i in range(pky(evs)):
        ev: int = stmt_at(a, evs, i)
        if sref_eq_ref(a, pk(a.n[ev + {{O:EnumVariant.name}}], a.n[ev + {{O:EnumVariant.name}} + 1]), attr):
            return ev
    return -1

def find_enum_variant_sym(ck: Ck, a: Ast, cd: int, asym: int) -> int:
    evs: int = sl_at(a, cd, {{O:ClassDef.enum_variants}})
    for i in range(pky(evs)):
        ev: int = stmt_at(a, evs, i)
        if sym_of(ck, a, pk(a.n[ev + {{O:EnumVariant.name}}], a.n[ev + {{O:EnumVariant.name}} + 1])) == asym:
            return ev
    return -1

def find_property(ck: Ck, ci: int, asym: int) -> int:
    cur: int = ci
    while cur >= 0:
        pe: int = m2_get(ck.props, ck.cls_sym[cur], asym)
        if pe >= 0:
            return ck.props.vv[pe]
        bsym: int = ck.cls_base[cur]
        cur = class_idx(ck, bsym) if bsym >= 0 else -1
    return -1

def check_attribute(ck: Ck, a: Ast, fx: Fx, at: int) -> int:
    obj: int = a.n[at + {{O:Attribute.obj}}]
    attr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    asym: int = sym_of(ck, a, attr)
    gnm_e: int = generic_enum_name(ck, a, fx, obj)
    if gnm_e >= 0:
        gcd_e: int = ck.gcls.vv[m2_get(ck.gcls, 0, gnm_e)]
        astr_e: str = sref_str(a, attr)
        if len(astr_e) > 6 and astr_e[:6] == "__tag_":
            vsym_e: int = sym_lit(ck, astr_e[6:])
            if find_enum_variant_sym(ck, a, gcd_e, vsym_e) < 0:
                mp(ck, "enum '")
                mp_sym(ck, gnm_e)
                mp(ck, "' has no variant '")
                mp_sym(ck, vsym_e)
                mp(ck, "'")
                raise mk_fail(ck, "UndefinedAttribute")
            return 0
        ev_e: int = find_enum_variant(a, gcd_e, attr)
        if ev_e >= 0 and pky(sl_at(a, ev_e, {{O:EnumVariant.fields}})) == 0:
            mp(ck, "cannot infer the type arguments of generic enum '")
            mp_sym(ck, gnm_e)
            mp(ck, "' for '")
            mp_sym(ck, gnm_e)
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "': give the target a type (`x: ")
            mp_sym(ck, gnm_e)
            mp(ck, "[int] = ")
            mp_sym(ck, gnm_e)
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "`)")
            raise mk_fail(ck, "TypeMismatch")
    rc: int = receiver_class_name(ck, a, fx, obj)
    if rc >= 0:
        rc_cd: int = ck.cls_node[rc]
        if pky(sl_at(a, rc_cd, {{O:ClassDef.enum_variants}})) > 0:
            astr: str = sref_str(a, attr)
            if len(astr) > 6 and astr[:6] == "__tag_":
                vsym: int = sym_lit(ck, astr[6:])
                if find_enum_variant_sym(ck, a, rc_cd, vsym) < 0:
                    mp(ck, "enum '")
                    mp_sym(ck, ck.cls_sym[rc])
                    mp(ck, "' has no variant '")
                    mp_sym(ck, vsym)
                    mp(ck, "'")
                    raise mk_fail(ck, "UndefinedAttribute")
            else:
                ev: int = find_enum_variant(a, rc_cd, attr)
                if ev >= 0 and pky(sl_at(a, ev, {{O:EnumVariant.fields}})) == 0:
                    cal: int = mk_Expr_attribute(a, mk_Attribute(a, obj, pkx(attr), pky(attr)))
                    esl: int = list_put_slice(a, [])
                    return check_expr(ck, a, fx, mk_Expr_call(a, mk_Call(a, cal, pkx(esl), pky(esl), 0, 0, 0, 0, 0, 0)))
        ce: int = m2_get(ck.cls_consts_ty, rc, asym)
        if ce >= 0:
            return ck.cls_consts_ty.vv[ce]
    obj_t: int = check_expr(ck, a, fx, obj)
    require_not_optional_sref(ck, obj_t, a, attr)
    if ck.tt.tag[obj_t] != 6:
        mp(ck, "'.")
        mp_sref(ck, a, attr)
        mp(ck, "' can only be used on class instances")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, obj_t)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, ck.tt.xa[obj_t])
        raise mk_fail(ck, "UndefinedClass")
    fe: int = m2_get(ck.cls_fields, ci, asym)
    if fe >= 0:
        if fx.narrowed.live > 0:
            pks: str = path_key_str(ck, a, mk_Expr_attribute(a, at), 0)
            if len(pks) > 0:
                pne: int = m2_get(fx.narrowed, 0, sym_lit(ck, pks))
                if pne >= 0:
                    return fx.narrowed.vv[pne]
        return ck.cls_fields.vv[fe]
    ce2: int = m2_get(ck.cls_consts_ty, ci, asym)
    if ce2 >= 0:
        return ck.cls_consts_ty.vv[ce2]
    if ck.props.live > 0 and find_property(ck, ci, asym) >= 0:
        return check_expr(ck, a, fx, mk_dunder_call(a, obj, sref_str(a, attr), []))
    mp(ck, "class '")
    mp_sym(ck, ck.cls_sym[ci])
    mp(ck, "' has no field '")
    mp_sref(ck, a, attr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedAttribute")

def require_not_optional_sref(ck: Ck, t: int, a: Ast, what: int) -> None:
    if ck.tt.tag[t] == 15:
        mp(ck, "an Optional (T | None) value cannot be used for '")
        mp_sref(ck, a, what)
        mp(ck, "' — narrow it first with 'if ... != None:'")
        raise mk_fail(ck, "OptionalNotNarrowed")

# kök tanımlayıcı (a.b.c → a) `nox` mu (stdlib niteliklı çağrı: kapsam dışı)
def dotted_root_is(ck: Ck, a: Ast, e: int, name: str) -> bool:
    cur: int = e
    while a.n[cur] == {{T:Expr.attribute}}:
        cur = a.n[a.n[cur + 1] + {{O:Attribute.obj}}]
    if a.n[cur] != {{T:Expr.identifier}}:
        return False
    return sref_eq(a, pk(a.n[cur + 1], a.n[cur + 2]), name)

def validate_param_defaults(ck: Ck, a: Ast, fn_sr: int, ps: int, start_i: int, skip_types: bool) -> None:
    seen_default: bool = False
    for i in range(start_i, pky(ps)):
        p: int = stmt_at(a, ps, i)
        d: int = a.n[p + {{O:Param.default}}]
        pn: int = pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])
        if d < 0:
            if seen_default and a.n[p + {{O:Param.variadic}}] == 0 and a.n[p + {{O:Param.var_kw}}] == 0 and a.n[p + {{O:Param.kw_only}}] == 0:
                mp(ck, "'")
                mp_sref(ck, a, fn_sr)
                mp(ck, "': a parameter without a default value ('")
                mp_sref(ck, a, pn)
                mp(ck, "') cannot follow a parameter with a default value")
                raise mk_fail(ck, "TypeMismatch")
            continue
        seen_default = True
        dt: int = a.n[d]
        lit_t: int = -1
        if dt == {{T:Expr.int_lit}}:
            lit_t = 0
        elif dt == {{T:Expr.float_lit}}:
            lit_t = 1
        elif dt == {{T:Expr.bool_lit}}:
            lit_t = 2
        elif dt == {{T:Expr.string_lit}}:
            lit_t = 3
        elif dt == {{T:Expr.bytes_lit}}:
            lit_t = ty_mk(ck.tt, 18, 0, 0)
        elif dt == {{T:Expr.none_lit}}:
            lit_t = 4
        elif dt == {{T:Expr.unary}}:
            up: int = a.n[d + 1]
            uop: int = a.n[up + {{O:Unary.op}}]
            uod: int = a.n[up + {{O:Unary.operand}}]
            if uop == {{E:UnaryOp.neg}} and a.n[uod] == {{T:Expr.int_lit}}:
                lit_t = 0
            elif uop == {{E:UnaryOp.neg}} and a.n[uod] == {{T:Expr.float_lit}}:
                lit_t = 1
            else:
                mp(ck, "function '")
                mp_sref(ck, a, fn_sr)
                mp(ck, "', parameter '")
                mp_sref(ck, a, pn)
                mp(ck, "': the default value can only be a constant literal")
                raise mk_fail(ck, "TypeMismatch")
        else:
            mp(ck, "function '")
            mp_sref(ck, a, fn_sr)
            mp(ck, "', parameter '")
            mp_sref(ck, a, pn)
            mp(ck, "': the default value can only be a constant literal (int/float/bool/str/None, a negative number)")
            raise mk_fail(ck, "TypeMismatch")
        if skip_types:
            continue
        pt: int = type_expr_to_type(ck, a, a.n[p + {{O:Param.type_expr}}])
        ok: bool = False
        if lit_t == 4:
            ok = ck.tt.tag[pt] == 15
        else:
            ok = ty_assignable(ck.tt, pt, lit_t)
        if not ok:
            mp(ck, "function '")
            mp_sref(ck, a, fn_sr)
            mp(ck, "', parameter '")
            mp_sref(ck, a, pn)
            mp(ck, "': the type of the default value does not match the parameter type")
            raise mk_fail(ck, "TypeMismatch")

def any_variadic(a: Ast, decl: int) -> bool:
    for i in range(pky(decl)):
        p: int = stmt_at(a, decl, i)
        if a.n[p + {{O:Param.variadic}}] != 0 or a.n[p + {{O:Param.var_kw}}] != 0 or a.n[p + {{O:Param.kw_only}}] != 0:
            return True
    return False

def expr_has_effects(a: Ast, e: int) -> bool:
    tag: int = a.n[e]
    if tag == {{T:Expr.int_lit}} or tag == {{T:Expr.float_lit}} or tag == {{T:Expr.bool_lit}} or tag == {{T:Expr.string_lit}} or tag == {{T:Expr.none_lit}} or tag == {{T:Expr.identifier}} or tag == {{T:Expr.lambda}}:
        return False
    if tag == {{T:Expr.unary}}:
        return expr_has_effects(a, a.n[a.n[e + 1] + {{O:Unary.operand}}])
    if tag == {{T:Expr.binary}}:
        b: int = a.n[e + 1]
        return expr_has_effects(a, a.n[b + {{O:Binary.left}}]) or expr_has_effects(a, a.n[b + {{O:Binary.right}}])
    if tag == {{T:Expr.attribute}}:
        return expr_has_effects(a, a.n[a.n[e + 1] + {{O:Attribute.obj}}])
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        return expr_has_effects(a, a.n[ix + {{O:Index.obj}}]) or expr_has_effects(a, a.n[ix + {{O:Index.index}}])
    if tag == {{T:Expr.ternary}}:
        t: int = a.n[e + 1]
        return expr_has_effects(a, a.n[t + {{O:Ternary.cond}}]) or expr_has_effects(a, a.n[t + {{O:Ternary.then_expr}}]) or expr_has_effects(a, a.n[t + {{O:Ternary.else_expr}}])
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        st: int = a.n[e + 1]
        for i in range(a.n[e + 2]):
            if expr_has_effects(a, a.l[st + i]):
                return True
        return False
    if tag == {{T:Expr.dict_lit}}:
        st2: int = a.n[e + 1]
        for j in range(a.n[e + 2]):
            dp: int = a.l[st2 + j]
            if expr_has_effects(a, a.n[dp + {{O:DictPair.key}}]) or expr_has_effects(a, a.n[dp + {{O:DictPair.value}}]):
                return True
        return False
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[e + 1]
        if expr_has_effects(a, a.n[sl + {{O:Slice.obj}}]):
            return True
        if a.n[sl + {{O:Slice.lo}}] >= 0 and expr_has_effects(a, a.n[sl + {{O:Slice.lo}}]):
            return True
        if a.n[sl + {{O:Slice.hi}}] >= 0 and expr_has_effects(a, a.n[sl + {{O:Slice.hi}}]):
            return True
        if a.n[sl + {{O:Slice.step}}] >= 0 and expr_has_effects(a, a.n[sl + {{O:Slice.step}}]):
            return True
        return False
    return True

def expand_call_args(ck: Ck, a: Ast, decl: int, args: int, nm_sym: int) -> int:
    n: int = pky(decl)
    na: int = pky(args)
    slots: list[int] = []
    for si in range(n):
        slots.append(-1)
    variadic_idx: int = -1
    kw_idx: int = -1
    pos_cap: int = n
    for j in range(n):
        p: int = stmt_at(a, decl, j)
        if a.n[p + {{O:Param.variadic}}] != 0:
            variadic_idx = j
            if j < pos_cap:
                pos_cap = j
        if a.n[p + {{O:Param.var_kw}}] != 0:
            kw_idx = j
            if j < pos_cap:
                pos_cap = j
        if a.n[p + {{O:Param.kw_only}}] != 0 and j < pos_cap:
            pos_cap = j
    extras: list[int] = []
    kw_pairs: list[int] = []
    star_value: int = -1
    dstars: list[int] = []
    for i in range(na):
        ae: int = stmt_at(a, args, i)
        if a.n[ae] == {{T:Expr.kwarg}}:
            kw: int = a.n[ae + 1]
            kn: int = pk(a.n[kw + {{O:Kwarg.name}}], a.n[kw + {{O:Kwarg.name}} + 1])
            kv: int = a.n[kw + {{O:Kwarg.value}}]
            if sref_eq(a, kn, "**"):
                if kw_idx < 0:
                    mp(ck, "'")
                    mp_sym(ck, nm_sym)
                    mp(ck, "': '**' unpacking in a call needs a '**kwargs' parameter")
                    raise mk_fail(ck, "ArgumentCountMismatch")
                dstars.append(kv)
                continue
            if sref_eq(a, kn, "*"):
                if variadic_idx < 0 or i != variadic_idx or star_value >= 0:
                    mp(ck, "'")
                    mp_sym(ck, nm_sym)
                    mp(ck, "': '*' unpacking in a call needs a '*args' parameter exactly at that position")
                    raise mk_fail(ck, "ArgumentCountMismatch")
                star_value = mk_dunder_call(a, kv, "copy", [])
                continue
            found: int = -1
            for j2 in range(n):
                p2: int = stmt_at(a, decl, j2)
                if a.n[p2 + {{O:Param.var_kw}}] != 0 or a.n[p2 + {{O:Param.pos_only}}] != 0:
                    continue
                if sref_eq_ref(a, pk(a.n[p2 + {{O:Param.name}}], a.n[p2 + {{O:Param.name}} + 1]), kn):
                    found = j2
                    break
            if found < 0 and kw_idx < 0:
                for j3 in range(n):
                    p3: int = stmt_at(a, decl, j3)
                    if a.n[p3 + {{O:Param.pos_only}}] != 0 and sref_eq_ref(a, pk(a.n[p3 + {{O:Param.name}}], a.n[p3 + {{O:Param.name}} + 1]), kn):
                        mp(ck, "'")
                        mp_sym(ck, nm_sym)
                        mp(ck, "': parameter '")
                        mp_sref(ck, a, kn)
                        mp(ck, "' is positional-only and cannot be given by keyword")
                        raise mk_fail(ck, "ArgumentCountMismatch")
            if found < 0 and kw_idx >= 0:
                kw_pairs.append(mk_DictPair(a, mk_Expr_string_lit(a, pkx(kn), pky(kn)), kv))
                continue
            if found < 0:
                mp(ck, "function '")
                mp_sym(ck, nm_sym)
                mp(ck, "' has no parameter named '")
                mp_sref(ck, a, kn)
                mp(ck, "'")
                raise mk_fail(ck, "ArgumentCountMismatch")
            if variadic_idx >= 0 and found == variadic_idx:
                mp(ck, "'")
                mp_sym(ck, nm_sym)
                mp(ck, "': the '*")
                mp_sref(ck, a, kn)
                mp(ck, "' parameter takes positional arguments only")
                raise mk_fail(ck, "ArgumentCountMismatch")
            if slots[found] >= 0:
                mp(ck, "in the call to '")
                mp_sym(ck, nm_sym)
                mp(ck, "', parameter '")
                mp_sref(ck, a, kn)
                mp(ck, "' was given more than once")
                raise mk_fail(ck, "ArgumentCountMismatch")
            slots[found] = kv
        elif i >= pos_cap:
            if variadic_idx < 0:
                mp(ck, "'")
                mp_sym(ck, nm_sym)
                mp(ck, "' takes at most ")
                mp_int(ck, pos_cap)
                mp(ck, " positional arguments, ")
                mp_int(ck, na)
                mp(ck, " were given")
                raise mk_fail(ck, "ArgumentCountMismatch")
            if star_value >= 0:
                mp(ck, "'")
                mp_sym(ck, nm_sym)
                mp(ck, "': positional arguments after a '*' unpacking are not supported")
                raise mk_fail(ck, "ArgumentCountMismatch")
            extras.append(ae)
        else:
            if i >= n:
                mp(ck, "'")
                mp_sym(ck, nm_sym)
                mp(ck, "' takes at most ")
                mp_int(ck, n)
                mp(ck, " arguments, ")
                mp_int(ck, na)
                mp(ck, " were given")
                raise mk_fail(ck, "ArgumentCountMismatch")
            slots[i] = ae
    if variadic_idx >= 0:
        if star_value >= 0:
            slots[variadic_idx] = star_value
        else:
            esl: int = list_put_slice(a, extras)
            slots[variadic_idx] = mk_Expr_list_lit(a, pkx(esl), pky(esl))
    if kw_idx >= 0:
        if len(dstars) == 0:
            ksl: int = list_put_slice(a, kw_pairs)
            slots[kw_idx] = mk_Expr_dict_lit(a, pkx(ksl), pky(ksl))
        else:
            reserved: list[int] = []
            for j4 in range(n):
                p4: int = stmt_at(a, decl, j4)
                if a.n[p4 + {{O:Param.variadic}}] != 0 or a.n[p4 + {{O:Param.var_kw}}] != 0:
                    continue
                if a.n[p4 + {{O:Param.pos_only}}] == 0:
                    reserved.append(mk_Expr_string_lit(a, a.n[p4 + {{O:Param.name}}], a.n[p4 + {{O:Param.name}} + 1]))
            rsl: int = list_put_slice(a, reserved)
            acc: int = -1
            if len(kw_pairs) > 0:
                ksl2: int = list_put_slice(a, kw_pairs)
                acc = mk_Expr_dict_lit(a, pkx(ksl2), pky(ksl2))
            for di in range(len(dstars)):
                res_lit: int = mk_Expr_list_lit(a, pkx(rsl), pky(rsl))
                unp: int = mk_ident_call(a, "__nox_kw_unpack", [dstars[di], res_lit])
                if acc >= 0:
                    acc = mk_ident_call(a, "__nox_kw_merge", [acc, unp])
                else:
                    acc = unp
            slots[kw_idx] = acc
    ambiguous: bool = False
    last_eff: int = -1
    for i2 in range(na):
        ae2: int = stmt_at(a, args, i2)
        slot_idx: int = i2
        if variadic_idx >= 0 and variadic_idx < slot_idx:
            slot_idx = variadic_idx
        val: int = ae2
        if a.n[ae2] == {{T:Expr.kwarg}}:
            kw2: int = a.n[ae2 + 1]
            kn2: int = pk(a.n[kw2 + {{O:Kwarg.name}}], a.n[kw2 + {{O:Kwarg.name}} + 1])
            if sref_eq(a, kn2, "*") or sref_eq(a, kn2, "**"):
                continue
            for j5 in range(n):
                p5: int = stmt_at(a, decl, j5)
                if sref_eq_ref(a, pk(a.n[p5 + {{O:Param.name}}], a.n[p5 + {{O:Param.name}} + 1]), kn2):
                    slot_idx = j5
            val = a.n[kw2 + {{O:Kwarg.value}}]
        if not expr_has_effects(a, val):
            continue
        if last_eff >= 0 and slot_idx < last_eff:
            ambiguous = True
        last_eff = slot_idx
    if ambiguous and (variadic_idx >= 0 or kw_idx >= 0):
        mp(ck, "'")
        mp_sym(ck, nm_sym)
        mp(ck, "': keyword arguments with side effects cannot be reordered in a call that also uses '*args'; write them in parameter order")
        raise mk_fail(ck, "ArgumentCountMismatch")
    if ambiguous and ck.in_spawn_op:
        mp(ck, "'")
        mp_sym(ck, nm_sym)
        mp(ck, "': keyword arguments with side effects in a 'spawn' call must be written in parameter order")
        raise mk_fail(ck, "ArgumentCountMismatch")
    out: list[int] = []
    for j6 in range(n):
        if slots[j6] >= 0:
            out.append(slots[j6])
        else:
            p6: int = stmt_at(a, decl, j6)
            d6: int = a.n[p6 + {{O:Param.default}}]
            if d6 < 0:
                mp(ck, "in the call to '")
                mp_sym(ck, nm_sym)
                mp(ck, "', argument '")
                mp_sref(ck, a, pk(a.n[p6 + {{O:Param.name}}], a.n[p6 + {{O:Param.name}} + 1]))
                mp(ck, "' is missing")
                raise mk_fail(ck, "ArgumentCountMismatch")
            out.append(d6)
    return list_put_slice(a, out)

# argüman denetimi (checkArgs/checkArgsDecl çekirdeği): imza kimliği `sid`, ileti adı `nm` (SymbolId)
def check_args_sig(ck: Ck, a: Ast, fx: Fx, c: int, sid: int, nm: int) -> None:
    check_args_slice(ck, a, fx, sl_at(a, c, {{O:Call.args}}), sid, nm, True)

def check_args_slice(ck: Ck, a: Ast, fx: Fx, args: int, sid: int, nm: int, use_span: bool) -> None:
    n: int = pky(args)
    has_kw: bool = False
    for i in range(n):
        if a.n[stmt_at(a, args, i)] == {{T:Expr.kwarg}}:
            has_kw = True
    decl: int = ck.fdecl[sid]
    np: int = ck.fpn[sid]
    st: int = ck.fps[sid]
    check_args_e: int = args
    span_ok: bool = use_span
    if has_kw or (decl >= 0 and (n < np or any_variadic(a, decl))):
        if decl < 0:
            mp(ck, "'")
            mp_sym(ck, nm)
            mp(ck, "' does not support keyword arguments/default values")
            raise mk_fail(ck, "TypeMismatch")
        check_args_e = expand_call_args(ck, a, decl, args, nm)
        n = pky(check_args_e)
        span_ok = False
    if np != n:
        mp(ck, "'")
        mp_sym(ck, nm)
        mp(ck, "' expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, n)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    for i2 in range(np):
        ae: int = stmt_at(a, check_args_e, i2)
        pt: int = ck.fpar[st + i2]
        at_: int = check_expr_expected(ck, a, fx, ae, pt)
        if not assignable_or_coerce(ck, a, pt, at_):
            if span_ok:
                sp: int = span_of(a, ae)
                if sp >= 0:
                    ck.cur_span = sp
            mp(ck, "type mismatch for argument '")
            mp_sym(ck, nm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")

# func-tipli alan çağrısı: `checkArgs(ft.func.params, ...)`
def check_args_func_type(ck: Ck, a: Ast, fx: Fx, c: int, ft: int, nm: int) -> None:
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    tt: TT = ck.tt
    np: int = tt.xc[ft]
    if np != n:
        mp(ck, "'")
        mp_sym(ck, nm)
        mp(ck, "' expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, n)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    for i in range(np):
        ae: int = stmt_at(a, args, i)
        pt: int = tt.fp[tt.xa[ft] + i]
        at_: int = check_expr_expected(ck, a, fx, ae, pt)
        if not assignable_or_coerce(ck, a, pt, at_):
            sp: int = span_of(a, ae)
            if sp >= 0:
                ck.cur_span = sp
            mp(ck, "type mismatch for argument '")
            mp_sym(ck, nm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")

# ---- yerleşik list/dict metotları (`checkCall`in `.attribute` dalı; str/Task/Channel/... 3.10'un devamı) ----
def fail2(ck: Ck, code: str, msg: str) -> None:
    mp(ck, msg)
    raise mk_fail(ck, code)

def fail_attr(ck: Ck, a: Ast, attr: int, code: str, pre: str, post: str) -> None:
    mp(ck, pre)
    mp_sref(ck, a, attr)
    mp(ck, post)
    raise mk_fail(ck, code)

def is_plain_field_chain(a: Ast, e: int) -> bool:
    if a.n[e] == {{T:Expr.identifier}}:
        return True
    if a.n[e] == {{T:Expr.attribute}}:
        return is_plain_field_chain(a, a.n[a.n[e + 1] + {{O:Attribute.obj}}])
    return False

# `checkGrowableListRecv`: append/insert alıcısı çıplak ad ya da `ad.alan[.alan...]` (kök sınıf örneği)
def check_growable_recv(ck: Ck, a: Ast, fx: Fx, obj: int, what: str, example: str) -> None:
    ok: bool = False
    if a.n[obj] == {{T:Expr.identifier}}:
        ok = True
    elif a.n[obj] == {{T:Expr.attribute}}:
        base: int = a.n[a.n[obj + 1] + {{O:Attribute.obj}}]
        if is_plain_field_chain(a, base):
            bt: int = check_expr(ck, a, fx, base)
            ok = ck.tt.tag[bt] == 6
    if not ok:
        fail2(ck, "TypeMismatch", "'" + what + "' can only be called on a variable or on 'name.field[.field...]' (e.g. '" + example + "', 'self.items.append(v)')")

# `requireListElemComparable`
def require_list_elem_comparable(ck: Ck, a: Ast, et: int, xt: int, attr: int) -> None:
    g: int = ck.tt.tag[et]
    if not (g == 0 or g == 1 or g == 2 or g == 3 or g == 16 or g == 6 or g == 5):
        fail_attr(ck, a, attr, "TypeMismatch", "the list element type is not supported for '", "' (it must be int/float/bool/str/class/list)")
    x: int = require_same_fixed(ck, xt, et)
    if not ((is_numeric_t(ck, xt) and is_numeric_t(ck, et)) or xt == et):
        fail_attr(ck, a, attr, "TypeMismatch", "the argument of '", "' does not match the list element type")

def check_list_method(ck: Ck, a: Ast, fx: Fx, c: int, obj: int, attr: int, obj_t: int) -> int:
    tt: TT = ck.tt
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    el: int = tt.xa[obj_t]
    if sref_eq(a, attr, "append"):
        check_growable_recv(ck, a, fx, obj, "append", "xs.append(v)")
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'append' takes exactly 1 argument")
        vt: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 0), el)
        if not assignable_or_coerce(ck, a, el, vt):
            fail2(ck, "TypeMismatch", "the argument of 'append' does not match the list's element type")
        return 4
    if sref_eq(a, attr, "sort"):
        if n != 0:
            has_key: bool = False
            for si in range(n):
                sa: int = stmt_at(a, args, si)
                okkw: bool = False
                if a.n[sa] == {{T:Expr.kwarg}}:
                    skn: int = pk(a.n[a.n[sa + 1] + {{O:Kwarg.name}}], a.n[a.n[sa + 1] + {{O:Kwarg.name}} + 1])
                    okkw = sref_eq(a, skn, "key") or sref_eq(a, skn, "reverse")
                    if sref_eq(a, skn, "key"):
                        has_key = True
                if not okkw:
                    fail2(ck, "ArgumentCountMismatch", "'sort' only takes the 'key=' and 'reverse=' keyword arguments")
            snm: str = "__nox_sort_key_inplace" if has_key else "__nox_sort_reverse_inplace"
            sargs: list[int] = [obj]
            for sj in range(n):
                sargs.append(stmt_at(a, args, sj))
            return check_expr(ck, a, fx, mk_ident_call(a, snm, sargs))
        if el != 0 and el != 1 and el != 3:
            fail2(ck, "TypeMismatch", "'sort' can only be called on list[int]/list[float]/list[str]")
        return 4
    if sref_eq(a, attr, "pop"):
        if n > 1:
            fail2(ck, "ArgumentCountMismatch", "'pop' takes 0 or 1 (index) arguments")
        if n == 1:
            it: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
            if it != 0:
                fail2(ck, "TypeMismatch", "the index of 'pop' must be an 'int'")
        return el
    if sref_eq(a, attr, "reverse") or sref_eq(a, attr, "clear"):
        if n != 0:
            fail_attr(ck, a, attr, "ArgumentCountMismatch", "'", "' takes no arguments")
        return 4
    if sref_eq(a, attr, "copy"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'copy' takes no arguments")
        return obj_t
    if sref_eq(a, attr, "insert"):
        check_growable_recv(ck, a, fx, obj, "insert", "xs.insert(i, v)")
        if n != 2:
            fail2(ck, "ArgumentCountMismatch", "'insert' takes exactly 2 arguments (index, value)")
        ix: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ix != 0:
            fail2(ck, "TypeMismatch", "the index of 'insert' must be an 'int'")
        iv: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 1), el)
        if not assignable_or_coerce(ck, a, el, iv):
            fail2(ck, "TypeMismatch", "the value of 'insert' does not match the list's element type")
        return 4
    if sref_eq(a, attr, "extend"):
        fail2(ck, "TypeMismatch", "'extend' can only be used as an expression statement (xs.extend(ys)); it produces no value")
    if sref_eq(a, attr, "remove") or sref_eq(a, attr, "index") or sref_eq(a, attr, "count"):
        if n != 1:
            fail_attr(ck, a, attr, "ArgumentCountMismatch", "'", "' takes exactly 1 argument")
        xt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        require_list_elem_comparable(ck, a, el, xt, attr)
        if sref_eq(a, attr, "remove"):
            return 4
        return 0
    fail_attr(ck, a, attr, "UndefinedMethod", "list has no method '", "' (append/extend/insert/pop/remove/clear/index/count/sort/reverse/copy)")
    return 4

def check_dict_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    tt: TT = ck.tt
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    k0: int = tt.xa[obj_t]
    v0: int = tt.xb[obj_t]
    if sref_eq(a, attr, "items"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'items' takes no arguments")
        return check_expr(ck, a, fx, mk_ident_call(a, "__nox_dict_items", [a.n[a.n[a.n[c + {{O:Call.callee}}] + 1] + {{O:Attribute.obj}}]]))
    if sref_eq(a, attr, "contains"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'contains' takes exactly 1 argument")
        kt: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if kt != k0:
            fail2(ck, "TypeMismatch", "the argument of 'contains' does not match the dict's key type")
        return 2
    if sref_eq(a, attr, "len"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'len' takes no arguments")
        return 0
    if sref_eq(a, attr, "keys"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'keys' takes no arguments")
        return ty_list(tt, k0)
    if sref_eq(a, attr, "values"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'values' takes no arguments")
        return ty_list(tt, v0)
    if sref_eq(a, attr, "get") or sref_eq(a, attr, "pop"):
        if n < 1 or n > 2:
            fail_attr(ck, a, attr, "ArgumentCountMismatch", "'", "' takes 1 or 2 arguments (key[, default])")
        gk: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if gk != k0:
            fail_attr(ck, a, attr, "TypeMismatch", "the key of '", "' does not match the dict's key type")
        if n == 2:
            gd: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 1), v0)
            if not ty_assignable(tt, v0, gd):
                fail_attr(ck, a, attr, "TypeMismatch", "the default value of '", "' does not match the dict's value type")
            return v0
        if sref_eq(a, attr, "pop"):
            return v0
        return ty_optional(tt, v0)
    if sref_eq(a, attr, "setdefault"):
        if n != 2:
            fail2(ck, "ArgumentCountMismatch", "'setdefault' takes exactly 2 arguments (key, default)")
        sk: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if sk != k0:
            fail2(ck, "TypeMismatch", "the key of 'setdefault' does not match the dict's key type")
        sd: int = check_expr_expected(ck, a, fx, stmt_at(a, args, 1), v0)
        if not ty_assignable(tt, v0, sd):
            fail2(ck, "TypeMismatch", "the default value of 'setdefault' does not match the dict's value type")
        return v0
    if sref_eq(a, attr, "clear"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'clear' takes no arguments")
        return 4
    if sref_eq(a, attr, "copy"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'copy' takes no arguments")
        return obj_t
    if sref_eq(a, attr, "update"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'update' takes exactly 1 argument")
        ut: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ut != obj_t:
            fail2(ck, "TypeMismatch", "the argument of 'update' must be of the same dict[K, V] type")
        return 4
    fail_attr(ck, a, attr, "UndefinedMethod", "dict has no method '", "' (contains/len/keys/values/get/pop/setdefault/clear/copy/update)")
    return 4

# ---- Task/Channel/TaskLocal/ThreadHandle/ThreadChannel/str yerleşik metotları (Zig `checkCallInner` `.attribute` dalı; 3.10 dilim C) ----
def arg_n(a: Ast, c: int) -> int:
    return pky(sl_at(a, c, {{O:Call.args}}))

def arg_e(ck: Ck, a: Ast, fx: Fx, c: int, i: int) -> int:
    return check_expr(ck, a, fx, stmt_at(a, sl_at(a, c, {{O:Call.args}}), i))

def check_task_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int) -> int:
    n: int = arg_n(a, c)
    if sref_eq(a, attr, "cancel"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'cancel' takes no arguments")
        return 4
    if sref_eq(a, attr, "is_done"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'is_done' takes no arguments")
        return 2
    if sref_eq(a, attr, "wait"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'wait' takes exactly 1 argument (timeout in milliseconds)")
        if arg_e(ck, a, fx, c, 0) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait' must be an int (milliseconds)")
        return 2
    if sref_eq(a, attr, "wait_any"):
        if n != 2:
            fail2(ck, "ArgumentCountMismatch", "'wait_any' takes 2 arguments (another Task, timeout in milliseconds)")
        if ck.tt.tag[arg_e(ck, a, fx, c, 0)] != 7:
            fail2(ck, "TypeMismatch", "the first argument of 'wait_any' must be a Task")
        if arg_e(ck, a, fx, c, 1) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait_any' must be an int (milliseconds)")
        return 0
    fail_attr(ck, a, attr, "UndefinedMethod", "Task has no method '", "' (only cancel, is_done, wait and wait_any)")
    return 4

def check_channel_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    elem: int = ck.tt.xa[obj_t]
    if sref_eq(a, attr, "send"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'send' takes exactly 1 argument")
        if not ty_assignable(ck.tt, elem, arg_e(ck, a, fx, c, 0)):
            fail2(ck, "TypeMismatch", "the argument of 'send' does not match the channel's element type")
        return 4
    if sref_eq(a, attr, "recv"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'recv' takes no arguments")
        return elem
    if sref_eq(a, attr, "wait"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'wait' takes exactly 1 argument (timeout in milliseconds)")
        if arg_e(ck, a, fx, c, 0) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait' must be an int (milliseconds)")
        return 2
    if sref_eq(a, attr, "wait_any"):
        if n < 2 or n > 4:
            fail2(ck, "ArgumentCountMismatch", "'wait_any' takes 1 to 3 other channels and a timeout in milliseconds")
        for i in range(n - 1):
            if ck.tt.tag[arg_e(ck, a, fx, c, i)] != 8:
                fail2(ck, "TypeMismatch", "the channel arguments of 'wait_any' must be Channels")
        if arg_e(ck, a, fx, c, n - 1) != 0:
            fail2(ck, "TypeMismatch", "the timeout of 'wait_any' must be an int (milliseconds)")
        return 0
    fail_attr(ck, a, attr, "UndefinedMethod", "Channel has no method '", "' (only send/recv/wait/wait_any)")
    return 4

def check_task_local_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    elem: int = ck.tt.xa[obj_t]
    if sref_eq(a, attr, "get"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'get' takes no arguments")
        return ty_optional(ck.tt, elem)
    if sref_eq(a, attr, "set"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'set' takes exactly 1 argument")
        if not ty_assignable(ck.tt, elem, arg_e(ck, a, fx, c, 0)):
            fail2(ck, "TypeMismatch", "the argument of 'set' does not match the TaskLocal's element type")
        return 4
    if sref_eq(a, attr, "clear"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'clear' takes no arguments")
        return 4
    fail_attr(ck, a, attr, "UndefinedMethod", "TaskLocal has no method '", "' (only get/set/clear)")
    return 4

def check_thread_handle_method(ck: Ck, a: Ast, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    if sref_eq(a, attr, "join"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'join' takes no arguments")
        return ck.tt.xa[obj_t]
    if sref_eq(a, attr, "cancel"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'cancel' takes no arguments")
        return 4
    fail_attr(ck, a, attr, "UndefinedMethod", "ThreadHandle has no method '", "' (only join and cancel)")
    return 4

def check_thread_channel_method(ck: Ck, a: Ast, fx: Fx, c: int, attr: int, obj_t: int) -> int:
    n: int = arg_n(a, c)
    elem: int = ck.tt.xa[obj_t]
    if sref_eq(a, attr, "send"):
        if n != 1:
            fail2(ck, "ArgumentCountMismatch", "'send' takes exactly 1 argument")
        if not ty_assignable(ck.tt, elem, arg_e(ck, a, fx, c, 0)):
            fail2(ck, "TypeMismatch", "the argument of 'send' does not match the channel's element type")
        return 4
    if sref_eq(a, attr, "recv"):
        if n != 0:
            fail2(ck, "ArgumentCountMismatch", "'recv' takes no arguments")
        return elem
    fail_attr(ck, a, attr, "UndefinedMethod", "ThreadChannel has no method '", "' (only send/recv)")
    return 4

def sref_eq_ascii_ci(a: Ast, v: int, s: str) -> bool:
    if sref_len(v) != len(s):
        return False
    for i in range(len(s)):
        cb: int = sref_byte(a, v, i)
        sb: int = ord(s[i])
        if cb >= 65 and cb <= 90:
            cb = cb + 32
        if sb >= 65 and sb <= 90:
            sb = sb + 32
        if cb != sb:
            return False
    return True

def is_core_str_method(a: Ast, m: int) -> bool:
    for nm in ["upper", "lower", "casefold", "strip", "lstrip", "rstrip", "split", "join", "replace", "startswith", "endswith", "find", "index", "count", "isdigit", "isalpha", "isalnum", "isspace", "isupper", "islower", "isdecimal", "isnumeric", "ljust", "rjust", "center", "zfill"]:
        if sref_eq(a, m, nm):
            return True
    return False

def check_bytes_method(ck: Ck, a: Ast, fx: Fx, c: int, obj: int, attr: int) -> int:
    is_dec: bool = sref_eq(a, attr, "decode")
    is_hex: bool = sref_eq(a, attr, "hex")
    is_tol: bool = sref_eq(a, attr, "to_list")
    if not is_dec and not is_hex and not is_tol:
        fail_attr(ck, a, attr, "UndefinedMethod", "bytes has no method '", "' (decode/hex/to_list)")
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    if is_dec and n == 1:
        a0: int = stmt_at(a, args, 0)
        ok_enc: bool = False
        if a.n[a0] == {{T:Expr.string_lit}}:
            enc: int = pk(a.n[a0 + 1], a.n[a0 + 2])
            ok_enc = sref_eq_ascii_ci(a, enc, "utf-8") or sref_eq_ascii_ci(a, enc, "utf8")
        if not ok_enc:
            fail2(ck, "TypeMismatch", "bytes.decode only supports the UTF-8 encoding")
    elif n != 0:
        mp(ck, "bytes.")
        mp_sref(ck, a, attr)
        mp(ck, " takes no arguments")
        raise mk_fail(ck, "ArgumentCountMismatch")
    fn: str = "__nox_bytes_decode" if is_dec else ("__nox_bytes_hex" if is_hex else "__nox_bytes_to_list")
    return check_expr(ck, a, fx, mk_ident_call(a, fn, [obj]))

# `str` metodları (Zig `checkStrMethod`): çekirdek imza tablosu; `__nox_str_<m>` prelude işlevine yönlendirme.
def check_str_method(ck: Ck, a: Ast, fx: Fx, c: int, obj: int, attr: int) -> int:
    tt: TT = ck.tt
    n: int = arg_n(a, c)
    pxs: list[int] = []
    pfx: str = "__nox_str_"
    for i in range(len(pfx)):
        pxs.append(ord(pfx[i]))
    for j in range(sref_len(attr)):
        pxs.append(sref_byte(a, attr, j))
    pre_sym: int = sym_intern_list(tt, pxs, 0, len(pxs))
    takes_extra: bool = (sref_eq(a, attr, "strip") or sref_eq(a, attr, "lstrip") or sref_eq(a, attr, "rstrip")) and n > 0
    core_has: bool = (not sref_eq(a, attr, "split")) and (not sref_eq(a, attr, "join"))
    if (m2_get(ck.fmap, 0, pre_sym) >= 0 or m2_get(ck.gfn, 0, pre_sym) >= 0) and core_has and (takes_extra or not is_core_str_method(a, attr)):
        cargs: int = sl_at(a, c, {{O:Call.args}})
        new_args: list[int] = [obj]
        for ai in range(n):
            new_args.append(stmt_at(a, cargs, ai))
        pre_sr: int = ast_str_sym(ck, a, pre_sym)
        ce: int = mk_Expr_identifier(a, pkx(pre_sr), pky(pre_sr))
        nsl: int = list_put_slice(a, new_args)
        return check_expr(ck, a, fx, mk_Expr_call(a, mk_Call(a, ce, pkx(nsl), pky(nsl), 0, 0, 0, 0, 0, 0)))
    np: int = -1
    p0: int = 3
    p1: int = 3
    ret: int = 3
    opt: bool = False
    if sref_eq(a, attr, "upper") or sref_eq(a, attr, "lower") or sref_eq(a, attr, "casefold") or sref_eq(a, attr, "strip") or sref_eq(a, attr, "lstrip") or sref_eq(a, attr, "rstrip"):
        np = 0
    elif sref_eq(a, attr, "isdigit") or sref_eq(a, attr, "isalpha") or sref_eq(a, attr, "isalnum") or sref_eq(a, attr, "isspace") or sref_eq(a, attr, "isupper") or sref_eq(a, attr, "islower") or sref_eq(a, attr, "isdecimal") or sref_eq(a, attr, "isnumeric"):
        np = 0
        ret = 2
    elif sref_eq(a, attr, "startswith") or sref_eq(a, attr, "endswith"):
        np = 1
        ret = 2
    elif sref_eq(a, attr, "find") or sref_eq(a, attr, "count") or sref_eq(a, attr, "index"):
        np = 1
        ret = 0
    elif sref_eq(a, attr, "replace"):
        np = 2
    elif sref_eq(a, attr, "zfill"):
        np = 1
        p0 = 0
    elif sref_eq(a, attr, "ljust") or sref_eq(a, attr, "rjust") or sref_eq(a, attr, "center"):
        np = 2
        p0 = 0
        opt = True
    elif sref_eq(a, attr, "split"):
        np = 1
        ret = ty_list(tt, 3)
        opt = True
    elif sref_eq(a, attr, "join"):
        np = 1
        p0 = ty_list(tt, 3)
    if np < 0:
        fail_attr(ck, a, attr, "UndefinedMethod", "str has no method '", "' (upper/lower/strip/lstrip/rstrip/split/join/replace/startswith/endswith/find/index/count/isdigit/isalpha/isalnum/isspace/isupper/islower/ljust/rjust/center/zfill)")
    minn: int = np
    if opt:
        minn = np - 1
    if n < minn or n > np:
        mp(ck, "str.")
        mp_sref(ck, a, attr)
        mp(ck, " expects ")
        mp_int(ck, np)
        mp(ck, " arguments, ")
        mp_int(ck, n)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    args: int = sl_at(a, c, {{O:Call.args}})
    for k in range(n):
        pt: int = p0
        if k == 1:
            pt = p1
        at: int = check_expr_expected(ck, a, fx, stmt_at(a, args, k), pt)
        if not ty_assignable(tt, pt, at):
            mp(ck, "str.")
            mp_sref(ck, a, attr)
            mp(ck, " argument ")
            mp_int(ck, k + 1)
            mp(ck, " has a mismatched type")
            raise mk_fail(ck, "TypeMismatch")
    return ret

# `super().metod(...)` / `super().__init__(...)` (Zig `checkCall` `.attribute` kolu, `isSuperCallExpr`)
def check_super_call(ck: Ck, a: Ast, fx: Fx, c: int, attr: int) -> int:
    if fx.self_cls < 0:
        fail2(ck, "TypeMismatch", "'super()' can only be used inside a method body")
    bsym: int = ck.cls_base[fx.self_cls]
    if bsym < 0:
        mp(ck, "class '")
        mp_sym(ck, ck.cls_sym[fx.self_cls])
        mp(ck, "' has no base class, so 'super()' cannot be used")
        raise mk_fail(ck, "TypeMismatch")
    bi: int = class_idx(ck, bsym)
    asym: int = sym_of(ck, a, attr)
    if sref_eq(a, attr, "__init__"):
        isid: int = ck.cls_init[bi]
        if isid < 0:
            isid = ck.sig_empty
        check_args_sig(ck, a, fx, c, isid, asym)
        return 4
    me: int = m2_get(ck.cls_meths, bi, asym)
    if me >= 0:
        sid: int = ck.cls_meths.vv[me]
        check_args_sig(ck, a, fx, c, sid, asym)
        return ck.fret[sid]
    mp(ck, "base class '")
    mp_sym(ck, bsym)
    mp(ck, "' has no method '")
    mp_sref(ck, a, attr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedMethod")

# `obj.metod(...)` (sınıf örneği + list/dict/str/Task/Channel/TaskLocal/ThreadHandle/ThreadChannel yerleşikleri)
def check_method_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    at: int = a.n[callee + 1]
    obj: int = a.n[at + {{O:Attribute.obj}}]
    attr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    qc: int = qualified_call(ck, a, fx, c, callee)
    if qc >= 0:
        return qc
    if a.n[obj] == {{T:Expr.call}}:
        oc: int = a.n[obj + 1]
        ocal: int = a.n[oc + {{O:Call.callee}}]
        if a.n[ocal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[ocal + 1], a.n[ocal + 2]), "super") and pky(sl_at(a, oc, {{O:Call.args}})) == 0:
            return check_super_call(ck, a, fx, c, attr)
    obj_t: int = check_expr(ck, a, fx, obj)
    require_not_optional_sref(ck, obj_t, a, attr)
    tt: TT = ck.tt
    g: int = tt.tag[obj_t]
    if g == 5:
        return check_list_method(ck, a, fx, c, obj, attr, obj_t)
    if g == 13:
        return check_dict_method(ck, a, fx, c, attr, obj_t)
    if g == 7:
        return check_task_method(ck, a, fx, c, attr)
    if (g == 8 or g == 10) and (sref_eq(a, attr, "send") or sref_eq(a, attr, "recv")) and callee != fx.awaited:
        mp(ck, "'")
        mp_sref(ck, a, attr)
        mp(ck, "' suspends the task: write 'await ch.")
        mp_sref(ck, a, attr)
        mp(ck, "(...)'")
        raise mk_fail(ck, "TypeMismatch")
    if g == 8:
        return check_channel_method(ck, a, fx, c, attr, obj_t)
    if g == 11:
        return check_task_local_method(ck, a, fx, c, attr, obj_t)
    if g == 9:
        return check_thread_handle_method(ck, a, c, attr, obj_t)
    if g == 10:
        return check_thread_channel_method(ck, a, fx, c, attr, obj_t)
    if g == 3:
        return check_str_method(ck, a, fx, c, obj, attr)
    if g == 18:
        return check_bytes_method(ck, a, fx, c, obj, attr)
    if g != 6:
        mp(ck, "a method call is only valid on class instances")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, obj_t)
    if ci < 0:
        mp(ck, "unknown class: ")
        mp_sym(ck, tt.xa[obj_t])
        raise mk_fail(ck, "UndefinedClass")
    asym: int = sym_of(ck, a, attr)
    me: int = m2_get(ck.cls_meths, ci, asym)
    if me >= 0:
        sid: int = ck.cls_meths.vv[me]
        check_args_sig(ck, a, fx, c, sid, asym)
        return ck.fret[sid]
    fe: int = m2_get(ck.cls_fields, ci, asym)
    if fe >= 0:
        ft: int = ck.cls_fields.vv[fe]
        if tt.tag[ft] == 14:
            check_args_func_type(ck, a, fx, c, ft, asym)
            return tt.xb[ft]
        mp(ck, "'")
        mp_sref(ck, a, attr)
        mp(ck, "' is not a function and cannot be called")
        raise mk_fail(ck, "TypeMismatch")
    mp(ck, "class '")
    mp_sym(ck, ck.cls_sym[ci])
    mp(ck, "' has no method '")
    mp_sref(ck, a, attr)
    mp(ck, "'")
    raise mk_fail(ck, "UndefinedMethod")

# `checkAssign` — alan hedefi (`self.x = v` / `self.x: T = v` / `obj.x = v`)
def check_assign_attr(ck: Ck, a: Ast, fx: Fx, asg: int, tg: int) -> None:
    at: int = a.n[tg + 1]
    obj: int = a.n[at + {{O:Attribute.obj}}]
    attr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
    asym: int = sym_of(ck, a, attr)
    tt: TT = ck.tt
    # `Sınıf.ad = v`: sınıf adı gölgelenmemişse sınıf özniteliği ataması
    oci: int = receiver_class_name(ck, a, fx, obj)
    if oci >= 0:
        osym: int = ck.cls_sym[oci]
        ce: int = m2_get(ck.cls_consts_ty, oci, asym)
        pe: int = m2_get(ck.cls_consts_prom, oci, asym)
        if ce >= 0 and pe >= 0 and ck.cls_consts_prom.vv[pe] != 0:
            kown: int = ck.cls_consts_owner.vv[m2_get(ck.cls_consts_owner, oci, asym)]
            if kown != osym:
                mp(ck, "'")
                mp_sym(ck, osym)
                mp(ck, ".")
                mp_sref(ck, a, attr)
                mp(ck, "' is declared in class '")
                mp_sym(ck, kown)
                mp(ck, "': assign it as '")
                mp_sym(ck, kown)
                mp(ck, ".")
                mp_sref(ck, a, attr)
                mp(ck, "' (a subclass has no copy of a class attribute)")
                raise mk_fail(ck, "TypeMismatch")
            kty: int = ck.cls_consts_ty.vv[ce]
            kvt: int = check_expr_expected(ck, a, fx, a.n[asg + {{O:Assign.value}}], kty)
            if not assignable_or_coerce(ck, a, kty, kvt):
                mp(ck, "type mismatch for '")
                mp_sym(ck, osym)
                mp(ck, ".")
                mp_sref(ck, a, attr)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            return
        mp(ck, "'")
        mp_sym(ck, osym)
        mp(ck, ".")
        mp_sref(ck, a, attr)
        mp(ck, "' cannot be assigned: it is not a class attribute (class attributes are declared in the class body as 'NAME: T = literal')")
        raise mk_fail(ck, "TypeMismatch")
    obj_t: int = check_expr(ck, a, fx, obj)
    require_not_optional_sref(ck, obj_t, a, attr)
    if tt.tag[obj_t] != 6:
        mp(ck, "'.")
        mp_sref(ck, a, attr)
        mp(ck, "' can only be used on class instances")
        raise mk_fail(ck, "TypeMismatch")
    ci: int = class_idx_of_type(ck, obj_t)
    is_self: bool = a.n[obj] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[obj + 1], a.n[obj + 2]), "self")
    fe: int = m2_get(ck.cls_fields, ci, asym)
    existing: int = -1
    if fe >= 0:
        existing = ck.cls_fields.vv[fe]
    ann: int = a.n[asg + {{O:Assign.ann}}]
    if existing < 0 and ann < 0 and ck.props.live > 0:
        hs: int = find_property(ck, ci, asym)
        if hs >= 0:
            if hs == 0:
                mp(ck, "property '")
                mp_sym(ck, ck.cls_sym[ci])
                mp(ck, ".")
                mp_sref(ck, a, attr)
                mp(ck, "' is read-only (it has no '@")
                mp_sref(ck, a, attr)
                mp(ck, ".setter')")
                raise mk_fail(ck, "TypeMismatch")
            check_expr(ck, a, fx, mk_dunder_call(a, obj, "__setprop_" + sref_str(a, attr), [a.n[asg + {{O:Assign.value}}]]))
            return
    if ann >= 0:
        declared: int = type_expr_to_type(ck, a, ann)
        if existing >= 0:
            if existing != declared:
                mp(ck, "the annotation of '")
                mp_sym(ck, ck.cls_sym[ci])
                mp(ck, ".")
                mp_sref(ck, a, attr)
                mp(ck, "' does not match the declared field type")
                raise mk_fail(ck, "TypeMismatch")
        elif not (is_self and fx.is_init):
            mp(ck, "in class '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, "', field '")
            mp_sref(ck, a, attr)
            mp(ck, "' can only be defined in __init__ with 'self.")
            mp_sref(ck, a, attr)
            mp(ck, ": T = ...'")
            raise mk_fail(ck, "UndefinedAttribute")
        vt: int = check_expr_expected(ck, a, fx, a.n[asg + {{O:Assign.value}}], declared)
        if not assignable_or_coerce(ck, a, declared, vt):
            mp(ck, "type mismatch for '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        if existing < 0:
            m2_put(ck.cls_fields, ci, asym, declared)
        else:
            m2_remove(ck.cls_unas, ci, asym)
        return
    value_t: int = check_expr_expected(ck, a, fx, a.n[asg + {{O:Assign.value}}], existing)
    if existing >= 0:
        if not assignable_or_coerce(ck, a, existing, value_t):
            mp(ck, "type mismatch for '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        m2_remove(ck.cls_unas, ci, asym)
    else:
        ce_i: int = m2_get(ck.cls_consts_ty, ci, asym)
        if ce_i >= 0:
            kown_i: int = ck.cls_consts_owner.vv[m2_get(ck.cls_consts_owner, ci, asym)]
            mp(ck, "'")
            if is_self:
                mp(ck, "self")
            else:
                mp_sym(ck, ck.cls_sym[ci])
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, "' is a class attribute and cannot be assigned through an instance: assign it as '")
            mp_sym(ck, kown_i)
            mp(ck, ".")
            mp_sref(ck, a, attr)
            mp(ck, " = ...' (instances have no copy of a class attribute)")
            raise mk_fail(ck, "TypeMismatch")
        if not (is_self and fx.is_init):
            mp(ck, "in class '")
            mp_sym(ck, ck.cls_sym[ci])
            mp(ck, "', field '")
            mp_sref(ck, a, attr)
            mp(ck, "' can only be defined in __init__ with 'self.")
            mp_sref(ck, a, attr)
            mp(ck, " = ...'")
            raise mk_fail(ck, "UndefinedAttribute")
        m2_put(ck.cls_fields, ci, asym, value_t)
    invalidate_narrows_by_field(ck, fx, sref_str(a, attr))

# `checkAssign` — indeks hedefi (`xs[i] = v` / `d[k] = v`)
def check_assign_index(ck: Ck, a: Ast, fx: Fx, asg: int, tg: int) -> None:
    ip: int = a.n[tg + 1]
    obj_t: int = check_expr(ck, a, fx, a.n[ip + {{O:Index.obj}}])
    require_not_optional(ck, obj_t, "[]")
    tt: TT = ck.tt
    if has_dunder(ck, obj_t, "__setitem__"):
        check_expr(ck, a, fx, mk_dunder_call(a, a.n[ip + {{O:Index.obj}}], "__setitem__", [a.n[ip + {{O:Index.index}}], a.n[asg + {{O:Assign.value}}]]))
        return
    if tt.tag[obj_t] == 5:
        kt: int = check_expr(ck, a, fx, a.n[ip + {{O:Index.index}}])
        if kt != 0:
            mp(ck, "the list index must be an 'int'")
            raise mk_fail(ck, "TypeMismatch")
        el: int = tt.xa[obj_t]
        vt: int = check_expr_expected(ck, a, fx, a.n[asg + {{O:Assign.value}}], el)
        if not assignable_or_coerce(ck, a, el, vt):
            mp(ck, "type mismatch in indexed assignment: it does not match the list's element type")
            raise mk_fail(ck, "TypeMismatch")
        return
    if tt.tag[obj_t] != 13:
        mp(ck, "indexed assignment only works on 'list'/'dict'")
        raise mk_fail(ck, "TypeMismatch")
    kt2: int = check_expr(ck, a, fx, a.n[ip + {{O:Index.index}}])
    if kt2 != tt.xa[obj_t]:
        mp(ck, "the dict index does not match the key type")
        raise mk_fail(ck, "TypeMismatch")
    dv: int = tt.xb[obj_t]
    vt2: int = check_expr_expected(ck, a, fx, a.n[asg + {{O:Assign.value}}], dv)
    if not assignable_or_coerce(ck, a, dv, vt2):
        mp(ck, "the dict value does not match the value type")
        raise mk_fail(ck, "TypeMismatch")

# `checkAssign`in identifier hedefi; `_ = ifade` at-gitsin atamasını da içerir.
def check_assign(ck: Ck, a: Ast, fx: Fx, asg: int) -> None:
    tg: int = a.n[asg + {{O:Assign.target}}]
    if a.n[tg] == {{T:Expr.attribute}}:
        check_assign_attr(ck, a, fx, asg, tg)
        return
    if a.n[tg] == {{T:Expr.index}}:
        check_assign_index(ck, a, fx, asg, tg)
        return
    if a.n[tg] != {{T:Expr.identifier}}:
        fail2(ck, "TypeMismatch", "invalid assignment target")
    nv: int = pk(a.n[tg + 1], a.n[tg + 2])
    sym: int = sym_of(ck, a, nv)
    if sref_eq(a, nv, "_") and a.n[asg + {{O:Assign.ann}}] < 0 and sc_lookup(ck, fx.scope, sym) < 0 and m2_get(ck.globs, 0, sym) < 0:
        check_expr(ck, a, fx, a.n[asg + {{O:Assign.value}}])
        return
    existing: int = sc_lookup_local(ck, fx.scope, sym)
    if existing < 0:
        if ck.sp[fx.scope] >= 0 and sc_exists(ck, ck.sp[fx.scope], sym):
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "' is a variable captured from OUTSIDE the nested function and can only be READ (assignment is not supported)")
            raise mk_fail(ck, "TypeMismatch")
        # modül global'i denenir
        gi: int = m2_get(ck.globs, 0, sym)
        if gi < 0:
            mp(ck, "undefined variable: ")
            mp_sym(ck, sym)
            mp(ck, " (give the type on first assignment: `")
            mp_sym(ck, sym)
            mp(ck, ": <type> = ...`)")
            raise mk_fail(ck, "UndefinedVariable")
        existing = ck.globs.vv[gi]
    value_t: int = check_expr_expected(ck, a, fx, a.n[asg + {{O:Assign.value}}], existing)
    if not assignable_or_coerce(ck, a, existing, value_t):
        ile: int = m2_get(fx.infer_lines, 0, sym)
        if ile >= 0:
            mp(ck, "type mismatch for '")
            mp_sym(ck, sym)
            mp(ck, "': ':=' inferred type '")
            mp_type(ck, existing)
            mp(ck, "' on line ")
            mp_int(ck, fx.infer_lines.vv[ile])
            mp(ck, ", but the value is '")
            mp_type(ck, value_t)
            mp(ck, "' (write the type on the first declaration if you need a different one)")
            raise mk_fail(ck, "TypeMismatch")
        mp(ck, "type mismatch for '")
        mp_sym(ck, sym)
        mp(ck, "'")
        raise mk_fail(ck, "TypeMismatch")

    invalidate_narrow_prefix(ck, fx, sym_to_str(ck, sym))

# `alwaysReturns`
def always_returns(a: Ast, s: int) -> bool:
    n: int = pky(s)
    if n == 0:
        return False
    st: int = stmt_at(a, s, n - 1)
    kn: int = a.n[a.n[st + {{O:Stmt.kind}}]]
    pay: int = a.n[a.n[st + {{O:Stmt.kind}}] + 1]
    if kn == {{T:StmtKind.return_stmt}} or kn == {{T:StmtKind.raise_stmt}}:
        return True
    if kn == {{T:StmtKind.if_stmt}}:
        if a.n[pay + {{O:IfStmt.else_body}}] == {{NONE}}:
            return False
        if not always_returns(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
            return False
        ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        for j in range(pky(ecs)):
            if not always_returns(a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}})):
                return False
        return always_returns(a, sl_at(a, pay, {{O:IfStmt.else_body}}))
    if kn == {{T:StmtKind.try_stmt}}:
        if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
            if always_returns(a, sl_at(a, pay, {{O:TryStmt.finally_body}})):
                return True
        if not always_returns(a, sl_at(a, pay, {{O:TryStmt.try_body}})):
            return False
        exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
        for k in range(pky(exs)):
            if not always_returns(a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}})):
                return False
        return pky(exs) > 0 or a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}
    if kn == {{T:StmtKind.with_stmt}}:
        return always_returns(a, sl_at(a, pay, {{O:WithStmt.body}}))
    if kn == {{T:StmtKind.lowlevel_stmt}}:
        return always_returns(a, sl_at(a, pay, {{O:LowLevelStmt.body}}))
    return False

def sref_eq_ref(a: Ast, u: int, v: int) -> bool:
    if sref_len(u) != sref_len(v):
        return False
    for i in range(sref_len(u)):
        if sref_byte(a, u, i) != sref_byte(a, v, i):
            return False
    return True

# ---- `extern def` (Zig `registerExternFunc`; dekoratörlü biçimler kapsam dışı) ----
# `isFfiSafeType`
def ffi_safe_type(ck: Ck, t: int) -> bool:
    tt: TT = ck.tt
    g: int = tt.tag[t]
    if t <= 5 or g == 16 or g == 17 or g == 18:
        return True
    if g == 13:
        return tt.xa[t] == 3 and tt.xb[t] == 3
    if g == 14:
        base: int = tt.xa[t]
        for i in range(tt.xc[t]):
            pg: int = tt.fp[base + i]
            if not (pg == 0 or pg == 1 or pg == 2 or pg == 5 or tt.tag[pg] == 16):
                return False
        rg: int = tt.xb[t]
        return rg == 0 or rg == 1 or rg == 2 or rg == 5 or rg == 4 or tt.tag[rg] == 16
    return False

def is_ffi_safe_cb_type(ck: Ck, ft: int) -> bool:
    tt: TT = ck.tt
    if tt.tag[ft] != 14:
        return False
    base: int = tt.xa[ft]
    for i in range(tt.xc[ft]):
        p: int = tt.fp[base + i]
        pg: int = tt.tag[p]
        if p != 0 and p != 1 and p != 2 and p != 5 and pg != 16:
            return False
    r: int = tt.xb[ft]
    rg: int = tt.tag[r]
    return r == 0 or r == 1 or r == 2 or r == 5 or r == 4 or rg == 16

def scalar_type_eql(ck: Ck, ta: int, tb: int) -> bool:
    if ta == tb:
        return True
    tt: TT = ck.tt
    ga: int = tt.tag[ta]
    gb: int = tt.tag[tb]
    if ga != gb:
        return False
    if ga == 16 or ga == 17:
        return tt.xa[ta] == tt.xa[tb]
    return False

def check_extern_errors_call(ck: Ck, a: Ast, sym: int) -> None:
    if m2_get(ck.ext_err_checked, 0, sym) >= 0:
        return
    m2_put(ck.ext_err_checked, 0, sym, 1)
    ee: int = m2_get(ck.ext_err_errno, 0, sym)
    if ee >= 0 and ck.ext_err_errno.vv[ee] != 0:
        if m2_get(ck.imod, 0, sym_lit(ck, "nox.ffi")) < 0:
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "': '@ffi.errors(errno=True)' needs 'import nox.ffi'")
            raise mk_fail(ck, "UnknownType")
    rsym: int = ck.ext_err_raises.vv[m2_get(ck.ext_err_raises, 0, sym)]
    rci: int = class_idx(ck, rsym)
    if rci < 0:
        rfe: int = m2_get(ck.fimp, 0, rsym)
        if rfe >= 0:
            rci = class_idx(ck, ck.fimp.vv[rfe])
    if rci < 0:
        mp(ck, "undefined function or class: ")
        mp_sym(ck, rsym)
        raise mk_fail(ck, "UndefinedFunction")
    isid: int = ck.cls_init[rci]
    if isid < 0:
        isid = ck.sig_empty
    if ck.fpn[isid] != 1 or not ty_assignable(ck.tt, ck.fpar[ck.fps[isid]], 3):
        mp(ck, "'")
        mp_sym(ck, sym)
        mp(ck, "': '@ffi.errors' raises class '")
        mp_sym(ck, rsym)
        mp(ck, "' must accept a single 'str' message")
        raise mk_fail(ck, "TypeMismatch")
    me: int = m2_get(ck.ext_err_msg, 0, sym)
    if me >= 0 and ck.ext_err_msg.vv[me] >= 0:
        msym: int = ck.ext_err_msg.vv[me]
        mfi: int = m2_get(ck.fmap, 0, msym)
        if mfi < 0:
            mfe: int = m2_get(ck.fimp, 0, msym)
            if mfe >= 0:
                mfi = m2_get(ck.fmap, 0, ck.fimp.vv[mfe])
        if mfi < 0:
            mp(ck, "undefined function or class: ")
            mp_sym(ck, msym)
            raise mk_fail(ck, "UndefinedFunction")
        msid: int = ck.fmap.vv[mfi]
        if ck.fpn[msid] != 1 or not ty_assignable(ck.tt, ck.fpar[ck.fps[msid]], 0) or ck.fret[msid] != 3:
            mp(ck, "'")
            mp_sym(ck, sym)
            mp(ck, "': '@ffi.errors(message=...)' function '")
            mp_sym(ck, msym)
            mp(ck, "' must have signature (int) -> str")
            raise mk_fail(ck, "TypeMismatch")

def check_callback_target_arg(ck: Ck, a: Ast, fx: Fx, ae: int, cb_ty: int, ud_pos: int, ext_sym: int) -> None:
    if a.n[ae] == {{T:Expr.none_lit}}:
        return
    tt: TT = ck.tt
    is_handle_cand: bool = a.n[ae] == {{T:Expr.attribute}}
    if not is_handle_cand and a.n[ae] == {{T:Expr.identifier}}:
        asym_h: int = sym_of(ck, a, pk(a.n[ae + 1], a.n[ae + 2]))
        if sc_lookup(ck, fx.scope, asym_h) >= 0:
            is_handle_cand = True
    if is_handle_cand:
        ht: int = check_expr(ck, a, fx, ae)
        if tt.tag[ht] == 6:
            cbe: int = m2_get(ck.ffi_cb_cls, 0, tt.xa[ht])
            if cbe >= 0:
                f_ty: int = ck.ffi_cb_cls.vv[cbe]
                cb_n: int = tt.xc[cb_ty]
                exp_n: int = cb_n - 1
                f_n: int = tt.xc[f_ty]
                if f_n != exp_n:
                    mp(ck, "'")
                    mp_sym(ck, ext_sym)
                    mp(ck, "': the Callback handle takes ")
                    mp_int(ck, f_n)
                    mp(ck, " parameters, the callback signature has ")
                    mp_int(ck, exp_n)
                    raise mk_fail(ck, "TypeMismatch")
                f_base: int = tt.xa[f_ty]
                cb_base: int = tt.xa[cb_ty]
                ei: int = 0
                for pi in range(cb_n):
                    if pi == ud_pos:
                        continue
                    if not scalar_type_eql(ck, tt.fp[f_base + ei], tt.fp[cb_base + pi]):
                        mp(ck, "'")
                        mp_sym(ck, ext_sym)
                        mp(ck, "': the Callback handle: the type of parameter ")
                        mp_int(ck, ei + 1)
                        mp(ck, " does not match the callback signature")
                        raise mk_fail(ck, "TypeMismatch")
                    ei = ei + 1
                if not scalar_type_eql(ck, tt.xb[f_ty], tt.xb[cb_ty]):
                    mp(ck, "'")
                    mp_sym(ck, ext_sym)
                    mp(ck, "': the Callback handle: the return type does not match the callback signature")
                    raise mk_fail(ck, "TypeMismatch")
                return
    if a.n[ae] != {{T:Expr.identifier}}:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the '@ffi.callback' target can only be the BARE name of a top-level function (lambdas/bound methods/capturing closures are NOT ACCEPTED)")
        raise mk_fail(ck, "TypeMismatch")
    tsym: int = sym_of(ck, a, pk(a.n[ae + 1], a.n[ae + 2]))
    if sc_lookup(ck, fx.scope, tsym) >= 0:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the '@ffi.callback' target '")
        mp_sym(ck, tsym)
        mp(ck, "' shadows a local variable, it MUST be a top-level function")
        raise mk_fail(ck, "TypeMismatch")
    if m2_get(ck.ext_fns, 0, tsym) >= 0:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the '@ffi.callback' target '")
        mp_sym(ck, tsym)
        mp(ck, "' is an 'extern def' — only ordinary top-level functions (with a Nox body) can be callback targets")
        raise mk_fail(ck, "TypeMismatch")
    if m2_get(ck.afn, 0, tsym) >= 0:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the '@ffi.callback' target '")
        mp_sym(ck, tsym)
        mp(ck, "' is an 'async def' — callback targets must be synchronous")
        raise mk_fail(ck, "TypeMismatch")
    tfi: int = m2_get(ck.fmap, 0, tsym)
    if tfi < 0:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the '@ffi.callback' target is an undefined function: ")
        mp_sym(ck, tsym)
        raise mk_fail(ck, "UndefinedFunction")
    tsid: int = ck.fmap.vv[tfi]
    cb_n2: int = tt.xc[cb_ty]
    exp_n2: int = cb_n2 - 1
    if ck.fpn[tsid] != exp_n2:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the parameter COUNT of the '@ffi.callback' target '")
        mp_sym(ck, tsym)
        mp(ck, "' does not match the callback signature (")
        mp_int(ck, exp_n2)
        mp(ck, " expected, ")
        mp_int(ck, ck.fpn[tsid])
        mp(ck, " found)")
        raise mk_fail(ck, "TypeMismatch")
    t_base: int = ck.fps[tsid]
    cb_base2: int = tt.xa[cb_ty]
    ei2: int = 0
    for pi2 in range(cb_n2):
        if pi2 == ud_pos:
            continue
        if not scalar_type_eql(ck, ck.fpar[t_base + ei2], tt.fp[cb_base2 + pi2]):
            mp(ck, "'")
            mp_sym(ck, ext_sym)
            mp(ck, "': the '@ffi.callback' target '")
            mp_sym(ck, tsym)
            mp(ck, "': the type of parameter ")
            mp_int(ck, ei2 + 1)
            mp(ck, " does not match the callback signature")
            raise mk_fail(ck, "TypeMismatch")
        ei2 = ei2 + 1
    if not scalar_type_eql(ck, ck.fret[tsid], tt.xb[cb_ty]):
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "': the return type of the '@ffi.callback' target '")
        mp_sym(ck, tsym)
        mp(ck, "' does not match the callback signature")
        raise mk_fail(ck, "TypeMismatch")

def check_extern_callback_args(ck: Ck, a: Ast, fx: Fx, sid: int, c: int, ext_sym: int) -> None:
    cargs: int = sl_at(a, c, {{O:Call.args}})
    nargs: int = pky(cargs)
    nparams: int = ck.fpn[sid]
    exp_arity: int = nparams - 1
    cb_idx: int = ck.ext_cb_idx.vv[m2_get(ck.ext_cb_idx, 0, ext_sym)]
    ctx_idx: int = ck.ext_cb_ctx.vv[m2_get(ck.ext_cb_ctx, 0, ext_sym)]
    cb_ty: int = ck.ext_cb_ty.vv[m2_get(ck.ext_cb_ty, 0, ext_sym)]
    ud_pos: int = ck.ext_cb_ud.vv[m2_get(ck.ext_cb_ud, 0, ext_sym)]
    if nargs != exp_arity:
        mp(ck, "'")
        mp_sym(ck, ext_sym)
        mp(ck, "' expects ")
        mp_int(ck, exp_arity)
        mp(ck, " arguments (parameter ")
        mp_int(ck, ctx_idx + 1)
        mp(ck, " is the '@ffi.callback' context_param and is NOT written at the call site — the compiler fills it in automatically), ")
        mp_int(ck, nargs)
        mp(ck, " were given")
        raise mk_fail(ck, "ArgumentCountMismatch")
    ai: int = 0
    for pi in range(nparams):
        if pi == ctx_idx:
            continue
        ae: int = stmt_at(a, cargs, ai)
        ai = ai + 1
        if pi == cb_idx:
            check_callback_target_arg(ck, a, fx, ae, cb_ty, ud_pos, ext_sym)
            continue
        pt: int = ck.fpar[ck.fps[sid] + pi]
        at: int = check_expr_expected(ck, a, fx, ae, pt)
        if not assignable_or_coerce(ck, a, pt, at):
            mp(ck, "type mismatch for argument '")
            mp_sym(ck, ext_sym)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")

def register_extern_errors(ck: Ck, a: Ast, sym: int, nm: int, dec: int, ed: int, ret: int) -> None:
    dargs: int = sl_at(a, dec, {{O:Decorator.args}})
    raises_sym: int = -1
    kind: int = -1
    val: int = 0
    errno_on: int = 0
    msg_sym: int = -1
    for i in range(pky(dargs)):
        da: int = stmt_at(a, dargs, i)
        if a.n[da] != {{T:Expr.kwarg}}:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': '@ffi.errors' takes keyword arguments only (raises=, ok=, ok_min=, null_is_error=, errno=, message=)")
            raise mk_fail(ck, "TypeMismatch")
        kw: int = a.n[da + 1]
        knm: int = pk(a.n[kw + {{O:Kwarg.name}}], a.n[kw + {{O:Kwarg.name}} + 1])
        kv: int = a.n[kw + {{O:Kwarg.value}}]
        kvt: int = a.n[kv]
        if sref_eq(a, knm, "raises"):
            if kvt != {{T:Expr.identifier}}:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.errors(raises=...)' must name an exception class")
                raise mk_fail(ck, "TypeMismatch")
            raises_sym = sym_of(ck, a, pk(a.n[kv + 1], a.n[kv + 2]))
        elif sref_eq(a, knm, "ok") or sref_eq(a, knm, "ok_min"):
            n: int = 0
            ok_int: bool = False
            if kvt == {{T:Expr.int_lit}}:
                n = a.n[kv + 1]
                ok_int = True
            elif kvt == {{T:Expr.unary}}:
                up: int = a.n[kv + 1]
                if a.n[up + {{O:Unary.op}}] == {{E:UnaryOp.neg}} and a.n[a.n[up + {{O:Unary.operand}}]] == {{T:Expr.int_lit}}:
                    n = 0 - a.n[a.n[up + {{O:Unary.operand}}] + 1]
                    ok_int = True
            if not ok_int:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.errors(")
                mp_sref(ck, a, knm)
                mp(ck, "=...)' takes an integer literal")
                raise mk_fail(ck, "TypeMismatch")
            if kind >= 0:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.errors' takes exactly one of ok=, ok_min=, null_is_error=")
                raise mk_fail(ck, "TypeMismatch")
            kind = 0 if sref_eq(a, knm, "ok") else 1
            val = n
        elif sref_eq(a, knm, "null_is_error"):
            if kvt != {{T:Expr.bool_lit}}:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.errors(null_is_error=...)' takes True or False")
                raise mk_fail(ck, "TypeMismatch")
            if a.n[kv + 1] != 0:
                if kind >= 0:
                    mp(ck, "extern function '")
                    mp_sref(ck, a, nm)
                    mp(ck, "': '@ffi.errors' takes exactly one of ok=, ok_min=, null_is_error=")
                    raise mk_fail(ck, "TypeMismatch")
                kind = 2
        elif sref_eq(a, knm, "errno"):
            if kvt != {{T:Expr.bool_lit}}:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.errors(errno=...)' takes True or False")
                raise mk_fail(ck, "TypeMismatch")
            errno_on = 1 if a.n[kv + 1] != 0 else 0
        elif sref_eq(a, knm, "message"):
            if kvt != {{T:Expr.string_lit}}:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.errors(message=...)' takes a string literal naming a top-level function")
                raise mk_fail(ck, "TypeMismatch")
            msg_sym = sym_of(ck, a, pk(a.n[kv + 1], a.n[kv + 2]))
        else:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': unknown '@ffi.errors' argument '")
            mp_sref(ck, a, knm)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
    if raises_sym < 0:
        mp(ck, "extern function '")
        mp_sref(ck, a, nm)
        mp(ck, "': '@ffi.errors' requires raises=<exception class>")
        raise mk_fail(ck, "TypeMismatch")
    if kind < 0:
        mp(ck, "extern function '")
        mp_sref(ck, a, nm)
        mp(ck, "': '@ffi.errors' requires one of ok=, ok_min=, null_is_error=True")
        raise mk_fail(ck, "TypeMismatch")
    eds: int = sl_at(a, ed, {{O:ExternDef.decorators}})
    for d2i in range(pky(eds)):
        d2: int = stmt_at(a, eds, d2i)
        if sref_eq(a, pk(a.n[d2 + {{O:Decorator.name}}], a.n[d2 + {{O:Decorator.name}} + 1]), "ffi.callback"):
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': '@ffi.errors' cannot be combined with '@ffi.callback'")
            raise mk_fail(ck, "TypeMismatch")
    rg: int = ck.tt.tag[ret]
    ret_ok: bool = (ret == 0 or rg == 16)
    if kind == 2:
        ret_ok = ret_ok or ret == 5 or rg == 17
    if not ret_ok:
        mp(ck, "extern function '")
        mp_sref(ck, a, nm)
        mp(ck, "': '@ffi.errors' needs an integer return type (ok=/ok_min=) or a ptr/integer return type (null_is_error=True)")
        raise mk_fail(ck, "TypeMismatch")
    m2_put(ck.ext_err_raises, 0, sym, raises_sym)
    m2_put(ck.ext_err_kind, 0, sym, kind)
    m2_put(ck.ext_err_thresh, 0, sym, val)
    m2_put(ck.ext_err_errno, 0, sym, errno_on)
    m2_put(ck.ext_err_msg, 0, sym, msg_sym)
    m2_put(ck.ext_err_node, 0, sym, ck.cur_line)

def register_extern_callback(ck: Ck, a: Ast, sym: int, nm: int, ed: int, tys: list[int]) -> None:
    ps: int = sl_at(a, ed, {{O:ExternDef.params}})
    eds: int = sl_at(a, ed, {{O:ExternDef.decorators}})
    for di in range(pky(eds)):
        dec: int = stmt_at(a, eds, di)
        dname: int = pk(a.n[dec + {{O:Decorator.name}}], a.n[dec + {{O:Decorator.name}} + 1])
        if not sref_eq(a, dname, "ffi.callback"):
            continue
        dargs: int = sl_at(a, dec, {{O:Decorator.args}})
        ud_kw: int = -1
        n_pos: int = 0
        for ai in range(pky(dargs)):
            da: int = stmt_at(a, dargs, ai)
            if a.n[da] == {{T:Expr.kwarg}}:
                kw: int = a.n[da + 1]
                if not sref_eq(a, pk(a.n[kw + {{O:Kwarg.name}}], a.n[kw + {{O:Kwarg.name}} + 1]), "ud_index") or a.n[a.n[kw + {{O:Kwarg.value}}]] != {{T:Expr.int_lit}}:
                    mp(ck, "extern function '")
                    mp_sref(ck, a, nm)
                    mp(ck, "': '@ffi.callback' accepts only the keyword argument ud_index=<integer literal>")
                    raise mk_fail(ck, "TypeMismatch")
                ud_kw = a.n[a.n[kw + {{O:Kwarg.value}}] + 1]
            else:
                n_pos = n_pos + 1
        if n_pos < 1 or n_pos > 2 or a.n[stmt_at(a, dargs, 0)] != {{T:Expr.string_lit}}:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': '@ffi.callback' expects at least \"param_name\" (the callback parameter) AND an optional \"context_param=...\" argument")
            raise mk_fail(ck, "TypeMismatch")
        cb_e: int = stmt_at(a, dargs, 0)
        cb_sr: int = pk(a.n[cb_e + 1], a.n[cb_e + 2])
        cb_idx: int = -1
        for pi in range(pky(ps)):
            p: int = stmt_at(a, ps, pi)
            if sref_eq_ref(a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]), cb_sr):
                cb_idx = pi
                break
        if cb_idx < 0:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': '@ffi.callback(\"")
            mp_sref(ck, a, cb_sr)
            mp(ck, "\")' names an unknown parameter")
            raise mk_fail(ck, "UnknownRetainedParam")
        cb_ty: int = tys[cb_idx]
        if ck.tt.tag[cb_ty] != 14:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': the '@ffi.callback' target '")
            mp_sref(ck, a, cb_sr)
            mp(ck, "' is not of a function TYPE")
            raise mk_fail(ck, "TypeMismatch")
        if not is_ffi_safe_cb_type(ck, cb_ty):
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': the SIGNATURE of the '@ffi.callback' target '")
            mp_sref(ck, a, cb_sr)
            mp(ck, "' is not FFI-safe (only int/float/bool/ptr parameters AND an int/float/bool/ptr/None return)")
            raise mk_fail(ck, "TypeMismatch")
        if n_pos != 2 or a.n[stmt_at(a, dargs, 1)] != {{T:Expr.string_lit}}:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': in v1 '@ffi.callback' is not supported WITHOUT a \"context_param\" argument (C APIs without a userdata slot are outside the v1 scope)")
            raise mk_fail(ck, "TypeMismatch")
        ctx_e: int = stmt_at(a, dargs, 1)
        ctx_sr: int = pk(a.n[ctx_e + 1], a.n[ctx_e + 2])
        ctx_idx: int = -1
        for pi2 in range(pky(ps)):
            p2: int = stmt_at(a, ps, pi2)
            if sref_eq_ref(a, pk(a.n[p2 + {{O:Param.name}}], a.n[p2 + {{O:Param.name}} + 1]), ctx_sr):
                ctx_idx = pi2
                break
        if ctx_idx < 0:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': the '@ffi.callback' context_param '")
            mp_sref(ck, a, ctx_sr)
            mp(ck, "' names an unknown parameter")
            raise mk_fail(ck, "UnknownRetainedParam")
        if ctx_idx == cb_idx:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': the '@ffi.callback' context_param cannot be the SAME as the callback parameter itself")
            raise mk_fail(ck, "TypeMismatch")
        if tys[ctx_idx] != 5:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': the '@ffi.callback' context_param '")
            mp_sref(ck, a, ctx_sr)
            mp(ck, "' is not of type 'ptr'")
            raise mk_fail(ck, "TypeMismatch")
        cb_np: int = ck.tt.xc[cb_ty]
        if cb_np == 0:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': the SIGNATURE of the '@ffi.callback' target '")
            mp_sref(ck, a, cb_sr)
            mp(ck, "' must have at least one parameter (the LAST parameter COUNTS as the 'userdata' slot)")
            raise mk_fail(ck, "TypeMismatch")
        ud_pos: int = cb_np - 1
        if ud_kw >= 0:
            if ud_kw < 0 or ud_kw >= cb_np:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.callback' ud_index=")
                mp_int(ck, ud_kw)
                mp(ck, " is outside the callback signature (")
                mp_int(ck, cb_np)
                mp(ck, " parameters)")
                raise mk_fail(ck, "TypeMismatch")
            ud_pos = ud_kw
        if ck.tt.fp[ck.tt.xa[cb_ty] + ud_pos] != 5:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': parameter ")
            mp_int(ck, ud_pos + 1)
            mp(ck, " of the SIGNATURE of the '@ffi.callback' target '")
            mp_sref(ck, a, cb_sr)
            mp(ck, "' (the userdata slot; the LAST one unless ud_index= is given) must be of type 'ptr'")
            raise mk_fail(ck, "TypeMismatch")
        m2_put(ck.ext_cb_idx, 0, sym, cb_idx)
        m2_put(ck.ext_cb_ctx, 0, sym, ctx_idx)
        m2_put(ck.ext_cb_ty, 0, sym, cb_ty)
        m2_put(ck.ext_cb_ud, 0, sym, ud_pos)

def register_extern(ck: Ck, a: Ast, ed: int) -> None:
    nm: int = pk(a.n[ed + {{O:ExternDef.name}}], a.n[ed + {{O:ExternDef.name}} + 1])
    ps: int = sl_at(a, ed, {{O:ExternDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if a.n[p + {{O:Param.default}}] >= 0:
            mp(ck, "'extern def ")
            mp_sref(ck, a, nm)
            mp(ck, "': parameter '")
            mp_sref(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]))
            mp(ck, "' cannot have a default value")
            raise mk_fail(ck, "TypeMismatch")
    sym: int = sym_of(ck, a, nm)
    if m2_get(ck.fmap, 0, sym) >= 0 or m2_get(ck.gfn, 0, sym) >= 0:
        mp(ck, "function already defined: ")
        mp_sref(ck, a, nm)
        raise mk_fail(ck, "DuplicateDefinition")
    needs_rt: bool = a.n[ed + {{O:ExternDef.needs_rt}}] != 0
    tys: list[int] = []
    pnames: list[int] = []
    for q in range(pky(ps)):
        pq: int = stmt_at(a, ps, q)
        pt: int = type_expr_to_type(ck, a, a.n[pq + {{O:Param.type_expr}}])
        pg: int = ck.tt.tag[pt]
        lst_ok: bool = pg == 5 and (ck.tt.xa[pt] == 3 or ck.tt.xa[pt] == 0)
        rt_fixed: bool = needs_rt and pg == 5 and ck.tt.tag[ck.tt.xa[pt]] == 16
        if not ffi_safe_type(ck, pt) and not lst_ok and not rt_fixed and not (needs_rt and pg == 6):
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': parameter '")
            mp_sref(ck, a, pk(a.n[pq + {{O:Param.name}}], a.n[pq + {{O:Param.name}} + 1]))
            mp(ck, "' has an unsupported type (only int/float/bool/str/None/list[str]/list[int] can cross the C ABI boundary in v0.1)")
            raise mk_fail(ck, "TypeMismatch")
        tys.append(pt)
        pnames.append(-1)
    ret: int = type_expr_to_type(ck, a, a.n[ed + {{O:ExternDef.return_type}}])
    rg2: int = ck.tt.tag[ret]
    rlst: bool = rg2 == 5 and (ck.tt.xa[ret] == 3 or ck.tt.xa[ret] == 0)
    if not ffi_safe_type(ck, ret) and not rlst and rg2 != 6:
        mp(ck, "extern function '")
        mp_sref(ck, a, nm)
        mp(ck, "': the return type is unsupported (only int/float/bool/str/None/list[str]/list[int]/class can cross the C ABI boundary in v0.1)")
        raise mk_fail(ck, "TypeMismatch")
    escape_syms: list[int] = []
    rts: int = sl_at(a, ed, {{O:ExternDef.retains}})
    for r in range(pky(rts)):
        rn: int = pk(a.l[pkx(rts) + r * 2], a.l[pkx(rts) + r * 2 + 1])
        escape_syms.append(sym_of(ck, a, rn))
    eds: int = sl_at(a, ed, {{O:ExternDef.decorators}})
    for di in range(pky(eds)):
        dec: int = stmt_at(a, eds, di)
        dname: int = pk(a.n[dec + {{O:Decorator.name}}], a.n[dec + {{O:Decorator.name}} + 1])
        if not sref_eq(a, dname, "ffi.escape") and not sref_eq(a, dname, "ffi.noescape") and not sref_eq(a, dname, "ffi.callback") and not sref_eq(a, dname, "ffi.errors") and not sref_eq(a, dname, "capability.requires"):
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': unknown decorator '@")
            mp_sref(ck, a, dname)
            mp(ck, "' (only @ffi.escape/@ffi.noescape/@ffi.callback/@ffi.errors/@capability.requires are valid)")
            raise mk_fail(ck, "UnknownExternDecorator")
        dargs: int = sl_at(a, dec, {{O:Decorator.args}})
        if sref_eq(a, dname, "capability.requires"):
            for ai in range(pky(dargs)):
                da: int = stmt_at(a, dargs, ai)
                if a.n[da] != {{T:Expr.string_lit}}:
                    mp(ck, "extern function '")
                    mp_sref(ck, a, nm)
                    mp(ck, "': argument ")
                    mp_int(ck, ai + 1)
                    mp(ck, " of '@capability.requires' must be a string LITERAL")
                    raise mk_fail(ck, "TypeMismatch")
            register_capability_decorator(ck, a, sym, dargs)
        elif sref_eq(a, dname, "ffi.errors"):
            register_extern_errors(ck, a, sym, nm, dec, ed, ret)
        elif sref_eq(a, dname, "ffi.escape"):
            for ai2 in range(pky(dargs)):
                da2: int = stmt_at(a, dargs, ai2)
                if a.n[da2] != {{T:Expr.string_lit}}:
                    mp(ck, "extern function '")
                    mp_sref(ck, a, nm)
                    mp(ck, "': argument ")
                    mp_int(ck, ai2 + 1)
                    mp(ck, " of '@ffi.escape' must be a string LITERAL (parameter name)")
                    raise mk_fail(ck, "TypeMismatch")
                escape_syms.append(sym_of(ck, a, pk(a.n[da2 + 1], a.n[da2 + 2])))
    for ei in range(len(escape_syms)):
        esym: int = escape_syms[ei]
        found_e: bool = False
        for f in range(pky(ps)):
            fp: int = stmt_at(a, ps, f)
            if sym_of(ck, a, pk(a.n[fp + {{O:Param.name}}], a.n[fp + {{O:Param.name}} + 1])) == esym:
                found_e = True
        if not found_e:
            mp(ck, "extern function '")
            mp_sref(ck, a, nm)
            mp(ck, "': 'retains/@ffi.escape(\"")
            mp_sym(ck, esym)
            mp(ck, "\")' names an unknown parameter")
            raise mk_fail(ck, "UnknownRetainedParam")
    for di2 in range(pky(eds)):
        dec2: int = stmt_at(a, eds, di2)
        dname2: int = pk(a.n[dec2 + {{O:Decorator.name}}], a.n[dec2 + {{O:Decorator.name}} + 1])
        if not sref_eq(a, dname2, "ffi.noescape"):
            continue
        dargs2: int = sl_at(a, dec2, {{O:Decorator.args}})
        for ai3 in range(pky(dargs2)):
            da3: int = stmt_at(a, dargs2, ai3)
            if a.n[da3] != {{T:Expr.string_lit}}:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': argument ")
                mp_int(ck, ai3 + 1)
                mp(ck, " of '@ffi.noescape' must be a string LITERAL")
                raise mk_fail(ck, "TypeMismatch")
            nsym: int = sym_of(ck, a, pk(a.n[da3 + 1], a.n[da3 + 2]))
            found_n: bool = False
            for f2 in range(pky(ps)):
                fp2: int = stmt_at(a, ps, f2)
                if sym_of(ck, a, pk(a.n[fp2 + {{O:Param.name}}], a.n[fp2 + {{O:Param.name}} + 1])) == nsym:
                    found_n = True
            if not found_n:
                mp(ck, "extern function '")
                mp_sref(ck, a, nm)
                mp(ck, "': '@ffi.noescape(\"")
                mp_sym(ck, nsym)
                mp(ck, "\")' names an unknown parameter")
                raise mk_fail(ck, "UnknownRetainedParam")
            for ei2 in range(len(escape_syms)):
                if escape_syms[ei2] == nsym:
                    mp(ck, "extern function '")
                    mp_sref(ck, a, nm)
                    mp(ck, "': parameter '")
                    mp_sym(ck, nsym)
                    mp(ck, "' is marked both as escaping (retains/@ffi.escape) AND as non-escaping (@ffi.noescape)")
                    raise mk_fail(ck, "ConflictingEscapeAnnotation")
    m2_put(ck.fmap, 0, sym, new_sig(ck, tys, pnames, ret))
    m2_put(ck.ext_fns, 0, sym, 1)
    register_extern_callback(ck, a, sym, nm, ed, tys)

# `registerFunc` (skaler dilim): varsayılan/variadik/dekoratörlü/jenerik/async işlevler kapsam dışı.
def stmts_have_yield(a: Ast, body: int) -> bool:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.return_stmt}}:
            e: int = pay
            if e >= 0 and a.n[e] == {{T:Expr.call}}:
                cal: int = a.n[a.n[e + 1] + {{O:Call.callee}}]
                if a.n[cal] == {{T:Expr.identifier}}:
                    cv: int = pk(a.n[cal + 1], a.n[cal + 2])
                    if sref_eq(a, cv, "__nox_yield") or sref_eq(a, cv, "__nox_yield_from") or sref_eq(a, cv, "__nox_yield_expr"):
                        return True
        elif tag == {{T:StmtKind.var_decl}}:
            ev: int = a.n[pay + {{O:VarDecl.value}}]
            if a.n[ev] == {{T:Expr.call}}:
                cal2: int = a.n[a.n[ev + 1] + {{O:Call.callee}}]
                if a.n[cal2] == {{T:Expr.identifier}}:
                    cv2: int = pk(a.n[cal2 + 1], a.n[cal2 + 2])
                    if sref_eq(a, cv2, "__nox_yield_expr"):
                        return True
        elif tag == {{T:StmtKind.assign}}:
            ea: int = a.n[pay + {{O:Assign.value}}]
            if a.n[ea] == {{T:Expr.call}}:
                cal3: int = a.n[a.n[ea + 1] + {{O:Call.callee}}]
                if a.n[cal3] == {{T:Expr.identifier}}:
                    cv3: int = pk(a.n[cal3 + 1], a.n[cal3 + 2])
                    if sref_eq(a, cv3, "__nox_yield_expr"):
                        return True
        elif tag == {{T:StmtKind.if_stmt}}:
            if stmts_have_yield(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                if stmts_have_yield(a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}})):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}} and stmts_have_yield(a, sl_at(a, pay, {{O:IfStmt.else_body}})):
                return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if stmts_have_yield(a, sl_at(a, pay, {{O:WhileStmt.body}})):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if stmts_have_yield(a, sl_at(a, pay, {{O:ForStmt.body}})):
                return True
        elif tag == {{T:StmtKind.try_stmt}}:
            if stmts_have_yield(a, sl_at(a, pay, {{O:TryStmt.try_body}})):
                return True
            exs_y: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k_y in range(pky(exs_y)):
                if stmts_have_yield(a, sl_at(a, a.l[pkx(exs_y) + k_y], {{O:ExceptClause.body}})):
                    return True
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}} and stmts_have_yield(a, sl_at(a, pay, {{O:TryStmt.finally_body}})):
                return True
        elif tag == {{T:StmtKind.with_stmt}}:
            if stmts_have_yield(a, sl_at(a, pay, {{O:WithStmt.body}})):
                return True
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if stmts_have_yield(a, sl_at(a, pay, {{O:LowLevelStmt.body}})):
                return True
    return False

def cap_from_name(a: Ast, v: int) -> int:
    if sref_eq(a, v, "filesystem"):
        return 0
    if sref_eq(a, v, "network"):
        return 1
    if sref_eq(a, v, "clock"):
        return 2
    if sref_eq(a, v, "entropy"):
        return 3
    if sref_eq(a, v, "threads"):
        return 4
    if sref_eq(a, v, "process"):
        return 5
    if sref_eq(a, v, "shared_memory"):
        return 6
    if sref_eq(a, v, "libc_math"):
        return 7
    if sref_eq(a, v, "arch_x86_64"):
        return 8
    if sref_eq(a, v, "dynamic_code"):
        return 9
    return -1

def parse_decorator_args(ck: Ck, a: Ast, dec: int, target_sym: int) -> None:
    dnm: int = pk(a.n[dec + {{O:Decorator.name}}], a.n[dec + {{O:Decorator.name}} + 1])
    dargs: int = sl_at(a, dec, {{O:Decorator.args}})
    for i in range(pky(dargs)):
        ae: int = stmt_at(a, dargs, i)
        atg: int = a.n[ae]
        if atg == {{T:Expr.string_lit}} or atg == {{T:Expr.int_lit}} or atg == {{T:Expr.bool_lit}}:
            pass
        elif atg == {{T:Expr.list_lit}}:
            items: int = sl_at(a, ae, 1)
            for k in range(pky(items)):
                if a.n[stmt_at(a, items, k)] != {{T:Expr.string_lit}}:
                    mp(ck, "decorator '@")
                    mp_sref(ck, a, dnm)
                    mp(ck, "' argument ")
                    mp_int(ck, i + 1)
                    mp(ck, ": a list can only contain string literals (target: ")
                    mp_sym(ck, target_sym)
                    mp(ck, ")")
                    raise mk_fail(ck, "TypeMismatch")
        else:
            mp(ck, "decorator '@")
            mp_sref(ck, a, dnm)
            mp(ck, "' argument ")
            mp_int(ck, i + 1)
            mp(ck, " can only be a string/int/bool literal or a list of strings (target: ")
            mp_sym(ck, target_sym)
            mp(ck, ")")
            raise mk_fail(ck, "TypeMismatch")

def register_capability_decorator(ck: Ck, a: Ast, fn_sym: int, dargs: int) -> None:
    if pky(dargs) == 0:
        mp(ck, "'@capability.requires' expects at least one capability name (function: ")
        mp_sym(ck, fn_sym)
        mp(ck, ")")
        raise mk_fail(ck, "TypeMismatch")
    mask: int = 0
    for i in range(pky(dargs)):
        ae: int = stmt_at(a, dargs, i)
        sv: int = pk(a.n[ae + 1], a.n[ae + 2])
        cid: int = cap_from_name(a, sv)
        if cid < 0:
            mp(ck, "'@capability.requires(\"")
            mp_sref(ck, a, sv)
            mp(ck, "\")': unknown capability name (function: ")
            mp_sym(ck, fn_sym)
            mp(ck, ")")
            raise mk_fail(ck, "TypeMismatch")
        mask = mask | (1 << cid)
    m2_put(ck.cap_fns, 0, fn_sym, mask)

def register_decorators(ck: Ck, a: Ast, fd: int, fn_sym: int) -> None:
    decs: int = sl_at(a, fd, {{O:FuncDef.decorators}})
    for i in range(pky(decs)):
        dec: int = a.l[pkx(decs) + i]
        parse_decorator_args(ck, a, dec, fn_sym)
        dnm: int = pk(a.n[dec + {{O:Decorator.name}}], a.n[dec + {{O:Decorator.name}} + 1])
        if sref_eq(a, dnm, "capability.requires"):
            dargs: int = sl_at(a, dec, {{O:Decorator.args}})
            for k in range(pky(dargs)):
                if a.n[stmt_at(a, dargs, k)] != {{T:Expr.string_lit}}:
                    mp(ck, "argument ")
                    mp_int(ck, k + 1)
                    mp(ck, " of '@capability.requires' must be a string LITERAL (function: ")
                    mp_sym(ck, fn_sym)
                    mp(ck, ")")
                    raise mk_fail(ck, "TypeMismatch")
            register_capability_decorator(ck, a, fn_sym, dargs)

def check_capability_call(ck: Ck, fn_sym: int) -> None:
    ce: int = m2_get(ck.cap_fns, 0, fn_sym)
    if ce < 0:
        return
    mask: int = ck.cap_fns.vv[ce]
    if (mask & (1 << 8)) != 0:
        mp(ck, "the call to '")
        mp_sym(ck, fn_sym)
        mp(ck, "' was rejected in the 'hosted' profile (required capability: 'arch_x86_64' — this profile does not provide it)")
        raise mk_fail(ck, "CapabilityNotGranted")

def register_func(ck: Ck, a: Ast, fd: int) -> None:
    nm: int = pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1])
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    validate_param_defaults(ck, a, nm, ps, 0, pky(sl_at(a, fd, {{O:FuncDef.type_params}})) > 0)
    if sref_eq(a, nm, "main"):
        mp(ck, "'main' is a reserved name: Nox has no 'def main()' convention, top-level statements are already the program's entry point — define this function under another name")
        raise mk_fail(ck, "DuplicateDefinition")
    sym: int = sym_of(ck, a, nm)
    if m2_get(ck.fmap, 0, sym) >= 0 or m2_get(ck.gfn, 0, sym) >= 0:
        mp(ck, "function already defined: ")
        mp_sym(ck, sym)
        raise mk_fail(ck, "DuplicateDefinition")
    eff_syms: list[int] = []
    eff_srefs: list[int] = []
    ftps: int = sl_at(a, fd, {{O:FuncDef.type_params}})
    for ti in range(pky(ftps)):
        tsr: int = pk(a.l[pkx(ftps) + ti * 2], a.l[pkx(ftps) + ti * 2 + 1])
        eff_syms.append(sym_of(ck, a, tsr))
        eff_srefs.append(tsr)
    for pi_p in range(pky(ps)):
        collect_protocol_names(ck, a, a.n[stmt_at(a, ps, pi_p) + {{O:Param.type_expr}}], eff_syms, eff_srefs)
    if len(eff_syms) > 0:
        reg_fd: int = fd
        if len(eff_syms) > pky(ftps):
            tps_st: int = len(a.l)
            for ti2 in range(len(eff_srefs)):
                a.l.append(pkx(eff_srefs[ti2]))
                a.l.append(pky(eff_srefs[ti2]))
            reg_fd = mk_FuncDef(a, a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1], tps_st, len(eff_srefs), a.n[fd + {{O:FuncDef.params}}], a.n[fd + {{O:FuncDef.params}} + 1], a.n[fd + {{O:FuncDef.return_type}}], a.n[fd + {{O:FuncDef.ret_omitted}}], a.n[fd + {{O:FuncDef.body}}], a.n[fd + {{O:FuncDef.body}} + 1], a.n[fd + {{O:FuncDef.is_async}}], a.n[fd + {{O:FuncDef.decorators}}], a.n[fd + {{O:FuncDef.decorators}} + 1], a.n[fd + {{O:FuncDef.link_name}}], a.n[fd + {{O:FuncDef.link_name}} + 1], a.n[fd + {{O:FuncDef.nonlocals}}], a.n[fd + {{O:FuncDef.nonlocals}} + 1], a.n[fd + {{O:FuncDef.globals}}], a.n[fd + {{O:FuncDef.globals}} + 1], a.n[fd + {{O:FuncDef.allow_await}}], a.n[fd + {{O:FuncDef.line}}])
        m2_put(ck.gfn, 0, sym, reg_fd)
        return
    tys: list[int] = []
    pnames: list[int] = []
    for k in range(pky(ps)):
        pk_node: int = stmt_at(a, ps, k)
        tys.append(type_expr_to_type(ck, a, a.n[pk_node + {{O:Param.type_expr}}]))
        pnames.append(sym_of(ck, a, pk(a.n[pk_node + {{O:Param.name}}], a.n[pk_node + {{O:Param.name}} + 1])))
    ret: int = type_expr_to_type(ck, a, a.n[fd + {{O:FuncDef.return_type}}])
    if a.n[fd + {{O:FuncDef.is_async}}] != 0:
        # `isSpawnParamSafeType` (hosted profil, varsayılan): thread_handle(9)/func(14)/optional(15) kapanış paketlemesinden geçemez
        for k2 in range(len(tys)):
            tg: int = ck.tt.tag[tys[k2]]
            if tg == 9 or tg == 14 or tg == 15:
                mp(ck, "'async def ")
                mp_sym(ck, sym)
                mp(ck, "': parameter '")
                mp_sym(ck, pnames[k2])
                mp(ck, "' has an unsupported type (only int/float/bool/str/None/Task[T]/Channel[T]/ThreadChannel[T] parameters can be packed, and additionally list/class/dict on hosted targets)")
                raise mk_fail(ck, "TypeMismatch")
        m2_put(ck.afn, 0, sym, 1)
    sid_f: int = new_sig(ck, tys, pnames, ret)
    ck.fdecl[sid_f] = ps
    m2_put(ck.fmap, 0, sym, sid_f)
    if pky(sl_at(a, fd, {{O:FuncDef.decorators}})) > 0:
        register_decorators(ck, a, fd, sym)

# ---- `spawn` paylaşılan argüman ve mutasyon analizleri (`SpawnSharedMutation`) ----
def is_mutating_container_method(a: Ast, attr: int) -> bool:
    for nm in ["append", "pop", "sort", "insert", "extend", "reverse", "remove", "clear", "update", "setdefault"]:
        if sref_eq(a, attr, nm):
            return True
    return False

def is_known_safe_builtin_callee(a: Ast, v: int) -> bool:
    for nm in ["len", "print", "str", "int", "float", "bool", "super", "wasm_call", "ptr_from_int", "ptr_to_int", "ptr_add", "ptr_read_int", "ptr_read_float", "ptr_read_bool", "ptr_write_int", "ptr_write_float", "ptr_write_bool", "detach", "ptr_offset", "ptr_of", "ffi_box", "ptr_read", "ptr_write", "ptr_read_volatile", "ptr_write_volatile", "memory_fence", "compiler_fence", "__nox_str_chars"]:
        if sref_eq(a, v, nm):
            return True
    return sref_starts_with(a, v, "__nox_reflect_")

def is_shared_type(ck: Ck, t: int) -> bool:
    g: int = ck.tt.tag[t]
    return g == 5 or g == 13 or g == 6

def param_index_by_name(ck: Ck, a: Ast, ps: int, name_sym: int) -> int:
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])) == name_sym:
            return i
    return -1

def kwarg_decl_index(ck: Ck, a: Ast, fn_sym: int, kw_sr: int) -> int:
    fe: int = m2_get(ck.fmap, 0, fn_sym)
    if fe < 0:
        return -1
    sid: int = ck.fmap.vv[fe]
    ps: int = ck.fdecl[sid]
    if ps < 0:
        return -1
    return param_index_by_name(ck, a, ps, sym_of(ck, a, kw_sr))

def method_is_final(ck: Ck, a: Ast, cls_sym: int, meth_sym: int) -> bool:
    for oi in range(len(ck.cls_sym)):
        other: int = ck.cls_sym[oi]
        if other == cls_sym:
            continue
        if not is_subclass(ck.tt, other, cls_sym):
            continue
        cd: int = ck.cls_node[oi]
        if cd < 0:
            continue
        ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
        for mi in range(pky(ms)):
            m: int = a.l[pkx(ms) + mi]
            if sym_of(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])) == meth_sym:
                return False
    return True

def collect_spawn_targets_expr(ck: Ck, a: Ast, e: int) -> None:
    tag: int = a.n[e]
    if tag <= {{T:Expr.identifier}}:
        return
    if tag == {{T:Expr.unary}}:
        collect_spawn_targets_expr(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}])
        return
    if tag == {{T:Expr.kwarg}}:
        collect_spawn_targets_expr(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}])
        return
    if tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[tp + {{O:Ternary.cond}}])
        collect_spawn_targets_expr(ck, a, a.n[tp + {{O:Ternary.then_expr}}])
        collect_spawn_targets_expr(ck, a, a.n[tp + {{O:Ternary.else_expr}}])
        return
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[bp + {{O:Binary.left}}])
        collect_spawn_targets_expr(ck, a, a.n[bp + {{O:Binary.right}}])
        return
    if tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[cp + {{O:Call.callee}}])
        cargs: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cargs)):
            collect_spawn_targets_expr(ck, a, stmt_at(a, cargs, i))
        return
    if tag == {{T:Expr.attribute}}:
        collect_spawn_targets_expr(ck, a, a.n[a.n[e + 1] + {{O:Attribute.obj}}])
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[lc + {{O:ListComp.elem}}])
        cls_s: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for ci in range(pky(cls_s)):
            cl: int = a.l[pkx(cls_s) + ci]
            if a.n[cl] == {{T:CompClause.for_clause}}:
                collect_spawn_targets_expr(ck, a, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}])
            else:
                collect_spawn_targets_expr(ck, a, a.n[cl + 1])
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[dc + {{O:DictComp.key}}])
        collect_spawn_targets_expr(ck, a, a.n[dc + {{O:DictComp.value}}])
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for di in range(pky(dcls)):
            dcl: int = a.l[pkx(dcls) + di]
            if a.n[dcl] == {{T:CompClause.for_clause}}:
                collect_spawn_targets_expr(ck, a, a.n[a.n[dcl + 1] + {{O:CompForClause.iterable}}])
            else:
                collect_spawn_targets_expr(ck, a, a.n[dcl + 1])
        return
    if tag == {{T:Expr.lambda}}:
        collect_spawn_targets_expr(ck, a, a.n[a.n[e + 1] + {{O:Lambda.body}}])
        return
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[sl + {{O:Slice.obj}}])
        if a.n[sl + {{O:Slice.lo}}] >= 0:
            collect_spawn_targets_expr(ck, a, a.n[sl + {{O:Slice.lo}}])
        if a.n[sl + {{O:Slice.hi}}] >= 0:
            collect_spawn_targets_expr(ck, a, a.n[sl + {{O:Slice.hi}}])
        if a.n[sl + {{O:Slice.step}}] >= 0:
            collect_spawn_targets_expr(ck, a, a.n[sl + {{O:Slice.step}}])
        return
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        collect_spawn_targets_expr(ck, a, a.n[ix + {{O:Index.obj}}])
        collect_spawn_targets_expr(ck, a, a.n[ix + {{O:Index.index}}])
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, e, 1)
        for li in range(pky(el)):
            collect_spawn_targets_expr(ck, a, stmt_at(a, el, li))
        return
    if tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, e, 1)
        for pi in range(pky(dl)):
            dp: int = a.l[pkx(dl) + pi]
            collect_spawn_targets_expr(ck, a, a.n[dp + {{O:DictPair.key}}])
            collect_spawn_targets_expr(ck, a, a.n[dp + {{O:DictPair.value}}])
        return
    if tag == {{T:Expr.await_expr}}:
        collect_spawn_targets_expr(ck, a, a.n[e + 1])
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[e + 1]
        gargs: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for gi in range(pky(gargs)):
            collect_spawn_targets_expr(ck, a, stmt_at(a, gargs, gi))
        return
    if tag == {{T:Expr.spawn_expr}}:
        ck.has_any_spawn = True
        opd: int = a.n[e + 1]
        if a.n[opd] == {{T:Expr.call}}:
            sc: int = a.n[opd + 1]
            cal: int = a.n[sc + {{O:Call.callee}}]
            if a.n[cal] == {{T:Expr.identifier}}:
                m2_put(ck.spawn_targets, 0, sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2])), 1)
            sargs: int = sl_at(a, sc, {{O:Call.args}})
            for si in range(pky(sargs)):
                collect_spawn_targets_expr(ck, a, stmt_at(a, sargs, si))

def collect_spawn_targets_stmts(ck: Ck, a: Ast, s: int) -> None:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            collect_spawn_targets_expr(ck, a, pay)
        elif tag == {{T:StmtKind.var_decl}}:
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:VarDecl.value}}])
        elif tag == {{T:StmtKind.assign}}:
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:Assign.target}}])
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:Assign.value}}])
        elif tag == {{T:StmtKind.if_stmt}}:
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}])
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}))
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                ec: int = a.l[pkx(ecs) + ei]
                collect_spawn_targets_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}])
                collect_spawn_targets_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}))
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}))
        elif tag == {{T:StmtKind.while_stmt}}:
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}])
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}))
        elif tag == {{T:StmtKind.for_stmt}}:
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}])
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}))
        elif tag == {{T:StmtKind.func_def}}:
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}))
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                m: int = a.l[pkx(ms) + mi]
                collect_spawn_targets_stmts(ck, a, sl_at(a, m, {{O:FuncDef.body}}))
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                collect_spawn_targets_expr(ck, a, pay)
        elif tag == {{T:StmtKind.try_stmt}}:
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}))
            txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for ti in range(pky(txs)):
                collect_spawn_targets_stmts(ck, a, sl_at(a, a.l[pkx(txs) + ti], {{O:ExceptClause.body}}))
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}))
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}))
        elif tag == {{T:StmtKind.with_stmt}}:
            collect_spawn_targets_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}])
            collect_spawn_targets_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}))
        elif tag == {{T:StmtKind.defer_stmt}}:
            dc: int = a.n[pay + {{O:DeferStmt.call}}]
            collect_spawn_targets_expr(ck, a, a.n[dc + {{O:Call.callee}}])
            dargs: int = sl_at(a, dc, {{O:Call.args}})
            for di in range(pky(dargs)):
                collect_spawn_targets_expr(ck, a, stmt_at(a, dargs, di))

def resolve_expr_shared_type(ck: Ck, a: Ast, expr: int, sh_sym: list[int], sh_ty: list[int], out_root: list[int]) -> int:
    tag: int = a.n[expr]
    if tag == {{T:Expr.identifier}}:
        nm: int = sym_of(ck, a, pk(a.n[expr + 1], a.n[expr + 2]))
        for i in range(len(sh_sym)):
            if sh_sym[i] == nm:
                out_root[0] = nm
                return sh_ty[i]
        return -1
    if tag == {{T:Expr.attribute}}:
        at: int = a.n[expr + 1]
        pty: int = resolve_expr_shared_type(ck, a, a.n[at + {{O:Attribute.obj}}], sh_sym, sh_ty, out_root)
        if pty < 0 or ck.tt.tag[pty] != 6:
            return -1
        ci: int = class_idx_of_type(ck, pty)
        if ci < 0:
            return -1
        asym: int = sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
        fe: int = m2_get(ck.cls_fields, ci, asym)
        if fe < 0:
            return -1
        return ck.cls_fields.vv[fe]
    return -1

class MutGraph:
    seed_fn: list[int]
    seed_idx: list[int]
    head: Map2
    edge_fn: list[int]
    edge_idx: list[int]
    edge_next: list[int]

    def __init__(self) -> None:
        self.seed_fn = []
        self.seed_idx = []
        self.head = Map2()
        self.edge_fn = []
        self.edge_idx = []
        self.edge_next = []

def mg_add_seed(ck: Ck, a: Ast, mg: MutGraph, fname_sym: int, ps: int, root_sym: int) -> None:
    idx: int = param_index_by_name(ck, a, ps, root_sym)
    if idx < 0:
        return
    mg.seed_fn.append(fname_sym)
    mg.seed_idx.append(idx)

def mg_add_edge(ck: Ck, a: Ast, mg: MutGraph, target_fn: int, target_idx: int, fname_sym: int, ps: int, root_sym: int) -> None:
    idx: int = param_index_by_name(ck, a, ps, root_sym)
    if idx < 0:
        return
    he: int = m2_get(mg.head, target_fn, target_idx)
    prev: int = mg.head.vv[he] if he >= 0 else -1
    nid: int = len(mg.edge_fn)
    mg.edge_fn.append(fname_sym)
    mg.edge_idx.append(idx)
    mg.edge_next.append(prev)
    m2_put(mg.head, target_fn, target_idx, nid)

def scan_mutates_graph_expr(ck: Ck, a: Ast, mg: MutGraph, fname_sym: int, ps: int, expr: int, sh_sym: list[int], sh_ty: list[int]) -> None:
    tag: int = a.n[expr]
    if tag <= {{T:Expr.identifier}}:
        return
    if tag == {{T:Expr.unary}}:
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[a.n[expr + 1] + {{O:Unary.operand}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.kwarg}}:
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[a.n[expr + 1] + {{O:Kwarg.value}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.ternary}}:
        tp: int = a.n[expr + 1]
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[tp + {{O:Ternary.cond}}], sh_sym, sh_ty)
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[tp + {{O:Ternary.then_expr}}], sh_sym, sh_ty)
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[tp + {{O:Ternary.else_expr}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[expr + 1]
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[bp + {{O:Binary.left}}], sh_sym, sh_ty)
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[bp + {{O:Binary.right}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.call}}:
        cp: int = a.n[expr + 1]
        cal: int = a.n[cp + {{O:Call.callee}}]
        cal_free: bool = False
        cal_safe: bool = False
        cal_sym: int = -1
        if a.n[cal] == {{T:Expr.identifier}}:
            cv: int = pk(a.n[cal + 1], a.n[cal + 2])
            cal_sym = sym_of(ck, a, cv)
            cal_free = m2_get(ck.fmap, 0, cal_sym) >= 0
            cal_safe = is_known_safe_builtin_callee(a, cv)
        mown_sym: int = -1
        if a.n[cal] == {{T:Expr.attribute}}:
            at: int = a.n[cal + 1]
            out_r: list[int] = [-1]
            rty: int = resolve_expr_shared_type(ck, a, a.n[at + {{O:Attribute.obj}}], sh_sym, sh_ty, out_r)
            if rty >= 0 and ck.tt.tag[rty] == 6:
                msym: int = sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
                csym: int = ck.tt.xa[rty]
                if method_is_final(ck, a, csym, msym):
                    ci: int = class_idx(ck, csym)
                    if ci >= 0 and m2_get(ck.cls_meths, ci, msym) >= 0:
                        mown_sym = join_syms(ck, [csym, msym], 2, 95)
        cargs: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cargs)):
            ae: int = stmt_at(a, cargs, i)
            av: int = a.n[a.n[ae + 1] + {{O:Kwarg.value}}] if a.n[ae] == {{T:Expr.kwarg}} else ae
            aidx: int = i
            idx_unk: bool = False
            if a.n[ae] == {{T:Expr.kwarg}}:
                if cal_free:
                    ki: int = kwarg_decl_index(ck, a, cal_sym, pk(a.n[a.n[ae + 1] + {{O:Kwarg.name}}], a.n[a.n[ae + 1] + {{O:Kwarg.name}} + 1]))
                    if ki >= 0:
                        aidx = ki
                    else:
                        idx_unk = True
                else:
                    idx_unk = True
            out_r2: list[int] = [-1]
            rty2: int = resolve_expr_shared_type(ck, a, av, sh_sym, sh_ty, out_r2)
            if rty2 >= 0 and is_shared_type(ck, rty2):
                if idx_unk:
                    if not cal_safe:
                        mg_add_seed(ck, a, mg, fname_sym, ps, out_r2[0])
                elif cal_free:
                    mg_add_edge(ck, a, mg, cal_sym, aidx, fname_sym, ps, out_r2[0])
                elif mown_sym >= 0:
                    mg_add_edge(ck, a, mg, mown_sym, aidx + 1, fname_sym, ps, out_r2[0])
                elif not cal_safe:
                    mg_add_seed(ck, a, mg, fname_sym, ps, out_r2[0])
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, ae, sh_sym, sh_ty)
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, cal, sh_sym, sh_ty)
        return
    if tag == {{T:Expr.attribute}}:
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[a.n[expr + 1] + {{O:Attribute.obj}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[expr + 1]
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[lc + {{O:ListComp.elem}}], sh_sym, sh_ty)
        cls_s: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for ci2 in range(pky(cls_s)):
            cl: int = a.l[pkx(cls_s) + ci2]
            if a.n[cl] == {{T:CompClause.for_clause}}:
                scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], sh_sym, sh_ty)
            else:
                scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[cl + 1], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[expr + 1]
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[dc + {{O:DictComp.key}}], sh_sym, sh_ty)
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[dc + {{O:DictComp.value}}], sh_sym, sh_ty)
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for di2 in range(pky(dcls)):
            dcl: int = a.l[pkx(dcls) + di2]
            if a.n[dcl] == {{T:CompClause.for_clause}}:
                scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[a.n[dcl + 1] + {{O:CompForClause.iterable}}], sh_sym, sh_ty)
            else:
                scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[dcl + 1], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.lambda}}:
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[a.n[expr + 1] + {{O:Lambda.body}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[expr + 1]
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[sl + {{O:Slice.obj}}], sh_sym, sh_ty)
        if a.n[sl + {{O:Slice.lo}}] >= 0:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[sl + {{O:Slice.lo}}], sh_sym, sh_ty)
        if a.n[sl + {{O:Slice.hi}}] >= 0:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[sl + {{O:Slice.hi}}], sh_sym, sh_ty)
        if a.n[sl + {{O:Slice.step}}] >= 0:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[sl + {{O:Slice.step}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.index}}:
        ix: int = a.n[expr + 1]
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[ix + {{O:Index.obj}}], sh_sym, sh_ty)
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[ix + {{O:Index.index}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, expr, 1)
        for li in range(pky(el)):
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, stmt_at(a, el, li), sh_sym, sh_ty)
        return
    if tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, expr, 1)
        for pi in range(pky(dl)):
            dp: int = a.l[pkx(dl) + pi]
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[dp + {{O:DictPair.key}}], sh_sym, sh_ty)
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[dp + {{O:DictPair.value}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[expr + 1], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[expr + 1]
        gargs: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for gi in range(pky(gargs)):
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, stmt_at(a, gargs, gi), sh_sym, sh_ty)

def scan_mutates_graph_stmts(ck: Ck, a: Ast, mg: MutGraph, fname_sym: int, ps: int, stmts: int, sh_sym: list[int], sh_ty: list[int]) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}}:
            atg: int = a.n[pay + {{O:Assign.target}}]
            out_r: list[int] = [-1]
            if a.n[atg] == {{T:Expr.index}}:
                rty: int = resolve_expr_shared_type(ck, a, a.n[a.n[atg + 1] + {{O:Index.obj}}], sh_sym, sh_ty, out_r)
                if rty >= 0 and (ck.tt.tag[rty] == 5 or ck.tt.tag[rty] == 13):
                    mg_add_seed(ck, a, mg, fname_sym, ps, out_r[0])
            elif a.n[atg] == {{T:Expr.attribute}}:
                rty2: int = resolve_expr_shared_type(ck, a, a.n[a.n[atg + 1] + {{O:Attribute.obj}}], sh_sym, sh_ty, out_r)
                if rty2 >= 0 and ck.tt.tag[rty2] == 6:
                    mg_add_seed(ck, a, mg, fname_sym, ps, out_r[0])
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[pay + {{O:Assign.value}}], sh_sym, sh_ty)
        elif tag == {{T:StmtKind.expr_stmt}}:
            if a.n[pay] == {{T:Expr.call}}:
                cp: int = a.n[pay + 1]
                cal: int = a.n[cp + {{O:Call.callee}}]
                if a.n[cal] == {{T:Expr.attribute}}:
                    at: int = a.n[cal + 1]
                    if is_mutating_container_method(a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])):
                        out_r3: list[int] = [-1]
                        rty3: int = resolve_expr_shared_type(ck, a, a.n[at + {{O:Attribute.obj}}], sh_sym, sh_ty, out_r3)
                        if rty3 >= 0 and (ck.tt.tag[rty3] == 5 or ck.tt.tag[rty3] == 13):
                            mg_add_seed(ck, a, mg, fname_sym, ps, out_r3[0])
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, pay, sh_sym, sh_ty)
        elif tag == {{T:StmtKind.var_decl}}:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[pay + {{O:VarDecl.value}}], sh_sym, sh_ty)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, pay, sh_sym, sh_ty)
        elif tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, pay, sh_sym, sh_ty)
        elif tag == {{T:StmtKind.if_stmt}}:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[pay + {{O:IfStmt.cond}}], sh_sym, sh_ty)
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:IfStmt.then_body}}), sh_sym, sh_ty)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                ec: int = a.l[pkx(ecs) + ei]
                scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[ec + {{O:ElifClause.cond}}], sh_sym, sh_ty)
                scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, ec, {{O:ElifClause.body}}), sh_sym, sh_ty)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:IfStmt.else_body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.while_stmt}}:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[pay + {{O:WhileStmt.cond}}], sh_sym, sh_ty)
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:WhileStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.for_stmt}}:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[pay + {{O:ForStmt.iterable}}], sh_sym, sh_ty)
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:ForStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.try_stmt}}:
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:TryStmt.try_body}}), sh_sym, sh_ty)
            txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for ti in range(pky(txs)):
                scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, a.l[pkx(txs) + ti], {{O:ExceptClause.body}}), sh_sym, sh_ty)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:TryStmt.finally_body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.with_stmt}}:
            scan_mutates_graph_expr(ck, a, mg, fname_sym, ps, a.n[pay + {{O:WithStmt.ctx_expr}}], sh_sym, sh_ty)
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:WithStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:LowLevelStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, sl_at(a, pay, {{O:LowLevelStmt.body}}), sh_sym, sh_ty)

def scan_mutates_graph_func(ck: Ck, a: Ast, mg: MutGraph, fname_sym: int, ps: int, fbody: int) -> None:
    sh_sym: list[int] = []
    sh_ty: list[int] = []
    is_tpl: bool = m2_get(ck.gfn, 0, fname_sym) >= 0
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        pte_m: int = a.n[p + {{O:Param.type_expr}}]
        if is_tpl and mentions_protocol(ck, a, pte_m):
            continue
        pt: int = -1
        try:
            pt = type_expr_to_type(ck, a, pte_m)
        except CkUnsupported:
            continue
        except CkErr:
            continue
        if is_shared_type(ck, pt):
            sh_sym.append(sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])))
            sh_ty.append(pt)
    if len(sh_sym) == 0:
        return
    scan_mutates_graph_stmts(ck, a, mg, fname_sym, ps, fbody, sh_sym, sh_ty)

def compute_mutates_graph(ck: Ck, a: Ast, body: int) -> None:
    if not ck.has_any_spawn:
        return
    mg: MutGraph = MutGraph()
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            fn_sym: int = sym_of(ck, a, pk(a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1]))
            scan_mutates_graph_func(ck, a, mg, fn_sym, sl_at(a, pay, {{O:FuncDef.params}}), sl_at(a, pay, {{O:FuncDef.body}}))
        elif tag == {{T:StmtKind.class_def}}:
            csym: int = sym_of(ck, a, pk(a.n[pay + {{O:ClassDef.name}}], a.n[pay + {{O:ClassDef.name}} + 1]))
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                m: int = a.l[pkx(ms) + mi]
                msym: int = sym_of(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1]))
                scan_mutates_graph_func(ck, a, mg, join_syms(ck, [csym, msym], 2, 95), sl_at(a, m, {{O:FuncDef.params}}), sl_at(a, m, {{O:FuncDef.body}}))
    wl_fn: list[int] = []
    wl_idx: list[int] = []
    for si in range(len(mg.seed_fn)):
        sf: int = mg.seed_fn[si]
        sx: int = mg.seed_idx[si]
        if m2_get(ck.mutates_params, sf, sx) < 0:
            m2_put(ck.mutates_params, sf, sx, 1)
            wl_fn.append(sf)
            wl_idx.append(sx)
    while len(wl_fn) > 0:
        kf: int = wl_fn.pop()
        kx: int = wl_idx.pop()
        he: int = m2_get(mg.head, kf, kx)
        if he < 0:
            continue
        eid: int = mg.head.vv[he]
        while eid >= 0:
            df: int = mg.edge_fn[eid]
            dx: int = mg.edge_idx[eid]
            if m2_get(ck.mutates_params, df, dx) < 0:
                m2_put(ck.mutates_params, df, dx, 1)
                wl_fn.append(df)
                wl_idx.append(dx)
            eid = mg.edge_next[eid]

def scan_returns_for_alias_effect(ck: Ck, a: Ast, stmts: int, ps: int, alias_indices: list[int], unk: list[bool]) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                et: int = a.n[pay]
                if et == {{T:Expr.identifier}}:
                    idx: int = param_index_by_name(ck, a, ps, sym_of(ck, a, pk(a.n[pay + 1], a.n[pay + 2])))
                    if idx >= 0:
                        if idx not in alias_indices:
                            alias_indices.append(idx)
                    else:
                        unk[0] = True
                elif et == {{T:Expr.list_lit}} or et == {{T:Expr.dict_lit}}:
                    pass
                elif et == {{T:Expr.call}}:
                    cp: int = a.n[pay + 1]
                    cal: int = a.n[cp + {{O:Call.callee}}]
                    if a.n[cal] == {{T:Expr.identifier}}:
                        csym: int = sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2]))
                        if class_idx(ck, csym) >= 0:
                            continue
                        re: int = m2_get(ck.rae_kind, 0, csym)
                        if re >= 0:
                            rk: int = ck.rae_kind.vv[re]
                            if rk == 0:
                                continue
                            if rk == 1:
                                cargs: int = sl_at(a, cp, {{O:Call.args}})
                                rps: int = ck.rae_ps.vv[m2_get(ck.rae_ps, 0, csym)]
                                rpn: int = ck.rae_pn.vv[m2_get(ck.rae_pn, 0, csym)]
                                for ri in range(rpn):
                                    cidx: int = ck.rae_pool[rps + ri]
                                    if cidx < pky(cargs):
                                        ca: int = stmt_at(a, cargs, cidx)
                                        if a.n[ca] == {{T:Expr.identifier}}:
                                            my_idx: int = param_index_by_name(ck, a, ps, sym_of(ck, a, pk(a.n[ca + 1], a.n[ca + 2])))
                                            if my_idx >= 0:
                                                if my_idx not in alias_indices:
                                                    alias_indices.append(my_idx)
                                                continue
                                    unk[0] = True
                                continue
                    unk[0] = True
                else:
                    unk[0] = True
        elif tag == {{T:StmtKind.if_stmt}}:
            scan_returns_for_alias_effect(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), ps, alias_indices, unk)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                scan_returns_for_alias_effect(ck, a, sl_at(a, a.l[pkx(ecs) + ei], {{O:ElifClause.body}}), ps, alias_indices, unk)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                scan_returns_for_alias_effect(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), ps, alias_indices, unk)
        elif tag == {{T:StmtKind.while_stmt}}:
            scan_returns_for_alias_effect(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), ps, alias_indices, unk)
        elif tag == {{T:StmtKind.for_stmt}}:
            scan_returns_for_alias_effect(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), ps, alias_indices, unk)
        elif tag == {{T:StmtKind.try_stmt}} or tag == {{T:StmtKind.with_stmt}}:
            unk[0] = True

def compute_return_alias_effects(ck: Ck, a: Ast, body: int) -> None:
    if not ck.has_any_spawn:
        return
    iters: int = 0
    while True:
        iters = iters + 1
        changed: bool = False
        for i in range(pky(body)):
            st: int = stmt_at(a, body, i)
            kn: int = a.n[st + {{O:Stmt.kind}}]
            if a.n[kn] != {{T:StmtKind.func_def}}:
                continue
            fd: int = a.n[kn + 1]
            fn_sym: int = sym_of(ck, a, pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1]))
            if pky(sl_at(a, fd, {{O:FuncDef.type_params}})) != 0 or m2_get(ck.gfn, 0, fn_sym) >= 0:
                continue
            alias_indices: list[int] = []
            unk: list[bool] = [False]
            scan_returns_for_alias_effect(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), sl_at(a, fd, {{O:FuncDef.params}}), alias_indices, unk)
            nk: int = 2 if unk[0] else (0 if len(alias_indices) == 0 else 1)
            pe: int = m2_get(ck.rae_kind, 0, fn_sym)
            if pe < 0:
                changed = True
            else:
                pk_old: int = ck.rae_kind.vv[pe]
                if pk_old != nk:
                    changed = True
                elif nk == 1:
                    ops: int = ck.rae_ps.vv[m2_get(ck.rae_ps, 0, fn_sym)]
                    opn: int = ck.rae_pn.vv[m2_get(ck.rae_pn, 0, fn_sym)]
                    if opn != len(alias_indices):
                        changed = True
                    else:
                        for xi in range(len(alias_indices)):
                            found_x: bool = False
                            for yi in range(opn):
                                if ck.rae_pool[ops + yi] == alias_indices[xi]:
                                    found_x = True
                                    break
                            if not found_x:
                                changed = True
                                break
            m2_put(ck.rae_kind, 0, fn_sym, nk)
            if nk == 1:
                st_p: int = len(ck.rae_pool)
                for ai in alias_indices:
                    ck.rae_pool.append(ai)
                m2_put(ck.rae_ps, 0, fn_sym, st_p)
                m2_put(ck.rae_pn, 0, fn_sym, len(alias_indices))
        if not changed or iters >= 64:
            return

def fail_spawn_shared(ck: Ck, fd_sym: int, root_sym: int, trans: bool, via_method: bool, via_sym: int) -> None:
    mp(ck, "since function '")
    mp_sym(ck, fd_sym)
    mp(ck, "' is a 'spawn' target, its shared parameter '")
    mp_sym(ck, root_sym)
    if not trans:
        mp(ck, "' cannot be mutated here (unsynchronised mutation across concurrent workers causes a data race) — make a local copy first")
    elif via_method:
        mp(ck, "' cannot be mutated transitively here through the method '")
        mp_sym(ck, via_sym)
        mp(ck, "' (unsynchronised mutation across concurrent workers causes a data race) — make a local copy first")
    else:
        mp(ck, "' cannot be mutated transitively here through '")
        mp_sym(ck, via_sym)
        mp(ck, "' (unsynchronised mutation across concurrent workers causes a data race) — make a local copy first")
    raise mk_fail(ck, "SpawnSharedMutation")

def check_transitive_spawn_shared_expr(ck: Ck, a: Ast, fd_sym: int, expr: int, sh_sym: list[int], sh_ty: list[int]) -> None:
    tag: int = a.n[expr]
    if tag <= {{T:Expr.identifier}}:
        return
    if tag == {{T:Expr.unary}}:
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[a.n[expr + 1] + {{O:Unary.operand}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.kwarg}}:
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[a.n[expr + 1] + {{O:Kwarg.value}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.ternary}}:
        tp: int = a.n[expr + 1]
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[tp + {{O:Ternary.cond}}], sh_sym, sh_ty)
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[tp + {{O:Ternary.then_expr}}], sh_sym, sh_ty)
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[tp + {{O:Ternary.else_expr}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[expr + 1]
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[bp + {{O:Binary.left}}], sh_sym, sh_ty)
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[bp + {{O:Binary.right}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.call}}:
        cp: int = a.n[expr + 1]
        cal: int = a.n[cp + {{O:Call.callee}}]
        cal_free: bool = False
        cal_sym: int = -1
        if a.n[cal] == {{T:Expr.identifier}}:
            cal_sym = sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2]))
            cal_free = m2_get(ck.fmap, 0, cal_sym) >= 0
        mown_sym: int = -1
        m_msg_sym: int = -1
        if a.n[cal] == {{T:Expr.attribute}}:
            at: int = a.n[cal + 1]
            out_r: list[int] = [-1]
            rty: int = resolve_expr_shared_type(ck, a, a.n[at + {{O:Attribute.obj}}], sh_sym, sh_ty, out_r)
            if rty >= 0 and ck.tt.tag[rty] == 6:
                msym: int = sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
                csym: int = ck.tt.xa[rty]
                if method_is_final(ck, a, csym, msym):
                    ci: int = class_idx(ck, csym)
                    if ci >= 0 and m2_get(ck.cls_meths, ci, msym) >= 0:
                        mown_sym = join_syms(ck, [csym, msym], 2, 95)
                        m_msg_sym = msym
        cargs: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cargs)):
            ae: int = stmt_at(a, cargs, i)
            av: int = a.n[a.n[ae + 1] + {{O:Kwarg.value}}] if a.n[ae] == {{T:Expr.kwarg}} else ae
            idx: int = i
            skip_kw: bool = False
            if a.n[ae] == {{T:Expr.kwarg}}:
                if cal_free:
                    ki: int = kwarg_decl_index(ck, a, cal_sym, pk(a.n[a.n[ae + 1] + {{O:Kwarg.name}}], a.n[a.n[ae + 1] + {{O:Kwarg.name}} + 1]))
                    if ki >= 0:
                        idx = ki
                    else:
                        skip_kw = True
                else:
                    skip_kw = True
            if skip_kw:
                check_transitive_spawn_shared_expr(ck, a, fd_sym, av, sh_sym, sh_ty)
                continue
            if cal_free:
                out_r2: list[int] = [-1]
                rty2: int = resolve_expr_shared_type(ck, a, av, sh_sym, sh_ty, out_r2)
                if rty2 >= 0 and is_shared_type(ck, rty2):
                    if m2_get(ck.mutates_params, cal_sym, idx) >= 0:
                        fail_spawn_shared(ck, fd_sym, out_r2[0], True, False, cal_sym)
            elif mown_sym >= 0:
                out_r3: list[int] = [-1]
                rty3: int = resolve_expr_shared_type(ck, a, ae, sh_sym, sh_ty, out_r3)
                if rty3 >= 0 and is_shared_type(ck, rty3):
                    if m2_get(ck.mutates_params, mown_sym, idx + 1) >= 0:
                        fail_spawn_shared(ck, fd_sym, out_r3[0], True, True, m_msg_sym)
            check_transitive_spawn_shared_expr(ck, a, fd_sym, ae, sh_sym, sh_ty)
        check_transitive_spawn_shared_expr(ck, a, fd_sym, cal, sh_sym, sh_ty)
        return
    if tag == {{T:Expr.attribute}}:
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[a.n[expr + 1] + {{O:Attribute.obj}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[expr + 1]
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[lc + {{O:ListComp.elem}}], sh_sym, sh_ty)
        cls_s: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for ci2 in range(pky(cls_s)):
            cl: int = a.l[pkx(cls_s) + ci2]
            if a.n[cl] == {{T:CompClause.for_clause}}:
                check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], sh_sym, sh_ty)
            else:
                check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[cl + 1], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[expr + 1]
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[dc + {{O:DictComp.key}}], sh_sym, sh_ty)
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[dc + {{O:DictComp.value}}], sh_sym, sh_ty)
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for di2 in range(pky(dcls)):
            dcl: int = a.l[pkx(dcls) + di2]
            if a.n[dcl] == {{T:CompClause.for_clause}}:
                check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[a.n[dcl + 1] + {{O:CompForClause.iterable}}], sh_sym, sh_ty)
            else:
                check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[dcl + 1], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.lambda}}:
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[a.n[expr + 1] + {{O:Lambda.body}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[expr + 1]
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[sl + {{O:Slice.obj}}], sh_sym, sh_ty)
        if a.n[sl + {{O:Slice.lo}}] >= 0:
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[sl + {{O:Slice.lo}}], sh_sym, sh_ty)
        if a.n[sl + {{O:Slice.hi}}] >= 0:
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[sl + {{O:Slice.hi}}], sh_sym, sh_ty)
        if a.n[sl + {{O:Slice.step}}] >= 0:
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[sl + {{O:Slice.step}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.index}}:
        ix: int = a.n[expr + 1]
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[ix + {{O:Index.obj}}], sh_sym, sh_ty)
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[ix + {{O:Index.index}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, expr, 1)
        for li in range(pky(el)):
            check_transitive_spawn_shared_expr(ck, a, fd_sym, stmt_at(a, el, li), sh_sym, sh_ty)
        return
    if tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, expr, 1)
        for pi in range(pky(dl)):
            dp: int = a.l[pkx(dl) + pi]
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[dp + {{O:DictPair.key}}], sh_sym, sh_ty)
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[dp + {{O:DictPair.value}}], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[expr + 1], sh_sym, sh_ty)
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[expr + 1]
        gargs: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for gi in range(pky(gargs)):
            check_transitive_spawn_shared_expr(ck, a, fd_sym, stmt_at(a, gargs, gi), sh_sym, sh_ty)

def check_no_spawn_shared_mutation(ck: Ck, a: Ast, fd_sym: int, stmts: int, sh_sym: list[int], sh_ty: list[int]) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}}:
            atg: int = a.n[pay + {{O:Assign.target}}]
            out_r: list[int] = [-1]
            if a.n[atg] == {{T:Expr.index}}:
                rty: int = resolve_expr_shared_type(ck, a, a.n[a.n[atg + 1] + {{O:Index.obj}}], sh_sym, sh_ty, out_r)
                if rty >= 0 and (ck.tt.tag[rty] == 5 or ck.tt.tag[rty] == 13):
                    fail_spawn_shared(ck, fd_sym, out_r[0], False, False, -1)
            elif a.n[atg] == {{T:Expr.attribute}}:
                rty2: int = resolve_expr_shared_type(ck, a, a.n[a.n[atg + 1] + {{O:Attribute.obj}}], sh_sym, sh_ty, out_r)
                if rty2 >= 0 and ck.tt.tag[rty2] == 6:
                    fail_spawn_shared(ck, fd_sym, out_r[0], False, False, -1)
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[pay + {{O:Assign.value}}], sh_sym, sh_ty)
        elif tag == {{T:StmtKind.var_decl}}:
            check_transitive_spawn_shared_expr(ck, a, fd_sym, a.n[pay + {{O:VarDecl.value}}], sh_sym, sh_ty)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                check_transitive_spawn_shared_expr(ck, a, fd_sym, pay, sh_sym, sh_ty)
        elif tag == {{T:StmtKind.raise_stmt}}:
            check_transitive_spawn_shared_expr(ck, a, fd_sym, pay, sh_sym, sh_ty)
        elif tag == {{T:StmtKind.expr_stmt}}:
            if a.n[pay] == {{T:Expr.call}}:
                cp: int = a.n[pay + 1]
                cal: int = a.n[cp + {{O:Call.callee}}]
                if a.n[cal] == {{T:Expr.attribute}}:
                    at: int = a.n[cal + 1]
                    if is_mutating_container_method(a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])):
                        out_r3: list[int] = [-1]
                        rty3: int = resolve_expr_shared_type(ck, a, a.n[at + {{O:Attribute.obj}}], sh_sym, sh_ty, out_r3)
                        if rty3 >= 0 and (ck.tt.tag[rty3] == 5 or ck.tt.tag[rty3] == 13):
                            fail_spawn_shared(ck, fd_sym, out_r3[0], False, False, -1)
            check_transitive_spawn_shared_expr(ck, a, fd_sym, pay, sh_sym, sh_ty)
        elif tag == {{T:StmtKind.if_stmt}}:
            check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:IfStmt.then_body}}), sh_sym, sh_ty)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, a.l[pkx(ecs) + ei], {{O:ElifClause.body}}), sh_sym, sh_ty)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:IfStmt.else_body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.while_stmt}}:
            check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:WhileStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.for_stmt}}:
            check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:ForStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.try_stmt}}:
            check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:TryStmt.try_body}}), sh_sym, sh_ty)
            txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for ti in range(pky(txs)):
                check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, a.l[pkx(txs) + ti], {{O:ExceptClause.body}}), sh_sym, sh_ty)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:TryStmt.finally_body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.with_stmt}}:
            check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:WithStmt.body}}), sh_sym, sh_ty)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            check_no_spawn_shared_mutation(ck, a, fd_sym, sl_at(a, pay, {{O:LowLevelStmt.body}}), sh_sym, sh_ty)

class IntListMap:
    keys: list[int]
    starts: list[int]
    lens: list[int]
    pool: list[int]

    def __init__(self) -> None:
        self.keys = []
        self.starts = []
        self.lens = []
        self.pool = []

def ilm_clone(m: IntListMap) -> IntListMap:
    out: IntListMap = IntListMap()
    for k in m.keys:
        out.keys.append(k)
    for s in m.starts:
        out.starts.append(s)
    for l in m.lens:
        out.lens.append(l)
    for p in m.pool:
        out.pool.append(p)
    return out

def ilm_idx(m: IntListMap, k: int) -> int:
    for i in range(len(m.keys)):
        if m.keys[i] == k:
            return i
    return -1

def ilm_set_one(m: IntListMap, k: int, v: int) -> None:
    st: int = len(m.pool)
    m.pool.append(v)
    idx: int = ilm_idx(m, k)
    if idx >= 0:
        m.starts[idx] = st
        m.lens[idx] = 1
    else:
        m.keys.append(k)
        m.starts.append(st)
        m.lens.append(1)

def ilm_set_slice(m: IntListMap, k: int, vs: list[int]) -> None:
    st: int = len(m.pool)
    for v in vs:
        m.pool.append(v)
    idx: int = ilm_idx(m, k)
    if idx >= 0:
        m.starts[idx] = st
        m.lens[idx] = len(vs)
    else:
        m.keys.append(k)
        m.starts.append(st)
        m.lens.append(len(vs))

def ilm_add_unique(m: IntListMap, k: int, v: int) -> None:
    idx: int = ilm_idx(m, k)
    if idx < 0:
        ilm_set_one(m, k, v)
        return
    st: int = m.starts[idx]
    ln: int = m.lens[idx]
    for i in range(ln):
        if m.pool[st + i] == v:
            return
    nst: int = len(m.pool)
    for i2 in range(ln):
        m.pool.append(m.pool[st + i2])
    m.pool.append(v)
    m.starts[idx] = nst
    m.lens[idx] = ln + 1

def ilm_remove_key(m: IntListMap, k: int) -> None:
    idx: int = ilm_idx(m, k)
    if idx < 0:
        return
    last: int = len(m.keys) - 1
    if idx != last:
        m.keys[idx] = m.keys[last]
        m.starts[idx] = m.starts[last]
        m.lens[idx] = m.lens[last]
    m.keys.pop()
    m.starts.pop()
    m.lens.pop()

def ilm_merge_from(dst: IntListMap, src: IntListMap) -> bool:
    changed: bool = False
    for si in range(len(src.keys)):
        k: int = src.keys[si]
        sst: int = src.starts[si]
        sln: int = src.lens[si]
        di: int = ilm_idx(dst, k)
        if di < 0:
            nst: int = len(dst.pool)
            for j in range(sln):
                dst.pool.append(src.pool[sst + j])
            dst.keys.append(k)
            dst.starts.append(nst)
            dst.lens.append(sln)
            changed = True
        else:
            dst_s: int = dst.starts[di]
            dst_n: int = dst.lens[di]
            adds: list[int] = []
            for j2 in range(sln):
                sv: int = src.pool[sst + j2]
                found: bool = False
                for q in range(dst_n):
                    if dst.pool[dst_s + q] == sv:
                        found = True
                        break
                if not found:
                    for a2 in adds:
                        if a2 == sv:
                            found = True
                            break
                if not found:
                    adds.append(sv)
            if len(adds) > 0:
                nst2: int = len(dst.pool)
                for q2 in range(dst_n):
                    dst.pool.append(dst.pool[dst_s + q2])
                for a3 in adds:
                    dst.pool.append(a3)
                dst.starts[di] = nst2
                dst.lens[di] = dst_n + len(adds)
                changed = True
    return changed

class SpawnFlow:
    pt: IntListMap
    ro: IntListMap
    tk: IntListMap
    locked: list[int]

    def __init__(self) -> None:
        self.pt = IntListMap()
        self.ro = IntListMap()
        self.tk = IntListMap()
        self.locked = []

def sf_clone(sf: SpawnFlow) -> SpawnFlow:
    out: SpawnFlow = SpawnFlow()
    out.pt = ilm_clone(sf.pt)
    out.ro = ilm_clone(sf.ro)
    out.tk = ilm_clone(sf.tk)
    for l in sf.locked:
        out.locked.append(l)
    return out

def sf_merge_from(dst: SpawnFlow, src: SpawnFlow) -> bool:
    c0: bool = ilm_merge_from(dst.pt, src.pt)
    c1: bool = ilm_merge_from(dst.ro, src.ro)
    c2: bool = ilm_merge_from(dst.tk, src.tk)
    c3: bool = False
    for l in src.locked:
        if l not in dst.locked:
            dst.locked.append(l)
            c3 = True
    return c0 or c1 or c2 or c3

def sf_is_resource_owned(sf: SpawnFlow, var_sym: int) -> bool:
    pi: int = ilm_idx(sf.pt, var_sym)
    if pi < 0:
        return False
    pst: int = sf.pt.starts[pi]
    pln: int = sf.pt.lens[pi]
    for i in range(pln):
        ri: int = ilm_idx(sf.ro, sf.pt.pool[pst + i])
        if ri >= 0 and sf.ro.lens[ri] > 0:
            return True
    return False

def fail_post_spawn_mut(ck: Ck, var_sym: int) -> None:
    mp(ck, "'")
    mp_sym(ck, var_sym)
    mp(ck, "' cannot be mutated here after being passed as a shared argument to a 'spawn' call and before it is awaited (unsynchronised mutation across concurrent workers causes a data race) — 'await' first or use a local copy")
    raise mk_fail(ck, "SpawnSharedMutation")

def check_direct_shared_mutation_stmt(ck: Ck, a: Ast, st: int, sf: SpawnFlow) -> None:
    kn: int = a.n[st + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    if tag == {{T:StmtKind.assign}}:
        atg: int = a.n[pay + {{O:Assign.target}}]
        obj: int = -1
        if a.n[atg] == {{T:Expr.index}}:
            obj = a.n[a.n[atg + 1] + {{O:Index.obj}}]
        elif a.n[atg] == {{T:Expr.attribute}}:
            obj = a.n[a.n[atg + 1] + {{O:Attribute.obj}}]
        if obj >= 0 and a.n[obj] == {{T:Expr.identifier}}:
            vsym: int = sym_of(ck, a, pk(a.n[obj + 1], a.n[obj + 2]))
            if sf_is_resource_owned(sf, vsym):
                fail_post_spawn_mut(ck, vsym)
    elif tag == {{T:StmtKind.expr_stmt}} and a.n[pay] == {{T:Expr.call}}:
        cp: int = a.n[pay + 1]
        cal: int = a.n[cp + {{O:Call.callee}}]
        if a.n[cal] == {{T:Expr.attribute}}:
            at: int = a.n[cal + 1]
            aobj: int = a.n[at + {{O:Attribute.obj}}]
            if a.n[aobj] == {{T:Expr.identifier}} and is_mutating_container_method(a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])):
                vsym2: int = sym_of(ck, a, pk(a.n[aobj + 1], a.n[aobj + 2]))
                if sf_is_resource_owned(sf, vsym2):
                    fail_post_spawn_mut(ck, vsym2)

def remove_awaited_task_sharing(ck: Ck, a: Ast, expr: int, sf: SpawnFlow) -> None:
    tag: int = a.n[expr]
    if tag <= {{T:Expr.identifier}}:
        return
    if tag == {{T:Expr.await_expr}}:
        op: int = a.n[expr + 1]
        if a.n[op] == {{T:Expr.identifier}}:
            tsym: int = sym_of(ck, a, pk(a.n[op + 1], a.n[op + 2]))
            ti: int = ilm_idx(sf.tk, tsym)
            if ti >= 0:
                tst: int = sf.tk.starts[ti]
                tln: int = sf.tk.lens[ti]
                rm_keys: list[int] = []
                for ri in range(len(sf.ro.keys)):
                    rk: int = sf.ro.keys[ri]
                    if rk in sf.locked:
                        continue
                    rst: int = sf.ro.starts[ri]
                    rln: int = sf.ro.lens[ri]
                    rem: list[int] = []
                    for oi in range(rln):
                        oid: int = sf.ro.pool[rst + oi]
                        still: bool = True
                        for ai in range(tln):
                            if oid == sf.tk.pool[tst + ai]:
                                still = False
                                break
                        if still:
                            rem.append(oid)
                    if len(rem) == 0:
                        rm_keys.append(rk)
                    elif len(rem) != rln:
                        nst: int = len(sf.ro.pool)
                        for x in rem:
                            sf.ro.pool.append(x)
                        sf.ro.starts[ri] = nst
                        sf.ro.lens[ri] = len(rem)
                for rk2 in rm_keys:
                    ilm_remove_key(sf.ro, rk2)
        remove_awaited_task_sharing(ck, a, op, sf)
        return
    if tag == {{T:Expr.unary}}:
        remove_awaited_task_sharing(ck, a, a.n[a.n[expr + 1] + {{O:Unary.operand}}], sf)
        return
    if tag == {{T:Expr.kwarg}}:
        remove_awaited_task_sharing(ck, a, a.n[a.n[expr + 1] + {{O:Kwarg.value}}], sf)
        return
    if tag == {{T:Expr.ternary}}:
        tp: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[tp + {{O:Ternary.cond}}], sf)
        remove_awaited_task_sharing(ck, a, a.n[tp + {{O:Ternary.then_expr}}], sf)
        remove_awaited_task_sharing(ck, a, a.n[tp + {{O:Ternary.else_expr}}], sf)
        return
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[bp + {{O:Binary.left}}], sf)
        remove_awaited_task_sharing(ck, a, a.n[bp + {{O:Binary.right}}], sf)
        return
    if tag == {{T:Expr.call}}:
        cp: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[cp + {{O:Call.callee}}], sf)
        cargs: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cargs)):
            remove_awaited_task_sharing(ck, a, stmt_at(a, cargs, i), sf)
        return
    if tag == {{T:Expr.attribute}}:
        remove_awaited_task_sharing(ck, a, a.n[a.n[expr + 1] + {{O:Attribute.obj}}], sf)
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[lc + {{O:ListComp.elem}}], sf)
        cls_s: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for ci2 in range(pky(cls_s)):
            cl: int = a.l[pkx(cls_s) + ci2]
            if a.n[cl] == {{T:CompClause.for_clause}}:
                remove_awaited_task_sharing(ck, a, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], sf)
            else:
                remove_awaited_task_sharing(ck, a, a.n[cl + 1], sf)
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[dc + {{O:DictComp.key}}], sf)
        remove_awaited_task_sharing(ck, a, a.n[dc + {{O:DictComp.value}}], sf)
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for di2 in range(pky(dcls)):
            dcl: int = a.l[pkx(dcls) + di2]
            if a.n[dcl] == {{T:CompClause.for_clause}}:
                remove_awaited_task_sharing(ck, a, a.n[a.n[dcl + 1] + {{O:CompForClause.iterable}}], sf)
            else:
                remove_awaited_task_sharing(ck, a, a.n[dcl + 1], sf)
        return
    if tag == {{T:Expr.lambda}}:
        remove_awaited_task_sharing(ck, a, a.n[a.n[expr + 1] + {{O:Lambda.body}}], sf)
        return
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[sl + {{O:Slice.obj}}], sf)
        if a.n[sl + {{O:Slice.lo}}] >= 0:
            remove_awaited_task_sharing(ck, a, a.n[sl + {{O:Slice.lo}}], sf)
        if a.n[sl + {{O:Slice.hi}}] >= 0:
            remove_awaited_task_sharing(ck, a, a.n[sl + {{O:Slice.hi}}], sf)
        if a.n[sl + {{O:Slice.step}}] >= 0:
            remove_awaited_task_sharing(ck, a, a.n[sl + {{O:Slice.step}}], sf)
        return
    if tag == {{T:Expr.index}}:
        ix: int = a.n[expr + 1]
        remove_awaited_task_sharing(ck, a, a.n[ix + {{O:Index.obj}}], sf)
        remove_awaited_task_sharing(ck, a, a.n[ix + {{O:Index.index}}], sf)
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, expr, 1)
        for li in range(pky(el)):
            remove_awaited_task_sharing(ck, a, stmt_at(a, el, li), sf)
        return
    if tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, expr, 1)
        for pi in range(pky(dl)):
            dp: int = a.l[pkx(dl) + pi]
            remove_awaited_task_sharing(ck, a, a.n[dp + {{O:DictPair.key}}], sf)
            remove_awaited_task_sharing(ck, a, a.n[dp + {{O:DictPair.value}}], sf)
        return
    if tag == {{T:Expr.spawn_expr}}:
        remove_awaited_task_sharing(ck, a, a.n[expr + 1], sf)
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[expr + 1]
        gargs: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for gi in range(pky(gargs)):
            remove_awaited_task_sharing(ck, a, stmt_at(a, gargs, gi), sf)

def update_points_to_for_target(ck: Ck, a: Ast, sf: SpawnFlow, target_sym: int, target_ty: int, rhs: int, stmt_id: int) -> None:
    if not is_shared_type(ck, target_ty):
        return
    rtag: int = a.n[rhs]
    if rtag == {{T:Expr.list_lit}} or rtag == {{T:Expr.dict_lit}}:
        ilm_set_one(sf.pt, target_sym, stmt_id)
        return
    if rtag == {{T:Expr.call}}:
        cp: int = a.n[rhs + 1]
        cal: int = a.n[cp + {{O:Call.callee}}]
        if a.n[cal] == {{T:Expr.identifier}}:
            csym: int = sym_of(ck, a, pk(a.n[cal + 1], a.n[cal + 2]))
            re: int = m2_get(ck.rae_kind, 0, csym)
            if re >= 0:
                rk: int = ck.rae_kind.vv[re]
                if rk == 0:
                    ilm_set_one(sf.pt, target_sym, stmt_id)
                elif rk == 1:
                    cargs: int = sl_at(a, cp, {{O:Call.args}})
                    rps: int = ck.rae_ps.vv[m2_get(ck.rae_ps, 0, csym)]
                    rpn: int = ck.rae_pn.vv[m2_get(ck.rae_pn, 0, csym)]
                    collected: list[int] = []
                    fe: int = m2_get(ck.fmap, 0, csym)
                    fdecl_ps: int = ck.fdecl[ck.fmap.vv[fe]] if fe >= 0 else -1
                    for ri in range(rpn):
                        cidx: int = ck.rae_pool[rps + ri]
                        aexpr: int = -1
                        if cidx < pky(cargs):
                            ce0: int = stmt_at(a, cargs, cidx)
                            if a.n[ce0] != {{T:Expr.kwarg}}:
                                aexpr = ce0
                        if aexpr < 0 and fdecl_ps >= 0 and cidx < pky(fdecl_ps):
                            dp: int = stmt_at(a, fdecl_ps, cidx)
                            pnm_sym: int = sym_of(ck, a, pk(a.n[dp + {{O:Param.name}}], a.n[dp + {{O:Param.name}} + 1]))
                            for ki in range(pky(cargs)):
                                ke: int = stmt_at(a, cargs, ki)
                                if a.n[ke] == {{T:Expr.kwarg}}:
                                    kp: int = a.n[ke + 1]
                                    if sym_of(ck, a, pk(a.n[kp + {{O:Kwarg.name}}], a.n[kp + {{O:Kwarg.name}} + 1])) == pnm_sym:
                                        aexpr = a.n[kp + {{O:Kwarg.value}}]
                                        break
                        if aexpr >= 0 and a.n[aexpr] == {{T:Expr.identifier}}:
                            src_sym: int = sym_of(ck, a, pk(a.n[aexpr + 1], a.n[aexpr + 2]))
                            si: int = ilm_idx(sf.pt, src_sym)
                            if si >= 0:
                                sst: int = sf.pt.starts[si]
                                sln: int = sf.pt.lens[si]
                                for j in range(sln):
                                    sid: int = sf.pt.pool[sst + j]
                                    if sid not in collected:
                                        collected.append(sid)
                    if len(collected) > 0:
                        ilm_set_slice(sf.pt, target_sym, collected)
            else:
                ilm_set_one(sf.pt, target_sym, stmt_id)
        return
    if rtag == {{T:Expr.identifier}}:
        src_sym2: int = sym_of(ck, a, pk(a.n[rhs + 1], a.n[rhs + 2]))
        si2: int = ilm_idx(sf.pt, src_sym2)
        if si2 >= 0:
            sst2: int = sf.pt.starts[si2]
            sln2: int = sf.pt.lens[si2]
            copied: list[int] = []
            for j2 in range(sln2):
                copied.append(sf.pt.pool[sst2 + j2])
            ilm_set_slice(sf.pt, target_sym, copied)

def lock_recurrent_loop_ownership(pre: SpawnFlow, sf: SpawnFlow) -> None:
    for ri in range(len(sf.ro.keys)):
        rk: int = sf.ro.keys[ri]
        rst: int = sf.ro.starts[ri]
        rln: int = sf.ro.lens[ri]
        pi: int = ilm_idx(pre.ro, rk)
        pst: int = pre.ro.starts[pi] if pi >= 0 else 0
        pln: int = pre.ro.lens[pi] if pi >= 0 else 0
        for j in range(rln):
            id_v: int = sf.ro.pool[rst + j]
            was_pre: bool = False
            for k in range(pln):
                if pre.ro.pool[pst + k] == id_v:
                    was_pre = True
                    break
            if not was_pre:
                if rk not in sf.locked:
                    sf.locked.append(rk)
                break

def force_conservative_state(ck: Ck, known: Map2, sf: SpawnFlow) -> None:
    for e in range(len(known.k1)):
        if known.dead[e] != 0:
            continue
        if is_shared_type(ck, known.vv[e]):
            pi: int = ilm_idx(sf.pt, known.k2[e])
            if pi >= 0:
                pst: int = sf.pt.starts[pi]
                pln: int = sf.pt.lens[pi]
                for i in range(pln):
                    ilm_add_unique(sf.ro, sf.pt.pool[pst + i], -999)

def iterate_loop_to_fixpoint(ck: Ck, a: Ast, body: int, known: Map2, sf: SpawnFlow, jumps: list[SpawnFlow]) -> None:
    pre_loop: SpawnFlow = sf_clone(sf)
    iters: int = 0
    while True:
        iters = iters + 1
        jmark: int = len(jumps)
        bstate: SpawnFlow = sf_clone(sf)
        walk_post_spawn_caller_mutation(ck, a, body, known, bstate, jumps)
        changed: bool = sf_merge_from(sf, bstate)
        for ji in range(jmark, len(jumps)):
            if sf_merge_from(sf, jumps[ji]):
                changed = True
        while len(jumps) > jmark:
            jumps.pop()
        if not changed:
            lock_recurrent_loop_ownership(pre_loop, sf)
            return
        if iters >= 64:
            force_conservative_state(ck, known, sf)
            return

def walk_post_spawn_caller_mutation(ck: Ck, a: Ast, stmts: int, known: Map2, sf: SpawnFlow, jumps: list[SpawnFlow]) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        check_direct_shared_mutation_stmt(ck, a, st, sf)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.var_decl}}:
            vsym: int = sym_of(ck, a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1]))
            vt: int = 4
            try:
                vt = type_expr_to_type(ck, a, a.n[pay + {{O:VarDecl.type_expr}}])
            except CkUnsupported:
                vt = 4
            except CkErr:
                vt = 4
            m2_put(known, 0, vsym, vt)
            update_points_to_for_target(ck, a, sf, vsym, vt, a.n[pay + {{O:VarDecl.value}}], st)
        elif tag == {{T:StmtKind.assign}}:
            atg: int = a.n[pay + {{O:Assign.target}}]
            if a.n[atg] == {{T:Expr.identifier}}:
                asym: int = sym_of(ck, a, pk(a.n[atg + 1], a.n[atg + 2]))
                ke: int = m2_get(known, 0, asym)
                if ke >= 0:
                    update_points_to_for_target(ck, a, sf, asym, known.vv[ke], a.n[pay + {{O:Assign.value}}], st)
        sv: int = -1
        decl_sym: int = -1
        if tag == {{T:StmtKind.var_decl}}:
            sv = a.n[pay + {{O:VarDecl.value}}]
            decl_sym = sym_of(ck, a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1]))
        elif tag == {{T:StmtKind.assign}}:
            sv = a.n[pay + {{O:Assign.value}}]
        elif tag == {{T:StmtKind.expr_stmt}}:
            sv = pay
        if sv >= 0 and a.n[sv] == {{T:Expr.spawn_expr}}:
            sop: int = a.n[sv + 1]
            if a.n[sop] == {{T:Expr.call}}:
                cp: int = a.n[sop + 1]
                cargs: int = sl_at(a, cp, {{O:Call.args}})
                any_shared: bool = False
                for ai in range(pky(cargs)):
                    ae: int = stmt_at(a, cargs, ai)
                    arg: int = a.n[a.n[ae + 1] + {{O:Kwarg.value}}] if a.n[ae] == {{T:Expr.kwarg}} else ae
                    if a.n[arg] == {{T:Expr.identifier}}:
                        arg_sym: int = sym_of(ck, a, pk(a.n[arg + 1], a.n[arg + 2]))
                        ke2: int = m2_get(known, 0, arg_sym)
                        if ke2 >= 0 and is_shared_type(ck, known.vv[ke2]):
                            any_shared = True
                            pi: int = ilm_idx(sf.pt, arg_sym)
                            if pi >= 0:
                                pst: int = sf.pt.starts[pi]
                                pln: int = sf.pt.lens[pi]
                                for j in range(pln):
                                    ilm_add_unique(sf.ro, sf.pt.pool[pst + j], sv)
                if decl_sym >= 0 and any_shared:
                    ilm_add_unique(sf.tk, decl_sym, sv)
        if tag == {{T:StmtKind.var_decl}}:
            remove_awaited_task_sharing(ck, a, a.n[pay + {{O:VarDecl.value}}], sf)
        elif tag == {{T:StmtKind.assign}}:
            remove_awaited_task_sharing(ck, a, a.n[pay + {{O:Assign.value}}], sf)
        elif tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}}:
            remove_awaited_task_sharing(ck, a, pay, sf)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                remove_awaited_task_sharing(ck, a, pay, sf)
        if tag == {{T:StmtKind.if_stmt}}:
            then_sf: SpawnFlow = sf_clone(sf)
            walk_post_spawn_caller_mutation(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), known, then_sf, jumps)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                ec_sf: SpawnFlow = sf_clone(sf)
                walk_post_spawn_caller_mutation(ck, a, sl_at(a, a.l[pkx(ecs) + ei], {{O:ElifClause.body}}), known, ec_sf, jumps)
                sf_merge_from(then_sf, ec_sf)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                else_sf: SpawnFlow = sf_clone(sf)
                walk_post_spawn_caller_mutation(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), known, else_sf, jumps)
                sf_merge_from(then_sf, else_sf)
            else:
                sf_merge_from(then_sf, sf)
            sf.pt = then_sf.pt
            sf.ro = then_sf.ro
            sf.tk = then_sf.tk
            sf.locked = then_sf.locked
        elif tag == {{T:StmtKind.while_stmt}}:
            iterate_loop_to_fixpoint(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), known, sf, jumps)
        elif tag == {{T:StmtKind.for_stmt}}:
            iterate_loop_to_fixpoint(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), known, sf, jumps)
        elif tag == {{T:StmtKind.break_stmt}} or tag == {{T:StmtKind.continue_stmt}}:
            jumps.append(sf_clone(sf))

def check_no_post_spawn_caller_mutation(ck: Ck, a: Ast, stmts: int, ps: int) -> None:
    known: Map2 = Map2()
    sf: SpawnFlow = SpawnFlow()
    if ps >= 0:
        for i in range(pky(ps)):
            p: int = stmt_at(a, ps, i)
            psym: int = sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]))
            pt: int = type_expr_to_type(ck, a, a.n[p + {{O:Param.type_expr}}])
            m2_put(known, 0, psym, pt)
            if is_shared_type(ck, pt):
                ilm_set_one(sf.pt, psym, p)
    jumps: list[SpawnFlow] = []
    walk_post_spawn_caller_mutation(ck, a, stmts, known, sf, jumps)

# `checkFunctionBody`
def check_function_body(ck: Ck, a: Ast, fd: int) -> None:
    gl: int = sl_at(a, fd, {{O:FuncDef.globals}})
    for gi in range(pky(gl)):
        gv: int = pk(a.l[pkx(gl) + gi * 2], a.l[pkx(gl) + gi * 2 + 1])
        gs: int = sym_of(ck, a, gv)
        if m2_get(ck.globs, 0, gs) < 0:
            mp(ck, "'global ")
            mp_sym(ck, gs)
            mp(ck, "': there is no module-level variable named '")
            mp_sym(ck, gs)
            mp(ck, "' (declare it at module level with a type: '")
            mp_sym(ck, gs)
            mp(ck, ": <type> = ...')")
            raise mk_fail(ck, "UndefinedVariable")
    scope: int = sc_new(ck, -1, False)
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    fd_sym: int = sym_of(ck, a, pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1]))
    is_spawn_target: bool = m2_get(ck.spawn_targets, 0, fd_sym) >= 0
    sh_sym: list[int] = []
    sh_ty: list[int] = []
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        pt: int = type_expr_to_type(ck, a, a.n[p + {{O:Param.type_expr}}])
        psym_b: int = sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]))
        sc_declare(ck, scope, psym_b, pt)
        if is_spawn_target and is_shared_type(ck, pt):
            sh_sym.append(psym_b)
            sh_ty.append(pt)
    body: int = sl_at(a, fd, {{O:FuncDef.body}})
    if ck.strict_spawn_shared and len(sh_sym) > 0:
        check_no_spawn_shared_mutation(ck, a, fd_sym, body, sh_sym, sh_ty)
    if ck.strict_spawn_shared:
        check_no_post_spawn_caller_mutation(ck, a, body, ps)
    ret: int = type_expr_to_type(ck, a, a.n[fd + {{O:FuncDef.return_type}}])
    fx: Fx = Fx(scope, ret, a.n[fd + {{O:FuncDef.is_async}}] != 0)
    fx.fn_path = sym_to_str(ck, fd_sym)
    cae: int = m2_get(ck.cls_alias_by_fn, 0, fd_sym)
    if cae >= 0:
        fx.cls_alias = ck.cls_alias_by_fn.vv[cae]
    check_block(ck, a, fx, body)
    if ret != 4 and not always_returns(a, body):
        mp(ck, "function '")
        mp_sref(ck, a, pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1]))
        mp(ck, "' does not return a value on all paths")
        raise mk_fail(ck, "MissingReturn")

def cap_resolve_class_cd(ck: Ck, a: Ast, e: int, cls_defs: Map2) -> int:
    if a.n[e] == {{T:Expr.identifier}}:
        nm: int = sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2]))
        ce: int = m2_get(cls_defs, 0, nm)
        if ce >= 0:
            return cls_defs.vv[ce]
        fe: int = m2_get(ck.fimp, 0, nm)
        if fe >= 0:
            ce2: int = m2_get(cls_defs, 0, ck.fimp.vv[fe])
            if ce2 >= 0:
                return cls_defs.vv[ce2]
        return -1
    if a.n[e] == {{T:Expr.attribute}}:
        raw: list[int] = []
        if not flatten_dotted(ck, a, e, raw) or len(raw) < 2:
            return -1
        segs: list[int] = subst_alias(ck, raw)
        mangled: int = join_syms(ck, segs, len(segs), 95)
        ce3: int = m2_get(cls_defs, 0, mangled)
        if ce3 >= 0:
            return cls_defs.vv[ce3]
    return -1

def cap_global_sym(ck: Ck, owner_sym: int, attr_sym: int) -> int:
    return sym_lit(ck, "__nox_cls_" + sym_to_str(ck, owner_sym) + "_" + sym_to_str(ck, attr_sym))

def cap_walk_stmts(ck: Ck, a: Ast, body: int, cls_defs: Map2, assigned: Map2) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}}:
            tg: int = a.n[pay + {{O:Assign.target}}]
            if a.n[tg] == {{T:Expr.attribute}}:
                at: int = a.n[tg + 1]
                cd: int = cap_resolve_class_cd(ck, a, a.n[at + {{O:Attribute.obj}}], cls_defs)
                if cd >= 0:
                    attr_sr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
                    kds: int = sl_at(a, cd, {{O:ClassDef.consts}})
                    for ki in range(pky(kds)):
                        kd: int = stmt_at(a, kds, ki)
                        knm: int = pk(a.n[kd + {{O:ConstDecl.name}}], a.n[kd + {{O:ConstDecl.name}} + 1])
                        if sref_eq_ref(a, knm, attr_sr):
                            osym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
                            if a.n[kd + {{O:ConstDecl.owner}}] != {{NONE}}:
                                osym = sym_of(ck, a, pk(a.n[kd + {{O:ConstDecl.owner}}], a.n[kd + {{O:ConstDecl.owner}} + 1]))
                            m2_put(assigned, 0, cap_global_sym(ck, osym, sym_of(ck, a, knm)), 1)
                            break
        elif tag == {{T:StmtKind.if_stmt}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), cls_defs, assigned)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                cap_walk_stmts(ck, a, sl_at(a, a.l[pkx(ecs) + ei], {{O:ElifClause.body}}), cls_defs, assigned)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                cap_walk_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.while_stmt}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.for_stmt}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.try_stmt}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), cls_defs, assigned)
            txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for ti in range(pky(txs)):
                cap_walk_stmts(ck, a, sl_at(a, a.l[pkx(txs) + ti], {{O:ExceptClause.body}}), cls_defs, assigned)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                cap_walk_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.with_stmt}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.func_def}}:
            cap_walk_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), cls_defs, assigned)
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                cap_walk_stmts(ck, a, sl_at(a, stmt_at(a, ms, mi), {{O:FuncDef.body}}), cls_defs, assigned)

def class_attr_promote_run(ck: Ck, a: Ast, body: int) -> None:
    any_ca: bool = False
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] == {{T:StmtKind.var_decl}} and a.n[a.n[kn + 1] + {{O:VarDecl.class_attr}}] >= 0:
            any_ca = True
            break
    if not any_ca:
        return
    cls_defs: Map2 = Map2()
    for i2 in range(pky(body)):
        st2: int = stmt_at(a, body, i2)
        kn2: int = a.n[st2 + {{O:Stmt.kind}}]
        if a.n[kn2] == {{T:StmtKind.class_def}}:
            cd: int = a.n[kn2 + 1]
            m2_put(cls_defs, 0, sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1])), cd)
    assigned: Map2 = Map2()
    cap_walk_stmts(ck, a, body, cls_defs, assigned)
    for i3 in range(pky(body)):
        st3: int = stmt_at(a, body, i3)
        kn3: int = a.n[st3 + {{O:Stmt.kind}}]
        if a.n[kn3] == {{T:StmtKind.class_def}}:
            cd3: int = a.n[kn3 + 1]
            kds: int = sl_at(a, cd3, {{O:ClassDef.consts}})
            csym3: int = sym_of(ck, a, pk(a.n[cd3 + {{O:ClassDef.name}}], a.n[cd3 + {{O:ClassDef.name}} + 1]))
            for ki in range(pky(kds)):
                kd: int = stmt_at(a, kds, ki)
                osym3: int = csym3
                if a.n[kd + {{O:ConstDecl.owner}}] != {{NONE}}:
                    osym3 = sym_of(ck, a, pk(a.n[kd + {{O:ConstDecl.owner}}], a.n[kd + {{O:ConstDecl.owner}} + 1]))
                ksym3: int = sym_of(ck, a, pk(a.n[kd + {{O:ConstDecl.name}}], a.n[kd + {{O:ConstDecl.name}} + 1]))
                if m2_get(assigned, 0, cap_global_sym(ck, osym3, ksym3)) >= 0:
                    a.n[kd + {{O:ConstDecl.promoted}}] = 1
        elif a.n[kn3] == {{T:StmtKind.var_decl}}:
            vd3: int = a.n[kn3 + 1]
            if a.n[vd3 + {{O:VarDecl.class_attr}}] >= 0:
                vsym3: int = sym_of(ck, a, pk(a.n[vd3 + {{O:VarDecl.name}}], a.n[vd3 + {{O:VarDecl.name}} + 1]))
                if m2_get(assigned, 0, vsym3) < 0:
                    m2_put(ck.skip_vdecl, 0, st3, 1)

# `collectModuleGlobals`: üst-düzey `var_decl`ların bildirilen tipleri (+ değişmez tamsayı sabitleri). `__infer` bildirimleri terfi etmez.
def collect_module_globals(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        if m2_get(ck.skip_vdecl, 0, st) >= 0:
            continue
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.var_decl}}:
            continue
        v: int = a.n[kn + 1]
        te: int = a.n[v + {{O:VarDecl.type_expr}}]
        if a.n[te] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[te + 1], a.n[te + 2]), "__infer"):
            continue
        declared: int = type_expr_to_type(ck, a, te)
        nm: int = pk(a.n[v + {{O:VarDecl.name}}], a.n[v + {{O:VarDecl.name}} + 1])
        sym: int = sym_of(ck, a, nm)
        m2_put(ck.globs, 0, sym, declared)
        if declared == 0:
            val: int = a.n[v + {{O:VarDecl.value}}]
            if a.n[val] == {{T:Expr.int_lit}}:
                m2_put(ck.iconsts, 0, sym, a.n[val + 1])
            elif a.n[val] == {{T:Expr.unary}}:
                up: int = a.n[val + 1]
                if a.n[up + {{O:Unary.op}}] == {{E:UnaryOp.neg}} and a.n[a.n[up + {{O:Unary.operand}}]] == {{T:Expr.int_lit}}:
                    m2_put(ck.iconsts, 0, sym, 0 - a.n[a.n[up + {{O:Unary.operand}}] + 1])
    # yeniden atanan (modülün herhangi bir yerinde, muhafazakâr) adlar sabit değildir
    for e in range(len(ck.iconsts.k1)):
        if ck.iconsts.dead[e] == 0:
            nsym: int = ck.iconsts.k2[e]
            tt: TT = ck.tt
            if stmts_assign_name_sym(a, body, tt, nsym):
                ck.iconsts.dead[e] = 1
                ck.iconsts.live = ck.iconsts.live - 1

# `stmts_assign_name`in SymbolId ile çağrılan biçimi (bayt aralığına çevirir).
def stmts_assign_name_sym(a: Ast, body: int, tt: TT, sym: int) -> bool:
    xs: list[int] = []
    o: int = tt.so[sym]
    for i in range(tt.sl[sym]):
        xs.append(tt.sb[o + i])
    return stmts_assign_name_ints(a, body, xs)

def sref_is_ints(a: Ast, v: int, xs: list[int]) -> bool:
    x: int = pkx(v)
    ln: int = pky(v)
    if x >= 0:
        ln = ln - x
    if ln != len(xs):
        return False
    for i in range(ln):
        if sref_byte(a, v, i) != xs[i]:
            return False
    return True

def stmts_assign_name_ints(a: Ast, s: int, xs: list[int]) -> bool:
    cnt: int = pky(s)
    for i in range(cnt):
        st: int = a.l[pkx(s) + i]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}}:
            tg: int = a.n[pay + {{O:Assign.target}}]
            if a.n[tg] == {{T:Expr.identifier}} and sref_is_ints(a, pk(a.n[tg + 1], a.n[tg + 2]), xs):
                return True
        elif tag == {{T:StmtKind.if_stmt}}:
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:IfStmt.then_body}}), xs):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                if stmts_assign_name_ints(a, sl_at(a, a.l[pkx(ecs) + j], {{O:ElifClause.body}}), xs):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                if stmts_assign_name_ints(a, sl_at(a, pay, {{O:IfStmt.else_body}}), xs):
                    return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:WhileStmt.body}}), xs):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if sref_is_ints(a, pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1]), xs):
                return True
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:ForStmt.body}}), xs):
                return True
        elif tag == {{T:StmtKind.func_def}}:
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:FuncDef.body}}), xs):
                return True
        elif tag == {{T:StmtKind.class_def}}:
            cms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for q in range(pky(cms)):
                if stmts_assign_name_ints(a, sl_at(a, a.l[pkx(cms) + q], {{O:FuncDef.body}}), xs):
                    return True
        elif tag == {{T:StmtKind.try_stmt}}:
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:TryStmt.try_body}}), xs):
                return True
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                if stmts_assign_name_ints(a, sl_at(a, a.l[pkx(exs) + k], {{O:ExceptClause.body}}), xs):
                    return True
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                if stmts_assign_name_ints(a, sl_at(a, pay, {{O:TryStmt.finally_body}}), xs):
                    return True
        elif tag == {{T:StmtKind.with_stmt}}:
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:WithStmt.body}}), xs):
                return True
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if stmts_assign_name_ints(a, sl_at(a, pay, {{O:LowLevelStmt.body}}), xs):
                return True
    return False

# `nonlocal_desugar` (`compiler/typecheck/nonlocal_desugar.zig`): `nonlocal` bildiren değişkenleri sahip işlevde `__nl_x: list[T] = [x]` hücresine çevirir.
def nl_declared_stmts(ck: Ck, a: Ast, s: int, out: Map2) -> None:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.var_decl}}:
            m2_put(out, 0, sym_of(ck, a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1])), 1)
        elif tag == {{T:StmtKind.func_def}}:
            m2_put(out, 0, sym_of(ck, a, pk(a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1])), 1)
        elif tag == {{T:StmtKind.for_stmt}}:
            m2_put(out, 0, sym_of(ck, a, pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1])), 1)
            nl_declared_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), out)
        elif tag == {{T:StmtKind.if_stmt}}:
            nl_declared_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), out)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                nl_declared_stmts(ck, a, sl_at(a, a.l[pkx(ecs) + j], {{O:ElifClause.body}}), out)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                nl_declared_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), out)
        elif tag == {{T:StmtKind.while_stmt}}:
            nl_declared_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), out)
        elif tag == {{T:StmtKind.try_stmt}}:
            nl_declared_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), out)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                ec: int = a.l[pkx(exs) + k]
                if a.n[ec + {{O:ExceptClause.bind_name}}] != {{NONE}}:
                    m2_put(out, 0, sym_of(ck, a, pk(a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1])), 1)
                nl_declared_stmts(ck, a, sl_at(a, ec, {{O:ExceptClause.body}}), out)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                nl_declared_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), out)
        elif tag == {{T:StmtKind.with_stmt}}:
            if a.n[pay + {{O:WithStmt.binding}}] != {{NONE}}:
                m2_put(out, 0, sym_of(ck, a, pk(a.n[pay + {{O:WithStmt.binding}}], a.n[pay + {{O:WithStmt.binding}} + 1])), 1)
            nl_declared_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), out)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            nl_declared_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), out)

def nl_declared(ck: Ck, a: Ast, fd: int, out: Map2) -> None:
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        m2_put(out, 0, sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])), 1)
    nl_declared_stmts(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), out)
    nls: int = sl_at(a, fd, {{O:FuncDef.nonlocals}})
    for ni in range(pky(nls)):
        m2_remove(out, 0, sym_of(ck, a, pk(a.l[pkx(nls) + ni * 2], a.l[pkx(nls) + ni * 2 + 1])))

def nl_nested_defs(a: Ast, s: int, out: list[int]) -> None:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            out.append(pay)
        elif tag == {{T:StmtKind.if_stmt}}:
            nl_nested_defs(a, sl_at(a, pay, {{O:IfStmt.then_body}}), out)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                nl_nested_defs(a, sl_at(a, a.l[pkx(ecs) + j], {{O:ElifClause.body}}), out)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                nl_nested_defs(a, sl_at(a, pay, {{O:IfStmt.else_body}}), out)
        elif tag == {{T:StmtKind.while_stmt}}:
            nl_nested_defs(a, sl_at(a, pay, {{O:WhileStmt.body}}), out)
        elif tag == {{T:StmtKind.for_stmt}}:
            nl_nested_defs(a, sl_at(a, pay, {{O:ForStmt.body}}), out)
        elif tag == {{T:StmtKind.try_stmt}}:
            nl_nested_defs(a, sl_at(a, pay, {{O:TryStmt.try_body}}), out)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                nl_nested_defs(a, sl_at(a, a.l[pkx(exs) + k], {{O:ExceptClause.body}}), out)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                nl_nested_defs(a, sl_at(a, pay, {{O:TryStmt.finally_body}}), out)
        elif tag == {{T:StmtKind.with_stmt}}:
            nl_nested_defs(a, sl_at(a, pay, {{O:WithStmt.body}}), out)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            nl_nested_defs(a, sl_at(a, pay, {{O:LowLevelStmt.body}}), out)

def nl_unresolved(ck: Ck, a: Ast, fd: int, out: Map2, out_syms: list[int]) -> None:
    tmp_m: Map2 = Map2()
    tmp_s: list[int] = []
    nls: int = sl_at(a, fd, {{O:FuncDef.nonlocals}})
    for i in range(pky(nls)):
        nsym: int = sym_of(ck, a, pk(a.l[pkx(nls) + i * 2], a.l[pkx(nls) + i * 2 + 1]))
        if m2_get(tmp_m, 0, nsym) < 0:
            m2_put(tmp_m, 0, nsym, 1)
            tmp_s.append(nsym)
    kids: list[int] = []
    nl_nested_defs(a, sl_at(a, fd, {{O:FuncDef.body}}), kids)
    for k in kids:
        nl_unresolved(ck, a, k, tmp_m, tmp_s)
    own: Map2 = Map2()
    nl_declared(ck, a, fd, own)
    for s in tmp_s:
        if m2_get(own, 0, s) < 0 and m2_get(out, 0, s) < 0:
            m2_put(out, 0, s, 1)
            out_syms.append(s)

def nl_find_type_in(ck: Ck, a: Ast, s: int, xsym: int) -> int:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.var_decl}}:
            if sym_of(ck, a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1])) == xsym:
                return a.n[pay + {{O:VarDecl.type_expr}}]
        elif tag == {{T:StmtKind.if_stmt}}:
            t: int = nl_find_type_in(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), xsym)
            if t >= 0:
                return t
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                t = nl_find_type_in(ck, a, sl_at(a, a.l[pkx(ecs) + j], {{O:ElifClause.body}}), xsym)
                if t >= 0:
                    return t
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                t = nl_find_type_in(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), xsym)
                if t >= 0:
                    return t
        elif tag == {{T:StmtKind.while_stmt}}:
            t2: int = nl_find_type_in(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), xsym)
            if t2 >= 0:
                return t2
        elif tag == {{T:StmtKind.for_stmt}}:
            t3: int = nl_find_type_in(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), xsym)
            if t3 >= 0:
                return t3
        elif tag == {{T:StmtKind.try_stmt}}:
            t4: int = nl_find_type_in(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), xsym)
            if t4 >= 0:
                return t4
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                t4 = nl_find_type_in(ck, a, sl_at(a, a.l[pkx(exs) + k], {{O:ExceptClause.body}}), xsym)
                if t4 >= 0:
                    return t4
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                t4 = nl_find_type_in(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), xsym)
                if t4 >= 0:
                    return t4
        elif tag == {{T:StmtKind.with_stmt}}:
            t5: int = nl_find_type_in(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), xsym)
            if t5 >= 0:
                return t5
    return -1

def nl_find_type(ck: Ck, a: Ast, fd: int, xsym: int) -> int:
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])) == xsym:
            return a.n[p + {{O:Param.type_expr}}]
    t: int = nl_find_type_in(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), xsym)
    if t < 0:
        return -1
    if a.n[t] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[t + 1], a.n[t + 2]), "__infer"):
        return -1
    return t

def nl_list_of(a: Ast, te: int) -> int:
    lsr: int = syn(a, "list")
    asl: int = ast_expr_list(a, [te])
    return mk_TypeExpr_generic(a, mk_Generic(a, pkx(lsr), pky(lsr), pkx(asl), pky(asl)))

def nl_comp_shadows(ck: Ck, a: Ast, clauses: int, xsym: int) -> bool:
    for i in range(pky(clauses)):
        cl: int = stmt_at(a, clauses, i)
        if a.n[cl] == {{T:CompClause.for_clause}}:
            cpay: int = a.n[cl + 1]
            if sym_of(ck, a, pk(a.n[cpay + {{O:CompForClause.var_name}}], a.n[cpay + {{O:CompForClause.var_name}} + 1])) == xsym:
                return True
    return False

def nl_rewrite_expr(ck: Ck, a: Ast, e: int, xsym: int, cell_s: str) -> None:
    if e < 0:
        return
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        if sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2])) == xsym:
            a.n[e] = {{T:Expr.index}}
            a.n[e + 1] = mk_Index(a, mk_ident_node(a, cell_s), mk_Expr_int_lit(a, 0))
        return
    if tag == {{T:Expr.unary}}:
        nl_rewrite_expr(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}], xsym, cell_s)
        return
    if tag == {{T:Expr.kwarg}}:
        nl_rewrite_expr(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}], xsym, cell_s)
        return
    if tag == {{T:Expr.ternary}}:
        t: int = a.n[e + 1]
        nl_rewrite_expr(ck, a, a.n[t + {{O:Ternary.cond}}], xsym, cell_s)
        nl_rewrite_expr(ck, a, a.n[t + {{O:Ternary.then_expr}}], xsym, cell_s)
        nl_rewrite_expr(ck, a, a.n[t + {{O:Ternary.else_expr}}], xsym, cell_s)
        return
    if tag == {{T:Expr.binary}}:
        b: int = a.n[e + 1]
        nl_rewrite_expr(ck, a, a.n[b + {{O:Binary.left}}], xsym, cell_s)
        nl_rewrite_expr(ck, a, a.n[b + {{O:Binary.right}}], xsym, cell_s)
        return
    if tag == {{T:Expr.call}}:
        c: int = a.n[e + 1]
        nl_rewrite_expr(ck, a, a.n[c + {{O:Call.callee}}], xsym, cell_s)
        args: int = sl_at(a, c, {{O:Call.args}})
        for i in range(pky(args)):
            nl_rewrite_expr(ck, a, a.l[pkx(args) + i], xsym, cell_s)
        return
    if tag == {{T:Expr.attribute}}:
        nl_rewrite_expr(ck, a, a.n[a.n[e + 1] + {{O:Attribute.obj}}], xsym, cell_s)
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        cls: int = sl_at(a, lc, {{O:ListComp.clauses}})
        if nl_comp_shadows(ck, a, cls, xsym):
            return
        nl_rewrite_expr(ck, a, a.n[lc + {{O:ListComp.elem}}], xsym, cell_s)
        for i in range(pky(cls)):
            cl: int = stmt_at(a, cls, i)
            if a.n[cl] == {{T:CompClause.for_clause}}:
                nl_rewrite_expr(ck, a, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], xsym, cell_s)
            elif a.n[cl] == {{T:CompClause.if_clause}}:
                nl_rewrite_expr(ck, a, a.n[cl + 1], xsym, cell_s)
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        cls2: int = sl_at(a, dc, {{O:DictComp.clauses}})
        if nl_comp_shadows(ck, a, cls2, xsym):
            return
        nl_rewrite_expr(ck, a, a.n[dc + {{O:DictComp.key}}], xsym, cell_s)
        nl_rewrite_expr(ck, a, a.n[dc + {{O:DictComp.value}}], xsym, cell_s)
        for i2 in range(pky(cls2)):
            cl2: int = stmt_at(a, cls2, i2)
            if a.n[cl2] == {{T:CompClause.for_clause}}:
                nl_rewrite_expr(ck, a, a.n[a.n[cl2 + 1] + {{O:CompForClause.iterable}}], xsym, cell_s)
            elif a.n[cl2] == {{T:CompClause.if_clause}}:
                nl_rewrite_expr(ck, a, a.n[cl2 + 1], xsym, cell_s)
        return
    if tag == {{T:Expr.lambda}}:
        lam: int = a.n[e + 1]
        lps: int = sl_at(a, lam, {{O:Lambda.params}})
        for i3 in range(pky(lps)):
            if sym_of(ck, a, pk(a.l[pkx(lps) + i3 * 2], a.l[pkx(lps) + i3 * 2 + 1])) == xsym:
                return
        nl_rewrite_expr(ck, a, a.n[lam + {{O:Lambda.body}}], xsym, cell_s)
        return
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[e + 1]
        nl_rewrite_expr(ck, a, a.n[sl + {{O:Slice.obj}}], xsym, cell_s)
        if a.n[sl + {{O:Slice.lo}}] != {{NONE}}:
            nl_rewrite_expr(ck, a, a.n[sl + {{O:Slice.lo}}], xsym, cell_s)
        if a.n[sl + {{O:Slice.hi}}] != {{NONE}}:
            nl_rewrite_expr(ck, a, a.n[sl + {{O:Slice.hi}}], xsym, cell_s)
        if a.n[sl + {{O:Slice.step}}] != {{NONE}}:
            nl_rewrite_expr(ck, a, a.n[sl + {{O:Slice.step}}], xsym, cell_s)
        return
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        nl_rewrite_expr(ck, a, a.n[ix + {{O:Index.obj}}], xsym, cell_s)
        nl_rewrite_expr(ck, a, a.n[ix + {{O:Index.index}}], xsym, cell_s)
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        its: int = pk(a.n[e + 1], a.n[e + 2])
        for i4 in range(pky(its)):
            nl_rewrite_expr(ck, a, a.l[pkx(its) + i4], xsym, cell_s)
        return
    if tag == {{T:Expr.dict_lit}}:
        prs: int = pk(a.n[e + 1], a.n[e + 2])
        for i5 in range(pky(prs)):
            pr: int = a.l[pkx(prs) + i5]
            nl_rewrite_expr(ck, a, a.n[pr + {{O:DictPair.key}}], xsym, cell_s)
            nl_rewrite_expr(ck, a, a.n[pr + {{O:DictPair.value}}], xsym, cell_s)
        return
    if tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        nl_rewrite_expr(ck, a, a.n[e + 1], xsym, cell_s)
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[e + 1]
        ga: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for i6 in range(pky(ga)):
            nl_rewrite_expr(ck, a, a.l[pkx(ga) + i6], xsym, cell_s)

def nl_rewrite_stmts(ck: Ck, a: Ast, s: int, xsym: int, cell_s: str, te: int) -> None:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            nl_rewrite_expr(ck, a, pay, xsym, cell_s)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay != {{NONE}}:
                nl_rewrite_expr(ck, a, pay, xsym, cell_s)
        elif tag == {{T:StmtKind.var_decl}}:
            nl_rewrite_expr(ck, a, a.n[pay + {{O:VarDecl.value}}], xsym, cell_s)
            if sym_of(ck, a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1])) == xsym:
                it_sl: int = ast_expr_list(a, [a.n[pay + {{O:VarDecl.value}}]])
                csr: int = syn(a, cell_s)
                a.n[pay + {{O:VarDecl.name}}] = pkx(csr)
                a.n[pay + {{O:VarDecl.name}} + 1] = pky(csr)
                a.n[pay + {{O:VarDecl.type_expr}}] = nl_list_of(a, te)
                a.n[pay + {{O:VarDecl.value}}] = mk_Expr_list_lit(a, pkx(it_sl), pky(it_sl))
        elif tag == {{T:StmtKind.assign}}:
            nl_rewrite_expr(ck, a, a.n[pay + {{O:Assign.target}}], xsym, cell_s)
            nl_rewrite_expr(ck, a, a.n[pay + {{O:Assign.value}}], xsym, cell_s)
        elif tag == {{T:StmtKind.if_stmt}}:
            nl_rewrite_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}], xsym, cell_s)
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), xsym, cell_s, te)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                ec: int = a.l[pkx(ecs) + j]
                nl_rewrite_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}], xsym, cell_s)
                nl_rewrite_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}), xsym, cell_s, te)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.while_stmt}}:
            nl_rewrite_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}], xsym, cell_s)
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.for_stmt}}:
            if sym_of(ck, a, pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1])) == xsym:
                mp(ck, "the nonlocal variable '")
                mp_sym(ck, xsym)
                mp(ck, "' cannot also be a 'for' loop variable")
                raise mk_fail(ck, "TypeMismatch")
            nl_rewrite_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}], xsym, cell_s)
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.func_def}}:
            fsym: int = sym_of(ck, a, pk(a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1]))
            own_n: Map2 = Map2()
            nl_declared(ck, a, pay, own_n)
            if fsym == xsym or m2_get(own_n, 0, xsym) >= 0:
                continue
            nls: int = sl_at(a, pay, {{O:FuncDef.nonlocals}})
            kept: list[int] = []
            for ni in range(pky(nls)):
                nsr: int = pk(a.l[pkx(nls) + ni * 2], a.l[pkx(nls) + ni * 2 + 1])
                if sym_of(ck, a, nsr) != xsym:
                    kept.append(pkx(nsr))
                    kept.append(pky(nsr))
            kst: int = len(a.l)
            for kv in kept:
                a.l.append(kv)
            a.n[pay + {{O:FuncDef.nonlocals}}] = kst
            a.n[pay + {{O:FuncDef.nonlocals}} + 1] = len(kept) // 2
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.try_stmt}}:
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), xsym, cell_s, te)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                nl_rewrite_stmts(ck, a, sl_at(a, a.l[pkx(exs) + k], {{O:ExceptClause.body}}), xsym, cell_s, te)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.with_stmt}}:
            nl_rewrite_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}], xsym, cell_s)
            nl_rewrite_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), xsym, cell_s, te)
        elif tag == {{T:StmtKind.defer_stmt}}:
            dc: int = a.n[pay]
            nl_rewrite_expr(ck, a, a.n[dc + {{O:Call.callee}}], xsym, cell_s)
            dargs: int = sl_at(a, dc, {{O:Call.args}})
            for di in range(pky(dargs)):
                nl_rewrite_expr(ck, a, a.l[pkx(dargs) + di], xsym, cell_s)

def nl_convert_cell(ck: Ck, a: Ast, fd: int, xsym: int, te: int) -> None:
    x_s: str = sym_to_str(ck, xsym)
    cell_s: str = "__nl_" + x_s
    is_param: bool = False
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])) == xsym:
            is_param = True
    nl_rewrite_stmts(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), xsym, cell_s, te)
    if is_param:
        bsl: int = sl_at(a, fd, {{O:FuncDef.body}})
        bn: int = pky(bsl)
        first_line: int = a.n[fd + {{O:FuncDef.line}}]
        first_span: int = -1
        if bn > 0:
            fst: int = stmt_at(a, bsl, 0)
            first_line = a.n[fst + {{O:Stmt.line}}]
            first_span = a.n[fst + {{O:Stmt.span}}]
        csr: int = syn(a, cell_s)
        xsr: int = syn(a, x_s)
        it_sl: int = ast_expr_list(a, [mk_Expr_identifier(a, pkx(xsr), pky(xsr))])
        vd: int = mk_VarDecl(a, pkx(csr), pky(csr), nl_list_of(a, te), mk_Expr_list_lit(a, pkx(it_sl), pky(it_sl)), 0, 0, 0, 0)
        ns_id: int = mk_Stmt(a, mk_StmtKind_var_decl(a, vd), first_line, first_span)
        nb_items: list[int] = [ns_id]
        for bi in range(bn):
            nb_items.append(stmt_at(a, bsl, bi))
        nbsl: int = ast_stmt_list(a, nb_items)
        a.n[fd + {{O:FuncDef.body}}] = pkx(nbsl)
        a.n[fd + {{O:FuncDef.body}} + 1] = pky(nbsl)

def nl_process_func(ck: Ck, a: Ast, fd: int, nested: bool) -> None:
    kids: list[int] = []
    nl_nested_defs(a, sl_at(a, fd, {{O:FuncDef.body}}), kids)
    unres_m: Map2 = Map2()
    unres_s: list[int] = []
    for k in kids:
        nl_unresolved(ck, a, k, unres_m, unres_s)
    if not nested:
        nls: int = sl_at(a, fd, {{O:FuncDef.nonlocals}})
        for ni in range(pky(nls)):
            nsym: int = sym_of(ck, a, pk(a.l[pkx(nls) + ni * 2], a.l[pkx(nls) + ni * 2 + 1]))
            if m2_get(unres_m, 0, nsym) < 0:
                m2_put(unres_m, 0, nsym, 1)
                unres_s.append(nsym)
    if len(unres_s) > 0:
        own: Map2 = Map2()
        nl_declared(ck, a, fd, own)
        for xsym in unres_s:
            if m2_get(own, 0, xsym) < 0:
                if not nested:
                    mp(ck, "nonlocal '")
                    mp_sym(ck, xsym)
                    mp(ck, "': no binding for it was found in an enclosing function")
                    raise mk_fail(ck, "TypeMismatch")
                continue
            te: int = nl_find_type(ck, a, fd, xsym)
            if te < 0:
                mp(ck, "the nonlocal variable '")
                mp_sym(ck, xsym)
                mp(ck, "' must be declared with an explicit type ('")
                mp_sym(ck, xsym)
                mp(ck, ": T = ...') or be a typed parameter")
                raise mk_fail(ck, "TypeMismatch")
            nl_convert_cell(ck, a, fd, xsym, te)
    for k2 in kids:
        nl_process_func(ck, a, k2, True)

# `generator_desugar` (`compiler/typecheck/generator_desugar.zig`): `yield`/`yield from` tembel jeneratör durum makinesine dönüştürür.
class GdPass:
    uid: int
    line: int
    send_line: int
    uses_send: bool
    owner: str
    ytype: int
    sent_cell: str
    sent_flag: int
    done: str
    closing: str
    thrown_cell: str
    thrown_flag: int
    prelude: list[int]
    fr_pc: list[str]
    fr_sel: list[str]
    fr_loop: list[bool]
    idxs: list[int]
    sc_base: list[int]
    sc_sym: list[int]
    sc_cell: list[str]
    sc_flag: list[int]
    rst_cell: list[str]
    rst_kind: list[int]

    def __init__(self) -> None:
        self.uid = 0
        self.line = 0
        self.send_line = 0
        self.uses_send = False
        self.owner = ""
        self.ytype = -1
        self.sent_cell = ""
        self.sent_flag = 0
        self.done = ""
        self.closing = ""
        self.thrown_cell = ""
        self.thrown_flag = 0
        self.prelude = []
        self.fr_pc = []
        self.fr_sel = []
        self.fr_loop = []
        self.idxs = []
        self.sc_base = []
        self.sc_sym = []
        self.sc_cell = []
        self.sc_flag = []
        self.rst_cell = []
        self.rst_kind = []

def gd_fail(g: GdPass, ck: Ck, msg: str) -> None:
    ck.cur_line = g.line
    mp(ck, msg)
    raise mk_fail(ck, "TypeMismatch")

def gd_is_yield(a: Ast, e: int) -> int:
    if e >= 0 and a.n[e] == {{T:Expr.call}}:
        c: int = a.n[e + 1]
        cal: int = a.n[c + {{O:Call.callee}}]
        args: int = sl_at(a, c, {{O:Call.args}})
        if a.n[cal] == {{T:Expr.identifier}} and pky(args) == 1:
            cv: int = pk(a.n[cal + 1], a.n[cal + 2])
            if sref_eq(a, cv, "__nox_yield"):
                return 1
            if sref_eq(a, cv, "__nox_yield_from"):
                return 2
            if sref_eq(a, cv, "__nox_yield_expr"):
                return 3
    return 0

def gd_list_has_yield(a: Ast, sl: int) -> bool:
    for i in range(pky(sl)):
        if gd_stmt_has_yield(a, stmt_at(a, sl, i)):
            return True
    return False

def gd_stmt_has_yield(a: Ast, st: int) -> bool:
    kn: int = a.n[st + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    if tag == {{T:StmtKind.expr_stmt}}:
        return gd_is_yield(a, pay) != 0
    if tag == {{T:StmtKind.var_decl}}:
        return gd_is_yield(a, a.n[pay + {{O:VarDecl.value}}]) == 3
    if tag == {{T:StmtKind.assign}}:
        return gd_is_yield(a, a.n[pay + {{O:Assign.value}}]) == 3
    if tag == {{T:StmtKind.if_stmt}}:
        if gd_list_has_yield(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
            return True
        ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        for j in range(pky(ecs)):
            if gd_list_has_yield(a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}})):
                return True
        if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}} and gd_list_has_yield(a, sl_at(a, pay, {{O:IfStmt.else_body}})):
            return True
        return False
    if tag == {{T:StmtKind.while_stmt}}:
        return gd_list_has_yield(a, sl_at(a, pay, {{O:WhileStmt.body}}))
    if tag == {{T:StmtKind.for_stmt}}:
        return gd_list_has_yield(a, sl_at(a, pay, {{O:ForStmt.body}}))
    if tag == {{T:StmtKind.try_stmt}}:
        if gd_list_has_yield(a, sl_at(a, pay, {{O:TryStmt.try_body}})):
            return True
        exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
        for k in range(pky(exs)):
            if gd_list_has_yield(a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}})):
                return True
        if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}} and gd_list_has_yield(a, sl_at(a, pay, {{O:TryStmt.finally_body}})):
            return True
        return False
    if tag == {{T:StmtKind.with_stmt}}:
        return gd_list_has_yield(a, sl_at(a, pay, {{O:WithStmt.body}}))
    if tag == {{T:StmtKind.lowlevel_stmt}}:
        return gd_list_has_yield(a, sl_at(a, pay, {{O:LowLevelStmt.body}}))
    return False

def gd_unsupported_yield(g: GdPass, ck: Ck, a: Ast, sl: int) -> None:
    for i in range(pky(sl)):
        st: int = stmt_at(a, sl, i)
        g.line = a.n[st + {{O:Stmt.line}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.try_stmt}}:
            gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}))
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                gd_unsupported_yield(g, ck, a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}))
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}))
        elif tag == {{T:StmtKind.with_stmt}}:
            gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:WithStmt.body}}))
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if gd_stmt_has_yield(a, st):
                gd_fail(g, ck, "'yield' inside 'lowlevel' is not supported in a generator")
        elif tag == {{T:StmtKind.if_stmt}}:
            gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}))
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                gd_unsupported_yield(g, ck, a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}}))
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}))
        elif tag == {{T:StmtKind.while_stmt}}:
            gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:WhileStmt.body}}))
        elif tag == {{T:StmtKind.for_stmt}}:
            gd_unsupported_yield(g, ck, a, sl_at(a, pay, {{O:ForStmt.body}}))

def gd_idx0(a: Ast, cell: str) -> int:
    return mk_Expr_index(a, mk_Index(a, mk_ident_node(a, cell), mk_Expr_int_lit(a, 0)))

def gd_call1(a: Ast, name: str, arg: int) -> int:
    asl: int = ast_expr_list(a, [arg])
    return mk_Expr_call(a, mk_Call(a, mk_ident_node(a, name), pkx(asl), pky(asl), 0, 0, 0, 0, 0, 0))

def gd_call0(a: Ast, name: str) -> int:
    return mk_Expr_call(a, mk_Call(a, mk_ident_node(a, name), 0, 0, 0, 0, 0, 0, 0, 0))

def gd_bin(a: Ast, op: int, l: int, r: int) -> int:
    return mk_Expr_binary(a, mk_Binary(a, op, l, r, 0, 0, 0, 0))

def gd_stmt(g: GdPass, a: Ast, kind: int) -> int:
    return mk_Stmt(a, kind, g.line, -1)

def gd_assign(g: GdPass, a: Ast, target: int, val: int) -> int:
    return gd_stmt(g, a, mk_StmtKind_assign(a, mk_Assign(a, target, val, 0)))

def gd_set_cell(g: GdPass, a: Ast, cell: str, v: int) -> int:
    return gd_assign(g, a, gd_idx0(a, cell), mk_Expr_int_lit(a, v))

def gd_if_stmt(g: GdPass, a: Ast, cond: int, bsl: int) -> int:
    return gd_stmt(g, a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, cond, pkx(bsl), pky(bsl), 0, 0, {{NONE}}, 0, 0, -1, 0)))

def gd_new_name(g: GdPass, base: str) -> str:
    g.uid = g.uid + 1
    return "__g_" + base + "_" + str(g.uid)

def gd_list_of(a: Ast, te: int) -> int:
    lsr: int = syn(a, "list")
    asl: int = ast_expr_list(a, [te])
    return mk_TypeExpr_generic(a, mk_Generic(a, pkx(lsr), pky(lsr), pkx(asl), pky(asl)))

def gd_reg_reset(g: GdPass, cell: str, kind: int) -> None:
    g.rst_cell.append(cell)
    g.rst_kind.append(kind)

def gd_reset_since(g: GdPass, a: Ast, mark: int) -> list[int]:
    out: list[int] = []
    for i in range(mark, len(g.rst_cell)):
        k: int = g.rst_kind[i]
        v: int = mk_Expr_none_lit(a)
        if k == 0:
            v = mk_Expr_int_lit(a, 0)
        elif k == 1:
            v = mk_Expr_bool_lit(a, 0)
        out.append(gd_assign(g, a, gd_idx0(a, g.rst_cell[i]), v))
    return out

def gd_int_cell(g: GdPass, a: Ast, base: str, v: int) -> str:
    name: str = gd_new_name(g, base)
    nsr: int = syn(a, name)
    isr: int = syn(a, "int")
    itsl: int = ast_expr_list(a, [mk_Expr_int_lit(a, v)])
    vd: int = mk_VarDecl(a, pkx(nsr), pky(nsr), gd_list_of(a, mk_TypeExpr_simple(a, pkx(isr), pky(isr))), mk_Expr_list_lit(a, pkx(itsl), pky(itsl)), 0, 0, 0, 0)
    g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd)))
    return name

def gd_bool_cell(g: GdPass, a: Ast, base: str, v: int) -> str:
    name: str = gd_new_name(g, base)
    nsr: int = syn(a, name)
    bsr: int = syn(a, "bool")
    itsl: int = ast_expr_list(a, [mk_Expr_bool_lit(a, v)])
    vd: int = mk_VarDecl(a, pkx(nsr), pky(nsr), gd_list_of(a, mk_TypeExpr_simple(a, pkx(bsr), pky(bsr))), mk_Expr_list_lit(a, pkx(itsl), pky(itsl)), 0, 0, 0, 0)
    g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd)))
    return name

def gd_is_fixed_int_sref(a: Ast, sr: int) -> bool:
    return sref_eq(a, sr, "u8") or sref_eq(a, sr, "u16") or sref_eq(a, sr, "u32") or sref_eq(a, sr, "u64") or sref_eq(a, sr, "i8") or sref_eq(a, sr, "i16") or sref_eq(a, sr, "i32") or sref_eq(a, sr, "i64")

def gd_zero_for(a: Ast, te: int) -> int:
    if a.n[te] != {{T:TypeExpr.simple}}:
        return -1
    sr: int = pk(a.n[te + 1], a.n[te + 2])
    if sref_eq(a, sr, "int"):
        return mk_Expr_int_lit(a, 0)
    if sref_eq(a, sr, "float"):
        return mk_Expr_float_lit(a, 0)
    if sref_eq(a, sr, "bool"):
        return mk_Expr_bool_lit(a, 0)
    if sref_eq(a, sr, "str"):
        esr: int = syn(a, "")
        return mk_Expr_string_lit(a, pkx(esr), pky(esr))
    return -1

def gd_typed_cell(g: GdPass, a: Ast, name: str, t: int) -> tuple[str, int]:
    if a.n[t] == {{T:TypeExpr.func_type}}:
        fbsr: int = syn(a, "__nox_FnBox")
        asl: int = ast_expr_list(a, [t])
        return gd_typed_cell(g, a, name, mk_TypeExpr_generic(a, mk_Generic(a, pkx(fbsr), pky(fbsr), pkx(asl), pky(asl))))
    cell: str = gd_new_name(g, name)
    csr: int = syn(a, cell)
    if a.n[t] == {{T:TypeExpr.generic}}:
        gg: int = a.n[t + 1]
        gsr: int = pk(a.n[gg + {{O:Generic.name}}], a.n[gg + {{O:Generic.name}} + 1])
        if sref_eq(a, gsr, "list") or sref_eq(a, gsr, "dict"):
            lit: int = mk_Expr_dict_lit(a, 0, 0)
            if sref_eq(a, gsr, "list"):
                lit = mk_Expr_list_lit(a, 0, 0)
            itsl: int = ast_expr_list(a, [lit])
            vd_ld: int = mk_VarDecl(a, pkx(csr), pky(csr), gd_list_of(a, t), mk_Expr_list_lit(a, pkx(itsl), pky(itsl)), 0, 0, 0, 0)
            g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd_ld)))
            return (cell, 1)
    z: int = gd_zero_for(a, t)
    if z >= 0:
        itsl2: int = ast_expr_list(a, [z])
        vd_z: int = mk_VarDecl(a, pkx(csr), pky(csr), gd_list_of(a, t), mk_Expr_list_lit(a, pkx(itsl2), pky(itsl2)), 0, 0, 0, 0)
        g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd_z)))
        return (cell, 1)
    if a.n[t] == {{T:TypeExpr.optional}}:
        inner_o: int = a.n[t + 1]
        if gd_zero_for(a, inner_o) >= 0 or (a.n[inner_o] == {{T:TypeExpr.simple}} and gd_is_fixed_int_sref(a, pk(a.n[inner_o + 1], a.n[inner_o + 2]))):
            nn0: str = gd_new_name(g, "none")
            nn0sr: int = syn(a, nn0)
            g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(nn0sr), pky(nn0sr), t, mk_Expr_none_lit(a), 0, 0, 0, 0))))
            sl_sr: int = syn(a, "__nox_Slot")
            iasl: int = ast_expr_list(a, [inner_o])
            slot_te: int = mk_TypeExpr_generic(a, mk_Generic(a, pkx(sl_sr), pky(sl_sr), pkx(iasl), pky(iasl)))
            casl: int = ast_expr_list(a, [mk_ident_node(a, nn0)])
            ctor: int = mk_Expr_generic_construct(a, mk_GenericConstruct(a, pkx(sl_sr), pky(sl_sr), pkx(iasl), pky(iasl), pkx(casl), pky(casl), {{NONE}}, 0))
            itsl3: int = ast_expr_list(a, [ctor])
            vd_s: int = mk_VarDecl(a, pkx(csr), pky(csr), gd_list_of(a, slot_te), mk_Expr_list_lit(a, pkx(itsl3), pky(itsl3)), 0, 0, 0, 0)
            g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd_s)))
            return (cell, 3)
    opt_t: int = t
    is_opt: bool = a.n[t] == {{T:TypeExpr.optional}}
    if not is_opt:
        opt_t = mk_TypeExpr_optional(a, t)
    nn: str = gd_new_name(g, "none")
    nnsr: int = syn(a, nn)
    g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(nnsr), pky(nnsr), opt_t, mk_Expr_none_lit(a), 0, 0, 0, 0))))
    itsl4: int = ast_expr_list(a, [mk_ident_node(a, nn)])
    vd_o: int = mk_VarDecl(a, pkx(csr), pky(csr), gd_list_of(a, opt_t), mk_Expr_list_lit(a, pkx(itsl4), pky(itsl4)), 0, 0, 0, 0)
    g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd_o)))
    if is_opt:
        return (cell, 1)
    return (cell, 2)

def gd_inferred_cell(g: GdPass, a: Ast, name: str, src: int) -> tuple[str, int]:
    cell: str = gd_new_name(g, name)
    csr: int = syn(a, cell)
    inf_sr: int = syn(a, "__infer")
    vd: int = mk_VarDecl(a, pkx(csr), pky(csr), mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr)), gd_call1(a, "__nox_cell_of", src), 0, 0, 0, 0)
    g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, vd)))
    return (cell, 2)

def gd_push_scope(g: GdPass) -> None:
    g.sc_base.append(len(g.sc_sym))

def gd_pop_scope(g: GdPass) -> None:
    b: int = g.sc_base[len(g.sc_base) - 1]
    g.sc_base.pop()
    while len(g.sc_sym) > b:
        g.sc_sym.pop()
        g.sc_cell.pop()
        g.sc_flag.pop()

def gd_bind(g: GdPass, sym: int, cell: str, flag: int) -> None:
    g.sc_sym.append(sym)
    g.sc_cell.append(cell)
    g.sc_flag.append(flag)

def gd_lookup(g: GdPass, sym: int) -> int:
    i: int = len(g.sc_sym)
    while i > 0:
        i = i - 1
        if g.sc_sym[i] == sym:
            if g.sc_flag[i] == 0:
                return -1
            return i
    return -1

def gd_read_of(a: Ast, cell: str, flag: int) -> int:
    if flag == 3:
        vsr: int = syn(a, "v")
        return mk_Expr_attribute(a, mk_Attribute(a, gd_idx0(a, cell), pkx(vsr), pky(vsr)))
    if flag == 2:
        return gd_call1(a, "__nox_get", mk_ident_node(a, cell))
    return gd_idx0(a, cell)

def gd_write_target(a: Ast, cell: str, flag: int) -> int:
    if flag == 3:
        vsr: int = syn(a, "v")
        return mk_Expr_attribute(a, mk_Attribute(a, gd_idx0(a, cell), pkx(vsr), pky(vsr)))
    return gd_idx0(a, cell)

def gd_rename(g: GdPass, ck: Ck, a: Ast, e: int) -> None:
    if e < 0:
        return
    tag: int = a.n[e]
    if tag == {{T:Expr.identifier}}:
        bi: int = gd_lookup(g, sym_of(ck, a, pk(a.n[e + 1], a.n[e + 2])))
        if bi >= 0:
            rep: int = gd_read_of(a, g.sc_cell[bi], g.sc_flag[bi])
            a.n[e] = a.n[rep]
            a.n[e + 1] = a.n[rep + 1]
        return
    if tag == {{T:Expr.unary}}:
        gd_rename(g, ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}])
        return
    if tag == {{T:Expr.kwarg}}:
        gd_rename(g, ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}])
        return
    if tag == {{T:Expr.ternary}}:
        t: int = a.n[e + 1]
        gd_rename(g, ck, a, a.n[t + {{O:Ternary.cond}}])
        gd_rename(g, ck, a, a.n[t + {{O:Ternary.then_expr}}])
        gd_rename(g, ck, a, a.n[t + {{O:Ternary.else_expr}}])
        return
    if tag == {{T:Expr.binary}}:
        b: int = a.n[e + 1]
        gd_rename(g, ck, a, a.n[b + {{O:Binary.left}}])
        gd_rename(g, ck, a, a.n[b + {{O:Binary.right}}])
        return
    if tag == {{T:Expr.call}}:
        c: int = a.n[e + 1]
        cal: int = a.n[c + {{O:Call.callee}}]
        args: int = sl_at(a, c, {{O:Call.args}})
        if a.n[cal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[cal + 1], a.n[cal + 2]), "__nox_sent") and pky(args) == 0:
            if g.sent_flag > 0:
                rep2: int = gd_read_of(a, g.sent_cell, g.sent_flag)
                a.n[e] = a.n[rep2]
                a.n[e + 1] = a.n[rep2 + 1]
            return
        gd_rename(g, ck, a, cal)
        for i in range(pky(args)):
            gd_rename(g, ck, a, stmt_at(a, args, i))
        return
    if tag == {{T:Expr.attribute}}:
        gd_rename(g, ck, a, a.n[a.n[e + 1] + {{O:Attribute.obj}}])
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        gd_rename_comp(g, ck, a, sl_at(a, lc, {{O:ListComp.clauses}}), [a.n[lc + {{O:ListComp.elem}}]])
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        gd_rename_comp(g, ck, a, sl_at(a, dc, {{O:DictComp.clauses}}), [a.n[dc + {{O:DictComp.key}}], a.n[dc + {{O:DictComp.value}}]])
        return
    if tag == {{T:Expr.lambda}}:
        lam: int = a.n[e + 1]
        gd_push_scope(g)
        try:
            lps: int = sl_at(a, lam, {{O:Lambda.params}})
            for i2 in range(pky(lps)):
                gd_bind(g, sym_of(ck, a, pk(a.l[pkx(lps) + i2 * 2], a.l[pkx(lps) + i2 * 2 + 1])), "", 0)
            gd_rename(g, ck, a, a.n[lam + {{O:Lambda.body}}])
        finally:
            gd_pop_scope(g)
        return
    if tag == {{T:Expr.slice}}:
        sl: int = a.n[e + 1]
        gd_rename(g, ck, a, a.n[sl + {{O:Slice.obj}}])
        if a.n[sl + {{O:Slice.lo}}] >= 0:
            gd_rename(g, ck, a, a.n[sl + {{O:Slice.lo}}])
        if a.n[sl + {{O:Slice.hi}}] >= 0:
            gd_rename(g, ck, a, a.n[sl + {{O:Slice.hi}}])
        if a.n[sl + {{O:Slice.step}}] >= 0:
            gd_rename(g, ck, a, a.n[sl + {{O:Slice.step}}])
        return
    if tag == {{T:Expr.index}}:
        ix: int = a.n[e + 1]
        gd_rename(g, ck, a, a.n[ix + {{O:Index.obj}}])
        gd_rename(g, ck, a, a.n[ix + {{O:Index.index}}])
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        its: int = pk(a.n[e + 1], a.n[e + 2])
        for i3 in range(pky(its)):
            gd_rename(g, ck, a, stmt_at(a, its, i3))
        return
    if tag == {{T:Expr.dict_lit}}:
        prs: int = pk(a.n[e + 1], a.n[e + 2])
        for i4 in range(pky(prs)):
            pr: int = stmt_at(a, prs, i4)
            gd_rename(g, ck, a, a.n[pr + {{O:DictPair.key}}])
            gd_rename(g, ck, a, a.n[pr + {{O:DictPair.value}}])
        return
    if tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        gd_rename(g, ck, a, a.n[e + 1])
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[e + 1]
        ga: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for i5 in range(pky(ga)):
            gd_rename(g, ck, a, stmt_at(a, ga, i5))

def gd_rename_comp(g: GdPass, ck: Ck, a: Ast, cls: int, bodies: list[int]) -> None:
    gd_push_scope(g)
    try:
        for i in range(pky(cls)):
            cl: int = stmt_at(a, cls, i)
            if a.n[cl] == {{T:CompClause.for_clause}}:
                cpay: int = a.n[cl + 1]
                gd_rename(g, ck, a, a.n[cpay + {{O:CompForClause.iterable}}])
                gd_bind(g, sym_of(ck, a, pk(a.n[cpay + {{O:CompForClause.var_name}}], a.n[cpay + {{O:CompForClause.var_name}} + 1])), "", 0)
            elif a.n[cl] == {{T:CompClause.if_clause}}:
                gd_rename(g, ck, a, a.n[cl + 1])
        for b in bodies:
            gd_rename(g, ck, a, b)
    finally:
        gd_pop_scope(g)

def gd_jump_resets(g: GdPass, a: Ast, out: list[int]) -> None:
    i: int = len(g.fr_pc)
    while i > 0:
        i = i - 1
        if len(g.fr_pc[i]) > 0:
            out.append(gd_set_cell(g, a, g.fr_pc[i], 0))
        if len(g.fr_sel[i]) > 0:
            out.append(gd_set_cell(g, a, g.fr_sel[i], 0))
        if g.fr_loop[i]:
            return

def gd_plain_block(g: GdPass, ck: Ck, a: Ast, sl: int, top: bool, loop_d: int) -> int:
    gd_push_scope(g)
    out: list[int] = []
    try:
        for i in range(pky(sl)):
            gd_plain_stmt(g, ck, a, stmt_at(a, sl, i), top, loop_d, out, False)
    finally:
        gd_pop_scope(g)
    return ast_stmt_list(a, out)

def gd_plain_stmt(g: GdPass, ck: Ck, a: Ast, st: int, top: bool, loop_d: int, out: list[int], hoist: bool) -> None:
    g.line = a.n[st + {{O:Stmt.line}}]
    kn: int = a.n[st + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    if tag == {{T:StmtKind.expr_stmt}}:
        gd_rename(g, ck, a, pay)
    elif tag == {{T:StmtKind.var_decl}}:
        gd_rename(g, ck, a, a.n[pay + {{O:VarDecl.value}}])
        vsr: int = pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1])
        vsym: int = sym_of(ck, a, vsr)
        vname: str = sym_to_str(ck, vsym)
        vte: int = a.n[pay + {{O:VarDecl.type_expr}}]
        is_inf: bool = a.n[vte] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[vte + 1], a.n[vte + 2]), "__infer")
        if is_inf:
            ex_bi: int = gd_lookup(g, vsym)
            if ex_bi >= 0:
                out.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, gd_write_target(a, g.sc_cell[ex_bi], g.sc_flag[ex_bi]), a.n[pay + {{O:VarDecl.value}}], 0)), g.line, a.n[st + {{O:Stmt.span}}]))
                return
        if hoist:
            b: tuple[str, int] = ("", 0)
            if is_inf:
                b = gd_inferred_cell(g, a, vname, a.n[pay + {{O:VarDecl.value}}])
            else:
                b = gd_typed_cell(g, a, vname, vte)
            gd_bind(g, vsym, b[0], b[1])
            if is_inf:
                out.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, gd_write_target(a, b[0], b[1]), a.n[pay + {{O:VarDecl.value}}], 0)), g.line, a.n[st + {{O:Stmt.span}}]))
            else:
                tmp: str = gd_new_name(g, "tmp")
                tsr: int = syn(a, tmp)
                out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), vte, a.n[pay + {{O:VarDecl.value}}], 0, 0, 0, 0)), g.line, a.n[st + {{O:Stmt.span}}]))
                out.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, gd_write_target(a, b[0], b[1]), mk_ident_node(a, tmp), 0)), g.line, a.n[st + {{O:Stmt.span}}]))
            return
        gd_bind(g, vsym, "", 0)
    elif tag == {{T:StmtKind.assign}}:
        atg: int = a.n[pay + {{O:Assign.target}}]
        if a.n[atg] == {{T:Expr.identifier}}:
            abi: int = gd_lookup(g, sym_of(ck, a, pk(a.n[atg + 1], a.n[atg + 2])))
            if abi >= 0:
                a.n[pay + {{O:Assign.target}}] = gd_write_target(a, g.sc_cell[abi], g.sc_flag[abi])
        else:
            gd_rename(g, ck, a, atg)
        gd_rename(g, ck, a, a.n[pay + {{O:Assign.value}}])
    elif tag == {{T:StmtKind.if_stmt}}:
        gd_rename(g, ck, a, a.n[pay + {{O:IfStmt.cond}}])
        ntb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), top, loop_d)
        a.n[pay + {{O:IfStmt.then_body}}] = pkx(ntb)
        a.n[pay + {{O:IfStmt.then_body}} + 1] = pky(ntb)
        ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        for j in range(pky(ecs)):
            ec: int = stmt_at(a, ecs, j)
            gd_rename(g, ck, a, a.n[ec + {{O:ElifClause.cond}}])
            neb: int = gd_plain_block(g, ck, a, sl_at(a, ec, {{O:ElifClause.body}}), top, loop_d)
            a.n[ec + {{O:ElifClause.body}}] = pkx(neb)
            a.n[ec + {{O:ElifClause.body}} + 1] = pky(neb)
        if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
            nelb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), top, loop_d)
            a.n[pay + {{O:IfStmt.else_body}}] = pkx(nelb)
            a.n[pay + {{O:IfStmt.else_body}} + 1] = pky(nelb)
    elif tag == {{T:StmtKind.while_stmt}}:
        gd_rename(g, ck, a, a.n[pay + {{O:WhileStmt.cond}}])
        nwb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), top, loop_d + 1)
        a.n[pay + {{O:WhileStmt.body}}] = pkx(nwb)
        a.n[pay + {{O:WhileStmt.body}} + 1] = pky(nwb)
    elif tag == {{T:StmtKind.for_stmt}}:
        gd_rename(g, ck, a, a.n[pay + {{O:ForStmt.iterable}}])
        gd_push_scope(g)
        try:
            gd_bind(g, sym_of(ck, a, pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1])), "", 0)
            nfb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:ForStmt.body}}), top, loop_d + 1)
            a.n[pay + {{O:ForStmt.body}}] = pkx(nfb)
            a.n[pay + {{O:ForStmt.body}} + 1] = pky(nfb)
        finally:
            gd_pop_scope(g)
    elif tag == {{T:StmtKind.break_stmt}} or tag == {{T:StmtKind.continue_stmt}}:
        if top and loop_d == 0:
            gd_jump_resets(g, a, out)
    elif tag == {{T:StmtKind.return_stmt}}:
        if top:
            if pay >= 0:
                gd_fail(g, ck, "a generator ('yield') cannot 'return' a value")
            a.n[kn + 1] = mk_Expr_none_lit(a)
        elif pay >= 0:
            gd_rename(g, ck, a, pay)
    elif tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
        gd_rename(g, ck, a, pay)
    elif tag == {{T:StmtKind.try_stmt}}:
        nttb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), top, loop_d)
        a.n[pay + {{O:TryStmt.try_body}}] = pkx(nttb)
        a.n[pay + {{O:TryStmt.try_body}} + 1] = pky(nttb)
        exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
        for k in range(pky(exs)):
            ex: int = stmt_at(a, exs, k)
            gd_push_scope(g)
            try:
                if a.n[ex + {{O:ExceptClause.bind_name}}] != {{NONE}}:
                    gd_bind(g, sym_of(ck, a, pk(a.n[ex + {{O:ExceptClause.bind_name}}], a.n[ex + {{O:ExceptClause.bind_name}} + 1])), "", 0)
                nexb: int = gd_plain_block(g, ck, a, sl_at(a, ex, {{O:ExceptClause.body}}), top, loop_d)
                a.n[ex + {{O:ExceptClause.body}}] = pkx(nexb)
                a.n[ex + {{O:ExceptClause.body}} + 1] = pky(nexb)
            finally:
                gd_pop_scope(g)
        if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
            nfinb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), top, loop_d)
            a.n[pay + {{O:TryStmt.finally_body}}] = pkx(nfinb)
            a.n[pay + {{O:TryStmt.finally_body}} + 1] = pky(nfinb)
    elif tag == {{T:StmtKind.with_stmt}}:
        gd_rename(g, ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}])
        gd_push_scope(g)
        try:
            if a.n[pay + {{O:WithStmt.binding}}] != {{NONE}}:
                gd_bind(g, sym_of(ck, a, pk(a.n[pay + {{O:WithStmt.binding}}], a.n[pay + {{O:WithStmt.binding}} + 1])), "", 0)
            nwb2: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:WithStmt.body}}), top, loop_d)
            a.n[pay + {{O:WithStmt.body}}] = pkx(nwb2)
            a.n[pay + {{O:WithStmt.body}} + 1] = pky(nwb2)
        finally:
            gd_pop_scope(g)
    elif tag == {{T:StmtKind.lowlevel_stmt}}:
        nlb: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), top, loop_d)
        a.n[pay + {{O:LowLevelStmt.body}}] = pkx(nlb)
        a.n[pay + {{O:LowLevelStmt.body}} + 1] = pky(nlb)
    elif tag == {{T:StmtKind.defer_stmt}}:
        dc: int = a.n[pay]
        gd_rename(g, ck, a, a.n[dc + {{O:Call.callee}}])
        dargs: int = sl_at(a, dc, {{O:Call.args}})
        for di in range(pky(dargs)):
            gd_rename(g, ck, a, stmt_at(a, dargs, di))
    elif tag == {{T:StmtKind.func_def}}:
        gd_bind(g, sym_of(ck, a, pk(a.n[pay + {{O:FuncDef.name}}], a.n[pay + {{O:FuncDef.name}} + 1])), "", 0)
        gd_push_scope(g)
        try:
            fps: int = sl_at(a, pay, {{O:FuncDef.params}})
            for pi in range(pky(fps)):
                p: int = stmt_at(a, fps, pi)
                gd_bind(g, sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])), "", 0)
            nfd_b: int = gd_plain_block(g, ck, a, sl_at(a, pay, {{O:FuncDef.body}}), False, 0)
            a.n[pay + {{O:FuncDef.body}}] = pkx(nfd_b)
            a.n[pay + {{O:FuncDef.body}} + 1] = pky(nfd_b)
        finally:
            gd_pop_scope(g)
    out.append(st)

def gd_guard(g: GdPass, a: Ast, pc: str, threshold: int, bsl: int, line: int) -> int:
    cond: int = gd_bin(a, {{E:BinaryOp.le}}, gd_idx0(a, pc), mk_Expr_int_lit(a, threshold))
    return mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, cond, pkx(bsl), pky(bsl), 0, 0, {{NONE}}, 0, 0, -1, 0)), line, -1)

def gd_emit_list(g: GdPass, ck: Ck, a: Ast, sl: int, loop: bool, sel: str) -> tuple[str, int]:
    pc: str = gd_int_cell(g, a, "pc", 0)
    gd_reg_reset(g, pc, 0)
    g.fr_pc.append(pc)
    g.fr_sel.append(sel)
    g.fr_loop.append(loop)
    g.idxs.append(0)
    gd_push_scope(g)
    out: list[int] = []
    n: int = pky(sl)
    i: int = 0
    try:
        while i < n:
            st: int = stmt_at(a, sl, i)
            g.line = a.n[st + {{O:Stmt.line}}]
            if not gd_stmt_has_yield(a, st):
                first: int = i
                grp: list[int] = []
                while i < n and not gd_stmt_has_yield(a, stmt_at(a, sl, i)):
                    st_i: int = stmt_at(a, sl, i)
                    if a.n[a.n[st_i + {{O:Stmt.kind}}]] == {{T:StmtKind.func_def}}:
                        gd_plain_stmt(g, ck, a, st_i, True, 0, g.prelude, True)
                    else:
                        gd_plain_stmt(g, ck, a, st_i, True, 0, grp, True)
                    i = i + 1
                out.append(gd_guard(g, a, pc, 2 * first + 1, ast_stmt_list(a, grp), a.n[st + {{O:Stmt.line}}]))
                continue
            g.idxs[len(g.idxs) - 1] = i
            code: list[int] = gd_emit_active(g, ck, a, st, i, pc)
            out.append(gd_guard(g, a, pc, 2 * i + 1, ast_stmt_list(a, code), a.n[st + {{O:Stmt.line}}]))
            if len(g.closing) > 0 and a.n[a.n[st + {{O:Stmt.kind}}]] == {{T:StmtKind.expr_stmt}}:
                resumed: int = gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, pc), mk_Expr_int_lit(a, 2 * i + 2))
                cond: int = gd_bin(a, {{E:BinaryOp.and_}}, gd_idx0(a, g.closing), resumed)
                gsr: int = syn(a, "generator closed")
                exit_ctor: int = gd_call1(a, "GeneratorExit", mk_Expr_string_lit(a, pkx(gsr), pky(gsr)))
                chk_b: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_raise_stmt(a, exit_ctor), a.n[st + {{O:Stmt.line}}], -1)])
                out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, cond, pkx(chk_b), pky(chk_b), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
                has_th: int = gd_bin(a, {{E:BinaryOp.ne}}, gd_idx0(a, g.thrown_cell), mk_Expr_none_lit(a))
                th_cond: int = gd_bin(a, {{E:BinaryOp.and_}}, has_th, resumed)
                g.uid = g.uid + 1
                tmp: str = "__nox_th_" + str(g.uid)
                tsr: int = syn(a, tmp)
                inf_sr: int = syn(a, "__infer")
                s0: int = mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr)), gd_read_of(a, g.thrown_cell, g.thrown_flag), 0, 0, 0, 0)), a.n[st + {{O:Stmt.line}}], -1)
                s1: int = mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, gd_idx0(a, g.thrown_cell), mk_Expr_none_lit(a), 0)), a.n[st + {{O:Stmt.line}}], -1)
                s2: int = mk_Stmt(a, mk_StmtKind_raise_stmt(a, mk_ident_node(a, tmp)), a.n[st + {{O:Stmt.line}}], -1)
                tb_sl: int = ast_stmt_list(a, [s0, s1, s2])
                out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, th_cond, pkx(tb_sl), pky(tb_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
            i = i + 1
        out.append(gd_set_cell(g, a, pc, 0))
    finally:
        gd_pop_scope(g)
        g.idxs.pop()
        g.fr_pc.pop()
        g.fr_sel.pop()
        g.fr_loop.pop()
    return (pc, ast_stmt_list(a, out))

def gd_emit_active(g: GdPass, ck: Ck, a: Ast, st: int, i: int, pc: str) -> list[int]:
    g.line = a.n[st + {{O:Stmt.line}}]
    kn: int = a.n[st + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    if tag == {{T:StmtKind.expr_stmt}}:
        yk: int = gd_is_yield(a, pay)
        arg: int = stmt_at(a, sl_at(a, a.n[pay + 1], {{O:Call.args}}), 0)
        if yk == 2:
            g.uid = g.uid + 1
            v: str = "__nox_yf_" + str(g.uid)
            vsr: int = syn(a, v)
            ybsl: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_expr_stmt(a, gd_call1(a, "__nox_yield", mk_ident_node(a, v))), g.line, -1)])
            return gd_emit_for(g, ck, a, mk_ForStmt(a, pkx(vsr), pky(vsr), arg, pkx(ybsl), pky(ybsl), 0, 0, 0), st)
        gd_rename(g, ck, a, arg)
        out: list[int] = []
        k: int = 0
        while k + 1 < len(g.fr_pc):
            if len(g.fr_pc[k]) > 0:
                out.append(gd_set_cell(g, a, g.fr_pc[k], 2 * g.idxs[k] + 1))
            k = k + 1
        out.append(gd_set_cell(g, a, pc, 2 * i + 2))
        out.append(gd_assign(g, a, gd_idx0(a, g.done), mk_Expr_bool_lit(a, 0)))
        out.append(mk_Stmt(a, mk_StmtKind_return_stmt(a, arg), g.line, -1))
        return out
    if tag == {{T:StmtKind.if_stmt}}:
        return gd_emit_if(g, ck, a, pay, st)
    if tag == {{T:StmtKind.try_stmt}}:
        return gd_emit_try(g, ck, a, pay, st)
    if tag == {{T:StmtKind.with_stmt}}:
        return gd_emit_with(g, ck, a, pay, st)
    if tag == {{T:StmtKind.while_stmt}}:
        return gd_emit_while(g, ck, a, pay, st)
    if tag == {{T:StmtKind.for_stmt}}:
        return gd_emit_for(g, ck, a, pay, st)
    gd_fail(g, ck, "internal error: unexpected statement kind in a generator")
    return []

def gd_emit_if(g: GdPass, ck: Ck, a: Ast, s: int, st: int) -> list[int]:
    sel: str = gd_int_cell(g, a, "sel", 0)
    gd_reg_reset(g, sel, 0)
    out: list[int] = []
    cond0: int = a.n[s + {{O:IfStmt.cond}}]
    gd_rename(g, ck, a, cond0)
    tb0: int = ast_stmt_list(a, [gd_set_cell(g, a, sel, 1)])
    ecs: int = sl_at(a, s, {{O:IfStmt.elif_clauses}})
    ec_ids: list[int] = []
    for k in range(pky(ecs)):
        ec: int = stmt_at(a, ecs, k)
        ec_c: int = a.n[ec + {{O:ElifClause.cond}}]
        gd_rename(g, ck, a, ec_c)
        eb_k: int = ast_stmt_list(a, [gd_set_cell(g, a, sel, k + 2)])
        ec_ids.append(mk_ElifClause(a, ec_c, pkx(eb_k), pky(eb_k)))
    ec_sl: int = list_put_slice(a, ec_ids)
    eb0: int = {{NONE}}
    eb1: int = 0
    if a.n[s + {{O:IfStmt.else_body}}] != {{NONE}}:
        eb_s: int = ast_stmt_list(a, [gd_set_cell(g, a, sel, pky(ecs) + 2)])
        eb0 = pkx(eb_s)
        eb1 = pky(eb_s)
    pick_st: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, cond0, pkx(tb0), pky(tb0), pkx(ec_sl), pky(ec_sl), eb0, eb1, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1)
    fresh: int = gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, sel), mk_Expr_int_lit(a, 0))
    fr_sl: int = ast_stmt_list(a, [pick_st])
    out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, fresh, pkx(fr_sl), pky(fr_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
    out.append(gd_branch(g, ck, a, sel, 1, sl_at(a, s, {{O:IfStmt.then_body}})))
    for k2 in range(pky(ecs)):
        out.append(gd_branch(g, ck, a, sel, k2 + 2, sl_at(a, stmt_at(a, ecs, k2), {{O:ElifClause.body}})))
    if a.n[s + {{O:IfStmt.else_body}}] != {{NONE}}:
        out.append(gd_branch(g, ck, a, sel, pky(ecs) + 2, sl_at(a, s, {{O:IfStmt.else_body}})))
    out.append(gd_set_cell(g, a, sel, 0))
    return out

def gd_branch(g: GdPass, ck: Ck, a: Ast, sel: str, k: int, bsl: int) -> int:
    code_sl: int = -1
    if gd_list_has_yield(a, bsl):
        r: tuple[str, int] = gd_emit_list(g, ck, a, bsl, False, sel)
        code_sl = r[1]
    else:
        g.fr_pc.append("")
        g.fr_sel.append(sel)
        g.fr_loop.append(False)
        try:
            code_sl = gd_plain_block(g, ck, a, bsl, True, 0)
        finally:
            g.fr_pc.pop()
            g.fr_sel.pop()
            g.fr_loop.pop()
    return gd_if_stmt(g, a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, sel), mk_Expr_int_lit(a, k)), code_sl)

def gd_has_escaping_jump(a: Ast, sl: int, loop_d: int) -> bool:
    for i in range(pky(sl)):
        st: int = stmt_at(a, sl, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.return_stmt}}:
            return True
        if tag == {{T:StmtKind.break_stmt}} or tag == {{T:StmtKind.continue_stmt}}:
            if loop_d == 0:
                return True
        elif tag == {{T:StmtKind.if_stmt}}:
            if gd_has_escaping_jump(a, sl_at(a, pay, {{O:IfStmt.then_body}}), loop_d):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                if gd_has_escaping_jump(a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}}), loop_d):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}} and gd_has_escaping_jump(a, sl_at(a, pay, {{O:IfStmt.else_body}}), loop_d):
                return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if gd_has_escaping_jump(a, sl_at(a, pay, {{O:WhileStmt.body}}), loop_d + 1):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if gd_has_escaping_jump(a, sl_at(a, pay, {{O:ForStmt.body}}), loop_d + 1):
                return True
        elif tag == {{T:StmtKind.try_stmt}}:
            if gd_has_escaping_jump(a, sl_at(a, pay, {{O:TryStmt.try_body}}), loop_d):
                return True
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                if gd_has_escaping_jump(a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}), loop_d):
                    return True
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}} and gd_has_escaping_jump(a, sl_at(a, pay, {{O:TryStmt.finally_body}}), loop_d):
                return True
        elif tag == {{T:StmtKind.with_stmt}}:
            if gd_has_escaping_jump(a, sl_at(a, pay, {{O:WithStmt.body}}), loop_d):
                return True
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if gd_has_escaping_jump(a, sl_at(a, pay, {{O:LowLevelStmt.body}}), loop_d):
                return True
    return False

def gd_emit_try(g: GdPass, ck: Ck, a: Ast, s: int, st: int) -> list[int]:
    exs: int = sl_at(a, s, {{O:TryStmt.except_clauses}})
    deferred: bool = False
    for k0 in range(pky(exs)):
        if gd_list_has_yield(a, sl_at(a, stmt_at(a, exs, k0), {{O:ExceptClause.body}})):
            deferred = True
    fb_sl: int = sl_at(a, s, {{O:TryStmt.finally_body}})
    has_fin: bool = a.n[s + {{O:TryStmt.finally_body}}] != {{NONE}}
    fin_yield: bool = has_fin and gd_list_has_yield(a, fb_sl)
    if fin_yield:
        jumps: bool = gd_has_escaping_jump(a, sl_at(a, s, {{O:TryStmt.try_body}}), 0)
        for k1 in range(pky(exs)):
            if gd_has_escaping_jump(a, sl_at(a, stmt_at(a, exs, k1), {{O:ExceptClause.body}}), 0):
                jumps = True
        if jumps or gd_has_escaping_jump(a, fb_sl, 0):
            gd_fail(g, ck, "'return', 'break' or 'continue' that leaves a 'try' whose 'finally' contains 'yield' is not supported in a generator (the 'finally' would be skipped)")
            return []
    mark: int = len(g.rst_cell)
    body_r: tuple[str, int] = gd_emit_list(g, ck, a, sl_at(a, s, {{O:TryStmt.try_body}}), False, "")
    body_resets: list[int] = gd_reset_since(g, a, mark)
    which: str = ""
    if deferred:
        which = gd_int_cell(g, a, "which", 0)
        gd_reg_reset(g, which, 0)
    ec_ids: list[int] = []
    def_k: list[int] = []
    def_bcell: list[str] = []
    def_code: list[int] = []
    for k in range(pky(exs)):
        ec: int = stmt_at(a, exs, k)
        ec_b: int = sl_at(a, ec, {{O:ExceptClause.body}})
        gd_push_scope(g)
        try:
            if gd_list_has_yield(a, ec_b):
                bcell: str = ""
                cb: list[int] = []
                for br in body_resets:
                    cb.append(br)
                cb.append(gd_set_cell(g, a, which, k + 1))
                if a.n[ec + {{O:ExceptClause.bind_name}}] != {{NONE}}:
                    bnsr: int = pk(a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1])
                    bnsym: int = sym_of(ck, a, bnsr)
                    cn_te: int = -1
                    if a.n[ec + {{O:ExceptClause.class_name}}] != {{NONE}}:
                        cn_te = mk_TypeExpr_simple(a, a.n[ec + {{O:ExceptClause.class_name}}], a.n[ec + {{O:ExceptClause.class_name}} + 1])
                    else:
                        ex_sr: int = syn(a, "Exception")
                        cn_te = mk_TypeExpr_simple(a, pkx(ex_sr), pky(ex_sr))
                    nb: tuple[str, int] = gd_typed_cell(g, a, sym_to_str(ck, bnsym), cn_te)
                    gd_reg_reset(g, nb[0], 2)
                    cb.append(gd_assign(g, a, gd_idx0(a, nb[0]), mk_Expr_identifier(a, pkx(bnsr), pky(bnsr))))
                    gd_bind(g, bnsym, nb[0], nb[1])
                    bcell = nb[0]
                cbsl: int = ast_stmt_list(a, cb)
                ec_ids.append(mk_ExceptClause(a, a.n[ec + {{O:ExceptClause.class_name}}], a.n[ec + {{O:ExceptClause.class_name}} + 1], a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1], pkx(cbsl), pky(cbsl), a.n[ec + {{O:ExceptClause.synth_bind}}], a.n[ec + {{O:ExceptClause.synth_class}}]))
                hl: tuple[str, int] = gd_emit_list(g, ck, a, ec_b, False, which)
                def_k.append(k)
                def_bcell.append(bcell)
                def_code.append(hl[1])
            else:
                if a.n[ec + {{O:ExceptClause.bind_name}}] != {{NONE}}:
                    gd_bind(g, sym_of(ck, a, pk(a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1])), "", 0)
                cb2: list[int] = []
                for br2 in body_resets:
                    cb2.append(br2)
                pb: int = gd_plain_block(g, ck, a, ec_b, True, 0)
                for pbi in range(pky(pb)):
                    cb2.append(stmt_at(a, pb, pbi))
                cbsl2: int = ast_stmt_list(a, cb2)
                ec_ids.append(mk_ExceptClause(a, a.n[ec + {{O:ExceptClause.class_name}}], a.n[ec + {{O:ExceptClause.class_name}} + 1], a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1], pkx(cbsl2), pky(cbsl2), a.n[ec + {{O:ExceptClause.synth_bind}}], a.n[ec + {{O:ExceptClause.synth_class}}]))
        finally:
            gd_pop_scope(g)
    ec_sl: int = list_put_slice(a, ec_ids)
    inner_t: int = mk_Stmt(a, mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(body_r[1]), pky(body_r[1]), pkx(ec_sl), pky(ec_sl), {{NONE}}, 0, 0)), a.n[st + {{O:Stmt.line}}], -1)
    region: list[int] = []
    if deferred:
        f_sl: int = ast_stmt_list(a, [inner_t])
        region.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, which), mk_Expr_int_lit(a, 0)), pkx(f_sl), pky(f_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
        for di in range(len(def_k)):
            blk: list[int] = []
            dc_sl: int = def_code[di]
            for dci in range(pky(dc_sl)):
                blk.append(stmt_at(a, dc_sl, dci))
            if len(def_bcell[di]) > 0:
                blk.append(gd_assign(g, a, gd_idx0(a, def_bcell[di]), mk_Expr_none_lit(a)))
            blk_sl: int = ast_stmt_list(a, blk)
            region.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, which), mk_Expr_int_lit(a, def_k[di] + 1)), pkx(blk_sl), pky(blk_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
        region.append(gd_set_cell(g, a, which, 0))
    else:
        region.append(inner_t)
    reg_sl: int = ast_stmt_list(a, region)
    if not fin_yield:
        fin: list[int] = []
        if has_fin:
            pfb: int = gd_plain_block(g, ck, a, fb_sl, True, 0)
            for pfi in range(pky(pfb)):
                fin.append(stmt_at(a, pfb, pfi))
        for rfr in gd_reset_since(g, a, mark):
            fin.append(rfr)
        g_fin: int = ast_stmt_list(a, [gd_if_stmt(g, a, gd_idx0(a, g.done), ast_stmt_list(a, fin))])
        return [mk_Stmt(a, mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(reg_sl), pky(reg_sl), 0, 0, pkx(g_fin), pky(g_fin), 0)), a.n[st + {{O:Stmt.line}}], -1)]
    fst: str = gd_int_cell(g, a, "fst", 0)
    gd_reg_reset(g, fst, 0)
    ex_sr2: int = syn(a, "Exception")
    pend: tuple[str, int] = gd_typed_cell(g, a, "pend", mk_TypeExpr_simple(a, pkx(ex_sr2), pky(ex_sr2)))
    gd_reg_reset(g, pend[0], 2)
    fl: tuple[str, int] = gd_emit_list(g, ck, a, fb_sl, False, "")
    cb_all: list[int] = gd_reset_since(g, a, mark)
    cb_all.append(gd_assign(g, a, gd_idx0(a, pend[0]), mk_ident_node(a, "__nox_pending")))
    cbs_all: int = ast_stmt_list(a, cb_all)
    pnd_sr: int = syn(a, "__nox_pending")
    ca_ec: int = mk_ExceptClause(a, pkx(ex_sr2), pky(ex_sr2), pkx(pnd_sr), pky(pnd_sr), pkx(cbs_all), pky(cbs_all), 0, 0)
    ca_sl: int = list_put_slice(a, [ca_ec])
    prot: int = mk_Stmt(a, mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(reg_sl), pky(reg_sl), pkx(ca_sl), pky(ca_sl), {{NONE}}, 0, 0)), a.n[st + {{O:Stmt.line}}], -1)
    eblk: int = ast_stmt_list(a, [prot, gd_set_cell(g, a, fst, 1)])
    out_t: list[int] = []
    out_t.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, fst), mk_Expr_int_lit(a, 0)), pkx(eblk), pky(eblk), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
    fblk: list[int] = []
    for fli in range(pky(fl[1])):
        fblk.append(stmt_at(a, fl[1], fli))
    fblk.append(gd_set_cell(g, a, fst, 0))
    g.uid = g.uid + 1
    tmp_pe: str = "__nox_pe_" + str(g.uid)
    tpesr: int = syn(a, tmp_pe)
    inf_sr2: int = syn(a, "__infer")
    rt0: int = gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tpesr), pky(tpesr), mk_TypeExpr_simple(a, pkx(inf_sr2), pky(inf_sr2)), gd_read_of(a, pend[0], pend[1]), 0, 0, 0, 0)))
    rt1: int = gd_assign(g, a, gd_idx0(a, pend[0]), mk_Expr_none_lit(a))
    rt2: int = gd_stmt(g, a, mk_StmtKind_raise_stmt(a, mk_ident_node(a, tmp_pe)))
    fblk.append(gd_if_stmt(g, a, gd_bin(a, {{E:BinaryOp.ne}}, gd_idx0(a, pend[0]), mk_Expr_none_lit(a)), ast_stmt_list(a, [rt0, rt1, rt2])))
    fblk_sl: int = ast_stmt_list(a, fblk)
    out_t.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, fst), mk_Expr_int_lit(a, 1)), pkx(fblk_sl), pky(fblk_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
    return out_t

def gd_emit_with(g: GdPass, ck: Ck, a: Ast, s: int, st: int) -> list[int]:
    ctx_e: int = a.n[s + {{O:WithStmt.ctx_expr}}]
    gd_rename(g, ck, a, ctx_e)
    out: list[int] = []
    mgr: tuple[str, int] = gd_inferred_cell(g, a, "mgr", ctx_e)
    gd_reg_reset(g, mgr[0], 2)
    gd_push_scope(g)
    try:
        bcell: str = ""
        bflag: int = 0
        enter_n: str = "__enter__"
        exit_n: str = "__exit__"
        if a.n[s + {{O:WithStmt.is_async}}] != 0:
            enter_n = "__aenter__"
            exit_n = "__aexit__"
        if a.n[s + {{O:WithStmt.binding}}] != {{NONE}}:
            bnsr: int = pk(a.n[s + {{O:WithStmt.binding}}], a.n[s + {{O:WithStmt.binding}} + 1])
            bnsym: int = sym_of(ck, a, bnsr)
            ec_expr: int = mk_attr_call_node(a, gd_call1(a, "__nox_get", mk_ident_node(a, mgr[0])), enter_n, pk(0, 0))
            bc: tuple[str, int] = gd_inferred_cell(g, a, sym_to_str(ck, bnsym), ec_expr)
            gd_bind(g, bnsym, bc[0], bc[1])
            bcell = bc[0]
            bflag = bc[1]
        g.uid = g.uid + 1
        tmp_w: str = "__nox_wm_" + str(g.uid)
        twsr: int = syn(a, tmp_w)
        inf_sr: int = syn(a, "__infer")
        fr_st: list[int] = [gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(twsr), pky(twsr), mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr)), ctx_e, 0, 0, 0, 0)))]
        ec_tmp: int = mk_attr_call_node(a, mk_ident_node(a, tmp_w), enter_n, pk(0, 0))
        if len(bcell) > 0:
            fr_st.append(gd_assign(g, a, gd_write_target(a, bcell, bflag), ec_tmp))
        else:
            fr_st.append(gd_stmt(g, a, mk_StmtKind_expr_stmt(a, ec_tmp)))
        fr_st.append(gd_assign(g, a, gd_idx0(a, mgr[0]), mk_ident_node(a, tmp_w)))
        fr_sl: int = ast_stmt_list(a, fr_st)
        unset: int = gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, mgr[0]), mk_Expr_none_lit(a))
        out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, unset, pkx(fr_sl), pky(fr_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
        body_r: tuple[str, int] = gd_emit_list(g, ck, a, sl_at(a, s, {{O:WithStmt.body}}), False, "")
        ex_c: int = mk_attr_call_node(a, gd_call1(a, "__nox_get", mk_ident_node(a, mgr[0])), exit_n, pk(0, 0))
        fin_sl: int = ast_stmt_list(a, [gd_stmt(g, a, mk_StmtKind_expr_stmt(a, ex_c)), gd_assign(g, a, gd_idx0(a, mgr[0]), mk_Expr_none_lit(a)), gd_set_cell(g, a, body_r[0], 0)])
        g_fin: int = ast_stmt_list(a, [gd_if_stmt(g, a, gd_idx0(a, g.done), fin_sl)])
        out.append(mk_Stmt(a, mk_StmtKind_try_stmt(a, mk_TryStmt(a, pkx(body_r[1]), pky(body_r[1]), 0, 0, pkx(g_fin), pky(g_fin), 0)), a.n[st + {{O:Stmt.line}}], -1))
    finally:
        gd_pop_scope(g)
    return out

def gd_emit_while(g: GdPass, ck: Ck, a: Ast, s: int, st: int) -> list[int]:
    cond: int = a.n[s + {{O:WhileStmt.cond}}]
    gd_rename(g, ck, a, cond)
    r: tuple[str, int] = gd_emit_list(g, ck, a, sl_at(a, s, {{O:WhileStmt.body}}), True, "")
    roc: int = gd_bin(a, {{E:BinaryOp.or_}}, gd_bin(a, {{E:BinaryOp.ne}}, gd_idx0(a, r[0]), mk_Expr_int_lit(a, 0)), cond)
    return [mk_Stmt(a, mk_StmtKind_while_stmt(a, mk_WhileStmt(a, roc, pkx(r[1]), pky(r[1]), -1)), a.n[st + {{O:Stmt.line}}], -1)]

def gd_is_range_call(g: GdPass, ck: Ck, a: Ast, e: int) -> bool:
    if a.n[e] != {{T:Expr.call}}:
        return False
    c: int = a.n[e + 1]
    cal: int = a.n[c + {{O:Call.callee}}]
    args: int = sl_at(a, c, {{O:Call.args}})
    return a.n[cal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[cal + 1], a.n[cal + 2]), "range") and pky(args) >= 1 and pky(args) <= 3 and gd_lookup(g, sym_lit(ck, "range")) < 0

def gd_emit_for(g: GdPass, ck: Ck, a: Ast, s: int, st: int) -> list[int]:
    out: list[int] = []
    raw_it: int = a.n[s + {{O:ForStmt.iterable}}]
    is_rng: bool = gd_is_range_call(g, ck, a, raw_it)
    it_e: int = raw_it
    gd_rename(g, ck, a, it_e)
    gd_push_scope(g)
    try:
        vsr: int = pk(a.n[s + {{O:ForStmt.var_name}}], a.n[s + {{O:ForStmt.var_name}} + 1])
        vsym: int = sym_of(ck, a, vsr)
        vname: str = sym_to_str(ck, vsym)
        if is_rng:
            cur: str = gd_int_cell(g, a, "cur", 0)
            stop: str = gd_int_cell(g, a, "stop", 0)
            step: str = gd_int_cell(g, a, "step", 1)
            started: str = gd_bool_cell(g, a, "started", 0)
            gd_reg_reset(g, started, 1)
            vcell: str = gd_int_cell(g, a, vname, 0)
            gd_bind(g, vsym, vcell, 1)
            rargs: int = sl_at(a, a.n[it_e + 1], {{O:Call.args}})
            rn: int = pky(rargs)
            se: int = mk_Expr_int_lit(a, 0)
            ee: int = stmt_at(a, rargs, 0)
            if rn >= 2:
                se = stmt_at(a, rargs, 0)
                ee = stmt_at(a, rargs, 1)
            ib: list[int] = [gd_assign(g, a, gd_idx0(a, cur), se), gd_assign(g, a, gd_idx0(a, stop), ee)]
            if rn == 3:
                ib.append(gd_assign(g, a, gd_idx0(a, step), stmt_at(a, rargs, 2)))
            ib.append(gd_assign(g, a, gd_idx0(a, started), mk_Expr_bool_lit(a, 1)))
            ib_sl: int = ast_stmt_list(a, ib)
            out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, started), mk_Expr_bool_lit(a, 0)), pkx(ib_sl), pky(ib_sl), 0, 0, {{NONE}}, 0, 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1))
            br: tuple[str, int] = gd_emit_list(g, ck, a, sl_at(a, s, {{O:ForStmt.body}}), True, "")
            pos: int = gd_bin(a, {{E:BinaryOp.and_}}, gd_bin(a, {{E:BinaryOp.gt}}, gd_idx0(a, step), mk_Expr_int_lit(a, 0)), gd_bin(a, {{E:BinaryOp.ge}}, gd_idx0(a, cur), gd_idx0(a, stop)))
            neg: int = gd_bin(a, {{E:BinaryOp.and_}}, gd_bin(a, {{E:BinaryOp.lt}}, gd_idx0(a, step), mk_Expr_int_lit(a, 0)), gd_bin(a, {{E:BinaryOp.le}}, gd_idx0(a, cur), gd_idx0(a, stop)))
            fin: int = gd_bin(a, {{E:BinaryOp.or_}}, pos, neg)
            brk_sl: int = ast_stmt_list(a, [gd_stmt(g, a, mk_StmtKind_break_stmt(a))])
            fb_sl: int = ast_stmt_list(a, [gd_if_stmt(g, a, fin, brk_sl), gd_assign(g, a, gd_idx0(a, vcell), gd_idx0(a, cur)), gd_assign(g, a, gd_idx0(a, cur), gd_bin(a, {{E:BinaryOp.add}}, gd_idx0(a, cur), gd_idx0(a, step)))])
            lb: list[int] = [gd_if_stmt(g, a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, br[0]), mk_Expr_int_lit(a, 0)), fb_sl)]
            for bci in range(pky(br[1])):
                lb.append(stmt_at(a, br[1], bci))
            lb_sl: int = ast_stmt_list(a, lb)
            out.append(mk_Stmt(a, mk_StmtKind_while_stmt(a, mk_WhileStmt(a, mk_Expr_bool_lit(a, 1), pkx(lb_sl), pky(lb_sl), -1)), a.n[st + {{O:Stmt.line}}], -1))
            out.append(gd_assign(g, a, gd_idx0(a, started), mk_Expr_bool_lit(a, 0)))
            return out
        it_b: tuple[str, int] = gd_inferred_cell(g, a, "it", gd_call1(a, "__nox_for_iter", it_e))
        gd_reg_reset(g, it_b[0], 2)
        v_b: tuple[str, int] = gd_inferred_cell(g, a, vname, gd_call1(a, "__nox_elem_of", it_e))
        gd_bind(g, vsym, v_b[0], v_b[1])
        it_un: int = gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, it_b[0]), mk_Expr_none_lit(a))
        out.append(gd_if_stmt(g, a, it_un, ast_stmt_list(a, [gd_assign(g, a, gd_idx0(a, it_b[0]), gd_call1(a, "__nox_for_iter", it_e))])))
        br2: tuple[str, int] = gd_emit_list(g, ck, a, sl_at(a, s, {{O:ForStmt.body}}), True, "")
        g.uid = g.uid + 1
        nx: str = "__nox_nx_" + str(g.uid)
        nxsr: int = syn(a, nx)
        inf_sr: int = syn(a, "__infer")
        nx_c: int = mk_attr_call_node(a, gd_call1(a, "__nox_get", mk_ident_node(a, it_b[0])), "__next__", pk(0, 0))
        vd_nx: int = gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(nxsr), pky(nxsr), mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr)), nx_c, 0, 0, 0, 0)))
        th_sl: int = ast_stmt_list(a, [gd_assign(g, a, gd_idx0(a, v_b[0]), mk_ident_node(a, nx))])
        el_sl: int = ast_stmt_list(a, [gd_stmt(g, a, mk_StmtKind_break_stmt(a))])
        pk_if: int = mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, gd_bin(a, {{E:BinaryOp.ne}}, mk_ident_node(a, nx), mk_Expr_none_lit(a)), pkx(th_sl), pky(th_sl), 0, 0, pkx(el_sl), pky(el_sl), 0, -1, 0)), a.n[st + {{O:Stmt.line}}], -1)
        pull_sl: int = ast_stmt_list(a, [vd_nx, pk_if])
        lb2: list[int] = [gd_if_stmt(g, a, gd_bin(a, {{E:BinaryOp.eq}}, gd_idx0(a, br2[0]), mk_Expr_int_lit(a, 0)), pull_sl)]
        for bci2 in range(pky(br2[1])):
            lb2.append(stmt_at(a, br2[1], bci2))
        lb2_sl: int = ast_stmt_list(a, lb2)
        out.append(mk_Stmt(a, mk_StmtKind_while_stmt(a, mk_WhileStmt(a, mk_Expr_bool_lit(a, 1), pkx(lb2_sl), pky(lb2_sl), -1)), a.n[st + {{O:Stmt.line}}], -1))
        out.append(gd_assign(g, a, gd_idx0(a, it_b[0]), mk_Expr_none_lit(a)))
    finally:
        gd_pop_scope(g)
    return out

def gd_has_cleanup(a: Ast, sl: int) -> bool:
    for i in range(pky(sl)):
        st: int = stmt_at(a, sl, i)
        if not gd_stmt_has_yield(a, st):
            continue
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.try_stmt}} or tag == {{T:StmtKind.with_stmt}}:
            return True
        if tag == {{T:StmtKind.if_stmt}}:
            if gd_has_cleanup(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                if gd_has_cleanup(a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}})):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}} and gd_has_cleanup(a, sl_at(a, pay, {{O:IfStmt.else_body}})):
                return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if gd_has_cleanup(a, sl_at(a, pay, {{O:WhileStmt.body}})):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if gd_has_cleanup(a, sl_at(a, pay, {{O:ForStmt.body}})):
                return True
    return False

def gd_expand_send(g: GdPass, a: Ast, sl: int) -> int:
    out: list[int] = []
    for i in range(pky(sl)):
        st: int = stmt_at(a, sl, i)
        ln: int = a.n[st + {{O:Stmt.line}}]
        spn: int = a.n[st + {{O:Stmt.span}}]
        g.line = ln
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}} and gd_is_yield(a, a.n[pay + {{O:Assign.value}}]) == 3:
            g.uses_send = True
            if g.send_line == 0:
                g.send_line = ln
            yc: int = a.n[a.n[pay + {{O:Assign.value}}] + 1]
            yarg: int = stmt_at(a, sl_at(a, yc, {{O:Call.args}}), 0)
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, gd_call1(a, "__nox_yield", yarg)), ln, spn))
            a.n[pay + {{O:Assign.value}}] = gd_call0(a, "__nox_sent")
            out.append(st)
            continue
        if tag == {{T:StmtKind.var_decl}} and gd_is_yield(a, a.n[pay + {{O:VarDecl.value}}]) == 3:
            g.uses_send = True
            if g.send_line == 0:
                g.send_line = ln
            yc2: int = a.n[a.n[pay + {{O:VarDecl.value}}] + 1]
            yarg2: int = stmt_at(a, sl_at(a, yc2, {{O:Call.args}}), 0)
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, gd_call1(a, "__nox_yield", yarg2)), ln, spn))
            a.n[pay + {{O:VarDecl.value}}] = gd_call0(a, "__nox_sent")
            out.append(st)
            continue
        if tag == {{T:StmtKind.expr_stmt}} and gd_is_yield(a, pay) == 3:
            yc3: int = a.n[pay + 1]
            yarg3: int = stmt_at(a, sl_at(a, yc3, {{O:Call.args}}), 0)
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, gd_call1(a, "__nox_yield", yarg3)), ln, spn))
            continue
        if tag == {{T:StmtKind.if_stmt}}:
            ntb: int = gd_expand_send(g, a, sl_at(a, pay, {{O:IfStmt.then_body}}))
            a.n[pay + {{O:IfStmt.then_body}}] = pkx(ntb)
            a.n[pay + {{O:IfStmt.then_body}} + 1] = pky(ntb)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                ec: int = stmt_at(a, ecs, j)
                neb: int = gd_expand_send(g, a, sl_at(a, ec, {{O:ElifClause.body}}))
                a.n[ec + {{O:ElifClause.body}}] = pkx(neb)
                a.n[ec + {{O:ElifClause.body}} + 1] = pky(neb)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                nelb: int = gd_expand_send(g, a, sl_at(a, pay, {{O:IfStmt.else_body}}))
                a.n[pay + {{O:IfStmt.else_body}}] = pkx(nelb)
                a.n[pay + {{O:IfStmt.else_body}} + 1] = pky(nelb)
        elif tag == {{T:StmtKind.while_stmt}}:
            nwb: int = gd_expand_send(g, a, sl_at(a, pay, {{O:WhileStmt.body}}))
            a.n[pay + {{O:WhileStmt.body}}] = pkx(nwb)
            a.n[pay + {{O:WhileStmt.body}} + 1] = pky(nwb)
        elif tag == {{T:StmtKind.for_stmt}}:
            nfb: int = gd_expand_send(g, a, sl_at(a, pay, {{O:ForStmt.body}}))
            a.n[pay + {{O:ForStmt.body}}] = pkx(nfb)
            a.n[pay + {{O:ForStmt.body}} + 1] = pky(nfb)
        elif tag == {{T:StmtKind.try_stmt}}:
            nttb: int = gd_expand_send(g, a, sl_at(a, pay, {{O:TryStmt.try_body}}))
            a.n[pay + {{O:TryStmt.try_body}}] = pkx(nttb)
            a.n[pay + {{O:TryStmt.try_body}} + 1] = pky(nttb)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                ex: int = stmt_at(a, exs, k)
                nexb: int = gd_expand_send(g, a, sl_at(a, ex, {{O:ExceptClause.body}}))
                a.n[ex + {{O:ExceptClause.body}}] = pkx(nexb)
                a.n[ex + {{O:ExceptClause.body}} + 1] = pky(nexb)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                nfinb: int = gd_expand_send(g, a, sl_at(a, pay, {{O:TryStmt.finally_body}}))
                a.n[pay + {{O:TryStmt.finally_body}}] = pkx(nfinb)
                a.n[pay + {{O:TryStmt.finally_body}} + 1] = pky(nfinb)
        elif tag == {{T:StmtKind.with_stmt}}:
            nwb2: int = gd_expand_send(g, a, sl_at(a, pay, {{O:WithStmt.body}}))
            a.n[pay + {{O:WithStmt.body}}] = pkx(nwb2)
            a.n[pay + {{O:WithStmt.body}} + 1] = pky(nwb2)
        out.append(st)
    return ast_stmt_list(a, out)

def gd_assigns_name(ck: Ck, a: Ast, sl: int, xsym: int) -> bool:
    for i in range(pky(sl)):
        st: int = stmt_at(a, sl, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.assign}}:
            atg: int = a.n[pay + {{O:Assign.target}}]
            if a.n[atg] == {{T:Expr.identifier}} and sym_of(ck, a, pk(a.n[atg + 1], a.n[atg + 2])) == xsym:
                return True
        elif tag == {{T:StmtKind.if_stmt}}:
            if gd_assigns_name(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), xsym):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                if gd_assigns_name(ck, a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}}), xsym):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}} and gd_assigns_name(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), xsym):
                return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if gd_assigns_name(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), xsym):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if gd_assigns_name(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), xsym):
                return True
        elif tag == {{T:StmtKind.try_stmt}}:
            if gd_assigns_name(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), xsym):
                return True
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                if gd_assigns_name(ck, a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}), xsym):
                    return True
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}} and gd_assigns_name(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), xsym):
                return True
        elif tag == {{T:StmtKind.with_stmt}}:
            if gd_assigns_name(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), xsym):
                return True
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if gd_assigns_name(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), xsym):
                return True
    return False

def gd_lower(g: GdPass, ck: Ck, a: Ast, fd: int, line: int) -> None:
    g.line = line
    was_async: int = a.n[fd + {{O:FuncDef.is_async}}]
    rt_te: int = a.n[fd + {{O:FuncDef.return_type}}]
    is_gens: bool = False
    is_gen: bool = False
    gargs: int = 0
    if a.n[rt_te] == {{T:TypeExpr.generic}}:
        gg: int = a.n[rt_te + 1]
        gn_sr: int = pk(a.n[gg + {{O:Generic.name}}], a.n[gg + {{O:Generic.name}} + 1])
        gargs = sl_at(a, gg, {{O:Generic.args}})
        is_gens = sref_eq(a, gn_sr, "__nox_GenS") and pky(gargs) == 2
        is_gen = sref_eq(a, gn_sr, "__nox_Gen") and pky(gargs) == 1
    if not is_gens and not is_gen:
        gd_fail(g, ck, "a function containing 'yield' must be annotated '-> Iterator[T]' (or Generator[T], or Generator[Y, S] to receive values with send())")
    g.ytype = stmt_at(a, gargs, 0)
    g.uses_send = False
    g.send_line = 0
    nbsl: int = gd_expand_send(g, a, sl_at(a, fd, {{O:FuncDef.body}}))
    a.n[fd + {{O:FuncDef.body}}] = pkx(nbsl)
    a.n[fd + {{O:FuncDef.body}} + 1] = pky(nbsl)
    if g.uses_send and not is_gens:
        g.line = g.send_line
        gd_fail(g, ck, "'x = yield value' receives sent values: annotate the function '-> Generator[Y, S]' (S is the type of the values passed to send())")
    g.line = line
    if a.n[g.ytype] == {{T:TypeExpr.optional}}:
        gd_fail(g, ck, "a generator cannot yield an optional type ('T | None'); yield the plain type")
    gd_unsupported_yield(g, ck, a, nbsl)
    g.prelude = []
    g.rst_cell = []
    g.rst_kind = []
    g.fr_pc = []
    g.fr_sel = []
    g.fr_loop = []
    g.idxs = []
    g.sc_base = []
    g.sc_sym = []
    g.sc_cell = []
    g.sc_flag = []
    gd_push_scope(g)
    try:
        ps: int = sl_at(a, fd, {{O:FuncDef.params}})
        for i in range(pky(ps)):
            p: int = stmt_at(a, ps, i)
            if a.n[p + {{O:Param.variadic}}] != 0 or a.n[p + {{O:Param.var_kw}}] != 0:
                continue
            psr: int = pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])
            psym: int = sym_of(ck, a, psr)
            pname: str = sym_to_str(ck, psym)
            if gd_assigns_name(ck, a, nbsl, psym):
                pcell: str = gd_new_name(g, pname)
                pcsr: int = syn(a, pcell)
                pitsl: int = ast_expr_list(a, [mk_Expr_identifier(a, pkx(psr), pky(psr))])
                g.prelude.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(pcsr), pky(pcsr), gd_list_of(a, a.n[p + {{O:Param.type_expr}}]), mk_Expr_list_lit(a, pkx(pitsl), pky(pitsl)), 0, 0, 0, 0))))
                gd_bind(g, psym, pcell, 1)
            else:
                gd_bind(g, psym, "", 0)
        g.done = gd_bool_cell(g, a, "done", 0)
        g.closing = ""
        if gd_has_cleanup(a, nbsl):
            g.closing = gd_bool_cell(g, a, "closing", 0)
        g.thrown_cell = ""
        g.thrown_flag = 0
        if len(g.closing) > 0:
            ex_sr3: int = syn(a, "Exception")
            th: tuple[str, int] = gd_typed_cell(g, a, "thrown", mk_TypeExpr_simple(a, pkx(ex_sr3), pky(ex_sr3)))
            g.thrown_cell = th[0]
            g.thrown_flag = th[1]
        g.sent_cell = ""
        g.sent_flag = 0
        if is_gens:
            stype: int = stmt_at(a, gargs, 1)
            sb: tuple[str, int] = gd_typed_cell(g, a, "sent", stype)
            g.sent_cell = sb[0]
            g.sent_flag = sb[1]
            vsr2: int = syn(a, "v")
            nsr2: int = syn(a, "None")
            spsl: int = ast_stmt_list(a, [mk_Param(a, pkx(vsr2), pky(vsr2), 0, 0, 0, 0, stype, 0, {{NONE}})])
            sbsl: int = ast_stmt_list(a, [gd_assign(g, a, gd_write_target(a, sb[0], sb[1]), mk_Expr_identifier(a, pkx(vsr2), pky(vsr2)))])
            snd_sr: int = syn(a, "__nox_send")
            sfd: int = mk_FuncDef(a, pkx(snd_sr), pky(snd_sr), 0, 0, pkx(spsl), pky(spsl), mk_TypeExpr_simple(a, pkx(nsr2), pky(nsr2)), 0, pkx(sbsl), pky(sbsl), 0, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, line)
            g.prelude.append(gd_stmt(g, a, mk_StmtKind_func_def(a, sfd)))
        root_r: tuple[str, int] = gd_emit_list(g, ck, a, nbsl, False, "")
        step_body: list[int] = [gd_if_stmt(g, a, gd_idx0(a, g.done), ast_stmt_list(a, [gd_stmt(g, a, mk_StmtKind_return_stmt(a, mk_Expr_none_lit(a)))])), gd_assign(g, a, gd_idx0(a, g.done), mk_Expr_bool_lit(a, 1))]
        for rci in range(pky(root_r[1])):
            step_body.append(stmt_at(a, root_r[1], rci))
        step_body.append(gd_stmt(g, a, mk_StmtKind_return_stmt(a, mk_Expr_none_lit(a))))
        st_bsl: int = ast_stmt_list(a, step_body)
        step_sr: int = syn(a, "__nox_step")
        step_fd: int = mk_FuncDef(a, pkx(step_sr), pky(step_sr), 0, 0, 0, 0, mk_TypeExpr_optional(a, g.ytype), 0, pkx(st_bsl), pky(st_bsl), 0, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, was_async, line)
        out_b: list[int] = []
        for pi2 in range(len(g.prelude)):
            out_b.append(g.prelude[pi2])
        out_b.append(gd_stmt(g, a, mk_StmtKind_func_def(a, step_fd)))
        if is_gens:
            cl_n: str = g.closing
            bsr_g: int = syn(a, "bool")
            if len(cl_n) == 0:
                cl_n = gd_new_name(g, "noclose")
                clsr: int = syn(a, cl_n)
                out_b.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(clsr), pky(clsr), gd_list_of(a, mk_TypeExpr_simple(a, pkx(bsr_g), pky(bsr_g))), mk_Expr_list_lit(a, 0, 0), 0, 0, 0, 0))))
            th_n: str = g.thrown_cell
            if len(th_n) == 0:
                th_n = gd_new_name(g, "nothrow")
                thsr: int = syn(a, th_n)
                ex_sr4: int = syn(a, "Exception")
                out_b.append(gd_stmt(g, a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(thsr), pky(thsr), gd_list_of(a, mk_TypeExpr_optional(a, mk_TypeExpr_simple(a, pkx(ex_sr4), pky(ex_sr4)))), mk_Expr_list_lit(a, 0, 0), 0, 0, 0, 0))))
            ga_sl: int = ast_expr_list(a, [mk_ident_node(a, "__nox_step"), mk_ident_node(a, cl_n), mk_ident_node(a, th_n), mk_ident_node(a, "__nox_send")])
            out_b.append(gd_stmt(g, a, mk_StmtKind_return_stmt(a, mk_Expr_call(a, mk_Call(a, mk_ident_node(a, "__nox_gens_from_step"), pkx(ga_sl), pky(ga_sl), 0, 0, 0, 0, 0, 0)))))
        elif len(g.closing) > 0:
            ga_sl2: int = ast_expr_list(a, [mk_ident_node(a, "__nox_step"), mk_ident_node(a, g.closing), mk_ident_node(a, g.thrown_cell)])
            out_b.append(gd_stmt(g, a, mk_StmtKind_return_stmt(a, mk_Expr_call(a, mk_Call(a, mk_ident_node(a, "__nox_gen_from_step_closable"), pkx(ga_sl2), pky(ga_sl2), 0, 0, 0, 0, 0, 0)))))
        else:
            out_b.append(gd_stmt(g, a, mk_StmtKind_return_stmt(a, gd_call1(a, "__nox_gen_from_step", mk_ident_node(a, "__nox_step")))))
        fbsl: int = ast_stmt_list(a, out_b)
        a.n[fd + {{O:FuncDef.body}}] = pkx(fbsl)
        a.n[fd + {{O:FuncDef.body}} + 1] = pky(fbsl)
        a.n[fd + {{O:FuncDef.is_async}}] = 0
        if len(g.closing) > 0:
            fsym_k: int = sym_of(ck, a, pk(a.n[fd + {{O:FuncDef.name}}], a.n[fd + {{O:FuncDef.name}} + 1]))
            key_s: str = sym_to_str(ck, fsym_k)
            if len(g.owner) > 0:
                key_s = g.owner + "." + key_s
            m2_put(ck.cleanup_gens, 0, sym_lit(ck, key_s), 1)
    finally:
        gd_pop_scope(g)

def gd_nested_defs(g: GdPass, ck: Ck, a: Ast, sl: int) -> None:
    for i in range(pky(sl)):
        st: int = stmt_at(a, sl, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            gd_process_func(g, ck, a, pay, a.n[st + {{O:Stmt.line}}])
        elif tag == {{T:StmtKind.if_stmt}}:
            gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}))
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                gd_nested_defs(g, ck, a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}}))
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}))
        elif tag == {{T:StmtKind.while_stmt}}:
            gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:WhileStmt.body}}))
        elif tag == {{T:StmtKind.for_stmt}}:
            gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:ForStmt.body}}))
        elif tag == {{T:StmtKind.try_stmt}}:
            gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}))
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                gd_nested_defs(g, ck, a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}))
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}))
        elif tag == {{T:StmtKind.with_stmt}}:
            gd_nested_defs(g, ck, a, sl_at(a, pay, {{O:WithStmt.body}}))

def gd_process_func(g: GdPass, ck: Ck, a: Ast, fd: int, line: int) -> None:
    gd_nested_defs(g, ck, a, sl_at(a, fd, {{O:FuncDef.body}}))
    if not gd_list_has_yield(a, sl_at(a, fd, {{O:FuncDef.body}})):
        return
    saved_uid: int = g.uid
    gd_lower(g, ck, a, fd, line)
    g.uid = saved_uid + 1000

def generator_desugar_run(ck: Ck, a: Ast, body: int) -> None:
    g: GdPass = GdPass()
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            gd_process_func(g, ck, a, pay, a.n[st + {{O:Stmt.line}}])
        elif tag == {{T:StmtKind.class_def}}:
            g.owner = sym_to_str(ck, sym_of(ck, a, pk(a.n[pay + {{O:ClassDef.name}}], a.n[pay + {{O:ClassDef.name}} + 1])))
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for q in range(pky(ms)):
                m: int = stmt_at(a, ms, q)
                msr: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
                if a.n[m + {{O:FuncDef.is_async}}] != 0 and (sref_eq(a, msr, "__aenter__") or sref_eq(a, msr, "__aexit__")):
                    a.n[m + {{O:FuncDef.is_async}}] = 0
                    a.n[m + {{O:FuncDef.allow_await}}] = 1
                gd_process_func(g, ck, a, m, a.n[st + {{O:Stmt.line}}])
            g.owner = ""

def nl_has_nonlocal(a: Ast, s: int) -> bool:
    for i in range(pky(s)):
        st: int = stmt_at(a, s, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            if pky(sl_at(a, pay, {{O:FuncDef.nonlocals}})) > 0 or nl_has_nonlocal(a, sl_at(a, pay, {{O:FuncDef.body}})):
                return True
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for q in range(pky(ms)):
                m: int = stmt_at(a, ms, q)
                if pky(sl_at(a, m, {{O:FuncDef.nonlocals}})) > 0 or nl_has_nonlocal(a, sl_at(a, m, {{O:FuncDef.body}})):
                    return True
        elif tag == {{T:StmtKind.if_stmt}}:
            if nl_has_nonlocal(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
                return True
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                if nl_has_nonlocal(a, sl_at(a, a.l[pkx(ecs) + j], {{O:ElifClause.body}})):
                    return True
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}} and nl_has_nonlocal(a, sl_at(a, pay, {{O:IfStmt.else_body}})):
                return True
        elif tag == {{T:StmtKind.while_stmt}}:
            if nl_has_nonlocal(a, sl_at(a, pay, {{O:WhileStmt.body}})):
                return True
        elif tag == {{T:StmtKind.for_stmt}}:
            if nl_has_nonlocal(a, sl_at(a, pay, {{O:ForStmt.body}})):
                return True
        elif tag == {{T:StmtKind.try_stmt}}:
            if nl_has_nonlocal(a, sl_at(a, pay, {{O:TryStmt.try_body}})):
                return True
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                if nl_has_nonlocal(a, sl_at(a, a.l[pkx(exs) + k], {{O:ExceptClause.body}})):
                    return True
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}} and nl_has_nonlocal(a, sl_at(a, pay, {{O:TryStmt.finally_body}})):
                return True
        elif tag == {{T:StmtKind.with_stmt}}:
            if nl_has_nonlocal(a, sl_at(a, pay, {{O:WithStmt.body}})):
                return True
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            if nl_has_nonlocal(a, sl_at(a, pay, {{O:LowLevelStmt.body}})):
                return True
    return False

def nonlocal_desugar_run(ck: Ck, a: Ast, body: int) -> None:
    if not nl_has_nonlocal(a, body):
        return
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            nl_process_func(ck, a, pay, False)
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for q in range(pky(ms)):
                nl_process_func(ck, a, stmt_at(a, ms, q), False)

# ---- 3.6d: prelude jenerikleri/çağrıları + protocol_def (Zig `tryDesugarPreludeCall`, `shortCircuitAnyAll`, `collectProtocols`, `satisfiesProtocol`, `ensureProtocolBase`, `ensureProtocolBox`, `assignableOrCoerce`) ----
def sym_to_str(ck: Ck, sym: int) -> str:
    tt: TT = ck.tt
    o: int = tt.so[sym]
    out: str = ""
    for i in range(tt.sl[sym]):
        out = out + chr(tt.sb[o + i])
    return out

def is_prelude_name(a: Ast, sr: int) -> bool:
    return sref_eq(a, sr, "max") or sref_eq(a, sr, "min") or sref_eq(a, sr, "sorted") or sref_eq(a, sr, "sum") or sref_eq(a, sr, "round") or sref_eq(a, sr, "map") or sref_eq(a, sr, "filter") or sref_eq(a, sr, "any") or sref_eq(a, sr, "all") or sref_eq(a, sr, "chr") or sref_eq(a, sr, "ord") or sref_eq(a, sr, "divmod")

def mk_dunder_call(a: Ast, obj: int, mname: str, extra_args: list[int]) -> int:
    msr: int = syn(a, mname)
    cal: int = mk_Expr_attribute(a, mk_Attribute(a, obj, pkx(msr), pky(msr)))
    asl: int = list_put_slice(a, extra_args)
    return mk_Expr_call(a, mk_Call(a, cal, pkx(asl), pky(asl), 0, 0, 0, 0, 0, 0))

def mk_ident_call(a: Ast, fname: str, args: list[int]) -> int:
    fsr: int = syn(a, fname)
    cal: int = mk_Expr_identifier(a, pkx(fsr), pky(fsr))
    asl: int = list_put_slice(a, args)
    return mk_Expr_call(a, mk_Call(a, cal, pkx(asl), pky(asl), 0, 0, 0, 0, 0, 0))

def short_circuit_any_all(ck: Ck, a: Ast, fx: Fx, c: int, is_any: bool) -> int:
    args: int = sl_at(a, c, {{O:Call.args}})
    arg0: int = stmt_at(a, args, 0)
    lc: int = a.n[arg0 + 1]
    clauses: int = sl_at(a, lc, {{O:ListComp.clauses}})
    ncl: int = pky(clauses)
    if ncl == 0:
        return -1
    cl0: int = stmt_at(a, clauses, 0)
    if a.n[cl0] != 0:
        return -1
    for ci in range(1, ncl):
        if a.n[stmt_at(a, clauses, ci)] != 1:
            return -1
    fc: int = a.n[cl0 + 1]
    it: int = a.n[fc + {{O:CompForClause.iterable}}]
    src_args: list[int] = []
    callee_name: str = ""
    is_rng: bool = False
    if a.n[it] == {{T:Expr.call}}:
        ic: int = a.n[it + 1]
        ical: int = a.n[ic + {{O:Call.callee}}]
        if a.n[ical] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[ical + 1], a.n[ical + 2]), "range"):
            rsym: int = sym_lit(ck, "range")
            if m2_get(ck.fmap, 0, rsym) < 0 and class_idx(ck, rsym) < 0:
                rargs: int = sl_at(a, ic, {{O:Call.args}})
                nr: int = pky(rargs)
                if nr == 1 or nr == 2:
                    all_pos: bool = True
                    for ri in range(nr):
                        if a.n[stmt_at(a, rargs, ri)] == {{T:Expr.kwarg}}:
                            all_pos = False
                    if all_pos:
                        is_rng = True
                        if nr == 1:
                            src_args.append(mk_Expr_int_lit(a, 0))
                            src_args.append(stmt_at(a, rargs, 0))
                        else:
                            src_args.append(stmt_at(a, rargs, 0))
                            src_args.append(stmt_at(a, rargs, 1))
                        if is_any:
                            callee_name = "__nox_any_range"
                        else:
                            callee_name = "__nox_all_range"
    if not is_rng:
        sv_c: int = len(ck.mb)
        sv_l: int = ck.cur_line
        sv_s: int = ck.cur_span
        it_t: int = -1
        try:
            it_t = check_expr(ck, a, fx, it)
        except CkErr:
            ck.mb = ck.mb[:sv_c]
            ck.cur_line = sv_l
            ck.cur_span = sv_s
            return -1
        if ck.tt.tag[it_t] != 5:
            return -1
        src_args.append(it)
        if is_any:
            callee_name = "__nox_any_pred"
        else:
            callee_name = "__nox_all_pred"
    cond: int = -1
    for ci2 in range(1, ncl):
        ce: int = a.n[stmt_at(a, clauses, ci2) + 1]
        if cond < 0:
            cond = ce
        else:
            cond = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.and_}}, cond, ce, 0, 0, 0, 0))
    elem: int = a.n[lc + {{O:ListComp.elem}}]
    body: int = elem
    if cond >= 0:
        if is_any:
            body = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.and_}}, cond, elem, 0, 0, 0, 0))
        else:
            neg: int = mk_Expr_unary(a, mk_Unary(a, {{E:UnaryOp.not_}}, cond))
            body = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.or_}}, neg, elem, 0, 0, 0, 0))
    lps_st: int = len(a.l)
    a.l.append(a.n[fc + {{O:CompForClause.var_name}}])
    a.l.append(a.n[fc + {{O:CompForClause.var_name}} + 1])
    src_args.append(mk_Expr_lambda(a, mk_Lambda(a, lps_st, 1, body)))
    repl: int = mk_ident_call(a, callee_name, src_args)
    return check_expr(ck, a, fx, repl)

def rename_callee_str(a: Ast, callee: int, new_name: str) -> None:
    sr: int = syn(a, new_name)
    a.n[callee + 1] = pkx(sr)
    a.n[callee + 2] = pky(sr)

def try_desugar_prelude_call(ck: Ck, a: Ast, fx: Fx, c: int, callee: int) -> int:
    cv: int = pk(a.n[callee + 1], a.n[callee + 2])
    args: int = sl_at(a, c, {{O:Call.args}})
    n: int = pky(args)
    has_key: bool = False
    positional: int = 0
    for ai in range(n):
        ae: int = stmt_at(a, args, ai)
        if a.n[ae] == {{T:Expr.kwarg}}:
            kn: int = pk(a.n[a.n[ae + 1] + {{O:Kwarg.name}}], a.n[a.n[ae + 1] + {{O:Kwarg.name}} + 1])
            if sref_eq(a, kn, "key"):
                has_key = True
        else:
            positional = positional + 1
    sym: int = sym_of(ck, a, cv)
    if sref_eq(a, cv, "__nox_cell_of") and n == 1:
        a0_co: int = stmt_at(a, args, 0)
        inner_t: int = -1
        is_eo: bool = False
        if a.n[a0_co] == {{T:Expr.call}}:
            eoc: int = a.n[a0_co + 1]
            eocal: int = a.n[eoc + {{O:Call.callee}}]
            eoargs: int = sl_at(a, eoc, {{O:Call.args}})
            if a.n[eocal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[eocal + 1], a.n[eocal + 2]), "__nox_elem_of") and pky(eoargs) == 1:
                is_eo = True
                ck.lazy_for_iter = -1
                inner_t = check_for_iterable(ck, a, fx, stmt_at(a, eoargs, 0))
                ck.lazy_for_iter = -1
        if not is_eo:
            inner_t = check_expr(ck, a, fx, a0_co)
        itg: int = ck.tt.tag[inner_t]
        if itg == 15 or itg == 4:
            fail2(ck, "TypeMismatch", "a generator variable cannot have an optional or None type here; give it a plain type")
        if itg == 14:
            fbt_sr: int = syn(a, "__nox_FnBox")
            fb_asl: int = ast_expr_list(a, [type_to_type_expr(ck, a, inner_t)])
            fb_te: int = mk_TypeExpr_generic(a, mk_Generic(a, pkx(fbt_sr), pky(fbt_sr), pkx(fb_asl), pky(fb_asl)))
            box_t: int = type_expr_to_type(ck, a, fb_te)
            return ty_list(ck.tt, ty_optional(ck.tt, box_t))
        if itg == 0 or itg == 16 or itg == 1 or itg == 2 or itg == 3 or itg == 5 or itg == 13:
            return ty_list(ck.tt, inner_t)
        return ty_list(ck.tt, ty_optional(ck.tt, inner_t))
    if sref_eq(a, cv, "__nox_get") and n == 1:
        ct_get: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ck.tt.tag[ct_get] != 5:
            fail2(ck, "TypeMismatch", "internal error: '__nox_get' needs a generator cell")
        zero_ix: int = mk_Expr_index(a, mk_Index(a, stmt_at(a, args, 0), mk_Expr_int_lit(a, 0)))
        elem_get: int = ck.tt.xa[ct_get]
        repl_get: int = zero_ix
        if ck.tt.tag[elem_get] == 15:
            unw_sr: int = syn(a, "__nox_unwrap")
            unw_asl: int = ast_expr_list(a, [zero_ix])
            unw: int = mk_Expr_call(a, mk_Call(a, mk_Expr_identifier(a, pkx(unw_sr), pky(unw_sr)), pkx(unw_asl), pky(unw_asl), 0, 0, 0, 0, 0, 0))
            repl_get = unw
            unw_t: int = ck.tt.xa[elem_get]
            if ck.tt.tag[unw_t] == 6:
                unw_s: str = sym_to_str(ck, ck.tt.xa[unw_t])
                if len(unw_s) >= 13 and unw_s[:13] == "__nox_FnBox__":
                    fsr_g: int = syn(a, "f")
                    repl_get = mk_Expr_attribute(a, mk_Attribute(a, unw, pkx(fsr_g), pky(fsr_g)))
        return check_expr(ck, a, fx, repl_get)
    if sref_eq(a, cv, "__nox_for_iter") and n == 1:
        a0_fi: int = stmt_at(a, args, 0)
        at_fi: int = check_expr(ck, a, fx, a0_fi)
        repl_fi: int = -1
        if ck.tt.tag[at_fi] == 6 and has_dunder(ck, at_fi, "__next__"):
            repl_fi = mk_dunder_call(a, a0_fi, "__self__", [])
        else:
            lsr_fi: int = syn(a, "list")
            lasl_fi: int = ast_expr_list(a, [a0_fi])
            lcall_fi: int = mk_Expr_call(a, mk_Call(a, mk_Expr_identifier(a, pkx(lsr_fi), pky(lsr_fi)), pkx(lasl_fi), pky(lasl_fi), 0, 0, 0, 0, 0, 0))
            gsr_fi: int = syn(a, "__nox_gen_from_list")
            gasl_fi: int = ast_expr_list(a, [lcall_fi])
            repl_fi = mk_Expr_call(a, mk_Call(a, mk_Expr_identifier(a, pkx(gsr_fi), pky(gsr_fi)), pkx(gasl_fi), pky(gasl_fi), 0, 0, 0, 0, 0, 0))
        return check_expr(ck, a, fx, repl_fi)
    if class_idx(ck, sym) >= 0 or (m2_get(ck.fmap, 0, sym) >= 0 and not is_prelude_name(a, cv)):
        return -1
    if (sref_eq(a, cv, "any") or sref_eq(a, cv, "all")) and n == 1:
        a0_g: int = stmt_at(a, args, 0)
        if a.n[a0_g] == {{T:Expr.list_comp}} and a.n[a.n[a0_g + 1] + {{O:ListComp.is_genexpr}}] != 0:
            sc_rt: int = short_circuit_any_all(ck, a, fx, c, sref_eq(a, cv, "any"))
            if sc_rt >= 0:
                return sc_rt
    takes_iter: bool = sref_eq(a, cv, "sorted") or sref_eq(a, cv, "sum") or sref_eq(a, cv, "list") or sref_eq(a, cv, "min") or sref_eq(a, cv, "max") or sref_eq(a, cv, "any") or sref_eq(a, cv, "all") or sref_eq(a, cv, "set") or sref_eq(a, cv, "enumerate") or sref_eq(a, cv, "zip") or sref_eq(a, cv, "map") or sref_eq(a, cv, "filter") or sref_eq(a, cv, "reversed")
    if takes_iter:
        has_new: bool = False
        new_args: list[int] = []
        for ai2 in range(n):
            a_i: int = stmt_at(a, args, ai2)
            new_args.append(a_i)
            tg_i: int = a.n[a_i]
            if tg_i == {{T:Expr.kwarg}} or tg_i == {{T:Expr.lambda}} or tg_i == {{T:Expr.string_lit}} or tg_i == {{T:Expr.list_lit}} or tg_i == {{T:Expr.list_comp}}:
                continue
            sv_c: int = len(ck.mb)
            sv_l: int = ck.cur_line
            sv_s: int = ck.cur_span
            at_i: int = -1
            try:
                at_i = check_expr(ck, a, fx, a_i)
            except CkErr:
                ck.mb = ck.mb[:sv_c]
                ck.cur_line = sv_l
                ck.cur_span = sv_s
                at_i = -1
            if at_i >= 0 and has_dunder(ck, at_i, "__iter__"):
                has_new = True
                new_args[ai2] = mk_dunder_call(a, a_i, "__iter__", [])
        if has_new:
            ncal: int = mk_Expr_identifier(a, pkx(cv), pky(cv))
            nasl: int = list_put_slice(a, new_args)
            nrepl: int = mk_Expr_call(a, mk_Call(a, ncal, pkx(nasl), pky(nasl), 0, 0, 0, 0, 0, 0))
            return check_expr(ck, a, fx, nrepl)
    if sref_eq(a, cv, "next") and (n == 1 or n == 2) and positional == n and m2_get(ck.fmap, 0, sym) < 0 and sc_lookup(ck, fx.scope, sym) < 0 and m2_get(ck.globs, 0, sym) < 0:
        sv_c2: int = len(ck.mb)
        sv_l2: int = ck.cur_line
        sv_s2: int = ck.cur_span
        at_n: int = -1
        try:
            at_n = check_expr(ck, a, fx, stmt_at(a, args, 0))
        except CkErr:
            ck.mb = ck.mb[:sv_c2]
            ck.cur_line = sv_l2
            ck.cur_span = sv_s2
            return -1
        if ck.tt.tag[at_n] == 6 and has_dunder(ck, at_n, "__nox_next_raise__"):
            n_repl: int = -1
            if n == 1:
                n_repl = mk_dunder_call(a, stmt_at(a, args, 0), "__nox_next_raise__", [])
            else:
                n_repl = mk_dunder_call(a, stmt_at(a, args, 0), "__nox_next_or__", [stmt_at(a, args, 1)])
            return check_expr(ck, a, fx, n_repl)
    if sref_eq(a, cv, "list") and n == 1 and positional == 1 and m2_get(ck.gfn, 0, sym) < 0:
        arg0: int = stmt_at(a, args, 0)
        is_rng_l: bool = False
        if a.n[arg0] == {{T:Expr.call}}:
            rc: int = a.n[arg0 + 1]
            rcal: int = a.n[rc + {{O:Call.callee}}]
            if a.n[rcal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[rcal + 1], a.n[rcal + 2]), "range"):
                is_rng_l = True
        if is_rng_l:
            ck.lam_cnt = ck.lam_cnt + 1
            vsr: int = syn(a, "__nox_lc_" + str(ck.lam_cnt))
            velem: int = mk_Expr_identifier(a, pkx(vsr), pky(vsr))
            fcl: int = mk_CompClause_for_clause(a, mk_CompForClause(a, pkx(vsr), pky(vsr), arg0))
            csl: int = list_put_slice(a, [fcl])
            lcrepl: int = mk_Expr_list_comp(a, mk_ListComp(a, velem, pkx(csl), pky(csl), {{NONE}}, 0))
            return check_expr(ck, a, fx, lcrepl)
        at_l: int = check_expr(ck, a, fx, arg0)
        if ck.tt.tag[at_l] == 5:
            return check_expr(ck, a, fx, mk_dunder_call(a, arg0, "copy", []))
        if ck.tt.tag[at_l] == 13:
            return check_expr(ck, a, fx, mk_dunder_call(a, arg0, "keys", []))
        if at_l == 3:
            return check_expr(ck, a, fx, mk_ident_call(a, "__nox_str_chars", [arg0]))
        fail2(ck, "TypeMismatch", "'list' only works on list/str/dict/range")
    if sref_eq(a, cv, "set") and n == 1 and positional == 1:
        l_call: int = mk_ident_call(a, "list", [stmt_at(a, args, 0)])
        return check_expr(ck, a, fx, mk_ident_call(a, "__nox_set_from_list", [l_call]))
    if sref_eq(a, cv, "bool") and n == 1 and positional == 1:
        b_arg: int = stmt_at(a, args, 0)
        at_b: int = check_expr(ck, a, fx, b_arg)
        bg: int = ck.tt.tag[at_b]
        if at_b == 2 or at_b == 0 or at_b == 1 or at_b == 3 or bg == 5 or bg == 13:
            return 2
        if bg == 6:
            if has_dunder(ck, at_b, "__bool__"):
                check_expr(ck, a, fx, mk_dunder_call(a, b_arg, "__bool__", []))
                return 2
            if has_dunder(ck, at_b, "__len__"):
                lc_b: int = mk_dunder_call(a, b_arg, "__len__", [])
                check_expr(ck, a, fx, mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.ne}}, lc_b, mk_Expr_int_lit(a, 0), 0, 0, 0, 0)))
                return 2
            return 2
        fail2(ck, "TypeMismatch", "'bool' only works on bool/int/float/str/list/dict/class")
    if (sref_eq(a, cv, "max") or sref_eq(a, cv, "min")) and positional == 1:
        is_max: bool = sref_eq(a, cv, "max")
        has_def: bool = False
        for ai3 in range(n):
            ae3: int = stmt_at(a, args, ai3)
            if a.n[ae3] == {{T:Expr.kwarg}}:
                kn3: int = pk(a.n[a.n[ae3 + 1] + {{O:Kwarg.name}}], a.n[a.n[ae3 + 1] + {{O:Kwarg.name}} + 1])
                if sref_eq(a, kn3, "default"):
                    has_def = True
        if has_key and has_def:
            if is_max:
                rename_callee_str(a, callee, "__nox_max_key_default")
            else:
                rename_callee_str(a, callee, "__nox_min_key_default")
        elif has_def:
            if is_max:
                rename_callee_str(a, callee, "__nox_max_default")
            else:
                rename_callee_str(a, callee, "__nox_min_default")
        elif has_key:
            if is_max:
                rename_callee_str(a, callee, "__nox_max_key")
            else:
                rename_callee_str(a, callee, "__nox_min_key")
        else:
            if is_max:
                rename_callee_str(a, callee, "__nox_max_list")
            else:
                rename_callee_str(a, callee, "__nox_min_list")
        return -1
    if (sref_eq(a, cv, "max") or sref_eq(a, cv, "min")) and positional >= 3 and positional == n:
        if sref_eq(a, cv, "max"):
            rename_callee_str(a, callee, "__nox_max_many")
        else:
            rename_callee_str(a, callee, "__nox_min_many")
        return -1
    if positional == n:
        if n == 1 and (sref_eq(a, cv, "hex") or sref_eq(a, cv, "oct") or sref_eq(a, cv, "bin")):
            if sref_eq(a, cv, "hex"):
                rename_callee_str(a, callee, "__nox_hex")
            elif sref_eq(a, cv, "oct"):
                rename_callee_str(a, callee, "__nox_oct")
            else:
                rename_callee_str(a, callee, "__nox_bin")
            return -1
        if sref_eq(a, cv, "pow") and (n == 2 or n == 3):
            at_p: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
            if n == 3:
                rename_callee_str(a, callee, "__nox_pow_mod")
            elif at_p == 0:
                rename_callee_str(a, callee, "__nox_pow_int")
            else:
                rename_callee_str(a, callee, "__nox_pow_float")
            return -1
        if sref_eq(a, cv, "int") and n == 2:
            rename_callee_str(a, callee, "__nox_int_base")
            return -1
        if sref_eq(a, cv, "zip") and n == 3:
            rename_callee_str(a, callee, "__nox_zip3")
            return -1
    if sref_eq(a, cv, "sorted") and has_key:
        rename_callee_str(a, callee, "__nox_sorted_key")
        return -1
    if sref_eq(a, cv, "sum") and (n == 1 or n == 2):
        at_s: int = check_expr(ck, a, fx, stmt_at(a, args, 0))
        if ck.tt.tag[at_s] == 5 and ck.tt.xa[at_s] == 1:
            rename_callee_str(a, callee, "sum_float")
        return -1
    if sref_eq(a, cv, "format") and n == 2 and positional == 2 and m2_get(ck.fmap, 0, sym) < 0:
        f_a0: int = stmt_at(a, args, 0)
        f_a1: int = stmt_at(a, args, 1)
        at_f: int = check_expr(ck, a, fx, f_a0)
        st_f: int = check_expr(ck, a, fx, f_a1)
        if st_f != 3:
            fail2(ck, "TypeMismatch", "the second argument of 'format' (the spec) must be a str")
        empty_spec: bool = a.n[f_a1] == {{T:Expr.string_lit}} and a.n[f_a1 + 2] == 0
        if at_f == 0:
            rename_callee_str(a, callee, "__nox_format_int")
            return -1
        if at_f == 1:
            rename_callee_str(a, callee, "__nox_format_float")
            return -1
        if at_f == 3:
            rename_callee_str(a, callee, "__nox_format_str")
            return -1
        if at_f == 2 or ck.tt.tag[at_f] == 6:
            if empty_spec or (ck.tt.tag[at_f] == 6 and has_dunder(ck, at_f, "__str__")):
                return check_expr(ck, a, fx, mk_ident_call(a, "str", [f_a0]))
            if at_f == 2:
                tern: int = mk_Expr_ternary(a, mk_Ternary(a, f_a0, mk_Expr_int_lit(a, 1), mk_Expr_int_lit(a, 0)))
                return check_expr(ck, a, fx, mk_ident_call(a, "__nox_format_int", [tern, f_a1]))
            fail2(ck, "TypeMismatch", "'format' for class values requires `__str__` and an empty spec")
        fail2(ck, "TypeMismatch", "'format' only works for int/float/str/bool (and classes that have `__str__`)")
    if sref_eq(a, cv, "round") and n == 2:
        rename_callee_str(a, callee, "__nox_round_digits")
        return -1
    return -1

def collect_protocols(ck: Ck, a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        ck.cur_span = a.n[st + {{O:Stmt.span}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.protocol_def}}:
            continue
        pd: int = a.n[kn + 1]
        pn: int = pk(a.n[pd + {{O:ProtocolDef.name}}], a.n[pd + {{O:ProtocolDef.name}} + 1])
        psym: int = sym_of(ck, a, pn)
        if m2_get(ck.proto_defs, 0, psym) >= 0:
            mp(ck, "protocol already defined: ")
            mp_sref(ck, a, pn)
            raise mk_fail(ck, "DuplicateDefinition")
        ms: int = sl_at(a, pd, {{O:ProtocolDef.methods}})
        nm_m: int = pky(ms)
        pi: int = len(ck.proto_ms)
        m_st: int = len(ck.proto_mname)
        for j in range(nm_m):
            m: int = stmt_at(a, ms, j)
            mn: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
            if pky(sl_at(a, m, {{O:FuncDef.type_params}})) > 0:
                mp(ck, "protocol methods cannot be generic: ")
                mp_sref(ck, a, pn)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                raise mk_fail(ck, "TypeMismatch")
            mps: int = sl_at(a, m, {{O:FuncDef.params}})
            if pky(mps) == 0:
                mp(ck, "protocol method '")
                mp_sref(ck, a, pn)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "' must take 'self' as its first parameter")
                raise mk_fail(ck, "TypeMismatch")
            p0: int = stmt_at(a, mps, 0)
            p0n: int = pk(a.n[p0 + {{O:Param.name}}], a.n[p0 + {{O:Param.name}} + 1])
            if not sref_eq(a, p0n, "self"):
                mp(ck, "protocol method '")
                mp_sref(ck, a, pn)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "' must take 'self' as its first parameter")
                raise mk_fail(ck, "TypeMismatch")
            p0te: int = a.n[p0 + {{O:Param.type_expr}}]
            self_ok: bool = a.n[p0te] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[p0te + 1], a.n[p0te + 2]), sym_to_str(ck, psym))
            if not self_ok:
                mp(ck, "inside protocol method '")
                mp_sref(ck, a, pn)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "', the type of 'self' must be '")
                mp_sref(ck, a, pn)
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            mbd: int = sl_at(a, m, {{O:FuncDef.body}})
            if pky(mbd) != 1 or a.n[a.n[stmt_at(a, mbd, 0) + {{O:Stmt.kind}}]] != {{T:StmtKind.pass_stmt}}:
                mp(ck, "protocol method '")
                mp_sref(ck, a, pn)
                mp(ck, ".")
                mp_sref(ck, a, mn)
                mp(ck, "' can only have a 'pass' body (signature only)")
                raise mk_fail(ck, "TypeMismatch")
            ptys: list[int] = []
            pnms: list[int] = []
            for k in range(1, pky(mps)):
                pk_p: int = stmt_at(a, mps, k)
                ptys.append(type_expr_to_type(ck, a, a.n[pk_p + {{O:Param.type_expr}}]))
                pnms.append(sym_of(ck, a, pk(a.n[pk_p + {{O:Param.name}}], a.n[pk_p + {{O:Param.name}} + 1])))
            pret: int = type_expr_to_type(ck, a, a.n[m + {{O:FuncDef.return_type}}])
            ck.proto_mname.append(sym_of(ck, a, mn))
            ck.proto_msig.append(new_sig(ck, ptys, pnms, pret))
        ck.proto_ms.append(m_st)
        ck.proto_mn.append(nm_m)
        m2_put(ck.proto_defs, 0, psym, pd)
        m2_put(ck.proto_idx, 0, psym, pi)

def collect_protocol_names(ck: Ck, a: Ast, te: int, out_syms: list[int], out_srefs: list[int]) -> None:
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        sr: int = pk(a.n[te + 1], a.n[te + 2])
        sym: int = sym_of(ck, a, sr)
        if m2_get(ck.proto_defs, 0, sym) >= 0:
            found: bool = False
            for i in range(len(out_syms)):
                if out_syms[i] == sym:
                    found = True
                    break
            if not found:
                out_syms.append(sym)
                out_srefs.append(sr)
        return
    if tag == {{T:TypeExpr.generic}}:
        gargs: int = sl_at(a, a.n[te + 1], {{O:Generic.args}})
        for i2 in range(pky(gargs)):
            collect_protocol_names(ck, a, stmt_at(a, gargs, i2), out_syms, out_srefs)
        return
    if tag == {{T:TypeExpr.func_type}}:
        ft: int = a.n[te + 1]
        fps: int = sl_at(a, ft, {{O:FuncTypeExpr.params}})
        for i3 in range(pky(fps)):
            collect_protocol_names(ck, a, stmt_at(a, fps, i3), out_syms, out_srefs)
        collect_protocol_names(ck, a, a.n[ft + {{O:FuncTypeExpr.return_type}}], out_syms, out_srefs)
        return
    if tag == {{T:TypeExpr.optional}}:
        collect_protocol_names(ck, a, a.n[te + 1], out_syms, out_srefs)

def mentions_protocol(ck: Ck, a: Ast, te: int) -> bool:
    if len(ck.proto_ms) == 0:
        return False
    syms: list[int] = []
    srefs: list[int] = []
    collect_protocol_names(ck, a, te, syms, srefs)
    return len(syms) > 0

def satisfies_protocol(ck: Ck, actual: int, proto_sym: int, fn_sym: int) -> None:
    if ck.tt.tag[actual] != 6:
        mp(ck, "in the call to '")
        mp_sym(ck, fn_sym)
        mp(ck, "', '")
        mp_sym(ck, proto_sym)
        mp(ck, "' can only match class instances")
        raise mk_fail(ck, "TypeMismatch")
    csym: int = ck.tt.xa[actual]
    ci: int = class_idx(ck, csym)
    pi: int = ck.proto_idx.vv[m2_get(ck.proto_idx, 0, proto_sym)]
    st: int = ck.proto_ms[pi]
    nm: int = ck.proto_mn[pi]
    for i in range(nm):
        msym: int = ck.proto_mname[st + i]
        psid: int = ck.proto_msig[st + i]
        me: int = m2_get(ck.cls_meths, ci, msym)
        if me < 0:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "' does not satisfy protocol '")
            mp_sym(ck, proto_sym)
            mp(ck, "': method '")
            mp_sym(ck, msym)
            mp(ck, "' is missing")
            raise mk_fail(ck, "TypeMismatch")
        csid: int = ck.cls_meths.vv[me]
        if ck.fpn[csid] != ck.fpn[psid]:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': method '")
            mp_sym(ck, msym)
            mp(ck, "' does not match protocol '")
            mp_sym(ck, proto_sym)
            mp(ck, "' (parameter count)")
            raise mk_fail(ck, "TypeMismatch")
        for j in range(ck.fpn[psid]):
            if ck.fpar[ck.fps[csid] + j] != ck.fpar[ck.fps[psid] + j]:
                mp(ck, "class '")
                mp_sym(ck, csym)
                mp(ck, "': method '")
                mp_sym(ck, msym)
                mp(ck, "' does not match protocol '")
                mp_sym(ck, proto_sym)
                mp(ck, "' (parameter type)")
                raise mk_fail(ck, "TypeMismatch")
        if ck.fret[csid] != ck.fret[psid]:
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': method '")
            mp_sym(ck, msym)
            mp(ck, "' does not match protocol '")
            mp_sym(ck, proto_sym)
            mp(ck, "' (return type)")
            raise mk_fail(ck, "TypeMismatch")

def class_satisfies_protocol(ck: Ck, cls_sym: int, proto_sym: int) -> bool:
    pe: int = m2_get(ck.proto_idx, 0, proto_sym)
    if pe < 0:
        return False
    ci: int = class_idx(ck, cls_sym)
    if ci < 0:
        return False
    pi: int = ck.proto_idx.vv[pe]
    st: int = ck.proto_ms[pi]
    nm: int = ck.proto_mn[pi]
    for i in range(nm):
        msym: int = ck.proto_mname[st + i]
        psid: int = ck.proto_msig[st + i]
        me: int = m2_get(ck.cls_meths, ci, msym)
        if me < 0:
            return False
        csid: int = ck.cls_meths.vv[me]
        if ck.fpn[csid] != ck.fpn[psid]:
            return False
        for j in range(ck.fpn[psid]):
            if ck.fpar[ck.fps[csid] + j] != ck.fpar[ck.fps[psid] + j]:
                return False
        if ck.fret[csid] != ck.fret[psid]:
            return False
    return True

def require_value_safe_protocol(ck: Ck, a: Ast, pd: int, proto_sym: int) -> None:
    ms: int = sl_at(a, pd, {{O:ProtocolDef.methods}})
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        syms: list[int] = []
        srefs: list[int] = []
        mps: int = sl_at(a, m, {{O:FuncDef.params}})
        for j in range(1, pky(mps)):
            collect_protocol_names(ck, a, a.n[stmt_at(a, mps, j) + {{O:Param.type_expr}}], syms, srefs)
        collect_protocol_names(ck, a, a.n[m + {{O:FuncDef.return_type}}], syms, srefs)
        if len(syms) > 0:
            mp(ck, "protocol '")
            mp_sym(ck, proto_sym)
            mp(ck, "' cannot be used as a value type: method '")
            mp_sref(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1]))
            mp(ck, "' mentions the protocol type '")
            mp_sym(ck, syms[0])
            mp(ck, "' in its signature (not supported)")
            raise mk_fail(ck, "TypeMismatch")

def register_synthetic_class(ck: Ck, a: Ast, csym: int, cd: int) -> None:
    sv_l: int = ck.cur_line
    sv_s: int = ck.cur_span
    try:
        ci: int = len(ck.cls_sym)
        ck.cls_sym.append(csym)
        ck.cls_node.append(cd)
        ck.cls_init.append(-1)
        ck.cls_base.append(-1)
        ck.cls_regd.append(0)
        ck.cls_chk.append(0)
        ck.tup_s.append(-1)
        ck.tup_n.append(0)
        ck.cls_synth.append(1)
        ck.gcls_ts.append(-1)
        ck.gcls_tn.append(0)
        m2_put(ck.cls_map, 0, csym, ci)
        cls_register(ck.tt, csym)
        ensure_class_sig(ck, a, ci)
        ensure_class_checked(ck, a, ci)
    finally:
        ck.cur_line = sv_l
        ck.cur_span = sv_s

def ensure_protocol_base(ck: Ck, a: Ast, proto_sym: int) -> int:
    p_str: str = sym_to_str(ck, proto_sym)
    b_str: str = p_str + "__Base"
    bsym: int = sym_lit(ck, b_str)
    if class_idx(ck, bsym) >= 0:
        return ty_class(ck.tt, bsym)
    pd: int = ck.proto_defs.vv[m2_get(ck.proto_defs, 0, proto_sym)]
    require_value_safe_protocol(ck, a, pd, proto_sym)
    bsr: int = syn(a, b_str)
    ms: int = sl_at(a, pd, {{O:ProtocolDef.methods}})
    has_ve: bool = class_idx(ck, sym_lit(ck, "ValueError")) >= 0
    mids: list[int] = []
    ssr: int = syn(a, "self")
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        mps: int = sl_at(a, m, {{O:FuncDef.params}})
        pids: list[int] = [mk_Param(a, pkx(ssr), pky(ssr), 0, 0, 0, 0, mk_TypeExpr_simple(a, pkx(bsr), pky(bsr)), 1, -1)]
        for j in range(1, pky(mps)):
            p: int = stmt_at(a, mps, j)
            pids.append(mk_Param(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1], 0, 0, 0, 0, a.n[p + {{O:Param.type_expr}}], 0, -1))
        psl: int = list_put_slice(a, pids)
        mn: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
        mret: int = a.n[m + {{O:FuncDef.return_type}}]
        st_id: int = -1
        if has_ve:
            m_str: str = sym_to_str(ck, sym_of(ck, a, mn))
            msgsr: int = syn(a, "abstract protocol method " + p_str + "." + m_str + " was called")
            rcal: int = mk_ident_call(a, "ValueError", [mk_Expr_string_lit(a, pkx(msgsr), pky(msgsr))])
            st_id = mk_Stmt(a, mk_StmtKind_raise_stmt(a, rcal), ck.cur_line, ck.cur_span)
        else:
            s_ref: int = mk_Expr_identifier(a, pkx(ssr), pky(ssr))
            cargs: list[int] = []
            for j2 in range(1, pky(mps)):
                p2: int = stmt_at(a, mps, j2)
                cargs.append(mk_Expr_identifier(a, a.n[p2 + {{O:Param.name}}], a.n[p2 + {{O:Param.name}} + 1]))
            casl: int = list_put_slice(a, cargs)
            cal: int = mk_Expr_call(a, mk_Call(a, mk_Expr_attribute(a, mk_Attribute(a, s_ref, pkx(mn), pky(mn))), pkx(casl), pky(casl), 0, 0, 0, 0, 0, 0))
            ret_none: bool = a.n[mret] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[mret + 1], a.n[mret + 2]), "None")
            if ret_none:
                st_id = mk_Stmt(a, mk_StmtKind_expr_stmt(a, cal), ck.cur_line, ck.cur_span)
            else:
                st_id = mk_Stmt(a, mk_StmtKind_return_stmt(a, cal), ck.cur_line, ck.cur_span)
        bsl: int = list_put_slice(a, [st_id])
        mids.append(mk_FuncDef(a, pkx(mn), pky(mn), 0, 0, pkx(psl), pky(psl), mret, 0, pkx(bsl), pky(bsl), 0, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, ck.cur_line))
    msl: int = list_put_slice(a, mids)
    cd: int = mk_ClassDef(a, pkx(bsr), pky(bsr), 0, 0, {{NONE}}, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, 0, 0, 0, pkx(msl), pky(msl), 0, 0, 0, 0, 0, 0)
    register_synthetic_class(ck, a, bsym, cd)
    m2_put(ck.proto_bases, 0, bsym, proto_sym)
    return ty_class(ck.tt, bsym)

def ensure_protocol_box(ck: Ck, a: Ast, proto_sym: int, cls_sym: int) -> int:
    ensure_protocol_base(ck, a, proto_sym)
    p_str: str = sym_to_str(ck, proto_sym)
    c_str: str = sym_to_str(ck, cls_sym)
    b_str: str = p_str + "__Base"
    box_str: str = p_str + "__Box_" + c_str
    box_sym: int = sym_lit(ck, box_str)
    if class_idx(ck, box_sym) >= 0:
        return box_sym
    pd: int = ck.proto_defs.vv[m2_get(ck.proto_defs, 0, proto_sym)]
    bsr: int = syn(a, b_str)
    boxsr: int = syn(a, box_str)
    csr: int = syn(a, c_str)
    insr: int = syn(a, "inner")
    ssr: int = syn(a, "self")
    nsr: int = syn(a, "None")
    inisr: int = syn(a, "__init__")
    fld: int = mk_FieldDecl(a, pkx(insr), pky(insr), mk_TypeExpr_simple(a, pkx(csr), pky(csr)), ck.cur_line)
    fsl: int = list_put_slice(a, [fld])
    ip0: int = mk_Param(a, pkx(ssr), pky(ssr), 0, 0, 0, 0, mk_TypeExpr_simple(a, pkx(boxsr), pky(boxsr)), 1, -1)
    ip1: int = mk_Param(a, pkx(insr), pky(insr), 0, 0, 0, 0, mk_TypeExpr_simple(a, pkx(csr), pky(csr)), 0, -1)
    ipsl: int = list_put_slice(a, [ip0, ip1])
    itg: int = mk_Expr_attribute(a, mk_Attribute(a, mk_Expr_identifier(a, pkx(ssr), pky(ssr)), pkx(insr), pky(insr)))
    ival: int = mk_Expr_identifier(a, pkx(insr), pky(insr))
    ist: int = mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, itg, ival, {{NONE}})), ck.cur_line, ck.cur_span)
    ibsl: int = list_put_slice(a, [ist])
    mids: list[int] = [mk_FuncDef(a, pkx(inisr), pky(inisr), 0, 0, pkx(ipsl), pky(ipsl), mk_TypeExpr_simple(a, pkx(nsr), pky(nsr)), 0, pkx(ibsl), pky(ibsl), 0, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, ck.cur_line)]
    ms: int = sl_at(a, pd, {{O:ProtocolDef.methods}})
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        mps: int = sl_at(a, m, {{O:FuncDef.params}})
        pids: list[int] = [mk_Param(a, pkx(ssr), pky(ssr), 0, 0, 0, 0, mk_TypeExpr_simple(a, pkx(boxsr), pky(boxsr)), 1, -1)]
        cargs: list[int] = []
        for j in range(1, pky(mps)):
            p: int = stmt_at(a, mps, j)
            pids.append(mk_Param(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1], 0, 0, 0, 0, a.n[p + {{O:Param.type_expr}}], 0, -1))
            cargs.append(mk_Expr_identifier(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]))
        psl: int = list_put_slice(a, pids)
        mn: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
        mret: int = a.n[m + {{O:FuncDef.return_type}}]
        in_ref: int = mk_Expr_attribute(a, mk_Attribute(a, mk_Expr_identifier(a, pkx(ssr), pky(ssr)), pkx(insr), pky(insr)))
        casl: int = list_put_slice(a, cargs)
        cal: int = mk_Expr_call(a, mk_Call(a, mk_Expr_attribute(a, mk_Attribute(a, in_ref, pkx(mn), pky(mn))), pkx(casl), pky(casl), 0, 0, 0, 0, 0, 0))
        ret_none: bool = a.n[mret] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[mret + 1], a.n[mret + 2]), "None")
        st_id: int = -1
        if ret_none:
            st_id = mk_Stmt(a, mk_StmtKind_expr_stmt(a, cal), ck.cur_line, ck.cur_span)
        else:
            st_id = mk_Stmt(a, mk_StmtKind_return_stmt(a, cal), ck.cur_line, ck.cur_span)
        bsl: int = list_put_slice(a, [st_id])
        mids.append(mk_FuncDef(a, pkx(mn), pky(mn), 0, 0, pkx(psl), pky(psl), mret, 0, pkx(bsl), pky(bsl), 0, 0, 0, {{NONE}}, 0, 0, 0, 0, 0, 0, ck.cur_line))
    msl: int = list_put_slice(a, mids)
    cd: int = mk_ClassDef(a, pkx(boxsr), pky(boxsr), 0, 0, {{NONE}}, 0, pkx(bsr), pky(bsr), 0, 0, 0, 0, 0, 0, 0, 0, pkx(msl), pky(msl), pkx(fsl), pky(fsl), 0, 0, 0, 0)
    register_synthetic_class(ck, a, box_sym, cd)
    return box_sym

def assignable_or_coerce(ck: Ck, a: Ast, declared: int, value: int) -> bool:
    if ty_assignable(ck.tt, declared, value):
        return True
    target: int = declared
    if ck.tt.tag[declared] == 15:
        target = ck.tt.xa[declared]
    if ck.tt.tag[target] == 6 and ck.tt.tag[value] == 14:
        tsym: int = ck.tt.xa[target]
        tstr: str = sym_to_str(ck, tsym)
        if len(tstr) >= 13 and tstr[:13] == "__nox_FnBox__":
            ci_f: int = class_idx(ck, tsym)
            if ci_f >= 0 and ck.gcls_tn[ci_f] == 1 and ck.gcls_te[ck.gcls_ts[ci_f]] == value:
                return True
    if ck.tt.tag[target] != 6 or ck.tt.tag[value] != 6:
        return False
    pe: int = m2_get(ck.proto_bases, 0, ck.tt.xa[target])
    if pe < 0:
        return False
    psym: int = ck.proto_bases.vv[pe]
    if not class_satisfies_protocol(ck, ck.tt.xa[value], psym):
        return False
    ensure_protocol_box(ck, a, psym, ck.tt.xa[value])
    return True

def ta_subst_te(ck: Ck, a: Ast, te: int, ta_map: Map2, memo: Map2, stack: list[int], mal_map: Map2, mal_segs: list[int]) -> int:
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        nm: int = sym_of(ck, a, pk(a.n[te + 1], a.n[te + 2]))
        if m2_get(ta_map, 0, nm) >= 0:
            return ta_resolve(ck, a, nm, te, ta_map, memo, stack, mal_map, mal_segs)
        return te
    if tag == {{T:TypeExpr.generic}}:
        g: int = a.n[te + 1]
        gs: int = sl_at(a, g, {{O:Generic.args}})
        nargs: list[int] = []
        for i in range(pky(gs)):
            nargs.append(ta_subst_te(ck, a, stmt_at(a, gs, i), ta_map, memo, stack, mal_map, mal_segs))
        nsl: int = list_put_slice(a, nargs)
        return mk_TypeExpr_generic(a, mk_Generic(a, a.n[g + {{O:Generic.name}}], a.n[g + {{O:Generic.name}} + 1], pkx(nsl), pky(nsl)))
    if tag == {{T:TypeExpr.func_type}}:
        ft: int = a.n[te + 1]
        ps: int = sl_at(a, ft, {{O:FuncTypeExpr.params}})
        nps: list[int] = []
        for i2 in range(pky(ps)):
            nps.append(ta_subst_te(ck, a, stmt_at(a, ps, i2), ta_map, memo, stack, mal_map, mal_segs))
        nsl2: int = list_put_slice(a, nps)
        nr: int = ta_subst_te(ck, a, a.n[ft + {{O:FuncTypeExpr.return_type}}], ta_map, memo, stack, mal_map, mal_segs)
        return mk_TypeExpr_func_type(a, mk_FuncTypeExpr(a, pkx(nsl2), pky(nsl2), nr))
    if tag == {{T:TypeExpr.qualified}}:
        q0: int = a.n[te + 1]
        qn: int = a.n[te + 2]
        if qn < 2:
            return te
        s0: int = sym_of(ck, a, pk(a.l[q0], a.l[q0 + 1]))
        full: list[int] = []
        mae: int = m2_get(mal_map, 0, s0)
        if mae >= 0:
            msl: int = mal_map.vv[mae]
            m0: int = pkx(msl)
            mn: int = pky(msl)
            for mi in range(mn):
                full.append(mal_segs[m0 + mi])
        else:
            full.append(s0)
        for qi in range(1, qn):
            full.append(sym_of(ck, a, pk(a.l[q0 + qi * 2], a.l[q0 + qi * 2 + 1])))
        mangled: int = join_syms(ck, full, len(full), 95)
        if m2_get(ta_map, 0, mangled) < 0:
            return te
        return ta_resolve(ck, a, mangled, te, ta_map, memo, stack, mal_map, mal_segs)
    if tag == {{T:TypeExpr.optional}}:
        return mk_TypeExpr_optional(a, ta_subst_te(ck, a, a.n[te + 1], ta_map, memo, stack, mal_map, mal_segs))
    return te

def ta_resolve(ck: Ck, a: Ast, nsym: int, orig_te: int, ta_map: Map2, memo: Map2, stack: list[int], mal_map: Map2, mal_segs: list[int]) -> int:
    me: int = m2_get(memo, 0, nsym)
    if me >= 0:
        return memo.vv[me]
    for i in range(len(stack)):
        if stack[i] == nsym:
            mp(ck, "the type alias '")
            mp_sym(ck, nsym)
            mp(ck, "' refers to itself (")
            for k in range(i, len(stack)):
                mp_sym(ck, stack[k])
                mp(ck, " -> ")
            mp_sym(ck, nsym)
            mp(ck, ")")
            raise mk_fail(ck, "TypeMismatch")
    if len(stack) >= 2000:
        mp(ck, "the type alias '")
        mp_sym(ck, nsym)
        mp(ck, "' is nested too deeply (more than 2000 aliases in one chain)")
        raise mk_fail(ck, "TypeMismatch")
    target: int = ta_map.vv[m2_get(ta_map, 0, nsym)]
    stack.append(nsym)
    r: int = ta_subst_te(ck, a, target, ta_map, memo, stack, mal_map, mal_segs)
    stack.pop()
    m2_put(memo, 0, nsym, r)
    return r

def ta_walk_expr(ck: Ck, a: Ast, e: int, ta_map: Map2, memo: Map2, stack: list[int], mal_map: Map2, mal_segs: list[int]) -> None:
    if e < 0:
        return
    tag: int = a.n[e]
    if tag <= {{T:Expr.identifier}}:
        return
    if tag == {{T:Expr.unary}}:
        ta_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[bp + {{O:Binary.left}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[bp + {{O:Binary.right}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[cp + {{O:Call.callee}}], ta_map, memo, stack, mal_map, mal_segs)
        cas: int = sl_at(a, cp, {{O:Call.args}})
        for i in range(pky(cas)):
            ta_walk_expr(ck, a, stmt_at(a, cas, i), ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.attribute}}:
        ta_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Attribute.obj}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[ip + {{O:Index.obj}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[ip + {{O:Index.index}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        el: int = sl_at(a, e, 1)
        for i2 in range(pky(el)):
            ta_walk_expr(ck, a, stmt_at(a, el, i2), ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.dict_lit}}:
        dl: int = sl_at(a, e, 1)
        for i3 in range(pky(dl)):
            dp: int = a.l[pkx(dl) + i3]
            ta_walk_expr(ck, a, a.n[dp + {{O:DictPair.key}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_expr(ck, a, a.n[dp + {{O:DictPair.value}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        ta_walk_expr(ck, a, a.n[e + 1], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[e + 1]
        tas: int = sl_at(a, gc, {{O:GenericConstruct.type_args}})
        for ti in range(pky(tas)):
            a.l[pkx(tas) + ti] = ta_subst_te(ck, a, a.l[pkx(tas) + ti], ta_map, memo, stack, mal_map, mal_segs)
        gas: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for gi in range(pky(gas)):
            ta_walk_expr(ck, a, stmt_at(a, gas, gi), ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[tp + {{O:Ternary.cond}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[tp + {{O:Ternary.then_expr}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[tp + {{O:Ternary.else_expr}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.kwarg}}:
        ta_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.slice}}:
        sp: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[sp + {{O:Slice.obj}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[sp + {{O:Slice.lo}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[sp + {{O:Slice.hi}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[sp + {{O:Slice.step}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.lambda}}:
        ta_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Lambda.body}}], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[lc + {{O:ListComp.elem}}], ta_map, memo, stack, mal_map, mal_segs)
        cls: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for ci in range(pky(cls)):
            cl: int = a.l[pkx(cls) + ci]
            if a.n[cl] == {{T:CompClause.for_clause}}:
                ta_walk_expr(ck, a, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], ta_map, memo, stack, mal_map, mal_segs)
            else:
                ta_walk_expr(ck, a, a.n[cl + 1], ta_map, memo, stack, mal_map, mal_segs)
        return
    if tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        ta_walk_expr(ck, a, a.n[dc + {{O:DictComp.key}}], ta_map, memo, stack, mal_map, mal_segs)
        ta_walk_expr(ck, a, a.n[dc + {{O:DictComp.value}}], ta_map, memo, stack, mal_map, mal_segs)
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for di in range(pky(dcls)):
            dcl: int = a.l[pkx(dcls) + di]
            if a.n[dcl] == {{T:CompClause.for_clause}}:
                ta_walk_expr(ck, a, a.n[a.n[dcl + 1] + {{O:CompForClause.iterable}}], ta_map, memo, stack, mal_map, mal_segs)
            else:
                ta_walk_expr(ck, a, a.n[dcl + 1], ta_map, memo, stack, mal_map, mal_segs)

def ta_walk_func(ck: Ck, a: Ast, fd: int, ta_map: Map2, memo: Map2, stack: list[int], mal_map: Map2, mal_segs: list[int]) -> None:
    ps: int = sl_at(a, fd, {{O:FuncDef.params}})
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        a.n[p + {{O:Param.type_expr}}] = ta_subst_te(ck, a, a.n[p + {{O:Param.type_expr}}], ta_map, memo, stack, mal_map, mal_segs)
        if a.n[p + {{O:Param.default}}] >= 0:
            ta_walk_expr(ck, a, a.n[p + {{O:Param.default}}], ta_map, memo, stack, mal_map, mal_segs)
    a.n[fd + {{O:FuncDef.return_type}}] = ta_subst_te(ck, a, a.n[fd + {{O:FuncDef.return_type}}], ta_map, memo, stack, mal_map, mal_segs)
    ta_walk_stmts(ck, a, sl_at(a, fd, {{O:FuncDef.body}}), ta_map, memo, stack, mal_map, mal_segs)

def ta_walk_stmts(ck: Ck, a: Ast, body: int, ta_map: Map2, memo: Map2, stack: list[int], mal_map: Map2, mal_segs: list[int]) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        ck.cur_line = a.n[st + {{O:Stmt.line}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.var_decl}}:
            a.n[pay + {{O:VarDecl.type_expr}}] = ta_subst_te(ck, a, a.n[pay + {{O:VarDecl.type_expr}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_expr(ck, a, a.n[pay + {{O:VarDecl.value}}], ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.assign}}:
            if a.n[pay + {{O:Assign.ann}}] >= 0:
                a.n[pay + {{O:Assign.ann}}] = ta_subst_te(ck, a, a.n[pay + {{O:Assign.ann}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_expr(ck, a, a.n[pay + {{O:Assign.target}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_expr(ck, a, a.n[pay + {{O:Assign.value}}], ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            ta_walk_expr(ck, a, pay, ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                ta_walk_expr(ck, a, pay, ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.defer_stmt}}:
            dc: int = a.n[pay + {{O:DeferStmt.call}}]
            ta_walk_expr(ck, a, a.n[dc + {{O:Call.callee}}], ta_map, memo, stack, mal_map, mal_segs)
            dargs: int = sl_at(a, dc, {{O:Call.args}})
            for di in range(pky(dargs)):
                ta_walk_expr(ck, a, stmt_at(a, dargs, di), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.if_stmt}}:
            ta_walk_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), ta_map, memo, stack, mal_map, mal_segs)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                ec: int = a.l[pkx(ecs) + ei]
                ta_walk_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}], ta_map, memo, stack, mal_map, mal_segs)
                ta_walk_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}), ta_map, memo, stack, mal_map, mal_segs)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                ta_walk_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.while_stmt}}:
            ta_walk_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.for_stmt}}:
            ta_walk_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.try_stmt}}:
            ta_walk_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), ta_map, memo, stack, mal_map, mal_segs)
            txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for ti in range(pky(txs)):
                ta_walk_stmts(ck, a, sl_at(a, a.l[pkx(txs) + ti], {{O:ExceptClause.body}}), ta_map, memo, stack, mal_map, mal_segs)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                ta_walk_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.with_stmt}}:
            ta_walk_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}], ta_map, memo, stack, mal_map, mal_segs)
            ta_walk_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            ta_walk_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.func_def}}:
            ta_walk_func(ck, a, pay, ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.class_def}}:
            fs: int = sl_at(a, pay, {{O:ClassDef.fields}})
            for fi in range(pky(fs)):
                f: int = stmt_at(a, fs, fi)
                a.n[f + {{O:FieldDecl.type_expr}}] = ta_subst_te(ck, a, a.n[f + {{O:FieldDecl.type_expr}}], ta_map, memo, stack, mal_map, mal_segs)
            kds: int = sl_at(a, pay, {{O:ClassDef.consts}})
            for ki in range(pky(kds)):
                kd: int = stmt_at(a, kds, ki)
                a.n[kd + {{O:ConstDecl.type_expr}}] = ta_subst_te(ck, a, a.n[kd + {{O:ConstDecl.type_expr}}], ta_map, memo, stack, mal_map, mal_segs)
                ta_walk_expr(ck, a, a.n[kd + {{O:ConstDecl.value}}], ta_map, memo, stack, mal_map, mal_segs)
            bas: int = sl_at(a, pay, {{O:ClassDef.base_args}})
            for bi in range(pky(bas)):
                a.l[pkx(bas) + bi] = ta_subst_te(ck, a, a.l[pkx(bas) + bi], ta_map, memo, stack, mal_map, mal_segs)
            evs: int = sl_at(a, pay, {{O:ClassDef.enum_variants}})
            for evi in range(pky(evs)):
                ev: int = stmt_at(a, evs, evi)
                vfs: int = sl_at(a, ev, {{O:EnumVariant.fields}})
                for vfi in range(pky(vfs)):
                    vf: int = stmt_at(a, vfs, vfi)
                    a.n[vf + {{O:FieldDecl.type_expr}}] = ta_subst_te(ck, a, a.n[vf + {{O:FieldDecl.type_expr}}], ta_map, memo, stack, mal_map, mal_segs)
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                ta_walk_func(ck, a, stmt_at(a, ms, mi), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.protocol_def}}:
            pms: int = sl_at(a, pay, {{O:ProtocolDef.methods}})
            for pmi in range(pky(pms)):
                ta_walk_func(ck, a, stmt_at(a, pms, pmi), ta_map, memo, stack, mal_map, mal_segs)
        elif tag == {{T:StmtKind.extern_def}}:
            eps: int = sl_at(a, pay, {{O:ExternDef.params}})
            for epi in range(pky(eps)):
                ep: int = stmt_at(a, eps, epi)
                a.n[ep + {{O:Param.type_expr}}] = ta_subst_te(ck, a, a.n[ep + {{O:Param.type_expr}}], ta_map, memo, stack, mal_map, mal_segs)
            a.n[pay + {{O:ExternDef.return_type}}] = ta_subst_te(ck, a, a.n[pay + {{O:ExternDef.return_type}}], ta_map, memo, stack, mal_map, mal_segs)

def type_alias_run(ck: Ck, a: Ast, body: int) -> None:
    any_ta: bool = False
    for i in range(pky(body)):
        if a.n[a.n[stmt_at(a, body, i) + {{O:Stmt.kind}}]] == {{T:StmtKind.type_alias}}:
            any_ta = True
            break
    if not any_ta:
        return
    ta_map: Map2 = Map2()
    ta_line: Map2 = Map2()
    mal_map: Map2 = Map2()
    mal_segs: list[int] = []
    for i2 in range(pky(body)):
        st: int = stmt_at(a, body, i2)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.type_alias}}:
            nsym: int = sym_of(ck, a, pk(a.n[pay + {{O:TypeAliasStmt.name}}], a.n[pay + {{O:TypeAliasStmt.name}} + 1]))
            if m2_get(ta_map, 0, nsym) >= 0:
                ck.cur_line = a.n[st + {{O:Stmt.line}}]
                mp(ck, "the type alias '")
                mp_sym(ck, nsym)
                mp(ck, "' is defined twice")
                raise mk_fail(ck, "TypeMismatch")
            m2_put(ta_map, 0, nsym, a.n[pay + {{O:TypeAliasStmt.target}}])
            m2_put(ta_line, 0, nsym, a.n[st + {{O:Stmt.line}}])
        elif tag == {{T:StmtKind.import_stmt}}:
            if a.n[pay + {{O:ImportStmt.alias}}] != {{NONE}}:
                asym: int = sym_of(ck, a, pk(a.n[pay + {{O:ImportStmt.alias}}], a.n[pay + {{O:ImportStmt.alias}} + 1]))
                sgs: int = sl_at(a, pay, {{O:ImportStmt.segments}})
                st0: int = len(mal_segs)
                for si in range(pky(sgs)):
                    mal_segs.append(sym_of(ck, a, pk(a.l[pkx(sgs) + si * 2], a.l[pkx(sgs) + si * 2 + 1])))
                m2_put(mal_map, 0, asym, pk(st0, pky(sgs)))
    for i3 in range(pky(body)):
        st3: int = stmt_at(a, body, i3)
        kn3: int = a.n[st3 + {{O:Stmt.kind}}]
        tag3: int = a.n[kn3]
        pay3: int = a.n[kn3 + 1]
        csym: int = -1
        if tag3 == {{T:StmtKind.class_def}}:
            csym = sym_of(ck, a, pk(a.n[pay3 + {{O:ClassDef.name}}], a.n[pay3 + {{O:ClassDef.name}} + 1]))
        elif tag3 == {{T:StmtKind.func_def}}:
            csym = sym_of(ck, a, pk(a.n[pay3 + {{O:FuncDef.name}}], a.n[pay3 + {{O:FuncDef.name}} + 1]))
        elif tag3 == {{T:StmtKind.protocol_def}}:
            csym = sym_of(ck, a, pk(a.n[pay3 + {{O:ProtocolDef.name}}], a.n[pay3 + {{O:ProtocolDef.name}} + 1]))
        if csym >= 0 and m2_get(ta_map, 0, csym) >= 0:
            ck.cur_line = a.n[st3 + {{O:Stmt.line}}]
            mp(ck, "the type alias '")
            mp_sym(ck, csym)
            mp(ck, "' clashes with a class/function of the same name")
            raise mk_fail(ck, "TypeMismatch")
    for i4 in range(pky(body)):
        st4: int = stmt_at(a, body, i4)
        kn4: int = a.n[st4 + {{O:Stmt.kind}}]
        if a.n[kn4] != {{T:StmtKind.from_import_stmt}}:
            continue
        fi: int = a.n[kn4 + 1]
        fsgs: int = sl_at(a, fi, {{O:FromImportStmt.segments}})
        pref_list: list[int] = []
        for fsi in range(pky(fsgs)):
            pref_list.append(sym_of(ck, a, pk(a.l[pkx(fsgs) + fsi * 2], a.l[pkx(fsgs) + fsi * 2 + 1])))
        pref: str = sym_to_str(ck, join_syms(ck, pref_list, len(pref_list), 95)) + "_"
        fns: int = sl_at(a, fi, {{O:FromImportStmt.names}})
        for fni in range(pky(fns)):
            fn: int = stmt_at(a, fns, fni)
            fn_sr: int = pk(a.n[fn + {{O:FromImportName.name}}], a.n[fn + {{O:FromImportName.name}} + 1])
            mangled: int = sym_lit(ck, pref + sref_str(a, fn_sr))
            if m2_get(ta_map, 0, mangled) < 0:
                continue
            lsr: int = fn_sr
            if a.n[fn + {{O:FromImportName.alias}}] != {{NONE}}:
                lsr = pk(a.n[fn + {{O:FromImportName.alias}}], a.n[fn + {{O:FromImportName.alias}} + 1])
            lsym: int = sym_of(ck, a, lsr)
            msr: int = ast_str_sym(ck, a, mangled)
            m2_put(ta_map, 0, lsym, mk_TypeExpr_simple(a, pkx(msr), pky(msr)))
            m2_put(ta_line, 0, lsym, a.n[st4 + {{O:Stmt.line}}])
    memo: Map2 = Map2()
    stack: list[int] = []
    for i5 in range(pky(body)):
        st5: int = stmt_at(a, body, i5)
        kn5: int = a.n[st5 + {{O:Stmt.kind}}]
        if a.n[kn5] == {{T:StmtKind.type_alias}}:
            pay5: int = a.n[kn5 + 1]
            nsym5: int = sym_of(ck, a, pk(a.n[pay5 + {{O:TypeAliasStmt.name}}], a.n[pay5 + {{O:TypeAliasStmt.name}} + 1]))
            ck.cur_line = a.n[st5 + {{O:Stmt.line}}]
            ta_resolve(ck, a, nsym5, -1, ta_map, memo, stack, mal_map, mal_segs)
    for e in range(len(ta_map.k1)):
        if ta_map.dead[e] == 0:
            nsym6: int = ta_map.k2[e]
            if m2_get(memo, 0, nsym6) < 0:
                le: int = m2_get(ta_line, 0, nsym6)
                ck.cur_line = ta_line.vv[le] if le >= 0 else 0
                ta_resolve(ck, a, nsym6, -1, ta_map, memo, stack, mal_map, mal_segs)
    ta_walk_stmts(ck, a, body, memo, memo, stack, mal_map, mal_segs)

def gn_has_none_leaf(a: Ast, cond: int) -> bool:
    if a.n[cond] != {{T:Expr.binary}}:
        return False
    bp: int = a.n[cond + 1]
    op: int = a.n[bp + {{O:Binary.op}}]
    l: int = a.n[bp + {{O:Binary.left}}]
    r: int = a.n[bp + {{O:Binary.right}}]
    if op == {{E:BinaryOp.eq}}:
        if (a.n[l] == {{T:Expr.identifier}} or a.n[l] == {{T:Expr.attribute}}) and a.n[r] == {{T:Expr.none_lit}}:
            return True
        if (a.n[r] == {{T:Expr.identifier}} or a.n[r] == {{T:Expr.attribute}}) and a.n[l] == {{T:Expr.none_lit}}:
            return True
        return False
    if op == {{E:BinaryOp.or_}}:
        return gn_has_none_leaf(a, l) or gn_has_none_leaf(a, r)
    return False

def gn_always_exits(a: Ast, s: int) -> bool:
    n: int = pky(s)
    if n == 0:
        return False
    st: int = stmt_at(a, s, n - 1)
    kn: int = a.n[st + {{O:Stmt.kind}}]
    tag: int = a.n[kn]
    pay: int = a.n[kn + 1]
    if tag == {{T:StmtKind.return_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.break_stmt}} or tag == {{T:StmtKind.continue_stmt}}:
        return True
    if tag == {{T:StmtKind.if_stmt}}:
        if a.n[pay + {{O:IfStmt.else_body}}] == {{NONE}}:
            return False
        if not gn_always_exits(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
            return False
        ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
        for i in range(pky(ecs)):
            if not gn_always_exits(a, sl_at(a, a.l[pkx(ecs) + i], {{O:ElifClause.body}})):
                return False
        return gn_always_exits(a, sl_at(a, pay, {{O:IfStmt.else_body}}))
    return False

def gn_norm_block(a: Ast, s: int) -> None:
    n: int = pky(s)
    x: int = pkx(s)
    for i in range(n):
        st: int = a.l[x + i]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.if_stmt}}:
            if a.n[pay + {{O:IfStmt.else_body}}] == {{NONE}} and pky(sl_at(a, pay, {{O:IfStmt.elif_clauses}})) == 0 and i + 1 < n:
                if gn_has_none_leaf(a, a.n[pay + {{O:IfStmt.cond}}]) and gn_always_exits(a, sl_at(a, pay, {{O:IfStmt.then_body}})):
                    rest_ids: list[int] = []
                    for rj in range(i + 1, n):
                        rest_ids.append(a.l[x + rj])
                    rsl: int = list_put_slice(a, rest_ids)
                    a.n[pay + {{O:IfStmt.else_body}}] = pkx(rsl)
                    a.n[pay + {{O:IfStmt.else_body}} + 1] = pky(rsl)
                    for pk_i in range(i, n - 1):
                        pst: int = a.l[x + pk_i]
                        a.l[x + pk_i] = mk_Stmt(a, mk_StmtKind_pass_stmt(a), a.n[pst + {{O:Stmt.line}}], a.n[pst + {{O:Stmt.span}}])
                    a.l[x + n - 1] = st
                    gn_norm_block(a, sl_at(a, pay, {{O:IfStmt.then_body}}))
                    gn_norm_block(a, rsl)
                    return
            gn_norm_block(a, sl_at(a, pay, {{O:IfStmt.then_body}}))
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for ei in range(pky(ecs)):
                gn_norm_block(a, sl_at(a, a.l[pkx(ecs) + ei], {{O:ElifClause.body}}))
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                gn_norm_block(a, sl_at(a, pay, {{O:IfStmt.else_body}}))
        elif tag == {{T:StmtKind.while_stmt}}:
            gn_norm_block(a, sl_at(a, pay, {{O:WhileStmt.body}}))
        elif tag == {{T:StmtKind.for_stmt}}:
            gn_norm_block(a, sl_at(a, pay, {{O:ForStmt.body}}))
        elif tag == {{T:StmtKind.try_stmt}}:
            gn_norm_block(a, sl_at(a, pay, {{O:TryStmt.try_body}}))
            txs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for ti in range(pky(txs)):
                gn_norm_block(a, sl_at(a, a.l[pkx(txs) + ti], {{O:ExceptClause.body}}))
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                gn_norm_block(a, sl_at(a, pay, {{O:TryStmt.finally_body}}))
        elif tag == {{T:StmtKind.with_stmt}}:
            gn_norm_block(a, sl_at(a, pay, {{O:WithStmt.body}}))
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            gn_norm_block(a, sl_at(a, pay, {{O:LowLevelStmt.body}}))
        elif tag == {{T:StmtKind.func_def}}:
            gn_norm_block(a, sl_at(a, pay, {{O:FuncDef.body}}))

def guard_normalize_run(a: Ast, body: int) -> None:
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.func_def}}:
            gn_norm_block(a, sl_at(a, pay, {{O:FuncDef.body}}))
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                gn_norm_block(a, sl_at(a, stmt_at(a, ms, mi), {{O:FuncDef.body}}))

# ---- TODO 8.2: mixin_flatten ----
def mx_resolve(ck: Ck, c_map: Map2, sym: int) -> int:
    e: int = m2_get(c_map, 0, sym)
    if e >= 0:
        return c_map.vv[e]
    fe: int = m2_get(ck.fimp, 0, sym)
    if fe >= 0:
        e2: int = m2_get(c_map, 0, ck.fimp.vv[fe])
        if e2 >= 0:
            return c_map.vv[e2]
    return -1

def mx_has_method_in_chain(ck: Ck, a: Ast, c_map: Map2, cd: int, msym: int) -> bool:
    cur: int = cd
    guard: int = 0
    while cur >= 0 and guard <= 64:
        guard = guard + 1
        ms: int = sl_at(a, cur, {{O:ClassDef.methods}})
        for i in range(pky(ms)):
            m: int = stmt_at(a, ms, i)
            if sym_of(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])) == msym:
                return True
        if a.n[cur + {{O:ClassDef.base}}] == {{NONE}}:
            return False
        cur = mx_resolve(ck, c_map, sym_of(ck, a, pk(a.n[cur + {{O:ClassDef.base}}], a.n[cur + {{O:ClassDef.base}} + 1])))
    return False

def mx_find_method(ck: Ck, a: Ast, c_map: Map2, start_cd: int, msym: int) -> int:
    src: int = start_cd
    guard: int = 0
    while src >= 0 and guard <= 64:
        guard = guard + 1
        ms: int = sl_at(a, src, {{O:ClassDef.methods}})
        for i in range(pky(ms)):
            m: int = stmt_at(a, ms, i)
            if sym_of(ck, a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])) == msym:
                return m
        if a.n[src + {{O:ClassDef.base}}] == {{NONE}}:
            return -1
        src = mx_resolve(ck, c_map, sym_of(ck, a, pk(a.n[src + {{O:ClassDef.base}}], a.n[src + {{O:ClassDef.base}} + 1])))
    return -1

def mx_mangled_sym(ck: Ck, mxsym: int, msym: int) -> int:
    ms: str = sym_to_str(ck, msym)
    mxs: str = sym_to_str(ck, mxsym)
    if ms == "__init__":
        return sym_lit(ck, "__nox_init_" + mxs)
    return sym_lit(ck, "__nox_mx_" + mxs + "_" + ms)

def mx_with_self_type(ck: Ck, a: Ast, m: int, csym: int) -> int:
    empty_b: Map2 = Map2()
    nb: int = subst_stmts(ck, a, sl_at(a, m, {{O:FuncDef.body}}), empty_b)
    ps: int = sl_at(a, m, {{O:FuncDef.params}})
    nps: list[int] = []
    for i in range(pky(ps)):
        p: int = stmt_at(a, ps, i)
        if i == 0 and sref_eq(a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1]), "self"):
            csr: int = ast_str_sym(ck, a, csym)
            te: int = mk_TypeExpr_simple(a, pkx(csr), pky(csr))
            p = mk_Param(a, a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1], a.n[p + {{O:Param.variadic}}], a.n[p + {{O:Param.var_kw}}], a.n[p + {{O:Param.kw_only}}], a.n[p + {{O:Param.pos_only}}], te, a.n[p + {{O:Param.self_inferred}}], a.n[p + {{O:Param.default}}])
        nps.append(p)
    psl: int = ast_stmt_list(a, nps)
    decs: int = sl_at(a, m, {{O:FuncDef.decorators}})
    return mk_FuncDef(a, a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1], 0, 0, pkx(psl), pky(psl), a.n[m + {{O:FuncDef.return_type}}], a.n[m + {{O:FuncDef.ret_omitted}}], pkx(nb), pky(nb), a.n[m + {{O:FuncDef.is_async}}], pkx(decs), pky(decs), a.n[m + {{O:FuncDef.link_name}}], a.n[m + {{O:FuncDef.link_name}} + 1], 0, 0, 0, 0, a.n[m + {{O:FuncDef.allow_await}}], a.n[m + {{O:FuncDef.line}}])

def mx_walk_expr(ck: Ck, a: Ast, e: int, scan_mixins: list[int], scan_base: int, from_mixin: bool, need_mx: list[int], need_m: list[int], line: int) -> None:
    tag: int = a.n[e]
    if tag == {{T:Expr.call}}:
        c: int = a.n[e + 1]
        cal: int = a.n[c + {{O:Call.callee}}]
        if from_mixin and a.n[cal] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[cal + 1], a.n[cal + 2]), "super"):
            ck.cur_line = line
            fail2(ck, "TypeMismatch", "'super()' cannot be used in a mixin method (the mixin is copied into the class that lists it)")
        if a.n[cal] == {{T:Expr.attribute}}:
            at: int = a.n[cal + 1]
            obj: int = a.n[at + {{O:Attribute.obj}}]
            args: int = sl_at(a, c, {{O:Call.args}})
            if a.n[obj] == {{T:Expr.identifier}} and pky(args) >= 1:
                a0: int = stmt_at(a, args, 0)
                if a.n[a0] == {{T:Expr.identifier}} and sref_eq(a, pk(a.n[a0 + 1], a.n[a0 + 2]), "self"):
                    osym: int = sym_of(ck, a, pk(a.n[obj + 1], a.n[obj + 2]))
                    if not from_mixin and scan_base >= 0 and osym == scan_base:
                        ssr: int = syn(a, "super")
                        sc_cal: int = mk_Expr_identifier(a, pkx(ssr), pky(ssr))
                        sc_e: int = mk_Expr_call(a, mk_Call(a, sc_cal, 0, 0, 0, 0, 0, 0, 0, 0))
                        a.n[at + {{O:Attribute.obj}}] = sc_e
                        a.n[c + {{O:Call.args}}] = pkx(args) + 1
                        a.n[c + {{O:Call.args}} + 1] = pky(args) - 1
                    else:
                        is_mx: bool = False
                        for mn in scan_mixins:
                            if mn == osym:
                                is_mx = True
                                break
                        if is_mx:
                            msym: int = sym_of(ck, a, pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1]))
                            need_mx.append(osym)
                            need_m.append(msym)
                            nsym: int = mx_mangled_sym(ck, osym, msym)
                            nsr: int = ast_str_sym(ck, a, nsym)
                            a.n[at + {{O:Attribute.obj}}] = mk_ident_node(a, "self")
                            a.n[at + {{O:Attribute.attr}}] = pkx(nsr)
                            a.n[at + {{O:Attribute.attr}} + 1] = pky(nsr)
                            a.n[c + {{O:Call.args}}] = pkx(args) + 1
                            a.n[c + {{O:Call.args}} + 1] = pky(args) - 1
        mx_walk_expr(ck, a, a.n[c + {{O:Call.callee}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        cargs: int = sl_at(a, c, {{O:Call.args}})
        for ai in range(pky(cargs)):
            mx_walk_expr(ck, a, stmt_at(a, cargs, ai), scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        return
    if tag == {{T:Expr.unary}}:
        mx_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.kwarg}}:
        mx_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        mx_walk_expr(ck, a, a.n[tp + {{O:Ternary.cond}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        mx_walk_expr(ck, a, a.n[tp + {{O:Ternary.then_expr}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        mx_walk_expr(ck, a, a.n[tp + {{O:Ternary.else_expr}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        mx_walk_expr(ck, a, a.n[bp + {{O:Binary.left}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        mx_walk_expr(ck, a, a.n[bp + {{O:Binary.right}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.attribute}}:
        mx_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Attribute.obj}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        mx_walk_expr(ck, a, a.n[ip + {{O:Index.obj}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        mx_walk_expr(ck, a, a.n[ip + {{O:Index.index}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.slice}}:
        sp: int = a.n[e + 1]
        mx_walk_expr(ck, a, a.n[sp + {{O:Slice.obj}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        if a.n[sp + {{O:Slice.lo}}] >= 0:
            mx_walk_expr(ck, a, a.n[sp + {{O:Slice.lo}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        if a.n[sp + {{O:Slice.hi}}] >= 0:
            mx_walk_expr(ck, a, a.n[sp + {{O:Slice.hi}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        if a.n[sp + {{O:Slice.step}}] >= 0:
            mx_walk_expr(ck, a, a.n[sp + {{O:Slice.step}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        for li in range(a.n[e + 2]):
            mx_walk_expr(ck, a, a.l[a.n[e + 1] + li], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.dict_lit}}:
        for di in range(a.n[e + 2]):
            pr: int = a.l[a.n[e + 1] + di]
            mx_walk_expr(ck, a, a.n[pr + {{O:DictPair.key}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            mx_walk_expr(ck, a, a.n[pr + {{O:DictPair.value}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.lambda}}:
        mx_walk_expr(ck, a, a.n[a.n[e + 1] + {{O:Lambda.body}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        mx_walk_expr(ck, a, a.n[e + 1], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
    elif tag == {{T:Expr.generic_construct}}:
        gargs: int = sl_at(a, a.n[e + 1], {{O:GenericConstruct.args}})
        for gi in range(pky(gargs)):
            mx_walk_expr(ck, a, stmt_at(a, gargs, gi), scan_mixins, scan_base, from_mixin, need_mx, need_m, line)

def mx_walk_stmts(ck: Ck, a: Ast, stmts: int, scan_mixins: list[int], scan_base: int, from_mixin: bool, need_mx: list[int], need_m: list[int]) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        line: int = a.n[st + {{O:Stmt.line}}]
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            mx_walk_expr(ck, a, pay, scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                mx_walk_expr(ck, a, pay, scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        elif tag == {{T:StmtKind.var_decl}}:
            mx_walk_expr(ck, a, a.n[pay + {{O:VarDecl.value}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        elif tag == {{T:StmtKind.assign}}:
            mx_walk_expr(ck, a, a.n[pay + {{O:Assign.target}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            mx_walk_expr(ck, a, a.n[pay + {{O:Assign.value}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
        elif tag == {{T:StmtKind.if_stmt}}:
            mx_walk_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                ec: int = stmt_at(a, ecs, j)
                mx_walk_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
                mx_walk_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                mx_walk_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.while_stmt}}:
            mx_walk_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.for_stmt}}:
            mx_walk_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.func_def}}:
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.try_stmt}}:
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                mx_walk_stmts(ck, a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                mx_walk_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.with_stmt}}:
            mx_walk_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            mx_walk_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), scan_mixins, scan_base, from_mixin, need_mx, need_m)
        elif tag == {{T:StmtKind.defer_stmt}}:
            dc: int = a.n[pay + {{O:DeferStmt.call}}]
            mx_walk_expr(ck, a, a.n[dc + {{O:Call.callee}}], scan_mixins, scan_base, from_mixin, need_mx, need_m, line)
            dargs: int = sl_at(a, dc, {{O:Call.args}})
            for di in range(pky(dargs)):
                mx_walk_expr(ck, a, stmt_at(a, dargs, di), scan_mixins, scan_base, from_mixin, need_mx, need_m, line)

def mx_flatten(ck: Ck, a: Ast, c_map: Map2, c_line: Map2, done: Map2, vis: Map2, cd: int) -> None:
    csym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
    if m2_get(done, 0, csym) >= 0:
        return
    line: int = c_line.vv[m2_get(c_line, 0, csym)] if m2_get(c_line, 0, csym) >= 0 else 0
    if m2_get(vis, 0, csym) >= 0:
        ck.cur_line = line
        mp(ck, "class '")
        mp_sym(ck, csym)
        mp(ck, "': cyclic base classes")
        raise mk_fail(ck, "TypeMismatch")
    m2_put(vis, 0, csym, 1)
    bsym: int = -1
    if a.n[cd + {{O:ClassDef.base}}] != {{NONE}}:
        bsym = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1]))
        bcd: int = mx_resolve(ck, c_map, bsym)
        if bcd >= 0:
            mx_flatten(ck, a, c_map, c_line, done, vis, bcd)
    ebs: int = sl_at(a, cd, {{O:ClassDef.extra_bases}})
    if pky(ebs) == 0:
        m2_remove(vis, 0, csym)
        m2_put(done, 0, csym, 1)
        return
    methods: list[int] = []
    from_mx: list[bool] = []
    ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
    for i in range(pky(ms)):
        methods.append(stmt_at(a, ms, i))
        from_mx.append(False)
    fields: list[int] = []
    fs: int = sl_at(a, cd, {{O:ClassDef.fields}})
    for i2 in range(pky(fs)):
        fields.append(stmt_at(a, fs, i2))
    consts: list[int] = []
    ks: int = sl_at(a, cd, {{O:ClassDef.consts}})
    for i3 in range(pky(ks)):
        consts.append(stmt_at(a, ks, i3))
    resolved_mxs: list[int] = []
    for ei in range(pky(ebs)):
        mnsr: int = pk(a.l[pkx(ebs) + ei * 2], a.l[pkx(ebs) + ei * 2 + 1])
        mnsym: int = sym_of(ck, a, mnsr)
        mixin: int = mx_resolve(ck, c_map, mnsym)
        if mixin < 0:
            ck.cur_line = line
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': unknown base class '")
            mp_sym(ck, mnsym)
            mp(ck, "'")
            raise mk_fail(ck, "TypeMismatch")
        if pky(sl_at(a, mixin, {{O:ClassDef.type_params}})) != 0:
            ck.cur_line = line
            mp(ck, "class '")
            mp_sym(ck, csym)
            mp(ck, "': the generic class '")
            mp_sym(ck, mnsym)
            mp(ck, "' cannot be used as a mixin")
            raise mk_fail(ck, "TypeMismatch")
        mx_rsym: int = sym_of(ck, a, pk(a.n[mixin + {{O:ClassDef.name}}], a.n[mixin + {{O:ClassDef.name}} + 1]))
        if bsym >= 0:
            bcd2: int = mx_resolve(ck, c_map, bsym)
            if bcd2 == mixin:
                continue
        mx_flatten(ck, a, c_map, c_line, done, vis, mixin)
        resolved_mxs.append(mx_rsym)
        src: int = mixin
        guard: int = 0
        while src >= 0 and guard <= 64:
            guard = guard + 1
            sms: int = sl_at(a, src, {{O:ClassDef.methods}})
            for mi in range(pky(sms)):
                m: int = stmt_at(a, sms, mi)
                mn: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
                if sref_eq(a, mn, "__init__"):
                    continue
                msym: int = sym_of(ck, a, mn)
                taken: bool = False
                for em in methods:
                    if sym_of(ck, a, pk(a.n[em + {{O:FuncDef.name}}], a.n[em + {{O:FuncDef.name}} + 1])) == msym:
                        taken = True
                        break
                if not taken and bsym >= 0:
                    bcd3: int = mx_resolve(ck, c_map, bsym)
                    if bcd3 >= 0 and mx_has_method_in_chain(ck, a, c_map, bcd3, msym):
                        taken = True
                if not taken:
                    methods.append(mx_with_self_type(ck, a, m, csym))
                    from_mx.append(True)
            sfs: int = sl_at(a, src, {{O:ClassDef.fields}})
            for fi in range(pky(sfs)):
                f: int = stmt_at(a, sfs, fi)
                fsym: int = sym_of(ck, a, pk(a.n[f + {{O:FieldDecl.name}}], a.n[f + {{O:FieldDecl.name}} + 1]))
                have_f: bool = False
                for ef in fields:
                    if sym_of(ck, a, pk(a.n[ef + {{O:FieldDecl.name}}], a.n[ef + {{O:FieldDecl.name}} + 1])) == fsym:
                        have_f = True
                        break
                if not have_f:
                    fields.append(f)
            sks: int = sl_at(a, src, {{O:ClassDef.consts}})
            for ki in range(pky(sks)):
                k: int = stmt_at(a, sks, ki)
                ksym: int = sym_of(ck, a, pk(a.n[k + {{O:ConstDecl.name}}], a.n[k + {{O:ConstDecl.name}} + 1]))
                have_k: bool = False
                for ek in consts:
                    if sym_of(ck, a, pk(a.n[ek + {{O:ConstDecl.name}}], a.n[ek + {{O:ConstDecl.name}} + 1])) == ksym:
                        have_k = True
                        break
                if not have_k:
                    ow0: int = a.n[k + {{O:ConstDecl.owner}}]
                    ow1: int = a.n[k + {{O:ConstDecl.owner}} + 1]
                    if ow0 == {{NONE}}:
                        ow0 = a.n[src + {{O:ClassDef.name}}]
                        ow1 = a.n[src + {{O:ClassDef.name}} + 1]
                    consts.append(mk_ConstDecl(a, a.n[k + {{O:ConstDecl.name}}], a.n[k + {{O:ConstDecl.name}} + 1], a.n[k + {{O:ConstDecl.type_expr}}], a.n[k + {{O:ConstDecl.value}}], a.n[k + {{O:ConstDecl.line}}], ow0, ow1, a.n[k + {{O:ConstDecl.promoted}}]))
            if a.n[src + {{O:ClassDef.base}}] == {{NONE}}:
                src = -1
            else:
                src = mx_resolve(ck, c_map, sym_of(ck, a, pk(a.n[src + {{O:ClassDef.base}}], a.n[src + {{O:ClassDef.base}} + 1])))
    scan_names: list[int] = []
    for ei2 in range(pky(ebs)):
        scan_names.append(sym_of(ck, a, pk(a.l[pkx(ebs) + ei2 * 2], a.l[pkx(ebs) + ei2 * 2 + 1])))
    si: int = 0
    while si < len(scan_names) and len(scan_names) < 256:
        mc: int = mx_resolve(ck, c_map, scan_names[si])
        si = si + 1
        if mc < 0:
            continue
        if a.n[mc + {{O:ClassDef.base}}] != {{NONE}}:
            mcb: int = sym_of(ck, a, pk(a.n[mc + {{O:ClassDef.base}}], a.n[mc + {{O:ClassDef.base}} + 1]))
            dup_b: bool = False
            for sn in scan_names:
                if sn == mcb:
                    dup_b = True
                    break
            if not dup_b:
                scan_names.append(mcb)
        mcmxs: int = sl_at(a, mc, {{O:ClassDef.mixins}})
        for mi2 in range(pky(mcmxs)):
            m2s: int = sym_of(ck, a, pk(a.l[pkx(mcmxs) + mi2 * 2], a.l[pkx(mcmxs) + mi2 * 2 + 1]))
            dup_m: bool = False
            for sn2 in scan_names:
                if sn2 == m2s:
                    dup_m = True
                    break
            if not dup_m:
                scan_names.append(m2s)
    seen_synth: Map2 = Map2()
    scanned: int = 0
    while scanned < len(methods):
        need_mx: list[int] = []
        need_m: list[int] = []
        mx_walk_stmts(ck, a, sl_at(a, methods[scanned], {{O:FuncDef.body}}), scan_names, bsym, from_mx[scanned], need_mx, need_m)
        scanned = scanned + 1
        for ni in range(len(need_mx)):
            nsym: int = mx_mangled_sym(ck, need_mx[ni], need_m[ni])
            if m2_get(seen_synth, 0, nsym) >= 0:
                continue
            m2_put(seen_synth, 0, nsym, 1)
            mcd: int = mx_resolve(ck, c_map, need_mx[ni])
            src_m: int = mx_find_method(ck, a, c_map, mcd, need_m[ni])
            if src_m < 0:
                ck.cur_line = line
                mp(ck, "class '")
                mp_sym(ck, csym)
                mp(ck, "': mixin '")
                mp_sym(ck, need_mx[ni])
                mp(ck, "' has no method '")
                mp_sym(ck, need_m[ni])
                mp(ck, "'")
                raise mk_fail(ck, "TypeMismatch")
            copy_m: int = mx_with_self_type(ck, a, src_m, csym)
            nsr: int = ast_str_sym(ck, a, nsym)
            a.n[copy_m + {{O:FuncDef.name}}] = pkx(nsr)
            a.n[copy_m + {{O:FuncDef.name}} + 1] = pky(nsr)
            methods.append(copy_m)
            from_mx.append(True)
    msl_out: int = ast_stmt_list(a, methods)
    fsl_out: int = ast_stmt_list(a, fields)
    ksl_out: int = ast_stmt_list(a, consts)
    a.n[cd + {{O:ClassDef.methods}}] = pkx(msl_out)
    a.n[cd + {{O:ClassDef.methods}} + 1] = pky(msl_out)
    a.n[cd + {{O:ClassDef.fields}}] = pkx(fsl_out)
    a.n[cd + {{O:ClassDef.fields}} + 1] = pky(fsl_out)
    a.n[cd + {{O:ClassDef.consts}}] = pkx(ksl_out)
    a.n[cd + {{O:ClassDef.consts}} + 1] = pky(ksl_out)
    mx_st: int = len(a.l)
    for rm in resolved_mxs:
        rsr: int = ast_str_sym(ck, a, rm)
        a.l.append(pkx(rsr))
        a.l.append(pky(rsr))
    a.n[cd + {{O:ClassDef.mixins}}] = mx_st
    a.n[cd + {{O:ClassDef.mixins}} + 1] = len(resolved_mxs)
    a.n[cd + {{O:ClassDef.extra_bases}}] = 0
    a.n[cd + {{O:ClassDef.extra_bases}} + 1] = 0
    m2_remove(vis, 0, csym)
    m2_put(done, 0, csym, 1)

def mixin_flatten_run(ck: Ck, a: Ast, body: int) -> None:
    any_b: bool = False
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] == {{T:StmtKind.class_def}}:
            cd: int = a.n[kn + 1]
            if pky(sl_at(a, cd, {{O:ClassDef.extra_bases}})) > 0 or a.n[cd + {{O:ClassDef.base}}] != {{NONE}}:
                any_b = True
                break
    if not any_b:
        return
    c_map: Map2 = Map2()
    c_line: Map2 = Map2()
    for i2 in range(pky(body)):
        st2: int = stmt_at(a, body, i2)
        kn2: int = a.n[st2 + {{O:Stmt.kind}}]
        if a.n[kn2] == {{T:StmtKind.class_def}}:
            cd2: int = a.n[kn2 + 1]
            csym: int = sym_of(ck, a, pk(a.n[cd2 + {{O:ClassDef.name}}], a.n[cd2 + {{O:ClassDef.name}} + 1]))
            m2_put(c_map, 0, csym, cd2)
            m2_put(c_line, 0, csym, a.n[st2 + {{O:Stmt.line}}])
    done: Map2 = Map2()
    vis: Map2 = Map2()
    for i3 in range(pky(body)):
        st3: int = stmt_at(a, body, i3)
        kn3: int = a.n[st3 + {{O:Stmt.kind}}]
        if a.n[kn3] == {{T:StmtKind.class_def}}:
            mx_flatten(ck, a, c_map, c_line, done, vis, a.n[kn3 + 1])
    for i4 in range(pky(body)):
        st4: int = stmt_at(a, body, i4)
        kn4: int = a.n[st4 + {{O:Stmt.kind}}]
        if a.n[kn4] == {{T:StmtKind.class_def}}:
            cd4: int = a.n[kn4 + 1]
            if a.n[cd4 + {{O:ClassDef.base}}] == {{NONE}} or pky(sl_at(a, cd4, {{O:ClassDef.mixins}})) > 0:
                continue
            bsym4: int = sym_of(ck, a, pk(a.n[cd4 + {{O:ClassDef.base}}], a.n[cd4 + {{O:ClassDef.base}} + 1]))
            ms4: int = sl_at(a, cd4, {{O:ClassDef.methods}})
            for mi4 in range(pky(ms4)):
                m4: int = stmt_at(a, ms4, mi4)
                m4s: str = sref_str(a, pk(a.n[m4 + {{O:FuncDef.name}}], a.n[m4 + {{O:FuncDef.name}} + 1]))
                if len(m4s) >= 6 and m4s[:6] == "__nox_":
                    continue
                n_mx: list[int] = []
                n_m: list[int] = []
                mx_walk_stmts(ck, a, sl_at(a, m4, {{O:FuncDef.body}}), [], bsym4, False, n_mx, n_m)

# ---- v2.1.110: @dataclass / @derive(...) ----
def drv_has_method(a: Ast, cd: int, name: str) -> bool:
    ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
    for i in range(pky(ms)):
        m: int = stmt_at(a, ms, i)
        if sref_eq(a, pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1]), name):
            return True
    return False

def drv_type_check_no_func(ck: Ck, a: Ast, te: int, line: int) -> None:
    if a.n[te] == {{T:TypeExpr.func_type}}:
        ck.cur_line = line
        fail2(ck, "TypeMismatch", "a function-typed field cannot be used with @dataclass/@derive")
    if a.n[te] == {{T:TypeExpr.optional}}:
        drv_type_check_no_func(ck, a, a.n[te + 1], line)
    elif a.n[te] == {{T:TypeExpr.generic}}:
        args: int = sl_at(a, a.n[te + 1], {{O:Generic.args}})
        for i in range(pky(args)):
            drv_type_check_no_func(ck, a, stmt_at(a, args, i), line)

def drv_mk_qual_call(a: Ast, segs: list[str], args: list[int]) -> int:
    cur: int = mk_ident_node(a, segs[0])
    for i in range(1, len(segs)):
        asr: int = syn(a, segs[i])
        cur = mk_Expr_attribute(a, mk_Attribute(a, cur, pkx(asr), pky(asr)))
    al: int = ast_expr_list(a, args)
    return mk_Expr_call(a, mk_Call(a, cur, pkx(al), pky(al), 0, 0, 0, 0, 0, 0))

def drv_gen_write(ck: Ck, a: Ast, out: list[int], e: int, te: int, wants: Map2, line: int) -> None:
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        nsr: int = pk(a.n[te + 1], a.n[te + 2])
        if sref_eq(a, nsr, "int"):
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_int", ast_expr_list(a, [e]))), line, -1))
            return
        if sref_eq(a, nsr, "float"):
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_float", ast_expr_list(a, [e]))), line, -1))
            return
        if sref_eq(a, nsr, "bool"):
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_bool", ast_expr_list(a, [e]))), line, -1))
            return
        if sref_eq(a, nsr, "str"):
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_string", ast_expr_list(a, [e]))), line, -1))
            return
        nsym: int = sym_of(ck, a, nsr)
        we: int = m2_get(wants, 0, nsym)
        if we < 0:
            ck.cur_line = line
            mp(ck, "@derive(\"json\"): field type '")
            mp_sref(ck, a, nsr)
            mp(ck, "' is not a basic type and has no @derive(\"json\")")
            raise mk_fail(ck, "TypeMismatch")
        if (wants.vv[we] & 8) == 0:
            ck.cur_line = line
            mp(ck, "@derive(\"json\"): field type '")
            mp_sref(ck, a, nsr)
            mp(ck, "' needs @derive(\"json\") too")
            raise mk_fail(ck, "TypeMismatch")
        out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, e, "write_json", ast_expr_list(a, [mk_ident_node(a, "w")]))), line, -1))
        return
    if tag == {{T:TypeExpr.generic}}:
        gp: int = a.n[te + 1]
        gn: int = pk(a.n[gp + {{O:Generic.name}}], a.n[gp + {{O:Generic.name}} + 1])
        gargs: int = sl_at(a, gp, {{O:Generic.args}})
        if sref_eq(a, gn, "list") and pky(gargs) == 1:
            ck.ext_cnt = ck.ext_cnt + 1
            evn: str = "__e" + str(ck.ext_cnt)
            evsr: int = syn(a, evn)
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "begin_array", pk(0, 0))), line, -1))
            fstmts: list[int] = []
            drv_gen_write(ck, a, fstmts, mk_ident_node(a, evn), stmt_at(a, gargs, 0), wants, line)
            fb: int = ast_stmt_list(a, fstmts)
            out.append(mk_Stmt(a, mk_StmtKind_for_stmt(a, mk_ForStmt(a, pkx(evsr), pky(evsr), e, pkx(fb), pky(fb), 0, 0, -1)), line, -1))
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "end_array", pk(0, 0))), line, -1))
            return
        if sref_eq(a, gn, "dict") and pky(gargs) == 2:
            a0: int = stmt_at(a, gargs, 0)
            if a.n[a0] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[a0 + 1], a.n[a0 + 2]), "str"):
                ck.ext_cnt = ck.ext_cnt + 1
                id_s: str = str(ck.ext_cnt)
                knm: str = "__k" + id_s
                vnm: str = "__v" + id_s
                tnm: str = "__nox_tup_d_" + id_s + "_2"
                tsr: int = syn(a, tnm)
                ksr: int = syn(a, knm)
                vsr: int = syn(a, vnm)
                inf_sr: int = syn(a, "__infer")
                inf_te: int = mk_TypeExpr_simple(a, pkx(inf_sr), pky(inf_sr))
                out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "begin_object", pk(0, 0))), line, -1))
                f0sr: int = syn(a, "f0")
                f1sr: int = syn(a, "f1")
                fstmts2: list[int] = [
                    mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(ksr), pky(ksr), inf_te, mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, tnm), pkx(f0sr), pky(f0sr))), 0, 0, 0, 0)), line, -1),
                    mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(vsr), pky(vsr), inf_te, mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, tnm), pkx(f1sr), pky(f1sr))), 0, 0, 0, 0)), line, -1),
                    mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_key", ast_expr_list(a, [mk_ident_node(a, knm)]))), line, -1),
                ]
                drv_gen_write(ck, a, fstmts2, mk_ident_node(a, vnm), stmt_at(a, gargs, 1), wants, line)
                fb2: int = ast_stmt_list(a, fstmts2)
                out.append(mk_Stmt(a, mk_StmtKind_for_stmt(a, mk_ForStmt(a, pkx(tsr), pky(tsr), mk_attr_call_node(a, e, "items", pk(0, 0)), pkx(fb2), pky(fb2), 0, 0, -1)), line, -1))
                out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "end_object", pk(0, 0))), line, -1))
                return
        ck.cur_line = line
        mp(ck, "@derive(\"json\"): unsupported field type ")
        mp_sref(ck, a, gn)
        mp(ck, "[...] (supported: int, float, bool, str, list[T], dict[str, T], T | None, and classes with @derive(\"json\"))")
        raise mk_fail(ck, "TypeMismatch")
    if tag == {{T:TypeExpr.optional}}:
        ck.ext_cnt = ck.ext_cnt + 1
        onm: str = "__o" + str(ck.ext_cnt)
        osr: int = syn(a, onm)
        out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(osr), pky(osr), te, e, 0, 0, 0, 0)), line, -1))
        cond: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.eq}}, mk_ident_node(a, onm), mk_Expr_none_lit(a), 0, 0, 0, 0))
        tb: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_null", pk(0, 0))), line, -1)])
        estmts: list[int] = []
        drv_gen_write(ck, a, estmts, mk_ident_node(a, onm), a.n[te + 1], wants, line)
        eb: int = ast_stmt_list(a, estmts)
        out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, cond, pkx(tb), pky(tb), 0, 0, pkx(eb), pky(eb), 0, -1, 0)), line, -1))
        return
    ck.cur_line = line
    fail2(ck, "TypeMismatch", "@derive(\"json\"): unsupported field type")

def drv_gen_read(ck: Ck, a: Ast, out: list[int], target: str, e: int, te: int, wants: Map2, line: int) -> None:
    tsr: int = syn(a, target)
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        nsr: int = pk(a.n[te + 1], a.n[te + 2])
        if sref_eq(a, nsr, "int"):
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, drv_mk_qual_call(a, ["nox", "json", "read_int"], [e]), 0, 0, 0, 0)), line, -1))
            return
        if sref_eq(a, nsr, "float"):
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, drv_mk_qual_call(a, ["nox", "json", "read_float"], [e]), 0, 0, 0, 0)), line, -1))
            return
        if sref_eq(a, nsr, "bool"):
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, drv_mk_qual_call(a, ["nox", "json", "read_bool"], [e]), 0, 0, 0, 0)), line, -1))
            return
        if sref_eq(a, nsr, "str"):
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, drv_mk_qual_call(a, ["nox", "json", "read_str"], [e]), 0, 0, 0, 0)), line, -1))
            return
        nsym: int = sym_of(ck, a, nsr)
        we: int = m2_get(wants, 0, nsym)
        if we < 0:
            ck.cur_line = line
            mp(ck, "@derive(\"json\"): field type '")
            mp_sref(ck, a, nsr)
            mp(ck, "' is not a basic type and has no @derive(\"json\")")
            raise mk_fail(ck, "TypeMismatch")
        if (wants.vv[we] & 8) == 0:
            ck.cur_line = line
            mp(ck, "@derive(\"json\"): field type '")
            mp_sref(ck, a, nsr)
            mp(ck, "' needs @derive(\"json\") too")
            raise mk_fail(ck, "TypeMismatch")
        fcall: int = mk_attr_call_node(a, mk_ident_node(a, sref_str(a, nsr)), "from_json_value", ast_expr_list(a, [e]))
        out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, fcall, 0, 0, 0, 0)), line, -1))
        return
    jvsr: int = syn(a, "JsonValue")
    jv_te: int = mk_TypeExpr_simple(a, pkx(jvsr), pky(jvsr))
    isr: int = syn(a, "int")
    i_te: int = mk_TypeExpr_simple(a, pkx(isr), pky(isr))
    if tag == {{T:TypeExpr.generic}}:
        gp: int = a.n[te + 1]
        gn: int = pk(a.n[gp + {{O:Generic.name}}], a.n[gp + {{O:Generic.name}} + 1])
        gargs: int = sl_at(a, gp, {{O:Generic.args}})
        ck.ext_cnt = ck.ext_cnt + 1
        id_s: str = str(ck.ext_cnt)
        if sref_eq(a, gn, "list") and pky(gargs) == 1:
            lvn: str = "__lv" + id_s
            inm: str = "__i" + id_s
            xnm: str = "__x" + id_s
            lvsr: int = syn(a, lvn)
            iisr: int = syn(a, inm)
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(lvsr), pky(lvsr), jv_te, e, 0, 0, 0, 0)), line, -1))
            out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, drv_mk_qual_call(a, ["nox", "json", "expect_array"], [mk_ident_node(a, lvn)])), line, -1))
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, mk_Expr_list_lit(a, 0, 0), 0, 0, 0, 0)), line, -1))
            out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(iisr), pky(iisr), i_te, mk_Expr_int_lit(a, 0), 0, 0, 0, 0)), line, -1))
            wcond: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, mk_ident_node(a, inm), drv_mk_qual_call(a, ["nox", "json", "array_len"], [mk_ident_node(a, lvn)]), 0, 0, 0, 0))
            wstmts: list[int] = []
            drv_gen_read(ck, a, wstmts, xnm, drv_mk_qual_call(a, ["nox", "json", "array_get"], [mk_ident_node(a, lvn), mk_ident_node(a, inm)]), stmt_at(a, gargs, 0), wants, line)
            wstmts.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, target), "append", ast_expr_list(a, [mk_ident_node(a, xnm)]))), line, -1))
            wstmts.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, mk_ident_node(a, inm), mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.add}}, mk_ident_node(a, inm), mk_Expr_int_lit(a, 1), 0, 0, 0, 0)), {{NONE}})), line, -1))
            wb: int = ast_stmt_list(a, wstmts)
            out.append(mk_Stmt(a, mk_StmtKind_while_stmt(a, mk_WhileStmt(a, wcond, pkx(wb), pky(wb), -1)), line, -1))
            return
        if sref_eq(a, gn, "dict") and pky(gargs) == 2:
            a0: int = stmt_at(a, gargs, 0)
            if a.n[a0] == {{T:TypeExpr.simple}} and sref_eq(a, pk(a.n[a0 + 1], a.n[a0 + 2]), "str"):
                dvn: str = "__dv" + id_s
                jnm: str = "__j" + id_s
                xnm2: str = "__x" + id_s
                dvsr: int = syn(a, dvn)
                jjsr: int = syn(a, jnm)
                dsr: int = syn(a, "dict")
                out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(dvsr), pky(dvsr), jv_te, e, 0, 0, 0, 0)), line, -1))
                out.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, drv_mk_qual_call(a, ["nox", "json", "expect_object"], [mk_ident_node(a, dvn), mk_Expr_string_lit(a, pkx(dsr), pky(dsr))])), line, -1))
                out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, mk_Expr_dict_lit(a, 0, 0), 0, 0, 0, 0)), line, -1))
                out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(jjsr), pky(jjsr), i_te, mk_Expr_int_lit(a, 0), 0, 0, 0, 0)), line, -1))
                wcond2: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, mk_ident_node(a, jnm), drv_mk_qual_call(a, ["nox", "json", "object_len"], [mk_ident_node(a, dvn)]), 0, 0, 0, 0))
                wstmts2: list[int] = []
                drv_gen_read(ck, a, wstmts2, xnm2, drv_mk_qual_call(a, ["nox", "json", "object_value"], [mk_ident_node(a, dvn), mk_ident_node(a, jnm)]), stmt_at(a, gargs, 1), wants, line)
                kcall: int = drv_mk_qual_call(a, ["nox", "json", "object_key"], [mk_ident_node(a, dvn), mk_ident_node(a, jnm)])
                wstmts2.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, mk_Expr_index(a, mk_Index(a, mk_ident_node(a, target), kcall)), mk_ident_node(a, xnm2), {{NONE}})), line, -1))
                wstmts2.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, mk_ident_node(a, jnm), mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.add}}, mk_ident_node(a, jnm), mk_Expr_int_lit(a, 1), 0, 0, 0, 0)), {{NONE}})), line, -1))
                wb2: int = ast_stmt_list(a, wstmts2)
                out.append(mk_Stmt(a, mk_StmtKind_while_stmt(a, mk_WhileStmt(a, wcond2, pkx(wb2), pky(wb2), -1)), line, -1))
                return
        ck.cur_line = line
        mp(ck, "@derive(\"json\"): unsupported field type ")
        mp_sref(ck, a, gn)
        mp(ck, "[...]")
        raise mk_fail(ck, "TypeMismatch")
    if tag == {{T:TypeExpr.optional}}:
        ck.ext_cnt = ck.ext_cnt + 1
        id_o: str = str(ck.ext_cnt)
        ovn: str = "__ov" + id_o
        xnm3: str = "__x" + id_o
        ovsr: int = syn(a, ovn)
        out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(ovsr), pky(ovsr), jv_te, e, 0, 0, 0, 0)), line, -1))
        out.append(mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(tsr), pky(tsr), te, mk_Expr_none_lit(a), 0, 0, 0, 0)), line, -1))
        icond: int = mk_Expr_unary(a, mk_Unary(a, {{E:UnaryOp.not_}}, drv_mk_qual_call(a, ["nox", "json", "is_null"], [mk_ident_node(a, ovn)])))
        tstmts: list[int] = []
        drv_gen_read(ck, a, tstmts, xnm3, mk_ident_node(a, ovn), a.n[te + 1], wants, line)
        tstmts.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, mk_ident_node(a, target), mk_ident_node(a, xnm3), {{NONE}})), line, -1))
        tb3: int = ast_stmt_list(a, tstmts)
        out.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, icond, pkx(tb3), pky(tb3), 0, 0, 0, 0, 0, -1, 0)), line, -1))
        return
    ck.cur_line = line
    fail2(ck, "TypeMismatch", "@derive(\"json\"): unsupported field type")

def drv_mk_method(a: Ast, name_s: str, ps: list[int], ret_te: int, body_stmts: list[int], is_static: bool, line: int) -> int:
    nsr: int = syn(a, name_s)
    psl: int = ast_stmt_list(a, ps)
    bsl: int = ast_stmt_list(a, body_stmts)
    dec_sl: int = pk(0, 0)
    if is_static:
        stsr: int = syn(a, "staticmethod")
        dec_sl = ast_stmt_list(a, [mk_Decorator(a, pkx(stsr), pky(stsr), 0, 0, line)])
    return mk_FuncDef(a, pkx(nsr), pky(nsr), 0, 0, pkx(psl), pky(psl), ret_te, 0, pkx(bsl), pky(bsl), 0, pkx(dec_sl), pky(dec_sl), {{NONE}}, 0, 0, 0, 0, 0, 0, line)

def drv_expand_class(ck: Ck, a: Ast, cd: int, c_map: Map2, wants: Map2, all_fs: Map2, f_pool: list[int], done: Map2, json_imp: bool, line: int) -> None:
    csym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.name}}], a.n[cd + {{O:ClassDef.name}} + 1]))
    if m2_get(done, 0, csym) >= 0:
        return
    m2_put(done, 0, csym, 1)
    we: int = m2_get(wants, 0, csym)
    if we < 0:
        return
    w: int = wants.vv[we]
    if pky(sl_at(a, cd, {{O:ClassDef.type_params}})) > 0:
        ck.cur_line = line
        mp(ck, "@dataclass/@derive cannot be used on a generic class (")
        mp_sym(ck, csym)
        mp(ck, ")")
        raise mk_fail(ck, "TypeMismatch")
    if pky(sl_at(a, cd, {{O:ClassDef.enum_variants}})) > 0:
        ck.cur_line = line
        mp(ck, "@dataclass/@derive cannot be used on an enum (")
        mp_sym(ck, csym)
        mp(ck, ")")
        raise mk_fail(ck, "TypeMismatch")
    fields: list[int] = []
    base_has_dc: bool = False
    if a.n[cd + {{O:ClassDef.base}}] != {{NONE}}:
        bsym: int = sym_of(ck, a, pk(a.n[cd + {{O:ClassDef.base}}], a.n[cd + {{O:ClassDef.base}} + 1]))
        bce: int = m2_get(c_map, 0, bsym)
        bwe: int = m2_get(wants, 0, bsym)
        if bce >= 0 and bwe >= 0 and (wants.vv[bwe] & 1) != 0:
            drv_expand_class(ck, a, c_map.vv[bce], c_map, wants, all_fs, f_pool, done, json_imp, line)
            afe: int = m2_get(all_fs, 0, bsym)
            if afe >= 0:
                afsl: int = all_fs.vv[afe]
                for bfi in range(pky(afsl)):
                    fields.append(f_pool[pkx(afsl) + bfi])
            base_has_dc = True
        if not base_has_dc and (w & 1) != 0:
            ck.cur_line = line
            mp(ck, "@dataclass class ")
            mp_sym(ck, csym)
            mp(ck, ": its base class '")
            mp_sym(ck, bsym)
            mp(ck, "' must also be a @dataclass")
            raise mk_fail(ck, "TypeMismatch")
    own_fs: int = sl_at(a, cd, {{O:ClassDef.fields}})
    own_start: int = len(fields)
    for fi in range(pky(own_fs)):
        fd: int = stmt_at(a, own_fs, fi)
        fnm: int = pk(a.n[fd + {{O:FieldDecl.name}}], a.n[fd + {{O:FieldDecl.name}} + 1])
        fsym: int = sym_of(ck, a, fnm)
        for gf in fields:
            if sym_of(ck, a, pk(a.n[gf + {{O:FieldDecl.name}}], a.n[gf + {{O:FieldDecl.name}} + 1])) == fsym:
                ck.cur_line = line
                mp(ck, "@dataclass class ")
                mp_sym(ck, csym)
                mp(ck, ": field '")
                mp_sref(ck, a, fnm)
                mp(ck, "' repeats a field of its base class")
                raise mk_fail(ck, "TypeMismatch")
        fields.append(fd)
    if (w & 1) != 0:
        fp0: int = len(f_pool)
        for f0 in fields:
            f_pool.append(f0)
        m2_put(all_fs, 0, csym, pk(fp0, len(fields)))
        if drv_has_method(a, cd, "__init__"):
            ck.cur_line = line
            mp(ck, "@dataclass class ")
            mp_sym(ck, csym)
            mp(ck, " must not define __init__ (the compiler generates it)")
            raise mk_fail(ck, "TypeMismatch")
        if len(fields) == 0:
            ck.cur_line = line
            mp(ck, "@dataclass class ")
            mp_sym(ck, csym)
            mp(ck, " has no fields (declare them as `name: type` lines in the class body)")
            raise mk_fail(ck, "TypeMismatch")
    elif (w & 14) != 0:
        if len(fields) == 0:
            ck.cur_line = line
            mp(ck, "@derive on class ")
            mp_sym(ck, csym)
            mp(ck, " needs fields declared as `name: type` lines in the class body")
            raise mk_fail(ck, "TypeMismatch")
    if (w & 12) != 0 and (w & 1) == 0:
        ck.cur_line = line
        mp(ck, "@derive(\"copy\"/\"json\") on class ")
        mp_sym(ck, csym)
        mp(ck, " needs @dataclass as well (it rebuilds the object through the generated __init__)")
        raise mk_fail(ck, "TypeMismatch")
    if (w & 8) != 0 and not json_imp:
        ck.cur_line = line
        mp(ck, "@derive(\"json\") on class ")
        mp_sym(ck, csym)
        mp(ck, " needs `import nox.json`")
        raise mk_fail(ck, "TypeMismatch")
    cname_s: str = sym_to_str(ck, csym)
    csr: int = ast_str_sym(ck, a, csym)
    cls_te: int = mk_TypeExpr_simple(a, pkx(csr), pky(csr))
    self_sr: int = syn(a, "self")
    self_p: int = mk_Param(a, pkx(self_sr), pky(self_sr), 0, 0, 0, 0, cls_te, 0, {{NONE}})
    none_sr: int = syn(a, "None")
    none_te: int = mk_TypeExpr_simple(a, pkx(none_sr), pky(none_sr))
    bool_sr: int = syn(a, "bool")
    bool_te: int = mk_TypeExpr_simple(a, pkx(bool_sr), pky(bool_sr))
    str_sr: int = syn(a, "str")
    str_te: int = mk_TypeExpr_simple(a, pkx(str_sr), pky(str_sr))
    gen_m: list[int] = []
    if (w & 1) != 0:
        ips: list[int] = [self_p]
        for fd2 in fields:
            drv_type_check_no_func(ck, a, a.n[fd2 + {{O:FieldDecl.type_expr}}], line)
            ips.append(mk_Param(a, a.n[fd2 + {{O:FieldDecl.name}}], a.n[fd2 + {{O:FieldDecl.name}} + 1], 0, 0, 0, 0, a.n[fd2 + {{O:FieldDecl.type_expr}}], 0, {{NONE}}))
        ibody: list[int] = []
        if base_has_dc:
            sargs: list[int] = []
            for bi in range(own_start):
                bfd: int = fields[bi]
                sargs.append(mk_Expr_identifier(a, a.n[bfd + {{O:FieldDecl.name}}], a.n[bfd + {{O:FieldDecl.name}} + 1]))
            sup_cal: int = mk_Expr_call(a, mk_Call(a, mk_ident_node(a, "super"), 0, 0, 0, 0, 0, 0, 0, 0))
            ibody.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, sup_cal, "__init__", ast_expr_list(a, sargs))), line, -1))
        for oi in range(own_start, len(fields)):
            ofd: int = fields[oi]
            fn0: int = a.n[ofd + {{O:FieldDecl.name}}]
            fn1: int = a.n[ofd + {{O:FieldDecl.name}} + 1]
            ibody.append(mk_Stmt(a, mk_StmtKind_assign(a, mk_Assign(a, mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "self"), fn0, fn1)), mk_Expr_identifier(a, fn0, fn1), {{NONE}})), line, -1))
        gen_m.append(drv_mk_method(a, "__init__", ips, none_te, ibody, False, line))
    if (w & 2) != 0:
        for om in ["__lt__", "__le__", "__gt__", "__ge__"]:
            if drv_has_method(a, cd, om):
                ck.cur_line = line
                mp(ck, "class ")
                mp(ck, cname_s)
                mp(ck, " defines ")
                mp(ck, om)
                mp(ck, " itself: remove @derive(\"order\") or the method")
                raise mk_fail(ck, "TypeMismatch")
        for fd3 in fields:
            if a.n[a.n[fd3 + {{O:FieldDecl.type_expr}}]] != {{T:TypeExpr.simple}}:
                ck.cur_line = line
                mp(ck, "@derive(\"order\") class ")
                mp(ck, cname_s)
                mp(ck, ": field '")
                mp_sref(ck, a, pk(a.n[fd3 + {{O:FieldDecl.name}}], a.n[fd3 + {{O:FieldDecl.name}} + 1]))
                mp(ck, "' has a type that cannot be ordered (use int, float, bool, str or an orderable class)")
                raise mk_fail(ck, "TypeMismatch")
        osr: int = syn(a, "o")
        op_p: int = mk_Param(a, pkx(osr), pky(osr), 0, 0, 0, 0, cls_te, 0, {{NONE}})
        lt_body: list[int] = []
        for fd4 in fields:
            fn0: int = a.n[fd4 + {{O:FieldDecl.name}}]
            fn1: int = a.n[fd4 + {{O:FieldDecl.name}} + 1]
            sf: int = mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "self"), fn0, fn1))
            of_: int = mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "o"), fn0, fn1))
            ne_c: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.ne}}, sf, of_, 0, 0, 0, 0))
            sf2: int = mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "self"), fn0, fn1))
            of2: int = mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "o"), fn0, fn1))
            lt_e: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, sf2, of2, 0, 0, 0, 0))
            tb_l: int = ast_stmt_list(a, [mk_Stmt(a, mk_StmtKind_return_stmt(a, lt_e), line, -1)])
            lt_body.append(mk_Stmt(a, mk_StmtKind_if_stmt(a, mk_IfStmt(a, ne_c, pkx(tb_l), pky(tb_l), 0, 0, 0, 0, 0, -1, 0)), line, -1))
        lt_body.append(mk_Stmt(a, mk_StmtKind_return_stmt(a, mk_Expr_bool_lit(a, 0)), line, -1))
        gen_m.append(drv_mk_method(a, "__lt__", [self_p, op_p], bool_te, lt_body, False, line))
        le_ret: int = mk_Expr_unary(a, mk_Unary(a, {{E:UnaryOp.not_}}, mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, mk_ident_node(a, "o"), mk_ident_node(a, "self"), 0, 0, 0, 0))))
        gen_m.append(drv_mk_method(a, "__le__", [self_p, op_p], bool_te, [mk_Stmt(a, mk_StmtKind_return_stmt(a, le_ret), line, -1)], False, line))
        gt_ret: int = mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, mk_ident_node(a, "o"), mk_ident_node(a, "self"), 0, 0, 0, 0))
        gen_m.append(drv_mk_method(a, "__gt__", [self_p, op_p], bool_te, [mk_Stmt(a, mk_StmtKind_return_stmt(a, gt_ret), line, -1)], False, line))
        ge_ret: int = mk_Expr_unary(a, mk_Unary(a, {{E:UnaryOp.not_}}, mk_Expr_binary(a, mk_Binary(a, {{E:BinaryOp.lt}}, mk_ident_node(a, "self"), mk_ident_node(a, "o"), 0, 0, 0, 0))))
        gen_m.append(drv_mk_method(a, "__ge__", [self_p, op_p], bool_te, [mk_Stmt(a, mk_StmtKind_return_stmt(a, ge_ret), line, -1)], False, line))
    if (w & 4) != 0:
        if drv_has_method(a, cd, "copy"):
            ck.cur_line = line
            mp(ck, "class ")
            mp(ck, cname_s)
            mp(ck, " defines copy itself: remove @derive(\"copy\") or the method")
            raise mk_fail(ck, "TypeMismatch")
        cargs: list[int] = []
        for fd5 in fields:
            cargs.append(mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "self"), a.n[fd5 + {{O:FieldDecl.name}}], a.n[fd5 + {{O:FieldDecl.name}} + 1])))
        cal_c: int = ast_expr_list(a, cargs)
        cret: int = mk_Expr_call(a, mk_Call(a, mk_ident_node(a, cname_s), pkx(cal_c), pky(cal_c), 0, 0, 0, 0, 0, 0))
        gen_m.append(drv_mk_method(a, "copy", [self_p], cls_te, [mk_Stmt(a, mk_StmtKind_return_stmt(a, cret), line, -1)], False, line))
    if (w & 8) != 0:
        for jm in ["to_json", "write_json", "from_json", "from_json_value"]:
            if drv_has_method(a, cd, jm):
                ck.cur_line = line
                mp(ck, "class ")
                mp(ck, cname_s)
                mp(ck, " defines ")
                mp(ck, jm)
                mp(ck, " itself: remove @derive(\"json\") or the method")
                raise mk_fail(ck, "TypeMismatch")
        njw_st: int = len(a.l)
        for seg_s in ["nox", "json", "JsonWriter"]:
            s_sr: int = syn(a, seg_s)
            a.l.append(pkx(s_sr))
            a.l.append(pky(s_sr))
        jw_te: int = mk_TypeExpr_qualified(a, njw_st, 3)
        wsr: int = syn(a, "w")
        w_p: int = mk_Param(a, pkx(wsr), pky(wsr), 0, 0, 0, 0, jw_te, 0, {{NONE}})
        wj_body: list[int] = [mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "begin_object", pk(0, 0))), line, -1)]
        for fd6 in fields:
            fn0: int = a.n[fd6 + {{O:FieldDecl.name}}]
            fn1: int = a.n[fd6 + {{O:FieldDecl.name}} + 1]
            wj_body.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "write_key", ast_expr_list(a, [mk_Expr_string_lit(a, fn0, fn1)]))), line, -1))
            drv_gen_write(ck, a, wj_body, mk_Expr_attribute(a, mk_Attribute(a, mk_ident_node(a, "self"), fn0, fn1)), a.n[fd6 + {{O:FieldDecl.type_expr}}], wants, line)
        wj_body.append(mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "end_object", pk(0, 0))), line, -1))
        gen_m.append(drv_mk_method(a, "write_json", [self_p, w_p], none_te, wj_body, False, line))
        tj_body: list[int] = [
            mk_Stmt(a, mk_StmtKind_var_decl(a, mk_VarDecl(a, pkx(wsr), pky(wsr), jw_te, drv_mk_qual_call(a, ["nox", "json", "JsonWriter"], []), 0, 0, 0, 0)), line, -1),
            mk_Stmt(a, mk_StmtKind_expr_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "self"), "write_json", ast_expr_list(a, [mk_ident_node(a, "w")]))), line, -1),
            mk_Stmt(a, mk_StmtKind_return_stmt(a, mk_attr_call_node(a, mk_ident_node(a, "w"), "build", pk(0, 0))), line, -1),
        ]
        gen_m.append(drv_mk_method(a, "to_json", [self_p], str_te, tj_body, False, line))
        jvsr2: int = syn(a, "JsonValue")
        jv_te2: int = mk_TypeExpr_simple(a, pkx(jvsr2), pky(jvsr2))
        vsr2: int = syn(a, "v")
        v_p: int = mk_Param(a, pkx(vsr2), pky(vsr2), 0, 0, 0, 0, jv_te2, 0, {{NONE}})
        fjv_body: list[int] = [mk_Stmt(a, mk_StmtKind_expr_stmt(a, drv_mk_qual_call(a, ["nox", "json", "expect_object"], [mk_ident_node(a, "v"), mk_Expr_string_lit(a, pkx(csr), pky(csr))])), line, -1)]
        ctor_args: list[int] = []
        for fi7 in range(len(fields)):
            fd7: int = fields[fi7]
            ft7: int = a.n[fd7 + {{O:FieldDecl.type_expr}}]
            tgt: str = "__f" + str(fi7)
            gname: str = "get_or_null" if a.n[ft7] == {{T:TypeExpr.optional}} else "get"
            fn_lit: int = mk_Expr_string_lit(a, a.n[fd7 + {{O:FieldDecl.name}}], a.n[fd7 + {{O:FieldDecl.name}} + 1])
            drv_gen_read(ck, a, fjv_body, tgt, drv_mk_qual_call(a, ["nox", "json", gname], [mk_ident_node(a, "v"), fn_lit]), ft7, wants, line)
            ctor_args.append(mk_ident_node(a, tgt))
        cal_fjv: int = ast_expr_list(a, ctor_args)
        fjv_body.append(mk_Stmt(a, mk_StmtKind_return_stmt(a, mk_Expr_call(a, mk_Call(a, mk_ident_node(a, cname_s), pkx(cal_fjv), pky(cal_fjv), 0, 0, 0, 0, 0, 0))), line, -1))
        gen_m.append(drv_mk_method(a, "from_json_value", [v_p], cls_te, fjv_body, True, line))
        ssr2: int = syn(a, "s")
        s_p: int = mk_Param(a, pkx(ssr2), pky(ssr2), 0, 0, 0, 0, str_te, 0, {{NONE}})
        fj_ret: int = mk_attr_call_node(a, mk_ident_node(a, cname_s), "from_json_value", ast_expr_list(a, [drv_mk_qual_call(a, ["nox", "json", "parse"], [mk_ident_node(a, "s")])]))
        gen_m.append(drv_mk_method(a, "from_json", [s_p], cls_te, [mk_Stmt(a, mk_StmtKind_return_stmt(a, fj_ret), line, -1)], True, line))
    if len(gen_m) == 0:
        return
    ms_orig: int = sl_at(a, cd, {{O:ClassDef.methods}})
    merged: list[int] = []
    for mi in range(pky(ms_orig)):
        merged.append(stmt_at(a, ms_orig, mi))
    for gm in gen_m:
        merged.append(gm)
    msl_out: int = ast_stmt_list(a, merged)
    a.n[cd + {{O:ClassDef.methods}}] = pkx(msl_out)
    a.n[cd + {{O:ClassDef.methods}} + 1] = pky(msl_out)

def derive_run(ck: Ck, a: Ast, body: int) -> None:
    json_imp: bool = False
    c_map: Map2 = Map2()
    wants: Map2 = Map2()
    any_w: bool = False
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.import_stmt}}:
            sgs: int = sl_at(a, pay, {{O:ImportStmt.segments}})
            if pky(sgs) == 2 and a.n[pay + {{O:ImportStmt.alias}}] == {{NONE}}:
                s0: int = pk(a.l[pkx(sgs)], a.l[pkx(sgs) + 1])
                s1: int = pk(a.l[pkx(sgs) + 2], a.l[pkx(sgs) + 3])
                if sref_eq(a, s0, "nox") and sref_eq(a, s1, "json"):
                    json_imp = True
        elif tag == {{T:StmtKind.class_def}}:
            csym: int = sym_of(ck, a, pk(a.n[pay + {{O:ClassDef.name}}], a.n[pay + {{O:ClassDef.name}} + 1]))
            m2_put(c_map, 0, csym, pay)
            decs: int = sl_at(a, pay, {{O:ClassDef.decorators}})
            w: int = 0
            for di in range(pky(decs)):
                dec: int = stmt_at(a, decs, di)
                dn: int = pk(a.n[dec + {{O:Decorator.name}}], a.n[dec + {{O:Decorator.name}} + 1])
                dline: int = a.n[dec + {{O:Decorator.line}}]
                dargs: int = sl_at(a, dec, {{O:Decorator.args}})
                if sref_eq(a, dn, "dataclass"):
                    if pky(dargs) != 0:
                        ck.cur_line = dline
                        mp(ck, "@dataclass takes no arguments (class ")
                        mp_sym(ck, csym)
                        mp(ck, ")")
                        raise mk_fail(ck, "TypeMismatch")
                    w = w | 1
                elif sref_eq(a, dn, "derive"):
                    if pky(dargs) == 0:
                        ck.cur_line = dline
                        mp(ck, "@derive needs at least one name: \"order\", \"copy\" or \"json\" (class ")
                        mp_sym(ck, csym)
                        mp(ck, ")")
                        raise mk_fail(ck, "TypeMismatch")
                    for ai in range(pky(dargs)):
                        arg: int = stmt_at(a, dargs, ai)
                        if a.n[arg] != {{T:Expr.string_lit}}:
                            ck.cur_line = dline
                            mp(ck, "@derive arguments must be string literals (class ")
                            mp_sym(ck, csym)
                            mp(ck, ")")
                            raise mk_fail(ck, "TypeMismatch")
                        asr: int = pk(a.n[arg + 1], a.n[arg + 2])
                        if sref_eq(a, asr, "order"):
                            w = w | 2
                        elif sref_eq(a, asr, "copy"):
                            w = w | 4
                        elif sref_eq(a, asr, "json"):
                            w = w | 8
                        elif sref_eq(a, asr, "eq") or sref_eq(a, asr, "repr") or sref_eq(a, asr, "str") or sref_eq(a, asr, "hash"):
                            ck.cur_line = dline
                            mp(ck, "@derive(\"")
                            mp_sref(ck, a, asr)
                            mp(ck, "\") is not needed: == and printing are already structural for every class (class ")
                            mp_sym(ck, csym)
                            mp(ck, ")")
                            raise mk_fail(ck, "TypeMismatch")
                        else:
                            ck.cur_line = dline
                            mp(ck, "unknown @derive name \"")
                            mp_sref(ck, a, asr)
                            mp(ck, "\" (known: \"order\", \"copy\", \"json\"; class ")
                            mp_sym(ck, csym)
                            mp(ck, ")")
                            raise mk_fail(ck, "TypeMismatch")
            if w != 0:
                m2_put(wants, 0, csym, w)
                any_w = True
    if not any_w:
        return
    all_fs: Map2 = Map2()
    f_pool: list[int] = []
    done: Map2 = Map2()
    for i2 in range(pky(body)):
        st2: int = stmt_at(a, body, i2)
        kn2: int = a.n[st2 + {{O:Stmt.kind}}]
        if a.n[kn2] == {{T:StmtKind.class_def}}:
            drv_expand_class(ck, a, a.n[kn2 + 1], c_map, wants, all_fs, f_pool, done, json_imp, a.n[st2 + {{O:Stmt.line}}])

# ---- Faz C.6: index_call_fixup ----
def icf_collect_vars(ck: Ck, a: Ast, stmts: int, vmap: Map2) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.var_decl}}:
            m2_put(vmap, 0, sym_of(ck, a, pk(a.n[pay + {{O:VarDecl.name}}], a.n[pay + {{O:VarDecl.name}} + 1])), 1)
        elif tag == {{T:StmtKind.for_stmt}}:
            m2_put(vmap, 0, sym_of(ck, a, pk(a.n[pay + {{O:ForStmt.var_name}}], a.n[pay + {{O:ForStmt.var_name}} + 1])), 1)
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), vmap)
        elif tag == {{T:StmtKind.with_stmt}}:
            if a.n[pay + {{O:WithStmt.binding}}] != {{NONE}}:
                m2_put(vmap, 0, sym_of(ck, a, pk(a.n[pay + {{O:WithStmt.binding}}], a.n[pay + {{O:WithStmt.binding}} + 1])), 1)
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), vmap)
        elif tag == {{T:StmtKind.try_stmt}}:
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), vmap)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                ec: int = stmt_at(a, exs, k)
                if a.n[ec + {{O:ExceptClause.bind_name}}] != {{NONE}}:
                    m2_put(vmap, 0, sym_of(ck, a, pk(a.n[ec + {{O:ExceptClause.bind_name}}], a.n[ec + {{O:ExceptClause.bind_name}} + 1])), 1)
                icf_collect_vars(ck, a, sl_at(a, ec, {{O:ExceptClause.body}}), vmap)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                icf_collect_vars(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), vmap)
        elif tag == {{T:StmtKind.if_stmt}}:
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), vmap)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                icf_collect_vars(ck, a, sl_at(a, stmt_at(a, ecs, j), {{O:ElifClause.body}}), vmap)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                icf_collect_vars(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), vmap)
        elif tag == {{T:StmtKind.while_stmt}}:
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), vmap)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), vmap)
        elif tag == {{T:StmtKind.func_def}}:
            ps: int = sl_at(a, pay, {{O:FuncDef.params}})
            for pi in range(pky(ps)):
                p: int = stmt_at(a, ps, pi)
                m2_put(vmap, 0, sym_of(ck, a, pk(a.n[p + {{O:Param.name}}], a.n[p + {{O:Param.name}} + 1])), 1)
            icf_collect_vars(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), vmap)
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                m: int = stmt_at(a, ms, mi)
                ps2: int = sl_at(a, m, {{O:FuncDef.params}})
                for pi2 in range(pky(ps2)):
                    p2: int = stmt_at(a, ps2, pi2)
                    m2_put(vmap, 0, sym_of(ck, a, pk(a.n[p2 + {{O:Param.name}}], a.n[p2 + {{O:Param.name}} + 1])), 1)
                icf_collect_vars(ck, a, sl_at(a, m, {{O:FuncDef.body}}), vmap)

def icf_te_to_idx(a: Ast, te: int) -> int:
    tag: int = a.n[te]
    if tag == {{T:TypeExpr.simple}}:
        return mk_Expr_identifier(a, a.n[te + 1], a.n[te + 2])
    if tag == {{T:TypeExpr.qualified}}:
        q0: int = a.n[te + 1]
        qn: int = a.n[te + 2]
        if qn < 2:
            return -1
        cur: int = mk_Expr_identifier(a, a.l[q0], a.l[q0 + 1])
        for i in range(1, qn):
            cur = mk_Expr_attribute(a, mk_Attribute(a, cur, a.l[q0 + i * 2], a.l[q0 + i * 2 + 1]))
        return cur
    if tag == {{T:TypeExpr.generic}}:
        gp: int = a.n[te + 1]
        gargs: int = sl_at(a, gp, {{O:Generic.args}})
        if pky(gargs) != 1:
            return -1
        inner: int = icf_te_to_idx(a, stmt_at(a, gargs, 0))
        if inner < 0:
            return -1
        obj: int = mk_Expr_identifier(a, a.n[gp + {{O:Generic.name}}], a.n[gp + {{O:Generic.name}} + 1])
        return mk_Expr_index(a, mk_Index(a, obj, inner))
    return -1

def icf_fix_expr(ck: Ck, a: Ast, e: int, gmap: Map2, vmap: Map2) -> None:
    tag: int = a.n[e]
    if tag == {{T:Expr.generic_construct}}:
        gc: int = a.n[e + 1]
        gargs: int = sl_at(a, gc, {{O:GenericConstruct.args}})
        for ai in range(pky(gargs)):
            icf_fix_expr(ck, a, stmt_at(a, gargs, ai), gmap, vmap)
        targs: int = sl_at(a, gc, {{O:GenericConstruct.type_args}})
        if pky(targs) != 1:
            return
        gn: int = pk(a.n[gc + {{O:GenericConstruct.name}}], a.n[gc + {{O:GenericConstruct.name}} + 1])
        if sref_eq(a, gn, "ptr") or sref_eq(a, gn, "Channel") or sref_eq(a, gn, "ThreadChannel") or sref_eq(a, gn, "TaskLocal"):
            return
        gsym: int = sym_of(ck, a, gn)
        if m2_get(gmap, 0, gsym) >= 0 or m2_get(vmap, 0, gsym) < 0:
            return
        idx_e: int = icf_te_to_idx(a, stmt_at(a, targs, 0))
        if idx_e < 0:
            return
        cal: int = mk_Expr_index(a, mk_Index(a, mk_Expr_identifier(a, pkx(gn), pky(gn)), idx_e))
        a.n[e] = {{T:Expr.call}}
        a.n[e + 1] = mk_Call(a, cal, pkx(gargs), pky(gargs), 0, 0, 0, 0, 0, 0)
        return
    if tag == {{T:Expr.unary}}:
        icf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}], gmap, vmap)
    elif tag == {{T:Expr.kwarg}}:
        icf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}], gmap, vmap)
    elif tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[tp + {{O:Ternary.cond}}], gmap, vmap)
        icf_fix_expr(ck, a, a.n[tp + {{O:Ternary.then_expr}}], gmap, vmap)
        icf_fix_expr(ck, a, a.n[tp + {{O:Ternary.else_expr}}], gmap, vmap)
    elif tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[bp + {{O:Binary.left}}], gmap, vmap)
        icf_fix_expr(ck, a, a.n[bp + {{O:Binary.right}}], gmap, vmap)
    elif tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[cp + {{O:Call.callee}}], gmap, vmap)
        cargs: int = sl_at(a, cp, {{O:Call.args}})
        for ci in range(pky(cargs)):
            icf_fix_expr(ck, a, stmt_at(a, cargs, ci), gmap, vmap)
    elif tag == {{T:Expr.attribute}}:
        icf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Attribute.obj}}], gmap, vmap)
    elif tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[ip + {{O:Index.obj}}], gmap, vmap)
        icf_fix_expr(ck, a, a.n[ip + {{O:Index.index}}], gmap, vmap)
    elif tag == {{T:Expr.slice}}:
        sp: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[sp + {{O:Slice.obj}}], gmap, vmap)
        if a.n[sp + {{O:Slice.lo}}] >= 0:
            icf_fix_expr(ck, a, a.n[sp + {{O:Slice.lo}}], gmap, vmap)
        if a.n[sp + {{O:Slice.hi}}] >= 0:
            icf_fix_expr(ck, a, a.n[sp + {{O:Slice.hi}}], gmap, vmap)
        if a.n[sp + {{O:Slice.step}}] >= 0:
            icf_fix_expr(ck, a, a.n[sp + {{O:Slice.step}}], gmap, vmap)
    elif tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        for li in range(a.n[e + 2]):
            icf_fix_expr(ck, a, a.l[a.n[e + 1] + li], gmap, vmap)
    elif tag == {{T:Expr.dict_lit}}:
        for di in range(a.n[e + 2]):
            pr: int = a.l[a.n[e + 1] + di]
            icf_fix_expr(ck, a, a.n[pr + {{O:DictPair.key}}], gmap, vmap)
            icf_fix_expr(ck, a, a.n[pr + {{O:DictPair.value}}], gmap, vmap)
    elif tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[lc + {{O:ListComp.elem}}], gmap, vmap)
        cls: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for qi in range(pky(cls)):
            cl: int = stmt_at(a, cls, qi)
            if a.n[cl] == {{T:CompClause.for_clause}}:
                icf_fix_expr(ck, a, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], gmap, vmap)
            else:
                icf_fix_expr(ck, a, a.n[cl + 1], gmap, vmap)
    elif tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        icf_fix_expr(ck, a, a.n[dc + {{O:DictComp.key}}], gmap, vmap)
        icf_fix_expr(ck, a, a.n[dc + {{O:DictComp.value}}], gmap, vmap)
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for qi2 in range(pky(dcls)):
            cl2: int = stmt_at(a, dcls, qi2)
            if a.n[cl2] == {{T:CompClause.for_clause}}:
                icf_fix_expr(ck, a, a.n[a.n[cl2 + 1] + {{O:CompForClause.iterable}}], gmap, vmap)
            else:
                icf_fix_expr(ck, a, a.n[cl2 + 1], gmap, vmap)
    elif tag == {{T:Expr.lambda}}:
        icf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Lambda.body}}], gmap, vmap)
    elif tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        icf_fix_expr(ck, a, a.n[e + 1], gmap, vmap)

def icf_fix_stmts(ck: Ck, a: Ast, stmts: int, gmap: Map2, vmap: Map2) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}} or tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            icf_fix_expr(ck, a, pay, gmap, vmap)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                icf_fix_expr(ck, a, pay, gmap, vmap)
        elif tag == {{T:StmtKind.var_decl}}:
            icf_fix_expr(ck, a, a.n[pay + {{O:VarDecl.value}}], gmap, vmap)
        elif tag == {{T:StmtKind.assign}}:
            icf_fix_expr(ck, a, a.n[pay + {{O:Assign.target}}], gmap, vmap)
            icf_fix_expr(ck, a, a.n[pay + {{O:Assign.value}}], gmap, vmap)
        elif tag == {{T:StmtKind.if_stmt}}:
            icf_fix_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}], gmap, vmap)
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), gmap, vmap)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                ec: int = stmt_at(a, ecs, j)
                icf_fix_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}], gmap, vmap)
                icf_fix_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}), gmap, vmap)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                icf_fix_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), gmap, vmap)
        elif tag == {{T:StmtKind.while_stmt}}:
            icf_fix_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}], gmap, vmap)
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), gmap, vmap)
        elif tag == {{T:StmtKind.for_stmt}}:
            icf_fix_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}], gmap, vmap)
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), gmap, vmap)
        elif tag == {{T:StmtKind.func_def}}:
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), gmap, vmap)
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                icf_fix_stmts(ck, a, sl_at(a, stmt_at(a, ms, mi), {{O:FuncDef.body}}), gmap, vmap)
        elif tag == {{T:StmtKind.try_stmt}}:
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), gmap, vmap)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                icf_fix_stmts(ck, a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}), gmap, vmap)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                icf_fix_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), gmap, vmap)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), gmap, vmap)
        elif tag == {{T:StmtKind.with_stmt}}:
            icf_fix_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}], gmap, vmap)
            icf_fix_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), gmap, vmap)
        elif tag == {{T:StmtKind.defer_stmt}}:
            dargs: int = sl_at(a, a.n[pay + {{O:DeferStmt.call}}], {{O:Call.args}})
            for di in range(pky(dargs)):
                icf_fix_expr(ck, a, stmt_at(a, dargs, di), gmap, vmap)

def index_call_fixup_run(ck: Ck, a: Ast, body: int) -> None:
    gmap: Map2 = Map2()
    for i in range(len(ck.gcls.k1)):
        if ck.gcls.dead[i] == 0:
            m2_put(gmap, 0, ck.gcls.k2[i], 1)
    for j in range(len(ck.fimp.k1)):
        if ck.fimp.dead[j] == 0 and m2_get(ck.gcls, 0, ck.fimp.vv[j]) >= 0:
            m2_put(gmap, 0, ck.fimp.k2[j], 1)
    vmap: Map2 = Map2()
    icf_collect_vars(ck, a, body, vmap)
    icf_fix_stmts(ck, a, body, gmap, vmap)

# ---- Faz C.1b: bound_method_fixup ----
def bmf_fix_expr(ck: Ck, a: Ast, e: int, val_pos: bool, mnames: Map2, evnames: Map2) -> None:
    tag: int = a.n[e]
    if tag == {{T:Expr.attribute}}:
        at: int = a.n[e + 1]
        obj: int = a.n[at + {{O:Attribute.obj}}]
        bmf_fix_expr(ck, a, obj, False, mnames, evnames)
        if val_pos and a.n[obj] == {{T:Expr.identifier}}:
            asr: int = pk(a.n[at + {{O:Attribute.attr}}], a.n[at + {{O:Attribute.attr}} + 1])
            asym: int = sym_of(ck, a, asr)
            if m2_get(mnames, 0, asym) >= 0 and m2_get(evnames, 0, asym) < 0:
                cal: int = mk_ident_node(a, "__nox_bind_method")
                al: int = ast_expr_list(a, [obj, mk_Expr_string_lit(a, pkx(asr), pky(asr))])
                a.n[e] = {{T:Expr.call}}
                a.n[e + 1] = mk_Call(a, cal, pkx(al), pky(al), 0, 0, 0, 0, 0, 0)
        return
    if tag == {{T:Expr.call}}:
        cp: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[cp + {{O:Call.callee}}], False, mnames, evnames)
        cargs: int = sl_at(a, cp, {{O:Call.args}})
        for ci in range(pky(cargs)):
            bmf_fix_expr(ck, a, stmt_at(a, cargs, ci), True, mnames, evnames)
    elif tag == {{T:Expr.unary}}:
        bmf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Unary.operand}}], True, mnames, evnames)
    elif tag == {{T:Expr.kwarg}}:
        bmf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Kwarg.value}}], True, mnames, evnames)
    elif tag == {{T:Expr.ternary}}:
        tp: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[tp + {{O:Ternary.cond}}], True, mnames, evnames)
        bmf_fix_expr(ck, a, a.n[tp + {{O:Ternary.then_expr}}], True, mnames, evnames)
        bmf_fix_expr(ck, a, a.n[tp + {{O:Ternary.else_expr}}], True, mnames, evnames)
    elif tag == {{T:Expr.binary}}:
        bp: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[bp + {{O:Binary.left}}], True, mnames, evnames)
        bmf_fix_expr(ck, a, a.n[bp + {{O:Binary.right}}], True, mnames, evnames)
    elif tag == {{T:Expr.index}}:
        ip: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[ip + {{O:Index.obj}}], False, mnames, evnames)
        bmf_fix_expr(ck, a, a.n[ip + {{O:Index.index}}], True, mnames, evnames)
    elif tag == {{T:Expr.slice}}:
        sp: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[sp + {{O:Slice.obj}}], False, mnames, evnames)
        if a.n[sp + {{O:Slice.lo}}] >= 0:
            bmf_fix_expr(ck, a, a.n[sp + {{O:Slice.lo}}], True, mnames, evnames)
        if a.n[sp + {{O:Slice.hi}}] >= 0:
            bmf_fix_expr(ck, a, a.n[sp + {{O:Slice.hi}}], True, mnames, evnames)
        if a.n[sp + {{O:Slice.step}}] >= 0:
            bmf_fix_expr(ck, a, a.n[sp + {{O:Slice.step}}], True, mnames, evnames)
    elif tag == {{T:Expr.list_lit}} or tag == {{T:Expr.tuple_lit}}:
        for li in range(a.n[e + 2]):
            bmf_fix_expr(ck, a, a.l[a.n[e + 1] + li], True, mnames, evnames)
    elif tag == {{T:Expr.dict_lit}}:
        for di in range(a.n[e + 2]):
            pr: int = a.l[a.n[e + 1] + di]
            bmf_fix_expr(ck, a, a.n[pr + {{O:DictPair.key}}], True, mnames, evnames)
            bmf_fix_expr(ck, a, a.n[pr + {{O:DictPair.value}}], True, mnames, evnames)
    elif tag == {{T:Expr.list_comp}}:
        lc: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[lc + {{O:ListComp.elem}}], True, mnames, evnames)
        cls: int = sl_at(a, lc, {{O:ListComp.clauses}})
        for qi in range(pky(cls)):
            cl: int = stmt_at(a, cls, qi)
            if a.n[cl] == {{T:CompClause.for_clause}}:
                bmf_fix_expr(ck, a, a.n[a.n[cl + 1] + {{O:CompForClause.iterable}}], True, mnames, evnames)
            else:
                bmf_fix_expr(ck, a, a.n[cl + 1], True, mnames, evnames)
    elif tag == {{T:Expr.dict_comp}}:
        dc: int = a.n[e + 1]
        bmf_fix_expr(ck, a, a.n[dc + {{O:DictComp.key}}], True, mnames, evnames)
        bmf_fix_expr(ck, a, a.n[dc + {{O:DictComp.value}}], True, mnames, evnames)
        dcls: int = sl_at(a, dc, {{O:DictComp.clauses}})
        for qi2 in range(pky(dcls)):
            cl2: int = stmt_at(a, dcls, qi2)
            if a.n[cl2] == {{T:CompClause.for_clause}}:
                bmf_fix_expr(ck, a, a.n[a.n[cl2 + 1] + {{O:CompForClause.iterable}}], True, mnames, evnames)
            else:
                bmf_fix_expr(ck, a, a.n[cl2 + 1], True, mnames, evnames)
    elif tag == {{T:Expr.lambda}}:
        bmf_fix_expr(ck, a, a.n[a.n[e + 1] + {{O:Lambda.body}}], True, mnames, evnames)
    elif tag == {{T:Expr.await_expr}} or tag == {{T:Expr.spawn_expr}}:
        bmf_fix_expr(ck, a, a.n[e + 1], False, mnames, evnames)
    elif tag == {{T:Expr.generic_construct}}:
        gargs: int = sl_at(a, a.n[e + 1], {{O:GenericConstruct.args}})
        for gi in range(pky(gargs)):
            bmf_fix_expr(ck, a, stmt_at(a, gargs, gi), True, mnames, evnames)

def bmf_fix_stmts(ck: Ck, a: Ast, stmts: int, mnames: Map2, evnames: Map2) -> None:
    for i in range(pky(stmts)):
        st: int = stmt_at(a, stmts, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        tag: int = a.n[kn]
        pay: int = a.n[kn + 1]
        if tag == {{T:StmtKind.expr_stmt}}:
            bmf_fix_expr(ck, a, pay, False, mnames, evnames)
        elif tag == {{T:StmtKind.raise_stmt}} or tag == {{T:StmtKind.del_stmt}}:
            bmf_fix_expr(ck, a, pay, True, mnames, evnames)
        elif tag == {{T:StmtKind.return_stmt}}:
            if pay >= 0:
                bmf_fix_expr(ck, a, pay, True, mnames, evnames)
        elif tag == {{T:StmtKind.var_decl}}:
            bmf_fix_expr(ck, a, a.n[pay + {{O:VarDecl.value}}], True, mnames, evnames)
        elif tag == {{T:StmtKind.assign}}:
            bmf_fix_expr(ck, a, a.n[pay + {{O:Assign.target}}], False, mnames, evnames)
            bmf_fix_expr(ck, a, a.n[pay + {{O:Assign.value}}], True, mnames, evnames)
        elif tag == {{T:StmtKind.if_stmt}}:
            bmf_fix_expr(ck, a, a.n[pay + {{O:IfStmt.cond}}], True, mnames, evnames)
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.then_body}}), mnames, evnames)
            ecs: int = sl_at(a, pay, {{O:IfStmt.elif_clauses}})
            for j in range(pky(ecs)):
                ec: int = stmt_at(a, ecs, j)
                bmf_fix_expr(ck, a, a.n[ec + {{O:ElifClause.cond}}], True, mnames, evnames)
                bmf_fix_stmts(ck, a, sl_at(a, ec, {{O:ElifClause.body}}), mnames, evnames)
            if a.n[pay + {{O:IfStmt.else_body}}] != {{NONE}}:
                bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:IfStmt.else_body}}), mnames, evnames)
        elif tag == {{T:StmtKind.while_stmt}}:
            bmf_fix_expr(ck, a, a.n[pay + {{O:WhileStmt.cond}}], True, mnames, evnames)
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:WhileStmt.body}}), mnames, evnames)
        elif tag == {{T:StmtKind.for_stmt}}:
            bmf_fix_expr(ck, a, a.n[pay + {{O:ForStmt.iterable}}], True, mnames, evnames)
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:ForStmt.body}}), mnames, evnames)
        elif tag == {{T:StmtKind.func_def}}:
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:FuncDef.body}}), mnames, evnames)
        elif tag == {{T:StmtKind.class_def}}:
            ms: int = sl_at(a, pay, {{O:ClassDef.methods}})
            for mi in range(pky(ms)):
                bmf_fix_stmts(ck, a, sl_at(a, stmt_at(a, ms, mi), {{O:FuncDef.body}}), mnames, evnames)
        elif tag == {{T:StmtKind.try_stmt}}:
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.try_body}}), mnames, evnames)
            exs: int = sl_at(a, pay, {{O:TryStmt.except_clauses}})
            for k in range(pky(exs)):
                bmf_fix_stmts(ck, a, sl_at(a, stmt_at(a, exs, k), {{O:ExceptClause.body}}), mnames, evnames)
            if a.n[pay + {{O:TryStmt.finally_body}}] != {{NONE}}:
                bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:TryStmt.finally_body}}), mnames, evnames)
        elif tag == {{T:StmtKind.lowlevel_stmt}}:
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:LowLevelStmt.body}}), mnames, evnames)
        elif tag == {{T:StmtKind.with_stmt}}:
            bmf_fix_expr(ck, a, a.n[pay + {{O:WithStmt.ctx_expr}}], False, mnames, evnames)
            bmf_fix_stmts(ck, a, sl_at(a, pay, {{O:WithStmt.body}}), mnames, evnames)
        elif tag == {{T:StmtKind.defer_stmt}}:
            dargs: int = sl_at(a, a.n[pay + {{O:DeferStmt.call}}], {{O:Call.args}})
            for di in range(pky(dargs)):
                bmf_fix_expr(ck, a, stmt_at(a, dargs, di), True, mnames, evnames)

def bound_method_fixup_run(ck: Ck, a: Ast, body: int) -> None:
    mnames: Map2 = Map2()
    evnames: Map2 = Map2()
    for i in range(pky(body)):
        st: int = stmt_at(a, body, i)
        kn: int = a.n[st + {{O:Stmt.kind}}]
        if a.n[kn] != {{T:StmtKind.class_def}}:
            continue
        cd: int = a.n[kn + 1]
        evs: int = sl_at(a, cd, {{O:ClassDef.enum_variants}})
        for ei in range(pky(evs)):
            ev: int = stmt_at(a, evs, ei)
            m2_put(evnames, 0, sym_of(ck, a, pk(a.n[ev + {{O:EnumVariant.name}}], a.n[ev + {{O:EnumVariant.name}} + 1])), 1)
        ms: int = sl_at(a, cd, {{O:ClassDef.methods}})
        for mi in range(pky(ms)):
            m: int = stmt_at(a, ms, mi)
            mn: int = pk(a.n[m + {{O:FuncDef.name}}], a.n[m + {{O:FuncDef.name}} + 1])
            if sref_len(mn) >= 2 and sref_byte(a, mn, 0) == 95 and sref_byte(a, mn, 1) == 95:
                continue
            m2_put(mnames, 0, sym_of(ck, a, mn), 1)
    if mnames.live == 0:
        return
    bmf_fix_stmts(ck, a, body, mnames, evnames)

# `Checker.checkModule` (skaler dilim). Dönüş: 0 = kabul, 1 = tanılama/hata (ayrıntı `nox_ck_diag_*`/`o_*`), 2 = kapsam dışı.
def check_module(ck: Ck, a: Ast, body: int) -> int:
    ck.cur_line = 0
    ck.cur_span = -1
    ck.o_code = ""
    ck.o_msg = []
    try:
        ck.sig_empty = new_sig(ck, [], [], 4)
        type_alias_run(ck, a, body)
        generator_desugar_run(ck, a, body)
        nonlocal_desugar_run(ck, a, body)
        guard_normalize_run(a, body)
        collect_imports(ck, a, body)
        mixin_flatten_run(ck, a, body)
        class_attr_promote_run(ck, a, body)
        derive_run(ck, a, body)
        check_base_cycles(ck, a, body)
        collect_class_names(ck, a, body)
        index_call_fixup_run(ck, a, body)
        bound_method_fixup_run(ck, a, body)
        extract_generic_methods(ck, a, body)
        extract_static_methods(ck, a, body)
        resolve_reexport(ck, a, body)
        collect_protocols(ck, a, body)
        resolve_generic_bases(ck, a, body)
        # registerSignatures
        for j in range(pky(body)):
            st: int = stmt_at(a, body, j)
            ck.cur_line = a.n[st + {{O:Stmt.line}}]
            ck.cur_span = a.n[st + {{O:Stmt.span}}]
            kn2: int = a.n[st + {{O:Stmt.kind}}]
            if a.n[kn2] == {{T:StmtKind.func_def}}:
                register_func(ck, a, a.n[kn2 + 1])
            elif a.n[kn2] == {{T:StmtKind.extern_def}}:
                register_extern(ck, a, a.n[kn2 + 1])
            elif a.n[kn2] == {{T:StmtKind.class_def}}:
                csym_r: int = sym_of(ck, a, pk(a.n[a.n[kn2 + 1] + {{O:ClassDef.name}}], a.n[a.n[kn2 + 1] + {{O:ClassDef.name}} + 1]))
                if m2_get(ck.gcls, 0, csym_r) < 0:
                    ensure_class_sig(ck, a, class_idx(ck, csym_r))
        check_pending_inst(ck, a)
        resolve_reexport(ck, a, body)
        collect_module_globals(ck, a, body)
        collect_spawn_targets_stmts(ck, a, body)
        compute_mutates_graph(ck, a, body)
        compute_return_alias_effects(ck, a, body)
    except CkUnsupported:
        return 2
    except CkErr:
        ck.o_code = ck.err_code
        ck.o_msg = ck.diag_msg
        return 1
    ck.top_scope = sc_new(ck, -1, False)
    top: Fx = Fx(ck.top_scope, -1, True)
    for k in range(pky(body)):
        st3: int = stmt_at(a, body, k)
        ck.cur_line = a.n[st3 + {{O:Stmt.line}}]
        ck.cur_span = a.n[st3 + {{O:Stmt.span}}]
        kn3: int = a.n[st3 + {{O:Stmt.kind}}]
        try:
            if a.n[kn3] == {{T:StmtKind.func_def}}:
                fdsym_b: int = sym_of(ck, a, pk(a.n[a.n[kn3 + 1] + {{O:FuncDef.name}}], a.n[a.n[kn3 + 1] + {{O:FuncDef.name}} + 1]))
                if m2_get(ck.gfn, 0, fdsym_b) < 0:
                    check_function_body(ck, a, a.n[kn3 + 1])
            elif a.n[kn3] == {{T:StmtKind.extern_def}} or a.n[kn3] == {{T:StmtKind.import_stmt}} or a.n[kn3] == {{T:StmtKind.from_import_stmt}} or a.n[kn3] == {{T:StmtKind.protocol_def}} or a.n[kn3] == {{T:StmtKind.type_alias}} or m2_get(ck.skip_vdecl, 0, st3) >= 0:
                pass
            elif a.n[kn3] == {{T:StmtKind.class_def}}:
                csym_b: int = sym_of(ck, a, pk(a.n[a.n[kn3 + 1] + {{O:ClassDef.name}}], a.n[a.n[kn3 + 1] + {{O:ClassDef.name}} + 1]))
                if m2_get(ck.gcls, 0, csym_b) < 0:
                    ensure_class_checked(ck, a, class_idx(ck, csym_b))
            else:
                check_stmt(ck, a, top, st3)
        except CkUnsupported:
            return 2
        except CkErr:
            ck.depth = 0
            record_diag(ck, a)
    if ck.has_any_spawn:
        try:
            check_no_post_spawn_caller_mutation(ck, a, body, -1)
        except CkUnsupported:
            return 2
        except CkErr:
            ck.depth = 0
            record_diag(ck, a)
    if len(ck.dcode) > 0:
        ck.o_code = ck.dcode[0]
        for m in range(ck.dlen[0]):
            ck.o_msg.append(ck.dbytes[ck.doff[0] + m])
        return 1
    return 0

# ---- Zig <-> Nox test köprüsü (noxc-nightly `ck-diff`) ----
CG: Ck = Ck(ty_global())

def nox_ck_reset() -> int:
    global CG
    CG = Ck(ty_global())
    return 0

def nox_ck_scope_new(parent: int, has_caps: int) -> int:
    return sc_new(CG, parent, has_caps != 0)

def nox_ck_declare(scope: int, sym: int, ty: int) -> int:
    sc_declare(CG, scope, sym, ty)
    return 0

def nox_ck_lookup_local(scope: int, sym: int) -> int:
    return sc_lookup_local(CG, scope, sym)

def nox_ck_lookup(scope: int, sym: int) -> int:
    return sc_lookup(CG, scope, sym)

def nox_ck_exists(scope: int, sym: int) -> int:
    if sc_exists(CG, scope, sym):
        return 1
    return 0

def nox_ck_declare_var(scope: int, sym: int, ty: int) -> int:
    return declare_var(CG, scope, sym, ty)

def nox_ck_set_nonarc(sym: int, flag: int) -> int:
    cls_set_nonarc(CG.tt, sym, flag)
    return 0

# Kapsamın yakalama sayısı ve i. yakalama (0: sembol, 1: tip), ekleme sırasıyla.
def nox_ck_caps_n(scope: int) -> int:
    cs: int = CG.sc[scope]
    if cs < 0:
        return 0
    n: int = 0
    for e in range(len(CG.caps.k1)):
        if CG.caps.k1[e] == cs and CG.caps.dead[e] == 0:
            n = n + 1
    return n

def nox_ck_cap(scope: int, i: int, which: int) -> int:
    cs: int = CG.sc[scope]
    n: int = 0
    for e in range(len(CG.caps.k1)):
        if CG.caps.k1[e] == cs and CG.caps.dead[e] == 0:
            if n == i:
                if which == 0:
                    return CG.caps.k2[e]
                return CG.caps.vv[e]
            n = n + 1
    return -1

# Modül düzeyi tablolar. which: 0 = module_globals, 1 = module_int_consts. Değerler: tip kimliği / tamsayı.
def ck_tab(which: int) -> Map2:
    if which == 0:
        return CG.globs
    return CG.iconsts

def nox_ck_tab_put(which: int, sym: int, v: int) -> int:
    m2_put(ck_tab(which), 0, sym, v)
    return 0

# Var mı: 1/0 (değer ayrı çağrıyla).
def nox_ck_tab_has(which: int, sym: int) -> int:
    if m2_get(ck_tab(which), 0, sym) >= 0:
        return 1
    return 0

def nox_ck_tab_get(which: int, sym: int) -> int:
    m: Map2 = ck_tab(which)
    e: int = m2_get(m, 0, sym)
    if e < 0:
        return 0
    return m.vv[e]

def nox_ck_tab_remove(which: int, sym: int) -> int:
    if m2_remove(ck_tab(which), 0, sym):
        return 1
    return 0

def nox_ck_tab_live(which: int) -> int:
    return ck_tab(which).live

# `stmtsAssignName(son ayrıştırılan modülün gövdesi, ad)`; ad: `base[off:off+n]` baytları (`types.nox` `nox_ty_names` tamponu değil; çağıran `base` verir).
def nox_ck_assigns_name(base: int, off: int, n: int) -> int:
    if stmts_assign_name(parse_ast(), parse_body(), base, off, n):
        return 1
    return 0

def nox_ck_mem() -> int:
    c: Ck = CG
    return (len(c.sp) * 2 + len(c.vars.k1) * 4 + len(c.vars.slots) + len(c.caps.k1) * 4 + len(c.caps.slots) + len(c.globs.k1) * 4 + len(c.globs.slots) + len(c.iconsts.k1) * 4 + len(c.iconsts.slots)) * 8

# ---- ölçüm (ck-bench): Zig `selfhost_ck_diff.zig` `benchZig` ile AYNI iş yükü ve sağlama toplamı ----
# ns kapsam zinciri (i. kapsamın üstü i-1; i % 4 == 3 olanlar yakalamalı), nn ad, m işlem (%70 lookup, %30 declare).
def nox_ck_bench(seed: int, ns: int, nn: int, m: int) -> int:
    ck: Ck = Ck(ty_global())
    for i in range(ns):
        par: int = i - 1
        sc_new(ck, par, i % 4 == 3)
    x: int = seed & 2147483647
    acc: int = 0
    for j in range(m):
        x = lcg(x)
        op: int = (x >> 6) % 10
        x = lcg(x)
        s: int = (x >> 4) % ns
        x = lcg(x)
        sym: int = (x >> 4) % nn
        if op < 7:
            acc = acc + sc_lookup(ck, s, sym) + 1
        else:
            x = lcg(x)
            sc_declare(ck, s, sym, (x >> 4) % 5)
    return acc + len(ck.caps.k1)

# ---- 3.3: `check` farksal köprüsü ----
# Zig'den düz-dizi olarak itilen (`ast_schema.G`) birleşik modülü denetler (`ck-diff checkm`).
def nox_ck_check_loaded(body_start: int, body_len: int) -> int:
    global CG
    CG = Ck(ty_global())
    try:
        return check_module(CG, loaded_ast(), pk(body_start, body_len))
    except Exception:
        return -1

def nox_ck_check() -> int:
    global CG
    CG = Ck(ty_global())
    # beklenmeyen (CkErr/CkUnsupported dışı) çalışma hatası sessizce 0 dönmesin: -1 = iç hata
    try:
        return check_module(CG, parse_ast(), parse_body())
    except Exception:
        return -1

# Metin alma: which 0 = sonuç kodu adı, 1 = sonuç iletisi, 2 = i. tanılamanın kodu, 3 = i. tanılamanın iletisi. Dönüş: bayt sayısı (veri `nox_ck_out_buffer`).
def nox_ck_text(which: int, i: int) -> int:
    ck: Ck = CG
    ck.out = []
    if which == 0:
        for k in range(len(ck.o_code)):
            ck.out.append(ord(ck.o_code[k]))
    elif which == 1:
        for k2 in range(len(ck.o_msg)):
            ck.out.append(ck.o_msg[k2])
    elif which == 4:
        for k5 in range(len(ck.why)):
            ck.out.append(ord(ck.why[k5]))
    elif which == 2:
        for k3 in range(len(ck.dcode[i])):
            ck.out.append(ord(ck.dcode[i][k3]))
    else:
        for k4 in range(ck.dlen[i]):
            ck.out.append(ck.dbytes[ck.doff[i] + k4])
    return len(ck.out)

def nox_ck_out_buffer() -> int:
    xs: list[int] = CG.out
    p: int = 0
    lowlevel:
        p = ptr_to_int(ptr_of(xs))
    return p

def nox_ck_diag_n() -> int:
    return len(CG.dcode)

# field 0 = satır, 1..6 = span (start_byte, end_byte, start_line, start_col, end_line, end_col)
def nox_ck_diag_int(i: int, field: int) -> int:
    if field == 0:
        return CG.dline[i]
    return CG.dspan[i * 6 + field - 1]

# deploy/web/.env.example — kopyalayıp `.env` olarak doldurun (`.env` git'e GİRMEZ).
# NOT: Docker Compose değerlerdeki `$` karakterini değişken sayar; Argon2 hash'indeki HER `$` için `$$` yazın.
NYX_SECRET_KEY=
NOXPKG_ADMIN_PASSWORD_HASH=
NOXPKG_SESSION_SECRET=
# İsteğe bağlı: yollar (varsayılanlar depo içindedir)
# NOXPKG_DATA_DIR=/Users/<kullanici>/nox-data/noxpkg
# BACKUP_DIR=/Users/<kullanici>/nox-data/backups
# İsteğe bağlı: Cloudflare R2'ye şifreli off-site yedek (dördü de dolu olmalı)
# RESTIC_REPOSITORY=s3:https://<hesap-kimligi>.r2.cloudflarestorage.com/<bucket>
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

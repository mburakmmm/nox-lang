{
  "name": "nox",
  "displayName": "Nox",
  "description": "Nox dili için sözdizimi vurgulama + LSP istemcisi (noxlsp: tanılama, tamamlama, tanıma, üzerine gelme, biçimlendirme)",
  "version": "0.1.0",
  "publisher": "nox-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nox"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nox",
        "aliases": [
          "Nox",
          "nox"
        ],
        "extensions": [
          ".nox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nox",
        "scopeName": "source.nox",
        "path": "./syntaxes/nox.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Nox",
      "properties": {
        "nox.languageServerPath": {
          "type": "string",
          "default": "noxlsp",
          "description": "noxlsp çalıştırılabilir dosyasının yolu (varsayılan: PATH üzerinde aranır)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}

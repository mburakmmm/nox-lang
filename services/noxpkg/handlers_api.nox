# handlers_api — `noxc login/logout/whoami/publish` API'si: GitHub aygıt-akışı girişi, jeton doğrulaması, ad sahipliği.
#
# Akış: `noxc login` -> POST /api/auth/device/start (kullanıcıya github.com/login/device ve bir kod gösterilir) -> kullanıcı
# GitHub'da onaylar -> `noxc` POST /api/auth/device/poll ile bekler -> sunucu GitHub'dan kullanıcıyı doğrular, yayıncıyı
# kaydeder ve noxpkg'in KENDİ API jetonunu döner. GitHub jetonu saklanmaz, `noxc`ye verilmez (bkz. github.nox).
# Mesajlar `noxc` tarafından olduğu gibi yazdırılır, bu yüzden İngilizcedir.
import nox.json
import nox.os
import nox.strings
import nox.validate
import nox.ed25519
import nox.time
from nox.validate import Schema
from nox.json import JsonValue
from nox.json import JsonError
from nox.os import OsError
from nox.router import Context
from nox.http import HttpResponse
import store
from store import Publisher, NameOwner, PublisherKey, Attestation
import github
from github import DeviceStart, DevicePoll, GithubUser
import handlers_public

def _fail(status: int, message: str) -> HttpResponse:
    body: str = "{\"ok\": false, \"error\": " + nox.json.dump_string(message) + "}"
    return HttpResponse(status, body, {"Content-Type": "application/json"})

# `Authorization: Bearer <jeton>` -> jeton ("" yoksa).
def bearer(ctx: Context) -> str:
    raw: str = ""
    if ctx.request.headers.contains("Authorization"):
        raw = ctx.request.headers["Authorization"]
    elif ctx.request.headers.contains("authorization"):
        raw = ctx.request.headers["authorization"]
    if not nox.strings.starts_with(raw, "Bearer "):
        return ""
    return nox.strings.trim(nox.strings.replace(raw, "Bearer ", ""))

# Jetonun yayıncısı; yoksa/geçersizse None.
def authenticated(ctx: Context) -> Publisher | None:
    token: str = bearer(ctx)
    if len(token) == 0:
        return None
    return store.publisher_for_token(token)

def _admin_github() -> str:
    try:
        return nox.os.getenv("NOXPKG_ADMIN_GITHUB")
    except OsError:
        return ""

def _is_admin_login(login: str) -> bool:
    admin: str = _admin_github()
    if len(admin) == 0:
        return False
    return nox.strings.lower(admin) == nox.strings.lower(login)

def device_start(ctx: Context) -> HttpResponse:
    if not github.configured():
        return _fail(503, "GitHub login is not configured on this server.")
    if handlers_public._locked(ctx, "dstart:", 3600000, 20):
        return _fail(429, "Too many login attempts, try again later.")
    handlers_public._hit(ctx, "dstart:", 3600000)
    ds: DeviceStart | None = github.device_start()
    if ds == None:
        return _fail(502, "Could not reach GitHub.")
    body: str = "{\"ok\": true, \"device_code\": " + nox.json.dump_string(ds.device_code) + ", \"user_code\": " + nox.json.dump_string(ds.user_code) + ", \"verification_uri\": " + nox.json.dump_string(ds.verification_uri) + ", \"interval\": " + str(ds.interval) + ", \"expires_in\": " + str(ds.expires_in) + "}"
    return HttpResponse(200, body, {"Content-Type": "application/json"})

def _status(status: str) -> HttpResponse:
    return HttpResponse(200, "{\"ok\": true, \"status\": " + nox.json.dump_string(status) + "}", {"Content-Type": "application/json"})

def device_poll(ctx: Context) -> HttpResponse:
    if not github.configured():
        return _fail(503, "GitHub login is not configured on this server.")
    if handlers_public._locked(ctx, "dpoll:", 3600000, 900):
        return _fail(429, "Too many requests, try again later.")
    handlers_public._hit(ctx, "dpoll:", 3600000)
    code: str = ""
    try:
        code = handlers_public._field(ctx.request.body, "device_code")
    except JsonError:
        return _fail(400, "Request could not be read.")
    if len(code) == 0 or len(code) > 200:
        return _fail(400, "device_code is required.")
    dp: DevicePoll = github.device_poll(code)
    if dp.state != "ok":
        if dp.state == "error":
            return _fail(502, "GitHub did not accept the device code.")
        return _status(dp.state)
    user: GithubUser | None = github.user_info(dp.access_token)
    if user == None:
        return _fail(502, "Could not verify the GitHub account.")
    pub: Publisher = store.upsert_publisher(user.id, user.login, user.avatar_url)
    if _is_admin_login(pub.login):
        store.claim_legacy(pub.id)
    token: str = store.mint_token(pub.id)
    body: str = "{\"ok\": true, \"status\": \"ok\", \"token\": " + nox.json.dump_string(token) + ", \"login\": " + nox.json.dump_string(pub.login) + "}"
    return HttpResponse(200, body, {"Content-Type": "application/json"})

def whoami(ctx: Context) -> HttpResponse:
    pub: Publisher | None = authenticated(ctx)
    if pub == None:
        return _fail(401, "Not logged in or the token expired: run `noxc login`.")
    body: str = "{\"ok\": true, \"login\": " + nox.json.dump_string(pub.login) + ", \"github_id\": " + str(pub.github_id) + "}"
    return HttpResponse(200, body, {"Content-Type": "application/json"})

def logout(ctx: Context) -> HttpResponse:
    token: str = bearer(ctx)
    if len(token) == 0:
        return _fail(401, "No token.")
    store.revoke_token(token)
    return HttpResponse(200, "{\"ok\": true}", {"Content-Type": "application/json"})

def _publish_schema() -> Schema:
    s: Schema = Schema()
    s.require("name", "string")
    s.require("repo", "string")
    s.optional("ref", "string")
    s.optional("description", "string")
    s.optional("tags", "array")
    return s

def _opt_field(v: JsonValue, key: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == key:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

# `noxc publish`: jeton ZORUNLU (anonim yayın kapalı). Ad ilk yayımlayana rezerve edilir; başkasının adı 403 alır. Yeni ad ve repo
# değişikliği yönetici onayına düşer (yönetim panelinde yayıncıyla birlikte görünür); onaylı paketin aynı sahibi aynı repoyu
# güncellerse onay beklemeden katalog güncellenir (`status: published`). Tekrarlar tek bekleyen satırda birleşir.
def publish(ctx: Context) -> HttpResponse:
    pub: Publisher | None = authenticated(ctx)
    if pub == None:
        return _fail(401, "Login required: run `noxc login` first.")
    errors: list[str] = nox.validate.validate_json_str(ctx.request.body, _publish_schema())
    if len(errors) > 0:
        return _fail(400, errors[0])
    v: JsonValue = nox.json.parse(ctx.request.body)
    name: str = ""
    repo: str = ""
    ref: str = "main"
    description: str = ""
    tags: list[str] = []
    name_v: JsonValue | None = _opt_field(v, "name")
    if name_v != None:
        name = nox.json.as_string(name_v)
    repo_v: JsonValue | None = _opt_field(v, "repo")
    if repo_v != None:
        repo = nox.json.as_string(repo_v)
    ref_v: JsonValue | None = _opt_field(v, "ref")
    if ref_v != None:
        ref = nox.json.as_string(ref_v)
    desc_v: JsonValue | None = _opt_field(v, "description")
    if desc_v != None:
        description = nox.json.as_string(desc_v)
    tags_v: JsonValue | None = _opt_field(v, "tags")
    if tags_v != None:
        i: int = 0
        n: int = nox.json.array_len(tags_v)
        while i < n:
            tags.append(nox.json.as_string(nox.json.array_get(tags_v, i)))
            i = i + 1
    owner: NameOwner = store.name_owner(name)
    if owner.kind == "publisher" and owner.publisher_id != pub.id:
        return _fail(403, "The name '" + name + "' belongs to @" + owner.login + ".")
    if owner.kind == "legacy":
        return _fail(403, "The name '" + name + "' is reserved by the registry administrators.")
    outcome: int = store.add_submission(name, repo, ref, description, tags, pub.id)
    if outcome == 0:
        return _fail(429, "Too many pending submissions.")
    id: str = ""
    status: str = "published"
    if outcome == 1:
        id = store.latest_submission_id(name, repo)
        status = "pending"
    body2: str = "{\"ok\": true, \"id\": " + nox.json.dump_string(id) + ", \"status\": " + nox.json.dump_string(status) + ", \"publisher\": " + nox.json.dump_string(pub.login) + "}"
    return HttpResponse(200, body2, {"Content-Type": "application/json"})

# ---- Yayıncı anahtarları ve yayın bildirimleri (TODO 7.4 S2; tasarım: project/registry-guvenlik-tasarimi-2026-11.md) ----

def _hex_ok(text: str, n: int) -> bool:
    if len(text) != n:
        return False
    i: int = 0
    while i < n:
        c: str = text[i]
        if not ((c >= "0" and c <= "9") or (c >= "a" and c <= "f")):
            return False
        i = i + 1
    return True

def _str_field(v: JsonValue, key: str) -> str:
    f: JsonValue | None = _opt_field(v, key)
    if f == None:
        return ""
    if not nox.json.is_string(f):
        return ""
    return nox.json.as_string(f)

# Bildirimin KANONİK metni; `noxc` (compiler/pkg/attest.zig) AYNI metni üretir. Alanlar satır sonu içermemeli (`_clean`).
def statement_text(name: str, repo: str, ref: str, commit: str, sbom: str) -> str:
    return "nox-attest-v1\nname=" + name + "\nrepo=" + repo + "\nref=" + ref + "\ncommit=" + commit + "\nsbom=" + sbom + "\n"

def _clean(text: str) -> bool:
    return len(text) > 0 and len(text) < 300 and not nox.strings.contains(text, "\n") and not nox.strings.contains(text, "\r")

def _key_json(k: PublisherKey) -> str:
    return "{\"fingerprint\": " + nox.json.dump_string(k.fingerprint) + ", \"label\": " + nox.json.dump_string(k.label) + ", \"created_ms\": " + str(k.created_ms) + ", \"revoked\": " + ("true" if k.revoked_ms != 0 else "false") + "}"

# POST /api/keys {"pub": <64 hex>, "label": "..."}: açık anahtarı hesaba bağlar. Parmak izi sunucuda yeniden hesaplanır.
def keys_add(ctx: Context) -> HttpResponse:
    pub: Publisher | None = authenticated(ctx)
    if pub == None:
        return _fail(401, "Login required: run `noxc login` first.")
    if handlers_public._locked(ctx, "keyadd:", 3600000, 30):
        return _fail(429, "Too many key registrations; try again later.")
    v: JsonValue = nox.json.parse("null")
    try:
        v = nox.json.parse(ctx.request.body)
    except JsonError:
        return _fail(400, "The body must be JSON.")
    if not nox.json.is_object(v):
        return _fail(400, "The body must be a JSON object.")
    pub_hex: str = nox.strings.lower(_str_field(v, "pub"))
    label: str = _str_field(v, "label")
    if not _hex_ok(pub_hex, 64):
        return _fail(400, "'pub' must be 64 hex characters (the raw Ed25519 public key).")
    if len(label) > 80 or nox.strings.contains(label, "\n"):
        return _fail(400, "'label' is too long or contains a newline.")
    fp: str = nox.ed25519.fingerprint(pub_hex)
    if len(fp) == 0:
        return _fail(400, "Invalid public key.")
    outcome: int = store.add_publisher_key(pub.id, fp, pub_hex, label)
    if outcome == 0:
        return _fail(409, "That key is already registered to another publisher.")
    status: str = "added"
    if outcome == 2:
        status = "exists"
    return HttpResponse(200, "{\"ok\": true, \"status\": " + nox.json.dump_string(status) + ", \"fingerprint\": " + nox.json.dump_string(fp) + "}", {"Content-Type": "application/json"})

def keys_list(ctx: Context) -> HttpResponse:
    pub: Publisher | None = authenticated(ctx)
    if pub == None:
        return _fail(401, "Login required: run `noxc login` first.")
    keys: list[PublisherKey] = store.list_publisher_keys(pub.id)
    items: list[str] = []
    i: int = 0
    while i < len(keys):
        items.append(_key_json(keys[i]))
        i = i + 1
    return HttpResponse(200, "{\"ok\": true, \"keys\": [" + nox.strings.join(items, ", ") + "]}", {"Content-Type": "application/json"})

def keys_revoke(ctx: Context) -> HttpResponse:
    pub: Publisher | None = authenticated(ctx)
    if pub == None:
        return _fail(401, "Login required: run `noxc login` first.")
    fp: str = nox.strings.lower(ctx.params["fp"])
    if not _hex_ok(fp, 32):
        return _fail(400, "The fingerprint must be 32 hex characters.")
    if not store.revoke_publisher_key(pub.id, fp):
        return _fail(404, "No active key with that fingerprint on your account.")
    return HttpResponse(200, "{\"ok\": true}", {"Content-Type": "application/json"})

# POST /api/attest {name, repo, ref, commit, sbom, signer, sig}: yayın bildirimini doğrular ve saklar. Koşullar: oturum, adın sahibi bu yayıncı, `signer` onun ETKİN anahtarı, imza kanonik metin üzerinde geçerli.
def attest(ctx: Context) -> HttpResponse:
    pub: Publisher | None = authenticated(ctx)
    if pub == None:
        return _fail(401, "Login required: run `noxc login` first.")
    if handlers_public._locked(ctx, "attest:", 3600000, 120):
        return _fail(429, "Too many attestations; try again later.")
    v: JsonValue = nox.json.parse("null")
    try:
        v = nox.json.parse(ctx.request.body)
    except JsonError:
        return _fail(400, "The body must be JSON.")
    if not nox.json.is_object(v):
        return _fail(400, "The body must be a JSON object.")
    name: str = _str_field(v, "name")
    repo: str = _str_field(v, "repo")
    ref: str = _str_field(v, "ref")
    commit: str = nox.strings.lower(_str_field(v, "commit"))
    sbom: str = nox.strings.lower(_str_field(v, "sbom"))
    signer: str = nox.strings.lower(_str_field(v, "signer"))
    sig: str = nox.strings.lower(_str_field(v, "sig"))
    if not (_clean(name) and _clean(repo) and _clean(ref)):
        return _fail(400, "'name', 'repo' and 'ref' are required and must be single-line.")
    if not (_hex_ok(commit, 40) or _hex_ok(commit, 64)):
        return _fail(400, "'commit' must be a full 40- or 64-hex commit id.")
    if not (_hex_ok(sbom, 64) and _hex_ok(signer, 32) and _hex_ok(sig, 128)):
        return _fail(400, "'sbom' (64 hex), 'signer' (32 hex) and 'sig' (128 hex) are required.")
    owner: NameOwner = store.name_owner(name)
    if not (owner.kind == "publisher" and owner.publisher_id == pub.id):
        return _fail(403, "You do not own the package name '" + name + "'.")
    key_hex: str = store.active_key_hex(pub.id, signer)
    if len(key_hex) == 0:
        return _fail(403, "The signing key is not registered and active on your account: run `noxc sign register`.")
    if not nox.ed25519.verify(key_hex, statement_text(name, repo, ref, commit, sbom), sig):
        return _fail(400, "The signature does not match the statement.")
    store.add_attestation(name, repo, ref, commit, sbom, signer, sig, pub.id)
    return HttpResponse(200, "{\"ok\": true}", {"Content-Type": "application/json"})

# GET /api/attestations/:name (herkese açık): bildirimler + imzalayan yayıncı. İstemci imzayı kendisi de doğrular (sunucuya güvenmek zorunda değildir).
def attestations(ctx: Context) -> HttpResponse:
    name: str = ctx.params["name"]
    list_a: list[Attestation] = store.load_attestations(name)
    items: list[str] = []
    i: int = 0
    while i < len(list_a):
        a: Attestation = list_a[i]
        keyhex: str = store.key_hex_of(a.signer)
        items.append("{\"name\": " + nox.json.dump_string(a.name) + ", \"repo\": " + nox.json.dump_string(a.repo) + ", \"ref\": " + nox.json.dump_string(a.ref) + ", \"commit\": " + nox.json.dump_string(a.commit) + ", \"sbom\": " + nox.json.dump_string(a.sbom_sha256) + ", \"signer\": " + nox.json.dump_string(a.signer) + ", \"pub\": " + nox.json.dump_string(keyhex) + ", \"sig\": " + nox.json.dump_string(a.sig) + ", \"publisher\": " + nox.json.dump_string(a.login) + ", \"created_ms\": " + str(a.created_ms) + ", \"key_revoked\": " + ("true" if a.revoked else "false") + "}")
        i = i + 1
    return HttpResponse(200, "{\"ok\": true, \"attestations\": [" + nox.strings.join(items, ", ") + "]}", {"Content-Type": "application/json"})


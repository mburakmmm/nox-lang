# templates — noxpkg sayfaları. Kullanıcı metni `render` ile kaçırılır;
# birleştirilmiş HTML `render_unescaped` ile gövdeye girer. Dinamik
# değerler JS string literali içine gömülmez; `data-*` ve form alanı
# olarak kalır.
import nox.template

def _page_template() -> str:
    return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{{ title }}</title><link rel=\"stylesheet\" href=\"/pkg.css\"><script>try{var t=localStorage.getItem(\"nox-theme\");if(t===\"light\"||t===\"dark\")document.documentElement.setAttribute(\"data-theme\",t);}catch(e){}</script>{{ csrf_meta }}</head><body><header class=\"topbar\"><a class=\"brand\" href=\"https://noxlang.com\"><span class=\"mark\">N</span><span>Nox</span></a><nav class=\"topnav\" aria-label=\"Primary\"><a href=\"/\" aria-current=\"page\">Packages</a><a href=\"https://noxlang.com/docs/tutorial/\">Tutorial</a><a href=\"https://noxlang.com/docs/stdlib/\">Stdlib</a></nav><div class=\"topright\">{{ account }}<button class=\"icon-btn\" id=\"theme\" type=\"button\" aria-label=\"Toggle theme\">◐</button></div></header><main class=\"wrap\">{{ main }}<p class=\"footer\"><a href=\"/admin/login\">Admin</a></p></main><script src=\"/pkg.js\"></script></body></html>"

def page(title: str, account_html: str, main_html: str, csrf: str) -> str:
    csrf_meta: str = ""
    if len(csrf) > 0:
        meta_ctx: dict[str, str] = {"token": csrf}
        csrf_meta = nox.template.render("<meta name=\"csrf\" content=\"{{ token }}\">", meta_ctx)
    ctx: dict[str, str] = {"title": title, "account": account_html, "main": main_html, "csrf_meta": csrf_meta}
    return nox.template.render_unescaped(_page_template(), ctx)

def account_bar(username: str, role: str) -> str:
    if len(username) == 0:
        return "<a class=\"btn\" href=\"/login\">Sign in</a>"
    who_ctx: dict[str, str] = {"name": username}
    who: str = nox.template.render("<span class=\"who\">{{ name }}</span>", who_ctx)
    admin: str = ""
    if role == "admin":
        admin = "<a class=\"btn btn-ghost\" href=\"/admin\">Admin</a>"
    return who + admin + "<button class=\"btn btn-ghost\" id=\"logout\" type=\"button\">Sign out</button>"

def _card_template() -> str:
    return "<a class=\"card\" href=\"/p/{{ name }}\" data-name=\"{{ name }}\" data-repo=\"{{ repo }}\" data-description=\"{{ description }}\" data-tags=\"{{ tags }}\"><h2>{{ name }}</h2><p>{{ description }}</p><span class=\"tags\">{{ tag_html }}</span></a>"

def _tag_template() -> str:
    return "<span class=\"tag\">{{ tag }}</span>"

def package_card(name: str, repo: str, description: str, tags: list[str]) -> str:
    tag_html: str = ""
    i: int = 0
    while i < len(tags):
        one: dict[str, str] = {"tag": tags[i]}
        tag_html = tag_html + nox.template.render(_tag_template(), one)
        i = i + 1
    joined: str = ""
    j: int = 0
    while j < len(tags):
        if j > 0:
            joined = joined + " "
        joined = joined + tags[j]
        j = j + 1
    ctx: dict[str, str] = {"name": nox.template.escape_html(name), "repo": nox.template.escape_html(repo), "description": nox.template.escape_html(description), "tags": nox.template.escape_html(joined), "tag_html": tag_html}
    return nox.template.render_unescaped(_card_template(), ctx)

def home_main(cards_html: str) -> str:
    ctx: dict[str, str] = {"cards": cards_html}
    tmpl: str = "<p class=\"kicker\">Registry</p><h1>Packages</h1><p class=\"lead\">The Nox package index. Find packages with <code>noxc search</code> and add one to your project with <code>noxc add</code>.</p><input class=\"search\" id=\"q\" type=\"search\" placeholder=\"Search packages\" autofocus><div class=\"grid\" id=\"pkgs\">{{ cards }}</div><p class=\"empty\" id=\"empty\" hidden>No matching packages.</p>"
    return nox.template.render_unescaped(tmpl, ctx)

def _comment_template() -> str:
    return "<article class=\"comment\"><header><strong>{{ username }}</strong><span>{{ when }}</span></header><p>{{ body }}</p></article>"

def comment_block(username: str, body: str, when: str) -> str:
    ctx: dict[str, str] = {"username": username, "body": body, "when": when}
    return nox.template.render(_comment_template(), ctx)

# Paketi yayınlayan GitHub hesabı (varsa). Avatar gösterilmez: site CSP'si dış görsele izin vermez.
def publisher_line(login: str) -> str:
    if len(login) == 0:
        return ""
    ctx: dict[str, str] = {"login": login}
    return nox.template.render("<p class=\"publisher\">Published by <a href=\"https://github.com/{{ login }}\" rel=\"noopener noreferrer\">@{{ login }}</a></p>", ctx)

def package_main(name: str, repo_href: str, repo_label: str, description: str, tags_html: str, install: str, comments_html: str, composer_html: str, publisher_html: str = "") -> str:
    ctx: dict[str, str] = {"publisher": publisher_html, "name": nox.template.escape_html(name), "repo_href": nox.template.escape_html(repo_href), "repo_label": nox.template.escape_html(repo_label), "description": nox.template.escape_html(description), "tags": tags_html, "install": nox.template.escape_html(install), "comments": comments_html, "composer": composer_html}
    tmpl: str = "<p class=\"kicker\"><a href=\"/\">Packages</a></p><div class=\"pkg-head\"><div><h1>{{ name }}</h1><p class=\"lead\">{{ description }}</p>{{ publisher }}<div class=\"tags\">{{ tags }}</div></div><div><p class=\"install\">noxc add {{ install }}</p><p><a href=\"{{ repo_href }}\" rel=\"noopener noreferrer\">{{ repo_label }}</a></p></div></div><section class=\"panel\"><h2>Comments</h2>{{ comments }}{{ composer }}</section>"
    return nox.template.render_unescaped(tmpl, ctx)

def guest_composer() -> str:
    return "<p class=\"callout\"><a href=\"/login\">Sign in</a> to comment or report a problem.</p>"

def member_composer(name: str) -> str:
    ctx: dict[str, str] = {"name": name}
    tmpl: str = "<form data-post=\"/p/{{ name }}/comment\"><label for=\"body\">Comment</label><textarea id=\"body\" name=\"body\" maxlength=\"2000\" required></textarea><p class=\"err\" hidden></p><button class=\"btn\" type=\"submit\">Post comment</button></form><form data-post=\"/p/{{ name }}/report\"><label for=\"title\">Problem title</label><input id=\"title\" name=\"title\" type=\"text\" maxlength=\"120\" required><label for=\"report\">What happened</label><textarea id=\"report\" name=\"body\" maxlength=\"4000\" required></textarea><p class=\"err\" hidden></p><button class=\"btn btn-ghost\" type=\"submit\">Report a problem</button></form>"
    return nox.template.render(tmpl, ctx)

def auth_main() -> str:
    return "<p class=\"kicker\">Account</p><h1>Sign in</h1><p class=\"lead\">An account is all you need to comment and report problems. Publishing packages uses <code>noxc login</code> with GitHub.</p><div class=\"auth-grid\"><section class=\"panel\"><h2>Sign in</h2><form data-post=\"/login\" data-next=\"/\"><label for=\"user\">Username</label><input id=\"user\" name=\"username\" type=\"text\" autocomplete=\"username\" required><label for=\"pw\">Password</label><input id=\"pw\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required><p class=\"err\" hidden></p><button class=\"btn\" type=\"submit\">Sign in</button></form></section><section class=\"panel\"><h2>Create an account</h2><form data-post=\"/register\" data-next=\"/\"><label for=\"new-user\">Username</label><input id=\"new-user\" name=\"username\" type=\"text\" autocomplete=\"username\" required><label for=\"new-pw\">Password</label><input id=\"new-pw\" name=\"password\" type=\"password\" autocomplete=\"new-password\" required><p class=\"err\" hidden></p><button class=\"btn\" type=\"submit\">Create account</button></form></section></div>"

def admin_login_main() -> str:
    return "<p class=\"kicker\">Admin</p><h1>Administrator sign-in</h1><p class=\"lead\">Package approvals and problem reports live behind this door.</p><section class=\"panel\"><form data-post=\"/admin/login\" data-next=\"/admin\"><label for=\"user\">Username</label><input id=\"user\" name=\"username\" type=\"text\" autocomplete=\"username\" value=\"admin\" required><label for=\"pw\">Password</label><input id=\"pw\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required><p class=\"err\" hidden></p><button class=\"btn\" type=\"submit\">Sign in</button></form></section>"

def _pending_row() -> str:
    return "<tr><td>{{ name }}</td><td>{{ publisher }}</td><td>{{ repo }}</td><td>{{ ref }}</td><td>{{ description }}</td><td><button class=\"btn\" type=\"button\" data-admin-post=\"/admin/approve/{{ id }}\">Approve</button> <button class=\"btn btn-ghost danger\" type=\"button\" data-admin-post=\"/admin/reject/{{ id }}\">Reject</button></td></tr>"

def pending_row(id: str, name: str, repo: str, ref: str, description: str, publisher: str) -> str:
    ctx: dict[str, str] = {"id": id, "name": name, "repo": repo, "ref": ref, "description": description, "publisher": publisher}
    return nox.template.render(_pending_row(), ctx)

def _index_row() -> str:
    return "<tr><td>{{ name }}</td><td>{{ publisher }}</td><td>{{ repo }}</td><td>{{ description }}</td><td><button class=\"btn btn-ghost danger\" type=\"button\" data-admin-post=\"/admin/index/remove\" data-extra=\"{{ name }}\">Remove</button></td></tr>"

def index_row(name: str, repo: str, description: str, publisher: str) -> str:
    ctx: dict[str, str] = {"name": name, "repo": repo, "description": description, "publisher": publisher}
    return nox.template.render(_index_row(), ctx)

def _report_row() -> str:
    return "<tr><td>{{ package }}</td><td>{{ username }}</td><td>{{ title }}</td><td>{{ body }}</td><td>{{ status }}</td><td><button class=\"btn btn-ghost\" type=\"button\" data-admin-post=\"/admin/reports/{{ id }}/close\">Close</button></td></tr>"

def report_row(id: str, package_name: str, username: str, title: str, body: str, status: str) -> str:
    ctx: dict[str, str] = {"id": id, "package": package_name, "username": username, "title": title, "body": body, "status": status}
    return nox.template.render(_report_row(), ctx)

def _publisher_row() -> str:
    return "<tr><td><a href=\"https://github.com/{{ login }}\" rel=\"noopener noreferrer\">@{{ login }}</a></td><td>{{ packages }}</td><td>{{ pending }}</td><td>{{ last_login }}</td></tr>"

def publisher_row(login: str, packages: str, pending: str, last_login: str) -> str:
    ctx: dict[str, str] = {"login": login, "packages": packages, "pending": pending, "last_login": last_login}
    return nox.template.render(_publisher_row(), ctx)

def dashboard_main(pending_html: str, index_html: str, report_html: str, publisher_html: str) -> str:
    ctx: dict[str, str] = {"pending": pending_html, "index": index_html, "reports": report_html, "publishers": publisher_html}
    tmpl: str = "<p class=\"kicker\">Admin</p><h1>Registry</h1><section class=\"panel\"><h2>Pending submissions</h2><div class=\"table-wrap\"><table><tr><th>Name</th><th>Publisher</th><th>Repo</th><th>Ref</th><th>Description</th><th></th></tr>{{ pending }}</table></div></section><section class=\"panel\"><h2>Published</h2><div class=\"table-wrap\"><table><tr><th>Name</th><th>Publisher</th><th>Repo</th><th>Description</th><th></th></tr>{{ index }}</table></div></section><section class=\"panel\"><h2>Publishers</h2><div class=\"table-wrap\"><table><tr><th>GitHub</th><th>Packages</th><th>Pending</th><th>Last sign-in</th></tr>{{ publishers }}</table></div></section><section class=\"panel\"><h2>Problem reports</h2><div class=\"table-wrap\"><table><tr><th>Package</th><th>User</th><th>Title</th><th>Details</th><th>Status</th><th></th></tr>{{ reports }}</table></div></section>"
    return nox.template.render_unescaped(tmpl, ctx)

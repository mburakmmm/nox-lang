# handlers_admin — yönetim kapısı. Kayıt olan hesap buraya giremez;
# rol veritabanından okunur. Onay, çıkarma ve hata kapatma CSRF ister.
import nox.strings
import store
from store import Submission, IndexEntry, Report, Viewer
from nox.router import Context
from nox.http import HttpResponse
from nox.json import JsonError
import http_util
import auth
from auth import Session
import templates
import handlers_public

def _cookie_value(ctx: Context) -> str:
    if not ctx.request.headers.contains("Cookie"):
        return ""
    cookies: dict[str, str] = http_util.parse_cookies(ctx.request.headers["Cookie"])
    if not cookies.contains("noxpkg_session"):
        return ""
    return cookies["noxpkg_session"]

def require_admin_session(ctx: Context) -> HttpResponse | None:
    target: str = ctx.request.target
    if not nox.strings.starts_with(target, "/admin"):
        return None
    if nox.strings.starts_with(target, "/admin/login"):
        return None
    viewer: Viewer | None = handlers_public.current_viewer(ctx)
    if viewer == None:
        return HttpResponse(302, "", {"Location": "/admin/login"})
    if viewer.role != "admin":
        return HttpResponse(302, "", {"Location": "/admin/login"})
    return None

def login_page(ctx: Context) -> HttpResponse:
    html: str = templates.page("Yönetim — Nox", templates.account_bar("", ""), templates.admin_login_main(), "")
    return HttpResponse(200, html, {"Content-Type": "text/html; charset=utf-8"})

def login_submit(ctx: Context) -> HttpResponse:
    if handlers_public._locked(ctx, "admin:", 900000, 5):
        return handlers_public._json_msg(429, False, "Çok fazla deneme.")
    username: str = ""
    password: str = ""
    try:
        username = handlers_public._field(ctx.request.body, "username")
        password = handlers_public._field(ctx.request.body, "password")
    except JsonError:
        return handlers_public._json_msg(400, False, "İstek okunamadı.")
    viewer: Viewer | None = store.authenticate(username, password)
    if viewer == None:
        handlers_public._hit(ctx, "admin:", 900000)
        return handlers_public._json_msg(401, False, "Yönetici girişi reddedildi.")
    if viewer.role != "admin":
        handlers_public._hit(ctx, "admin:", 900000)
        return handlers_public._json_msg(401, False, "Yönetici girişi reddedildi.")
    handlers_public._clear_hits(ctx, "admin:")
    return HttpResponse(200, "{\"ok\": true, \"error\": \"\"}", {"Content-Type": "application/json", "Set-Cookie": handlers_public._session_cookie(ctx, viewer)})

def _csrf_ok(ctx: Context, submitted: str) -> bool:
    session: Session = Session(handlers_public._secret())
    return session.verify_csrf(_cookie_value(ctx), submitted)

def dashboard(ctx: Context) -> HttpResponse:
    subs: list[Submission] = store.load_inbox()
    pending_html: str = ""
    i: int = 0
    while i < len(subs):
        s: Submission = subs[i]
        pending_html = pending_html + templates.pending_row(s.id, s.name, s.repo, s.ref, s.description)
        i = i + 1
    entries: list[IndexEntry] = store.load_packages()
    index_html: str = ""
    j: int = 0
    while j < len(entries):
        e: IndexEntry = entries[j]
        index_html = index_html + templates.index_row(e.name, e.repo, e.description)
        j = j + 1
    reports: list[Report] = store.load_reports()
    report_html: str = ""
    k: int = 0
    while k < len(reports):
        r: Report = reports[k]
        report_html = report_html + templates.report_row(str(r.id), r.package_name, r.username, r.title, r.body, r.status)
        k = k + 1
    viewer: Viewer | None = handlers_public.current_viewer(ctx)
    account: str = templates.account_bar("", "")
    if viewer != None:
        account = templates.account_bar(viewer.username, viewer.role)
    html: str = templates.page("Yönetim — Nox", account, templates.dashboard_main(pending_html, index_html, report_html), handlers_public._csrf(ctx))
    return HttpResponse(200, html, {"Content-Type": "text/html; charset=utf-8"})

def approve(ctx: Context) -> HttpResponse:
    if not _csrf_ok(ctx, ctx.request.body):
        return HttpResponse(403, "", {})
    if not store.approve_submission(ctx.param("id")):
        return HttpResponse(404, "", {})
    return HttpResponse(200, "", {})

def reject(ctx: Context) -> HttpResponse:
    if not _csrf_ok(ctx, ctx.request.body):
        return HttpResponse(403, "", {})
    if not store.reject_submission(ctx.param("id")):
        return HttpResponse(404, "", {})
    return HttpResponse(200, "", {})

def remove_entry(ctx: Context) -> HttpResponse:
    parts: list[str] = nox.strings.splitn(ctx.request.body, "\n", 2)
    if len(parts) != 2:
        return HttpResponse(400, "", {})
    if not _csrf_ok(ctx, parts[0]):
        return HttpResponse(403, "", {})
    if not store.remove_package(parts[1]):
        return HttpResponse(404, "", {})
    return HttpResponse(200, "", {})

def close_report(ctx: Context) -> HttpResponse:
    if not _csrf_ok(ctx, ctx.request.body):
        return HttpResponse(403, "", {})
    if not store.set_report_status(int(ctx.param("id")), "closed"):
        return HttpResponse(404, "", {})
    return HttpResponse(200, "", {})

def logout(ctx: Context) -> HttpResponse:
    return handlers_public.logout(ctx)

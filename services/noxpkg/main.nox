# main — noxpkg sunucusunun giriş noktası.
#
# Birinci-sınıf fonksiyon değeri yalnızca AYNI dosyada tanımlı üst-düzey
# fonksiyonlar için çalışır. Her işleyici bu yüzden ince bir `h_*`
# sarmalayıcıdır.
#
# `num_threads=1` bilinçli: rate-limit dosyası ve SQLite yazıları tek
# iş parçacığında yarışmasın. `PORT` 8080. Durum `data/noxpkg.db`dedir;
# `GET /index.json` bu veritabanından üretilir.
import nox.http
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
import handlers_public
import handlers_admin

def h_home(ctx: Context) -> HttpResponse:
    return handlers_public.home(ctx)

def h_index_json(ctx: Context) -> HttpResponse:
    return handlers_public.index_json(ctx)

def h_publish(ctx: Context) -> HttpResponse:
    return handlers_public.publish(ctx)

def h_css(ctx: Context) -> HttpResponse:
    return handlers_public.css(ctx)

def h_js(ctx: Context) -> HttpResponse:
    return handlers_public.js(ctx)

def h_login_page(ctx: Context) -> HttpResponse:
    return handlers_public.login_page(ctx)

def h_login_submit(ctx: Context) -> HttpResponse:
    return handlers_public.login_submit(ctx)

def h_register(ctx: Context) -> HttpResponse:
    return handlers_public.register_submit(ctx)

def h_logout(ctx: Context) -> HttpResponse:
    return handlers_public.logout(ctx)

def h_package(ctx: Context) -> HttpResponse:
    return handlers_public.package_page(ctx)

def h_comment(ctx: Context) -> HttpResponse:
    return handlers_public.post_comment(ctx)

def h_report(ctx: Context) -> HttpResponse:
    return handlers_public.post_report(ctx)

def h_admin_login_page(ctx: Context) -> HttpResponse:
    return handlers_admin.login_page(ctx)

def h_admin_login_submit(ctx: Context) -> HttpResponse:
    return handlers_admin.login_submit(ctx)

def h_dashboard(ctx: Context) -> HttpResponse:
    return handlers_admin.dashboard(ctx)

def h_approve(ctx: Context) -> HttpResponse:
    return handlers_admin.approve(ctx)

def h_reject(ctx: Context) -> HttpResponse:
    return handlers_admin.reject(ctx)

def h_remove_entry(ctx: Context) -> HttpResponse:
    return handlers_admin.remove_entry(ctx)

def h_close_report(ctx: Context) -> HttpResponse:
    return handlers_admin.close_report(ctx)

def h_admin_logout(ctx: Context) -> HttpResponse:
    return handlers_admin.logout(ctx)

def h_require_admin_session(ctx: Context) -> HttpResponse | None:
    return handlers_admin.require_admin_session(ctx)

def build_router() -> Router:
    router: Router = Router()
    router.get("/", h_home)
    router.get("/index.json", h_index_json)
    router.get("/pkg.css", h_css)
    router.get("/pkg.js", h_js)
    router.get("/giris", h_login_page)
    router.post("/giris", h_login_submit)
    router.post("/kayit", h_register)
    router.post("/cikis", h_logout)
    router.get("/p/:name", h_package)
    router.post("/p/:name/yorum", h_comment)
    router.post("/p/:name/hata", h_report)
    router.post("/api/publish", h_publish)
    router.get("/admin/login", h_admin_login_page)
    router.post("/admin/login", h_admin_login_submit)
    router.get("/admin", h_dashboard)
    router.post("/admin/approve/:id", h_approve)
    router.post("/admin/reject/:id", h_reject)
    router.post("/admin/index/remove", h_remove_entry)
    router.post("/admin/reports/:id/close", h_close_report)
    router.post("/admin/logout", h_admin_logout)
    router.use_before(h_require_admin_session)
    return router

router: Router = build_router()

def handle(req: HttpRequest) -> HttpResponse:
    try:
        return router.dispatch(req)
    except Exception as e:
        print(e.message)
        return HttpResponse(500, e.message, {"Content-Type": "text/plain; charset=utf-8"})

nox.http.serve_multicore(8080, handle, 1, 0)

# auth — noxpkg'in admin oturum/CSRF/rate-limit katmanı.
#
# **Bulundu, GERÇEK bir dil kısıtı (bu modülün TASARIMINI DOĞRUDAN
# ŞEKİLLENDİRDİ):** Nox'ta modül-düzeyi (üst-düzey `var_decl`) durum,
# BAŞKA bir fonksiyonun İÇİNDEN GÖRÜLEMEZ — ne okuma ne yazma (`counter:
# int = 0` + `def f(): counter = counter + 1` bile `UndefinedVariable`
# verir; TEK-dosyalık, gerçek bir minimal tekrar-üretimle DOĞRULANDI).
# `nox.http.serve*`nin `handle`si ÇIPLAK bir üst-düzey fonksiyon OLMAK
# ZORUNDA OLDUĞUNDAN (closure/metod DEĞİL) HİÇBİR ORTAK "tek global
# Router/Store örneği" isteğe bağlı DEĞİL — YASAK. Çözüm: HER ŞEY
# DURUMSUZ — oturum imzalama saf bir HMAC hesabı (paylaşılan durum
# GEREKMEZ), `RateLimiter` İSE (GERÇEKTEN istekler ARASI kalıcı durum
# gerektiren TEK bileşen) küçük bir düz-metin dosyasına (`data/
# ratelimit.txt`) HER çağrıda YÜKLENİP/KAYDEDİLİR — `main.nox`nin
# `num_threads=1`i (bkz. onun belge notu) BU dosya round-trip'ini
# YARIŞ-KOŞULU'NDAN korur (aynı ANDA İKİ isteğin HİÇBİR ZAMAN aynı
# dosyayı OKUYUP/YAZMADIĞI garantisi).
import nox.crypto
import nox.strings
import nox.time
import nox.fs

class Session:
    def __init__(self: Session, secret: str) -> None:
        self.secret = secret

    def _sign(self: Session, session_id: str, issued_at: str, suffix: str) -> str:
        return nox.crypto.hmac_sha256(self.secret, session_id + "." + issued_at + suffix)

    def mint_cookie_value(self: Session) -> str:
        session_id: str = nox.crypto.secure_random_hex(16)
        issued_at: str = str(nox.time.now_ms() // 1000)
        sig: str = self._sign(session_id, issued_at, "")
        return session_id + "." + issued_at + "." + sig

    def is_valid(self: Session, cookie_value: str) -> bool:
        parts: list[str] = nox.strings.splitn(cookie_value, ".", 3)
        if len(parts) != 3:
            return False
        session_id: str = parts[0]
        issued_at: str = parts[1]
        sig: str = parts[2]
        expected: str = self._sign(session_id, issued_at, "")
        if not nox.crypto.constant_time_eq(sig, expected):
            return False
        issued_at_s: int = int(issued_at)
        now_s: int = nox.time.now_ms() // 1000
        if now_s - issued_at_s > 43200:
            return False
        return True

    def csrf_token(self: Session, cookie_value: str) -> str:
        parts: list[str] = nox.strings.splitn(cookie_value, ".", 3)
        if len(parts) != 3:
            return ""
        session_id: str = parts[0]
        issued_at: str = parts[1]
        return self._sign(session_id, issued_at, ".csrf")

    def verify_csrf(self: Session, cookie_value: str, submitted_token: str) -> bool:
        expected: str = self.csrf_token(cookie_value)
        if len(expected) == 0:
            return False
        return nox.crypto.constant_time_eq(expected, submitted_token)

# Dosya biçimi: HER satır "<anahtar> <sayac> <pencere-baslangici-ms>" —
# bilinçli olarak JSON DEĞİL (bir `dict[str,int]`i `nox.json`nin
# `JsonValue` ağacına el ile inşa etmek/ayrıştırmak İçin GEREKEN kodun
# BASİTLİĞİ, bu ölçekte — tek admin, ender giriş denemesi — buna
# DEĞMEDİ).
class RateLimiter:
    keys: list[str]
    counts: list[int]
    starts_ms: list[int]

    def __init__(self: RateLimiter) -> None:
        self.keys = []
        self.counts = []
        self.starts_ms = []

    def load(self: RateLimiter, path: str) -> None:
        if not nox.fs.exists(path):
            return
        content: str = nox.fs.read_to_string(path)
        lines: list[str] = nox.strings.split(content, "\n")
        i: int = 0
        while i < len(lines):
            line: str = nox.strings.trim(lines[i])
            if len(line) > 0:
                parts: list[str] = nox.strings.split(line, " ")
                if len(parts) == 3:
                    keys: list[str] = self.keys
                    keys.append(parts[0])
                    self.keys = keys
                    counts: list[int] = self.counts
                    counts.append(int(parts[1]))
                    self.counts = counts
                    starts_ms: list[int] = self.starts_ms
                    starts_ms.append(int(parts[2]))
                    self.starts_ms = starts_ms
            i = i + 1

    def save(self: RateLimiter, path: str) -> None:
        out: str = ""
        i: int = 0
        while i < len(self.keys):
            out = out + self.keys[i] + " " + str(self.counts[i]) + " " + str(self.starts_ms[i]) + "\n"
            i = i + 1
        tmp: str = path + ".tmp"
        nox.fs.write_string(tmp, out)
        nox.fs.rename(tmp, path)

    def _find(self: RateLimiter, key: str) -> int:
        i: int = 0
        while i < len(self.keys):
            if self.keys[i] == key:
                return i
            i = i + 1
        return -1

    def is_locked(self: RateLimiter, key: str, window_ms: int, max_attempts: int) -> bool:
        idx: int = self._find(key)
        if idx < 0:
            return False
        now: int = nox.time.now_ms()
        if now - self.starts_ms[idx] > window_ms:
            return False
        return self.counts[idx] >= max_attempts

    def record_failure(self: RateLimiter, key: str, window_ms: int) -> None:
        now: int = nox.time.now_ms()
        idx: int = self._find(key)
        if idx < 0:
            keys: list[str] = self.keys
            keys.append(key)
            self.keys = keys
            counts: list[int] = self.counts
            counts.append(1)
            self.counts = counts
            starts_ms: list[int] = self.starts_ms
            starts_ms.append(now)
            self.starts_ms = starts_ms
            return
        if now - self.starts_ms[idx] > window_ms:
            self.counts[idx] = 1
            self.starts_ms[idx] = now
        else:
            self.counts[idx] = self.counts[idx] + 1

    def reset(self: RateLimiter, key: str) -> None:
        idx: int = self._find(key)
        if idx >= 0:
            self.counts[idx] = 0

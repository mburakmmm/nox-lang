# Welcome to the Nox playground. Edit this program and press Run.
def greet(name: str) -> str:
    return f"Hello, {name}!"

names: list[str] = ["Nox", "WebAssembly", "you"]
for n in names:
    print(greet(n))

total: int = 0
for i in range(1, 11):
    total += i * i
print("sum of the first ten squares:", total)

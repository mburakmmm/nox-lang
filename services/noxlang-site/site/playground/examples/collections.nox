words: list[str] = ["nox", "native", "typed", "fast", "nox", "wasm", "typed", "nox"]

counts: dict[str, int] = {}
for w in words:
    if w in counts:
        counts[w] += 1
    else:
        counts[w] = 1

for key in sorted(list(counts.keys())):
    print(key, counts[key])

odd_squares: list[int] = [x * x for x in range(1, 8) if x % 2 == 1]
print("odd squares:", odd_squares)

longest: str = ""
for w in words:
    if len(w) > len(longest):
        longest = w
print("longest word:", longest)

unique: set[str] = set(words)
print("unique words:", len(unique))

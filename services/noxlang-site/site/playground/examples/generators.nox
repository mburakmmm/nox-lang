def fib(limit: int) -> Iterator[int]:
    a: int = 0
    b: int = 1
    while a < limit:
        yield a
        a, b = b, a + b

total: int = 0
for n in fib(200):
    print(n)
    total += n
print("sum:", total)

def squares(xs: list[int]) -> Iterator[int]:
    for x in xs:
        yield x * x

print(sum(list(squares([1, 2, 3, 4]))))

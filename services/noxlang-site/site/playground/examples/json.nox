import nox.json
from nox.json import JsonValue

text: str = '{"name": "Nox", "tags": ["typed", "native"], "stable": true}'
v: JsonValue = nox.json.parse(text)
for i in range(nox.json.object_len(v)):
    print("key:", nox.json.object_key(v, i))
print(nox.json.dump_string("quote \" and unicode ✓"))
print(nox.json.dump(v))

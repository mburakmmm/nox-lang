import nox.http
import nox.os
import nox.time
from nox.http import HttpResponse, HttpError, HttpTimeoutError

async def worker(url: str, ch: Channel[int]) -> None:
    code: int = 3
    try:
        r: HttpResponse = nox.http.request("GET", url, "", {}, 60000)
        if r.status == 200 and r.body == "ok":
            code = 0
    except HttpTimeoutError:
        code = 1
    except HttpError:
        code = 2
    await ch.send(code)

async def driver(url: str, n: int, ch: Channel[int]) -> None:
    i: int = 0
    while i < n:
        t: Task[None] = spawn worker(url, ch)
        i = i + 1

N: int = int(nox.os.getenv("LOAD_N"))
URL: str = nox.os.getenv("LOAD_URL")
start: int = nox.time.instant_now().ms
ch: Channel[int] = Channel[int](0)
d: Task[None] = spawn driver(URL, N, ch)
oks: int = 0
timeouts: int = 0
errors: int = 0
bad: int = 0
k: int = 0
while k < N:
    c: int = await ch.recv()
    if c == 0:
        oks = oks + 1
    if c == 1:
        timeouts = timeouts + 1
    if c == 2:
        errors = errors + 1
    if c == 3:
        bad = bad + 1
    k = k + 1
await d
print("N " + str(N) + " ok " + str(oks) + " timeouts " + str(timeouts) + " errors " + str(errors) + " bad " + str(bad) + " ms " + str(nox.time.instant_now().ms - start))

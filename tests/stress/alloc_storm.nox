# ARC stres: tahsis fırtınası — milyonlarca kısa ömürlü liste/dize/sınıf, farklı yaşam süreleri ve boyutlarla (parçalanma, serbest bırakma yolları).
import nox.os

class Cell:
    a: int
    b: str

    def __init__(self, a: int, b: str) -> None:
        self.a = a
        self.b = b

def scale() -> int:
    if nox.os.arg_count() > 1:
        return int(nox.os.arg(1))
    return 1

def churn(n: int) -> int:
    keep: list[Cell] = []
    total: int = 0
    for i in range(n):
        c: Cell = Cell(i, "cell-" + str(i % 97))
        tmp: list[int] = [i, i + 1, i + 2, i + 3]
        total = total + tmp[i % 4] + len(c.b)
        if i % 50 == 0:
            keep.append(c)
        if i % 5000 == 4999:
            # uzun ömürlüleri periyodik bırak: karışık yaşam süreleri
            keep = []
    return total + len(keep)

def big_small(n: int) -> int:
    t: int = 0
    for i in range(n):
        big: list[int] = []
        for j in range(200):
            big.append(j * i)
        s: str = "x" * (i % 300)
        t = t + len(big) + len(s) + big[199 % (len(big))]
    return t

S: int = scale()
print(churn(400000 * S))
print(big_small(20000 * S))

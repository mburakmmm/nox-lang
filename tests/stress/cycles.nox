# ARC stres: döngüsel yapılar — çift bağlı liste, graf, kendine referans veren nesne; her tur atılır, döngü çözücü belleği geri vermeli (tepe RSS sınırlı kalmalı).
import nox.os

class DNode:
    val: int
    prev: DNode | None
    nxt: DNode | None

    def __init__(self, val: int) -> None:
        self.val = val
        self.prev = None
        self.nxt = None

class GNode:
    id: int
    edges: list[GNode]

    def __init__(self, id: int) -> None:
        self.id = id
        self.edges = []

class SelfRef:
    me: SelfRef | None
    payload: list[int]

    def __init__(self) -> None:
        self.me = None
        self.payload = [1, 2, 3, 4, 5, 6, 7, 8]

def scale() -> int:
    if nox.os.arg_count() > 1:
        return int(nox.os.arg(1))
    return 1

def dlist(n: int) -> int:
    head: DNode = DNode(0)
    cur: DNode = head
    for i in range(1, n):
        nxt: DNode = DNode(i)
        cur.nxt = nxt
        nxt.prev = cur
        cur = nxt
    return head.val + cur.val

def graph(n: int) -> int:
    nodes: list[GNode] = []
    for i in range(n):
        nodes.append(GNode(i))
    for i in range(n):
        g: GNode = nodes[i]
        g.edges.append(nodes[(i + 1) % n])
        g.edges.append(nodes[(i * 7 + 3) % n])
    return len(nodes[0].edges) + nodes[n - 1].id

def selfref(n: int) -> int:
    t: int = 0
    for i in range(n):
        s: SelfRef = SelfRef()
        s.me = s
        t = t + len(s.payload)
    return t

S: int = scale()
acc: int = 0
for r in range(30 * S):
    acc = acc + dlist(2000) + graph(1500) + selfref(2000)
print(acc)

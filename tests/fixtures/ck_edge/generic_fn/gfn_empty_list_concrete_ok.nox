class Acc:
    n: int

    def __init__(self, n: int) -> None:
        self.n = n

    def m[T](self, x: T, ys: list[int]) -> T:
        return x

def f[T](x: T, ys: list[int]) -> T:
    return x

def run_emp() -> int:
    a: str = f("ok", [])
    c: Acc = Acc(1)
    b: str = c.m("ok", [])
    return 0

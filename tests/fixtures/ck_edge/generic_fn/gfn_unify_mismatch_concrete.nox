class Box[T]:
    v: T

class Other[T]:
    v: T

class Item:
    x: int

def f_conc[T](x: T, y: int) -> T:
    return x

def f_list[T](xs: list[T]) -> T:
    return xs[0]

def f_dict[K, V](d: dict[K, V], k: K) -> V:
    return d[k]

def f_fn[T](x: T, fn: (T) -> int) -> int:
    return fn(x)

def f_ptr[T](p: ptr[T]) -> int:
    return 0

def unbox[T](b: Box[T]) -> T:
    return b.v

def bad_fn(a: int, b: int) -> int:
    return a + b

a: int = f_conc(1, "s")
b: int = f_list(1)
c: int = f_dict(1, "k")
d: int = f_fn(1, bad_fn)
e: int = f_ptr(1)
f: int = unbox(Item(1))
g: int = unbox(Other[int](1))

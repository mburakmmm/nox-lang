class Item:
    k: int
    def __init__(self, k: int) -> None:
        self.k = k

class Base:
    b: int
    def __init__(self, b: int) -> None:
        self.b = b
    def first[T](self, x: T) -> T:
        return x
    def again[T](self, x: T) -> T:
        return self.first[T](x)
    def rec[T](self, x: T, n: int) -> T:
        if n <= 0:
            return x
        return self.rec[T](x, n - 1)

class Sub(Base):
    pass

s: Sub = Sub(1)
a: int = s.first(3)
b: int = s.first(4)
c: Item = s.again[Item](Item(5))
d: str = s.first[str]("z")
e: int = s.rec[int](1, 2)

class __nox_Set[T]:
    items: list[T]
    def __init__(self, items: list[T]) -> None:
        self.items = items

def __nox_set_from_list[T](xs: list[T]) -> set[T]:
    return __nox_Set[T](xs)

def __nox_hex(x: int) -> str:
    return "0x"

def __nox_oct(x: int) -> str:
    return "0o"

def __nox_bin(x: int) -> str:
    return "0b"

def __nox_pow_int(a: int, b: int) -> int:
    return a

def __nox_pow_float(a: float, b: float) -> float:
    return a

def __nox_pow_mod(a: int, b: int, m: int) -> int:
    return a

def __nox_int_base(s: str, b: int) -> int:
    return b

def __nox_zip3[A, B, C](xs: list[A], ys: list[B], zs: list[C]) -> list[int]:
    return [0]

def __nox_max_list[T](xs: list[T]) -> T:
    return xs[0]

def __nox_min_default[T](xs: list[T], default: T) -> T:
    return default

def __nox_max_many(a: int, b: int, c: int) -> int:
    return a

def __nox_sorted_key[T, K](xs: list[T], key: (T) -> K) -> list[T]:
    return xs

def sum_float(xs: list[float]) -> float:
    return 0.0

def __nox_round_digits(x: float, nd: int) -> float:
    return x

def __nox_format_int(x: int, sp: str) -> str:
    return sp

def __nox_format_float(x: float, sp: str) -> str:
    return sp

def __nox_format_str(x: str, sp: str) -> str:
    return x

def __nox_any_range(a: int, b: int, p: (int) -> bool) -> bool:
    return p(a)

def __nox_all_pred[T](xs: list[T], p: (T) -> bool) -> bool:
    return p(xs[0])

def __nox_str_chars(s: str) -> list[str]:
    return [s]

class Plain:
    v: int
    def __init__(self, v: int) -> None:
        self.v = v

class WithBool:
    v: int
    def __init__(self, v: int) -> None:
        self.v = v
    def __bool__(self) -> bool:
        return self.v != 0

class WithLen:
    v: int
    def __init__(self, v: int) -> None:
        self.v = v
    def __len__(self) -> int:
        return self.v

class WithStr:
    v: int
    def __init__(self, v: int) -> None:
        self.v = v
    def __str__(self) -> str:
        return "w"

lr: list[int] = list(range(3))
lc: list[int] = list([1, 2])
ls: list[str] = list("ab")
lk: list[str] = list({"a": 1})
st: set[int] = set([1, 2])
b1: bool = bool(1)
b2: bool = bool(0.0)
b3: bool = bool("a")
b4: bool = bool([1])
b5: bool = bool(Plain(1))
b6: bool = bool(WithBool(1))
b7: bool = bool(WithLen(2))
hx: str = hex(10)
oc: str = oct(10)
bn: str = bin(10)
pi: int = pow(2, 3)
pf: float = pow(2.0, 3.0)
pm: int = pow(2, 3, 5)
ib: int = int("ff", 16)
zp: list[int] = zip([1], ["a"], [True])
mx: int = max([1, 2])
mm: int = max(1, 2, 3)
sf: float = sum([1.0, 2.0])
rn: float = round(1.23, 1)
fi: str = format(5, "d")
ff: str = format(1.5, ".1f")
fs: str = format("hi", ">4")
fb: str = format(True, "d")
fb2: str = format(True, "")
a1: bool = any(i > 0 for i in range(3))
a2: bool = all(x > 0 for x in [1, 2] if x != 0)

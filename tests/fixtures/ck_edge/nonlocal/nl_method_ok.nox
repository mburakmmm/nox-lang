class Box:
    val: int
    def __init__(self, val: int) -> None:
        self.val = val
    def bump(self, d: int) -> int:
        cur: int = self.val
        def add() -> int:
            nonlocal cur
            cur = cur + d
            return cur
        return add()
b: Box = Box(7)
r: int = b.bump(3)

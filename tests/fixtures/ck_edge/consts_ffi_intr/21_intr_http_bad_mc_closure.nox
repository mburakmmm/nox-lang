import nox.http

class nox_http_HttpRequest:
    path: str
    def __init__(self, path: str) -> None:
        self.path = path

class nox_http_HttpResponse:
    status: int
    def __init__(self, status: int) -> None:
        self.status = status

if False:
    nox.http.serve_multicore(8080, lambda req: nox_http_HttpResponse(200), 2)

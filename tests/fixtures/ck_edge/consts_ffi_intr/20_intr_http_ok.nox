import nox.http
import nox.websocket

class nox_http_HttpRequest:
    path: str
    def __init__(self, path: str) -> None:
        self.path = path

class nox_http_HttpResponse:
    status: int
    def __init__(self, status: int) -> None:
        self.status = status

class nox_websocket_WebSocketServerConn:
    id: int
    def __init__(self, id: int) -> None:
        self.id = id

def h(req: nox_http_HttpRequest) -> nox_http_HttpResponse:
    return nox_http_HttpResponse(200)

def fac() -> (nox_http_HttpRequest) -> nox_http_HttpResponse:
    return h

def ws(c: nox_websocket_WebSocketServerConn) -> None:
    pass

if False:
    nox.http.serve(8080, h)
    nox.http.serve_fd(3, h, 16)
    nox.http.serve_multicore(8080, fac, 4, 32)
    nox.http.serve_tls(8443, h, "c.pem", "k.pem")
    nox.http.serve_ws(8080, h, ws)
    nox.http.serve_multicore_ws_tls(8443, fac, 2, ws, "c.pem", "k.pem", 64)

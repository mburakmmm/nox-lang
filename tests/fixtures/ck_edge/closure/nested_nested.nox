def apply(f: (int) -> int, x: int) -> int:
    return f(x)
def run0(f: () -> None) -> None:
    f()
def cleanup(n: int) -> None:
    pass
g0: int = 5
def outer(k: int) -> int:
    def mid(a: int) -> int:
        def inn(b: int) -> int:
            return a + b + k
        return inn(1)
    return mid(2)

def apply(f: (int) -> int, x: int) -> int:
    return f(x)
def run0(f: () -> None) -> None:
    f()
def cleanup(n: int) -> None:
    pass
g0: int = 5
def outer(k: int) -> int:
    def inner(a: int) -> int:
        return a + k + g0
    x: int = inner(1)
    y: str = inner(2)
    z: int = inner()
    w: int = inner("s")
    return inner(3)

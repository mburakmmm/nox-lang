class Box[T]:
    v: T
    def __init__(self, v: T) -> None:
        self.v = v
    def get(self) -> T:
        return self.v

class Sub(Box[int]):
    e: int
    def __init__(self, v: int, e: int) -> None:
        super().__init__(v)
        self.e = e
    def get(self) -> int:
        return super().get() + self.e

s: Sub = Sub(10, 5)
r: int = s.get() + s.v

class Box[T]:
    v: T
    def __init__(self, v: T) -> None:
        self.v = v
    def get(self) -> T:
        return self.v

class Pair[K, V]:
    k: K
    v: V
    def __init__(self, k: K, v: V) -> None:
        self.k = k
        self.v = v

a: Box[int] = Box[int](42)
b: int = a.get()
c: Box[int] = Box[int](7)
p: Pair[str, int] = Pair[str, int]("ok", b + c.get())
k: str = p.k

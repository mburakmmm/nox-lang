import lib

class lib_Item:
    k: int
    def __init__(self, k: int) -> None:
        self.k = k

class lib_Box[T]:
    v: T
    def __init__(self, v: T) -> None:
        self.v = v
    def get(self) -> T:
        return self.v

a: lib.Box[lib.Item] = lib.Box[lib.Item](lib.Item(3))
b: lib.Box[list[int]] = lib.Box[list[int]]([1, 2])
x: int = a.get().k + len(b.get())

class Base:
    v: int
    def __init__(self, v: int) -> None:
        self.v = v
    def calc(self) -> int:
        return self.v + 1

class Child(Base):
    def __init__(self, v: int) -> None:
        Base.__init__(self, v)
    def calc(self) -> int:
        return Base.calc(self) * 2

def run() -> None:
    c: Child = Child(5)
    print(c.calc())

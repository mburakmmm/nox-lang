class Exception:
    msg: str
    def __init__(self, msg: str) -> None:
        self.msg = msg

class __nox_FnBox[F]:
    f: F
    def __init__(self, f: F) -> None:
        self.f = f

class __nox_Gen[T]:
    step: () -> T | None
    def __init__(self, step: () -> T | None) -> None:
        self.step = step
    def __next__(self) -> T | None:
        return self.step()
    def close(self) -> None:
        pass

def __nox_unwrap[T](x: T | None) -> T:
    if x is not None:
        return x
    raise Exception("unwrap")

def __nox_gen_from_step[T](step: () -> T | None) -> __nox_Gen[T]:
    return __nox_Gen[T](step)

def g() -> Iterator[int]:
    f: (int) -> int = lambda x: x + 1
    yield f(1)
    f = lambda x: x + 2
    yield f(2)

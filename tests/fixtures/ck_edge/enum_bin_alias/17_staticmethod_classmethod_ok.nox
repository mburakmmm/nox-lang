class Counter:
    n: int
    def __init__(self, n: int) -> None:
        self.n = n
    @staticmethod
    def zero() -> Counter:
        return Counter(0)
    @classmethod
    def from_val(cls, v: int) -> Counter:
        return cls(v)

def run() -> None:
    a: Counter = Counter.zero()
    b: Counter = Counter.from_val(5)
    print(a.n + b.n)

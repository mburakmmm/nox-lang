class Box:
    _v: int
    def __init__(self, v: int) -> None:
        self._v = v
    @property
    def val(self) -> int:
        return self._v
    @val.setter
    def val(self, nv: int) -> None:
        self._v = nv

def run() -> None:
    b: Box = Box(3)
    print(b.val)
    b.val = 9
    print(b.val)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mburakmmm/aHPy/schemas/nox-hpy-package-v1.json",
  "title": "aHPy Universal HPy package manifest for NOX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "producer",
    "host",
    "module",
    "exports",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ahpy_version",
        "cython_base",
        "source_digest",
        "compiler_options_digest"
      ],
      "properties": {
        "ahpy_version": {"type": "string", "minLength": 1},
        "cython_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "compiler_options_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "hpy_abi",
        "hpy_version",
        "required_capabilities"
      ],
      "properties": {
        "profile": {"const": "nox-hpy-host-v1"},
        "hpy_abi": {"const": "universal"},
        "hpy_version": {"const": "0.9"},
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "init_symbol"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "init_symbol": {"type": "string", "pattern": "^HPyInit_[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "exports": {
      "type": "array",
      "items": {"$ref": "#/$defs/export"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "bytes",
        "call-keywords",
        "call-positional",
        "error-take",
        "extension-object",
        "hpy-debug",
        "hpy-trace",
        "module-close",
        "module-open",
        "object-close"
      ]
    },
    "value_kind": {
      "type": "string",
      "enum": [
        "bool",
        "bytes",
        "float64",
        "int64",
        "none",
        "opaque-object",
        "unicode",
        "void"
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "call_kind", "ownership"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/value_kind"},
        "call_kind": {
          "type": "string",
          "enum": ["keyword-only", "positional-only", "positional-or-keyword"]
        },
        "ownership": {"enum": ["borrowed", "owned", "value"]}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "parameters", "result"],
      "properties": {
        "kind": {"enum": ["constructor", "method", "module-function"]},
        "name": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ownership"],
          "properties": {
            "kind": {"$ref": "#/$defs/value_kind"},
            "ownership": {"enum": ["owned", "value"]}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "path", "sha256", "size"],
      "properties": {
        "target": {
          "enum": [
            "linux-aarch64",
            "linux-x86_64",
            "macos-aarch64",
            "macos-x86_64",
            "windows-x86_64"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.hpy0$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    }
  }
}

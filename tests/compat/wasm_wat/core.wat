;; Yorumlayıcının yapısal özelliklerini (kontrol akışı, bellek, global, tablo, çok değerli, bulk-memory, referanslar, start, içe aktarma) sınar.
;; `scripts/wasm_build_wat.sh` ile `core.wasm`a derlenir; `tests/compat/wasm_interp_test.zig` bekleneni doğrular.
(module
  (type $binop (func (param i32 i32) (result i32)))
  (type $unop (func (param i32) (result i32)))
  (import "env" "host_add" (func $host_add (param i32 i32) (result i32)))
  (import "env" "host_counter" (func $host_counter (result i32)))
  (import "env" "base" (global $base i32))
  (memory (export "memory") 1 4)
  (table $t 8 funcref)
  (table $t2 4 externref)
  (global $counter (mut i32) (i32.const 0))
  (global $g64 (mut i64) (i64.const 10))
  (global $gf (mut f64) (f64.const 1.5))
  (global (export "const_g") i32 (i32.const 77))
  (data (i32.const 16) "hello, wasm")
  (data $passive "ABCDEFGH")
  (elem (i32.const 0) $inc $dec $mul2 $unop_alias)
  (elem $pe funcref (ref.func $inc) (ref.func $dec) (ref.null func))
  (elem declare func $five)
  (start $init)

  (func $init (global.set $counter (i32.const 100)))
  (func $inc (type $unop) (i32.add (local.get 0) (i32.const 1)))
  (func $dec (type $unop) (i32.sub (local.get 0) (i32.const 1)))
  (func $mul2 (type $unop) (i32.mul (local.get 0) (i32.const 2)))
  (func $unop_alias (type $unop) (local.get 0))
  (func $five (result i32) (i32.const 5))

  (func (export "counter") (result i32) (global.get $counter))
  (func (export "bump") (result i32)
    (global.set $counter (i32.add (global.get $counter) (i32.const 1)))
    (global.get $counter))
  (func (export "g64") (result i64) (global.set $g64 (i64.mul (global.get $g64) (i64.const 3))) (global.get $g64))
  (func (export "gf") (result f64) (global.set $gf (f64.mul (global.get $gf) (f64.const 2))) (global.get $gf))
  (func (export "base_plus") (param i32) (result i32) (i32.add (global.get $base) (local.get 0)))

  ;; ---- kontrol akışı ----
  (func $fac (export "fac") (param i64) (result i64)
    (if (result i64) (i64.eqz (local.get 0))
      (then (i64.const 1))
      (else (i64.mul (local.get 0) (call $fac (i64.sub (local.get 0) (i64.const 1)))))))
  (func (export "fib") (param i32) (result i32)
    (local $a i32) (local $b i32) (local $t i32)
    (local.set $b (i32.const 1))
    (block $done
      (loop $l
        (br_if $done (i32.eqz (local.get 0)))
        (local.set $t (i32.add (local.get $a) (local.get $b)))
        (local.set $a (local.get $b))
        (local.set $b (local.get $t))
        (local.set 0 (i32.sub (local.get 0) (i32.const 1)))
        (br $l)))
    (local.get $a))
  (func (export "sw") (param i32) (result i32)
    (block $d (block $c (block $b (block $a
      (br_table $a $b $c $d (local.get 0)))
      (return (i32.const 10)))
      (return (i32.const 20)))
      (return (i32.const 30)))
    (i32.const 99))
  (func (export "block_params") (param i32 i32) (result i32)
    (local.get 0) (local.get 1)
    (block (param i32 i32) (result i32) (i32.sub)))
  (func (export "loop_params") (param i32) (result i32)
    ;; döngü parametreli: 0'dan n'e kadar toplam (parametre = toplam, sayaç yerelde)
    (local $i i32)
    (i32.const 0)
    (loop $l (param i32) (result i32)
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (i32.add (local.get $i))
      (br_if $l (i32.lt_u (local.get $i) (local.get 0)))))
  (func (export "select_t") (param i32) (result i32) (select (i32.const 11) (i32.const 22) (local.get 0)))
  (func (export "sel_ref") (param i32) (result i32)
    (ref.is_null (select (result funcref) (ref.null func) (ref.func $five) (local.get 0))))
  (func (export "tee") (param i32) (result i32) (local $x i32)
    (i32.add (local.tee $x (i32.mul (local.get 0) (i32.const 3))) (local.get $x)))
  (func (export "swap") (param i32 i32) (result i32 i32) (local.get 1) (local.get 0))
  (func (export "swap_sub") (param i32 i32) (result i32) (call $swap2 (local.get 0) (local.get 1)) (i32.sub))
  (func $swap2 (param i32 i32) (result i32 i32) (local.get 1) (local.get 0))
  (func (export "nested_br") (param i32) (result i32)
    (block $outer (result i32)
      (block $inner
        (br_if $inner (i32.eqz (local.get 0)))
        (br $outer (i32.const 1)))
      (i32.const 2)))
  (func (export "early_return") (param i32) (result i32)
    (if (local.get 0) (then (return (i32.const 7))))
    (i32.const 8))
  (func (export "dead_code") (result i32)
    (return (i32.const 3))
    (i32.add (i32.const 1) (i32.const 2)) (drop)
    (unreachable))
  (func (export "unreachable_trap") (unreachable))
  (func (export "div0") (param i32) (result i32) (i32.div_s (i32.const 1) (local.get 0)))
  (func (export "rec") (param i32) (result i32) (call $rec (i32.add (local.get 0) (i32.const 1))))
  (func $rec (param i32) (result i32) (call $rec (i32.add (local.get 0) (i32.const 1))))
  (func (export "spin") (loop $l (br $l)))

  ;; ---- bellek ----
  (func (export "store_load") (param i32 i32) (result i32) (i32.store (local.get 0) (local.get 1)) (i32.load (local.get 0)))
  (func (export "st64") (param i32 i64) (result i64) (i64.store (local.get 0) (local.get 1)) (i64.load (local.get 0)))
  (func (export "ld8s") (param i32) (result i32) (i32.load8_s (local.get 0)))
  (func (export "ld8u") (param i32) (result i32) (i32.load8_u (local.get 0)))
  (func (export "ld16s") (param i32) (result i32) (i32.load16_s (local.get 0)))
  (func (export "ld16u") (param i32) (result i32) (i32.load16_u (local.get 0)))
  (func (export "ld32s64") (param i32) (result i64) (i64.load32_s (local.get 0)))
  (func (export "ld32u64") (param i32) (result i64) (i64.load32_u (local.get 0)))
  (func (export "ld8s64") (param i32) (result i64) (i64.load8_s (local.get 0)))
  (func (export "st8") (param i32 i32) (i32.store8 (local.get 0) (local.get 1)))
  (func (export "st16") (param i32 i32) (i32.store16 (local.get 0) (local.get 1)))
  (func (export "stf") (param i32 f64) (result f64) (f64.store (local.get 0) (local.get 1)) (f64.load (local.get 0)))
  (func (export "stf32") (param i32 f32) (result f32) (f32.store (local.get 0) (local.get 1)) (f32.load (local.get 0)))
  (func (export "load_off") (param i32) (result i32) (i32.load offset=4 (local.get 0)))
  (func (export "size") (result i32) (memory.size))
  (func (export "grow") (param i32) (result i32) (memory.grow (local.get 0)))
  (func (export "fill") (param i32 i32 i32) (memory.fill (local.get 0) (local.get 1) (local.get 2)))
  (func (export "copy") (param i32 i32 i32) (memory.copy (local.get 0) (local.get 1) (local.get 2)))
  (func (export "init") (param i32 i32 i32) (memory.init $passive (local.get 0) (local.get 1) (local.get 2)))
  (func (export "drop_data") (data.drop $passive))

  ;; ---- tablo / dolaylı çağrı / referans ----
  (func (export "call_ind") (param i32 i32) (result i32) (call_indirect $t (type $unop) (local.get 1) (local.get 0)))
  (func (export "call_ind_bad") (param i32) (result i32) (call_indirect $t (type $binop) (i32.const 1) (i32.const 2) (local.get 0)))
  (func (export "tbl_size") (result i32) (table.size $t))
  (func (export "tbl_grow") (param i32) (result i32) (table.grow $t (ref.null func) (local.get 0)))
  (func (export "tbl_set_func") (param i32) (table.set $t (local.get 0) (ref.func $five)))
  (func (export "tbl_null") (param i32) (result i32) (ref.is_null (table.get $t (local.get 0))))
  (func (export "tbl_clear") (param i32) (table.set $t (local.get 0) (ref.null func)))
  (func (export "tbl_fill") (param i32 i32) (table.fill $t (local.get 0) (ref.func $inc) (local.get 1)))
  (func (export "tbl_copy") (param i32 i32 i32) (table.copy $t $t (local.get 0) (local.get 1) (local.get 2)))
  (func (export "tbl_init") (param i32 i32 i32) (table.init $t $pe (local.get 0) (local.get 1) (local.get 2)))
  (func (export "tbl_ext_roundtrip") (result i32)
    (table.set $t2 (i32.const 1) (ref.null extern))
    (ref.is_null (table.get $t2 (i32.const 1))))

  ;; ---- içe aktarma ----
  (func (export "use_host") (param i32 i32) (result i32) (call $host_add (local.get 0) (local.get 1)))
  (func (export "use_counter") (result i32) (i32.add (call $host_counter) (call $host_counter)))
)

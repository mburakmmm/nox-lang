# P04 — sabit-genişlikli aritmetik: taşma/daraltma `nox_int_overflow_trap(rt, ad)` çağrısına bağlanır. Leaf'te bu sembol
# YALNIZCA açıkça onaylı, tahsissiz bir "fatal sink" sağlayıcısıyla (burada harness'te: write(2)+_exit(70)) kabul edilir.
# leaf: fx_mul, fx_widen
# allow: nox_int_overflow_trap
# harness: p04_fatal_sink.c
# expect-out: ok

def fx_mul(a: u32, b: u32) -> u32:
    return a * b

def fx_widen(a: u8) -> int:
    return int(a) + 1

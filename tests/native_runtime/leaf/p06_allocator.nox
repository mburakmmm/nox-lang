# P06/P08 — bootstrap allocator spike (readiness R3): Nox ile yazılmış, runtime'sız (noxrt.o YOK) boyut-sınıflı allocator.
#  - Platform sağlayıcısı LINK ZAMANINDA sembol: rtcore_os_map / rtcore_os_unmap / rtcore_fatal (indirect çağrı YOK, döngüsel bağımlılık YOK).
#  - RuntimeState benzeri durum HAM depolamada (caller'ın verdiği 128 B sıfırlı blok): init/fini durum makinesi, kısmi-init geri alma.
#  - Debug (flags bit0): canary + double-free + ledger (canlı sayaç/bayt); OOM = 0 döner (nesne yaratılmaz); fatal = tahsissiz sink.
# Kapsam DIŞI (bilinçli): iş parçacığı güvenliği (tek sahip), ISR reentrancy, >16 B hizalama, nihai performans (bkz. native-runtime-performance.md).
# leaf: rt_init, rt_fini, rt_state_code, ra_alloc, ra_free, ra_realloc, ra_live_count, ra_live_bytes
# allow: rtcore_os_map, rtcore_os_unmap, rtcore_fatal
# harness: p06_allocator.c
# link: shim/rtcore_provider.c
# expect-out: ok
#
# Durum kelimeleri (st = ham depolama adresi, kelime indeksi): 0 durum | 1 chunk listesi | 2 bump | 3 bump_end | 4 canlı sayaç |
#   5 canlı bayt | 6 bayrak | 7 chunk sayısı | 8..15 serbest listeleri (sınıf 16,32,...,2048 B yük).
# Durumlar: 0 UNINITIALIZED | 1 BOOTSTRAP | 2 CORE_READY | 3 SHUTTING_DOWN | 4 DEAD.
# Blok: [başlık 16 B: boyut, magic][yük (16'ya yuvarlı)][debug: 16 B canary]. Chunk başlığı 32 B: [sonraki, boyut, -, -].

extern def rtcore_os_map(size: int) -> int from "rtcore_provider.o"
extern def rtcore_os_unmap(addr: int, size: int) -> None from "rtcore_provider.o"
extern def rtcore_fatal(code: int) -> None from "rtcore_provider.o"

def w_get(a: int, i: int) -> int:
    lowlevel:
        return ptr_read(ptr_offset(ptr[int](a), i))

def w_set(a: int, i: int, v: int) -> None:
    lowlevel:
        ptr_write(ptr_offset(ptr[int](a), i), v)

def cls_of(n: int) -> int:
    c: int = 0
    lim: int = 16
    while c < 8:
        if n <= lim:
            return c
        lim = lim * 2
        c = c + 1
    return -1

def cls_size(c: int) -> int:
    lim: int = 16
    i: int = 0
    while i < c:
        lim = lim * 2
        i = i + 1
    return lim

def rt_state_code(st: int) -> int:
    return w_get(st, 0)

def ra_live_count(st: int) -> int:
    return w_get(st, 4)

def ra_live_bytes(st: int) -> int:
    return w_get(st, 5)

# Başlat: 0 = tamam, -1 = zaten başlatılmış (durum DEĞİŞMEZ), -2 = platform OOM (geri alındı: durum 0, hiçbir şey tutulmaz).
def rt_init(st: int, flags: int) -> int:
    if w_get(st, 0) != 0:
        return -1
    w_set(st, 0, 1)
    chunk: int = rtcore_os_map(65536)
    if chunk == 0:
        w_set(st, 0, 0)
        return -2
    w_set(chunk, 0, 0)
    w_set(chunk, 1, 65536)
    w_set(st, 1, chunk)
    w_set(st, 2, chunk + 32)
    w_set(st, 3, chunk + 65536)
    w_set(st, 4, 0)
    w_set(st, 5, 0)
    w_set(st, 6, flags)
    w_set(st, 7, 1)
    i: int = 8
    while i < 16:
        w_set(st, i, 0)
        i = i + 1
    w_set(st, 0, 2)
    return 0

# Yık: sızıntı sayısını (canlı blok) döner; durum DEAD. Hazır değilken (çift fini / init'siz) -1.
def rt_fini(st: int) -> int:
    if w_get(st, 0) != 2:
        return -1
    w_set(st, 0, 3)
    leaked: int = w_get(st, 4)
    c: int = w_get(st, 1)
    while c != 0:
        nxt: int = w_get(c, 0)
        sz: int = w_get(c, 1)
        rtcore_os_unmap(c, sz)
        c = nxt
    w_set(st, 1, 0)
    w_set(st, 0, 4)
    return leaked

def ra_alloc(st: int, size: int, align: int) -> int:
    if w_get(st, 0) != 2:
        return 0
    if align > 16:
        rtcore_fatal(4)
        return 0
    if size < 0 or size > 1152921504606846976:
        return 0
    n: int = size
    if n == 0:
        n = 1
    pay: int = (n + 15) & -16
    extra: int = 0
    if (w_get(st, 6) & 1) != 0:
        extra = 16
    cls: int = cls_of(pay + extra)
    base: int = 0
    if cls >= 0:
        head: int = w_get(st, 8 + cls)
        if head != 0:
            w_set(st, 8 + cls, w_get(head, 2))
            base = head
        else:
            blk: int = 16 + cls_size(cls)
            bump: int = w_get(st, 2)
            if bump + blk > w_get(st, 3):
                nc: int = rtcore_os_map(65536)
                if nc == 0:
                    return 0
                w_set(nc, 0, w_get(st, 1))
                w_set(nc, 1, 65536)
                w_set(st, 1, nc)
                w_set(st, 7, w_get(st, 7) + 1)
                bump = nc + 32
                w_set(st, 3, nc + 65536)
            base = bump
            w_set(st, 2, bump + blk)
    else:
        total: int = 32 + 16 + pay + extra
        lc: int = rtcore_os_map(total)
        if lc == 0:
            return 0
        w_set(lc, 0, w_get(st, 1))
        w_set(lc, 1, total)
        w_set(st, 1, lc)
        w_set(st, 7, w_get(st, 7) + 1)
        base = lc + 32
    w_set(base, 0, size)
    w_set(base, 1, 1279347013)
    p: int = base + 16
    if extra != 0:
        w_set(p + pay, 0, 6510615555426900570)
        w_set(p + pay, 1, 6510615555426900570)
    w_set(st, 4, w_get(st, 4) + 1)
    w_set(st, 5, w_get(st, 5) + size)
    return p

def ra_free(st: int, p: int) -> None:
    if p == 0:
        return
    if w_get(st, 0) != 2:
        rtcore_fatal(5)
        return
    base: int = p - 16
    if w_get(base, 1) != 1279347013:
        rtcore_fatal(2)
        return
    size: int = w_get(base, 0)
    n: int = size
    if n == 0:
        n = 1
    pay: int = (n + 15) & -16
    extra: int = 0
    if (w_get(st, 6) & 1) != 0:
        extra = 16
        if w_get(p + pay, 0) != 6510615555426900570 or w_get(p + pay, 1) != 6510615555426900570:
            rtcore_fatal(3)
            return
    w_set(base, 1, 3735941870)
    w_set(st, 4, w_get(st, 4) - 1)
    w_set(st, 5, w_get(st, 5) - size)
    cls: int = cls_of(pay + extra)
    if cls >= 0:
        w_set(p, 0, w_get(st, 8 + cls))
        w_set(st, 8 + cls, base)
        return
    # büyük blok: kendi chunk'ı — listeden çıkar ve platforma geri ver.
    lc: int = base - 32
    prev: int = 0
    c: int = w_get(st, 1)
    while c != 0 and c != lc:
        prev = c
        c = w_get(c, 0)
    if c == 0:
        rtcore_fatal(6)
        return
    if prev == 0:
        w_set(st, 1, w_get(lc, 0))
    else:
        w_set(prev, 0, w_get(lc, 0))
    w_set(st, 7, w_get(st, 7) - 1)
    rtcore_os_unmap(lc, w_get(lc, 1))

# Başarısızlıkta ESKİ blok sahipliği korunur (0 döner, p geçerli kalır).
def ra_realloc(st: int, p: int, new_size: int) -> int:
    if p == 0:
        return ra_alloc(st, new_size, 16)
    old: int = w_get(p - 16, 0)
    q: int = ra_alloc(st, new_size, 16)
    if q == 0:
        return 0
    m: int = old
    if new_size < m:
        m = new_size
    j: int = 0
    while j * 8 < m:
        w_set(q, j, w_get(p, j))
        j = j + 1
    ra_free(st, p)
    return q

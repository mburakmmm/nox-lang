# v4 Faz C madde 2 (bkz. nox-teknik-spesifikasyon.md §3.2xx) — paylaşılan
# "dogfood" korpusu: bu dosya HEM hosted (`noxc run`, `tests/golden/
# freestanding_dogfood_test.zig`nin KENDİ hosted-karşılaştırma adımı)
# HEM GERÇEK bir x86_64 QEMU önyüklemesinde (madde 1'in genelleştirilmiş
# yardımcısı, `tests/golden/freestanding_dogfood_test.zig`) ÇALIŞTIRILIR —
# İKİSİNİN de AYNI checkpoint dizisini bastığı kanıtlanır. SADECE
# capability-siz/saf stdlib modülleri + çekirdek dil kullanılır (`nox.
# log`/`nox.http`/`nox.fs`/vb. GİBİ GERÇEK OS kaynağı gerektiren HİÇBİR
# şey YOK).

import nox.mathx
import nox.bits
import nox.mem
from nox.buffer import Buffer
from nox.binary import BinaryReader, BinaryWriter
from nox.collections import Stack, Set
import nox.console
import nox.time

print("DOGFOOD_START")

# --- çekirdek dil: list/dict/class/exceptions ---
xs: list[int] = [1, 2, 3]
xs.append(4)
d: dict[str, int] = {}
d["a"] = 1
d["b"] = 2

class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y
    def sum(self: Point) -> int:
        return self.x + self.y

p: Point = Point(3, 4)
try:
    raise ValueError("test")
except ValueError:
    pass

if len(xs) == 4 and xs[3] == 4 and d["a"] + d["b"] == 3 and p.sum() == 7:
    print("CORE_OK")

# --- nox.mathx (bkz. nox-teknik-spesifikasyon.md ilgili bölüm: `nox.math`
# ESKİ çıplak-çağrılabilir/hosted-only haline GERİ DÖNDÜRÜLDÜĞÜNDEN,
# capability-siz/freestanding-safe davranış ARTIK `nox.mathx`dedir) ---
if nox.mathx.sqrt(4.0) == 2.0 and nox.mathx.pow(2.0, 10.0) == 1024.0 and nox.mathx.floor(3.7) == 3.0 and nox.mathx.ceil(3.2) == 4.0 and nox.mathx.sin(0.0) == 0.0 and nox.mathx.cos(0.0) == 1.0:
    print("MATH_OK")

# --- nox.bits ---
if nox.bits.rotl_u8(u8(1), 1) == u8(2) and nox.bits.swap32(u32(1)) == u32(16777216) and nox.bits.test_bit(5, 0) and nox.bits.set_bit(0, 2) == 4:
    print("BITS_OK")

# --- nox.mem (ptr[T]/lowlevel:) ---
def data_ptr(raw: ptr) -> ptr:
    lowlevel:
        return ptr_add(raw, 16)

def mem_check() -> bool:
    lowlevel:
        src_buf: list[int] = [10, 20, 30]
        src: ptr[int] = ptr[int](ptr_to_int(data_ptr(detach(src_buf))))
        dst_buf: list[int] = [0, 0, 0]
        dst: ptr[int] = ptr[int](ptr_to_int(data_ptr(detach(dst_buf))))
        nox.mem.copy(dst, src, 3)
        return ptr_read(ptr_offset(dst, 0)) == 10 and ptr_read(ptr_offset(dst, 2)) == 30

if mem_check():
    print("MEM_OK")

# --- nox.buffer ---
buf: Buffer = Buffer(4)
buf.set(0, u8(42))
buf.fill(u8(1))
buf.set(0, u8(99))
if buf.len() == 4 and buf.get(0) == u8(99) and buf.get(1) == u8(1):
    print("BUFFER_OK")

# --- nox.binary ---
bbuf: Buffer = Buffer(16)
w: BinaryWriter = BinaryWriter(bbuf)
w.write_u16_le(u16(4660))
w.write_i32_be(i32(-1))
r: BinaryReader = BinaryReader(bbuf)
v1: u16 = r.read_u16_le()
v2: i32 = r.read_i32_be()
if v1 == u16(4660) and v2 == i32(-1):
    print("BINARY_OK")

# --- nox.collections ---
st: Stack[int] = Stack[int]()
st.push(1)
st.push(2)
s: Set[int] = Set[int]()
s.add(5)
s.add(5)
if st.pop() == 2 and st.pop() == 1 and s.size() == 1 and s.contains(5):
    print("COLLECTIONS_OK")

# --- nox.console (zaman damgasız, capability-siz) ---
nox.console.info("dogfood")
print(nox.console.format("DEBUG", "x"))

# --- nox.time (SADECE saf takvim aritmetiği — now_ms/sleep_ms/now/
# instant_now GERÇEKTEN saat okur, freestanding'de capability-gated,
# BU KORPUSTA KULLANILMAZ) ---
dt: nox.time.DateTime = nox.time.DateTime(2024, 3, 15, 10, 30, 0)
ms: int = dt.to_epoch_ms()
dt2: nox.time.DateTime = nox.time.from_epoch_ms(ms)
if dt2.year == 2024 and dt2.month == 3 and dt2.day == 15 and dt2.hour == 10 and dt2.minute == 30 and dt2.second == 0:
    print("TIME_OK")

# --- spawn/await/Task[T] (ÇEKİRDEK dil özelliği — bkz. nox-teknik-
# spesifikasyon.md §3.2xx, Faz C'nin BULDUĞU 3 GERÇEK hata: (1)
# `g_scheduler`/`g_current_scheduler`nin `threadlocal`ı freestanding'de
# TLS hiç kurulmadığından GERÇEK bir #GP çökmesine yol AÇIYORDU, (2)
# `moduleUsesAsync`nin `.generic_construct => true`sı HERHANGİ bir
# generic sınıf örneklemesini (yukarıdaki `Stack[int]()`/`Set[int]()`
# DAHİL) yanlışlıkla async SAYIYORDU, (3) fiber yığını İçİn HİÇBİR
# "stack provider" kayıtlı DEĞİLDİ — ÜÇÜ de düzeltildi, AŞAĞIDAKİ
# `spawn`/`await` artık GERÇEKTEN uçtan uca çalışıyor) ---
async def compute(x: int) -> int:
    return x * 2

t: Task[int] = spawn compute(21)
spawn_result: int = await t
if spawn_result == 42:
    print("SPAWN_OK")

print("DOGFOOD_END")

import nox.base64
import nox.fs
import nox.jwt
import nox.os
import nox.smtp
import nox.thread
import nox.websocket
from nox.smtp import SmtpClient, SmtpError
from nox.websocket import WebSocketClient, WebSocketError

async def add(a: int, b: int) -> int:
    return a + b

async def twice(x: int) -> int:
    return x * 2

def smtp_link() -> int:
    try:
        client: SmtpClient = nox.smtp.connect("127.0.0.1", 1, False)
        client.close()
    except SmtpError:
        return 1
    return 0

def write_code(path: str, code: int) -> None:
    if code == 0:
        nox.fs.write_string(path, "0")
    elif code == 1:
        nox.fs.write_string(path, "1")
    elif code == 2:
        nox.fs.write_string(path, "2")
    elif code == 3:
        nox.fs.write_string(path, "3")
    elif code == 4:
        nox.fs.write_string(path, "4")
    else:
        nox.fs.write_string(path, "5")

code: int = 0
if nox.base64.encode("foo") != "Zm9v":
    code = 1
if code == 0:
    token: str = nox.jwt.sign("{\"sub\":\"1234\"}", "secret")
    if nox.jwt.verify(token, "secret") != "{\"sub\":\"1234\"}":
        code = 2
if code == 0:
    summed: int = await spawn add(20, 22)
    if summed != 42:
        code = 3
if code == 0:
    handle: ThreadHandle[int] = nox.thread.start(twice, 21)
    joined: int = await handle.join()
    if joined != 42:
        code = 4
if code == 0:
    try:
        client: WebSocketClient = nox.websocket.connect("wss://ws.postman-echo.com/raw")
        sent: int = client.send_text("nox")
        got: str = client.recv()
        client.close()
        if sent < 0 or got != "nox":
            code = 5
    except WebSocketError:
        code = 5
root: str = nox.os.getenv("NOX_MOBILE_ROOT")
write_code(root + "/probe.txt", code)
print(code)

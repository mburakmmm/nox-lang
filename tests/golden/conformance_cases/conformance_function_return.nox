class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def ret_int() -> int:
    return 42

def ret_bool() -> bool:
    return True

def ret_float() -> float:
    return 3.5

def ret_str() -> str:
    return "hello"

def ret_class() -> Point:
    return Point(1, 2)

def ret_list() -> list[int]:
    return [1, 2, 3]

print(ret_int())
print(ret_bool())
print(ret_float())
print(ret_str())
print(ret_class())
print(ret_list())

async def give_int() -> int:
    return 7

async def give_bool() -> bool:
    return True

async def give_float() -> float:
    return 2.5

async def give_str() -> str:
    return "ok"

t1: Task[int] = spawn give_int()
print(await t1)
t2: Task[bool] = spawn give_bool()
print(await t2)
t3: Task[float] = spawn give_float()
print(await t3)
t4: Task[str] = spawn give_str()
print(await t4)

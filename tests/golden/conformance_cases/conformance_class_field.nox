class Bag:
    n: int
    flag: bool
    ratio: float
    label: str
    items: list[int]
    def __init__(self: Bag, n: int, flag: bool, ratio: float, label: str, items: list[int]) -> None:
        self.n = n
        self.flag = flag
        self.ratio = ratio
        self.label = label
        self.items = items

b: Bag = Bag(1, False, 0.5, "x", [1])
b.n = 2
b.flag = True
b.ratio = 1.5
b.label = "y"
b.items = [2, 3]
print(b.n)
print(b.flag)
print(b.ratio)
print(b.label)
print(b.items)

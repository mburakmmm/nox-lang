class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

ints: list[int] = [1, 2, 3]
bools: list[bool] = [True, False]
floats: list[float] = [1.5, 2.5]
strs: list[str] = ["a", "b"]
points: list[Point] = [Point(1, 1), Point(2, 2)]

print(ints)
print(bools)
print(floats)
print(strs)
print(points)

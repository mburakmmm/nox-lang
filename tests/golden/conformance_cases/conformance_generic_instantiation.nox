def identity[T](x: T) -> T:
    return x

class Box[T]:
    value: T
    def __init__(self: Box, value: T) -> None:
        self.value = value
    def get(self: Box) -> T:
        return self.value

print(identity(7))
print(identity("hello"))

b1: Box[int] = Box[int](42)
b2: Box[str] = Box[str]("nox")
print(b1.get())
print(b2.get())

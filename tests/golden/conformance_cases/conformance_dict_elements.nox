class Holder:
    def __init__(self: Holder, tags: dict[str, str]) -> None:
        self.tags = tags

d: dict[str, str] = {"greeting": "merhaba", "name": "nox"}
print(d["greeting"])
print(d["name"])

counts: dict[str, int] = {"a": 1, "b": 2}
print(counts["a"])
print(counts["b"])

h: Holder = Holder({"env": "test"})
print(h.tags["env"])

ks: list[str] = d.keys()
print(len(ks))

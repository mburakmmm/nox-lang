class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def make_closure(i: int, b: bool, f: float, s: str, lst: list[int], p: Point) -> () -> None:
    def show() -> None:
        print(i)
        print(b)
        print(f)
        print(s)
        print(lst)
        print(p)
    return show

fn: () -> None = make_closure(1, True, 1.5, "cap", [1, 2], Point(3, 4))
fn()

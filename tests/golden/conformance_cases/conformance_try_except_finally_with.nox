class Resource:
    def __init__(self: Resource, name: str) -> None:
        self.name = name

    def __enter__(self: Resource) -> str:
        print("enter " + self.name)
        return self.name

    def __exit__(self: Resource) -> None:
        print("exit " + self.name)

def risky(n: int) -> int:
    try:
        if n == 0:
            raise ValueError("zero")
        return 100 + n
    except ValueError as e:
        print("caught: " + e.message)
        return -1
    finally:
        print("finally")

print(risky(5))
print(risky(0))

with Resource("outer") as name:
    print("inside " + name)
print("after with")

def compute() -> int:
    total: int = 0
    lowlevel:
        nums: list[int] = [5, 15, 25]
        base: ptr = detach(nums)
        elem0: ptr = ptr_add(base, 16)
        elem1: ptr = ptr_add(base, 24)
        v0: int = ptr_read_int(elem0)
        v1: int = ptr_read_int(elem1)
        ptr_write_int(elem1, v1 + 1)
        v1_new: int = ptr_read_int(elem1)
        total = v0 + v1_new
    return total

print(compute())

def build_sum(n: int) -> int:
    xs: list[int] = []
    i: int = 0
    while i < n:
        xs.append(i)
        i = i + 1
    total: int = 0
    for v in xs:
        total = total + v
    return total

def compute(rounds: int) -> int:
    total: int = 0
    i: int = 0
    while i < rounds:
        total = total + build_sum(50)
        i = i + 1
    return total

print(compute(2000))

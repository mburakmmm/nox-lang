# Tamponsuz (rendezvous) kanalda 200 bin mesaj. v2.0.85: native çok-işçili havuzda üretici ve tüketici farklı işçilere oturunca iki hata vardı:
# (1) boşta işçi 1 ms'lik uykuyla bekliyordu (mesaj başına ~1 ms: program dakikalarca "takılıyordu"), (2) `Channel.recv` göndericiyi uyandırdıktan SONRA
# `slot.value` okuyordu (hızlı uyandırmada çöp/yanlış toplam). Toplam her çalıştırmada tam olmalı.
async def producer(ch: Channel[int], n: int) -> None:
    i: int = 0
    while i < n:
        await ch.send(i)
        i = i + 1

async def consumer(ch: Channel[int], n: int) -> int:
    s: int = 0
    i: int = 0
    while i < n:
        v: int = await ch.recv()
        s = s + v
        i = i + 1
    return s

ch: Channel[int] = Channel[int](0)
p: Task[None] = spawn producer(ch, 200000)
c: Task[int] = spawn consumer(ch, 200000)
total: int = await c
await p
print(total)

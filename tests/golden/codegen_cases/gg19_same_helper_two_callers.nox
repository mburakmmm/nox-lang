class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def helper(x: int) -> int:
    p: Point = Point(x, x + 1)
    return p.x + p.y

def caller_a(n: int) -> int:
    return helper(n) * 2

def caller_b(n: int) -> int:
    return helper(n) + 100

print(caller_a(5))
print(caller_b(5))
print(helper(5))

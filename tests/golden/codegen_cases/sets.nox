a: set[int] = {1, 2, 3}
b: set[int] = {3, 4}
e: set[int] = set()
print(a, b, e)
print(a | b, a & b, a - b, a ^ b)
print(3 in a, 9 in a, 9 not in a, len(a), len(e))
a.add(10)
a.discard(1)
a.remove(2)
print(a, a <= b, {3} <= b, {3, 4, 5} >= b, a == a.copy(), {1} == {2})
for x in {5, 6}:
    print(x)
w: set[str] = set(["x", "y", "x"])
print(w, sorted(w), {c for c in "hello"})
print(f"{w}", str(b), len(set([1, 1, 2])), set(range(3)))
sq: set[int] = {i * i for i in range(4)}
print(sq)
try:
    a.remove(99)
except KeyError as ex:
    print("KeyError", ex)

xs: list[int] = [3, 1, 2]
print(max(xs), min(xs), sum(xs))
print(sorted(xs, reverse=True), sorted(xs))
words: list[str] = ["bb", "a", "ccc", "dd"]
print(sorted(words, key=lambda s: len(s)))
print(sorted(words, key=lambda s: len(s), reverse=True))
print(max(words, key=lambda s: len(s)), min(words, key=lambda s: len(s)))
print(max(words), min(words))
print(any([False, True]), all([True, False]), any([False]), all([True]))
print(divmod(17, 5), divmod(-17, 5))
print(bool(0), bool(3), bool(""), bool("a"), bool(0.0), bool(True))
print(chr(65), ord("A"), chr(8364), ord("€"))
print(round(2.5), round(3.5), round(-2.5), round(0.5), round(2.675, 2), round(3.14159, 3))
print(list(range(5)), list("abc"), list([1, 2]), list({"a": 1, "b": 2}))
print(sum([1.5, 2.5]))
print(list(map(lambda v: v * 2, xs)), list(filter(lambda v: v > 1, xs)))
ws: list[int] = [5, 3, 9]
ws.sort(reverse=True)
print(ws)
names: list[str] = ["ccc", "a", "bb"]
names.sort(key=lambda s: len(s))
print(names)
print(max([1.5, 2.5]), min([4, 2, 8]))

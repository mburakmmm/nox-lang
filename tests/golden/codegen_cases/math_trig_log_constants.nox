import nox.math

# v4 Faz B madde 1 (bkz. nox-teknik-spesifikasyon.md §3.2xx): sin/cos/
# tan/log/exp/atan2 ARTIK NİTELİKLİ çağrılır (ESKİ "çıplak çağrı"
# asimetrisi ÇÖZÜLDÜ).
print(nox.math.sin(0.0))
print(nox.math.cos(0.0))
print(nox.math.tan(0.0))
print(nox.math.log(2.718281828459045))
print(nox.math.ln(2.718281828459045))
print(nox.math.exp(1.0))
print(nox.math.atan2(1.0, 1.0))
print(nox.math.pi())
print(nox.math.e())

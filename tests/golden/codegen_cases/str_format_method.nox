a: int = 7
b: float = 2.5
n: str = "bob"
print("{} and {}".format(a, n))
print("{0}-{1}-{0}".format(a, n))
print("{:>5}|{:<5}|{:^5}|".format(a, n, "x"))
print("{:.2f} {:05d} {:,}".format(b, a, 1234567))
print("{name} is {age}".format(name=n, age=a))
print("{{}} {} {{x}}".format(a))
print("no fields".format())
print("val={:8.3f}".format(3.14159))

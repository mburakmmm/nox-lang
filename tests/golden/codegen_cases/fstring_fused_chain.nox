def side(counter: list[int], v: int) -> int:
    counter.append(v)
    return v

def name_of(i: int) -> str:
    return "n" + str(i)

a: int = 7
b: int = -42
big: int = 1234567890123
zero: int = 0
s: str = "héllo"
e: str = ""
flag: bool = True
off: bool = False
f: float = 2.5
u: u8 = 200
xs: list[int] = [1, 2, 3]

print(f"{a}:{b}")
print(f"[{big}] [{zero}] [{a * b}]")
print(f"{s}-{a}-{e}-{b}")
print(f"{flag} {off} {a}")
print(f"{f} and {a} and {f * 2.0}")
print(f"{u}/{a}/{u}")
print(f"{xs} {a}")
print(f"<{a:5d}|{b:<6d}|{f:.2f}>")
print(f"{a}{b}{big}")
print(f"x{a}y{b}z")
print("{}-{}-{}".format(a, s, b))

order: list[int] = []
t: str = f"{side(order, 1)}{side(order, 2)}{side(order, 3)}"
print(t, order)

i: int = 0
total: int = 0
while i < 2000:
    line: str = f"{i}:{i * 2}:{name_of(i)}"
    total = total + len(line)
    i = i + 1
print(total)

out: str = f"{a}" + f"{b}:{big}" + "!"
print(out, len(out))
alias: str = s
print(f"{alias}{alias}{a}")
print(f"{a}{s}{b}{s}")

class P:
    def __init__(self, x: int, name: str) -> None:
        self.x = x
        self.name = name

xs: list[int] = [1, 2, 3]
words: list[str] = ["a", "b"]
d: dict[str, list[int]] = {"k": [1, 2], "m": [3]}
ps: list[P] = [P(1, "u"), P(2, "v")]
t: tuple[int, str, float] = (1, "x", 2.5)
print(str(xs), str(words), str(d))
print(f"xs={xs} words={words} d={d}")
print(repr("hi"), repr(5), repr(2.5), repr(True), repr(xs), repr([1.5, 2.0]))
print(f"{ps} {t}")
s: str = str(ps[0])
print(s + "!", len(str(xs)))
n: list[list[str]] = [["a", "b"], ["c"]]
print(str(n))
total: int = 0
for i in range(3):
    total += len(str(xs))
print(total)

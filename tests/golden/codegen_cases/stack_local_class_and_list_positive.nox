class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def compute() -> int:
    p: Point = Point(3, 4)
    xs: list[int] = [10, 20, 30, 40, 50]
    total: int = p.x + p.y
    for v in xs:
        total = total + v
    return total

print(compute())

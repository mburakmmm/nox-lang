class Vec:
    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y

    def __add__(self, o: Vec) -> Vec:
        return Vec(self.x + o.x, self.y + o.y)

    def __sub__(self, o: Vec) -> Vec:
        return Vec(self.x - o.x, self.y - o.y)

    def __mul__(self, k: int) -> Vec:
        return Vec(self.x * k, self.y * k)

    def __rmul__(self, k: int) -> Vec:
        return Vec(self.x * k, self.y * k)

    def __neg__(self) -> Vec:
        return Vec(-self.x, -self.y)

    def __eq__(self, o: Vec) -> bool:
        return self.x == o.x and self.y == o.y

    def __lt__(self, o: Vec) -> bool:
        return self.x * self.x + self.y * self.y < o.x * o.x + o.y * o.y

    def __str__(self) -> str:
        return "Vec(" + str(self.x) + ", " + str(self.y) + ")"

    def __len__(self) -> int:
        return 2

    def __getitem__(self, i: int) -> int:
        if i == 0:
            return self.x
        return self.y

    def __setitem__(self, i: int, v: int) -> None:
        if i == 0:
            self.x = v
        else:
            self.y = v

    def __contains__(self, v: int) -> bool:
        return self.x == v or self.y == v


class Flag:
    def __init__(self, on: bool) -> None:
        self.on = on

    def __bool__(self) -> bool:
        return self.on


class Plain:
    def __init__(self) -> None:
        self.n = 1


a: Vec = Vec(1, 2)
b: Vec = Vec(3, 4)
print(a + b)
print(b - a)
print(a * 3)
print(3 * a)
print(-a)
print(a == Vec(1, 2), a == b, a != b, a != Vec(1, 2))
print(a < b, a > b)
print(len(a), str(a), a[0], a[1])
a[0] = 10
print(a)
print(10 in a, 7 in a, 7 not in a)
print(f"v = {a}")
print(bool(Flag(True)), bool(Flag(False)), bool(a), bool(Plain()))
c: Vec = a + b * 2
print(c)
total: Vec = Vec(0, 0)
for i in range(3):
    total += Vec(i, i)
print(total)

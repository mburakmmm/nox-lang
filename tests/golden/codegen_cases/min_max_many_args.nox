# v2.1.170: min/max ile 3+ konumsal argüman (değişken sayıda parametreli çekirdek yardımcılar)
print(min(3, 1, 2), max(3, 9, 2, 7), min(2.5, 0.5, 1.5), max("b", "z", "a"), min(5, 4, 3, 2, 1))
print(min(1, 2), max(1, 2), max([4, 8, 6]), min([4, 8, 6]))
x: int = 7
print(max(x, 3, 12), min(x, 3, 12), max(x * 2, x + 100, 0))

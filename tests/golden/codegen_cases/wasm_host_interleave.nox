# v2.1.124 (Faz 9.2): host işlevi görevi askıya aldığında (sleep_ms) başka bir görev başka bir örneği çağırsa da her çağrı KENDİ örneğinin host işlevine gider
# (eskiden modül düzeyinde "etkin örnek yığını" bu durumda karışıyordu). Modül: (import "env" "twice" (func (param i32) (result i32))) run(x) = twice(x) + 1.
import nox.wasm
import nox.time

def make_code() -> list[int]:
    return [0, 97, 115, 109, 1, 0, 0, 0, 1, 6, 1, 96, 1, 127, 1, 127, 2, 13, 1, 3, 101, 110, 118, 5, 116, 119, 105, 99, 101, 0, 0, 3, 2, 1, 0, 7, 7, 1, 3, 114, 117, 110, 0, 1, 10, 11, 1, 9, 0, 32, 0, 16, 0, 65, 1, 106, 11]

def host_a(x: int) -> int:
    nox.time.sleep_ms(1)
    return x + 1000

def host_b(x: int) -> int:
    nox.time.sleep_ms(1)
    return x + 2000

async def run_instance(tag: int, out: Channel[int]) -> None:
    h: nox.wasm.Host = nox.wasm.host()
    if tag == 1:
        h.func1("env", "twice", host_a)
    else:
        h.func1("env", "twice", host_b)
    w: nox.wasm.Instance = h.open_bytes(make_code())
    bad: int = 0
    i: int = 0
    while i < 25:
        r: int = w.call("run", [i])
        want: int = i + 1001 if tag == 1 else i + 2001
        if r != want:
            bad = bad + 1
        i = i + 1
    w.close()
    await out.send(bad)

async def main_task() -> None:
    out: Channel[int] = Channel[int](8)
    ta: Task[None] = spawn run_instance(1, out)
    tb: Task[None] = spawn run_instance(2, out)
    tc: Task[None] = spawn run_instance(1, out)
    total: int = 0
    k: int = 0
    while k < 3:
        total = total + await out.recv()
        k = k + 1
    print(total)

mt: Task[None] = spawn main_task()
await mt

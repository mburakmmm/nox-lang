x: int = 7
name: str = "ab"
pi: float = 3.14159
big: int = 1234567
neg: int = -42
print(f"[{x:5d}] [{x:03d}] [{x:>6}] [{name:<6}] [{name:^6}] [{x:x}] [{x:b}] [{pi:8.3f}] [{big:,}]")
print(f"[{pi:.2f}] [{2.675:.2f}] [{0.5:.0f}] [{1.5:.0f}] [{2.5:.0f}] [{1e10:.2e}] [{12345.6789:g}] [{0.000012345:g}] [{1234567.0:g}]")
print(f"[{neg:+d}] [{x:+d}] [{neg:06d}] [{x:*^7}] [{255:#x}] [{255:#X}] [{255:#b}] [{255:o}]")
print(f"[{0.25:%}] [{0.256:.1%}] [{pi:10.4f}] [{pi:<10.1f}] [{pi:+.1f}] [{-pi:010.2f}]")
print(f"[{'abc':>5}] [{'abcdef':.3}] [{x:.2f}] [{True}] [{True:d}] [{pi}] [{name!s}] [{x!s:>4}]")
print(f"{big:_}, {1234.5:,.2f}, {1e6:,.0f}, {7:e}")
print(format(3.14159, ".3f"), format(42, "05d"), format("hi", ">4"))
try:
    print(f"{x:q}")
except ValueError as e:
    print("ValueError", e.message)

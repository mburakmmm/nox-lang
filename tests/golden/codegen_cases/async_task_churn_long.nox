# 300 bin art arda spawn/await: her askıya alma Asyncify'da bir swap çerçevesi sızdırıyordu (ReleaseFast'te 32 bayt/görev, 8 MiB gölge yığın = 2^18 görev sonra
# "memory access out of bounds"). Eşik aşıldıktan sonra da doğru toplamı vermelidir.
async def make_value(x: int) -> int:
    return x * 2

total: int = 0
i: int = 0
while i < 300000:
    t: Task[int] = spawn make_value(i)
    total = total + await t
    i = i + 1

print(total)

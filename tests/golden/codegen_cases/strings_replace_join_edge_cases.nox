import nox.strings

print(nox.strings.replace("aaaa", "aa", "b"))
print(nox.strings.replace("abcabc", "abc", ""))
print(nox.strings.replace("xabcx", "abc", "ZZZZ"))
print(nox.strings.replace("hello", "xyz", "q"))
print(nox.strings.replace("hello", "hello", "bye"))
print(nox.strings.replace("hello", "hello world", "bye"))
print(nox.strings.replace("abab", "ab", "ababab"))
print(nox.strings.replace("a-b-c-d", "-", "--"))
print(nox.strings.replace("", "a", "b"))
print(nox.strings.replace("abc", "", "X"))
long: str = "the quick brown fox jumps over the lazy dog the end"
print(nox.strings.replace(long, "the", "THE"))
print(len(nox.strings.replace(long, "o", "00")))

parts: list[str] = ["a", "", "ccc"]
print(nox.strings.join(parts, ","))
print(nox.strings.join(parts, ""))
empty: list[str] = []
print(len(nox.strings.join(empty, ",")))
print(nox.strings.repeat("ab", 3))
print(nox.strings.upper("MiXed 123"))
print(nox.strings.lower("MiXed 123"))

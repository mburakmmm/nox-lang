print(bx * by)
print(m["a"][1])

# döngüde sızıntı denetimli
acc: int = 0
i2: int = 0
while i2 < 2000:
    i2 = i2 + 1
    n2, l2, r2 = pair(i2)
    acc = acc + len(n2) + l2[1] + len(r2.label)
    lo2, hi2 = minmax([i2, i2 % 7, i2 % 13])
    acc = acc + lo2 + hi2
    a2: int = i2
    b2: int = i2 + 1
    a2, b2 = b2, a2
    acc = acc + a2 - b2
    for kk, vv in {"u": i2, "w": 2}.items():
        acc = acc + len(kk) + vv
    for ix, nm in enumerate(["a", "bb"]):
        acc = acc + ix + len(nm)
    sw: tuple[str, int] = swap((i2, "t" + str(i2 % 5)))
    acc = acc + len(sw[0]) + sw[1]
print(acc)

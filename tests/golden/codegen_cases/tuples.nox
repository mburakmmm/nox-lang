class Rec:
    label: str
    def __init__(self, label: str) -> None:
        self.label = label

def minmax(xs: list[int]) -> tuple[int, int]:
    lo: int = xs[0]
    hi: int = xs[0]
    for x in xs:
        if x < lo:
            lo = x
        if x > hi:
            hi = x
    return lo, hi

def pair(i: int) -> tuple[str, list[int], Rec]:
    return ("n" + str(i), [i, i + 1], Rec("r" + str(i)))

def swap(t: tuple[int, str]) -> tuple[str, int]:
    return t[1], t[0]

lo, hi = minmax([3, 1, 4, 1, 5, 9, 2, 6])
print(lo)
print(hi)

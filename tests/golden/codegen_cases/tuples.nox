class Holder:
    pos: tuple[int, int]
    def __init__(self, x: int, y: int) -> None:
        self.pos = (x, y)
h: Holder = Holder(3, 4)
hx, hy = h.pos
print(hx + hy)
h.pos = (hy, hx)
print(h.pos[0])

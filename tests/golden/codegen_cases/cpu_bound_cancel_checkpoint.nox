# nox.tasks.checkpoint()/is_cancelled(): CPU-bound bir görev ve bir iş parçacığı kooperatif olarak iptal edilir (Task.cancel / ThreadHandle.cancel).
import nox.tasks
import nox.time
import nox.thread

async def spin() -> int:
    n: int = 0
    while True:
        n += 1
        nox.tasks.checkpoint()
        if n % 200 == 0:
            nox.time.sleep_ms(0)
    return n

async def worker(x: int) -> int:
    n: int = 0
    while True:
        n += 1
        if nox.tasks.is_cancelled():
            return 42
        if n % 200 == 0:
            nox.time.sleep_ms(1)
    return 0

# Üst-düzey kod iptal edilemez: checkpoint etkisizdir.
nox.tasks.checkpoint()
print("top level ok", nox.tasks.is_cancelled())

t: Task[int] = spawn spin()
nox.time.sleep_ms(50)
t.cancel()
try:
    await t
except CancelledError as e:
    print("task cancelled")

h: ThreadHandle[int] = nox.thread.start(worker, 1)
nox.time.sleep_ms(50)
h.cancel()
print(await h.join())

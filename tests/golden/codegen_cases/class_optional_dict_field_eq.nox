# v2.1.111: Optional / dict alanlı sınıfların yapısal eşitliği, iç içe `__eq__`, Optional elemanlı listeler.
import nox.mem

class A:
    n: str | None
    def __init__(self, n: str | None) -> None:
        self.n = n

print(A(None) == A(None))
print(A("x") == A("x"))
print(A("x") == A(None), A(None) == A("x"), A("x") == A("y"))
print(A(None) != A(None), A("x") != A("x"), A("x") != A(None), A("x") != A("y"))

class Q:
    k: int
    t: int
    def __init__(self, k: int, t: int) -> None:
        self.k = k
        self.t = t
    def __eq__(self, o: Q) -> bool:
        return self.k == o.k

class M:
    i: int | None
    f: float | None
    b: bool | None
    s: str | None
    q: Q | None
    xs: list[int] | None
    d: dict[str, int] | None
    def __init__(self, i: int | None, f: float | None, b: bool | None, s: str | None, q: Q | None, xs: list[int] | None, d: dict[str, int] | None) -> None:
        self.i = i
        self.f = f
        self.b = b
        self.s = s
        self.q = q
        self.xs = xs
        self.d = d

def mk(i: int | None, s: str | None, q: Q | None, d: dict[str, int] | None) -> M:
    return M(i, 1.5, True, s, q, [1, 2], d)

e1: M = M(None, None, None, None, None, None, None)
e2: M = M(None, None, None, None, None, None, None)
print(e1 == e2, e1 != e2)
print(mk(1, "s", Q(1, 2), {"a": 1}) == mk(1, "s", Q(1, 2), {"a": 1}))
print(mk(1, "s", Q(1, 2), {"a": 1}) == mk(2, "s", Q(1, 2), {"a": 1}))
print(mk(1, "s", Q(1, 2), {"a": 1}) == mk(1, "t", Q(1, 2), {"a": 1}))
print(mk(1, "s", Q(1, 2), {"a": 1}) == mk(1, "s", Q(2, 2), {"a": 1}))
print(mk(1, "s", Q(1, 2), {"a": 1}) == mk(1, "s", Q(1, 99), {"a": 1}))
print(mk(1, "s", Q(1, 2), {"a": 1}) == mk(1, "s", Q(1, 2), {"a": 2}))
print(mk(1, "s", Q(1, 2), {"a": 1, "b": 2}) == mk(1, "s", Q(1, 2), {"b": 2, "a": 1}))
print(mk(1, "s", None, None) == mk(1, "s", None, None))
print(mk(1, "s", None, None) == mk(1, "s", Q(1, 2), None))
print(mk(1, "s", None, {"a": 1}) == mk(1, "s", None, None))
print(mk(0, None, None, None) == mk(None, None, None, None))

class W:
    q: Q
    def __init__(self, q: Q) -> None:
        self.q = q

print(W(Q(1, 2)) == W(Q(1, 3)), W(Q(1, 2)) == W(Q(2, 2)))
qs1: list[Q] = [Q(1, 2), Q(3, 4)]
qs2: list[Q] = [Q(1, 9), Q(3, 8)]
qs3: list[Q] = [Q(1, 2), Q(4, 4)]
print(qs1 == qs2, qs1 == qs3, qs1 != qs3)

class Hold:
    name: str
    tag: str | None
    def __init__(self, name: str, tag: str | None) -> None:
        self.name = name
        self.tag = tag

hs1: list[Hold] = [Hold("a", None), Hold("b", "x")]
hs2: list[Hold] = [Hold("a", None), Hold("b", "x")]
hs3: list[Hold] = [Hold("a", None), Hold("b", None)]
print(hs1 == hs2, hs1 == hs3, hs1 != hs3)

def churn(n: int) -> int:
    t: int = 0
    i: int = 0
    while i < n:
        x: M = mk(i, "s" + str(i), Q(i, 1), {"k": i})
        y: M = mk(i, "s" + str(i), Q(i, 2), {"k": i})
        hh1: list[Hold] = [Hold("a" + str(i), None), Hold("b", "x")]
        hh2: list[Hold] = [Hold("a" + str(i), None), Hold("b", "x")]
        if x == y and hh1 == hh2 and not (x != y):
            t = t + 1
        i = i + 1
    return t

nox.mem.stats()
print(churn(200))
m1: nox.mem.MemStats = nox.mem.stats()
print(churn(200))
m2: nox.mem.MemStats = nox.mem.stats()
print(m2.live - m1.live <= 1)

# Üretildi: scripts/gen_zstd_golden.py. nox.zstd açma sonuçları Python compression.zstd ile aynı özet/uzunluk.
import nox.base64
import nox.crypto
import nox.strings
import nox.zstd
from nox.zstd import ZstdError

def show(b64: str) -> None:
    try:
        raw: str = nox.zstd.decompress(nox.base64.decode(b64))
        print(nox.strings.byte_len(raw), nox.crypto.sha256(raw))
    except ZstdError as e:
        print("ZstdError")

show("KLUv/SAAAQAA")
show("KLUv/SAAAQAA")
show("KLUv/SAAAQAA")
show("KLUv/SAAAQAA")

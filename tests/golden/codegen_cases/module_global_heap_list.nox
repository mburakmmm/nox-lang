names: list[str] = []

def add_name(n: str) -> None:
    names.append(n)

def join_names() -> str:
    result: str = ""
    i: int = 0
    while i < len(names):
        result = result + names[i]
        if i < len(names) - 1:
            result = result + ","
        i = i + 1
    return result

add_name("alice")
add_name("bob")
add_name("carol")
print(join_names())

def run() -> int:
    a: list[list[int]] = []
    b: list[list[int]] = []
    i: int = 0
    while i < 3:
        ra: list[int] = []
        rb: list[int] = []
        j: int = 0
        while j < 3:
            ra.append(i * 3 + j)
            rb.append(j * 3 + i)
            j = j + 1
        a.append(ra)
        b.append(rb)
        i = i + 1
    total: int = 0
    i = 0
    while i < 3:
        j2: int = 0
        while j2 < 3:
            s: int = 0
            k: int = 0
            while k < 3:
                s = s + a[i][k] * b[k][j2]
                k = k + 1
            total = total + s
            j2 = j2 + 1
        i = i + 1
    xs: list[int] = [10, 20, 30]
    total = total + xs[2]
    total = total + xs[-1]
    p: int = 0
    t2: int = 0
    while p < 3:
        t2 = t2 + xs[p]
        p = p + 1
    return total + t2

def skip() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    while k < 0:
        x: int = a[i][k]
        k = k + 1
    return 1

def early_break() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    while i < 1:
        break
        x: int = a[i][k]
    return 42

def early_return() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    while i < 1:
        return 42
        x: int = a[i][k]
    return 0

def early_continue() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    n: int = 0
    while n < 1:
        n = n + 1
        continue
        x: int = a[i][k]
    return n

def if_return() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    while i < 1:
        if i < 1:
            return 42
        x: int = a[i][k]
    return 0

def early_raise() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    try:
        while i < 1:
            raise ValueError("stop")
            x: int = a[i][k]
    except ValueError:
        return 42
    return 0

def bump(rows: list[list[int]], step: list[int]) -> bool:
    if step[0] == 0:
        rows[0] = [7]
    else:
        rows[0] = [9]
    step[0] = step[0] + 1
    return step[0] <= 2

def cond_mutates() -> int:
    rows: list[list[int]] = [[0]]
    step: list[int] = [0]
    i: int = 0
    k: int = 0
    s: int = 0
    while bump(rows, step):
        s = s + rows[i][k]
    return s

def row_then_break() -> int:
    a: list[list[int]] = [[8]]
    i: int = 0
    k: int = 0
    s: int = 0
    while i < 2:
        s = s + a[i][k]
        break
    return s

def inner_break() -> int:
    a: list[list[int]] = [[4]]
    i: int = 0
    k: int = 0
    s: int = 0
    while i < 1:
        j: int = 0
        while j < 2:
            break
        s = a[i][k]
        i = i + 1
    return s

print(run())
print(skip())
print(early_break())
print(early_return())
print(early_continue())
print(if_return())
print(early_raise())
print(cond_mutates())
print(row_then_break())
print(inner_break())

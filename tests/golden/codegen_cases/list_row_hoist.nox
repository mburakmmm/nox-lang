def run() -> int:
    a: list[list[int]] = []
    b: list[list[int]] = []
    i: int = 0
    while i < 3:
        ra: list[int] = []
        rb: list[int] = []
        j: int = 0
        while j < 3:
            ra.append(i * 3 + j)
            rb.append(j * 3 + i)
            j = j + 1
        a.append(ra)
        b.append(rb)
        i = i + 1
    total: int = 0
    i = 0
    while i < 3:
        j2: int = 0
        while j2 < 3:
            s: int = 0
            k: int = 0
            while k < 3:
                s = s + a[i][k] * b[k][j2]
                k = k + 1
            total = total + s
            j2 = j2 + 1
        i = i + 1
    xs: list[int] = [10, 20, 30]
    total = total + xs[2]
    total = total + xs[-1]
    p: int = 0
    t2: int = 0
    while p < 3:
        t2 = t2 + xs[p]
        p = p + 1
    return total + t2

def skip() -> int:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    while k < 0:
        x: int = a[i][k]
        k = k + 1
    return 1

print(run())
print(skip())

class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def point_sum(x: int) -> int:
    p: Point = Point(x, 2)
    return p.x + p.y

def compute(n: int) -> int:
    total: int = 0
    i: int = 0
    while i < n:
        total = total + point_sum(i)
        i = i + 1
    return total

print(compute(1000))

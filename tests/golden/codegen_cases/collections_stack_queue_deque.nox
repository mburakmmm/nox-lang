from nox.collections import Stack, Queue, Deque

s: Stack[int] = Stack[int]()
s.push(1)
s.push(2)
s.push(3)
print(s.pop())
print(s.pop())
print(s.size())

q: Queue[str] = Queue[str]()
q.push("a")
q.push("b")
q.push("c")
print(q.pop())
print(q.pop())
print(q.pop())
print(q.is_empty())

d: Deque[int] = Deque[int]()
d.push_back(1)
d.push_back(2)
d.push_front(0)
print(d.pop_front())
print(d.pop_front())
print(d.pop_back())
print(d.is_empty())

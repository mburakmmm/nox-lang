# v2.1.111: `T | None` işlenenli ==/!= — None == None doğru, None ile değer eşitsiz, iki değer iç tipin eşitliğine devredilir.
import nox.mem

class P:
    k: int
    t: int
    def __init__(self, k: int, t: int) -> None:
        self.k = k
        self.t = t

class Q:
    k: int
    t: int
    def __init__(self, k: int, t: int) -> None:
        self.k = k
        self.t = t
    def __eq__(self, o: Q) -> bool:
        return self.k == o.k

def same(a: str | None, b: str | None) -> bool:
    return a == b

sn: str | None = None
sn2: str | None = None
sa: str | None = "a"
sa2: str | None = "a"
sb: str | None = "b"
print(sn == sn2, sn == sa, sa == sn, sa == sa2, sa == sb)
print(sn != sn2, sn != sa, sa != sn, sa != sa2, sa != sb)
print(same(None, None), same("x", None), same(None, "x"), same("x", "x"), same("x", "y"))
# içerik eşitliği (aynı işaretçi değil): çalışma zamanında üretilen iki ayrı dize
s1: str | None = "ab" + "c"
s2: str | None = "a" + "bc"
print(s1 == s2, s1 != s2)
# Optional ile düz T karışık
plain: str = "a"
print(sa == plain, plain == sa, sn == plain, plain == sn, sb != plain)

in1: int | None = None
in2: int | None = None
i5: int | None = 5
i5b: int | None = 5
i6: int | None = 6
print(in1 == in2, in1 == i5, i5 == in1, i5 == i5b, i5 == i6)
print(in1 != in2, in1 != i5, i5 != in1, i5 != i5b, i5 != i6)
print(i5 == 5, 5 == i5, in1 == 5, 6 == i5, i5 != 5)
z0: int | None = 0
print(z0 == in1, z0 == 0, in1 == z0)

f1: float | None = None
f2: float | None = 1.5
f3: float | None = 1.5
f4: float | None = 2.5
print(f1 == f1, f1 == f2, f2 == f1, f2 == f3, f2 == f4, f2 != f3, f2 != f4)
print(f2 == 1.5, f1 == 1.5)

b1: bool | None = None
b2: bool | None = True
b3: bool | None = True
b4: bool | None = False
print(b1 == b1, b1 == b2, b2 == b1, b2 == b3, b2 == b4, b4 == b4, b4 == b1, b2 != b4)

p1: P | None = None
p2: P | None = P(1, 2)
p3: P | None = P(1, 2)
p4: P | None = P(1, 3)
print(p1 == p1, p1 == p2, p2 == p1, p2 == p3, p2 == p4, p2 != p3, p2 != p4)

q1: Q | None = None
q2: Q | None = Q(1, 2)
q3: Q | None = Q(1, 99)
q4: Q | None = Q(2, 2)
print(q1 == q1, q1 == q2, q2 == q1, q2 == q3, q2 == q4, q2 != q3, q2 != q4)

l1: list[int] | None = None
l2: list[int] | None = [1, 2]
l3: list[int] | None = [1, 2]
l4: list[int] | None = [1, 3]
print(l1 == l1, l1 == l2, l2 == l1, l2 == l3, l2 == l4)

d1: dict[str, int] | None = None
d2: dict[str, int] | None = {"a": 1, "b": 2}
d3: dict[str, int] | None = {"b": 2, "a": 1}
d4: dict[str, int] | None = {"a": 1, "b": 3}
print(d1 == d1, d1 == d2, d2 == d1, d2 == d3, d2 == d4)

# daraltılmış işlenenler
def narrowed(x: int | None, y: int | None) -> str:
    if x is not None and y is not None:
        return str(x == y)
    if x is not None:
        return str(x == y)
    return str(y == x)
print(narrowed(1, 1), narrowed(1, 2), narrowed(3, None), narrowed(None, 3), narrowed(None, None))

# koşulda kullanım
if sa == sa2:
    print("cond-ok")
if sn != sa:
    print("cond-ne-ok")

# sızıntı: aynı eşitlikleri çok kez çalıştır, canlı blok sayısı büyümemeli
def churn(n: int) -> int:
    t: int = 0
    i: int = 0
    while i < n:
        a: str | None = "k" + str(i)
        b: str | None = "k" + str(i)
        c: int | None = i
        d: int | None = i
        e: P | None = P(i, 1)
        g: P | None = P(i, 1)
        if a == b and c == d and e == g and not (a != b) and not (c != d):
            t = t + 1
        i = i + 1
    return t

nox.mem.stats()
print(churn(300))
m1: nox.mem.MemStats = nox.mem.stats()
print(churn(300))
m2: nox.mem.MemStats = nox.mem.stats()
print(m2.live - m1.live <= 1)

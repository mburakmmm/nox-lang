# v2.1.80: `s[i] == "c"` / `s[i] != "c"` döngü içinde birleştirilir (ASCII yolunda geçici dize yok); unicode ve negatif indeks yolları aynı sonucu vermeli.
def count_char(s: str, c: str) -> int:
    n: int = 0
    for i in range(len(s)):
        if s[i] == "a":
            n = n + 1
    return n

def count_not(s: str) -> int:
    n: int = 0
    for i in range(len(s)):
        if s[i] != "a":
            n = n + 1
    return n

def count_rev(s: str) -> int:
    n: int = 0
    for i in range(len(s)):
        if "b" == s[i]:
            n = n + 1
    return n

def last_is(s: str) -> int:
    n: int = 0
    for i in range(3):
        if s[-1] == "z":
            n = n + 1
    return n

print(count_char("abcab", "a"))
print(count_char("aüaé€a", "a"))
print(count_not("abcab"))
print(count_not("aüaé€a"))
print(count_rev("abcab"))
print(count_rev("bübéb€"))
print(last_is("xyz"))
print(last_is("xyzü"))
t: str = "banana" * 3
c: int = 0
for q in range(len(t)):
    if t[q] == "a":
        c = c + 1
print(c)
u: str = "ana" + "é"
d: int = 0
for q in range(len(u)):
    if u[q] == "a":
        d = d + 1
    if u[q] != "é":
        d = d + 10
print(d)

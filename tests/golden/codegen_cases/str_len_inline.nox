# v2.1.163: len(str) ASCII için satır içi; UTF-8/bilinmeyen/boş durumlar eski yoldan doğru sayılır

def cnt(s: str) -> int:
    return len(s)

a: str = "hello"
b: str = "café"
c: str = "日本語テキスト"
d: str = ""
e: str = a + b
f: str = "x" * 5 + "é"
print(len(a), len(b), len(c), len(d), len(e), len(f))
print(cnt(a), cnt(b), cnt(c), cnt(d), cnt(e), cnt(f))
parts: list[str] = ["a", "bé", "ccc", "日本"]
tot: int = 0
for p in parts:
    tot = tot + len(p)
print(tot, len(str(12345)), len(str(-7)), len("é" + "a"), len(a.upper()), len(a[1:3]))
g: str = "abc"
g = g + "défg"
print(len(g), len(g + "ü"))
print(len(" ".join(parts)), len(a * 3), len(b * 2))

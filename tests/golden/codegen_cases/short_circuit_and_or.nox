def side(tag: str) -> bool:
    print(tag)
    return True

def side_false(tag: str) -> bool:
    print(tag)
    return False

print(False and side("and_rhs_should_not_print"))
print(True or side("or_rhs_should_not_print"))
print(True and side("and_rhs_should_print"))
print(False or side("or_rhs_should_print"))
print(True and side_false("and_rhs_merges_false"))
print(False or side_false("or_rhs_merges_false"))

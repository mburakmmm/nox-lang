protocol Greeter:
    def hello(self) -> str:
        pass

class A:
    protocol: str

    def __init__(self: A) -> None:
        self.protocol = "p1"

    def protocol_name(self: A) -> str:
        return self.protocol

class B:
    def protocol(self: B) -> str:
        return "method"

class C:
    def hello(self) -> str:
        return "hi"

def use(g: Greeter) -> str:
    return g.hello()

a: A = A()
print(a.protocol, a.protocol_name(), B().protocol(), use(C()))
protocol: int = 3
print(protocol + 1)

class P:
    def __init__(self, x: int) -> None:
        self.x = x

def s(n: int) -> str | None:
    if n > 0:
        return "a"
    return None

def p(n: int) -> P | None:
    if n > 0:
        return P(n)
    return None

def l(n: int) -> list[int] | None:
    if n > 0:
        return [n]
    return None

def fl(n: int) -> float | None:
    if n > 0:
        return 1.5
    return None

def b(n: int) -> bool | None:
    if n > 0:
        return True
    return None

print(s(1))
print(s(0))
print(p(1))
print(p(0))
print(l(1))
print(l(0))
print(fl(1))
print(fl(0))
print(b(1))
print(b(0))
x: int | None = None
print(x)

def find(xs: list[int], t: int) -> int | None:
    for x in xs:
        if x == t:
            return x
    return None

print(find([1, 2], 2))
print(find([1, 2], 9))

class Q:
    def __init__(self, name: str | None, n: int | None) -> None:
        self.name = name
        self.n = n

print(Q("a", 3))
print(Q(None, None))

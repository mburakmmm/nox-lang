# v2.0: int(<sabit-genişlikli>) (aralık-kontrollü genişletme) ve int(bool). Önceden sabit-genişlikliden düz int'e dönüş yolu yoktu.
b: u8 = u8(200)
c: u8 = u8(55)
print(int(b) + int(c), int(True), int(False) + 1)
h: u64 = u64(9)
w: i32 = i32(-5)
print(int(h) * 2, int(w) - 1)
big: u64 = u64(9223372036854775807)
print(int(big))

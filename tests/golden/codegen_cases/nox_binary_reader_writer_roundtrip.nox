from nox.buffer import Buffer
from nox.binary import BinaryReader, BinaryWriter

# v4 Faz A madde 7 (SON madde, bkz. nox-teknik-spesifikasyon.md §3.2xx):
# BinaryReader/BinaryWriter — Buffer üzerine kurulu. Tüm genişlikler
# (8/16/32/64-bit) + işaretli/işaretsiz + little/big-endian + MIN/MAX
# sınır değerleri (iki-tümleyen asimetrisi — i8/i16/i32/i64 MIN'in
# POZİTİF karşılığı YOKTUR — DAHİL) kanıtlanır.

buf: Buffer = Buffer(128)
w: BinaryWriter = BinaryWriter(buf)
w.write_u8(u8(200))
w.write_i8(i8(-5))
w.write_i8(i8(-128))
w.write_i8(i8(127))
w.write_u16_le(u16(4660))
w.write_u16_be(u16(4660))
w.write_i16_le(i16(-1))
w.write_i16_le(i16(-32768))
w.write_i16_be(i16(32767))
w.write_u32_le(u32(305419896))
w.write_u32_be(u32(305419896))
w.write_i32_le(i32(-1))
w.write_i32_le(i32(-2147483648))
w.write_i32_be(i32(2147483647))
w.write_u64_le(u64(1))
w.write_u64_be(u64(1))
w.write_i64_le(i64(-1))
w.write_i64_le(i64(-9223372036854775807) - i64(1))
w.write_i64_be(i64(9223372036854775807))

r: BinaryReader = BinaryReader(buf)
print(r.read_u8())
print(r.read_i8())
print(r.read_i8())
print(r.read_i8())
print(r.read_u16_le())
print(r.read_u16_be())
print(r.read_i16_le())
print(r.read_i16_le())
print(r.read_i16_be())
print(r.read_u32_le())
print(r.read_u32_be())
print(r.read_i32_le())
print(r.read_i32_le())
print(r.read_i32_be())
print(r.read_u64_le())
print(r.read_u64_be())
print(r.read_i64_le())
print(r.read_i64_le())
print(r.read_i64_be())
print(r.position())
print(r.remaining())

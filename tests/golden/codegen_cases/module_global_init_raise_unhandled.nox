class InitError:
    def __init__(self: InitError, code: int) -> None:
        self.code = code

def load(n: int) -> list[int]:
    xs: list[int] = [1, 2]
    if n > 0:
        raise InitError(n)
    return xs

first: int = 5
items: list[int] = load(3)
after: int = 9

def total() -> int:
    return items[0] + after

print("unreachable")
print(total())

# Faz 9.0 (v2.1.139): `@packed` (hizasız işaretçi yuvaları) ve `@repr("C")` sınıflar paylaşıma uygun — barikat yükleme/saklamaları hizasız komutlarla, erişim yine örnek kilidi altında.
@packed
class PBox:
    flag: u8
    label: str
    tags: list[str]
    n: u8
    def __init__(self: PBox) -> None:
        self.flag = u8(1)
        self.label = "p"
        self.tags = []
        self.n = u8(0)
    def set(self: PBox, s: str) -> None:
        self.label = s
        self.tags.append(s)

@repr("C")
class CBox:
    id: i32
    name: str
    def __init__(self: CBox) -> None:
        self.id = i32(7)
        self.name = "c"
    def rename(self: CBox, s: str) -> None:
        self.name = s

pb: PBox = PBox()
cb: CBox = CBox()

async def worker(id: int, out: Channel[int]) -> None:
    j: int = 0
    while j < 100:
        pb.set("w" + str(id) + "_" + str(j))
        cb.rename("n" + str(j))
        j = j + 1
    await out.send(id)

async def main_task() -> None:
    out: Channel[int] = Channel[int](16)
    k: int = 0
    while k < 6:
        t: Task[None] = spawn worker(k, out)
        k = k + 1
    s: int = 0
    k = 0
    while k < 6:
        s = s + await out.recv()
        k = k + 1
    print(s)
    print(len(pb.tags))
    print(len(pb.label) > 0)
    print(len(cb.name) > 0)

mt: Task[None] = spawn main_task()
await mt

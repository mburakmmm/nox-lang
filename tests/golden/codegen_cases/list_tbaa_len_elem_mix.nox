# v2.1.82: LLVM TBAA (liste uzunluğu / liste elemanı etiketleri) — eleman yazımı ve uzunluk değiştiren işlemler (append/pop/extend/sort) iç içe döngülerde
# birbirine karışsa da sonuç Python ile aynı olmalı (LLVM yanlış önbelleğe alma/birleştirme yapmamalı).
def churn(n: int) -> int:
    xs: list[int] = []
    t: int = 0
    i: int = 0
    while i < n:
        xs.append(i * 3)
        if i % 4 == 3:
            xs.pop()
        j: int = len(xs) - 1
        while j >= 0:
            xs[j] = xs[j] + 1
            t = t + xs[j]
            j = j - 1
        i = i + 1
    return t + len(xs)

def swap_sort(n: int) -> int:
    a: list[int] = []
    s: int = 7
    for q in range(n):
        s = (s * 31 + 17) % 1009
        a.append(s)
    i: int = 1
    while i < len(a):
        v: int = a[i]
        j: int = i - 1
        while j >= 0 and a[j] > v:
            a[j + 1] = a[j]
            j = j - 1
        a[j + 1] = v
        i = i + 1
    return a[0] * 1000000 + a[len(a) // 2] * 1000 + a[len(a) - 1]

def strings(n: int) -> str:
    ws: list[str] = []
    for q in range(n):
        ws.append("w" + str(q))
    k: int = 0
    while k < len(ws):
        ws[k] = ws[k] + "!"
        k = k + 1
    ws[-1] = "last"
    return ",".join(ws)

def nested(n: int) -> int:
    g: list[list[int]] = []
    for r in range(n):
        row: list[int] = []
        for c in range(n):
            row.append(r * n + c)
        g.append(row)
    t: int = 0
    r2: int = 0
    while r2 < n:
        c2: int = 0
        while c2 < n:
            g[r2][c2] = g[r2][c2] * 2
            t = t + g[r2][c2]
            c2 = c2 + 1
        r2 = r2 + 1
    g[0].append(99)
    return t + len(g[0]) * 1000

def grow_inside(n: int) -> int:
    xs: list[int] = [1, 2, 3]
    t: int = 0
    k: int = 0
    while k < n:
        xs.append(k)
        xs[0] = xs[0] + len(xs)
        t = t + xs[0] + xs[len(xs) - 1]
        k = k + 1
    return t

def oob(n: int) -> int:
    xs: list[int] = [1, 2, 3]
    hit: int = 0
    k: int = 0
    while k < n:
        try:
            xs[len(xs)] = 5
        except IndexError:
            hit = hit + 1
        xs.pop()
        try:
            hit = hit + xs[2]
        except IndexError:
            hit = hit + 10
        xs.append(k)
        xs.append(k)
        k = k + 1
    return hit

print(churn(40))
print(swap_sort(300))
print(strings(6))
print(nested(7))
print(grow_inside(50))
print(oob(5))

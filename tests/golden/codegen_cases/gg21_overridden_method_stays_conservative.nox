sink: list[list[int]] = []

class Helper:
    def __init__(self: Helper) -> None:
        self.n = 0
    def peek(self: Helper, xs: list[int]) -> int:
        return xs[0]

class SubHelper(Helper):
    def peek(self: SubHelper, xs: list[int]) -> int:
        sink.append(xs)
        return xs[0]

def compute(h: Helper) -> int:
    xs: list[int] = [1, 2, 3]
    return h.peek(xs)

print(compute(Helper()))

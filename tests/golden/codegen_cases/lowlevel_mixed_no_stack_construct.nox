class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def compute(n: int) -> int:
    total: int = 0
    i: int = 0
    while i < n:
        lowlevel:
            p: Point = Point(i, i + 1)
            a: int = i
            b: int = i * 2
            c: int = i * 3
            nums: list[int] = [a, b, c]
            j: int = 0
            inner: int = 0
            while j < 3:
                inner = inner + nums[j]
                j = j + 1
            total = total + p.x + p.y + inner
        i = i + 1
    return total

print(compute(1000))

def sum_rows(grid: list[list[int]], r: int, n: int) -> int:
    total: int = 0
    k: int = 0
    while k < n:
        total = total + grid[r][k]
        k = k + 1
    return total

def run(grid: list[list[int]], r: int, n: int) -> int:
    names: list[str] = ["a", "b"]
    return sum_rows(grid, r, n) + len(names)

g: list[list[int]] = [[1, 2, 3], [4, 5, 6]]

print(run(g, 1, 3))

try:
    print(run(g, 5, 3))
except IndexError as e:
    print("dis: " + e.message)

try:
    print(run(g, 0, 4))
except IndexError as e2:
    print("ic: " + e2.message)

i: int = 0
caught: int = 0
while i < 3:
    try:
        print(run(g, i, 3))
    except IndexError as e3:
        caught = caught + 1
    i = i + 1
print(caught)

def f(tag: str) -> int:
    print("eval", tag)
    return len(tag)

class K:
    v: int

    def __init__(self, a: int, b: int) -> None:
        self.v = a * 10 + b

    def m(self, a: int, b: int, c: int = 7) -> int:
        return a * 100 + b * 10 + c

def h(a: int, b: int) -> int:
    return a * 10 + b

print(h(b=f("bb"), a=f("a")))
print(h(a=f("x"), b=f("yyy")))
k: K = K(b=f("kb"), a=f("k"))
print(k.v)
print(k.m(b=f("mb"), a=f("m1")))
print(k.m(c=f("c"), a=f("a1"), b=f("b11")))
print(h(1, b=f("pos")))

class D(K):
    def __init__(self) -> None:
        super().__init__(b=f("sb"), a=f("s"))
d: D = D()
print(d.v)

x: u8 = 200
y: u8 = 55
z: u8 = x + y
print(z)

a: i8 = -100
b: i8 = -20
c: i8 = a - b
print(c)

big: u64 = 9223372036854775807
print(big)

s: isize = -1
print(s)

xs: list[u8] = [u8(10), u8(20), u8(30)]
xs[1] = u8(99)
for e in xs:
    print(e)
print(xs)

narrowed: u8 = u8(200)
print(narrowed)
widened: i32 = i32(a)
print(widened)

cmp_a: u32 = 4000000000
cmp_b: u32 = 100
print(cmp_a > cmp_b)

def need(x: int) -> int:
    v: int | None = x
    if v is None:
        raise ValueError("none")
    return v

def pick(x: float) -> float:
    v: float | None = x
    if v is not None:
        return v
    return 0.0

def flag(b: bool) -> bool:
    v: bool | None = b
    if v is None:
        return False
    return v

total: int = 0
for i in range(100):
    total += need(i)
print(total, pick(1.5), flag(True), flag(False))

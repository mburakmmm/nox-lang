class Base:
    def __init__(self: Base, n: int) -> None:
        self.n = n

    def compute(self: Base) -> int:
        return self.n * 2

class Derived(Base):
    def compute(self: Derived) -> int:
        return super().compute() + 1

d: Derived = Derived(10)
print(d.compute())

b: Base = d
print(b.compute())

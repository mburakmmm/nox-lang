def run() -> None:
    n: int = 10
    a: list[int] = [i * 2 for i in range(n)]
    b: list[int] = [i for i in range(3, 8)]
    c: list[int] = [i for i in range(5, 2)]
    d: list[float] = [float(i) / 2.0 for i in range(4)]
    s: list[str] = [str(i) for i in range(3)]
    e: list[bool] = [i % 2 == 0 for i in range(5)]
    xs: list[int] = [4, 5, 6]
    f: list[int] = [v + 1 for v in xs]
    g: list[int] = [v for v in xs if v > 4]
    h: list[int] = [i * j for i in range(3) for j in range(3)]
    print(a, b, c, d, s, e, f, g, h)
    big: list[int] = [i for i in range(1000)]
    print(len(big), big[999], sum(big))
    z: list[int] = list(range(0))
    print(z, list(range(5)), len([0 for _ in range(100000)]))
run()

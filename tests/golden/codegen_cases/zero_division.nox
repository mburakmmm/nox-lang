def safe_div(a: int, b: int) -> int:
    try:
        return a // b
    except ZeroDivisionError as e:
        print("zde", e.message)
        return -1

def safe_mod(a: int, b: int) -> int:
    try:
        return a % b
    except Exception as e:
        print("exc", e.message)
        return -1

print(safe_div(7, 2), safe_div(-7, 2), safe_div(5, 0))
print(safe_mod(7, 3), safe_mod(-7, 3), safe_mod(5, 0))
z: int = 0

import nox.ip
from nox.ip import IpAddress

# Çapraz doğrulama: beklenen çıktı Python `ipaddress` ile üretildi (belgelenen sapmalar: çok-yayın global sayılmaz, NAT64 gömülü IPv4'e göre sınıflanır).

import nox.json

v: JsonValue = nox.json.parse("{\"a\":1,\"b\":[1,2,3],\"c\":{\"x\":true,\"y\":null}}")
print(nox.json.dump_pretty(v, 2))

empty_arr: JsonValue = nox.json.parse("[]")
print(nox.json.dump_pretty(empty_arr, 2))

empty_obj: JsonValue = nox.json.parse("{}")
print(nox.json.dump_pretty(empty_obj, 4))

scalar: JsonValue = nox.json.parse("42")
print(nox.json.dump_pretty(scalar, 2))

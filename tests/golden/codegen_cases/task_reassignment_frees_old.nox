import nox.time

async def worker(n: int) -> None:
    if n == 2:
        # M:N havuzunda iki gorevin yazdirma sirasi garanti degildir; ikincisi gec yazdirir
        nox.time.sleep_ms(100)
    print(n)

async def main_task() -> None:
    t: Task[None] = spawn worker(1)
    t = spawn worker(2)
    await t

t2: Task[None] = spawn main_task()
await t2

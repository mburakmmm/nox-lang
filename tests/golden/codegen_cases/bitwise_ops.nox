x: int = 12
y: int = 10
print(x & y)
print(x | y)
print(x ^ y)
print(~x)
print(x << 2)
print(x >> 2)
print(-8 >> 1)

a: u8 = u8(200)
b: u8 = u8(15)
print(a & b)
print(a | b)
print(a ^ b)
print(~a)
print(a << 2)

s: i8 = i8(-4)
print(s >> 1)
print(~s)

flag: bool = True
print(flag & False)
print(flag | False)

def shift_amount(n: int) -> int:
    try:
        result: int = 1 << n
        return result
    except ValueError as e:
        print(e.message)
        return -1

print(shift_amount(3))
print(shift_amount(-1))
print(shift_amount(64))

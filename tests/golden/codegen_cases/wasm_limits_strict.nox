# 2.3 madde 5.6: nox.wasm `Limits` kotaları — sıkı hazır ayar (strict_limits) sonsuz döngüyü yakıtla keser, bellek büyütmeyi reddeder, yakalanan çıktıyı sınırlar.
# Modül: (memory 1) spin = loop{br 0}; grow(n) = memory.grow(n)
import nox.wasm
from nox.wasm import WasmError

code: list[int] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 9, 2, 96, 0, 0, 96, 1, 127, 1, 127, 3, 3, 2, 0, 1, 5, 3, 1, 0, 1, 7, 15, 2, 4, 115, 112, 105, 110, 0, 0, 4, 103, 114, 111, 119, 0, 1, 10, 16, 2, 7, 0, 3, 64, 12, 0, 11, 11, 6, 0, 32, 0, 64, 0, 11]
wcode: list[int] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 16, 3, 96, 4, 127, 127, 127, 127, 1, 127, 96, 1, 127, 0, 96, 0, 0, 2, 70, 2, 22, 119, 97, 115, 105, 95, 115, 110, 97, 112, 115, 104, 111, 116, 95, 112, 114, 101, 118, 105, 101, 119, 49, 8, 102, 100, 95, 119, 114, 105, 116, 101, 0, 0, 22, 119, 97, 115, 105, 95, 115, 110, 97, 112, 115, 104, 111, 116, 95, 112, 114, 101, 118, 105, 101, 119, 49, 9, 112, 114, 111, 99, 95, 101, 120, 105, 116, 0, 1, 3, 2, 1, 2, 5, 3, 1, 0, 1, 7, 19, 2, 6, 95, 115, 116, 97, 114, 116, 0, 2, 6, 109, 101, 109, 111, 114, 121, 2, 0, 10, 19, 1, 17, 0, 65, 1, 65, 0, 65, 1, 65, 20, 16, 0, 26, 65, 7, 16, 1, 11, 11, 17, 1, 0, 65, 0, 11, 11, 8, 0, 0, 0, 3, 0, 0, 0, 104, 105, 10]

# Varsayılan kotalarda büyütme başarılı (eski boyut = 1 sayfa döner)
w0: nox.wasm.Instance = nox.wasm.from_bytes_limited(code, nox.wasm.default_limits())
print(w0.call("grow", [100]))
w0.close()

# Sıkı ayar: 256 sayfa tavanı — 100 sayfa tamam, 300 sayfa reddedilir (-1)
w1: nox.wasm.Instance = nox.wasm.from_bytes_limited(code, nox.wasm.strict_limits())
print(w1.call("grow", [100]))
print(w1.call("grow", [300]))
w1.close()

# Küçük yakıt sonsuz döngüyü keser; WasmError olur
lim: nox.wasm.Limits = nox.wasm.default_limits()
lim.fuel = 10000
w2: nox.wasm.Instance = nox.wasm.from_bytes_limited(code, lim)
try:
    w2.call("spin", [])
except WasmError:
    print("fuel exhausted caught")
w2.close()

# Sıkı ayar da sonsuz döngüyü (100 milyon yakıtla) keser
w3: nox.wasm.Instance = nox.wasm.from_bytes_limited(code, nox.wasm.strict_limits())
try:
    w3.call("spin", [])
except WasmError:
    print("strict fuel caught")
w3.close()

# Çağrı derinliği kotası geçerli değerle açılır
lim2: nox.wasm.Limits = nox.wasm.strict_limits()
lim2.max_depth = 64
w4: nox.wasm.Instance = nox.wasm.from_bytes_limited(code, lim2)
print(w4.call("grow", [1]))
w4.close()

# Yakalanan çıktı tavanı: varsayılan "hi\n" yakalar, 2 baytlık tavan yazmayı ENOSPC ile reddeder
h: nox.wasm.Host = nox.wasm.host()
args: list[str] = ["prog"]
h.enable_wasi(args)
a: nox.wasm.Instance = h.open_bytes(wcode)
a.run_start()
print(a.stdout() == "hi\n")
a.close()
small: nox.wasm.Limits = nox.wasm.default_limits()
small.max_output = 2
b: nox.wasm.Instance = h.open_bytes_limited(wcode, small)
b.run_start()
print(b.stdout() == "")
b.close()

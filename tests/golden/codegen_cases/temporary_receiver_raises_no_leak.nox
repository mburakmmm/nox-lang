class BoomError:
    def __init__(self: BoomError, message: str) -> None:
        self.message = message

class Box:
    items: list[str]
    def __init__(self: Box, seed: str) -> None:
        self.items = [seed]

    def boom(self: Box) -> int:
        raise BoomError("bum")

try:
    x: int = Box("hello").boom()
except BoomError:
    print("BoomError yakalandi (gecici alici sizmadan)")

ys: list[int] = []
try:
    v: int = ys.pop()
except IndexError:
    print("IndexError yakalandi (yerel liste)")

def make_empty() -> list[int]:
    xs: list[int] = []
    return xs

try:
    w: int = make_empty().pop()
except IndexError:
    print("IndexError yakalandi (gecici liste sizmadan)")

def make_temp_arg() -> str:
    s: str = "gecici"
    return s

def boom_free(x: str) -> int:
    raise BoomError("bum")

try:
    r1: int = boom_free(make_temp_arg())
except BoomError:
    print("BoomError yakalandi (serbest fonksiyon, gecici arguman)")

fn: (str) -> int = boom_free
try:
    r2: int = fn(make_temp_arg())
except BoomError:
    print("BoomError yakalandi (dolayli closure cagrisi, gecici arguman)")

class Bad:
    def __init__(self: Bad, seed: str) -> None:
        raise BoomError("init basarisiz")

try:
    b: Bad = Bad(make_temp_arg())
except BoomError:
    print("BoomError yakalandi (__init__ raise, gecici arguman)")

class BadWithField:
    items: list[str]
    def __init__(self: BadWithField, seed: str) -> None:
        self.items = [seed]
        raise BoomError("init basarisiz (alan atandiktan sonra)")

try:
    bf: BadWithField = BadWithField(make_temp_arg())
except BoomError:
    print("BoomError yakalandi (__init__ raise, alan atandiktan sonra)")

def make_list3() -> list[int]:
    return [1, 2, 3]

try:
    oob1: int = make_list3()[99]
except IndexError:
    print("IndexError yakalandi (gecici liste indeksleme sizmadan)")

def make_str3() -> str:
    return "abc"

try:
    oob2: str = make_str3()[99]
except IndexError:
    print("IndexError yakalandi (gecici str indeksleme sizmadan)")

try:
    make_list3()[99] = 5
except IndexError:
    print("IndexError yakalandi (gecici listeye indeksle atama sizmadan)")

def make_dict3() -> dict[str, int]:
    d: dict[str, int] = {}
    d["a"] = 1
    return d

try:
    oob3: int = make_dict3()["eksik"]
except KeyError:
    print("KeyError yakalandi (gecici sozluk anahtari sizmadan)")

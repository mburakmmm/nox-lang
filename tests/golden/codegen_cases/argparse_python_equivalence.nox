# Üretildi: scripts/gen_argparse_golden.py. nox.argparse, Python argparse (parse_intermixed_args) ile aynı sonucu vermeli.
import nox.argparse
from nox.argparse import ArgumentParser, Namespace, ArgumentError

p: ArgumentParser = ArgumentParser("tool")
p.add_flag("-v", "--verbose")
p.add_option("-o", "--output", "out.txt")
p.add_int_option("-n", "--count", 1)
p.add_multi_option("-I", "--include")
p.add_positional("file")
p.add_rest("more")

def show(args: list[str]) -> None:
    try:
        ns: Namespace = p.parse(args)
        print(ns.flag("verbose"), ns.get_str("output"), ns.get_int("count"), ns.get_list("include"), ns.get_str("file"), ns.get_list("more"))
    except ArgumentError as e:
        print("ERROR")

show(["in.txt"])
show(["in.txt", "-vv"])
show(["-vofile", "-o", "-7", "-vn", "4", "-I", "d1", "-vv", "in.txt"])
show(["-n3", "e1", "in.txt", "--", "-weird", "e3"])
show(["--include=d4", "in.txt"])
show(["-o", "-7", "-o", "x", "in.txt", "-n", "5"])
show(["--output", "z", "in.txt", "-vv", "--output", "z", "-I", "d1", "--count=7"])
show(["-vn", "in.txt", "4", "--output", "z", "--include=d4", "--include=d4"])

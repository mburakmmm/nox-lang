# v2.0: int ** int tam sayı üs almadır — 64-bit sarmalı, iki backend'de BİREBİR aynı (önceden pow() ile kesinlik kaybı + backend farkı).
print(3 ** 39, 3 ** 40, 10 ** 19, 2 ** 62, 2 ** 63, 2 ** 64)
print(2 ** 10, 0 ** 0, (-2) ** 3, 7 ** 0)
e: int = -2
base: int = 2
print(base ** e, (-1) ** -3, 1 ** -5)
print(2.0 ** -1, 2 ** 0.5)
zero: int = 0
try:
    print(zero ** -1)
except ZeroDivisionError:
    print("zero")

# Üretildi: scripts/gen_glob_golden.py. nox.glob, Python glob.glob(root_dir=..., recursive=True) ile aynı sonucu vermeli (sıralı).
import nox.fs
import nox.tempfile
from nox.tempfile import mkdtemp
from nox.glob import glob

root: str = mkdtemp("nox-glob-")
nox.fs.create_dir_all(root + "/a")
nox.fs.write_string(root + "/a/x.txt", "x")
nox.fs.create_dir_all(root + "/a")
nox.fs.write_string(root + "/a/y.py", "x")
nox.fs.create_dir_all(root + "/a/b")
nox.fs.write_string(root + "/a/b/z.txt", "x")
nox.fs.create_dir_all(root + "/a/b/c")
nox.fs.write_string(root + "/a/b/c/w.txt", "x")
nox.fs.create_dir_all(root + "/a/b/c")
nox.fs.write_string(root + "/a/b/c/v.py", "x")
nox.fs.create_dir_all(root + "/a")
nox.fs.write_string(root + "/a/.h", "x")
nox.fs.create_dir_all(root + "/a/.hid")
nox.fs.write_string(root + "/a/.hid/q.txt", "x")
nox.fs.write_string(root + "/top.txt", "x")
nox.fs.write_string(root + "/.dot", "x")
nox.fs.write_string(root + "/readme.md", "x")
nox.fs.write_string(root + "/x y.txt", "x")
nox.fs.create_dir_all(root + "/a/b/.secret")
nox.fs.write_string(root + "/a/b/.secret/s.txt", "x")
nox.fs.create_dir_all(root + "/e1/e2")
nox.fs.write_string(root + "/e1/e2/leaf.txt", "x")
nox.fs.create_dir_all(root + "/d")
nox.fs.create_dir_all(root + "/empty/inner")

def show(pattern: str) -> None:
    print(pattern, glob(pattern, root, True))

show("*")
show("*.txt")
show("a/*")
show("a/*.py")
show("a/*/")
show("a/b/*")
show("a/b/c/*")
show("*/*")
show("*/*/*")
show("?")
show("??")
show("[a-d]*")
show("[!a]*")
show("a/?.txt")
show(".*")
show("a/.*")
show("*.md")
show("x*")
show("nope")
show("nope/*")
show("a")
show("a/")
show("a/x.txt")
show("a/nope.txt")
show("top.txt")
show("*/")
show("a/b")
show("e1/*/*.txt")
show("e*/*/leaf.txt")
show("[ae]*/*")
show("a/[xy].*")
show("a/*.[tp][xy]*")
show("**")
show("**/")
show("**/*.txt")
show("a/**")
show("a/**/")
show("a/**/*.txt")
show("**/z.txt")
show("**/c/*")
show("a/**/c/*.py")
show("**/*")
show("**/.h")
show("**/*.py")
show("e1/**")
show("**/leaf.txt")
show("a/b/**")
show("*/**/*.txt")
show(".dot")
show("./top.txt")
show("a/./x.txt")

nox.fs.remove_dir_all(root)

# v2.0: `spawn f(x)` deyim olarak (ateşle-ve-unut): Task tutamacı artık sızmaz (DebugAllocator sızıntı raporu boş kalmalı) ve kanal üzerinden sonuç toplama deseni.
async def worker(ch: Channel[int], n: int) -> None:
    await ch.send(n * n)
async def run() -> None:
    ch: Channel[int] = Channel[int](4)
    for i in range(4):
        spawn worker(ch, i)
    total: int = 0
    for i in range(4):
        total += await ch.recv()
    print("total", total)
t0: Task[None] = spawn run()
await t0

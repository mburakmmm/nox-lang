# Ember NL-008: nox.signal — bayrak-kuran işleyici, take/pending/wait; wait kooperatiftir (killer görevi 40 ms sonra sinyal gönderir).
import nox.signal
import nox.time

s: int = nox.signal.sigusr1()
print(nox.signal.install(s))
print(nox.signal.pending(s))
print(nox.signal.send_self(s))
print(nox.signal.pending(s))
print(nox.signal.take(s), nox.signal.take(s))

async def killer(sig: int) -> None:
    nox.time.sleep_ms(40)
    nox.signal.send_self(sig)

# 2.3 madde 1.7 regresyonu: `run` modül-global `s`yi DOĞRUDAN okur. `$main_body` eskiden çalınabilir bir görev olarak başlatılıyordu; bir işçi onu çalarsa modül-global ilklendirme
# slot 0'ın yerine o işçinin bloğuna yazılır, slot 0'da çalışan `run` ise `s`yi 0/ilklenmemiş okurdu (ağır CPU yarışında ~%0,07). Artık `$main_body` slot 0'a sabitlenir
# (`scripts/globals_race_stress.sh` yarışı yük altında yineler).
async def run() -> None:
    k: Task[None] = spawn killer(s)
    print(nox.signal.wait(s, 20000))
    print(nox.signal.wait(s, 30))
    await k

m: Task[None] = spawn run()
await m

# Ember NL-008: nox.signal — bayrak-kuran işleyici, take/pending/wait; wait kooperatiftir (killer görevi 40 ms sonra sinyal gönderir).
import nox.signal
import nox.time

s: int = nox.signal.sigusr1()
print(nox.signal.install(s))
print(nox.signal.pending(s))
print(nox.signal.send_self(s))
print(nox.signal.pending(s))
print(nox.signal.take(s), nox.signal.take(s))

async def killer(sig: int) -> None:
    nox.time.sleep_ms(40)
    nox.signal.send_self(sig)

# Sinyal numarası `run`a PARAMETRE olarak verilir: çalınan bir fiber modül-global `s`yi okursa bu, başka bir işçinin modül-global kopyasını okur; ağır CPU yarışında o kopyanın henüz
# ilklenmemiş (Debug'da 0xAA) olduğu bir koşu gözlendi (project/v2-3-yapilacaklar 1.7). Fixture bu belirsiz yoldan bağımsız kalır.
async def run(sig: int) -> None:
    k: Task[None] = spawn killer(sig)
    print(nox.signal.wait(sig, 20000))
    print(nox.signal.wait(sig, 30))
    await k

m: Task[None] = spawn run(s)
await m

import nox.json
import nox.csv

v: JsonValue = nox.json.decode("{\"a\": 1}")
print(nox.json.encode(v))
print(nox.json.encode_pretty(v, 2))

rows: list[list[str]] = [["a", "b"], ["c", "d"]]
print(nox.csv.write(rows))
print(nox.csv.write_row(["x", "y"]))


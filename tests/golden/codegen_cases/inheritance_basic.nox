class Animal:
    def __init__(self: Animal, name: str) -> None:
        self.name = name

    def speak(self: Animal) -> str:
        return self.name + " makes a sound"

class Dog(Animal):
    def __init__(self: Dog, name: str, breed: str) -> None:
        super().__init__(name)
        self.breed = breed

    def speak(self: Dog) -> str:
        return self.name + " barks (" + self.breed + ")"

d: Dog = Dog("Rex", "Labrador")
print(d.speak())
print(d.name)
print(d.breed)

a: Animal = Animal("Generic")
print(a.speak())

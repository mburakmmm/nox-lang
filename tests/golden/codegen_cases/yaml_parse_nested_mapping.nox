import nox.yaml

text: str = "a:\n  x: 1\n  b:\n    y: 2\n    c:\n      z: 3\n"
root: nox.yaml.YamlValue = nox.yaml.parse(text)
a: nox.yaml.YamlValue = root.mapping["a"]
b: nox.yaml.YamlValue = a.mapping["b"]
c: nox.yaml.YamlValue = b.mapping["c"]
print(a.mapping["x"].i)
print(b.mapping["y"].i)
print(c.mapping["z"].i)

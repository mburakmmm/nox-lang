# Faz 9.0 F3a (v2.1.132): DİNAMİK paylaşım — skaler elemanlı `list[int]` alanı olan modül düzeyi sınıf örneği. `append` alan yuvasına geri yazar: örnek kilidi altında yapılır (paylaşılan
# bloğun büyümesi hep kopyalama yoluna düşer, okuyucular eski bloğu tutar); alanın yeniden atanması yeni bloğu yayımlar, eskiyi kilit dışında bırakır. Sızıntı/çift bırakma DebugAllocator ile yakalanır.
class Bag:
    items: list[int]
    scratch: list[int]
    hits: int
    def __init__(self: Bag) -> None:
        self.items = []
        self.scratch = []
        self.hits = 0
    def put(self: Bag, v: int) -> None:
        self.items.append(v)
    def churn(self: Bag, j: int) -> None:
        self.scratch = [j, j + 1, j + 2]
        self.scratch.append(j)
    def peek(self: Bag) -> int:
        n: int = len(self.scratch)
        if n > 0:
            return self.scratch[0]
        return 0

bag: Bag = Bag()

async def worker(id: int, out: Channel[int]) -> None:
    acc: int = 0
    j: int = 0
    while j < 200:
        bag.put(j)
        bag.churn(j)
        acc = acc + bag.peek() % 3
        if len(bag.items) > 0:
            acc = acc + bag.items[0] % 2
        k: int = 0
        while k < 200:
            acc = (acc * 31 + k + j + id) % 1000003
            k = k + 1
        j = j + 1
    await out.send(acc)

async def main_task() -> None:
    out: Channel[int] = Channel[int](16)
    k: int = 0
    while k < 6:
        t: Task[None] = spawn worker(k, out)
        k = k + 1
    s: int = 0
    k = 0
    while k < 6:
        s = s + await out.recv()
        k = k + 1
    print(s < 1000000000)
    print(len(bag.items))
    total: int = 0
    for v in bag.items:
        total = total + v
    print(total)
    print(len(bag.scratch) >= 3)

mt: Task[None] = spawn main_task()
await mt

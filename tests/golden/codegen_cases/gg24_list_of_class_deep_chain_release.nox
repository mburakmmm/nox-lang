# GG.24: `genListElemRelease`nin sınıf-dispatch dalını (`list[Node]`nin
# ELEMANLARININ KENDİ derin zincirleri OLABİLİR) egzersiz eder — TEK
# elemanlı bir liste, AMA o TEK eleman eşiğin (200) ÇOK ÜZERİNDE bir
# zincirin BAŞIDIR.
class Node:
    next: Node | None
    def __init__(self, next: Node | None) -> None:
        self.next = next

def run() -> None:
    head: Node | None = None
    i: int = 0
    while i < 2000:
        head = Node(head)
        i = i + 1
    if head != None:
        items: list[Node] = [head]
        items = []
    print("tamamlandi")

run()

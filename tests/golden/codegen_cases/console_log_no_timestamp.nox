# v4 Faz B (bkz. nox-teknik-spesifikasyon.md §3.2xx): `nox.console` —
# `nox.log` İLE AYNI biçim, AMA zaman damgası YOK — çıktı (nox.log'un
# AKSİNE) TAM eşleşmeyle test edilebilir (deterministik).
import nox.console

nox.console.debug("starting up")
nox.console.info("all good")
nox.console.warn("careful")
nox.console.error("boom")
print(nox.console.format("DEBUG", "x"))

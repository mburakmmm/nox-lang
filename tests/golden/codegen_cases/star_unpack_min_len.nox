def f(xs: list[int]) -> str:
    try:
        a, *b, c = xs
        return str(a) + "|" + str(b) + "|" + str(c)
    except ValueError as e:
        return "VE: " + e.message

def g(xs: list[int]) -> str:
    try:
        a, *m, z = xs
        return "ok"
    except ValueError as e:
        return "VE2: " + e.message

print(f([1, 2, 3, 4]))
print(f([1, 2]))
print(f([1]))
print(f([]))
first, *rest = [5, 6, 7]
print(first, rest)
print(g([1]))

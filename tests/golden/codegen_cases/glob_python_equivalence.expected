* ['a', 'd', 'e1', 'empty', 'readme.md', 'top.txt', 'x y.txt']
*.txt ['top.txt', 'x y.txt']
a/* ['a/b', 'a/x.txt', 'a/y.py']
a/*.py ['a/y.py']
a/*/ ['a/b/']
a/b/* ['a/b/c', 'a/b/z.txt']
a/b/c/* ['a/b/c/v.py', 'a/b/c/w.txt']
*/* ['a/b', 'a/x.txt', 'a/y.py', 'e1/e2', 'empty/inner']
*/*/* ['a/b/c', 'a/b/z.txt', 'e1/e2/leaf.txt']
? ['a', 'd']
?? ['e1']
[a-d]* ['a', 'd']
[!a]* ['d', 'e1', 'empty', 'readme.md', 'top.txt', 'x y.txt']
a/?.txt ['a/x.txt']
.* ['.dot']
a/.* ['a/.h', 'a/.hid']
*.md ['readme.md']
x* ['x y.txt']
nope []
nope/* []
a ['a']
a/ ['a/']
a/x.txt ['a/x.txt']
a/nope.txt []
top.txt ['top.txt']
*/ ['a/', 'd/', 'e1/', 'empty/']
a/b ['a/b']
e1/*/*.txt ['e1/e2/leaf.txt']
e*/*/leaf.txt ['e1/e2/leaf.txt']
[ae]*/* ['a/b', 'a/x.txt', 'a/y.py', 'e1/e2', 'empty/inner']
a/[xy].* ['a/x.txt', 'a/y.py']
a/*.[tp][xy]* ['a/x.txt', 'a/y.py']
** ['a', 'a/b', 'a/b/c', 'a/b/c/v.py', 'a/b/c/w.txt', 'a/b/z.txt', 'a/x.txt', 'a/y.py', 'd', 'e1', 'e1/e2', 'e1/e2/leaf.txt', 'empty', 'empty/inner', 'readme.md', 'top.txt', 'x y.txt']
**/ ['a/', 'a/b/', 'a/b/c/', 'd/', 'e1/', 'e1/e2/', 'empty/', 'empty/inner/']
**/*.txt ['a/b/c/w.txt', 'a/b/z.txt', 'a/x.txt', 'e1/e2/leaf.txt', 'top.txt', 'x y.txt']
a/** ['a/', 'a/b', 'a/b/c', 'a/b/c/v.py', 'a/b/c/w.txt', 'a/b/z.txt', 'a/x.txt', 'a/y.py']
a/**/ ['a/', 'a/b/', 'a/b/c/']
a/**/*.txt ['a/b/c/w.txt', 'a/b/z.txt', 'a/x.txt']
**/z.txt ['a/b/z.txt']
**/c/* ['a/b/c/v.py', 'a/b/c/w.txt']
a/**/c/*.py ['a/b/c/v.py']
**/* ['a', 'a/b', 'a/b/c', 'a/b/c/v.py', 'a/b/c/w.txt', 'a/b/z.txt', 'a/x.txt', 'a/y.py', 'd', 'e1', 'e1/e2', 'e1/e2/leaf.txt', 'empty', 'empty/inner', 'readme.md', 'top.txt', 'x y.txt']
**/.h ['a/.h']
**/*.py ['a/b/c/v.py', 'a/y.py']
e1/** ['e1/', 'e1/e2', 'e1/e2/leaf.txt']
**/leaf.txt ['e1/e2/leaf.txt']
a/b/** ['a/b/', 'a/b/c', 'a/b/c/v.py', 'a/b/c/w.txt', 'a/b/z.txt']
*/**/*.txt ['a/b/c/w.txt', 'a/b/z.txt', 'a/x.txt', 'e1/e2/leaf.txt']
.dot ['.dot']
./top.txt ['./top.txt']

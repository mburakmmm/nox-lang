# v1.142.18: nox.strings.byte_at sınır DIŞI indekste bellek dışı okuyup çöküyordu (SIGSEGV);
# artık geçerli indekste bayt, sınır dışında (ve negatifte) 0 döner.
import nox.strings

s: str = "hello"
print(nox.strings.byte_at(s, 0))
print(nox.strings.byte_at(s, 4))
print(nox.strings.byte_at(s, 5))
print(nox.strings.byte_at(s, 5000000))
print(nox.strings.byte_at(s, -3))
print(nox.strings.byte_at("", 0))

# v2.1.85: `list * n` ve `str * n` ikiye katlanarak doldurulur (tek baytlıkta memset); sonuçlar Python ile aynı olmalı:
# sıfır/negatif/bir tekrar, boş girdi, tek ve çok elemanlı kalıp, iç içe liste (retain), UTF-8 dize.
bs: list[bool] = [True] * 1000
bs[3] = False
cb: int = 0
for b in bs:
    if b:
        cb = cb + 1
print(len(bs))
print(cb)
xs: list[int] = [7] * 5
ys: list[int] = [1, 2, 3] * 4
zs: list[int] = [1, 2, 3, 4, 5] * 7
print(xs)
print(ys)
print(len(zs))
print(zs[34])
print(zs[0] + zs[5] + zs[30])
empty: list[int] = []
print(len(empty * 9))
print(len([4, 5] * 0))
print(len([4, 5] * -3))
print([4, 5] * 1)
rows: list[list[int]] = [[1, 2]] * 3
print(rows)
print(len(rows))
ss: list[str] = ["ab", "cde"] * 3
print(ss)
print("ab" * 5)
print("x" * 7)
print("é" * 4)
print(len("héllo" * 3))
print(("" * 5) + "|")
print("abc" * 0 + "|")
print("abc" * -2 + "|")
print("abcde" * 13)
big: str = "xyz" * 100000
print(len(big))
print(big[299999])
print(big[3])

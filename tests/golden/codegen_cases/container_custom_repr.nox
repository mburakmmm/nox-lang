class Money:
    def __init__(self, c: int) -> None:
        self.c = c

    def __repr__(self) -> str:
        return "$" + str(self.c)

class Pt:
    def __init__(self, x: int) -> None:
        self.x = x

    def __str__(self) -> str:
        return "Pt<" + str(self.x) + ">"

a: set[int] = {1, 2}
print([a, {3}])
print([Money(5), Money(7)], {"k": Pt(1)})
print(f"{[Pt(2)]}")

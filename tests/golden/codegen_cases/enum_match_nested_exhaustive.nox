enum Option[T]:
    Some(value: T)
    Nothing

enum Shape:
    Circle(r: int)
    Rect(w: int, h: int)

def deep(o: Option[Option[int]]) -> str:
    match o:
        case Option.Some(Option.Some(v)):
            return "ss"
        case Option.Some(Option.Nothing):
            return "sn"
        case Option.Nothing:
            return "n"

def mixed(o: Option[Shape]) -> int:
    match o:
        case Option.Some(Shape.Circle(r)):
            return r
        case Option.Some(Shape.Rect(w=a, h=b)):
            return a + b
        case Option.Nothing:
            return 0

def lit_then_plain(s: Shape) -> int:
    match s:
        case Shape.Circle(0):
            return 0
        case Shape.Circle(r):
            return r
        case Shape.Rect(w, h):
            return w + h

print(deep(Option.Some(Option.Some(1))), deep(Option.Some(Option.Nothing)), deep(Option.Nothing))
print(mixed(Option.Some(Shape.Rect(2, 3))), lit_then_plain(Shape.Circle(0)), lit_then_plain(Shape.Circle(4)))

# F (paralel döngü toplama): büyük canlı, dallanan ve döngüsel (parent işaretçili) bir ağaç + yoğun çöp döngüsü üretimi.
# Toplamalar ağacın tamamını ziyaret eder (eşik 32k düğümü aşar → paralel yol); çöp döngüler toplanmalı, canlı ağaç bozulmamalı.
class T:
    left: T | None
    right: T | None
    parent: T | None
    pad: int
    def __init__(self: T, pad: int) -> None:
        self.left = None
        self.right = None
        self.parent = None
        self.pad = pad

def build(n: int) -> list[T]:
    nodes: list[T] = []
    i: int = 0
    while i < n:
        nodes.append(T(i))
        i = i + 1
    i = 1
    while i < n:
        p: T = nodes[(i - 1) // 2]
        nodes[i].parent = p
        if i % 2 == 1:
            p.left = nodes[i]
        else:
            p.right = nodes[i]
        i = i + 1
    return nodes

def check(nodes: list[T]) -> int:
    bad: int = 0
    i: int = 1
    while i < len(nodes):
        t: T = nodes[i]
        par: T | None = t.parent
        if par is None:
            bad = bad + 1
        else:
            if par.pad != (i - 1) // 2:
                bad = bad + 1
            child: T | None = par.left
            if i % 2 == 0:
                child = par.right
            if child is None:
                bad = bad + 1
            else:
                if child.pad != i:
                    bad = bad + 1
        i = i + 1
    return bad

live: list[T] = build(60000)
keep: int = 0
j: int = 0
while j < 40000:
    a: T = T(j)
    b: T = T(j)
    a.left = b
    b.parent = a
    x: T = live[j % 60000]
    keep = keep + x.pad % 3
    j = j + 1
print("garbage cycles", j)
print("keep", keep)
print("bad links", check(live))

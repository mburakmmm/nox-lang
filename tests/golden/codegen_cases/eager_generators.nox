def squares(n: int) -> Iterator[int]:
    for i in range(n):
        yield i * i

def words(text: str) -> Generator[str]:
    for w in text.split():
        if w == "stop":
            return
        yield w.upper()

def chain(a: Iterable[int], b: Iterable[int]) -> Iterator[int]:
    yield from a
    yield from b
    yield 99

class Bag:
    def __init__(self, xs: list[int]) -> None:
        self.xs: list[int] = xs

    def evens(self) -> Iterator[int]:
        for x in self.xs:
            if x % 2 == 0:
                yield x

def total(it: Iterator[int]) -> int:
    t: int = 0
    for v in it:
        t += v
    return t

print(list(squares(5)))
for w in words("a b stop c"):
    print(w)
print(chain(squares(3), [7, 8]))
print(Bag([1, 2, 3, 4]).evens(), total(squares(4)))
print(len(squares(10)), squares(10)[3])

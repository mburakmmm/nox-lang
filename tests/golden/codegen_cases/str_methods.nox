s: str = "  Hello, World  "
print(s.strip())
print(s.lstrip() + "|")
print("|" + s.rstrip())
print(s.upper())
print(s.lower())
words: list[str] = "a b  c".split()
print(len(words))
parts: list[str] = "x,y,z".split(",")
print(parts[2])
print(", ".join(parts))
print("hello".replace("l", "L"))
print("hello".startswith("he"))
print("hello".endswith("lo"))
print("hello".endswith("x"))
print("héllo wörld".find("wörld"))
print("hello".find("z"))
print("banana".count("an"))
print("abc".index("c"))
print("123".isdigit())
print("12a".isdigit())
print("abc".isalpha())
print("a1".isalnum())
print("  ".isspace())
print("ABC".isupper())
print("abc".islower())
print("5".zfill(3))
print("-5".zfill(4))
print("ab".ljust(5, ".") + "|")
print("ab".rjust(5) + "|")
print("ab".center(5, "*"))
name: str = "x"
print(name.upper() + name.lower())
try:
    print("abc".index("z"))
except ValueError:
    print("ValueError")
n: int = 0
i: int = 0
while i < 800:
    i = i + 1
    t: str = ("w" + str(i)) + " v"
    n = n + len(t.upper().split()) + len(t.replace("w", "W")) + t.find("v") + len(" ".join(t.split()))
print(n)

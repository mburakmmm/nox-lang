sink: list[list[int]] = []

class Helper:
    def __init__(self: Helper) -> None:
        self.n = 0
    def store_it(self: Helper, xs: list[int]) -> None:
        sink.append(xs)

def compute(h: Helper) -> int:
    xs: list[int] = [1, 2, 3]
    h.store_it(xs)
    return len(xs)

print(compute(Helper()))

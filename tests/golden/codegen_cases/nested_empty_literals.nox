class Board:
    def __init__(self) -> None:
        self.rows: list[list[str]] = [[], [], []]
        self.index: dict[str, list[int]] = {"a": [], "b": []}

b: Board = Board()
b.rows[1].append("x")
b.index["a"].append(7)
print(b.rows, b.index)
b.rows = [[], ["y"]]
print(b.rows)

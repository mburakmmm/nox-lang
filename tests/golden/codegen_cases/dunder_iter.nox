class Bag:
    items: list[int]

    def __init__(self) -> None:
        self.items = []

    def add(self, v: int) -> None:
        self.items.append(v)

    def __iter__(self) -> list[int]:
        return self.items

b: Bag = Bag()
b.add(3)
b.add(4)
for x in b:
    print(x)
print([x * 2 for x in b])
total: int = 0
for x in b:
    total += x
print(total, sum(x for x in b))

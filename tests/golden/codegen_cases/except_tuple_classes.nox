def risky(n: int) -> int:
    if n == 0:
        raise ValueError("zero")
    if n == 1:
        raise KeyError("one")
    if n == 2:
        raise IndexError("two")
    return n

for i in range(4):
    try:
        print(risky(i))
    except (ValueError, KeyError) as e:
        print("vk:", e)
    except IndexError as e:
        print("ie:", e.message)

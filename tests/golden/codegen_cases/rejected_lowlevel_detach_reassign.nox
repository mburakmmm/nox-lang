class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def f() -> int:
    pt: Point = Point(3, 4)
    v: int = 0
    lowlevel:
        p: ptr = detach(pt)
        pt = Point(100, 200)
        v = ptr_read_int(ptr_add(p, 8))
    print(v)
    return 0

print(f())

class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def compute() -> int:
    pt: Point = Point(3, 4)
    result: int = 0
    lowlevel:
        p: ptr = detach(pt)
        p2: ptr = ptr_add(p, 0)
        pt2: Point = adopt(p2)
        result = pt2.x + pt2.y
    return result

print(compute())

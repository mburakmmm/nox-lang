# Aether NOX_LIMITATIONS.md yol haritası, Faz C.6 (bkz. nox-teknik-
# spesifikasyon.md ilgili bölüm): `name[i](args)` — bir closure/fonksiyon
# listesini indeksleyip SONUCU çağırmak. Parser bu kalıbı generic kurucu
# (`Box[int](3)`) gibi ayrıştırır; checker'ın ön geçişi, `name` TANINAN bir
# generic DEĞİLSE ve bir DEĞİŞKEN olarak bildirilmişse onu sıradan
# `call(index(...))`a yeniden yazar. Gerçek generic kurucu DEĞİŞMEDEN çalışır.
class Box[T]:
    def __init__(self: Box, v: T) -> None:
        self.v = v

class Dispatcher:
    handlers: list[(int) -> int]
    def __init__(self: Dispatcher, hs: list[(int) -> int]) -> None:
        self.handlers = hs
    def run(self: Dispatcher, i: int, x: int) -> int:
        return self.handlers[i](x)

def inc(x: int) -> int:
    return x + 1

def times10(x: int) -> int:
    return x * 10

def make_adder(n: int) -> (int) -> int:
    def add(x: int) -> int:
        return x + n
    return add

def run_all(handlers: list[(int) -> int], n: int) -> int:
    total: int = 0
    k: int = 0
    while k < n:
        total = total + handlers[k](2)
        k = k + 1
    return total

# Gerçek generic kurucu hâlâ generic kurucudur.
bx: Box[int] = Box[int](7)
print(bx.v)

fs: list[(int) -> int] = [inc, times10, make_adder(100)]
i: int = 1
print(fs[i](5))
print(fs[0](5))
print(fs[2](5))

# İç içe indeks: fs[order[j]](3).
order: list[int] = [2, 0]
j: int = 0
print(fs[order[j]](3))
print(fs[order[1]](3))

# Parametre olarak verilen liste.
print(run_all(fs, 3))

# Alan üzerinden (belirsiz DEĞİL, regresyon kontrolü).
d: Dispatcher = Dispatcher(fs)
print(d.run(1, 4))

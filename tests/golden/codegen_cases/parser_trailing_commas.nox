# v2.2.63 (Prism): çağrı, `def`, sınıf tabanı ve generic kurucu argüman listelerinde sondaki virgül (Python sözdizimi).
def add(a: int, b: int,) -> int:
    return a + b

def tag(
    name: str,
    value: int,
) -> str:
    return name + str(value)

class Base:
    def hello(self) -> str:
        return "base"

class Child(Base,):
    def hello(self) -> str:
        return "child"

class Box[T]:
    item: T

    def __init__(self, item: T,) -> None:
        self.item = item

print(add(1, 2,))
print(tag("n", 7,))
print(
    add(
        10,
        20,
    ),
)
print(Child().hello())
b: Box[int] = Box[int](5,)
print(b.item)

import nox.yaml

text: str = "name: nox\nversion: 42\npi: 3.14\nenabled: true\ndisabled: false\nmissing: null\n"
root: nox.yaml.YamlValue = nox.yaml.parse(text)
print(root.mapping["name"].s)
print(root.mapping["version"].i)
print(root.mapping["pi"].f)
print(root.mapping["enabled"].b)
print(root.mapping["disabled"].b)
print(nox.yaml.is_null(root.mapping["missing"]))

def conf(name: str, *, retries: int = 3, verbose: bool = False) -> str:
    return name + ":" + str(retries) + ":" + str(verbose)

def mix(a: int, *rest: int, scale: int = 1) -> int:
    t: int = a
    for r in rest:
        t += r
    return t * scale

print(conf("x"))
print(conf("y", retries=5, verbose=True))
print(mix(1))
print(mix(1, 2, 3))
print(mix(1, 2, 3, scale=10))
nums: list[int] = [10, 20, 30]
print(mix(1, *nums))
print(mix(1, *nums, scale=2))
nums.append(40)
print(mix(0, *nums))

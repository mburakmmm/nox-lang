class Bag:
    items: list[int]
    def __init__(self) -> None:
        self.items = [10, 20, 30]
    def vals(self) -> list[int]:
        return self.items

def evens(n: int) -> list[int]:
    out: list[int] = []
    for i in range(0, n, 2):
        out.append(i)
    return out

# range forms
t: int = 0
for i in range(3):
    t = t + i
print(t)
for i in range(2, 5):
    print(i)
for i in range(0, 10, 3):
    print(i)
for i in range(10, 0, -4):
    print(i)
for i in range(5, 5):
    print(999)
for i in range(5, 2):
    print(998)

step: int = 2
for i in range(1, 8, step):
    print(i)
neg: int = -3
for i in range(9, 0, neg):
    print(i)

# str iteration (ASCII and multibyte)
for c in "ab":
    print(c)
word: str = "héy"
n: int = 0
for ch in word:
    n = n + 1
    print(ch)
print(n)

# dict iteration (insertion order)
d: dict[str, int] = {"x": 1, "y": 2, "z": 3}
s: int = 0
for k in d:
    s = s + d[k]
    print(k)
print(s)
di: dict[int, str] = {5: "a", 6: "b"}
for ki in di:
    print(ki)

# iterables that are expressions
b: Bag = Bag()
for v in b.items:
    print(v)
for v in b.vals():
    print(v)
for v in evens(7):
    print(v)
for k in d.keys():
    print(k)
for v in d.values():
    print(v)
for v in [1, 2]:
    print(v)

# break / continue with the new iterables
for c in "abcdef":
    if c == "b":
        continue
    if c == "e":
        break
    print(c)
for i in range(0, 100, 7):
    if i > 20:
        break
    print(i)

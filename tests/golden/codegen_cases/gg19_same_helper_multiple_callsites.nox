class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def helper(x: int) -> int:
    p: Point = Point(x, x + 1)
    xs: list[int] = [1, 2, 3]
    return p.x + p.y + xs[0] + xs[1] + xs[2]

def caller(n: int) -> int:
    a: int = helper(n)
    b: int = helper(n + 1)
    c: int = helper(n + 2)
    return a + b + c

print(caller(10))

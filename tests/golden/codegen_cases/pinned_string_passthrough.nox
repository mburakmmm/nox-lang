def literal_str(i: int) -> str:
    if i % 2 == 0:
        return "even"
    return "odd"

def forward(s: str) -> str:
    return s

def make_dynamic(i: int) -> str:
    return "n=" + str(i)

def compute(n: int) -> int:
    count: int = 0
    i: int = 0
    while i < n:
        pinned: str = forward(literal_str(i))
        dynamic: str = forward(make_dynamic(i))
        if len(pinned) > 0:
            count = count + 1
        if len(dynamic) > 0:
            count = count + 1
        i = i + 1
    return count

print(compute(2000000))

# Aether NOX_LIMITATIONS.md yol haritası, Faz B.1 (bkz. nox-teknik-
# spesifikasyon.md ilgili bölüm): `nox.atomic` — tek-iş-parçacıklı API
# davranışı + GERÇEK `nox.thread.start` worker'ları arasında paylaşılan
# bir sayaç (kayıp güncelleme OLMAMALI) + paylaşılan bir bayrak.
import nox.atomic
import nox.thread

async def bump(h: int) -> int:
    c: nox.atomic.AtomicInt = nox.atomic.from_int_handle(h)
    i: int = 0
    while i < 1000:
        c.increment()
        i = i + 1
    return 0

async def raise_flag(h: int) -> int:
    f: nox.atomic.AtomicBool = nox.atomic.from_bool_handle(h)
    f.store(True)
    return 0

a: nox.atomic.AtomicInt = nox.atomic.new_int(5)
print(a.load())
a.store(10)
print(a.add(3))
print(a.decrement())
print(a.compare_and_swap(12, 100))
print(a.compare_and_swap(12, 200))
print(a.load())
a.free()

counter: nox.atomic.AtomicInt = nox.atomic.new_int(0)
h1: ThreadHandle[int] = nox.thread.start(bump, counter.handle)
h2: ThreadHandle[int] = nox.thread.start(bump, counter.handle)
h3: ThreadHandle[int] = nox.thread.start(bump, counter.handle)
h4: ThreadHandle[int] = nox.thread.start(bump, counter.handle)
r1: int = await h1.join()
r2: int = await h2.join()
r3: int = await h3.join()
r4: int = await h4.join()
print(counter.load())
counter.free()

flag: nox.atomic.AtomicBool = nox.atomic.new_bool(False)
print(flag.load())
hf: ThreadHandle[int] = nox.thread.start(raise_flag, flag.handle)
rf: int = await hf.join()
print(flag.load())
print(flag.compare_and_swap(True, False))
print(flag.load())
flag.free()

from nox.collections import Set, Counter, OrderedDict

st: Set[str] = Set[str]()
st.add("x")
st.add("y")
st.add("x")
print(st.size())
print(st.contains("y"))
st.remove("y")
print(st.contains("y"))

c: Counter[str] = Counter[str]()
c.add("a")
c.add("a")
c.add("b")
print(c.count("a"))
print(c.count("b"))
print(c.count("z"))
print(c.total())

od: OrderedDict[str, int] = OrderedDict[str, int]()
od.set("first", 1)
od.set("second", 2)
od.set("first", 10)
print(od.get("first"))
print(od.get("second"))
print(od.size())
ks: list[str] = od.keys_list()
print(ks[0])
print(ks[1])

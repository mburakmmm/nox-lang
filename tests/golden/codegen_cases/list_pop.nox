xs: list[int] = [1, 2, 3]
print(xs.pop())
print(len(xs))

class Box:
    items: list[str]
    def __init__(self: Box) -> None:
        self.items = []
    def add(self: Box, v: str) -> None:
        items: list[str] = self.items
        items.append(v)
        self.items = items
    def take(self: Box) -> str:
        return self.items.pop()

b: Box = Box()
b.add("x")
b.add("y")
b.add("z")
print(b.take())
print(b.take())
print(len(b.items))


import nox.math

# v4 Faz B madde 1 (bkz. nox-teknik-spesifikasyon.md §3.2xx): sqrt/pow/
# floor/ceil ARTIK NİTELİKLİ çağrılır (ESKİ "çıplak çağrı" asimetrisi
# ÇÖZÜLDÜ — nox.math libm'e değil, Zig'in KENDİ std.math'ına bağlı).
print(nox.math.sqrt(4.0))
print(nox.math.pow(2.0, 10.0))
print(nox.math.floor(3.7))
print(nox.math.ceil(3.2))
print(nox.math.min(3.0, 5.0))
print(nox.math.max(3.0, 5.0))
print(nox.math.abs(-4.5))
print(nox.math.abs(4.5))

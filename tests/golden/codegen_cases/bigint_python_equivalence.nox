# Üretildi: scripts/gen_bigint_golden.py. Rastgele büyük sayılarda nox.bigint, Python int ile aynı sonucu vermeli.
import nox.bigint
from nox.bigint import BigInt, parse

a0: BigInt = parse("-4660402925324155361")
b0: BigInt = parse("5571433448793192345")
print(a0 + b0)
print(a0 - b0)
print(a0 * b0)
print(a0 // b0)
print(a0 % b0)
print(a0 & b0)
print(a0 | b0)
print(a0 ^ b0)
print(a0 < b0, a0 == b0, a0 > b0)
print(a0.gcd(b0))
print(a0.bit_length(), a0.sign())
print(a0 >> 105)
print(a0 << 105)
print(a0.to_str(16))
print(a0.abs().isqrt())
q0, r0 = a0.divmod(b0)
print(q0 * b0 + r0 == a0)
print(a0.pow_mod(parse("42"), b0.abs()))
print(a0 ** 5)

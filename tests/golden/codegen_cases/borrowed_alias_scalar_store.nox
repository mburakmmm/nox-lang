# 2.3 B1: skaler alana yazan (ama heap'i değiştirmeyen) fonksiyonlarda parametre-alanı alias'ları retain/release'siz ödünç alınır; heap alanına yazan fonksiyonlarda alias GÜVENLİ kalır. Sızıntı yok.
import nox.mem

class Node:
    val: int
    visits: int
    label: str
    left: Node | None
    right: Node | None

    def __init__(self: Node, val: int, left: Node | None, right: Node | None) -> None:
        self.val = val
        self.visits = 0
        self.label = "n" + str(val)
        self.left = left
        self.right = right

# skaler sayaç artıran gezinti: alias'lar ödünç alınabilir
def walk(n: Node) -> int:
    n.visits = n.visits + 1
    t: int = n.val
    l: Node | None = n.left
    if l != None:
        t = t + walk(l)
    r: Node | None = n.right
    if r != None:
        t = t + walk(r)
    return t

# heap alanına (left) yazar: alias, alan değiştikten sonra da geçerli kalmalı
def cut_left(n: Node) -> int:
    l: Node | None = n.left
    n.left = None
    if l != None:
        return l.val
    return -1

# str alanını değiştirir: alias retain'li kalmalı
def relabel(n: Node) -> int:
    s: str = n.label
    n.label = "changed"
    return len(s)

def build(d: int) -> Node:
    if d == 0:
        return Node(1, None, None)
    return Node(d, build(d - 1), build(d - 1))

def run() -> int:
    root: Node = build(5)
    a: int = walk(root)
    b: int = walk(root)
    c: int = cut_left(root)
    d: int = cut_left(root)
    e: int = relabel(root)
    f: int = relabel(root)
    return a + b + c + d + e + f + root.visits

print(run())
nox.mem.stats()
r0: int = run()
m1: nox.mem.MemStats = nox.mem.stats()
r1: int = run()
r2: int = run()
m2: nox.mem.MemStats = nox.mem.stats()
print(r0 == r1 and r1 == r2)
print(m2.live - m1.live)

import nox.strings

# NOX-STR-001: char_from_byte(0) bir NUL baytlı str üretir (önceden boştu); 0-255 dışı boş kalır.
z: str = nox.strings.char_from_byte(0)
print(len(z))
print(ord(z))
print(len("a" + nox.strings.char_from_byte(0) + "b"))
print(len(nox.strings.char_from_byte(65)))
print(len(nox.strings.char_from_byte(300)))
print(nox.strings.byte_len(nox.strings.char_from_byte(200)))

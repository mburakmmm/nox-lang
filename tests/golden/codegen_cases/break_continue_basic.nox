# while + break / continue
i: int = 0
s: int = 0
while i < 10:
    i = i + 1
    if i == 3:
        continue
    if i == 8:
        break
    s = s + i
print(s)
print(i)

# for range + break + continue
t: int = 0
for k in range(100):
    if k % 2 == 0:
        continue
    if k > 9:
        break
    t = t + k
print(t)

# for list
xs: list[int] = [5, 6, 7, 8, 9]
u: int = 0
for x in xs:
    if x == 6:
        continue
    if x == 9:
        break
    u = u + x
print(u)

# nested loops: break only leaves the inner loop
cnt: int = 0
for a in range(4):
    for b in range(4):
        if b == 2:
            break
        cnt = cnt + 1
    cnt = cnt + 10
print(cnt)

# continue in the inner loop of a nested while keeps the outer loop going
n: int = 0
o: int = 0
while o < 3:
    o = o + 1
    q: int = 0
    while q < 5:
        q = q + 1
        if q % 2 == 0:
            continue
        n = n + 1
print(n)

# break skips the rest of the body
z: int = 0
while True:
    z = z + 1
    if z >= 4:
        break
print(z)

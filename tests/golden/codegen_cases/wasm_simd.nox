# v2.1.98: nox.wasm — WASM SIMD (v128). Modül i32 arayüzlü ama içeride v128 kullanır: splat/replace_lane/mul/extract_lane, v128.load/store döngüsü, bitmask.
# v128 değerleri Nox sınırından GEÇEMEZ: v128 imzalı bir dışa aktarma çağrılınca WasmError olur (i64-çifti sarmalayıcı kullanın).
import nox.wasm
from nox.wasm import WasmError

code: list[int] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 30, 4, 96, 8, 127, 127, 127, 127, 127, 127, 127, 127, 1, 127, 96, 3, 127, 127, 127, 0, 96, 2, 127, 127, 1, 127, 96, 1, 123, 1, 123, 3, 5, 4, 0, 1, 2, 3, 5, 3, 1, 0, 1, 7, 39, 5, 3, 109, 101, 109, 2, 0, 3, 100, 111, 116, 0, 0, 5, 115, 99, 97, 108, 101, 0, 1, 7, 97, 110, 121, 95, 110, 101, 103, 0, 2, 5, 105, 100, 101, 110, 116, 0, 3, 10, 189, 1, 4, 70, 1, 1, 123, 32, 0, 253, 17, 32, 1, 253, 28, 1, 32, 2, 253, 28, 2, 32, 3, 253, 28, 3, 32, 4, 253, 17, 32, 5, 253, 28, 1, 32, 6, 253, 28, 2, 32, 7, 253, 28, 3, 253, 181, 1, 33, 8, 32, 8, 253, 27, 0, 32, 8, 253, 27, 1, 106, 32, 8, 253, 27, 2, 106, 32, 8, 253, 27, 3, 106, 11, 58, 1, 1, 127, 2, 64, 3, 64, 32, 3, 32, 1, 79, 13, 1, 32, 0, 32, 3, 65, 4, 116, 106, 32, 0, 32, 3, 65, 4, 116, 106, 253, 0, 4, 0, 32, 2, 253, 17, 253, 181, 1, 253, 11, 4, 0, 32, 3, 65, 1, 106, 33, 3, 12, 0, 11, 0, 11, 11, 52, 2, 1, 123, 1, 127, 2, 64, 3, 64, 32, 3, 32, 1, 79, 13, 1, 32, 2, 32, 0, 32, 3, 65, 4, 116, 106, 253, 0, 4, 0, 253, 80, 33, 2, 32, 3, 65, 1, 106, 33, 3, 12, 0, 11, 0, 11, 32, 2, 253, 164, 1, 11, 4, 0, 32, 0, 11]

w: nox.wasm.Instance = nox.wasm.from_bytes(code)
print(w.call("dot", [1, 2, 3, 4, 5, 6, 7, 8]))
print(w.signature("ident"))

# 2 vektör (8 x i32) yaz, hepsini 10 ile ölçekle
i: int = 0
while i < 8:
    w.store(i * 4, 4, i + 1)
    i += 1
w.call("scale", [0, 2, 10])
out: list[int] = []
i = 0
while i < 8:
    out.append(w.load(i * 4, 4))
    i += 1
print(out)

# bitmask: yalnızca işareti negatif olan lane'ler
w.store(0, 4, 1)
w.store(4, 4, 2)
w.store(8, 4, 3)
w.store(12, 4, 4)
print(w.call("any_neg", [0, 1]))
w.store(20, 4, -1)
print(w.call("any_neg", [0, 2]))

# v128 imzalı dışa aktarma sınırdan geçemez
try:
    w.call("ident", [1])
except WasmError:
    print("v128 boundary rejected")

# bellek sınırı: v128.load son baytı aşarsa tuzak
try:
    w.call("any_neg", [65528, 1])
except WasmError:
    print("v128 load out of bounds trapped")
w.close()

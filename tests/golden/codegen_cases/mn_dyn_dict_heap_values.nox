# Faz 9.0 F5 (v2.1.138): yığın DEĞERLİ sözlükler (dict[str, list[int]], dict[str, Sınıf]) paylaşılır — eklenen değerler yayımlanır, okumalar sahipli, yazdırma girdileri kilit altında retain ederek okur.
class Item:
    label: str
    qty: int
    def __init__(self: Item, label: str, qty: int) -> None:
        self.label = label
        self.qty = qty

class Store:
    lists: dict[str, list[int]]
    items: dict[str, Item]
    def __init__(self: Store) -> None:
        self.lists = {}
        self.items = {}
    def put(self: Store, k: str, j: int) -> None:
        self.lists[k] = [j, j + 1]
        self.items[k] = Item("i" + k, j)
    def read(self: Store, k: str) -> int:
        n: int = 0
        try:
            row: list[int] = self.lists[k]
            n = n + len(row)
        except KeyError:
            n = n + 1
        try:
            it: Item = self.items[k]
            n = n + len(it.label) % 3
        except KeyError:
            n = n + 1
        return n
    def reset(self: Store) -> None:
        self.lists = {}

store: Store = Store()
shared_map: dict[str, list[str]] = {}

async def worker(id: int, out: Channel[int]) -> None:
    acc: int = 0
    j: int = 0
    while j < 120:
        k: str = "k" + str(j % 9)
        store.put(k, j + id)
        acc = acc + store.read("k" + str((j + 3) % 9)) % 5
        shared_map[k] = ["a" + k, "b" + k]
        try:
            sm: list[str] = shared_map[k]
            acc = acc + len(sm) % 2
        except KeyError:
            acc = acc + 1
        if j % 40 == 39:
            store.reset()
        if j % 30 == 29:
            print(len(str(store.lists)) >= 0)
        j = j + 1
    await out.send(id)

async def main_task() -> None:
    out: Channel[int] = Channel[int](16)
    k: int = 0
    while k < 6:
        t: Task[None] = spawn worker(k, out)
        k = k + 1
    s: int = 0
    k = 0
    while k < 6:
        s = s + await out.recv()
        k = k + 1
    print(s)
    print(len(store.items) <= 9)
    print(len(shared_map) <= 9)

mt: Task[None] = spawn main_task()
await mt

def make_list() -> list[str]:
    xs: list[str] = ["a", "b", "c"]
    return xs

def loopcall(n: int) -> str:
    out: str = ""
    i: int = 0
    while i < n:
        ys: list[str] = make_list()
        out = out + ys[0] + ys[1] + ys[2]
        i = i + 1
    return out

print(loopcall(5))
print(loopcall(1))
print(loopcall(0))

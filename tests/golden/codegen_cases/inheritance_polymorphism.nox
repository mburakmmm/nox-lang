class Animal:
    def __init__(self: Animal, name: str) -> None:
        self.name = name

    def speak(self: Animal) -> str:
        return self.name + " makes a sound"

    def describe(self: Animal) -> str:
        return "I am " + self.name + ": " + self.speak()

class Dog(Animal):
    def speak(self: Dog) -> str:
        return self.name + " barks"

class Cat(Animal):
    def speak(self: Cat) -> str:
        return self.name + " meows"

def make_speak(a: Animal) -> str:
    return a.speak()

animals: list[Animal] = [Dog("Rex"), Cat("Tom"), Animal("Generic")]
i: int = 0
while i < len(animals):
    a: Animal = animals[i]
    print(a.speak())
    print(a.describe())
    print(make_speak(a))
    i = i + 1

# Faz 9.0 F3b (v2.1.133): paylaşılan sınıf örneğindeki `list[str]` alanının TÜM yöntem/işleçleri eş zamanlı çalışır (in/count/index/remove/insert/sort/reverse/copy/clear/pop(i)/del/dilim/+/==/print/anlama).
# Bellek güvenliği (sızıntı/çift bırakma/kullanım-sonrası) DebugAllocator ile yakalanır; sonuçlar yalnızca değişmezlere dayanır.
class Box:
    names: list[str]
    n: int
    def __init__(self: Box) -> None:
        self.names = ["seed"]
        self.n = 0
    def churn(self: Box, tag: str, j: int) -> int:
        acc: int = 0
        self.names.append(tag)
        self.names.insert(0, tag + "i")
        if tag in self.names:
            acc = acc + 1
        acc = acc + self.names.count(tag) % 2
        if len(self.names) > 40:
            try:
                self.names.pop(0)
                del self.names[1]
                self.names.remove(tag)
            except IndexError:
                acc = acc + 1
            except ValueError:
                acc = acc + 1
        if j % 9 == 0:
            self.names.reverse()
        if j % 13 == 0:
            self.names.sort()
        cp: list[str] = self.names.copy()
        acc = acc + len(cp) % 2
        sl: list[str] = self.names[0:3]
        acc = acc + len(sl) % 2
        both: list[str] = cp + sl
        acc = acc + len(both) % 2
        lens: list[int] = [len(x) for x in self.names]
        acc = acc + len(lens) % 2
        if cp == cp:
            acc = acc + 1
        if j % 31 == 0:
            self.names = ["reset", tag]
        if j % 47 == 0:
            self.names.clear()
            self.names.append("again")
        return acc

box: Box = Box()

async def worker(id: int, out: Channel[int]) -> None:
    acc: int = 0
    j: int = 1
    while j <= 200:
        acc = acc + box.churn("t" + str(id) + "_" + str(j), j)
        if j % 50 == 0:
            print(len(box.names) >= 0)
        j = j + 1
    await out.send(acc)

async def main_task() -> None:
    out: Channel[int] = Channel[int](16)
    k: int = 0
    while k < 6:
        t: Task[None] = spawn worker(k, out)
        k = k + 1
    s: int = 0
    k = 0
    while k < 6:
        s = s + await out.recv()
        k = k + 1
    print(s > 0)
    print(len(box.names) >= 1)

mt: Task[None] = spawn main_task()
await mt

# Faz 9.0 dilim 4 (v2.1.125): paylaşılan modül listesi `for` ile gezilebilir ve salt-okunur parametreli modül işlevlerine argüman olarak geçirilebilir (çağrı anlık kopya alır).
nums: list[int] = []
names: list[str] = []

def total(xs: list[int]) -> int:
    t: int = 0
    for v in xs:
        t = t + v
    return t

def longest(xs: list[str]) -> int:
    best: int = 0
    i: int = 0
    while i < len(xs):
        if len(xs[i]) > best:
            best = len(xs[i])
        i = i + 1
    return best

def checked_total(xs: list[int]) -> int:
    return total(xs) + len(xs)

async def worker(id: int, out: Channel[int]) -> None:
    acc: int = 0
    j: int = 0
    while j < 20:
        i: int = 0
        while i < 1500:
            acc = (acc * 31 + i + j + id) % 1000003
            i = i + 1
        nums.append(id * 100 + j)
        names.append("n" + str(id) + "x" * j)
        j = j + 1
    await out.send(acc)

async def main_task() -> None:
    out: Channel[int] = Channel[int](16)
    k: int = 0
    while k < 6:
        t: Task[None] = spawn worker(k, out)
        k = k + 1
    s: int = 0
    k = 0
    while k < 6:
        s = s + await out.recv()
        k = k + 1
    print(s)
    print(total(nums))
    print(checked_total(nums))
    print(longest(names))
    c: int = 0
    for v in nums:
        c = c + 1
    print(c)
    cnt: int = 0
    for n in names:
        if len(n) > 5:
            cnt = cnt + 1
    print(cnt)

mt: Task[None] = spawn main_task()
await mt

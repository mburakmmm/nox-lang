import nox.time

dt: nox.time.DateTime = nox.time.from_epoch_ms(0)
print(dt.to_str())
print(dt.to_epoch_ms())

dt2: nox.time.DateTime = nox.time.from_epoch_ms(951868800000)
print(dt2.to_str())
print(dt2.to_epoch_ms())

dt3: nox.time.DateTime = nox.time.from_epoch_ms(1709210096000)
print(dt3.to_str())
print(dt3.to_epoch_ms())

built: nox.time.DateTime = nox.time.DateTime(2024, 2, 29, 12, 34, 56)
print(built.to_epoch_ms())

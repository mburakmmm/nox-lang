# Üretildi: scripts/gen_zip_golden.py. nox.zip, Python zipfile ile aynı içeriği okur; pack/unpack gidiş-dönüşü ve hatalar.
import nox.base64
import nox.crypto
import nox.strings
import nox.zip
from nox.zip import ZipEntry, ZipError, file_entry, dir_entry, pack, unpack

def show(b64: str) -> None:
    try:
        for e in unpack(nox.base64.decode(b64)):
            h: str = nox.crypto.sha256(e.data)
            print(e.name, e.is_dir(), nox.strings.byte_len(e.data), h[0:16])
    except ZipError as err:
        print("ZipError")

show("UEsDBBQAAAAAAAAAIQCGphA2BQAAAAUAAAAFAAAAYS50eHRoZWxsb1BLAQIUAxQAAAAAAAAAIQCGphA2BQAAAAUAAAAFAAAAAAAAAAAAAACkgQAAAABhLnR4dFBLBQYAAAAAAQABADMAAAAoAAAAAAA=")
show("UEsDBBQAAAAIAAAAIQCGphA2BwAAAAUAAAAFAAAAYS50eHTLSM3JyQcAUEsBAhQDFAAAAAgAAAAhAIamEDYHAAAABQAAAAUAAAAAAAAAAAAAAKSBAAAAAGEudHh0UEsFBgAAAAABAAEAMwAAACoAAAAAAA==")
show("")
show("")
show("")
show("")
show("UEsDBBQAAAAAAAAAIQCAiPnlEQAAABEAAAAFAAAAYS50eHRoZW1sbyBoZWxsbyBoZWxsb1BLAQIUAxQAAAAAAAAAIQCAiPnlEQAAABEAAAAFAAAAAAAAAAAAAACkgQAAAABhLnR4dFBLBQYAAAAAAQABADMAAAA0AAAAAAA=")
show("UEsDBBQAAAAAAAAAIQCAiPnlEQAAABEAAAAFAAAAYS50eHRoZWxsbyBoZWxsbyBoZWxsb1BLAQIUAxQAAAAAAAAAIQCAiPnlEQAAABEAAAAFAAAAAAAAAAAAAACkgQAAAABhLnR4dFBLBQYAAAAAAQABAA==")
show("UEsAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
show("bm90IGEgemlwIGF0IGFsbCwgZGVmaW5pdGVseSBub3Q=")

def roundtrip(compress: bool) -> None:
    entries: list[ZipEntry] = []
    entries.append(dir_entry("d"))
    entries.append(file_entry("d/a.txt", "abc " * 500))
    entries.append(file_entry("empty", ""))
    entries.append(file_entry("ünï/çğ.bin", "\x01\x02 çğış"))
    blob: str = pack(entries, compress)
    for e in unpack(blob):
        h: str = nox.crypto.sha256(e.data)
        print(e.name, e.is_dir(), nox.strings.byte_len(e.data), h[0:16])

roundtrip(True)
roundtrip(False)

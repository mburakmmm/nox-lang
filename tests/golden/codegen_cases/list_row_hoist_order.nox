def div_then_index() -> str:
    a: list[list[int]] = [[1]]
    d: int = 0
    i: int = 5
    go: int = 1
    try:
        while go == 1:
            x: int = 1 // d
            y: int = a[i][0]
            go = 0
            go = go + x + y
        return "none"
    except ZeroDivisionError:
        return "zero"
    except IndexError:
        return "index"

def index_then_div() -> str:
    a: list[list[int]] = [[1]]
    d: int = 0
    i: int = 5
    go: int = 1
    try:
        while go == 1:
            y: int = a[i][0]
            x: int = 1 // d
            go = 0
            go = go + x + y
        return "none"
    except ZeroDivisionError:
        return "zero"
    except IndexError:
        return "index"

def div_in_same_expr() -> str:
    a: list[list[int]] = [[1]]
    d: int = 0
    i: int = 5
    go: int = 1
    try:
        while go == 1:
            y: int = (1 // d) + a[i][0]
            go = 0
            go = go + y
        return "none"
    except ZeroDivisionError:
        return "zero"
    except IndexError:
        return "index"

def if_then_row() -> str:
    b: list[list[int]] = []
    j: int = 0
    go: int = 1
    try:
        while go == 1:
            x: int = 1
            if go == 1:
                x = 1 // 0
            y: int = b[j][0]
            go = 0
            go = go + y + x
        return "none"
    except ZeroDivisionError:
        return "zero"
    except IndexError:
        return "index"

def and_skips_row() -> str:
    a: list[list[int]] = []
    i: int = 0
    k: int = 0
    go: int = 1
    try:
        while go == 1:
            ok: bool = False and a[i][k] == 1
            go = 0
            if ok:
                go = 1
        return "ok"
    except IndexError:
        return "index"

def safe_row() -> int:
    a: list[list[int]] = [[2, 3]]
    i: int = 0
    k: int = 0
    s: int = 0
    while k < 2:
        s = s + a[i][k]
        k = k + 1
    return s

print(div_then_index())
print(index_then_div())
print(div_in_same_expr())
print(if_then_row())
print(and_skips_row())
print(safe_row())

def base(x: int) -> int:
    return x * 2

def make_wrapper(handler: (int) -> int) -> (int) -> int:
    def wrapped(x: int) -> int:
        return handler(x) + 1
    return wrapped

def double_wrap(handler: (int) -> int) -> (int) -> int:
    inner: (int) -> int = make_wrapper(handler)
    def outer(x: int) -> int:
        return inner(x) * 10
    return outer

i: int = 0
while i < 500:
    f: (int) -> int = make_wrapper(base)
    g: (int) -> int = double_wrap(base)
    if f(3) != 7:
        print("FAIL f")
    if g(3) != 70:
        print("FAIL g")
    i = i + 1

print("ok")

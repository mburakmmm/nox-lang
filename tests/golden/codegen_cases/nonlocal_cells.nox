def counter(start: int) -> int:
    n: int = start
    total: str = ""
    def inc(by: int) -> None:
        nonlocal n, total
        n = n + by
        total = total + "x"
    inc(1)
    inc(2)
    print(n, total)
    return n

def make() -> int:
    hits: int = 0
    def outer() -> int:
        def deep() -> None:
            nonlocal hits
            hits += 10
        deep()
        deep()
        return hits
    r: int = outer()
    return r + hits

class Box:
    def run(self, k: int) -> int:
        acc: int = 0
        def add(v: int) -> None:
            nonlocal acc
            acc += v * k
        add(1)
        add(2)
        return acc

print(counter(5))
print(make())
print(Box().run(3))

def captured_list(s: int) -> int:
    xs: list[int] = [s, s + 1]
    def total() -> int:
        return xs[0] + xs[1]
    return total()

print(captured_list(4))

class Rec:
    label: str
    def __init__(self, label: str) -> None:
        self.label = label

def show(xs: list[int]) -> None:
    s: str = ""
    for x in xs:
        s = s + str(x) + ","
    print(s)

xs: list[int] = [10, 20, 30, 40, 50]
show(xs[1:4])
show(xs[:2])
show(xs[3:])
show(xs[:])
show(xs[::-1])
show(xs[::2])
show(xs[1::2])
show(xs[-2:])
show(xs[:-1])
show(xs[10:20])
show(xs[3:1])
show(xs[4:0:-1])
show(xs[-100:100])
show(xs[::-2])
show(xs[1:4][1:])
n: int = 2
show(xs[n:n + 2])
show(xs[::n])

# kopya bağımsızlığı
ys: list[int] = xs[:]
ys[0] = 99
print(xs[0])
print(ys[0])

# str dilimleme (ASCII ve çok baytlı)
s: str = "hello world"
print(s[1:4])
print(s[:5])
print(s[6:])
print(s[::-1])
print(s[::2])
print(s[-5:])
print(len(s[3:3]))
print(len(s[20:]))
u: str = "héllo wörld"
print(u[1:4])
print(u[::-1])
print(u[::2])
print(u[-5:])
print(u[2:-2])

# sınıf/str eleman listeleri (ARC)
words: list[str] = ["a", "b", "c", "d"]
w2: list[str] = words[1:3]
print(len(w2))
print(w2[1])
recs: list[Rec] = [Rec("x"), Rec("y"), Rec("z")]
r2: list[Rec] = recs[::-1]
print(r2[0].label)
r2[0].label = "changed"
print(recs[2].label)

# döngüde sızıntı denetimi
acc: int = 0
i: int = 0
while i < 2000:
    i = i + 1
    part: list[str] = words[i % 3:]
    acc = acc + len(part) + len(recs[::2]) + len(("ab" * (i % 5))[1:])
    acc = acc + len(s[i % 7:])
print(acc)

# str karşılaştırma ve tekrar
print("apple" < "banana")
print("b" < "a")
print("a" <= "a")
print("zebra" > "apple")
print("abc" >= "abd")
print("" < "a")
print("é" > "z")
print("ab" * 3)
print(len(2 * "xyz"))
print(len("q" * 0))
print(len("q" * -2))
best: str = words[0]
for w in words:
    if w > best:
        best = w
print(best)
print(("-" * 5) + ">")

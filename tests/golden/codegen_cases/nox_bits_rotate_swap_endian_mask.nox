import nox.bits

# rotate
print(nox.bits.rotl_u8(u8(1), 1))
print(nox.bits.rotl_u8(u8(128), 1))
print(nox.bits.rotr_u8(u8(1), 1))
print(nox.bits.rotl_u16(u16(1), 15))
print(nox.bits.rotr_u16(u16(1), 1))
print(nox.bits.rotl_u32(u32(1), 31))
print(nox.bits.rotr_u32(u32(1), 1))
print(nox.bits.rotl_u64(u64(1), 63))
print(nox.bits.rotr_u64(u64(1), 1))
# n == 0 / n == genişlik (negatif normalize dahil) özel durumları
print(nox.bits.rotl_u32(u32(123456), 0))
print(nox.bits.rotl_u32(u32(123456), 32))
print(nox.bits.rotl_u8(u8(1), -1))

# byte swap
print(nox.bits.swap16(u16(258)))
print(nox.bits.swap32(u32(305419896)))
print(nox.bits.swap64(u64(305419896)))

# little/big-endian
print(nox.bits.to_le32(u32(42)))
print(nox.bits.from_le32(u32(42)))
print(nox.bits.to_be32(u32(1)))
print(nox.bits.from_be16(u16(1)))

# mask/bit ops
print(nox.bits.mask(3))
print(nox.bits.mask(8))
print(nox.bits.test_bit(5, 0))
print(nox.bits.test_bit(5, 1))
print(nox.bits.set_bit(0, 3))
print(nox.bits.clear_bit(15, 1))
print(nox.bits.toggle_bit(5, 0))

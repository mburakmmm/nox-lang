# Üretildi: scripts/gen_decimal_golden.py. nox.decimal, Python decimal.Decimal ile aynı sonucu vermeli.
import nox.decimal
from nox.decimal import Decimal, parse

a0: Decimal = parse("2e-6")
b0: Decimal = parse("-7e-7")
print(a0)
print(a0 + b0)
print(a0 - b0)
print(a0 * b0)
print(a0.compare(b0), a0 == b0, a0 < b0)
print(a0.quantize(-1, "half_down"))
print(a0.quantize(2, "ceiling"))
print(a0.quantize(-2, "half_even"))
print(a0.div(b0, 7, "floor"))
print(a0.normalize())
print(a0.to_bigint())

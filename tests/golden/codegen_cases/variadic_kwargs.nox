def describe(name: str, **opts: int) -> int:
    total: int = 0
    for k in opts:
        total += opts[k]
    print(name + ":" + str(len(opts)))
    return total

def both(a: int, *rest: int, **named: str) -> str:
    return str(a) + "/" + str(len(rest)) + "/" + str(len(named))

print(describe("x"))
print(describe("y", a=1, b=2, c=3))
print(describe(name="z", k=10))
print(both(1))
print(both(1, 2, 3, u="a", v="b"))

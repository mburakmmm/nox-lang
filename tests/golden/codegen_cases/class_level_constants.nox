class Limits:
    MAX: int = 5
    RATE: float = 2
    NAME: str = "lim"
    DEBUG: bool = False
    NEG: int = -3
    count: int

    def __init__(self) -> None:
        self.count = 0

    def room(self) -> int:
        return Limits.MAX - self.count + self.NEG

class Sub(Limits):
    def __init__(self) -> None:
        self.count = 1

l: Limits = Limits()
s: Sub = Sub()
print(Limits.MAX)
print(Limits.RATE)
print(Limits.NAME + "!")
print(Limits.DEBUG)
print(l.room())
print(s.room())
print(Sub.MAX + s.MAX)
x: float = Limits.RATE * 2.0
print(x)

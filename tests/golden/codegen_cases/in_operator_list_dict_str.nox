class P:
    x: int
    def __init__(self: P, x: int) -> None:
        self.x = x

xs: list[int] = [3, 5, 7]
print(5 in xs)
print(4 in xs)
print(4 not in xs)
print(7 not in xs)

names: list[str] = ["ann", "bob"]
print("bob" in names)
print("cy" in names)
w: str = "b" + "ob"
print(w in names)

fs: list[float] = [1.5, 2.5]
print(2.5 in fs)
print(2 in fs)

ps: list[P] = [P(1), P(2)]
print(P(2) in ps)
print(P(9) in ps)

nested: list[list[int]] = [[1, 2], [3]]
print([3] in nested)
print([4] in nested)

empty: list[int] = []
print(1 in empty)

d: dict[str, int] = {"a": 1, "b": 2}
print("a" in d)
print("z" in d)
print("z" not in d)

di: dict[int, str] = {1: "x"}
print(1 in di)
print(2 in di)

s: str = "hello world"
print("lo w" in s)
print("xyz" in s)
print("" in s)
print("hello world!" in s)
print("world" not in s)

if 3 in xs and "ann" in names:
    print("both")
if not (9 in xs):
    print("not9")

# in a loop with break
found: int = -1
i: int = 0
while i < 10:
    if i in xs:
        found = i
        break
    i = i + 1
print(found)

def has(items: list[str], q: str) -> bool:
    return q in items

print(has(names, "ann"))
print(has(names, "zed"))

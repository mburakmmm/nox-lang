# Üretildi: scripts/gen_streq_golden.py. Satır içi `s == "lit"` karşılaştırması strcmp anlamıyla (ilk NUL'da durur) birebir aynı olmalı.
import nox.strings

def f0(s: str) -> str:
    r: str = ""
    if s == "":
        r = r + "E"
    if "" == s:
        r = r + "L"
    if s != "":
        r = r + "N"
    return r


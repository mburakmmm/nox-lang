class Counter:
    def __init__(self) -> None:
        self.n = 0
    def bump(self) -> None:
        self.n += 1

c: Counter = Counter()
c.bump()
c.bump()
print(c.n)
xs: list[int] = [1, 2, 3]
xs[1] += 10
xs[0] *= 5
print(xs)
d: dict[str, int] = {"a": 1}
d["a"] += 5
d["a"] -= 1
print(d)
grid: list[list[int]] = [[1, 2], [3, 4]]
grid[1][0] += 7
print(grid)
x: int = 5
print(0 < x < 10, 0 < x < 3, 1 <= x <= 5, 10 > x > 2 > 1)
print(sum(v * v for v in xs), any(v > 10 for v in xs), all(v > 0 for v in xs))
print(max(v for v in xs), ", ".join(str(v) for v in xs))
print(sorted(v * 2 for v in xs))
assert x == 5, "x should be 5"
assert x > 0
try:
    assert x == 6, "bad x"
except AssertionError as e:
    print("caught:", e.message)
try:
    assert 0 > 1
except AssertionError as e:
    print("caught:", e.message)

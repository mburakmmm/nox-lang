def side(c: list[int], v: int) -> str:
    c.append(v)
    return "s" + str(v)

a: int = 7
s: str = "héllo"
e: str = ""
order: list[int] = []
print("item" + str(a) + "tail")
print(s + "-" + s + "-" + e + "!")
print("a" + str(a) + "b" + str(-a) + "c")
print(side(order, 1) + "," + side(order, 2) + "," + side(order, 3), order)

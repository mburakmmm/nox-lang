import nox.log

print(nox.log.redact("token=abc123 ve abc123 tekrar", ["abc123"]))
print(nox.log.redact("gizli yok", ["", "zzz"]))
print(nox.log.mask_assignments("GET /x?user=ali&password=p4ss&n=1 token=T0K,ok", ["password", "token"]))
print(nox.log.mask_assignments("xpassword=1 password=2 \"password=3\"", ["password"]))
print(nox.log.mask_assignments("türkçe şifre=çok gizli password=ğ", ["password"]))
print(nox.log.mask_assignments("", ["password"]))

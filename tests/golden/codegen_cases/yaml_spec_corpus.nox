import nox.yaml
from nox.yaml import YamlValue, YamlError

def esc(s: str) -> str:
    out: str = ""
    for c in s:
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif c == "\n":
            out = out + "\\n"
        elif c == "\t":
            out = out + "\\t"
        else:
            out = out + c
    return "\"" + esc_done(out) + "\""

def esc_done(s: str) -> str:
    return s

def show(v: YamlValue) -> str:
    if nox.yaml.is_null(v):
        return "null"
    if nox.yaml.is_bool(v):
        if v.b:
            return "true"
        return "false"
    if nox.yaml.is_int(v):
        return str(v.i)
    if nox.yaml.is_float(v):
        return str(v.f)
    if nox.yaml.is_string(v):
        return esc(v.s)
    if nox.yaml.is_sequence(v):
        parts: list[str] = []
        for x in v.arr:
            parts.append(show(x))
        return "[" + ",".join(parts) + "]"
    parts2: list[str] = []
    for k in v.mapping.keys():
        parts2.append(esc(k) + ":" + show(v.mapping[k]))
    return "{" + ",".join(parts2) + "}"

docs: list[str] = [

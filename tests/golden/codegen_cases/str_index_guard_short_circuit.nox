def probe(text: str) -> str:
    result: str = ""
    pos: int = 0
    n: int = len(text)
    while pos < n and text[pos] != "X":
        pos = pos + 1
    if pos < n:
        result = "found_at:" + str(pos)
    else:
        result = "not_found"
    return result

print(probe("abcXyz"))
print(probe("abcdef"))
print(probe(""))

from nox.collections import LRUCache, Heap, PriorityQueue

lru: LRUCache[str, int] = LRUCache[str, int](2)
lru.put("a", 1)
lru.put("b", 2)
lru.get("a")
lru.put("c", 3)
print(lru.contains("a"))
print(lru.contains("b"))
print(lru.contains("c"))

h: Heap[int] = Heap[int]()
h.push(5)
h.push(1)
h.push(3)
h.push(2)
h.push(4)
print(h.pop_min())
print(h.pop_min())
print(h.pop_min())
print(h.pop_min())
print(h.pop_min())

pq: PriorityQueue[str] = PriorityQueue[str]()
pq.push(5, "five")
pq.push(1, "one")
pq.push(3, "three")
print(pq.pop_min())
print(pq.pop_min())
print(pq.pop_min())

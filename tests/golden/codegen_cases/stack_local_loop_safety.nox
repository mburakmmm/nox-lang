class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def compute(n: int) -> int:
    p: Point = Point(1, 2)
    xs: list[int] = [1, 2, 3, 4]
    total: int = 0
    i: int = 0
    while i < n:
        total = total + p.x + p.y
        for v in xs:
            total = total + v
        i = i + 1
    return total

print(compute(200000))

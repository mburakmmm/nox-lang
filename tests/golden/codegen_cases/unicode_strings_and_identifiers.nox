class Öğrenci:
    def __init__(self, ad: str, yaş: int) -> None:
        self.ad = ad
        self.yaş = yaş

    def selamla(self) -> str:
        return "Merhaba " + self.ad

def büyüt(x: int) -> int:
    return x * 2

ö: Öğrenci = Öğrenci("Çağrı", 30)
print(ö.selamla(), ö.yaş, büyüt(21))
print(ö)
名前: str = "x"
print(名前)
f: (int) -> int = büyüt
print(f(4))

s: str = "Çağrı ÖĞRENCİ straße ΑΒΓ привет"
print(s.upper())
print(s.lower())
print(s.capitalize())
print(s.title())
print(s.swapcase())
print("Straße".casefold(), "ΟΔΟΣ".lower(), "ΑΣ ΑΣ".lower(), "ǅ".lower(), "ß".upper())
print("héllo".isalpha(), "héllo1".isalpha(), "٣".isdigit(), "٣".isdecimal(), "²".isdigit(), "²".isdecimal(), "²".isnumeric(), "Ⅷ".isnumeric())
print("ÇAĞ".isupper(), "Çağ".isupper(), "çağ".islower(), "Ç1".isupper(), "".isupper())
print("　".isspace(), "é1".isalnum(), "é_".isalnum())

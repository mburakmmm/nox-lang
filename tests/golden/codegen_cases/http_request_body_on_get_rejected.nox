# Pulse HTTP-003: GET/DELETE ile boş olmayan gövde sessizce atılmaz, "invalid request" olarak reddedilir
# (ağa hiç çıkılmaz). Boş gövde geçerlidir ve normal bağlantı hatasına düşer.
import nox.http
from nox.http import HttpError, HttpResponse

h: dict[str, str] = {}
for method in ["GET", "DELETE", "HEAD", "OPTIONS"]:
    try:
        r: HttpResponse = nox.http.request(method, "http://127.0.0.1:1/", "payload", h, 1000)
        print(method + " accepted")
    except HttpError as e:
        print(method + ": " + e.message[0:15])
try:
    r2: HttpResponse = nox.http.request("GET", "http://127.0.0.1:1/", "", h, 1000)
    print("accepted")
except HttpError as e:
    print("empty body: " + e.message[0:14])

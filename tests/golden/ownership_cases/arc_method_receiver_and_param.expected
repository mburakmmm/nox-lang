[module]
  p: Point -> ARC (because it is the receiver of a method call)
    allocation: var_decl
    free: end of scope
[method Point.__init__]
  self: Point (parameter) -> ARC (parameter: it already crossed the function boundary)
    allocation: parameter
    free: end of scope
[method Point.length_sq]
  self: Point (parameter) -> ARC (parameter: it already crossed the function boundary)
    allocation: parameter
    free: end of scope

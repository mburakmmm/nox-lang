[module]
  (no heap-typed binding)
[function process]
  item: str (parameter) -> ARC (parameter: it already crossed the function boundary)
    allocation: parameter
    free: end of scope
[function build]
  a: str -> ARC (because it is added to a list literal)
    allocation: var_decl
    free: end of scope
  xs: list[str] -> ASAP (stays in scope (no escape detected))
    allocation: var_decl
    free: end of scope
  b: str -> ARC (because it is passed as an argument to a call)
    allocation: var_decl
    free: end of scope
  c: str -> ASAP (stays in scope (no escape detected))
    allocation: var_decl
    free: end of scope

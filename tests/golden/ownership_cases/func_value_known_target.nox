class Point:
    def __init__(self: Point, x: int, y: int) -> None:
        self.x = x
        self.y = y

def observe(p: Point) -> int:
    return p.x

def keep(p: Point) -> Point:
    return p

def use_known() -> int:
    f: (Point) -> int = observe
    pt: Point = Point(1, 2)
    return f(pt)

def use_closure() -> int:
    def inner(p: Point) -> int:
        return p.x
    f: (Point) -> int = inner
    pt: Point = Point(3, 4)
    return f(pt)

def use_ambiguous(flag: bool) -> int:
    f: (Point) -> int = observe
    if flag:
        f = observe
    pt: Point = Point(5, 6)
    return f(pt)

def use_param(f: (Point) -> int) -> int:
    pt: Point = Point(7, 8)
    return f(pt)

def use_keeps() -> int:
    f: (Point) -> Point = keep
    pt: Point = Point(9, 10)
    kept: Point = f(pt)
    return kept.x

def rec(p: Point) -> int:
    if p.x <= 0:
        return 0
    return p.x + rec(Point(p.x - 1, p.y))

def use_rec() -> int:
    f: (Point) -> int = rec
    pt: Point = Point(3, 1)
    return f(pt)

def rec_same(p: Point, n: int) -> int:
    if n <= 0:
        return p.x
    return rec_same(p, n - 1)

def use_rec_same() -> int:
    f: (Point, int) -> int = rec_same
    pt: Point = Point(4, 0)
    return f(pt, 3)

class Neg:
    def __init__(self) -> None:
        pass

def maybe(p: Point) -> int:
    if p.x < 0:
        raise Neg()
    return p.x

def use_except() -> int:
    f: (Point) -> int = maybe
    pt: Point = Point(5, 0)
    try:
        return f(pt)
    except Neg:
        return 0

def use_except_raise() -> int:
    f: (Point) -> int = maybe
    pt: Point = Point(-1, 0)
    try:
        return f(pt)
    except Neg:
        return 9

def use_alias() -> int:
    g: (Point) -> int = observe
    f: (Point) -> int = g
    pt: Point = Point(2, 0)
    return f(pt)

async def worker_s(s: str) -> int:
    return 1

async def use_spawn() -> int:
    s: str = "nox"
    t: Task[int] = spawn worker_s(s)
    return await t

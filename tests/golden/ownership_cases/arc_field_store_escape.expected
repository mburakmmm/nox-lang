[module]
  (no heap-typed binding)
[method Box.__init__]
  self: Box (parameter) -> ARC (parameter: it already crossed the function boundary)
    allocation: parameter
    free: end of scope
  seed: str (parameter) -> ARC (parameter: it already crossed the function boundary)
    allocation: parameter
    free: end of scope
  computed: str -> ARC (because it is assigned to a class field (self.<field>))
    allocation: var_decl
    free: end of scope

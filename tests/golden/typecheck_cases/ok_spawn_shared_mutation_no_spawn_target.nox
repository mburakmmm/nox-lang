def helper(xs: list[int]) -> None:
    xs.append(1)

class Counter:
    def __init__(self: Counter, n: int) -> None:
        self.n = n

    def bump(self: Counter) -> None:
        self.n = self.n + 1

xs: list[int] = [1, 2, 3]
helper(xs)
xs[0] = 99

d: dict[int, int] = {}
d[1] = 2

c: Counter = Counter(0)
c.bump()
c.n = 5

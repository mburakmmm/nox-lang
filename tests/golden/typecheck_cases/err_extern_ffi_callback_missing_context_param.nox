# v2.0 madde 2.3: v1'de '@ffi.callback' bir context_param argümanı OLMADAN
# desteklenmez (userdata yuvası taşımayan C API'leri kapsam dışı).
def add_ints(a: int, b: int) -> int:
    return a + b

@ffi.callback("cb")
extern def nox_ffi23_invoke(cb: (int, int) -> int, a: int, b: int) -> int from "fake_ffi23.o"

print(nox_ffi23_invoke(add_ints, 3, 4))

class MyErr:
    message: str
    def __init__(self, message: str) -> None:
        self.message = message

x: int = 1
def f() -> None:
    global x
    x = 2
    for i in [1]: print(i)
    else: print(0)
    try: x = 3
    except MyErr: x = 4
    else: x = 5
    a: int = 1; b: int = 2
    s: str = r"a\nb" "c"
    print(a, b, s)

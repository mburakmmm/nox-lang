protocol Named:
    def name(self) -> str:
        pass

protocol Owner:
    def pet(self) -> Named:
        pass

class Dog:
    def __init__(self) -> None:
        pass
    def name(self) -> str:
        return "dog"

class Person:
    def __init__(self) -> None:
        pass
    def pet(self) -> Named:
        return Dog()

xs: list[Owner] = [Person()]

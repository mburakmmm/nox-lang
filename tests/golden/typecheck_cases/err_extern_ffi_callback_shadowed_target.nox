# v2.0 madde 2.3: callback yuvasındaki argüman bir ÇIPLAK ÜST-DÜZEY
# fonksiyon adı olmalı — yerel bir değişken/parametre AYNI adı
# gölgeliyorsa (lambda/yakalayan closure'ların dolaylı BİR biçimi)
# reddedilir.
def add_ints(a: int, b: int) -> int:
    return a + b

@ffi.callback("cb", "userdata")
extern def nox_ffi23_invoke(cb: (int, int, ptr) -> int, a: int, b: int, userdata: ptr) -> int from "fake_ffi23.o"

def run() -> int:
    add_ints: int = 5
    return nox_ffi23_invoke(add_ints, 3, 4)

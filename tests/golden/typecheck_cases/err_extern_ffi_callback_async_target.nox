# v2.0 madde 2.3: callback hedefi bir 'async def' olamaz (senkron olmalı).
async def add_ints(a: int, b: int) -> int:
    return a + b

@ffi.callback("cb", "userdata")
extern def nox_ffi23_invoke(cb: (int, int, ptr) -> int, a: int, b: int, userdata: ptr) -> int from "fake_ffi23.o"

print(nox_ffi23_invoke(add_ints, 3, 4))

class P:
    n: int
    def __init__(self, n: int) -> None:
        self.n = n

xs: list[int] = [3, 1, 2]
xs.insert(0, 9)
xs.extend([4, 5])
xs.reverse()
xs.remove(9)
print(xs.index(3))
print(xs.count(1))
print(xs.pop(0))
del xs[0]
ys: list[int] = xs.copy() + xs
zs: list[int] = [0] * 3
ws: list[int] = 2 * zs
ps: list[P] = [P(1)]
ps.remove(P(1))
xs.clear()

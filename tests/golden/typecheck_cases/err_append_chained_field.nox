class Inner:
    def __init__(self: Inner) -> None:
        self.xs = [1]

class Outer:
    def __init__(self: Outer) -> None:
        self.inner = Inner()

def make() -> Outer:
    return Outer()

# Zincirin KÖKÜ bir isim değil, bir çağrı (geçici alıcı) — hâlâ reddedilir.
make().inner.xs.append(2)

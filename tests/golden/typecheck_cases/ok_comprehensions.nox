class P:
    n: int
    def __init__(self, n: int) -> None:
        self.n = n

xs: list[int] = [1, 2, 3]
sq: list[int] = [x * x for x in xs if x > 1]
ps: list[P] = [P(i) for i in range(3)]
d: dict[str, int] = {str(i): i for i in range(3)}
n: list[list[int]] = [[j for j in range(i)] for i in range(3)]
t: list[int] = [x if x > 1 else 0 for x in xs]
x: str = "shadow"
z: list[int] = [x for x in xs]

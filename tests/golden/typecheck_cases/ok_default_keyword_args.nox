class P:
    def __init__(self, x: int, y: int = 7) -> None:
        self.x = x
        self.y = y
    def m(self, k: int = 1) -> int:
        return k
def g(a: int, b: int = -2, c: float = 1.5, d: str = "s", e: bool = False, o: P | None = None) -> int:
    return a
p: P = P(1)
q: P = P(y=2, x=1)
print(g(1) + g(a=2, d="t") + p.m() + p.m(k=3))

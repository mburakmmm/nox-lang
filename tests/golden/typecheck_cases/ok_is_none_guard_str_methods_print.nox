def f(x: int | None) -> int:
    if x is None:
        return 0
    return x + 1
def g(a: int | None, b: int | None) -> int:
    if a is None or b is None:
        return 0
    return a + b
s: str = "a b"
parts: list[str] = s.split()
print("x", "y", sep=",", end="")
print(parts[0].upper(), s.find("b"), s.zfill(5))
y: int | None = 3
print(y is not None)

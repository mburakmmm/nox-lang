# v2.0 madde 2.2: `@ffi.escape("xs")` GERÇEK bir parametre adını gösteriyor
# — `retains(xs)`ın decorator-sözdizimli eşdeğeri, `OK` beklenir.
@ffi.escape("xs")
extern def nox_ffi22_take_list(xs: list[int]) -> None from "fake_ffi22.o"

def compute() -> int:
    xs: list[int] = [1, 2, 3]
    nox_ffi22_take_list(xs)
    return len(xs)

print(compute())

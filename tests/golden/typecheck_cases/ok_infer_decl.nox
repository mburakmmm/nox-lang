class P:
    x: int
    def __init__(self: P, x: int) -> None:
        self.x = x

def find(xs: list[int], k: int) -> int | None:
    for v in xs:
        if v == k:
            return v
    return None

def f() -> None:
    n := 5
    r := 1.5
    s := "hi"
    b := n > 3
    p := P(1)
    xs := [1, 2, 3]
    d := {"a": 1}
    t := (1, "x")
    o := find(xs, 2)
    m := f"n={n}"
    n = n + 1
    print(r, s, b, p.x, d["a"], t[0], m)
    if o is not None:
        print(o + 1)

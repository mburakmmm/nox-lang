# v2.0 madde 2.3: callback yuvasındaki argüman salt bir tanımlayıcı OLMALI
# — bir metod referansı (bound method) gibi başka HERHANGİ bir ifade
# reddedilir.
class Adder:
    def add(self, a: int, b: int) -> int:
        return a + b

def add_ints(a: int, b: int) -> int:
    return a + b

@ffi.callback("cb", "userdata")
extern def nox_ffi23_invoke(cb: (int, int, ptr) -> int, a: int, b: int, userdata: ptr) -> int from "fake_ffi23.o"

e: Adder = Adder()
print(nox_ffi23_invoke(e.add, 3, 4))

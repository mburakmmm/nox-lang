# nox.postgres — libpq'ya `std.DynLib` (dlopen/dlsym, ÇALIŞMA ZAMANINDA,
# TEMBEL) İLE bağlanan bir PostgreSQL sürücüsü — `nox.sqlite`nin BİREBİR
# AYNI şablonu (bkz. proje belleği "4 yeni stdlib modülü" planı): TÜM
# postgres erişimi `runtime/stdlib_shims/postgres.zig`nin `nox_pg_*_raw`
# sarmalayıcılarından geçer, bu dosyada `from "pq"` İÇEREN TEK BİR `extern
# def` bile YOK — `libpq` yalnızca GERÇEKTEN `nox.postgres.open()`
# ÇAĞRILDIĞINDA yüklenir, KURULU DEĞİLSE (nadir ama olası) temiz bir
# `PostgresError` fırlatılır (ÇÖKME YOK), `libpq` KULLANMAYAN HİÇBİR Nox
# programı ETKİLENMEZ.
#
# `open(conninfo)`: `PQconnectdb` HEM keyword-value (`"host=localhost
# user=postgres dbname=mydb"`) HEM URI (`"postgres://user:pass@host:port/
# db"`) bağlantı dizesini NATİF kabul eder — ham dize DOĞRUDAN iletilir,
# AYRI bir DSN ayrıştırıcısı YOK.
#
# **Faz NN.4 (bkz. proje belleği "nyx v2 limitasyon listesi doğrulaması"):**
# `Statement` sınıfı İLE PARAMETRELİ (`$1`/`$2`/...) sorgu ARTIK
# DESTEKLENİYOR — `Connection.prepare(sql)` bir `Statement` döner,
# `bind_int`/`bind_float`/`bind_str`/`bind_null` çağrıları BİRİKTİRİLİR
# (libpq'nun `PQexecParams`i sqlite'ın AKSİNE TEK bir çağrıda TÜM
# parametreleri istediğinden — "biriktir-sonra-ateşle" — sqlite.nox'un
# GERÇEK artımlı bind'inden FARKLI ama KULLANICI API'si AYNI ŞEKİLDE
# görünür), gerçek `PQexecParams` çağrısı `execute()`/`query()` anında
# yapılır. `last_insert_rowid()` YOK — Postgres'in KENDİ idiyomu `INSERT
# ... RETURNING id` yazıp sonucu `query()`den OKUMAKTIR (bu, hâlâ bilinçli
# bir v1 sınırlaması — `nox_pg_*` shim'i `PQprepare`/adlandırılmış hazır
# deyimleri KULLANMAZ, HER `Statement.execute()`in kendi `PQexecParams`
# çağrısı BAĞIMSIZDIR, sunucu tarafında ismi olan bir "prepared statement"
# YOK).

# Faz OO: `Row` ARTIK `nox.db`den PAYLAŞILAN — bkz. `db.nox`nin belge
# notu (`DbConnection` protokolünün `query`yi KAPSAYABİLMESİNİN nedeni).
from nox.db import Row, Statement

extern def nox_pg_connect_raw(conninfo: str) -> ptr from "zig-out/lib/noxrt.o"
extern def nox_pg_status_ok_raw(conn: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_errmsg_raw(conn: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_pg_finish_raw(conn: ptr) -> None from "zig-out/lib/noxrt.o"
extern def nox_pg_exec_raw(conn: ptr, query: str) -> ptr from "zig-out/lib/noxrt.o"
extern def nox_pg_set_timeout_raw(conn: ptr, ms: int) -> None from "zig-out/lib/noxrt.o"
extern def nox_pg_cancel_raw(conn: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_exec_params_raw(conn: ptr, query: str, params: list[str], null_flags: list[str]) -> ptr from "zig-out/lib/noxrt.o"
extern def nox_pg_result_ok_raw(res: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_result_errmsg_raw(res: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_pg_result_field_raw(res: ptr, code: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_pg_ntuples_raw(res: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_nfields_raw(res: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_fname_raw(res: ptr, col: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_pg_getvalue_raw(res: ptr, row: int, col: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_pg_getisnull_raw(res: ptr, row: int, col: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_changes_raw(res: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_pg_clear_raw(res: ptr) -> None from "zig-out/lib/noxrt.o"
extern def nox_pg_is_null_ptr(p: ptr) -> int from "zig-out/lib/noxrt.o"

# Hata ayrımı (Ember NL-006): sunucu hatalarında `sqlstate` (5 karakter, ör. "23505"), `severity`, `detail`, `hint`, `table`, `column` ve `constraint`
# doldurulur; bağlantı kurulamadığında/koptuğunda `sqlstate` boştur ve `kind == "connection"`. Hata iletisini ayrıştırmak YERİNE `kind`/`is_*` kullanın.
# `kind`: "unique_violation" (23505), "foreign_key_violation" (23503), "not_null_violation" (23502), "check_violation" (23514),
# "serialization_failure" (40001), "deadlock" (40P01), "query_canceled" (57014: `statement_timeout`/iptal), "connection" (08xxx, 57P01-57P03, bağlantı hatası),
# "other".
class PostgresError(Exception):
    sqlstate: str
    severity: str
    detail: str
    hint: str
    table: str
    column: str
    constraint: str
    kind: str

    def __init__(self: PostgresError, message: str, sqlstate: str = "", severity: str = "", detail: str = "", hint: str = "", table: str = "", column: str = "", constraint: str = "", kind: str = "") -> None:
        super().__init__(message)
        self.sqlstate = sqlstate
        self.severity = severity
        self.detail = detail
        self.hint = hint
        self.table = table
        self.column = column
        self.constraint = constraint
        if len(kind) > 0:
            self.kind = kind
        else:
            self.kind = _kind_for_sqlstate(sqlstate)

    def is_unique_violation(self: PostgresError) -> bool:
        return self.kind == "unique_violation"

    def is_serialization_failure(self: PostgresError) -> bool:
        return self.kind == "serialization_failure"

    def is_deadlock(self: PostgresError) -> bool:
        return self.kind == "deadlock"

    def is_query_canceled(self: PostgresError) -> bool:
        return self.kind == "query_canceled"

    def is_connection_error(self: PostgresError) -> bool:
        return self.kind == "connection"

    # Aynı işlemi (yeni bir işlemde) yeniden denemek anlamlı mı? Serileştirme hatası ve kilitlenme: evet. Bağlantı hatası için yeni bir bağlantı gerekir.
    def is_retryable(self: PostgresError) -> bool:
        return self.kind == "serialization_failure" or self.kind == "deadlock"

def _kind_for_sqlstate(sqlstate: str) -> str:
    if sqlstate == "23505":
        return "unique_violation"
    if sqlstate == "23503":
        return "foreign_key_violation"
    if sqlstate == "23502":
        return "not_null_violation"
    if sqlstate == "23514":
        return "check_violation"
    if sqlstate == "40001":
        return "serialization_failure"
    if sqlstate == "40P01":
        return "deadlock"
    if sqlstate == "57014":
        return "query_canceled"
    if sqlstate.startswith("08") or sqlstate == "57P01" or sqlstate == "57P02" or sqlstate == "57P03":
        return "connection"
    return "other"

# Başarısız bir sonuçtan yapılandırılmış `PostgresError` kurar ve sonucu serbest bırakır (çağıran `raise` eder). `prefix`: "query failed: " gibi.
def _pg_error(res: ptr, prefix: str) -> PostgresError:
    msg: str = nox_pg_result_errmsg_raw(res)
    err: PostgresError = PostgresError(prefix + msg, nox_pg_result_field_raw(res, 67), nox_pg_result_field_raw(res, 83), nox_pg_result_field_raw(res, 68), nox_pg_result_field_raw(res, 72), nox_pg_result_field_raw(res, 116), nox_pg_result_field_raw(res, 99), nox_pg_result_field_raw(res, 110))
    nox_pg_clear_raw(res)
    return err

def _read_rows(res: ptr) -> list[Row]:
    nrows: int = nox_pg_ntuples_raw(res)
    ncols: int = nox_pg_nfields_raw(res)
    names: list[str] = []
    c: int = 0
    while c < ncols:
        names.append(nox_pg_fname_raw(res, c))
        c = c + 1

    rows: list[Row] = []
    r: int = 0
    while r < nrows:
        values: list[str] = []
        is_null_flags: list[bool] = []
        c2: int = 0
        while c2 < ncols:
            is_null: bool = nox_pg_getisnull_raw(res, r, c2) != 0
            value: str = ""
            if not is_null:
                value = nox_pg_getvalue_raw(res, r, c2)
            values.append(value)
            is_null_flags.append(is_null)
            c2 = c2 + 1
        rows.append(Row(values, is_null_flags, names))
        r = r + 1
    return rows

# Faz STD.6: `Statement` artık `nox.db`den PAYLAŞILAN, BİRLEŞİK bir sınıf
# (bkz. `db.nox`nin belge notu) — bu dispatch fonksiyonları ONUN
# `bind_int_fn`/vb. alanlarına `prepare()` TARAFINDAN ENJEKTE EDİLİR. İÇ
# MEKANİZMA DEĞİŞMEDİ: `bind_*` çağrıları sadece `stmt.params`/`stmt.
# null_flags`e EKLER (libpq'nun `PQexecParams`i TÜM parametreleri TEK
# çağrıda istediğinden gerçek artımlı bind YOK) — `idx` parametresi bu
# YÜZDEN KULLANILMAZ (SADECE eklenme SIRASI ÖNEMLİDİR).
def _pg_push(stmt: Statement, value: str, is_null: bool) -> None:
    params: list[str] = stmt.params
    params.append(value)
    stmt.params = params
    null_flags: list[bool] = stmt.null_flags
    null_flags.append(is_null)
    stmt.null_flags = null_flags

def _pg_bind_int(stmt: Statement, idx: int, value: int) -> None:
    _pg_push(stmt, str(value), False)

def _pg_bind_float(stmt: Statement, idx: int, value: float) -> None:
    _pg_push(stmt, str(value), False)

def _pg_bind_str(stmt: Statement, idx: int, value: str) -> None:
    _pg_push(stmt, value, False)

def _pg_bind_null(stmt: Statement, idx: int) -> None:
    _pg_push(stmt, "", True)

# `nox_pg_exec_params_raw`nin `null_flags` parametresi `list[str]`
# ("1"/"0") BEKLER (checker'ın FFI sınırı `list[bool]`e İZİN VERMEZ,
# bkz. o extern def'in belge notu) — `stmt.null_flags: list[bool]`
# (PAYLAŞILAN `Statement`in KENDİ tipi) BURADA metne ÇEVRİLİR.
def _pg_exec_params(stmt: Statement) -> ptr:
    str_flags: list[str] = []
    i: int = 0
    while i < len(stmt.null_flags):
        if stmt.null_flags[i]:
            str_flags.append("1")
        else:
            str_flags.append("0")
        i = i + 1
    return nox_pg_exec_params_raw(stmt.handle, stmt.sql, stmt.params, str_flags)

def _pg_execute(stmt: Statement) -> int:
    res: ptr = _pg_exec_params(stmt)
    if nox_pg_result_ok_raw(res) == 0:
        raise _pg_error(res, "statement failed: ")
    n: int = nox_pg_changes_raw(res)
    nox_pg_clear_raw(res)
    return n

def _pg_query(stmt: Statement) -> list[Row]:
    res: ptr = _pg_exec_params(stmt)
    if nox_pg_result_ok_raw(res) == 0:
        raise _pg_error(res, "query failed: ")
    rows: list[Row] = _read_rows(res)
    nox_pg_clear_raw(res)
    return rows

# Faz STD.6: Postgres (mysql/sqlite'ın AKSİNE) YALNIZCA numaralı `$1,
# $2, ...` placeholder KABUL EDER — `nox.orm`/kullanıcıların TÜM sürücüler
# İçİn TEK, TUTARLI bir "?" sözdizimi yazabilmesi İçİn `prepare()` HER
# `?`yi SIRAYLA `$1`,`$2`,... İLE DEĞİŞTİRİR. `mysql.nox`nin `_build_sql`ı
# İLE AYNI, naif/tırnak-farkında OLMAYAN karakter-karakter yaklaşım
# (BİLİNÇLİ tutarlılık — bir string LİTERALİ İçİNDEKİ "?" de değişir).
# MEVCUT, `$1`-tarzı NATİF SQL yazan çağrı siteleri ETKİLENMEZ (metinde
# HİÇ "?" karakteri OLMADIĞINDAN bu fonksiyon bir NO-OP'tur).
def _translate_placeholders_to_dollar(sql: str) -> str:
    result: str = ""
    param_num: int = 0
    i: int = 0
    n: int = len(sql)
    while i < n:
        c: str = sql[i]
        if c == "?":
            param_num = param_num + 1
            result = result + "$" + str(param_num)
        else:
            result = result + c
        i = i + 1
    return result

class Connection:
    def __init__(self: Connection, handle: ptr) -> None:
        self.handle = handle

    def prepare(self: Connection, sql: str) -> Statement:
        translated: str = _translate_placeholders_to_dollar(sql)
        return Statement(self.handle, self.handle, translated, _pg_bind_int, _pg_bind_float, _pg_bind_str, _pg_bind_null, _pg_execute, _pg_query)

    # Etkilenen satır sayısını döner (`INSERT`/`UPDATE`/`DELETE`/DDL İçin
    # `0`) — Postgres'te bu bir SONUÇ özelliğidir (sqlite'ın `sqlite3_
    # changes(db)`si GİBİ AYRI bir bağlantı-durumu DEĞİL), bu YÜZDEN
    # `execute`in KENDİSİ döner, ayrı bir `changes()` metoduna GEREK YOK.
    def execute(self: Connection, sql: str) -> int:
        res: ptr = nox_pg_exec_raw(self.handle, sql)
        if nox_pg_result_ok_raw(res) == 0:
            raise _pg_error(res, "statement failed: ")
        n: int = nox_pg_changes_raw(res)
        nox_pg_clear_raw(res)
        return n

    def query(self: Connection, sql: str) -> list[Row]:
        res: ptr = nox_pg_exec_raw(self.handle, sql)
        if nox_pg_result_ok_raw(res) == 0:
            raise _pg_error(res, "query failed: ")
        rows: list[Row] = _read_rows(res)
        nox_pg_clear_raw(res)
        return rows

    def close(self: Connection) -> None:
        nox_pg_finish_raw(self.handle)

    # Bağlantı hâlâ kullanılabilir durumda mı (kopmamış/bozulmamış)? Havuz bozuk bağlantıyı bununla ayıklar.
    def is_ok(self: Connection) -> bool:
        return nox_pg_status_ok_raw(self.handle) != 0

    # Sunucu tarafı sorgu zaman aşımı: `ms` milisaniyeyi aşan her deyim sunucuca iptal edilir ve `PostgresError` (`kind == "query_canceled"`, 57014)
    # olarak döner; bağlantı kullanılabilir kalır. `0` sınırı kaldırır.
    def set_statement_timeout(self: Connection, ms: int) -> None:
        self.execute("SET statement_timeout = " + str(ms))

    # İstemci tarafı sorgu zaman aşımı: `ms` milisaniyeyi aşan her deyim `PQcancel` ile iptal edilir (sunucu `kind == "query_canceled"` döner) ve bağlantı kullanılabilir kalır.
    # `statement_timeout`un aksine sunucu yanıt veremese de çalışır (sunucuya ayrı kısa bir iptal bağlantısı açılır). `0` sınırı kaldırır.
    # Mobil/wasm saf Zig istemcisinde etkisizdir (sunucu tarafı `set_statement_timeout` kullanın).
    def set_query_timeout(self: Connection, ms: int) -> None:
        nox_pg_set_timeout_raw(self.handle, ms)

    # Çalışan bir sorguyu başka bir görevden/iş parçacığından iptal eder; başarıyla istenirse True (sorgu o sırada çalışmıyorsa etkisizdir). Çalışan sorgu
    # `PostgresError(kind == "query_canceled")` ile döner. İptal isteği için sunucuya ayrı bir bağlantı açıldığından çağıranı kısa süre bloklar.
    def cancel(self: Connection) -> bool:
        return nox_pg_cancel_raw(self.handle) == 1

    # Kilit bekleme sınırı (aynı biçimde, `kind == "query_canceled"`... kilit zaman aşımı 55P03 → "other").
    def set_lock_timeout(self: Connection, ms: int) -> None:
        self.execute("SET lock_timeout = " + str(ms))

    # `with conn.transaction() as tx:` — bkz. `Transaction`.
    def transaction(self: Connection) -> Transaction:
        return Transaction(self)

# Kapsam korumalı işlem: `with conn.transaction() as tx:` BEGIN yapar; gövde `tx.commit()` çağırmadan biterse (dönüş, istisna, `break`) `__exit__`
# ROLLBACK yapar. Nox'ta `__exit__` istisnayı görmez, bu yüzden "açıkça commit edilmeyen işlem geri alınır" kuralı kullanılır (Go'nun `defer tx.Rollback()` idiyomu).
# ROLLBACK'in kendisi başarısız olursa (bağlantı koptu) hata yutulur: sunucu zaten işlemi sonlandırmıştır.
class Transaction:
    conn: Connection
    active: bool

    def __init__(self: Transaction, conn: Connection) -> None:
        self.conn = conn
        self.active = False

    def __enter__(self: Transaction) -> Transaction:
        self.conn.execute("BEGIN")
        self.active = True
        return self

    def execute(self: Transaction, sql: str) -> int:
        return self.conn.execute(sql)

    def query(self: Transaction, sql: str) -> list[Row]:
        return self.conn.query(sql)

    def prepare(self: Transaction, sql: str) -> Statement:
        return self.conn.prepare(sql)

    def commit(self: Transaction) -> None:
        if self.active:
            self.active = False
            self.conn.execute("COMMIT")

    def rollback(self: Transaction) -> None:
        if self.active:
            self.active = False
            self.conn.execute("ROLLBACK")

    def __exit__(self: Transaction) -> None:
        if self.active:
            self.active = False
            try:
                self.conn.execute("ROLLBACK")
            except PostgresError as e:
                pass

def open(conninfo: str) -> Connection:
    handle: ptr = nox_pg_connect_raw(conninfo)
    if nox_pg_is_null_ptr(handle) != 0:
        raise PostgresError("could not connect (libpq may have failed to load): " + conninfo, "", "", "", "", "", "", "", "connection")
    if nox_pg_status_ok_raw(handle) == 0:
        msg: str = nox_pg_errmsg_raw(handle)
        nox_pg_finish_raw(handle)
        raise PostgresError("connection failed: " + msg, "", "", "", "", "", "", "", "connection")
    return Connection(handle)


# Sınırlı bağlantı havuzu (Ember NL-007). `acquire()` boş bir bağlantı verir (gerekirse en çok `size` bağlantıya kadar yenisini açar); havuz doluysa
# başka bir görev `give_back` edene kadar KOOPERATİF bekler (`acquire_timeout_ms` sonra `PostgresError`, `kind == "other"`). Bozuk (kopmuş) bağlantılar
# `give_back`te ayıklanır, sıradaki `acquire` yenisini açar. İç durum atomik bir kilitle korunur: havuz, M:N zamanlayıcıdaki farklı işçilerde koşan
# görevler arasında paylaşılabilir. Bir bağlantı AYNI ANDA tek göreve verilir; bağlantıyı görevler arasında paylaşmayın.
#
#     pool: Pool = nox.postgres.pool("host=... dbname=...", 4, 5000)
#     c: Connection = pool.acquire()
#     try:
#         rows: list[Row] = c.query("SELECT 1")
#     finally:
#         pool.give_back(c)
import nox.atomic
import nox.time

class Pool:
    conninfo: str
    size: int
    acquire_timeout_ms: int
    idle: list[Connection]
    opened: int
    lock: nox.atomic.AtomicInt

    def __init__(self: Pool, conninfo: str, size: int, acquire_timeout_ms: int) -> None:
        self.conninfo = conninfo
        self.size = size
        self.acquire_timeout_ms = acquire_timeout_ms
        self.idle = []
        self.opened = 0
        self.lock = nox.atomic.new_int(0)

    def _lock(self: Pool) -> None:
        spins: int = 0
        while not self.lock.compare_and_swap(0, 1):
            spins = spins + 1
            if spins > 20:
                nox.time.sleep_ms(1)

    def _unlock(self: Pool) -> None:
        self.lock.store(0)

    # Boş bağlantıyı al, yoksa (sınır altındaysa) yenisini aç, yoksa bekle.
    def acquire(self: Pool) -> Connection:
        started: nox.time.Instant = nox.time.instant_now()
        poll: int = 1
        while True:
            self._lock()
            reuse: bool = len(self.idle) > 0
            candidate: Connection | None = None
            if reuse:
                idle: list[Connection] = self.idle
                candidate = idle.pop()
                self.idle = idle
            can_open: bool = (not reuse) and self.opened < self.size
            if can_open:
                self.opened = self.opened + 1
            self._unlock()
            if candidate is not None:
                if candidate.is_ok():
                    return candidate
                candidate.close()
                self._lock()
                self.opened = self.opened - 1
                self._unlock()
            elif can_open:
                try:
                    return open(self.conninfo)
                except PostgresError as e:
                    self._lock()
                    self.opened = self.opened - 1
                    self._unlock()
                    raise e
            else:
                if started.elapsed_ms() >= self.acquire_timeout_ms:
                    raise PostgresError("connection pool exhausted: no connection became free within " + str(self.acquire_timeout_ms) + " ms")
                nox.time.sleep_ms(poll)
                if poll < 10:
                    poll = poll * 2
        raise PostgresError("unreachable")

    # Bağlantıyı havuza geri ver. Bozuksa kapatılır ve sayaçtan düşülür (açık işlem varsa önce ROLLBACK denenir).
    def give_back(self: Pool, conn: Connection) -> None:
        healthy: bool = conn.is_ok()
        if healthy:
            try:
                conn.execute("ROLLBACK")
            except PostgresError as e:
                healthy = False
        self._lock()
        if healthy:
            idle: list[Connection] = self.idle
            idle.append(conn)
            self.idle = idle
        else:
            self.opened = self.opened - 1
        self._unlock()
        if not healthy:
            conn.close()

    # Boştaki tüm bağlantıları kapatır (kullanımdaki bağlantılar `give_back`te havuza girmeye devam eder).
    def close(self: Pool) -> None:
        self._lock()
        idle: list[Connection] = self.idle
        self.idle = []
        self.opened = self.opened - len(idle)
        self._unlock()
        for c in idle:
            c.close()

    # Şu an boşta bekleyen ve toplam açık bağlantı sayısı (tanı/test için).
    def idle_count(self: Pool) -> int:
        return len(self.idle)

    def open_count(self: Pool) -> int:
        return self.opened

def pool(conninfo: str, size: int, acquire_timeout_ms: int) -> Pool:
    if size <= 0:
        raise PostgresError("pool size must be positive")
    return Pool(conninfo, size, acquire_timeout_ms)

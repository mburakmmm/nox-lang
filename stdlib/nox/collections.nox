# nox.collections — genel amaçlı veri yapıları (Stack/Queue/Deque/Set/
# Counter/OrderedDict/LRUCache/Heap/PriorityQueue), TAMAMEN saf Nox
# (extern def YOK) — `class Foo[T, ...]:` (Faz P2.1, ARİTE-GENEL generic
# sınıflar) üzerine inşa edilir.
#
# **Bilinçli v1 tasarım kısıtı:** Nox'ta kullanıcı sınıfları İçin `__hash__`
# YOK (`==` HER ZAMAN derleyici-üretimi ALAN-ALANA yapısal karşılaştırma,
# bkz. `codegen_qbe/layout.zig`nin `$ClassName_eq`ı) — bu YÜZDEN `Set[T]`/
# `Counter[T]`/`OrderedDict[K,V]`/`LRUCache[K,V]` native `dict[K,V]`e
# DAYANAMAZ (`dict`in KENDİ anahtar/değer tipi `int`/`bool`/`str`/`float`
# İLE SINIRLI, bkz. checker.zig). Bunun yerine `list[T]` üzerinde DOĞRUSAL
# TARAMA (`==` İLE) kullanılır — O(n) per işlem, ama HERHANGİ bir `T`/`K`
# İçin doğru (sınıflar DAHİL). Daha hızlı, `str`/`int` anahtarlarla
# SINIRLI bir varyant istenirse (native `dict` üzerine), bu AYRI bir
# gelecek görev olabilir — bu modül BİLİNÇLİ olarak genelliği tercih eder.
#
# v1.142.20: `Set[T]`/`Counter[T]`/`OrderedDict[K,V]` ARTIK doğrusal tarama YERİNE açık adresli bir
# KARMA indeksi kullanır (ekleme/arama ortalama O(1); 100K farklı öğede inşa O(n²) → O(n)). Karma
# dahili `__nox_hash` ilkelinden gelir: int/bool/sabit-genişlikli/float/str için gerçek karma,
# DİĞER tipler (sınıf/liste/...) için 0 — bu tiplerde tüm öğeler tek kovaya düşer (eski doğrusal
# davranış, DOĞRU ama yavaş). Eşitlik HER ZAMAN `==` ile (sınıflar için yapısal) doğrulanır.
#
# `Heap[T]`/`PriorityQueue[T]`: Nox'ta kullanıcı-tanımlı `__lt__` YOK
# (`list.sort()`nin AYNI kısıtı) — `Heap[T]`, `T`yi `<` operatörünün
# ZATEN desteklediği tiplerle (int/float/str) SOMUTLAŞTIĞINDA doğal
# olarak tip kontrolünden GEÇER; sınıf tipli `T` İLE somutlaştırılırsa
# `<` KENDİSİ derleme zamanında reddedilir (EK bir kısıt kodu YAZILMADI,
# dilin KENDİ operatör tipi kontrolü yeterli). `PriorityQueue[T]` bunun
# TERSİNE `T` üzerinde HİÇ karşılaştırma yapmaz (yalnızca ayrı bir
# `priority: int` alanı üzerinde) — bu YÜZDEN `T` KEYFİ olabilir (sınıflar
# DAHİL).
#
# `.append()`in AKSİNE (alıcısı ÇIPLAK bir isim OLMAK ZORUNDA, bkz.
# `codegen_qbe/calls.zig`nin `genListAppend`ı), YENİ `.pop()` ilkeli
# (bu oturumda eklendi) HİÇBİR ZAMAN yeniden ayırmadığından `self.field.
# pop()` GİBİ keyfi bir alıcı üzerinde DOĞRUDAN çalışır — bu modülde
# HER `.append()` çağrısından ÖNCE hâlâ "yerele kopyala → mutasyona
# uğrat → geri yaz" deseni (bkz. `stdlib/nox/router.nox`nin `Router.add`ı)
# UYGULANIR, ama `.pop()`/indeksleme (`xs[i]`/`xs[i] = v`)/`len(xs)`
# HİÇBİRİ bu dansı GEREKTİRMEZ (doğrudan `self.field` üzerinde çağrılır).
#
# Nox'ta `break`/`continue` YOK — döngü-içi erken-çıkış TÜM metodlarda
# bir `active: bool` bayrağıyla (`while cond and active:`) taklit edilir.

# ---------------------------------------------------------------------
# Dahili karma indeksi (Set/Counter/OrderedDict): `slots` açık adresli, 2'nin kuvveti uzunluklu bir
# `list[int]` (0 = boş, değer = `items` indeksi + 1), doğrusal problama, yük <= 0.5. Yardımcılar
# `.append()` ÇAĞIRMAZ (parametre listesine append desteklenmez); büyütme/yeniden kurma çağıranın
# yerel dansıyla yapılır.
def _hx_find_h[T](items: list[T], slots: list[int], v: T, h: int) -> int:
    cap: int = len(slots)
    if cap == 0:
        return -1
    mask: int = cap - 1
    pos: int = h & mask
    probes: int = 0
    while probes < cap:
        s: int = slots[pos]
        if s == 0:
            return -1
        # s < 0: silinmiş slot (mezar taşı) — zincir sürer.
        if s > 0 and items[s - 1] == v:
            return s - 1
        pos = (pos + 1) & mask
        probes = probes + 1
    return -1

# 2.2 aşama 12: karma değeri çağıran tarafından bir kez hesaplanıp `find` ve `place`e verilir (önceden `add` yolu `__nox_hash`i iki kez çağırıyordu).
def _hx_find[T](items: list[T], slots: list[int], v: T) -> int:
    return _hx_find_h(items, slots, v, __nox_hash(v))

# `_hx_find` gibi, ama bulunan SLOTUN konumunu döndürür (silme için); yoksa -1.
def _hx_find_slot_h[T](items: list[T], slots: list[int], v: T, h: int) -> int:
    cap: int = len(slots)
    if cap == 0:
        return -1
    mask: int = cap - 1
    pos: int = h & mask
    probes: int = 0
    while probes < cap:
        s: int = slots[pos]
        if s == 0:
            return -1
        if s > 0 and items[s - 1] == v:
            return pos
        pos = (pos + 1) & mask
        probes = probes + 1
    return -1

def _hx_find_slot[T](items: list[T], slots: list[int], v: T) -> int:
    return _hx_find_slot_h(items, slots, v, __nox_hash(v))

def _hx_place(slots: list[int], h: int, idx: int) -> None:
    mask: int = len(slots) - 1
    pos: int = h & mask
    while slots[pos] != 0:
        pos = (pos + 1) & mask
    slots[pos] = idx + 1

def _hx_rebuild[T](items: list[T], cap: int) -> list[int]:
    slots: list[int] = [0] * cap  # tek tahsis + sıfırlama (cap kez append(0) 20x yavaştı)
    j: int = 0
    while j < len(items):
        _hx_place(slots, __nox_hash(items[j]), j)
        j = j + 1
    return slots

# `n_items` öğe için en az 2*n_items uzunlukta, en az 16 olan 2'nin kuvveti.
def _hx_cap_for(n_items: int, cur_cap: int) -> int:
    cap: int = cur_cap
    if cap < 16:
        cap = 16
    while cap < n_items * 2:
        cap = cap * 2
    return cap

# ---------------------------------------------------------------------
# Stack[T] — LIFO, dogrudan list[T] uzerinde.
class Stack[T]:
    items: list[T]

    def __init__(self: Stack) -> None:
        self.items = []

    def push(self: Stack, v: T) -> None:
        self.items.append(v)

    def pop(self: Stack) -> T:
        return self.items.pop()

    def peek(self: Stack) -> T:
        return self.items[len(self.items) - 1]

    def is_empty(self: Stack) -> bool:
        return len(self.items) == 0

    def size(self: Stack) -> int:
        return len(self.items)

# ---------------------------------------------------------------------
# Queue[T] — FIFO, klasik "iki-yigin" hilesiyle amortize O(1) (bkz.
# modul basligi). `inbox`a push edilir; `outbox` bosaldiginda `inbox`in
# TAMAMI (`.pop()` ile, ters sirada) `outbox`a aktarilir.
class Queue[T]:
    inbox: list[T]
    outbox: list[T]

    def __init__(self: Queue) -> None:
        self.inbox = []
        self.outbox = []

    def push(self: Queue, v: T) -> None:
        self.inbox.append(v)

    # `inbox`ın TAMAMI tek `reverse()` ile `outbox`a taşınır (yalnızca `outbox` boşken çağrılır).
    def _shift(self: Queue) -> None:
        moved: list[T] = self.inbox
        moved.reverse()
        self.outbox = moved
        self.inbox = []

    def pop(self: Queue) -> T:
        if len(self.outbox) == 0:
            self._shift()
        return self.outbox.pop()

    def peek(self: Queue) -> T:
        if len(self.outbox) == 0:
            self._shift()
        return self.outbox[len(self.outbox) - 1]

    def is_empty(self: Queue) -> bool:
        return len(self.inbox) == 0 and len(self.outbox) == 0

    def size(self: Queue) -> int:
        return len(self.inbox) + len(self.outbox)

# ---------------------------------------------------------------------
# Deque[T] — her iki ucta da amortize O(1), Queue'nun IKI-YONLU hali:
# `front`/`back` iki liste, biri bosaldiginda DIGERININ TAMAMI (ters
# sirada) aktarilir.
class Deque[T]:
    front: list[T]
    back: list[T]

    def __init__(self: Deque) -> None:
        self.front = []
        self.back = []

    def push_front(self: Deque, v: T) -> None:
        self.front.append(v)

    def push_back(self: Deque, v: T) -> None:
        self.back.append(v)

    # Boşalan uç için öbür uçtaki TÜM elemanlar tek `reverse()` ile (eleman eleman pop/append değil) taşınır: sıra korunur, maliyet tek bellek taraması.
    # Yalnızca ilgili uç BOŞKEN çağrılır (`pop_*`/`peek_*`), bu yüzden hedef liste doğrudan değiştirilir.
    def _drain_back_to_front(self: Deque) -> None:
        moved: list[T] = self.back
        moved.reverse()
        self.front = moved
        self.back = []

    def _drain_front_to_back(self: Deque) -> None:
        moved: list[T] = self.front
        moved.reverse()
        self.back = moved
        self.front = []

    def pop_front(self: Deque) -> T:
        if len(self.front) == 0:
            self._drain_back_to_front()
        return self.front.pop()

    def pop_back(self: Deque) -> T:
        if len(self.back) == 0:
            self._drain_front_to_back()
        return self.back.pop()

    def peek_front(self: Deque) -> T:
        if len(self.front) == 0:
            self._drain_back_to_front()
        return self.front[len(self.front) - 1]

    def peek_back(self: Deque) -> T:
        if len(self.back) == 0:
            self._drain_front_to_back()
        return self.back[len(self.back) - 1]

    def is_empty(self: Deque) -> bool:
        return len(self.front) == 0 and len(self.back) == 0

    def size(self: Deque) -> int:
        return len(self.front) + len(self.back)

# ---------------------------------------------------------------------
# Set[T] — dogrusal tarama (bkz. modul basligi), HERHANGI bir T icin
# dogru (siniflar DAHIL).
class Set[T]:
    # `remove` mezar taşıyla O(1) amortize (OrderedDict ile aynı desen); ekleme sırası korunur. 2.2 aşama 2: önceden her `remove` listeyi ve karma dizinini baştan kuruyordu
    # (20 000 elemanda 20 000 silme 3,6 s; Python 0,85 ms). `items` alanı özel `_items` oldu (mezar taşı içerebilir); herkese açık erişim `to_list()`tir.
    _items: list[T]
    _slots: list[int]
    _dead: list[bool]
    _ndead: int

    def __init__(self: Set) -> None:
        self._items = []
        self._slots = []
        self._dead = []
        self._ndead = 0

    def _compact(self: Set) -> None:
        items: list[T] = self._items
        dead: list[bool] = self._dead
        new_items: list[T] = []
        i: int = 0
        while i < len(items):
            if i >= len(dead) or not dead[i]:
                new_items.append(items[i])
            i = i + 1
        self._items = new_items
        self._dead = []
        self._ndead = 0
        self._slots = _hx_rebuild(new_items, _hx_cap_for(len(new_items) * 2, len(self._slots)))

    def contains(self: Set, v: T) -> bool:
        return _hx_find(self._items, self._slots, v) >= 0

    def add(self: Set, v: T) -> None:
        h: int = __nox_hash(v)
        if _hx_find_h(self._items, self._slots, v, h) >= 0:
            return
        self._items.append(v)
        n: int = len(self._items)
        if n * 2 > len(self._slots):
            if self._ndead > 0:
                self._compact()
            else:
                self._slots = _hx_rebuild(self._items, _hx_cap_for(n, len(self._slots)))
        else:
            _hx_place(self._slots, h, n - 1)

    def remove(self: Set, v: T) -> bool:
        pos: int = _hx_find_slot(self._items, self._slots, v)
        if pos < 0:
            return False
        idx: int = self._slots[pos] - 1
        self._slots[pos] = -1
        # `_dead` tembeldir: ilk silmeye kadar boştur (ekleme yolu onu hiç dokunmaz); gerektiğinde `_items` uzunluğuna tamamlanır.
        dead: list[bool] = self._dead
        while len(dead) < len(self._items):
            dead.append(False)
        self._dead = dead
        self._dead[idx] = True
        self._ndead = self._ndead + 1
        if self._ndead >= 16 and self._ndead * 2 > len(self._items):
            self._compact()
        return True

    def size(self: Set) -> int:
        return len(self._items) - self._ndead

    def is_empty(self: Set) -> bool:
        return len(self._items) == self._ndead

    def to_list(self: Set) -> list[T]:
        if self._ndead > 0:
            self._compact()
        return self._items

    # v3 sertleştirme yol haritası, madde 10: `Set[T]` döner (v4 Faz A madde 2 ile `substituteStmt`in `Expr` ağaçlarını gezmeme sorunu düzeltildi).
    def union(self: Set, other: Set) -> Set[T]:
        result: Set[T] = Set[T]()
        mine: list[T] = self.to_list()
        theirs: list[T] = other.to_list()
        i: int = 0
        while i < len(mine):
            result.add(mine[i])
            i = i + 1
        j: int = 0
        while j < len(theirs):
            result.add(theirs[j])
            j = j + 1
        return result

    def intersection(self: Set, other: Set) -> Set[T]:
        result: Set[T] = Set[T]()
        mine: list[T] = self.to_list()
        i: int = 0
        while i < len(mine):
            if other.contains(mine[i]):
                result.add(mine[i])
            i = i + 1
        return result

    def difference(self: Set, other: Set) -> Set[T]:
        result: Set[T] = Set[T]()
        mine: list[T] = self.to_list()
        i: int = 0
        while i < len(mine):
            if not other.contains(mine[i]):
                result.add(mine[i])
            i = i + 1
        return result

# ---------------------------------------------------------------------
# Counter[T] — paralel anahtar/sayac listeleri, dogrusal tarama.
class Counter[T]:
    _keys: list[T]
    _counts: list[int]
    _slots: list[int]

    # 2.3 madde 5.3 (v2.2.8): Counter'da SİLME yoktur, bu yüzden karma tablosunda mezar taşı olmaz ve arama her zaman boş bir yuvada biter (yük <= 0,5). `add` aramayı satır içi yapar
    # (yardımcı çağrısı + ikinci kez yerleştirme araması kalktı) ve yeni anahtarı aramanın bulduğu boş yuvaya doğrudan yazar; yalnızca tablo büyürken yeniden kurulur.
    def __init__(self: Counter) -> None:
        self._keys = []
        self._counts = []
        self._slots = [0] * 16

    def _index_of(self: Counter, v: T) -> int:
        mask: int = len(self._slots) - 1
        pos: int = __nox_hash(v) & mask
        res: int = -1
        searching: bool = True
        while searching:
            s: int = self._slots[pos]
            if s == 0:
                searching = False
            elif self._keys[s - 1] == v:
                res = s - 1
                searching = False
            else:
                pos = (pos + 1) & mask
        return res

    def add(self: Counter, v: T) -> None:
        mask: int = len(self._slots) - 1
        pos: int = __nox_hash(v) & mask
        idx: int = -1
        searching: bool = True
        while searching:
            s: int = self._slots[pos]
            if s == 0:
                searching = False
            elif self._keys[s - 1] == v:
                idx = s - 1
                searching = False
            else:
                pos = (pos + 1) & mask
        if idx >= 0:
            self._counts[idx] = self._counts[idx] + 1
        else:
            self._keys.append(v)
            self._counts.append(1)
            n: int = len(self._keys)
            if n * 2 > len(self._slots):
                self._slots = _hx_rebuild(self._keys, _hx_cap_for(n, len(self._slots)))
            else:
                self._slots[pos] = n

    def count(self: Counter, v: T) -> int:
        idx: int = self._index_of(v)
        if idx < 0:
            return 0
        return self._counts[idx]

    def total(self: Counter) -> int:
        t: int = 0
        i: int = 0
        while i < len(self._counts):
            t = t + self._counts[i]
            i = i + 1
        return t

    def size(self: Counter) -> int:
        return len(self._keys)

# ---------------------------------------------------------------------
# OrderedDict[K, V] — paralel anahtar/deger listeleri, ekleme SIRASINI
# dogal olarak korur (dogrusal tarama, `dict`in K/V kisitindan BAGIMSIZ
# herhangi bir K/V icin calisir).
class OrderedDict[K, V]:
    _keys: list[K]
    _values: list[V]
    _slots: list[int]
    # Aura L2: `remove` listeyi kaydırıp indeksi yeniden kurmak yerine girdiyi MEZAR TAŞI yapar (`_dead[i]`, slot = -1);
    # mezar taşları yarıyı aşınca `_compact` tek geçişte temizler (amortize O(1) silme). `_ndead == 0` iken eski davranış.
    _dead: list[bool]
    _ndead: int

    def __init__(self: OrderedDict) -> None:
        self._keys = []
        self._values = []
        self._slots = []
        self._dead = []
        self._ndead = 0

    def _compact(self: OrderedDict) -> None:
        keys: list[K] = self._keys
        values: list[V] = self._values
        dead: list[bool] = self._dead
        new_keys: list[K] = []
        new_values: list[V] = []
        new_dead: list[bool] = []
        i: int = 0
        while i < len(keys):
            if not dead[i]:
                new_keys.append(keys[i])
                new_values.append(values[i])
                new_dead.append(False)
            i = i + 1
        self._keys = new_keys
        self._values = new_values
        self._dead = new_dead
        self._ndead = 0
        # Sıkıştırma sonrası canlı girdi sayısının 2 katı kadar ekleme payı bırakılır (aksi halde her ~n/40 eklemede yeniden kurulurdu).
        self._slots = _hx_rebuild(new_keys, _hx_cap_for(len(new_keys) * 2, len(self._slots)))

    def _index_of(self: OrderedDict, k: K) -> int:
        return _hx_find(self._keys, self._slots, k)

    def contains(self: OrderedDict, k: K) -> bool:
        return self._index_of(k) >= 0

    def set(self: OrderedDict, k: K, v: V) -> None:
        h: int = __nox_hash(k)
        idx: int = _hx_find_h(self._keys, self._slots, k, h)
        if idx >= 0:
            self._values[idx] = v
        else:
            self._keys.append(k)
            self._values.append(v)
            self._dead.append(False)
            n: int = len(self._keys)
            if n * 2 > len(self._slots):
                if self._ndead > 0:
                    self._compact()
                else:
                    self._slots = _hx_rebuild(self._keys, _hx_cap_for(n, len(self._slots)))
            else:
                _hx_place(self._slots, h, n - 1)

    def get(self: OrderedDict, k: K) -> V:
        idx: int = self._index_of(k)
        if idx < 0:
            raise KeyError("key not in OrderedDict")
        return self._values[idx]

    def remove(self: OrderedDict, k: K) -> bool:
        pos: int = _hx_find_slot(self._keys, self._slots, k)
        if pos < 0:
            return False
        idx: int = self._slots[pos] - 1
        self._slots[pos] = -1
        self._dead[idx] = True
        self._ndead = self._ndead + 1
        if self._ndead >= 16 and self._ndead * 2 > len(self._keys):
            self._compact()
        return True

    def keys_list(self: OrderedDict) -> list[K]:
        if self._ndead > 0:
            self._compact()
        return self._keys

    def values_list(self: OrderedDict) -> list[V]:
        if self._ndead > 0:
            self._compact()
        return self._values

    def size(self: OrderedDict) -> int:
        return len(self._keys) - self._ndead

# ---------------------------------------------------------------------
# LRUCache[K, V] — sabit indeksli girdiler + çift bağlı güncellik listesi + karma indeksi (aşağıdaki sınıf notuna bakın).
# `get` erişileni en-son-kullanılan yapar; `put` kapasiteyi AŞARSA en ESKİYİ atar; `contains` sırayı DEĞİŞTİRMEZ.
class LRUCache[K, V]:
    _keys: list[K]
    _values: list[V]
    # Girdi i için `_meta[3*i]` = karma, `_meta[3*i+1]` = bir önceki (daha yeni) girdi, `_meta[3*i+2]` = bir sonraki (daha eski) girdi; -1 = yok.
    _meta: list[int]
    _slots: list[int]
    _head: int
    _tail: int
    _n: int
    capacity: int

    # 2.3 madde 5.3 (v2.2.8): eski tasarım her `get`te girdiyi listenin sonuna taşıyıp mezar taşı bırakıyor, yarıdan fazlası ölü olunca TÜM anahtarları yeniden karmalıyordu. Yeni tasarım:
    # girdiler sabit indekslerde durur, güncellik sırası bir çift bağlı liste (`_meta`), karma indeksi mezar taşı yerine GERİ KAYDIRMALI silme kullanır (Knuth R; girdinin karması `_meta`da saklı).
    # Sıkıştırma/yeniden karma yoktur; dolu önbellekte en eski girdinin dizini yeni girdi için yeniden kullanılır. Dış davranış aynıdır.
    def __init__(self: LRUCache, capacity: int) -> None:
        self._keys = []
        self._values = []
        self._meta = []
        self._slots = [0] * 16
        self._head = -1
        self._tail = -1
        self._n = 0
        self.capacity = capacity

    # `k`nin karma yuvasının konumunu döndürür; yoksa -1.
    def _find(self: LRUCache, k: K, h: int) -> int:
        mask: int = len(self._slots) - 1
        pos: int = h & mask
        res: int = -2
        while res == -2:
            s: int = self._slots[pos]
            if s == 0:
                res = -1
            elif self._keys[s - 1] == k:
                res = pos
            else:
                pos = (pos + 1) & mask
        return res

    def _place(self: LRUCache, h: int, idx: int) -> None:
        mask: int = len(self._slots) - 1
        pos: int = h & mask
        while self._slots[pos] != 0:
            pos = (pos + 1) & mask
        self._slots[pos] = idx + 1

    def _rebuild(self: LRUCache, cap: int) -> None:
        self._slots = [0] * cap
        j: int = 0
        while j < self._n:
            self._place(self._meta[3 * j], j)
            j = j + 1

    # Yuva `pos`u boşaltır ve doğrusal yoklama zincirini geri kaydırarak onarır (girdi, karma konumu `(i, j]` aralığında DEĞİLSE boşluğa taşınır).
    def _del_slot(self: LRUCache, pos: int) -> None:
        mask: int = len(self._slots) - 1
        i: int = pos
        j: int = pos
        active: bool = True
        while active:
            j = (j + 1) & mask
            s: int = self._slots[j]
            if s == 0:
                active = False
            else:
                home: int = self._meta[3 * (s - 1)] & mask
                mv: bool = False
                if i <= j:
                    mv = home <= i or home > j
                else:
                    mv = home <= i and home > j
                if mv:
                    self._slots[i] = s
                    i = j
        self._slots[i] = 0

    def _unlink(self: LRUCache, i: int) -> None:
        p: int = self._meta[3 * i + 1]
        nx: int = self._meta[3 * i + 2]
        if p >= 0:
            self._meta[3 * p + 2] = nx
        else:
            self._head = nx
        if nx >= 0:
            self._meta[3 * nx + 1] = p
        else:
            self._tail = p

    def _push_front(self: LRUCache, i: int) -> None:
        self._meta[3 * i + 1] = -1
        self._meta[3 * i + 2] = self._head
        if self._head >= 0:
            self._meta[3 * self._head + 1] = i
        else:
            self._tail = i
        self._head = i

    def contains(self: LRUCache, k: K) -> bool:
        return self._find(k, __nox_hash(k)) >= 0

    def get(self: LRUCache, k: K) -> V:
        pos: int = self._find(k, __nox_hash(k))
        if pos < 0:
            raise KeyError("key not in LRUCache")
        i: int = self._slots[pos] - 1
        if self._head != i:
            self._unlink(i)
            self._push_front(i)
        return self._values[i]

    def put(self: LRUCache, k: K, v: V) -> None:
        if self.capacity <= 0:
            return
        h: int = __nox_hash(k)
        pos: int = self._find(k, h)
        if pos >= 0:
            i: int = self._slots[pos] - 1
            self._values[i] = v
            if self._head != i:
                self._unlink(i)
                self._push_front(i)
            return
        if self._n < self.capacity:
            e: int = self._n
            self._keys.append(k)
            self._values.append(v)
            self._meta.append(h)
            self._meta.append(-1)
            self._meta.append(-1)
            self._n = self._n + 1
            if self._n * 2 > len(self._slots):
                self._rebuild(len(self._slots) * 2)
            else:
                self._place(h, e)
            self._push_front(e)
        else:
            t: int = self._tail
            self._unlink(t)
            mask: int = len(self._slots) - 1
            p: int = self._meta[3 * t] & mask
            while self._slots[p] != t + 1:
                p = (p + 1) & mask
            self._del_slot(p)
            self._keys[t] = k
            self._values[t] = v
            self._meta[3 * t] = h
            self._place(h, t)
            self._push_front(t)

    def size(self: LRUCache) -> int:
        return self._n

# ---------------------------------------------------------------------
# Heap[T] — ikili min-heap (index aritmetigi), T yalnizca `<` destekleyen
# tiplerle (int/float/str) somutlastirilabilir (bkz. modul basligi —
# EK bir kisit kodu YOK, dilin operator tip kontrolu yeterli).
class Heap[T]:
    _items: list[T]

    def __init__(self: Heap) -> None:
        self._items = []

    def size(self: Heap) -> int:
        return len(self._items)

    def is_empty(self: Heap) -> bool:
        return len(self._items) == 0

    def peek_min(self: Heap) -> T:
        return self._items[0]

    # "Delik" tekniği: yer değiştirmeler yerine eleman bir kez yerleştirilir; `items` yerel takma adı alan yüklemelerini ve ARC işlemlerini döngü dışına alır.
    def _sift_up(self: Heap, idx: int) -> None:
        items: list[T] = self._items
        x: T = items[idx]
        i: int = idx
        active: bool = True
        while i > 0 and active:
            parent: int = (i - 1) // 2
            p: T = items[parent]
            if x < p:
                items[i] = p
                i = parent
            else:
                active = False
        items[i] = x

    # Bulundu (bkz. nox-teknik-spesifikasyon.md §"and/or kısa devre
    # yapmaz"): `left < n and items[left] < ...` YAZILAMAZ —
    # Nox'ta `and` HER İKİ operandı da HER ZAMAN değerlendirir, bu yüzden
    # `left >= n` OLSA BİLE `items[left]` DEĞERLENDİRİLİR (sınır
    # dışı bir okuma — GERÇEK bir `IndexError`la tekrar-üretilip
    # DOĞRULANDI). Bunun yerine İÇ İÇE `if`ler kullanılır (dıştaki sınır
    # kontrolü, İÇTEKİ karşılaştırma yalnızca sınır GEÇERLİYSE çalışır).
    def _sift_down(self: Heap, idx: int) -> None:
        items: list[T] = self._items
        n: int = len(items)
        x: T = items[idx]
        i: int = idx
        active: bool = True
        while active:
            smallest: int = i * 2 + 1
            if smallest < n:
                right: int = smallest + 1
                if right < n:
                    if items[right] < items[smallest]:
                        smallest = right
                if items[smallest] < x:
                    items[i] = items[smallest]
                    i = smallest
                else:
                    active = False
            else:
                active = False
        items[i] = x

    def push(self: Heap, v: T) -> None:
        self._items.append(v)
        self._sift_up(len(self._items) - 1)

    def pop_min(self: Heap) -> T:
        n: int = len(self._items)
        result: T = self._items[0]
        last: T = self._items[n - 1]
        self._items[0] = last
        self._items.pop()
        if len(self._items) > 0:
            self._sift_down(0)
        return result

# ---------------------------------------------------------------------
# PriorityQueue[T] — Heap'ten BAGIMSIZ, ayri bir `priority: int` alanina
# gore siralanir — T KEYFI olabilir (siniflar DAHIL) cunku T uzerinde
# HIC karsilastirma yapilmaz.
class PriorityQueue[T]:
    _priorities: list[int]
    _values: list[T]

    def __init__(self: PriorityQueue) -> None:
        self._priorities = []
        self._values = []

    def size(self: PriorityQueue) -> int:
        return len(self._values)

    def is_empty(self: PriorityQueue) -> bool:
        return len(self._values) == 0

    def peek_min(self: PriorityQueue) -> T:
        return self._values[0]

    def peek_min_priority(self: PriorityQueue) -> int:
        return self._priorities[0]

    def _swap(self: PriorityQueue, i: int, j: int) -> None:
        tp: int = self._priorities[i]
        tv: T = self._values[i]
        self._priorities[i] = self._priorities[j]
        self._values[i] = self._values[j]
        self._priorities[j] = tp
        self._values[j] = tv

    def _sift_up(self: PriorityQueue, idx: int) -> None:
        i: int = idx
        active: bool = True
        while i > 0 and active:
            parent: int = (i - 1) // 2
            if self._priorities[i] < self._priorities[parent]:
                self._swap(i, parent)
                i = parent
            else:
                active = False

    # Bkz. `Heap._sift_down`nin AYNI belge notu — Nox'ta `and` kısa devre
    # YAPMADIĞINDAN İÇ İÇE `if` kullanılır (aksi halde sınır dışı okuma).
    def _sift_down(self: PriorityQueue, idx: int) -> None:
        i: int = idx
        n: int = len(self._values)
        active: bool = True
        while active:
            left: int = i * 2 + 1
            right: int = i * 2 + 2
            smallest: int = i
            if left < n:
                if self._priorities[left] < self._priorities[smallest]:
                    smallest = left
            if right < n:
                if self._priorities[right] < self._priorities[smallest]:
                    smallest = right
            if smallest != i:
                self._swap(i, smallest)
                i = smallest
            else:
                active = False

    def push(self: PriorityQueue, priority: int, v: T) -> None:
        priorities: list[int] = self._priorities
        values: list[T] = self._values
        priorities.append(priority)
        values.append(v)
        self._priorities = priorities
        self._values = values
        self._sift_up(len(self._values) - 1)

    def pop_min(self: PriorityQueue) -> T:
        n: int = len(self._values)
        result: T = self._values[0]
        last_p: int = self._priorities[n - 1]
        last_v: T = self._values[n - 1]
        self._priorities[0] = last_p
        self._values[0] = last_v
        priorities: list[int] = self._priorities
        values: list[T] = self._values
        priorities.pop()
        values.pop()
        self._priorities = priorities
        self._values = values
        if len(self._values) > 0:
            self._sift_down(0)
        return result

# nox.argparse (v2.1.68) — komut satırı ayrıştırıcı (Python `argparse`ın çekirdeği), saf Nox. Tipler statik olduğundan sonuç dinamik bir nitelik
# nesnesi değil, `Namespace` içinde adla sorgulanır (`ns.flag("verbose")`, `ns.get_int("count")`). Kısaltılmış uzun seçenek ("--verb") DESTEKLENMEZ.

class ArgumentError(Exception):
    pass

# Seçenek türleri
_FLAG: int = 0
_STR: int = 1
_INT: int = 2
_FLOAT: int = 3
_MULTI: int = 4
_POS: int = 5
_POS_OPT: int = 6
_POS_REST: int = 7

class _Spec:
    kind: int
    short: str
    long: str
    dest: str
    default: str
    help: str
    required: bool
    choices: list[str]

    def __init__(self, kind: int, short: str, long: str, dest: str, default: str, help: str, required: bool, choices: list[str]) -> None:
        self.kind = kind
        self.short = short
        self.long = long
        self.dest = dest
        self.default = default
        self.help = help
        self.required = required
        self.choices = choices

class Namespace:
    flags: dict[str, bool]
    values: dict[str, str]
    lists: dict[str, list[str]]
    given: dict[str, bool]
    command: str
    help_requested: bool

    def __init__(self) -> None:
        self.flags = {}
        self.values = {}
        self.lists = {}
        self.given = {}
        self.command = ""
        self.help_requested = False

    # Bayrak (`add_flag`) açık mı.
    def flag(self, name: str) -> bool:
        if name in self.flags:
            return self.flags[name]
        return False

    # Dize değeri (seçenek ya da konumsal); bilinmeyen ad için "".
    def get_str(self, name: str) -> str:
        if name in self.values:
            return self.values[name]
        return ""

    def get_int(self, name: str) -> int:
        if name in self.values:
            return int(self.values[name])
        return 0

    def get_float(self, name: str) -> float:
        if name in self.values:
            return float(self.values[name])
        return 0.0

    # `add_multi_option` ve `add_rest` değerleri.
    def get_list(self, name: str) -> list[str]:
        if name in self.lists:
            return self.lists[name]
        return []

    # Komut satırında AÇIKÇA verildi mi (varsayılan kullanıldıysa False).
    def has(self, name: str) -> bool:
        return name in self.given

def _dest_of(short: str, long: str) -> str:
    base: str = long
    if base == "":
        base = short
    out: str = ""
    i: int = 0
    # baştaki '-' işaretlerini at
    while i < len(base) and base[i] == "-":
        i = i + 1
    while i < len(base):
        c: str = base[i]
        if c == "-":
            out = out + "_"
        else:
            out = out + c
        i = i + 1
    return out

def _is_negative_number(s: str) -> bool:
    if len(s) < 2 or s[0] != "-":
        return False
    i: int = 1
    seen_digit: bool = False
    seen_dot: bool = False
    while i < len(s):
        c: str = s[i]
        if c == ".":
            if seen_dot:
                return False
            seen_dot = True
        elif c >= "0" and c <= "9":
            seen_digit = True
        else:
            return False
        i = i + 1
    return seen_digit

# Python gibi: '-' ile başlayan (negatif sayı olmayan) bir dize seçenek sayılır ve seçenek değeri olamaz.
def _looks_like_option(s: str) -> bool:
    return len(s) >= 2 and s[0] == "-" and not _is_negative_number(s)

def _is_int_text(s: str) -> bool:
    if len(s) == 0:
        return False
    i: int = 0
    if s[0] == "-" or s[0] == "+":
        i = 1
    if i >= len(s):
        return False
    while i < len(s):
        if s[i] < "0" or s[i] > "9":
            return False
        i = i + 1
    return True

def _is_float_text(s: str) -> bool:
    if len(s) == 0:
        return False
    i: int = 0
    if s[0] == "-" or s[0] == "+":
        i = 1
    digits: int = 0
    dots: int = 0
    while i < len(s):
        c: str = s[i]
        if c == ".":
            dots = dots + 1
        elif c >= "0" and c <= "9":
            digits = digits + 1
        else:
            return False
        i = i + 1
    return digits > 0 and dots <= 1

class ArgumentParser:
    prog: str
    description: str
    specs: list[_Spec]
    names: list[str]
    sub_names: list[str]
    sub_help: list[str]
    subs: list[ArgumentParser]

    def __init__(self, prog: str, description: str = "") -> None:
        self.prog = prog
        self.description = description
        self.specs = []
        self.names = []
        self.sub_names = []
        self.sub_help = []
        self.subs = []

    def _add(self, s: _Spec) -> None:
        if s.dest in self.names:
            raise ArgumentError("duplicate argument name: " + s.dest)
        self.names.append(s.dest)
        self.specs.append(s)

    # Değer almayan bayrak: `-v` / `--verbose`. Ad: dest (uzun addan, `-` -> `_`).
    def add_flag(self, short: str, long: str, help: str = "") -> None:
        self._add(_Spec(_FLAG, short, long, _dest_of(short, long), "", help, False, []))

    # Dize değerli seçenek: `-o FILE`, `--output FILE`, `--output=FILE`, `-oFILE`.
    def add_option(self, short: str, long: str, default: str = "", help: str = "", required: bool = False) -> None:
        self._add(_Spec(_STR, short, long, _dest_of(short, long), default, help, required, []))

    # Değeri `choices` listesinden biri olmak zorunda olan seçenek.
    def add_choice_option(self, short: str, long: str, choices: list[str], default: str = "", help: str = "") -> None:
        self._add(_Spec(_STR, short, long, _dest_of(short, long), default, help, False, choices))

    def add_int_option(self, short: str, long: str, default: int = 0, help: str = "", required: bool = False) -> None:
        self._add(_Spec(_INT, short, long, _dest_of(short, long), str(default), help, required, []))

    def add_float_option(self, short: str, long: str, default: float = 0.0, help: str = "", required: bool = False) -> None:
        self._add(_Spec(_FLOAT, short, long, _dest_of(short, long), str(default), help, required, []))

    # Tekrarlanabilir seçenek: `-I a -I b` -> get_list == ["a", "b"].
    def add_multi_option(self, short: str, long: str, help: str = "") -> None:
        self._add(_Spec(_MULTI, short, long, _dest_of(short, long), "", help, False, []))

    # Zorunlu konumsal argüman.
    def add_positional(self, name: str, help: str = "") -> None:
        self._add(_Spec(_POS, "", "", name, "", help, True, []))

    # İsteğe bağlı konumsal argüman (varsayılanlı). Zorunlulardan sonra eklenmelidir.
    def add_optional_positional(self, name: str, default: str = "", help: str = "") -> None:
        self._add(_Spec(_POS_OPT, "", "", name, default, help, False, []))

    # Kalan tüm konumsal argümanlar (0 ya da daha fazla) -> get_list(name). Son konumsal olmalıdır.
    def add_rest(self, name: str, help: str = "") -> None:
        self._add(_Spec(_POS_REST, "", "", name, "", help, False, []))

    # Alt komut: ilk konumsal argüman `name` ise kalan argümanlar `parser` ile ayrıştırılır; `ns.command == name`.
    def add_command(self, name: str, parser: ArgumentParser, help: str = "") -> None:
        self.sub_names.append(name)
        self.sub_help.append(help)
        self.subs.append(parser)

    def _find_long(self, name: str) -> int:
        i: int = 0
        while i < len(self.specs):
            if self.specs[i].long == name and name != "":
                return i
            i = i + 1
        return -1

    def _find_short(self, name: str) -> int:
        i: int = 0
        while i < len(self.specs):
            if self.specs[i].short == name and name != "":
                return i
            i = i + 1
        return -1

    def _store(self, ns: Namespace, s: _Spec, value: str) -> None:
        if s.kind == _INT and not _is_int_text(value):
            raise ArgumentError("argument " + _display(s) + ": invalid int value: '" + value + "'")
        if s.kind == _FLOAT and not _is_float_text(value):
            raise ArgumentError("argument " + _display(s) + ": invalid float value: '" + value + "'")
        if len(s.choices) > 0 and value not in s.choices:
            raise ArgumentError("argument " + _display(s) + ": invalid choice: '" + value + "'")
        if s.kind == _MULTI:
            if s.dest not in ns.lists:
                ns.lists[s.dest] = []
            ns.lists[s.dest].append(value)
        else:
            ns.values[s.dest] = value
        ns.given[s.dest] = True

    def parse(self, args: list[str]) -> Namespace:
        ns: Namespace = Namespace()
        # varsayılanlar
        for s in self.specs:
            if s.kind == _FLAG:
                ns.flags[s.dest] = False
            elif s.kind == _MULTI or s.kind == _POS_REST:
                ns.lists[s.dest] = []
            elif s.kind != _POS:
                ns.values[s.dest] = s.default
        positionals: list[str] = []
        only_positional: bool = False
        i: int = 0
        while i < len(args):
            a: str = args[i]
            i = i + 1
            if only_positional or len(a) < 2 or a[0] != "-" or _is_negative_number(a):
                positionals.append(a)
                if len(self.subs) > 0 and len(positionals) == 1:
                    # alt komut: kalan her şey alt ayrıştırıcıya gider
                    k: int = 0
                    while k < len(self.sub_names):
                        if self.sub_names[k] == a:
                            rest: list[str] = []
                            while i < len(args):
                                rest.append(args[i])
                                i = i + 1
                            sub_ns: Namespace = self.subs[k].parse(rest)
                            return self._merge(ns, sub_ns, a, positionals)
                        k = k + 1
                    raise ArgumentError("invalid command: '" + a + "'")
                continue
            if a == "--":
                only_positional = True
                continue
            if a == "-h" or a == "--help":
                ns.help_requested = True
                return ns
            if a[0:2] == "--":
                eq: int = -1
                j: int = 0
                while j < len(a):
                    if a[j] == "=" and eq < 0:
                        eq = j
                    j = j + 1
                name: str = a
                inline: str = ""
                has_inline: bool = False
                if eq >= 0:
                    name = a[0:eq]
                    inline = a[eq + 1:len(a)]
                    has_inline = True
                idx: int = self._find_long(name)
                if idx < 0:
                    raise ArgumentError("unrecognized arguments: " + a)
                spec: _Spec = self.specs[idx]
                if spec.kind == _FLAG:
                    if has_inline:
                        raise ArgumentError("argument " + name + ": ignored explicit argument '" + inline + "'")
                    ns.flags[spec.dest] = True
                    ns.given[spec.dest] = True
                else:
                    if not has_inline:
                        if i >= len(args) or _looks_like_option(args[i]):
                            raise ArgumentError("argument " + name + ": expected one argument")
                        inline = args[i]
                        i = i + 1
                    self._store(ns, spec, inline)
                continue
            # kısa seçenek öbeği: -abc, -ofile, -n5
            c: int = 1
            while c < len(a):
                key: str = "-" + a[c]
                idx2: int = self._find_short(key)
                if idx2 < 0:
                    raise ArgumentError("unrecognized arguments: " + a)
                spec2: _Spec = self.specs[idx2]
                if spec2.kind == _FLAG:
                    ns.flags[spec2.dest] = True
                    ns.given[spec2.dest] = True
                    c = c + 1
                else:
                    if c + 1 < len(a):
                        val: str = a[c + 1:len(a)]
                        if val[0] == "=":
                            val = val[1:len(val)]
                        self._store(ns, spec2, val)
                    else:
                        if i >= len(args) or _looks_like_option(args[i]):
                            raise ArgumentError("argument " + key + ": expected one argument")
                        self._store(ns, spec2, args[i])
                        i = i + 1
                    c = len(a)
        self._assign_positionals(ns, positionals)
        self._check_required(ns)
        return ns

    def _assign_positionals(self, ns: Namespace, positionals: list[str]) -> None:
        p: int = 0
        for s in self.specs:
            if s.kind == _POS:
                if p >= len(positionals):
                    raise ArgumentError("the following arguments are required: " + s.dest)
                ns.values[s.dest] = positionals[p]
                ns.given[s.dest] = True
                p = p + 1
            elif s.kind == _POS_OPT:
                if p < len(positionals):
                    ns.values[s.dest] = positionals[p]
                    ns.given[s.dest] = True
                    p = p + 1
            elif s.kind == _POS_REST:
                while p < len(positionals):
                    ns.lists[s.dest].append(positionals[p])
                    ns.given[s.dest] = True
                    p = p + 1
        if p < len(positionals):
            raise ArgumentError("unrecognized arguments: " + positionals[p])

    def _check_required(self, ns: Namespace) -> None:
        for s in self.specs:
            if s.required and s.kind != _POS and s.dest not in ns.given:
                raise ArgumentError("the following arguments are required: " + _display(s))

    def _merge(self, ns: Namespace, sub: Namespace, command: str, positionals: list[str]) -> Namespace:
        self._check_required(ns)
        ns.command = command
        ns.help_requested = sub.help_requested
        for k in sub.flags:
            ns.flags[k] = sub.flags[k]
        for k in sub.values:
            ns.values[k] = sub.values[k]
        for k in sub.lists:
            ns.lists[k] = sub.lists[k]
        for k in sub.given:
            ns.given[k] = True
        return ns

    def usage(self) -> str:
        out: str = "usage: " + self.prog + " [-h]"
        for s in self.specs:
            if s.kind == _POS or s.kind == _POS_OPT or s.kind == _POS_REST:
                continue
            name: str = s.short
            if name == "":
                name = s.long
            part: str = name
            if s.kind != _FLAG:
                part = name + " " + _upper(s.dest)
            if s.required:
                out = out + " " + part
            else:
                out = out + " [" + part + "]"
        if len(self.subs) > 0:
            out = out + " {" + _join(self.sub_names, ",") + "} ..."
        for s in self.specs:
            if s.kind == _POS:
                out = out + " " + s.dest
            elif s.kind == _POS_OPT:
                out = out + " [" + s.dest + "]"
            elif s.kind == _POS_REST:
                out = out + " [" + s.dest + " ...]"
        return out

    def help_text(self) -> str:
        out: str = self.usage() + "\n"
        if self.description != "":
            out = out + "\n" + self.description + "\n"
        has_pos: bool = len(self.subs) > 0
        for s in self.specs:
            if s.kind == _POS or s.kind == _POS_OPT or s.kind == _POS_REST:
                has_pos = True
        if has_pos:
            out = out + "\npositional arguments:\n"
            k: int = 0
            while k < len(self.subs):
                out = out + _row("  " + self.sub_names[k], self.sub_help[k])
                k = k + 1
            for s in self.specs:
                if s.kind == _POS or s.kind == _POS_OPT or s.kind == _POS_REST:
                    out = out + _row("  " + s.dest, s.help)
        out = out + "\noptions:\n"
        out = out + _row("  -h, --help", "show this help message and exit")
        for s in self.specs:
            if s.kind == _POS or s.kind == _POS_OPT or s.kind == _POS_REST:
                continue
            label: str = "  "
            if s.short != "" and s.long != "":
                label = label + s.short + ", " + s.long
            elif s.short != "":
                label = label + s.short
            else:
                label = label + s.long
            if s.kind != _FLAG:
                label = label + " " + _upper(s.dest)
            text: str = s.help
            if s.kind != _FLAG and s.kind != _MULTI and not s.required and s.default != "":
                text = text + " (default: " + s.default + ")"
            out = out + _row(label, text)
        return out

def _display(s: _Spec) -> str:
    if s.long != "":
        if s.short != "":
            return s.short + "/" + s.long
        return s.long
    if s.short != "":
        return s.short
    return s.dest

def _upper(s: str) -> str:
    out: str = ""
    i: int = 0
    while i < len(s):
        c: str = s[i]
        if c >= "a" and c <= "z":
            out = out + chr(ord(c) - 32)
        else:
            out = out + c
        i = i + 1
    return out

def _join(parts: list[str], sep: str) -> str:
    out: str = ""
    i: int = 0
    while i < len(parts):
        if i > 0:
            out = out + sep
        out = out + parts[i]
        i = i + 1
    return out

def _row(label: str, text: str) -> str:
    if text == "":
        return label + "\n"
    pad: str = ""
    n: int = 24 - len(label)
    if n < 2:
        n = 2
    i: int = 0
    while i < n:
        pad = pad + " "
        i = i + 1
    return label + pad + text + "\n"

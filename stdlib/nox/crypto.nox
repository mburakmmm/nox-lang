# Stdlib fazı V.3 — nox.crypto: SHA-256 (asgari kapsam).
# `runtime/stdlib_shims/crypto.zig`ye sarar (Zig'in KENDİ `std.crypto.hash.
# sha2.Sha256`si — sıfırdan bir hash algoritması YAZILMADI). `with_rt`
# GEREKİR (sonuç ARC'lı bir `str`, 64 karakterlik küçük harf hex).
import nox.buffer
from nox.buffer import Buffer

extern def nox_crypto_sha256_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt

# v3 sertleştirme yol haritası, madde 10 (bkz. nox-teknik-spesifikasyon.md
# ilgili bölüm, stdlib/API denetimi): `nox.crypto`, benzer TÜM I/O-benzeri
# stdlib modüllerinin (`nox.fs`/`nox.json`/`nox.sqlite`/vb.) AKSİNE ÖNCEDEN
# HİÇBİR özel exception sınıfı TAŞIMIYORDU — Zig kabuğu (`runtime/stdlib_
# shims/crypto.zig`) `strHash`in (argon2/bcrypt/scrypt) ya da bir `null`
# argümanın tetiklediği HERHANGİ bir iç hatada SESSİZCE boş dize `""`
# DÖNÜYORDU — çağıran taraf BUNU AYIRT EDEMİYORDU (bkz. o dosyanın `catch
# return dupeToNoxStr(rt, "")` deseni). Aşağıdaki sarmalayıcılar ARTIK bu
# sentineli KONTROL EDİP `CryptoError` fırlatıyor.
class CryptoError(Exception):
    pass

def sha256(data: str) -> str:
    result: str = nox_crypto_sha256_hex_raw(data)
    if result == "":
        raise CryptoError("sha256 failed")
    return result

# Faz III.9 (bkz. nox-teknik-spesifikasyon.md §3.69) — `sha256` İLE AYNI
# desen: Zig'in KENDİ `std.crypto.hash.Sha1`/`sha2.Sha512`si.
extern def nox_crypto_sha1_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_sha512_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt

# GÜVENLİK UYARISI (bulgu M-4, bkz. güvenlik raporu, 20 Temmuz 2026):
# SHA-1, 2017'den beri (SHAttered) PRATİK çakışma saldırılarına AÇIKTIR —
# bütünlük/imza DOĞRULAMASI İçin KULLANILMAMALIDIR (yalnızca ESKİ-sistem
# UYUMLULUĞU/çakışma-DIRENCİ GEREKMEYEN senaryolarda kullanın). GÜVENLİK-
# İLGİLİ hash İhtiyaçları İçin `sha256`/`sha512` (çakışma-dirençli) YA DA
# mesaj DOĞRULAMASI İçin `hmac_sha256` (aşağı bkz.) TERCİH EDİN.
def sha1(data: str) -> str:
    result: str = nox_crypto_sha1_hex_raw(data)
    if result == "":
        raise CryptoError("sha1 failed")
    return result

def sha512(data: str) -> str:
    result: str = nox_crypto_sha512_hex_raw(data)
    if result == "":
        raise CryptoError("sha512 failed")
    return result

# v2.1.70: Zig `std.crypto.hash` özetleri. MD5 çakışma-dirençli DEĞİLDİR (yalnızca uyumluluk/sağlama toplamı; güvenlik için sha256/sha3/blake3 kullanın).
extern def nox_crypto_md5_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_sha384_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_sha3_256_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_sha3_512_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_blake3_hex_raw(data: str) -> str from "zig-out/lib/noxrt.o" with_rt

def md5(data: str) -> str:
    return nox_crypto_md5_hex_raw(data)

def sha384(data: str) -> str:
    return nox_crypto_sha384_hex_raw(data)

def sha3_256(data: str) -> str:
    return nox_crypto_sha3_256_hex_raw(data)

def sha3_512(data: str) -> str:
    return nox_crypto_sha3_512_hex_raw(data)

def blake3(data: str) -> str:
    return nox_crypto_blake3_hex_raw(data)

# Güvenlik bulguları M-4/M-5/M-6 (bkz. güvenlik raporu) — DÜZELTİLDİ:
# stdlib'de HMAC/zaman-sabit-karşılaştırma/güvenli-rastgelelik
# ilkelleri YOKTU.
extern def nox_crypto_hmac_sha256_hex_raw(key: str, data: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_constant_time_eq_raw(a: str, b: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_crypto_secure_random_hex_raw(n_bytes: int) -> str from "zig-out/lib/noxrt.o" with_rt

# `key` İLE `data`nın HMAC-SHA256'sı (küçük harf hex, 64 karakter) —
# `sha256`nin AKSİNE bir paylaşılan GİZLİ anahtar gerektirir, bu YÜZDEN
# mesaj bütünlüğü/kimlik DOĞRULAMASI İçin GÜVENLİDİR (saldırgan anahtarı
# BİLMEDEN geçerli bir MAC üretemez).
def hmac_sha256(key: str, data: str) -> str:
    result: str = nox_crypto_hmac_sha256_hex_raw(key, data)
    if result == "":
        raise CryptoError("hmac_sha256 failed")
    return result

# İKİ dizeyi ZAMAN-SABİT (constant-time) karşılaştırır — bir belirteç/
# parola-özeti/HMAC doğrulaması yaparken `==` YERİNE BUNU kullanın: `==`
# ilk FARKLI bayta rastlayınca DURDUĞUNDAN, bir saldırgan yanıt SÜRESİNDEN
# doğru değeri bayt-bayt SIZDIRABİLİR (zamanlama yan-kanalı saldırısı).
def constant_time_eq(a: str, b: str) -> bool:
    return nox_crypto_constant_time_eq_raw(a, b) != 0

# `n_bytes` bayt GÜVENLİ (kriptografik, OS-düzeyi) rastgelelik üretip
# küçük harf hex (`n_bytes * 2` karakter) olarak döner — oturum belirteci/
# CSRF token/API anahtarı gibi GÜVENLİK-İLGİLİ rastgelelik İçin `nox.
# random`nin (BİLİNÇLİ OLARAK kriptografik güvenlik iddiası TAŞIMAYAN)
# YERİNE KULLANILMALIDIR. `n_bytes` 256'yı AŞARSA sessizce 256'ya kırpılır
# (GERÇEKÇİ HERHANGİ bir token/anahtar büyüklüğünün ÇOK ÜSTÜNDE).
# v4 (Faz A madde 1, bkz. nox-teknik-spesifikasyon.md §3.2xx): `nox.crypto`
# modülünün KENDİSİ capability-SİZDİR (`sha256`/`hmac_sha256`/vb. HER
# profilde import/çağrılabilir) — ama BU fonksiyon GERÇEK OS entropisi
# İSTEDİĞİNDEN sembol-seviyesinde işaretlenir (`freestanding`de HENÜZ bir
# entropi kaynağı YOK).
@capability.requires("entropy")
def secure_random_hex(n_bytes: int) -> str:
    if n_bytes <= 0:
        raise CryptoError("n_bytes must be positive")
    return nox_crypto_secure_random_hex_raw(n_bytes)

# Parola hash'leme (argon2id/bcrypt/scrypt) — Zig'in KENDİ `std.crypto.
# pwhash.*`si (`runtime/stdlib_shims/crypto.zig`). Üçü de OWASP'ın ÖNERDİĞİ
# maliyet parametresini KULLANIR, HİÇBİR tuning seçeneği SUNULMAZ (yanlış/
# zayıf bir parametre seçme riskini TAMAMEN ortadan kaldırır). Dönen dize
# TÜM parametreleri+tuzu (salt) KENDİ İÇİNDE taşır — AYRI bir tuz saklamaya
# GEREK YOK, doğrudan bir veritabanı sütununa yazılabilir.
#
# GÜVENLİK NOTU: `sha256`/`sha512`/`sha1` parola SAKLAMAK İçin ASLA
# KULLANILMAMALIDIR (hızlı hash'ler, kaba-kuvvet/gökkuşağı-tablosu
# saldırılarına AÇIKTIR) — parola saklama İçin HER ZAMAN bu üçünden
# BİRİNİ (argon2id ÖNERİLİR, OWASP'ın 2024 önerisiyle UYUMLU) kullanın.
extern def nox_crypto_argon2_hash_raw(password: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_argon2_verify_raw(hash: str, password: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_crypto_bcrypt_hash_raw(password: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_bcrypt_verify_raw(hash: str, password: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_crypto_scrypt_hash_raw(password: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_scrypt_verify_raw(hash: str, password: str) -> int from "zig-out/lib/noxrt.o"

# Argon2id (OWASP'ın 2024 parola-saklama önerisinde İLK sırada önerilen
# algoritma) İLE bir parolayı hash'ler — dönen dize (`$argon2id$v=19$...`)
# doğrudan saklanabilir, doğrulama İçin `argon2_verify`ye geçilir.
# v4 madde 1: `strHash` TUZ'u (salt) KENDİ İÇİNDE OS entropisinden
# üretir (`runtime/stdlib_shims/crypto.zig`nin `pwhash.argon2.strHash`ı,
# AÇIKÇA verilen bir tuz PARAMETRESİ YOK) — bu YÜZDEN `secure_random_hex`
# İLE AYNI gerekçeyle işaretlenir. `argon2_verify` İSE SADECE VERİLEN bir
# hash/parolayı KARŞILAŞTIRIR, RNG GEREKTİRMEZ — işaretsiz KALIR.
@capability.requires("entropy")
def argon2_hash(password: str) -> str:
    result: str = nox_crypto_argon2_hash_raw(password)
    if result == "":
        raise CryptoError("argon2_hash failed")
    return result

# `argon2_hash`nin ürettiği bir hash'e karşı bir parolayı doğrular. Yanlış
# parola VE bozuk/geçersiz bir `hash` (ör. BAŞKA bir algoritmadan gelen)
# AYNI şekilde `False` DÖNER — hangi nedenle başarısız olduğu bilinçli
# olarak AYIRT EDİLMEZ (bir yan-kanal sızıntısı olmasın diye).
def argon2_verify(hash: str, password: str) -> bool:
    return nox_crypto_argon2_verify_raw(hash, password) != 0

# bcrypt İLE bir parolayı hash'ler ($2b$... biçimi) — eski sistemlerle
# uyumluluk/dosya-boyutu ÖNEMLİYSE argon2id YERİNE tercih edilebilir
# (60 karakterlik SABİT uzunluk, argon2/scrypt'in AKSİNE).
@capability.requires("entropy")
def bcrypt_hash(password: str) -> str:
    result: str = nox_crypto_bcrypt_hash_raw(password)
    if result == "":
        raise CryptoError("bcrypt_hash failed")
    return result

def bcrypt_verify(hash: str, password: str) -> bool:
    return nox_crypto_bcrypt_verify_raw(hash, password) != 0

# scrypt İLE bir parolayı hash'ler — bellek-sert (memory-hard) bir
# alternatif, ÖZEL donanım (ASIC/FPGA) saldırılarına argon2id/bcrypt'ten
# DAHA dirençlidir ama OWASP varsayılan parametreleriyle (128 MB/çağrı)
# argon2id'den DAHA maliyetlidir.
@capability.requires("entropy")
def scrypt_hash(password: str) -> str:
    result: str = nox_crypto_scrypt_hash_raw(password)
    if result == "":
        raise CryptoError("scrypt_hash failed")
    return result

def scrypt_verify(hash: str, password: str) -> bool:
    return nox_crypto_scrypt_verify_raw(hash, password) != 0

# AEAD (kimlik doğrulamalı şifreleme, v2.1.195): ChaCha20-Poly1305, XChaCha20-Poly1305, AES-256-GCM, AES-128-GCM — Zig'in `std.crypto.aead`i. Anahtar, nonce ve MÜHÜR onaltılık (hex) dizelerdir
# (`secure_random_hex(32)` anahtar, `secure_random_hex(12)` nonce üretir). `plaintext` ikili-güvenlidir (str uzunluğu başlıkta). Mühür = hex(şifreli metin || 16 baytlık etiket).
#
#     key: str = nox.crypto.secure_random_hex(32)
#     nonce: str = nox.crypto.secure_random_hex(12)         # AYNI anahtarla bir nonce'u İKİ KEZ kullanmayın
#     sealed: str = nox.crypto.aead_seal(key, nonce, "secret", "context")
#     plain: str = nox.crypto.aead_open(key, nonce, sealed, "context")   # bozulmuş/yanlış anahtar/aad -> CryptoError
#
# `algorithm`: "chacha20-poly1305" (32 B anahtar, 12 B nonce; varsayılan), "xchacha20-poly1305" (32 B, 24 B nonce — rastgele nonce için daha güvenli), "aes-256-gcm" (32 B, 12 B), "aes-128-gcm" (16 B, 12 B).
# `aad`: şifrelenmeyen ama kimliği doğrulanan ek veri (boş olabilir).
extern def nox_crypto_aead_raw(seal: int, alg: int, key_hex: str, nonce_hex: str, data: str, aad: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_crypto_aead_status_raw() -> int from "zig-out/lib/noxrt.o"

def _aead_alg(algorithm: str) -> int:
    if algorithm == "chacha20-poly1305":
        return 0
    if algorithm == "aes-256-gcm":
        return 1
    if algorithm == "aes-128-gcm":
        return 2
    if algorithm == "xchacha20-poly1305":
        return 3
    raise CryptoError("unknown AEAD algorithm: " + algorithm)

def _aead_check(status: int, what: str) -> None:
    if status == 0:
        return
    if status == 2:
        raise CryptoError(what + ": wrong key length for this algorithm")
    if status == 3:
        raise CryptoError(what + ": wrong nonce length for this algorithm")
    if status == 4:
        raise CryptoError(what + ": key, nonce or sealed text is not valid hex")
    raise CryptoError(what + ": authentication failed")

def aead_seal(key_hex: str, nonce_hex: str, plaintext: str, aad: str = "", algorithm: str = "chacha20-poly1305") -> str:
    out: str = nox_crypto_aead_raw(1, _aead_alg(algorithm), key_hex, nonce_hex, plaintext, aad)
    _aead_check(nox_crypto_aead_status_raw(), "aead_seal")
    return out

def aead_open(key_hex: str, nonce_hex: str, sealed_hex: str, aad: str = "", algorithm: str = "chacha20-poly1305") -> str:
    out: str = nox_crypto_aead_raw(0, _aead_alg(algorithm), key_hex, nonce_hex, sealed_hex, aad)
    _aead_check(nox_crypto_aead_status_raw(), "aead_open")
    return out

# İkili (bayt) varyantı (v2.2.1): anahtar, nonce, düz metin, AAD ve mühür `Buffer`dır (`nox.buffer`); `str`/hex dönüşümü gerekmez, düz metin NUL ve geçersiz UTF-8 dahil her bayt olabilir.
# Mühür = şifreli metin || 16 baytlık etiket. Hatalar `aead_seal`/`aead_open` ile aynıdır (`CryptoError`).
#
#     from nox.buffer import Buffer
#     sealed: Buffer = nox.crypto.aead_seal_bytes(key, nonce, data, aad)
#     data2: Buffer = nox.crypto.aead_open_bytes(key, nonce, sealed, aad)
def _buf_hex(b: Buffer) -> str:
    digits: str = "0123456789abcdef"
    parts: list[str] = []
    i: int = 0
    while i < b.len():
        v: int = int(b.get(i))
        parts.append(digits[v // 16] + digits[v % 16])
        i = i + 1
    return "".join(parts)

def _hex_buf(h: str) -> Buffer:
    out: Buffer = Buffer(len(h) // 2)
    digits: str = "0123456789abcdef"
    i: int = 0
    while i < len(h) // 2:
        hi: int = digits.find(h[2 * i])
        lo: int = digits.find(h[2 * i + 1])
        out.set(i, u8(hi * 16 + lo))
        i = i + 1
    return out

def aead_seal_bytes(key: Buffer, nonce: Buffer, plaintext: Buffer, aad: Buffer, algorithm: str = "chacha20-poly1305") -> Buffer:
    out: str = nox_crypto_aead_raw(3, _aead_alg(algorithm), _buf_hex(key), _buf_hex(nonce), _buf_hex(plaintext), _buf_hex(aad))
    _aead_check(nox_crypto_aead_status_raw(), "aead_seal_bytes")
    return _hex_buf(out)

def aead_open_bytes(key: Buffer, nonce: Buffer, sealed: Buffer, aad: Buffer, algorithm: str = "chacha20-poly1305") -> Buffer:
    out: str = nox_crypto_aead_raw(2, _aead_alg(algorithm), _buf_hex(key), _buf_hex(nonce), _buf_hex(sealed), _buf_hex(aad))
    _aead_check(nox_crypto_aead_status_raw(), "aead_open_bytes")
    return _hex_buf(out)

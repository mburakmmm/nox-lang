# nox.csv — RFC 4180 uyumlu CSV ayrıştırma/yazma. Saf Nox'ta yazıldı
# (yeni bir runtime ilkeli GEREKMEDİ) — Nox'ta dilim sözdizimi (`s[a:b]`)
# olmadığından tek-geçişli, karakter-karakter bir durum makinesi
# (`s[i]` ile) kullanılır. `continue`/`break` Nox'ta YOK — döngü gövdesi
# SAF bir if/elif zinciri, HER dal KENDİ `i`sini günceller.
#
# Kapsam (BİLİNÇLİ v1): virgülle ayrılmış, çift-tırnak İLE alıntılanabilen
# alanlar — alıntılı bir alan virgül/tırnak/satır-sonu İÇEREBİLİR, kaçış
# İçİn `""` (iki ardışık çift tırnak = BİR tırnak karakteri). Okurken HEM
# `\n` HEM `\r\n` satır sonu KABUL edilir, YAZARKEN SADECE `\n` üretilir.
# Özel ayraç (`;`/TAB), BOM, dosyadan-doğrudan-okuma (bu modül METİN
# alır, dosya AÇMAZ — bkz. `nox.fs`) kapsam DIŞI.

class CsvError(Exception):
    pass

def _field_needs_quoting(field: str) -> bool:
    i: int = 0
    n: int = len(field)
    while i < n:
        c: str = field[i]
        if c == "," or c == "\"" or c == "\n" or c == "\r":
            return True
        i = i + 1
    return False

def _quote_field(field: str) -> str:
    result: str = "\""
    i: int = 0
    n: int = len(field)
    while i < n:
        c: str = field[i]
        if c == "\"":
            result = result + "\"\""
        else:
            result = result + c
        i = i + 1
    return result + "\""

# `text`i satır/sütunlara ayırır — HER satır `list[str]`, tüm satırlar
# `list[list[str]]`. Boş metin `[]` döner; sondaki temiz bir `\n`
# SAHTE bir ek (boş) satır ÜRETMEZ.
# v2.1.62: ayrıştırma Zig'de (`runtime/stdlib_shims/csv.zig`); anlam saf-Nox durum makinesiyle BİREBİR aynıdır (golden: `csv_zig_equivalence`). Zig düz alan listesini ve satır uzunluklarını verir.
extern def nox_csv_fields_raw(text: str) -> list[str] from "zig-out/lib/noxrt.o" with_rt
extern def nox_csv_row_lens_raw() -> list[int] from "zig-out/lib/noxrt.o" with_rt
extern def nox_csv_last_ok_raw() -> int from "zig-out/lib/noxrt.o"

def parse(text: str) -> list[list[str]]:
    fields: list[str] = nox_csv_fields_raw(text)
    if nox_csv_last_ok_raw() == 0:
        raise CsvError("unterminated quoted field")
    lens: list[int] = nox_csv_row_lens_raw()
    rows: list[list[str]] = []
    pos: int = 0
    for n in lens:
        rows.append(fields[pos:pos + n])
        pos = pos + n
    return rows

# İLK satırı başlık olarak kullanıp SONRAKİ HER satırı `dict[str,str]`e
# çevirir (eksik sütunlar İçİn `""`) — pratik kullanım İçİn bir kolaylık
# katmanı.
def parse_dicts(text: str) -> list[dict[str, str]]:
    rows: list[list[str]] = parse(text)
    result: list[dict[str, str]] = []
    if len(rows) == 0:
        return result
    header: list[str] = rows[0]
    i: int = 1
    n: int = len(rows)
    while i < n:
        row: list[str] = rows[i]
        d: dict[str, str] = {}
        j: int = 0
        m: int = len(header)
        while j < m:
            if j < len(row):
                d[header[j]] = row[j]
            else:
                d[header[j]] = ""
            j = j + 1
        result.append(d)
        i = i + 1
    return result

# v3 sertleştirme yol haritası, madde 10 (bkz. nox-teknik-spesifikasyon.md
# ilgili bölüm, stdlib/API denetimi): `write`/`write_row` (v1.110.4'e
# kadarki isimler) `dump`/`dump_row` OLARAK YENİDEN ADLANDIRILDI —
# `nox.json`/`nox.toml`/`nox.yaml`nin AYNI `parse`/`dump` çiftiyle TÜM
# format modülleri ARASINDA TUTARLI KILINMASI İçİn.
def dump_row(fields: list[str]) -> str:
    result: str = ""
    i: int = 0
    n: int = len(fields)
    while i < n:
        f: str = fields[i]
        if _field_needs_quoting(f):
            result = result + _quote_field(f)
        else:
            result = result + f
        if i < n - 1:
            result = result + ","
        i = i + 1
    return result

def dump(rows: list[list[str]]) -> str:
    result: str = ""
    i: int = 0
    n: int = len(rows)
    while i < n:
        result = result + dump_row(rows[i]) + "\n"
        i = i + 1
    return result

import nox.strings

class HttpError(Exception):
    pass

# `request(..., timeout_ms)` süre dolduğunda fırlatır (bağlantı gerçekten iptal edilir); `except HttpError` bunu da yakalar.
class HttpTimeoutError(HttpError):
    pass

class HttpResponse:
    def __init__(self: HttpResponse, status: int, body: str, headers: dict[str, str]) -> None:
        self.status = status
        self.body = body
        self.headers = headers

# v2.0.124 — akışlı yanıt (SSE, büyük/uzun yanıtlar). `HttpRequest.stream`/`sse` döndürür. Parçalar yazılır yazılmaz istemciye gönderilir.
# İstemci gittiğinde `send` `False` döner ve akış kapanır: döngüler `is_open()`/`send` sonucuna bakmalıdır. Kopma bir SONRAKİ yazmada anlaşılır, uzun sessizliklerde `comment()` ile kalp atışı gönderin.
class ResponseStream:
    def __init__(self: ResponseStream, conn: int) -> None:
        self.conn = conn
        # `conn == 0` (birim testi): gönderilen parçalar burada toplanır.
        self.sent: list[str] = []
        self.finished = False

    # Ham bir parça yazar. `True`: yazıldı; `False`: istemci gitti ya da akış bitti.
    def send(self: ResponseStream, chunk: str) -> bool:
        if self.conn == 0:
            if self.finished:
                return False
            self.sent.append(chunk)
            return True
        return nox_http_respstream_send_raw(self.conn, chunk) != 0

    # Bir SSE olayı: `data` çok satırlıysa her satır ayrı `data:` alanı olur; `event`/`id` yeni satır içeremez (temizlenir).
    def event(self: ResponseStream, data: str, event: str = "", id: str = "") -> bool:
        out: str = ""
        if event != "":
            out = out + "event: " + _sse_line(event) + "\n"
        if id != "":
            out = out + "id: " + _sse_line(id) + "\n"
        for line in nox.strings.split(nox.strings.replace(data, "\r", ""), "\n"):
            out = out + "data: " + line + "\n"
        return self.send(out + "\n")

    # SSE yorum satırı (`: metin`): istemci görmez, bağlantıyı canlı tutar ve kopmayı yakalar.
    def comment(self: ResponseStream, text: str = "") -> bool:
        return self.send(": " + _sse_line(text) + "\n\n")

    # Yeniden bağlanma gecikmesi önerisi (ms).
    def retry(self: ResponseStream, ms: int) -> bool:
        return self.send("retry: " + str(ms) + "\n\n")

    # Akış açık mı: başlamış, yazma hatası yok, `end` çağrılmamış ve sunucu kapanmıyor (SIGTERM/`nox.http.shutdown()`).
    def is_open(self: ResponseStream) -> bool:
        if self.conn == 0:
            return not self.finished
        return nox_http_respstream_open_raw(self.conn) != 0

    # Akış döngülerinde bekleme. Kooperatiftir (diğer bağlantılar ilerler, QBE'nin tek iş parçacığı takılmaz) ve sunucu kapanırken erken döner; `nox.time.sleep_ms` yerine bunu kullanın.
    def sleep_ms(self: ResponseStream, ms: int) -> None:
        nox_http_respstream_sleep_raw(ms)

    # Akışı bitirir ve handler'ın döndürmesi gereken yer tutucu yanıtı verir: `return stream.end()`. (Dönen yanıt yok sayılır.)
    def end(self: ResponseStream) -> HttpResponse:
        if self.conn == 0:
            self.finished = True
        else:
            nox_http_respstream_end_raw(self.conn)
        return HttpResponse(200, "", {})

def _sse_line(s: str) -> str:
    return nox.strings.replace(nox.strings.replace(s, "\r", ""), "\n", " ")

# stdlib fazı §D.1.6: `nox.http.serve`in `handle` çağrı sitesine geçtiği
# istek nesnesi — alan SIRASI (method, target, body, headers, peer_addr)
# codegen'in `genHttpServeWrapper`ının HANGİ `nox_http_request_*`
# erişimcisini hangi alana yazacağını AD üzerinden çözmesiyle
# EŞLEŞMELİDİR (bkz. codegen.zig).
#
# Aether NOX_LIMITATIONS.md yol haritası, Faz A.3 (bkz. nox-teknik-
# spesifikasyon.md ilgili bölüm): `peer_addr` — bağlantıyı kabul eden
# `accept()`in doldurduğu karşı tarafın "`ip:port`" adresi (HER ZAMAN
# IPv4 — dinleme soketi HER ZAMAN `AF_INET`dir).
# v2.0 sözleşmesi (VERSIONING.md §5): kurucuya EKLENEN her yeni parametre varsayılan değer TAŞIR, böylece mevcut çağıranlar (testler, çerçeveler)
# bozulmaz; `peer_addr` bunun ilk uygulamasıdır (eskiden zorunluydu ve Aether'i kırmıştı).
# v2.0.124: `conn` sunucunun bu bağlantı için doldurduğu iç tutamaçtır (yalnızca handler çağrısı boyunca geçerli; elle kurulan isteklerde 0 = bağlantı yok). `stream`/`sse` onu kullanır.
class HttpRequest:
    def __init__(self: HttpRequest, method: str, target: str, body: str, headers: dict[str, str], peer_addr: str = "", conn: int = 0) -> None:
        self.method = method
        self.target = target
        self.body = body
        self.headers = headers
        self.peer_addr = peer_addr
        self.conn = conn

    # Akışlı yanıt başlatır: durum satırı ve başlıklar HEMEN gönderilir, gövde `ResponseStream.send` ile parça parça yazılır (chunked). Handler sonunda `return stream.end()`.
    # Akıştan sonra bağlantı kapanır. Başlatılamazsa (akış zaten başlamış, durum 200-599 dışı/204/304, geçersiz başlık, bağlantı yok) `HttpError`.
    # Elle kurulmuş isteklerde (`conn == 0`, birim testleri) akış bellekte toplanır: `stream.sent`.
    def stream(self: HttpRequest, status: int, headers: dict[str, str]) -> ResponseStream:
        s: ResponseStream = ResponseStream(self.conn)
        if self.conn != 0:
            if nox_http_respstream_start_raw(self.conn, status, headers) == 0:
                raise HttpError("cannot start a streaming response (already started, invalid status or header, or the client is gone)")
        return s

    # Server-Sent Events: `Content-Type: text/event-stream`, `Cache-Control: no-cache`, vekil tamponlamasını kapatan `X-Accel-Buffering: no`. Olayları `stream.event(...)` ile yazın.
    def sse(self: HttpRequest) -> ResponseStream:
        return self.stream(200, {"Content-Type": "text/event-stream; charset=utf-8", "Cache-Control": "no-cache", "X-Accel-Buffering": "no"})

extern def nox_http_get_raw(url: str, headers: dict[str, str]) -> ptr from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_post_raw(url: str, body: str, headers: dict[str, str]) -> ptr from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_request_raw(method: str, url: str, body: str, has_body: int, headers: dict[str, str], timeout_ms: int) -> ptr from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_response_error_kind(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_response_ok(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_response_status(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_response_body(h: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_response_headers(h: ptr) -> dict[str, str] from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_response_free(h: ptr) -> None from "zig-out/lib/noxrt.o"

# Faz DD.1 (bkz. nox-teknik-spesifikasyon.md §3.60) — çok-çekirdekli
# sunumun temel taşı: `socket()`/`bind()`/`listen()` yapıp ham dosya
# tanımlayıcısını (`fd`) saf bir `int` olarak döner. Bu `int`, `nox.
# thread`in ZATEN desteklediği iş-parçacıkları-arası aktarım
# tiplerinden biridir — TEK bir `listen`den dönen `fd`, `nox.thread.
# start` ile N bağımsız iş parçacığına dağıtılıp her biri kendi
# `nox.http.serve_fd(fd, handle)`ini çağırabilir (ya da tek satırlık
# `nox.http.serve_multicore(port, handle, num_threads)` kolaylığı
# kullanılabilir).
#
# Faz MN.7b: `noxc build --release` (LLVM backend) İLE derlendiğinde
# `serve_multicore` ARTIK `nox.thread.start`nin N-BAĞIMSIZ-`RuntimeState`
# modeli YERİNE `nox.thread.pool_run`ın AYNI paylaşılan `WorkerPool`unu
# kullanır — TÜM worker'lar TEK bir ARC havuzunu/döngü-çözücüyü
# PAYLAŞIR (`nox.thread.start` tabanlı bayraksız `noxc build` yolu
# BİREBİR DEĞİŞMEDEN kalır). Bağlantı işleyicisi (`handle`) HÂLÂ
# `async def` OLAMAZ — `spawn`/`await` handler İçİNDEN KULLANILAMAZ
# (bağlantı zaten kendi fiber'ında senkron çalışır); bağlantı-seviyesi
# dengeleme ZATEN paylaşılan-fd üzerindeki OS-seviyesi `accept()`
# yarışıyla sağlanır, --release'in KENDİSİ BUNU DEĞİŞTİRMEZ.
# v2.0.118 — sunucu yapılandırması ve graceful shutdown (bkz. spec §3.324). `configure` süreç-geneli ayarları `serve*`den ÖNCE kurar (0 = varsayılanı koru):
#   max_body_bytes    istek gövdesi üst sınırı (varsayılan 10 MiB; aşılırsa 413)
#   max_header_bytes  istek satırı + başlıklar için tampon (varsayılan 16 KiB, 4 KiB-1 MiB; aşılırsa 431)
#   read_timeout_ms   bir istek beklerken/okurken en uzun sessizlik (varsayılan 30000)
#   max_connections   aynı anda en çok açık bağlantı (varsayılan 4096; aşan bağlantı reddedilir)
#   drain_timeout_ms  shutdown'da uçuştaki isteklerin bitmesi için en uzun bekleme (varsayılan 10000)
# `shutdown()` graceful kapanış başlatır (SIGTERM/SIGINT de aynısını yapar): yeni bağlantı alınmaz, uçuştaki istekler biter, boştaki keep-alive bağlantılar kapanır ve `serve*` DÖNER;
# çağıran sonrasında temizlik kodunu çalıştırabilir. İkinci sinyal hemen çıkar.
# v2.0.120 — AYNI adlı birden çok yanıt başlığı (Set-Cookie, Link, Vary ...): `HttpResponse.headers` bir `dict[str, str]` olduğundan değerler `\n` ile birleştirilir ve sunucu HER parçayı
# ayrı bir başlık satırı olarak yazar: `h["Set-Cookie"] = nox.http.multi(["a=1; Path=/", "b=2; Path=/"])`. (Başlıkta CR/NUL hâlâ yasak: yanıt reddedilir.) İstek tarafında yinelenen
# başlıklar `req.headers`te `, ` ile (Cookie için `; ` ile) birleşik gelir.
def multi(values: list[str]) -> str:
    out: str = ""
    first: bool = True
    for v in values:
        if not first:
            out = out + "\n"
        out = out + v
        first = False
    return out

extern def nox_http_config_set_raw(key: int, value: int) -> None from "zig-out/lib/noxrt.o"
extern def nox_http_shutdown_raw() -> None from "zig-out/lib/noxrt.o"
extern def nox_http_respstream_start_raw(conn: int, status: int, headers: dict[str, str]) -> int from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_respstream_send_raw(conn: int, data: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_respstream_end_raw(conn: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_respstream_open_raw(conn: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_respstream_sleep_raw(ms: int) -> None from "zig-out/lib/noxrt.o"

def configure(max_body_bytes: int = 0, max_header_bytes: int = 0, read_timeout_ms: int = 0, max_connections: int = 0, drain_timeout_ms: int = 0) -> None:
    nox_http_config_set_raw(1, max_body_bytes)
    nox_http_config_set_raw(2, max_header_bytes)
    nox_http_config_set_raw(3, read_timeout_ms)
    nox_http_config_set_raw(4, max_connections)
    nox_http_config_set_raw(5, drain_timeout_ms)

def shutdown() -> None:
    nox_http_shutdown_raw()

# HTTP/2 (v2.0.127): TLS'te ALPN `h2` ve düz TCP'de istemci ön eki (h2c) ile açılır. `False` iken TLS yalnızca `http/1.1` sunar ve h2c algılanmaz. Sonradan kabul edilen bağlantılar için geçerlidir.
def set_http2(enabled: bool) -> None:
    if enabled:
        nox_http_config_set_raw(6, 1)
    else:
        nox_http_config_set_raw(6, 2)

extern def nox_http_client_pool_set_raw(max_idle: int) -> None from "zig-out/lib/noxrt.o"
extern def nox_http_client_pool_idle_raw() -> int from "zig-out/lib/noxrt.o"
extern def nox_http_client_pool_idle_timeout_raw(ms: int) -> None from "zig-out/lib/noxrt.o"

# Giden isteklerin bağlantı havuzu (v2.0.126): bir isteğin bağlantısı bitince boşta havuza döner, aynı sunucuya sonraki istekler onu kullanır (TCP + TLS el sıkışması atlanır).
# `max_idle`, süreç-geneli boşta bağlantı üst sınırıdır (varsayılan 32); 0 havuzu kapatır (boştakiler hemen kapanır, her istek kendi bağlantısını açıp kapatır).
# `idle_timeout_ms`: boşta bir bağlantının havuzda en çok ne kadar kalacağı (varsayılan 90000 = 90 sn; 0 = sınırsız; verilmezse mevcut değer korunur).
def client_pool(max_idle: int, idle_timeout_ms: int = -1) -> None:
    nox_http_client_pool_set_raw(max_idle)
    if idle_timeout_ms >= 0:
        nox_http_client_pool_idle_timeout_raw(idle_timeout_ms)

# Şu an havuzda bekleyen boşta bağlantı sayısı.
def client_idle_connections() -> int:
    return nox_http_client_pool_idle_raw()

extern def nox_http_listen_fd(port: int) -> int from "zig-out/lib/noxrt.o" with_rt

def listen(port: int) -> int:
    fd: int = nox_http_listen_fd(port)
    if fd < 0:
        raise HttpError("listen failed: port " + str(port))
    return fd

# v1.142.10: OPT-IN IPv6 dinleyici (varsayılan `listen` IPv4-only KALIR).
# `v6_only=False` → dual-stack (`::`): IPv4 istemciler de bağlanır ve
# `HttpRequest.peer_addr` onlar için ESKİ `a.b.c.d:port` biçiminde kalır;
# gerçek IPv6 istemciler `[::1]:port` biçimini alır (IP'yi `:` ile bölen
# kod bunu `rsplit`/köşeli-parantez ile ele almalıdır). Dönen fd
# `serve_fd(fd, handler)` / `serve_multicore`-benzeri kabul döngüleriyle
# kullanılır. Windows'ta desteklenmez (`HttpError`).
extern def nox_http_listen_fd_v6(port: int, v6_only: int) -> int from "zig-out/lib/noxrt.o" with_rt

def listen_v6(port: int, v6_only: bool) -> int:
    only: int = 0
    if v6_only:
        only = 1
    fd: int = nox_http_listen_fd_v6(port, only)
    if fd < 0:
        raise HttpError("IPv6 listen failed: port " + str(port))
    return fd

def get(url: str, headers: dict[str, str]) -> HttpResponse:
    h: ptr = nox_http_get_raw(url, headers)
    if nox_http_response_ok(h) == 0:
        nox_http_response_free(h)
        raise HttpError("request failed: " + url)
    status: int = nox_http_response_status(h)
    body: str = nox_http_response_body(h)
    # Faz FF.3 (bkz. nox-teknik-spesifikasyon.md §3.62): `dict[K,V]` ARTIK
    # `str`/`list`/`class` İLE AYNI TAM ARC modelindedir — `nox_http_
    # response_headers(h)`nin SONUCU İSTER doğrudan burada (adlandırılmamış
    # bir geçici olarak) İSTER adlandırılmış bir yerele BAĞLANARAK
    # kullanılsın, HER İKİ durumda da GÜVENLİDİR (bkz. `dict.zig`nin
    # modül-üstü notu — ESKİDEN burada BAĞLAMA YASAĞI vardı, ARTIK YOK).
    resp: HttpResponse = HttpResponse(status, body, nox_http_response_headers(h))
    nox_http_response_free(h)
    return resp

def post(url: str, body: str, headers: dict[str, str]) -> HttpResponse:
    h: ptr = nox_http_post_raw(url, body, headers)
    if nox_http_response_ok(h) == 0:
        nox_http_response_free(h)
        raise HttpError("request failed: " + url)
    status: int = nox_http_response_status(h)
    resp_body: str = nox_http_response_body(h)
    # Bkz. `get`in AYNI notu (Faz FF.3).
    resp: HttpResponse = HttpResponse(status, resp_body, nox_http_response_headers(h))
    nox_http_response_free(h)
    return resp

# Genel HTTP isteği. `method`: GET, POST, PUT, PATCH, DELETE, HEAD veya OPTIONS (büyük harf); başka bir ad HttpError verir,
# sessizce GET'e dönüşmez. Gövde yalnızca POST/PUT/PATCH ile gönderilebilir. `timeout_ms > 0` ise bağlantı kurulduktan sonraki
# gönderme/okuma bu süreyi aşarsa bağlantı iptal edilir ve HttpTimeoutError fırlar. DNS çözümleme ve TCP bağlanma aşaması da
# aynı `timeout_ms` ile sınırlıdır (v2.0.91): çözülemeyen ad ya da cevap vermeyen adres işletim sisteminin dakikalık süresini
# beklemez. `timeout_ms = 0`: sınırsız.
def request(method: str, url: str, body: str, headers: dict[str, str], timeout_ms: int = 0) -> HttpResponse:
    has_body: int = 0
    if method == "POST" or method == "PUT" or method == "PATCH":
        has_body = 1
    h: ptr = nox_http_request_raw(method, url, body, has_body, headers, timeout_ms)
    if nox_http_response_ok(h) == 0:
        kind: int = nox_http_response_error_kind(h)
        nox_http_response_free(h)
        if kind == 3:
            raise HttpError("invalid request (unsupported method, a body on a method that cannot carry one, or a bad header): " + method + " " + url)
        if kind == 1:
            raise HttpTimeoutError("request timed out: " + method + " " + url)
        raise HttpError("request failed: " + method + " " + url)
    status: int = nox_http_response_status(h)
    resp_body: str = nox_http_response_body(h)
    resp: HttpResponse = HttpResponse(status, resp_body, nox_http_response_headers(h))
    nox_http_response_free(h)
    return resp

def put(url: str, body: str, headers: dict[str, str]) -> HttpResponse:
    return request("PUT", url, body, headers)

def patch(url: str, body: str, headers: dict[str, str]) -> HttpResponse:
    return request("PATCH", url, body, headers)

def delete(url: str, headers: dict[str, str]) -> HttpResponse:
    return request("DELETE", url, "", headers)

def head(url: str, headers: dict[str, str]) -> HttpResponse:
    return request("HEAD", url, "", headers)

def options(url: str, headers: dict[str, str]) -> HttpResponse:
    return request("OPTIONS", url, "", headers)

# ---- Akışlı istemci (v2.0.69, Nova N.4) ----
#
# `get`/`post`/`request` yanıt gövdesinin TAMAMINI belleğe alır. Büyük gövdeler için `stream` (indirme) ve `stream_upload` (yükleme)
# bir `HttpStream` döner; gövde parça parça okunur/yazılır, bellek kullanımı parça boyutuyla sınırlıdır ve okuma çekme tabanlıdır
# (yalnızca `read_chunk` çağrıldıkça ağdan okunur).
#
#     with stream("GET", url, {}) as s:
#         if s.status == 200:
#             while True:
#                 chunk: str = s.read_chunk(65536)
#                 if len(chunk) == 0:       # gövde sonu
#                     break
#                 ...
#
# Parça ham baytları taşıyan bir `str`tir (ikili veri, gömülü NUL dahil); bir parça çok baytlı bir UTF-8 karakterinin ortasında
# bitebilir. `read_chunk(n)` en az bir bayt hazır olunca döner (en çok `n`); dosya gibi tam `n` doldurmaz. Gövde `Content-Encoding`e
# göre (gzip/deflate) çözülerek verilir. `timeout_ms > 0`: HER işlem (bağlanma sonrası başlık beklemesi, her `read_chunk`/`write`)
# için en çok bu kadar boşta beklenir, aşılırsa bağlantı iptal edilir ve `HttpTimeoutError` fırlar (toplam süre değil).
#
# `HttpStream` işletim sistemi bağlantısını tutar ve kendiliğinden KAPATILMAZ: `with` kullanın ya da `close()` çağırın
# (iki kez çağrılabilir). Yönlendirmeler izlenmez; gövde yalnızca POST/PUT/PATCH ile gönderilebilir (`request` ile aynı).
extern def nox_http_stream_open_raw(method: str, url: str, headers: dict[str, str], body: str, has_body: int, upload_len: int, timeout_ms: int) -> ptr from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_stream_error_kind(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_stream_ok(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_stream_status(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_stream_headers(h: ptr) -> dict[str, str] from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_stream_read_raw(h: ptr, n: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_http_stream_write_raw(h: ptr, content: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_stream_finish_raw(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_http_stream_close_raw(h: ptr) -> None from "zig-out/lib/noxrt.o"

class HttpStream:
    def __init__(self: HttpStream, handle: ptr, label: str, uploading: bool, status: int, headers: dict[str, str]) -> None:
        self.handle = handle
        self.label = label
        self.uploading = uploading
        self.closed = False
        self.status = status
        self.headers = headers

    # İşlem başarısızsa akışı kapatıp doğru istisnayı fırlatır.
    def _fail(self: HttpStream, what: str) -> None:
        kind: int = nox_http_stream_error_kind(self.handle)
        self.close()
        if kind == 1:
            raise HttpTimeoutError("request timed out: " + self.label)
        raise HttpError(what + ": " + self.label)

    def read_chunk(self: HttpStream, n: int) -> str:
        if self.closed:
            raise HttpError("stream is closed: " + self.label)
        if self.uploading:
            raise HttpError("finish() the upload before reading the response: " + self.label)
        if n <= 0:
            raise HttpError("read_chunk needs a positive size: " + self.label)
        chunk: str = nox_http_stream_read_raw(self.handle, n)
        if nox_http_stream_ok(self.handle) == 0:
            self._fail("could not read the response body")
        return chunk

    # Yükleme parçası gönderir (`stream_upload` ile açılmış akışlar).
    def write(self: HttpStream, content: str) -> None:
        if self.closed:
            raise HttpError("stream is closed: " + self.label)
        if not self.uploading:
            raise HttpError("this stream is not an upload: " + self.label)
        if nox_http_stream_write_raw(self.handle, content) == 0:
            self._fail("could not send the request body")

    # Yüklemeyi bitirir ve yanıt başlığını okur; sonrasında `status`/`headers` dolar ve gövde `read_chunk` ile okunur.
    def finish(self: HttpStream) -> None:
        if self.closed:
            raise HttpError("stream is closed: " + self.label)
        if not self.uploading:
            raise HttpError("this stream is not an upload: " + self.label)
        if nox_http_stream_finish_raw(self.handle) == 0:
            self._fail("could not finish the upload")
        self.uploading = False
        self.status = nox_http_stream_status(self.handle)
        self.headers = nox_http_stream_headers(self.handle)

    def close(self: HttpStream) -> None:
        if not self.closed:
            self.closed = True
            nox_http_stream_close_raw(self.handle)

    def __enter__(self: HttpStream) -> HttpStream:
        return self

    def __exit__(self: HttpStream) -> None:
        self.close()

def _open_stream(method: str, url: str, body: str, has_body: int, headers: dict[str, str], upload_len: int, timeout_ms: int) -> HttpStream:
    h: ptr = nox_http_stream_open_raw(method, url, headers, body, has_body, upload_len, timeout_ms)
    if nox_http_stream_ok(h) == 0:
        kind: int = nox_http_stream_error_kind(h)
        nox_http_stream_close_raw(h)
        if kind == 3:
            raise HttpError("invalid request (unsupported method, a body on a method that cannot carry one, or a bad header): " + method + " " + url)
        if kind == 1:
            raise HttpTimeoutError("request timed out: " + method + " " + url)
        raise HttpError("request failed: " + method + " " + url)
    return HttpStream(h, method + " " + url, upload_len != -2, nox_http_stream_status(h), nox_http_stream_headers(h))

# İsteği gönderir, yanıt başlığını bekler ve gövdeyi parça parça okunacak şekilde döner. `body` (isteğe bağlı bellek-içi gövde)
# yalnızca POST/PUT/PATCH ile geçerlidir.
def stream(method: str, url: str, headers: dict[str, str], body: str = "", timeout_ms: int = 0) -> HttpStream:
    has_body: int = 0
    if body != "":
        has_body = 1
    return _open_stream(method, url, body, has_body, headers, -2, timeout_ms)

# Akışlı yükleme: `write` ile gövdeyi parça parça gönderin, `finish()` ile bitirip yanıtı okuyun. `content_length >= 0` sabit
# Content-Length ile gönderir (toplam yazılan bayt tam eşit olmalı), `-1` chunked transfer encoding kullanır. Yalnızca POST/PUT/PATCH.
def stream_upload(method: str, url: str, headers: dict[str, str], content_length: int = -1, timeout_ms: int = 0) -> HttpStream:
    if content_length < -1:
        raise HttpError("content_length must be -1 (chunked) or a non-negative size")
    return _open_stream(method, url, "", 0, headers, content_length, timeout_ms)

# Dosyaya/dosyadan akış yardımcıları (`download_to_file`, `upload_file`) bu modülde DEĞİL, `nox.transfer`dedir: onlar hem ağ hem dosya sistemi
# yeteneği ister, `nox.http` ise yalnızca `network` ister.

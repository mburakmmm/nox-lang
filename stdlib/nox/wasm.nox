# nox.wasm (v2.1.92) — gömülü WebAssembly yorumlayıcısı (saf Zig, JIT yok; mobil dahil her hedefte aynı). Bir `.wasm` modülünü açar, dışa aktarılan
# işlevlerini çağırır ve doğrusal belleğini sınır denetimli okur/yazar. Modül SANDBOX'tadır: dosya/ağ/süreç erişimi yoktur (içe aktarma gerektiren
# modüller `open` ile açılamaz; host işlevleri sonraki sürüm). Yakıt (talimat sayısı) ve bellek sayfası tavanı vardır: sonsuz döngü ve bellek
# tüketimi `WasmError` verir. Değerler: `i32`/`i64` parametre ve sonuçlar `int` (i32 işaret genişletilir); `f32`/`f64` için `call_f` ya da
# `f64_bits`/`f64_from_bits`. Opak tutamaç: Nox'a modülün ham belleği verilmez (İlke 4), yalnızca kopyalayan `read_*`/`write_*` çağrıları vardır.

import nox.ffi
from nox.ffi import Callback

extern def nox_wasm_open_raw(path: str, fuel: int, max_pages: int) -> ptr from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_open_bytes_raw(data: list[int], fuel: int, max_pages: int) -> ptr from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_is_null_raw(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_null_raw() -> ptr from "zig-out/lib/noxrt.o"
extern def nox_wasm_error_raw(h: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_close_raw(h: ptr) -> None from "zig-out/lib/noxrt.o"
extern def nox_wasm_call_raw(h: ptr, name: str, args: list[int]) -> int from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_call_f_raw(h: ptr, name: str, args: list[int]) -> float from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_result_raw(h: ptr, i: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_result_count_raw(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_exports_raw(h: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_signature_raw(h: ptr, name: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_mem_size_raw(h: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_mem_read_raw(h: ptr, off: int, n: int) -> list[int] from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_mem_read_str_raw(h: ptr, off: int, n: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_mem_write_raw(h: ptr, off: int, data: list[int]) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_mem_write_str_raw(h: ptr, off: int, s: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_mem_load_raw(h: ptr, off: int, width: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_mem_store_raw(h: ptr, off: int, width: int, value: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_f64_to_bits_raw(x: float) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_f64_from_bits_raw(b: int) -> float from "zig-out/lib/noxrt.o"
extern def nox_wasm_f32_to_bits_raw(x: float) -> int from "zig-out/lib/noxrt.o"
extern def nox_wasm_f32_from_bits_raw(b: int) -> float from "zig-out/lib/noxrt.o"

class WasmError(Exception):
    pass

# WASI `proc_exit(kod)` çağrıldığında fırlar; kod `Instance.exit_code()` ile okunur.
class WasmExit(Exception):
    pass

# --- W3: host işlevleri (v2.1.93). Modülün içe aktarmaları Nox işlevleriyle karşılanır. Host işlevi en çok 4 parametre ve 1 sonuç alır; hepsi `int`:
# wasm `i32` işaret genişletilmiş, `i64` olduğu gibi, `f32`/`f64` ham bit deseni olarak gelir (`f64_from_bits` ile çevrilir). Gönderici (`@ffi.callback`)
# her çağrı süresince geçerlidir; saklanan bir geri çağrı yoktur. Host işlevinde fırlayan istisna yürütmeyi keser ve çağrıda `WasmError` olur.
@ffi.callback("cb", "userdata")
extern def nox_wasm_open_host_raw(path: str, names: list[str], wasi_args: list[str], flags: int, fuel: int, max_pages: int, cb: (int, int, int, int, int, ptr) -> int, userdata: ptr) -> ptr from "zig-out/lib/noxrt.o" with_rt
@ffi.callback("cb", "userdata")
extern def nox_wasm_open_bytes_host_raw(data: list[int], names: list[str], wasi_args: list[str], flags: int, fuel: int, max_pages: int, cb: (int, int, int, int, int, ptr) -> int, userdata: ptr) -> ptr from "zig-out/lib/noxrt.o" with_rt
@ffi.callback("cb", "userdata")
extern def nox_wasm_call_host_raw(h: ptr, name: str, args: list[int], cb: (int, int, int, int, int, ptr) -> int, userdata: ptr) -> int from "zig-out/lib/noxrt.o"
@ffi.callback("cb", "userdata")
extern def nox_wasm_call_f_host_raw(h: ptr, name: str, args: list[int], cb: (int, int, int, int, int, ptr) -> int, userdata: ptr) -> float from "zig-out/lib/noxrt.o"
extern def nox_wasm_host_fail_raw(h: ptr) -> None from "zig-out/lib/noxrt.o"
extern def nox_wasm_take_stdout_raw(h: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_take_stderr_raw(h: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_wasm_exit_code_raw(h: ptr) -> int from "zig-out/lib/noxrt.o"

def _no_hosts() -> list[(int, int, int, int) -> int]:
    empty: list[(int, int, int, int) -> int] = []
    return empty

class Instance:
    def __init__(self: Instance, handle: ptr, hosts: list[(int, int, int, int) -> int]) -> None:
        self.handle = handle
        self.closed = False
        self.hosts = hosts
        # Host gönderici: örnek BAŞINA bir kez kurulur (örneği kapanışla taşır; `close()` kapatır). Modül düzeyinde "etkin örnek" durumu yoktur: host işlevi görevi askıya alıp başka bir görev başka örneği çağırsa da doğru örnek kullanılır.
        self.cb: Callback[(int, int, int, int, int) -> int] = _make_cb(handle, hosts)

    def _check(self: Instance) -> None:
        if self.closed:
            raise WasmError("wasm instance is closed")
        msg: str = nox_wasm_error_raw(self.handle)
        if msg != "":
            raise WasmError(msg)

    # Çağrı sonrası denetim: önce WASI `proc_exit` (WasmExit), sonra hata (WasmError).
    def _check_call(self: Instance) -> None:
        if self.closed:
            raise WasmError("wasm instance is closed")
        if nox_wasm_exit_code_raw(self.handle) >= 0:
            raise WasmExit("wasm module exited with code " + str(nox_wasm_exit_code_raw(self.handle)))
        self._check()

    # Dışa aktarılan işlevi tamsayı argümanlarla çağırır (en çok 16); ilk sonucu döner (sonuç yoksa 0). Tuzak/yakıt bitişi `WasmError`.
    def call(self: Instance, name: str, args: list[int]) -> int:
        if self.closed:
            raise WasmError("wasm instance is closed")
        r: int = 0
        if len(self.hosts) > 0:
            # Gönderici örneği KAPANIŞLA taşır (modül düzeyinde "etkin örnek yığını" yok): host işlevi görevi askıya alıp başka bir görev başka bir örneği çağırsa da doğru örneğin `hosts` listesi kullanılır.
            cbh: Callback[(int, int, int, int, int) -> int] = self.cb
            r = nox_wasm_call_host_raw(self.handle, name, args, cbh)
        else:
            r = nox_wasm_call_raw(self.handle, name, args)
        self._check_call()
        return r

    # `f32`/`f64` içeren imzalar için: argümanlar `float` (tamsayı parametreler değeri keser), ilk sonuç `float` döner.
    def call_f(self: Instance, name: str, args: list[float]) -> float:
        if self.closed:
            raise WasmError("wasm instance is closed")
        bits: list[int] = []
        for a in args:
            bits.append(nox_wasm_f64_to_bits_raw(a))
        r: float = 0.0
        if len(self.hosts) > 0:
            cbh: Callback[(int, int, int, int, int) -> int] = self.cb
            r = nox_wasm_call_f_host_raw(self.handle, name, bits, cbh)
        else:
            r = nox_wasm_call_f_raw(self.handle, name, bits)
        self._check_call()
        return r

    # Çok değerli dönüşlerde `i`. sonucun ham 64 bit deseni (son `call`/`call_f` çağrısından).
    def result(self: Instance, i: int) -> int:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_result_raw(self.handle, i)

    def result_count(self: Instance) -> int:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_result_count_raw(self.handle)

    # Dışa aktarılan işlevlerin adları (modüldeki sırayla).
    def exports(self: Instance) -> list[str]:
        if self.closed:
            raise WasmError("wasm instance is closed")
        txt: str = nox_wasm_exports_raw(self.handle)
        if txt == "":
            empty: list[str] = []
            return empty
        return txt.split("\n")

    # "i32,i32->i32" biçiminde imza ("" = böyle bir dışa aktarım yok).
    def signature(self: Instance, name: str) -> str:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_signature_raw(self.handle, name)

    # Doğrusal bellek boyutu (bayt; bellek yoksa 0).
    def memory_size(self: Instance) -> int:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_mem_size_raw(self.handle)

    def read_bytes(self: Instance, offset: int, length: int) -> list[int]:
        if self.closed:
            raise WasmError("wasm instance is closed")
        data: list[int] = nox_wasm_mem_read_raw(self.handle, offset, length)
        self._check()
        return data

    # UTF-8 metin okur (modül belleğinde NUL görülürse orada biter; Nox `str` NUL içeremez).
    def read_str(self: Instance, offset: int, length: int) -> str:
        if self.closed:
            raise WasmError("wasm instance is closed")
        s: str = nox_wasm_mem_read_str_raw(self.handle, offset, length)
        self._check()
        return s

    def write_bytes(self: Instance, offset: int, data: list[int]) -> None:
        if self.closed:
            raise WasmError("wasm instance is closed")
        rc: int = nox_wasm_mem_write_raw(self.handle, offset, data)
        if rc != 0:
            self._check()
            raise WasmError("memory write failed")

    def write_str(self: Instance, offset: int, text: str) -> None:
        if self.closed:
            raise WasmError("wasm instance is closed")
        rc: int = nox_wasm_mem_write_str_raw(self.handle, offset, text)
        if rc != 0:
            self._check()
            raise WasmError("memory write failed")

    # Küçük-endian işaretsiz tamsayı okuma/yazma (`width` 1, 2, 4 veya 8 bayt).
    def load(self: Instance, offset: int, width: int) -> int:
        if self.closed:
            raise WasmError("wasm instance is closed")
        v: int = nox_wasm_mem_load_raw(self.handle, offset, width)
        self._check()
        return v

    def store(self: Instance, offset: int, width: int, value: int) -> None:
        if self.closed:
            raise WasmError("wasm instance is closed")
        rc: int = nox_wasm_mem_store_raw(self.handle, offset, width, value)
        if rc != 0:
            self._check()
            raise WasmError("memory store failed")

    # --- WASI (yalnızca `Host.enable_wasi` ile açıldıysa anlamlı): yakalanan çıktı, çıkış kodu, `_start` kısayolu.
    # `fd_write` çıktısı (fd 1 / fd 2) bellekte birikir; bu çağrılar birikeni döner ve boşaltır.
    def stdout(self: Instance) -> str:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_take_stdout_raw(self.handle)

    def stderr(self: Instance) -> str:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_take_stderr_raw(self.handle)

    # `proc_exit` ile verilen çıkış kodu (çağrılmadıysa -1).
    def exit_code(self: Instance) -> int:
        if self.closed:
            raise WasmError("wasm instance is closed")
        return nox_wasm_exit_code_raw(self.handle)

    # `_start` işlevini çalıştırır; `proc_exit(kod)` -> `kod`, normal dönüş -> 0.
    def run_start(self: Instance) -> int:
        empty: list[int] = []
        try:
            self.call("_start", empty)
        except WasmExit:
            return nox_wasm_exit_code_raw(self.handle)
        return 0

    def close(self: Instance) -> None:
        if not self.closed:
            nox_wasm_close_raw(self.handle)
            self.closed = True
            self.cb.close()

    def __enter__(self: Instance) -> Instance:
        return self

    def __exit__(self: Instance) -> None:
        self.close()

def _make_cb(h: ptr, hosts: list[(int, int, int, int) -> int]) -> Callback[(int, int, int, int, int) -> int]:
    return Callback[(int, int, int, int, int) -> int](lambda i, a0, a1, a2, a3: _host_dispatch(h, hosts, i, a0, a1, a2, a3))

def _wrap(h: ptr, what: str, hosts: list[(int, int, int, int) -> int]) -> Instance:
    if nox_wasm_is_null_raw(h) != 0:
        raise WasmError("out of memory while opening " + what)
    msg: str = nox_wasm_error_raw(h)
    if msg != "":
        nox_wasm_close_raw(h)
        raise WasmError(msg)
    return Instance(h, hosts)

# `.wasm` dosyasını açıp örnekler. Varsayılan yakıt 2 milyar talimat, en çok 4096 sayfa (256 MiB) bellek.
def open(path: str) -> Instance:
    return _wrap(nox_wasm_open_raw(path, 0, 0), path, _no_hosts())

# Yakıt (talimat) ve bellek sayfası (64 KiB) tavanlarıyla açar.
def open_with_limits(path: str, fuel: int, max_pages: int) -> Instance:
    return _wrap(nox_wasm_open_raw(path, fuel, max_pages), path, _no_hosts())

# Bellekteki bayt listesinden (her eleman 0..255) açar.
def from_bytes(data: list[int]) -> Instance:
    return _wrap(nox_wasm_open_bytes_raw(data, 0, 0), "<bytes>", _no_hosts())

# `from_bytes` ile aynı, yakıt (talimat) ve bellek sayfası tavanlarıyla.
def from_bytes_with_limits(data: list[int], fuel: int, max_pages: int) -> Instance:
    return _wrap(nox_wasm_open_bytes_raw(data, fuel, max_pages), "<bytes>", _no_hosts())

def f64_bits(x: float) -> int:
    return nox_wasm_f64_to_bits_raw(x)

def f64_from_bits(b: int) -> float:
    return nox_wasm_f64_from_bits_raw(b)

def f32_bits(x: float) -> int:
    return nox_wasm_f32_to_bits_raw(x)

def f32_from_bits(b: int) -> float:
    return nox_wasm_f32_from_bits_raw(b)

# Gönderici: örneğin tutamacı ve host listesi kapanışla taşınır (Instance'a geri referans yok = ARC döngüsü yok); host işlevi `hosts[idx]`tir.
def _host_dispatch(h: ptr, hosts: list[(int, int, int, int) -> int], idx: int, a0: int, a1: int, a2: int, a3: int) -> int:
    f: (int, int, int, int) -> int = hosts[idx]
    try:
        return f(a0, a1, a2, a3)
    except Exception:
        nox_wasm_host_fail_raw(h)
        return 0

def _drop0(f: () -> int) -> (int, int, int, int) -> int:
    return lambda a, b, c, d: f()

def _drop1(f: (int) -> int) -> (int, int, int, int) -> int:
    return lambda a, b, c, d: f(a)

def _drop2(f: (int, int) -> int) -> (int, int, int, int) -> int:
    return lambda a, b, c, d: f(a, b)

def _drop3(f: (int, int, int) -> int) -> (int, int, int, int) -> int:
    return lambda a, b, c, d: f(a, b, c)

# Modülün içe aktarmalarını karşılayacak Nox işlevleri: `func0..func4` ile (modül adı, içe aktarma adı, işlev) kaydedilir, sonra `open`/`open_bytes`.
class Host:
    def __init__(self: Host, names: list[str], fns: list[(int, int, int, int) -> int], wasi_args: list[str]) -> None:
        self.names = names
        self.fns = fns
        self.wasi_args = wasi_args
        self.flags = 0

    # WASI preview1 alt kümesini açar (varsayılan KAPALI): `fd_write` (fd 1/2, yakalanır), `args_*`, `environ_*` (boş), `proc_exit`, `sched_yield`, ve
    # sahte-kapalı `fd_*`. Dosya sistemi / ağ / stdin yoktur. Saat ve rastgelelik ayrı yeteneklerdir (`allow_clock`, `allow_random`).
    def enable_wasi(self: Host, args: list[str]) -> None:
        self.wasi_args = args
        self.flags = self.flags | 8

    # wasi-threads (varsayılan KAPALI): modülün `wasi::thread-spawn` içe aktarımını bağlar; en çok `max_threads` (1..256) EŞ ZAMANLI OS iş parçacığı. Paylaşımlı bellek gerçek atomikler ve gerçek
    # `memory.atomic.wait/notify` kullanır. iOS/Android'de açılış `WasmError` verir. Ana bilgisayar (host) işlevleri yalnızca ana yürütme durumundan çağrılabilir.
    def enable_threads(self: Host, max_threads: int) -> None:
        n: int = max_threads
        if n < 0:
            n = 0
        if n > 256:
            n = 256
        self.flags = (self.flags & 65535) | (n * 65536)

    def allow_clock(self: Host) -> None:
        self.flags = self.flags | 1

    def allow_random(self: Host) -> None:
        self.flags = self.flags | 2

    # WASI çıktısını yakalamaya EK OLARAK gerçek stdout/stderr'e de yazar.
    def inherit_output(self: Host) -> None:
        self.flags = self.flags | 4

    def func0(self: Host, module: str, name: str, f: () -> int) -> None:
        self.names.append(module + "." + name)
        self.fns.append(_drop0(f))

    def func1(self: Host, module: str, name: str, f: (int) -> int) -> None:
        self.names.append(module + "." + name)
        self.fns.append(_drop1(f))

    def func2(self: Host, module: str, name: str, f: (int, int) -> int) -> None:
        self.names.append(module + "." + name)
        self.fns.append(_drop2(f))

    def func3(self: Host, module: str, name: str, f: (int, int, int) -> int) -> None:
        self.names.append(module + "." + name)
        self.fns.append(_drop3(f))

    def func4(self: Host, module: str, name: str, f: (int, int, int, int) -> int) -> None:
        self.names.append(module + "." + name)
        self.fns.append(f)

    def open(self: Host, path: str) -> Instance:
        return self.open_with_limits(path, 0, 0)

    def open_with_limits(self: Host, path: str, fuel: int, max_pages: int) -> Instance:
        tmp: Instance = Instance(nox_wasm_null_raw(), self.fns)
        tmpcb: Callback[(int, int, int, int, int) -> int] = tmp.cb
        h: ptr = nox_wasm_null_raw()
        try:
            h = nox_wasm_open_host_raw(path, self.names, self.wasi_args, self.flags, fuel, max_pages, tmpcb)
        finally:
            tmpcb.close()
        return _wrap(h, path, self.fns)

    def open_bytes(self: Host, data: list[int]) -> Instance:
        tmp: Instance = Instance(nox_wasm_null_raw(), self.fns)
        tmpcb: Callback[(int, int, int, int, int) -> int] = tmp.cb
        h: ptr = nox_wasm_null_raw()
        try:
            h = nox_wasm_open_bytes_host_raw(data, self.names, self.wasi_args, self.flags, 0, 0, tmpcb)
        finally:
            tmpcb.close()
        return _wrap(h, "<bytes>", self.fns)

# Boş bir `Host` (derleyici kısıtı: sınıf alanı kurucudan gelen listeyle kurulur; bu fabrika onu sağlar).
def host() -> Host:
    names: list[str] = []
    wargs: list[str] = []
    return Host(names, _no_hosts(), wargs)

# Stdlib fazı §L — bkz. nox-teknik-spesifikasyon.md. `JsonValue` sınıfının
# KENDİSİ VE `nox_json_make_json_value` fabrikası `stdlib/nox/core.nox`da
# tanımlıdır (bkz. onun belge notu — Zig kabuğunun `noxrt.o` üzerinden HER
# programa KOŞULSUZ bağlanması YÜZÜNDEN ZORUNLU bir tasarım kararı).
#
# STRATEJİ 1 (kullanıcının "tam olarak yapalım" talebiyle seçilen, bkz. plan
# dosyası): `nox.json.parse`, Zig'in `std.json`iyle (savaş-test edilmiş,
# keyfi iç içe/kaçış/sayı ayrıştırması) ayrıştırır — Nox tarafında KARAKTER
# KARAKTER bir ayrıştırıcı YAZILMAZ. Zig kabuğu (`runtime/stdlib_shims/
# json.zig`), ayrıştırılan ağacı ÖZYİNELEMELİ olarak gezip HER düğüm için
# `nox_json_make_json_value`yi (bkz. core.nox) ÇAĞIRIR — Zig KAYNAK kodunun
# (önceden derlenmiş, `noxrt.o` içinde) QBE'nin DERLEYECEĞİ bir Nox sembolünü
# `extern fn` ile çağırması bu PROJEDE İLK KEZ denenen bir yön (ŞİMDİYE KADAR
# hep tersi oldu). Bu, doğru `class_id`nin (derleme sırası bağımlı, Zig'den
# ASLA güvenle tahmin edilemez) ve doğru ARC muhasebesinin OTOMATİK, TEST
# EDİLMİŞ mekanizmayla elde edilmesini sağlar.
#
# `arr`/`keys`/`vals` alanları HER ZAMAN gerçek (gerekmeyen durumlarda SIFIR
# elemanlı) `list[T]` değerleridir (bkz. core.nox'un belge notu) — bu sayede
# ne kendine-başvuran bir literal ne de bir `MAX_CHILDREN` sınırı GEREKİR
# (GERÇEKTEN "tam" — keyfi derinlik).
#
# v3 sertleştirme yol haritası, madde 10 (bkz. nox-teknik-spesifikasyon.md
# ilgili bölüm, stdlib/API denetimi): `decode`/`encode`/`encode_pretty`
# (v1.110.4'e kadarki isimler) `parse`/`dump`/`dump_pretty` OLARAK YENİDEN
# ADLANDIRILDI — `nox.toml`/`nox.yaml`nin (ARTIK dump'ı da OLAN) `parse`/
# `dump` çiftiyle TÜM format modülleri (json/toml/yaml/csv) ARASINDA
# TUTARLI KILINMASI İçİn, kullanıcının AÇIKÇA seçtiği KIRICI bir yeniden
# adlandırma (v2.0'dan ÖNCE, semantik dondurma'DAN [madde 11] HEMEN ÖNCE
# — bu tam da BÖYLE bir kararın YAPILABİLECEĞİ SON pencere).

import nox.strings

class JsonError(Exception):
    pass

extern def nox_json_decode_raw(s: str) -> JsonValue from "zig-out/lib/noxrt.o" with_rt
extern def nox_json_last_op_ok() -> int from "zig-out/lib/noxrt.o"
extern def nox_json_escape_string_raw(s: str) -> str from "zig-out/lib/noxrt.o" with_rt

def parse(s: str) -> JsonValue:
    v: JsonValue = nox_json_decode_raw(s)
    if nox_json_last_op_ok() == 0:
        raise JsonError("gecersiz JSON: " + s)
    return v

def is_null(v: JsonValue) -> bool:
    return v.kind == 0

def is_bool(v: JsonValue) -> bool:
    return v.kind == 1

def is_number(v: JsonValue) -> bool:
    return v.kind == 2

def is_string(v: JsonValue) -> bool:
    return v.kind == 3

def is_array(v: JsonValue) -> bool:
    return v.kind == 4

def is_object(v: JsonValue) -> bool:
    return v.kind == 5

def as_bool(v: JsonValue) -> bool:
    return v.b

def as_number(v: JsonValue) -> float:
    return v.n

def as_string(v: JsonValue) -> str:
    return v.s

def array_len(v: JsonValue) -> int:
    return len(v.arr)

def array_get(v: JsonValue, i: int) -> JsonValue:
    return v.arr[i]

def object_len(v: JsonValue) -> int:
    return len(v.keys)

def object_key(v: JsonValue, i: int) -> str:
    return v.keys[i]

def object_value(v: JsonValue, i: int) -> JsonValue:
    return v.vals[i]

# Faz II devamı (bkz. nox-teknik-spesifikasyon.md §3.67, test kapsamı
# genişletmesi sırasında BULUNAN, GERÇEK bir düzeltme) — ÖNCEKİ sürüm
# yalnızca `"`/`\`/`\n`i escape ediyordu; bir `\t` (VEYA CR baytı) İÇEREN
# bir dizeyi `dump` ETTİĞİNDE ham (escape'siz) kontrol karakterini
# ÇIKTIYA yazıyordu — bu GEÇERSİZ JSON'dur (JSON spesifikasyonu bir dize
# İÇİNDEKİ HER kontrol karakterinin escape EDİLMESİNİ ZORUNLU kılar) ve
# `nox.json.parse(nox.json.dump(v))` (round-trip) bir `\t` İÇEREN
# GERÇEK bir girdide YAKALANMAMIŞ bir istisnayla ÇÖKÜYORDU (Zig'in
# `std.json`ı ham kontrol karakterini REDDEDİYOR). `\t`, `\n` İLE AYNI
# (basit literal karşılaştırma) YOLLA eklendi. **CR (bayt 13, `\r`) İSE
# BİR STRİNG LİTERALİ OLARAK YAZILAMAZ** — GERÇEKTEN denenip KEŞFEDİLDİ:
# Nox'un lexer'ı `\r`yi TANIMAZ (SESSİZCE `\` düşürülüp `r` DÜZ karakter
# olarak alınır, `\x`/hex escape'lerin AKSİNE — bkz. `\t`/`\n` gibi GERÇEK
# escape'lerle KARIŞTIRILMAMASI İçin buraya not düşüldü); bu YÜZDEN CR
# `nox.strings.byte_at` İLE bayt-DEĞERİ (13) karşılaştırılarak yakalanır.
#
# **v1.142.1 NOTU: aşağıdaki "v1 sınırlaması" ARTIK GEÇERSİZDİR** — `dump_string`
# Zig'e taşındı (`nox_json_escape_string_raw`, bkz. nox-teknik-spesifikasyon.md
# §3.241): TÜM C0 kontrol karakterleri `\u00XX` ile kaçışlanır VE saf-Nox
# karakter-döngüsünün O(n²) tahsisi ortadan kalktı. Aşağıdaki tarihsel not
# eski saf-Nox uygulamanın neden eksik kaldığını açıklar.
#
# **TARİHSEL NOT (v1.142.1 öncesi):** eski saf-Nox uygulama `\t`/CR/`\n`
# dışındaki C0 kontrol karakterlerini escape etmiyordu; o dönemde bir
# `list[str]`-dönen fonksiyonun döngü içinde iki kez çağrılmasının ARC'yi
# bozduğu sanılmıştı. Bu hata Faz JJ'de kök nedeniyle ÇÖZÜLMÜŞTÜ (yerel
# slotun release sonrası sıfırlanmaması) — artık ilgili bir sınırlama YOK;
# `dump_string` tüm C0 karakterlerini Zig tarafında `\u00XX` olarak escape eder.
def dump_string(s: str) -> str:
    return nox_json_escape_string_raw(s)

def dump(v: JsonValue) -> str:
    if is_null(v):
        return "null"
    if is_bool(v):
        if as_bool(v):
            return "true"
        return "false"
    if is_number(v):
        return str(as_number(v))
    if is_string(v):
        return dump_string(as_string(v))
    if is_array(v):
        return dump_array(v)
    return dump_object(v)

def dump_array(v: JsonValue) -> str:
    out: str = "["
    i: int = 0
    n: int = array_len(v)
    while i < n:
        if i > 0:
            out = out + ","
        out = out + dump(array_get(v, i))
        i = i + 1
    return out + "]"

def dump_object(v: JsonValue) -> str:
    out: str = "{"
    i: int = 0
    n: int = object_len(v)
    while i < n:
        if i > 0:
            out = out + ","
        out = out + dump_string(object_key(v, i)) + ":" + dump(object_value(v, i))
        i = i + 1
    return out + "}"

# Faz III.10 (bkz. nox-teknik-spesifikasyon.md §3.69) — `dump_pretty`:
# `dump`in girintili varyantı, SAF Nox (HİÇ runtime değişikliği GEREKMEDİ,
# `nox.strings.repeat` — Faz III.2 — İLE girinti dizeleri üretilir).
# `indent`, SEVİYE BAŞINA boşluk SAYISIDIR (ör. `2` -> Python'un
# `json.dumps(v, indent=2)`si İLE AYNI biçim).
def indent_str(indent: int, level: int) -> str:
    return nox.strings.repeat(" ", indent * level)

def dump_pretty(v: JsonValue, indent: int) -> str:
    return dump_pretty_at(v, indent, 0)

def dump_pretty_at(v: JsonValue, indent: int, level: int) -> str:
    if is_array(v):
        return dump_pretty_array(v, indent, level)
    if is_object(v):
        return dump_pretty_object(v, indent, level)
    return dump(v)

def dump_pretty_array(v: JsonValue, indent: int, level: int) -> str:
    n: int = array_len(v)
    if n == 0:
        return "[]"
    inner: str = indent_str(indent, level + 1)
    out: str = "[\n"
    i: int = 0
    while i < n:
        if i > 0:
            out = out + ",\n"
        out = out + inner + dump_pretty_at(array_get(v, i), indent, level + 1)
        i = i + 1
    return out + "\n" + indent_str(indent, level) + "]"

def dump_pretty_object(v: JsonValue, indent: int, level: int) -> str:
    n: int = object_len(v)
    if n == 0:
        return "{}"
    inner: str = indent_str(indent, level + 1)
    out: str = "{\n"
    i: int = 0
    while i < n:
        if i > 0:
            out = out + ",\n"
        out = out + inner + dump_string(object_key(v, i)) + ": " + dump_pretty_at(object_value(v, i), indent, level + 1)
        i = i + 1
    return out + "\n" + indent_str(indent, level) + "}"

# --- KULLANIMDAN KALDIRILMIŞ (deprecated) takma adlar ---
#
# v3 sertleştirme yol haritası, madde 10 (bkz. nox-teknik-spesifikasyon.md
# ilgili bölüm): `decode`/`encode`/`encode_pretty`, `parse`/`dump`/
# `dump_pretty` OLARAK yeniden adlandırıldı. `VERSIONING.md`nin §3'ü
# ("Kullanımdan Kaldırma Politikası") bir fonksiyonun KALDIRILMADAN ÖNCE
# EN AZ BİR MINOR sürüm boyunca ÇALIŞMAYA DEVAM ETMESİNİ (deprecated
# İŞARETLİ) ZORUNLU kılar — GERÇEK kaldırma yalnızca bir SONRAKİ MAJOR
# sürümde (v2.0.0) olabilir. Bu YÜZDEN eski isimler İNCE sarmalayıcılar
# OLARAK KORUNUR — YENİ kod `parse`/`dump`/`dump_pretty` KULLANMALIDIR,
# bu üçü SADECE GERİYE-DÖNÜK UYUMLULUK İçİndir.
def decode(s: str) -> JsonValue:
    return parse(s)

def encode(v: JsonValue) -> str:
    return dump(v)

def encode_pretty(v: JsonValue, indent: int) -> str:
    return dump_pretty(v, indent)

# v3 sertleştirme yol haritası, madde 12 (RC + release qualification) —
# GERÇEK bir üretim hatası burada bulunup düzeltildi: `encode_array`/
# `encode_object`/`encode_pretty_at`/`encode_pretty_array`/`encode_pretty_
# object`/`encode_string` (v1.110.4'e kadarki isimler) İç ÖZYİNELEMELİ
# yardımcılar SANILIP (BAŞINDA `_` OLMADIĞI İçİn TEKNİK olarak PUBLIC,
# nox-lang MONOREPO'sunun İçİNDE HİÇBİR çağıran BULUNAMADIĞI İçİn
# "harici çağıran YOK" diye YANLIŞLIKLA doğrulanmış) takma ad OLMADAN
# kaldırılmıştı — GERÇEK, harici (nox-lang deposu DIŞINDAKİ) tüketiciler
# (`nyx`/`aether` framework'lerinin CI entegrasyon testleri, bkz. proje
# belleği) BUNLARI DOĞRUDAN ÇAĞIRIYORDU, `dump_string`/`dump_array`/vb.
# İSİMLERİYLE DEĞİL — GERÇEK bir üretim regresyonu (v1.111.0'dan İTİBAREN,
# nyx/aether'in HER İKİSİNİN de TÜM test paketleri BAŞARISIZ OLDU).
# `VERSIONING.md` §3 gereği AYNI deprecated-sarmalayıcı deseni BURAYA da
# uygulanır.
def encode_string(s: str) -> str:
    return dump_string(s)

def encode_array(v: JsonValue) -> str:
    return dump_array(v)

def encode_object(v: JsonValue) -> str:
    return dump_object(v)

def encode_pretty_at(v: JsonValue, indent: int, level: int) -> str:
    return dump_pretty_at(v, indent, level)

def encode_pretty_array(v: JsonValue, indent: int, level: int) -> str:
    return dump_pretty_array(v, indent, level)

def encode_pretty_object(v: JsonValue, indent: int, level: int) -> str:
    return dump_pretty_object(v, indent, level)

# Aether NOX_LIMITATIONS.md yol haritası, Faz A.4 (bkz. nox-teknik-
# spesifikasyon.md ilgili bölüm, madde 18): `JsonWriter` — bir HTTP
# yanıt gövdesi gibi büyük bir JSON belgesini, ÖNCE bir `JsonValue`
# ağacı İNŞA ETMEDEN (ya da `dump_object`/`dump_array`nin KENDİ `out =
# out + ...` döngülerinde OLDUĞU gibi TEKRARLANAN `str` birleştirmesi
# İLE, HER birleştirme YENİ bir kopya ÜRETTİĞİNDEN O(n²)) ARTIMLI
# olarak yazmak İçin. `self.parts: list[str]` İÇİNDE TOPLANAN PARÇALAR
# SADECE `build()` ÇAĞRILDIĞINDA TEK bir `nox.strings.join` (GERÇEKTEN
# O(n) — ÖNCE TOPLAM uzunluk hesaplanır, SONRA TEK bir arabellek
# doldurulur, bkz. `runtime/stdlib_shims/strings.zig`nin `nox_strings_
# join_raw`ı) İLE BİRLEŞTİRİLİR.
#
# Mevcut `dump`/`dump_pretty`/`parse` API'leri BU sınıfla HİÇBİR şekilde
# DEĞİŞTİRİLMEDİ (saf bir EKLEME) — `JsonValue` ağacı ZATEN elindeyse
# `write_value` İLE `JsonWriter`e GÖMÜLEBİLİR (iki yaklaşımı KARIŞTIRMAK
# güvenlidir).
#
# **Tasarım — "bekleyen anahtar" (`pending_key`):** `write_key("x")`
# HİÇBİR ŞEY YAZMAZ, SADECE `x`i BEKLEMEYE alır — asıl virgül/anahtar
# yazımı bir SONRAKİ `write_*`/`begin_*` çağrısında (`_emit_prefix`
# İÇİNDE) gerçekleşir. Bu, `write_string`/`write_int`/vb.nin TEK bir
# KOD YOLUYLA HEM nesne-değeri (anahtardan HEMEN sonra, virgülsüz) HEM
# dizi-elemanı (virgüllü, anahtarsız) bağlamında GÜVENLE kullanılabilmesini
# SAĞLAR — çağıranın HANGİ bağlamda olduğunu AYRI metodlarla belirtmesi
# GEREKMEZ.
class JsonWriter:
    parts: list[str]
    need_comma_stack: list[bool]
    pending_key: str
    has_pending_key: bool

    def __init__(self: JsonWriter) -> None:
        self.parts = []
        self.need_comma_stack = []
        self.pending_key = ""
        self.has_pending_key = False

    # `.append()`in alıcısı ÇIPLAK bir yerel İSİM olmak ZORUNDADIR (bkz.
    # `stdlib/nox/collections.nox`nin AYNI notu — `obj.field.append(x)`
    # HENÜZ desteklenmiyor) — bu YÜZDEN HER iki liste alanı İçİn de
    # "yerele kopyala → mutasyona uğrat → geri yaz" dansı BURADA, TEK bir
    # yerde toplanır (`.pop()`/indeksli atama bu dansı GEREKTİRMEZ,
    # DOĞRUDAN `self.alan` üzerinde çağrılabilir — AŞAĞIDAKİ `pop()`/
    # `[n - 1] = True` satırlarına bkz.).
    def _push_part(self: JsonWriter, s: str) -> None:
        parts: list[str] = self.parts
        parts.append(s)
        self.parts = parts

    def _push_comma_frame(self: JsonWriter, v: bool) -> None:
        stack: list[bool] = self.need_comma_stack
        stack.append(v)
        self.need_comma_stack = stack

    # İÇİNDE bulunulan (en İÇTEKİ) konteynerin daha ÖNCE bir öğe
    # yazıp YAZMADIĞINA göre virgül ekler (VE bayrağı `True`ya çeker),
    # SONRA bekleyen bir anahtar VARSA onu (escape edilmiş hâliyle)
    # ve `:`yi yazar. HER `write_*`/`begin_*`in İLK adımı BUDUR.
    def _emit_prefix(self: JsonWriter) -> None:
        n: int = len(self.need_comma_stack)
        if n > 0:
            if self.need_comma_stack[n - 1]:
                self._push_part(",")
            self.need_comma_stack[n - 1] = True
        if self.has_pending_key:
            self._push_part(dump_string(self.pending_key))
            self._push_part(":")
            self.has_pending_key = False

    # Bir SONRAKİ `write_*`/`begin_*` çağrısının (asıl DEĞER) bir nesne
    # ÜYESİNİN anahtarı olarak yazılmasını SAĞLAR — SADECE `begin_object`/
    # `end_object` İLE AÇILMIŞ bir kapsamda ANLAMLIDIR (bir dizi İçİnde
    # çağrılırsa `pending_key` sessizce YOK SAYILMAZ, bir SONRAKİ elemana
    # YANLIŞLIKLA bir anahtar EKLER — ÇAĞIRANIN SORUMLULUĞU, bkz. modül
    # üstü not: "programcı YANLIŞ KULLANIMI İçİn savunmacı KONTROL YOK").
    def write_key(self: JsonWriter, key: str) -> None:
        self.pending_key = key
        self.has_pending_key = True

    def begin_object(self: JsonWriter) -> None:
        self._emit_prefix()
        self._push_part("{")
        self._push_comma_frame(False)

    def end_object(self: JsonWriter) -> None:
        self.need_comma_stack.pop()
        self._push_part("}")

    def begin_array(self: JsonWriter) -> None:
        self._emit_prefix()
        self._push_part("[")
        self._push_comma_frame(False)

    def end_array(self: JsonWriter) -> None:
        self.need_comma_stack.pop()
        self._push_part("]")

    def write_string(self: JsonWriter, s: str) -> None:
        self._emit_prefix()
        self._push_part(dump_string(s))

    def write_int(self: JsonWriter, n: int) -> None:
        self._emit_prefix()
        self._push_part(str(n))

    def write_float(self: JsonWriter, n: float) -> None:
        self._emit_prefix()
        self._push_part(str(n))

    def write_bool(self: JsonWriter, b: bool) -> None:
        self._emit_prefix()
        if b:
            self._push_part("true")
        else:
            self._push_part("false")

    def write_null(self: JsonWriter) -> None:
        self._emit_prefix()
        self._push_part("null")

    # Zaten elde var olan bir `JsonValue` alt-ağacını OLDUĞU GİBİ gömer
    # (`dump` İLE) — iki inşa YAKLAŞIMININ (artımlı yazıcı + hazır ağaç)
    # KARIŞTIRILABİLMESİ İçİn.
    def write_value(self: JsonWriter, v: JsonValue) -> None:
        self._emit_prefix()
        self._push_part(dump(v))

    def build(self: JsonWriter) -> str:
        return nox.strings.join(self.parts, "")

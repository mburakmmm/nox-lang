# nox.mysql — libmysqlclient'e (ya da ikili-uyumlu MariaDB connector'üne)
# `std.DynLib` (dlopen/dlsym, ÇALIŞMA ZAMANINDA, TEMBEL) İLE bağlanan bir
# MySQL/MariaDB sürücüsü — `nox.sqlite`/`nox.postgres`nin BİREBİR AYNI
# şablonu (bkz. proje belleği "4 yeni stdlib modülü" planı). `libmysqlclient`
# yalnızca GERÇEKTEN `nox.mysql.open_url()` ÇAĞRILDIĞINDA yüklenir —
# KURULU DEĞİLSE temiz bir `MysqlError` fırlatılır, `nox.mysql` KULLANMAYAN
# HİÇBİR Nox programı ETKİLENMEZ.
#
# `mysql_real_connect`, Postgres'in `PQconnectdb`sinin AKSİNE bir URI
# KABUL ETMEZ (AYRI host/user/passwd/db/port parametreleri ister) — bu
# YÜZDEN `open_url`, `mysql://user:pass@host:port/db` biçimini `nox.url.
# parse` İLE ayrıştırıp BU parçaları ÇIKARIR (port belirtilmemişse
# MySQL'in KENDİ varsayılanı 3306 kullanılır).
#
# **Faz NN.4 (bkz. proje belleği "nyx v2 limitasyon listesi doğrulaması"):**
# `Statement` sınıfı İLE PARAMETRELİ (`?`) sorgu ARTIK DESTEKLENİYOR —
# `Connection.prepare(sql)` bir `Statement` döner, `bind_int`/`bind_float`/
# `bind_str`/`bind_null` çağrıları BİRİKTİRİLİR. **Bilinçli tasarım
# kararı**: GERÇEK sunucu-taraflı `mysql_stmt_*` hazırlanmış deyimleri
# (`MYSQL_BIND` struct'ının ÇOK-TİPLİ, ABI-KIRILGAN TAM Zig karşılığını
# gerektirirdi) YERİNE, `mysql_real_escape_string` (libmysqlclient'ın
# KENDİ, iyi-test-edilmiş SQL-enjeksiyon kaçışlama fonksiyonu) İLE
# İSTEMCİ-TARAFLI kaçışlama KULLANILIR — `bind_str` değeri kaçışlanıp
# SQL metnine `?` yerine DOĞRUDAN gömülür, SONRA MEVCUT `nox_mysql_
# query_raw` (düz metin) çağrılır. KULLANICI API'si (`bind_int`/`bind_str`
# sonra `execute()`/`query()`) Postgres/sqlite İLE AYNI görünür — GERÇEK
# SQL-enjeksiyon koruması (asıl pratik endişe) sağlanır, sunucu tarafında
# İSE isimli bir "prepared statement" YOK (bkz. `nox_mysql_escape_raw`nin
# Zig belge notu, `runtime/stdlib_shims/mysql.zig`). `last_insert_rowid()`
# ARTIK VAR (`mysql_insert_id` — Postgres'in AKSİNE MySQL bunu DOĞRUDAN
# destekler).

import nox.url
import nox.strings
from nox.url import URL
# Faz OO: `Row` ARTIK `nox.db`den PAYLAŞILAN — bkz. `db.nox`nin belge
# notu (`DbConnection` protokolünün `query`yi KAPSAYABİLMESİNİN nedeni).
# Faz STD.6: `Statement` de AYNI şekilde `nox.db`den PAYLAŞILAN.
from nox.db import Row, Statement

extern def nox_mysql_connect_raw(host: str, user: str, passwd: str, db: str, port: int) -> ptr from "zig-out/lib/noxrt.o"
extern def nox_mysql_status_ok_raw(conn: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_errmsg_raw(conn: ptr) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_mysql_close_raw(conn: ptr) -> None from "zig-out/lib/noxrt.o"
extern def nox_mysql_query_raw(conn: ptr, stmt_str: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_field_count_raw(conn: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_affected_rows_raw(conn: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_store_result_raw(conn: ptr) -> ptr from "zig-out/lib/noxrt.o"
extern def nox_mysql_num_fields_raw(res: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_fname_raw(res: ptr, col: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_mysql_fetch_row_raw(res: ptr) -> ptr from "zig-out/lib/noxrt.o"
extern def nox_mysql_row_isnull_raw(row: ptr, col: int) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_row_getvalue_raw(row: ptr, col: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_mysql_free_result_raw(res: ptr) -> None from "zig-out/lib/noxrt.o"
extern def nox_mysql_is_null_ptr(p: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_insert_id_raw(conn: ptr) -> int from "zig-out/lib/noxrt.o"
extern def nox_mysql_escape_raw(conn: ptr, value: str) -> str from "zig-out/lib/noxrt.o" with_rt

class MysqlError(Exception):
    pass

def _substr(s: str, start: int, end: int) -> str:
    result: str = ""
    i: int = start
    while i < end:
        result = result + s[i]
        i = i + 1
    return result

def _read_rows(res: ptr, ncols: int) -> list[Row]:
    names: list[str] = []
    c: int = 0
    while c < ncols:
        names.append(nox_mysql_fname_raw(res, c))
        c = c + 1

    rows: list[Row] = []
    row: ptr = nox_mysql_fetch_row_raw(res)
    while nox_mysql_is_null_ptr(row) == 0:
        values: list[str] = []
        is_null_flags: list[bool] = []
        c2: int = 0
        while c2 < ncols:
            is_null: bool = nox_mysql_row_isnull_raw(row, c2) != 0
            value: str = ""
            if not is_null:
                value = nox_mysql_row_getvalue_raw(row, c2)
            values.append(value)
            is_null_flags.append(is_null)
            c2 = c2 + 1
        rows.append(Row(values, is_null_flags, names))
        row = nox_mysql_fetch_row_raw(res)
    return rows

# Faz STD.6: `Statement` artık `nox.db`den PAYLAŞILAN, BİRLEŞİK bir sınıf
# (bkz. `db.nox`nin belge notu) — bu dispatch fonksiyonları ONUN
# `bind_int_fn`/vb. alanlarına `prepare()` TARAFINDAN ENJEKTE EDİLİR. İÇ
# MEKANİZMA DEĞİŞMEDİ: `bind_*` çağrıları `stmt.params`e (PAYLAŞILAN
# `Statement`in ALANI — ÖNCEDEN mysql'e ÖZEL `fragments` İSİMLİYDİ, ARTIK
# `params` — SQL METNİ parçaları olarak EKLER (`bind_str` `mysql_real_
# escape_string` İLE kaçışlayıp tek-tırnak İÇİNE alır, `bind_null` literal
# `"NULL"` ekler) — `idx` KULLANILMAZ (SADECE eklenme SIRASI önemlidir).
# `execute()`/`query()` anında `stmt.sql`deki HER `?` KARAKTERİ, SIRAYLA
# `stmt.params`teki karşılığıyla DEĞİŞTİRİLİR (GERÇEK sunucu-taraflı hazır
# deyim DEĞİL, İSTEMCİ-TARAFLI güvenli metin ikamesidir — DEĞİŞMEDİ).
def _mysql_bind_int(stmt: Statement, idx: int, value: int) -> None:
    params: list[str] = stmt.params
    params.append(str(value))
    stmt.params = params

def _mysql_bind_float(stmt: Statement, idx: int, value: float) -> None:
    params: list[str] = stmt.params
    params.append(str(value))
    stmt.params = params

def _mysql_bind_str(stmt: Statement, idx: int, value: str) -> None:
    escaped: str = nox_mysql_escape_raw(stmt.handle, value)
    params: list[str] = stmt.params
    params.append("'" + escaped + "'")
    stmt.params = params

def _mysql_bind_null(stmt: Statement, idx: int) -> None:
    params: list[str] = stmt.params
    params.append("NULL")
    stmt.params = params

def _mysql_build_sql(stmt: Statement) -> str:
    result: str = ""
    frag_idx: int = 0
    i: int = 0
    n: int = len(stmt.sql)
    while i < n:
        ch: str = stmt.sql[i]
        if ch == "?":
            result = result + stmt.params[frag_idx]
            frag_idx = frag_idx + 1
        else:
            result = result + ch
        i = i + 1
    return result

def _mysql_execute(stmt: Statement) -> int:
    sql: str = _mysql_build_sql(stmt)
    rc: int = nox_mysql_query_raw(stmt.handle, sql)
    if rc != 0:
        raise MysqlError("deyim basarisiz: " + nox_mysql_errmsg_raw(stmt.handle))
    return nox_mysql_affected_rows_raw(stmt.handle)

def _mysql_query(stmt: Statement) -> list[Row]:
    sql: str = _mysql_build_sql(stmt)
    rc: int = nox_mysql_query_raw(stmt.handle, sql)
    if rc != 0:
        raise MysqlError("sorgu basarisiz: " + nox_mysql_errmsg_raw(stmt.handle))
    ncols: int = nox_mysql_field_count_raw(stmt.handle)
    if ncols == 0:
        return []
    res: ptr = nox_mysql_store_result_raw(stmt.handle)
    if nox_mysql_is_null_ptr(res) != 0:
        raise MysqlError("sonuc alinamadi: " + nox_mysql_errmsg_raw(stmt.handle))
    rows: list[Row] = _read_rows(res, ncols)
    nox_mysql_free_result_raw(res)
    return rows

class Connection:
    def __init__(self: Connection, handle: ptr) -> None:
        self.handle = handle

    def prepare(self: Connection, sql: str) -> Statement:
        return Statement(self.handle, self.handle, sql, _mysql_bind_int, _mysql_bind_float, _mysql_bind_str, _mysql_bind_null, _mysql_execute, _mysql_query)

    # Etkilenen satır sayısını döner (`INSERT`/`UPDATE`/`DELETE`/DDL İçin
    # `0`).
    def execute(self: Connection, sql: str) -> int:
        rc: int = nox_mysql_query_raw(self.handle, sql)
        if rc != 0:
            raise MysqlError("deyim basarisiz: " + nox_mysql_errmsg_raw(self.handle))
        return nox_mysql_affected_rows_raw(self.handle)

    def query(self: Connection, sql: str) -> list[Row]:
        rc: int = nox_mysql_query_raw(self.handle, sql)
        if rc != 0:
            raise MysqlError("sorgu basarisiz: " + nox_mysql_errmsg_raw(self.handle))
        ncols: int = nox_mysql_field_count_raw(self.handle)
        if ncols == 0:
            return []
        res: ptr = nox_mysql_store_result_raw(self.handle)
        if nox_mysql_is_null_ptr(res) != 0:
            raise MysqlError("sonuc alinamadi: " + nox_mysql_errmsg_raw(self.handle))
        rows: list[Row] = _read_rows(res, ncols)
        nox_mysql_free_result_raw(res)
        return rows

    # Postgres'in AKSİNE MySQL BUNU DOĞRUDAN destekler (`mysql_insert_id`,
    # bağlantı-durumu — sqlite'ın `last_insert_rowid()`iyle AYNI KAVRAM).
    def last_insert_rowid(self: Connection) -> int:
        return nox_mysql_insert_id_raw(self.handle)

    def close(self: Connection) -> None:
        nox_mysql_close_raw(self.handle)

# `mysql://[user[:pass]@]host[:port]/db` — port belirtilmemişse `3306`
# (MySQL'in KENDİ varsayılanı) kullanılır.
def open_url(conn_url: str) -> Connection:
    u: URL = nox.url.parse(conn_url)
    user: str = u.userinfo
    passwd: str = ""
    colon_idx: int = nox.strings.index_of(u.userinfo, ":")
    if colon_idx >= 0:
        user = _substr(u.userinfo, 0, colon_idx)
        passwd = _substr(u.userinfo, colon_idx + 1, len(u.userinfo))
    dbname: str = u.path
    if nox.strings.starts_with(dbname, "/"):
        dbname = _substr(dbname, 1, len(dbname))
    port: int = u.port
    if port == 0:
        port = 3306
    handle: ptr = nox_mysql_connect_raw(u.host, user, passwd, dbname, port)
    if nox_mysql_is_null_ptr(handle) != 0:
        raise MysqlError("baglanti kurulamadi (libmysqlclient yuklenemedi olabilir): " + conn_url)
    if nox_mysql_status_ok_raw(handle) == 0:
        msg: str = nox_mysql_errmsg_raw(handle)
        nox_mysql_close_raw(handle)
        raise MysqlError("baglanti basarisiz: " + msg)
    return Connection(handle)

# Çekirdek yerleşikler — HİÇBİR `import` GEREKMEDEN her programa otomatik
# birleştirilir (bkz. `compiler/module_loader.zig`'in `resolveImports`ı,
# stdlib fazı §E). Buradaki isimler MANGLE EDİLMEZ (`ValueError` gibi
# ÇIPLAK kullanılır) — `print`/`len` gibi modül gerektirmeyen çekirdek dil
# yerleşikleriyle AYNI "her yerde hazır" statüsü.

# Faz OO.3 (bkz. nox-teknik-spesifikasyon.md §3.84): TÜM `raise`
# edilebilir sınıfların ORTAK taban sınıfı — `except Exception:` İLE
# programdaki HERHANGİ bir istisnayı (hangi modülden gelirse gelsin)
# tek bir kolla yakalamak İçİN (Faz 7 tekli kalıtım + hiyerarşik
# `except` mekanizması, `isSubclassOf`, ZATEN bunu DESTEKLİYOR — burada
# YENİ bir dil özelliği GEREKMEZ, SADECE stdlib'in TÜM `*Error`
# sınıflarının BU taban sınıftan türemesi GEREKİR). Alt sınıflar KENDİ
# `__init__`ini TANIMLAMAZ (bkz. `calls.zig`nin `has_init`/`init_owner`
# belge notu) — inşa çağrısı OTOMATİK OLARAK BU `__init__`e dağıtılır.
class Exception:
    def __init__(self: Exception, message: str) -> None:
        self.message = message
        # Aether NOX_LIMITATIONS.md yol haritası, Faz A.2 (bkz. nox-
        # teknik-spesifikasyon.md ilgili bölüm): `raise` deyiminin KAYNAK
        # SATIRI — BURADA SIFIR olarak başlar (HENÜZ raise EDİLMEDİ),
        # `nox_raise`in HER çağrı sitesinden HEMEN SONRA codegen
        # tarafından üretilen EK bir alan-yazma İLE (`.message`in KENDİSİ
        # GİBİ inşa-zamanında DEĞİL) GERÇEK `raise` ANINDA doldurulur —
        # `__init__` ÇAĞRILDIĞI an (ör. `e = SomeError("x")`) İLE `raise
        # e` deyiminin KENDİSİ FARKLI satırlarda OLABİLİR, bu YÜZDEN
        # satır bilgisi KONSTRÜKTÖRDE DEĞİL, raise ANINDA yazılmalıdır.
        self.line = 0

    # v1.164.0: `print(e)` / `str(e)` / f-string — Python gibi YALNIZCA mesajı yazar (`__str__` protokolü, bkz. spec §3.279).
    def __str__(self: Exception) -> str:
        return self.message

class ValueError(Exception):
    pass

class IndexError(Exception):
    pass

# Python'daki gibi: çalışma zamanı sözleşme ihlalleri (örn. `close()` edilen jeneratörün `GeneratorExit`e yield ile karşılık vermesi).
class RuntimeError(Exception):
    pass

# `assert koşul, "mesaj"` deyimi başarısız olursa fırlatılır (parser `if not koşul: raise AssertionError(mesaj)`e indirger).
class AssertionError(Exception):
    pass

# ---- v1.165.0: ek str metodları (checker `s.metod(...)`yi `__nox_str_<metod>(s, ...)`e yönlendirir) ----
def __nox_str_capitalize[T](s: T) -> T:
    if len(s) == 0:
        return s
    return s[:1].upper() + s[1:].lower()

def __nox_str_title[T](s: T) -> T:
    out: str = ""
    prev_alpha: bool = False
    for ch in s:
        if prev_alpha:
            out = out + ch.lower()
        else:
            out = out + ch.upper()
        prev_alpha = ch.isalpha()
    return out

def __nox_str_swapcase[T](s: T) -> T:
    out: str = ""
    for ch in s:
        if ch.isupper():
            out = out + ch.lower()
        else:
            out = out + ch.upper()
    return out

def __nox_str_removeprefix[T](s: T, prefix: T) -> T:
    if s.startswith(prefix):
        return s[len(prefix):]
    return s

def __nox_str_removesuffix[T](s: T, suffix: T) -> T:
    if len(suffix) > 0 and s.endswith(suffix):
        return s[:len(s) - len(suffix)]
    return s

def __nox_str_rfind[T](s: T, sub: T) -> int:
    n: int = len(s)
    m: int = len(sub)
    i: int = n - m
    while i >= 0:
        if s[i:i + m] == sub:
            return i
        i = i - 1
    return -1

def __nox_str_rindex[T](s: T, sub: T) -> int:
    i: int = __nox_str_rfind(s, sub)
    if i < 0:
        raise ValueError("str.rindex(sub): substring not found")
    return i

# NOT: dönüş tipinde tuple olan prelude işlevleri GENERİK olmalıdır (`T` = str): jenerik olmayanlar, tuple sınıfları örneklenmeden
# imza kaydı yapan eski codegen test donanımlarını (`extra_classes = &.{}`) kırar; jenerikler yalnızca kullanıldığında örneklenir.
def __nox_str_partition[T](s: T, sep: T) -> tuple[T, T, T]:
    i: int = s.find(sep)
    if i < 0 or len(sep) == 0:
        return s, "", ""
    return s[:i], sep, s[i + len(sep):]

def __nox_str_rpartition[T](s: T, sep: T) -> tuple[T, T, T]:
    i: int = __nox_str_rfind(s, sep)
    if i < 0 or len(sep) == 0:
        return "", "", s
    return s[:i], sep, s[i + len(sep):]

def __nox_str_splitlines[T](s: T) -> list[T]:
    parts: list[str] = s.replace("\r\n", "\n").split("\n")
    if len(parts) > 0 and parts[len(parts) - 1] == "":
        parts.pop()
    return parts

def __nox_str_rsplit[T](s: T, sep: T, maxsplit: int = -1) -> list[T]:
    if maxsplit < 0:
        return s.split(sep)
    out: list[str] = []
    rest: str = s
    k: int = 0
    while k < maxsplit:
        i: int = __nox_str_rfind(rest, sep)
        if i < 0:
            break
        out.append(rest[i + len(sep):])
        rest = rest[:i]
        k = k + 1
    out.append(rest)
    out.reverse()
    return out

def __nox_str_strip[T](s: T, chars: T) -> T:
    return __nox_str_rstrip(__nox_str_lstrip(s, chars), chars)

def __nox_str_lstrip[T](s: T, chars: T) -> T:
    i: int = 0
    while i < len(s) and chars.find(s[i]) >= 0:
        i = i + 1
    return s[i:]

def __nox_str_rstrip[T](s: T, chars: T) -> T:
    j: int = len(s)
    while j > 0 and chars.find(s[j - 1]) >= 0:
        j = j - 1
    return s[:j]

# Tamsayı `//` ve `%` sıfır bölenle bu sınıfı fırlatır (float bölme IEEE: inf/nan).
class ZeroDivisionError(Exception):
    pass

# Güvenlik bulgusu H-2 (bkz. güvenlik raporu) — `d[key]`nin eksik bir
# anahtarda SESSİZCE `0`/null DÖNDÜRDÜĞÜ (Python'un `KeyError`ı YOK
# denen v1 kararı) GERÇEKTE bir null-pointer çökmesiydi: dönen değer
# normal, opsiyonel-olmayan bir `str`/`list`/`class` gibi ileri
# taşınıyordu, `len()`/indeksleme gibi HERHANGİ bir sonraki kullanım
# çöküyordu. `IndexError` İLE AYNI desen İZLENİR — `genDictGet` artık
# `contains` KONTROLÜNDEN SONRA raise eder (bkz. onun belge notu).
class KeyError(Exception):
    pass

# `next(g)` tükenmiş bir jeneratörde fırlatır.
class StopIteration(Exception):
    pass

# `g.close()` bir jeneratörün yield noktasında fırlatılır (bkz. `__nox_Gen.close`).
class GeneratorExit(Exception):
    pass

# Faz 18 (bkz. plan dosyası "HPy köprüsünü Nox'un istisna mekanizmasına
# entegre etme"): `hpy_call`/`hpy_open`/`hpy_call_on`/vb.nin (bkz.
# runtime/foreign_bridge.zig'in `setHpyError`/`nox_hpy_take_error`si)
# TÜM hata durumları (dosya/sembol/metod bulunamadı, çağrılan HPy C
# fonksiyonunun KENDİSİ bir istisna fırlattı) İçİn — `ValueError`/
# `IndexError`/`KeyError`YLA AYNI "alt sınıf KENDİ `__init__`ini
# tanımlamaz" deseni.
class HPyError(Exception):
    pass

# Faz SC.2 (bkz. nox-teknik-spesifikasyon.md, "Task[T].cancel()"): `t.
# cancel()` İLE İSTENEN kooperatif iptalin, cancel edilen task'ın KENDİ
# kodunun BİR SONRAKİ `await`inde fırlattığı istisna — `ValueError`/
# `IndexError`/`KeyError`/`HPyError`YLA AYNI "alt sınıf KENDİ `__init__`ini
# tanımlamaz" deseni.
class CancelledError(Exception):
    pass

# Stdlib fazı §L (`nox.json`, bkz. nox-teknik-spesifikasyon.md) — `JsonValue`
# ve onun fabrika fonksiyonu BİLİNÇLİ OLARAK burada, `stdlib/nox/json.nox`
# YERİNE, ÇEKİRDEKTE tanımlanır: `runtime/stdlib_shims/json.zig`nin
# `extern fn nox_json_make_json_value(...)` bildirimi, BU sembole SABİT
# bir isimle başvurur — `noxrt.o` (json.zig'in makine kodu DAHİL) HER
# derlenen Nox programına KOŞULSUZ bağlanır (`cc -o bin prog.s noxrt.o`),
# ama `stdlib/nox/json.nox` yalnızca `import nox.json` YAPAN programlara
# dahil edilir. Fabrika `json.nox`da olsaydı, `nox.json`u HİÇ import
# ETMEYEN bir program (ör. `os_args_basic.nox`) `nox_json_make_json_value`
# sembolünü ASLA tanımlamaz, ama noxrt.o'nun (HER programa bağlanan)
# `json.zig` kodu YİNE DE ona başvurduğundan `cc`nin bağlama adımı "symbol
# not found" hatasıyla ÇÖKERDİ (GERÇEKTEN denenip yakalandı — HER golden
# testin `nox.json` İTHAL ETMEMESİNE RAĞMEN başarısız olduğu görüldü).
# Çözüm: `ValueError`/`IndexError` İLE AYNI ilkeyi izleyip `JsonValue`yi
# de HER programa KOŞULSUZ dahil ETMEK — kullanılmadığında yalnızca birkaç
# yüz bayt ölü kod dışında hiçbir maliyeti yoktur.
class JsonValue:
    def __init__(self: JsonValue, kind: int, b: bool, n: float, s: str,
                 arr: list[JsonValue], keys: list[str], vals: list[JsonValue]) -> None:
        self.kind = kind
        self.b = b
        self.n = n
        self.s = s
        self.arr = arr
        self.keys = keys
        self.vals = vals

def nox_json_make_json_value(kind: int, b: bool, n: float, s: str,
                              arr: list[JsonValue], keys: list[str], vals: list[JsonValue]) -> JsonValue:
    return JsonValue(kind, b, n, s, arr, keys, vals)

# Python builtin genişletmesi (bkz. nox-teknik-spesifikasyon.md yeni Faz
# bölümü) — `input`/`abs`/`min`/`max`/`sum`/`round`. HİÇBİR checker.zig/
# codegen.zig değişikliği GEREKTİRMEZ: `input` `runtime/stdlib_shims/
# io.zig`ye `extern def ... with_rt` İLE sarılır (`nox.fs`in AYNI deseni),
# geri kalanı `type_params` generic'leriyle SAF Nox kodudur.
extern def nox_stdin_read_line_raw() -> str from "zig-out/lib/noxrt.o" with_rt

# v1 kapsamı: Python'ın `input(prompt)`inin AKSİNE argümansızdır — bir
# `prompt` isteyen çağıran taraf ÖNCE `print(prompt)` çağırabilir. Gerçek
# EOF (stdin'de HİÇ satır kalmadığında) Python'daki gibi `EOFError`
# FIRLATMAZ, boş bir `str` döner — bilinçli v1 basitleştirmesi.
def input() -> str:
    return nox_stdin_read_line_raw()

def abs[T](x: T) -> T:
    if x < 0:
        return -x
    return x

# v1 kapsamı: yalnızca İKİ argüman (Nox'ta fonksiyon overload'u/değişken
# sayıda argüman YOK, Python'ın iterable-alan `min(xs)` formu desteklenmez).
def min[T](a: T, b: T) -> T:
    if a < b:
        return a
    return b

def max[T](a: T, b: T) -> T:
    if a > b:
        return a
    return b

extern def nox_float_round_digits_raw(x: float, nd: int) -> float from "zig-out/lib/noxrt.o"
extern def nox_chr_raw(cp: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_ord_raw(s: str) -> int from "zig-out/lib/noxrt.o"

# v1.162.0: Python gibi YARIM → ÇİFTE yuvarlama (`round(2.5) == 2`) ve tam ikili değer üzerinden (`round(x, nd)` aşağıda).
def round(x: float) -> int:
    return int(nox_float_round_digits_raw(x, 0))

# `round(x, nd)` çağrısı checker tarafından bu fonksiyona yönlendirilir (`float` döner, Python gibi).
# ---- TODO 8.6: tembel jeneratörler ----
# `Iterator[T]` / `Generator[T]` tipi `__nox_Gen[T]`dir. Üç kaynaktan biriyle kurulur: bir ADIM kapanışı (yield içeren fonksiyon, bkz.
# `generator_desugar.zig`), bir liste (`__nox_gen_from_list`) ya da başka bir Gen. `__next__` bir sonraki değeri ya da bitince None döner;
# `for x in g` bu protokolle TEMBEL yinelenir, `list(g)`/`sum(g)`/... ise `__iter__` ile kalanı bir listeye boşaltır.
class __nox_Gen[T]:
    def __init__(self, steps: list[() -> T | None], items: list[T], pos: int, closing: list[bool], thrown: list[Exception | None]) -> None:
        self.steps: list[() -> T | None] = steps
        self.items: list[T] = items
        self.pos: int = pos
        self.closing: list[bool] = closing
        self.thrown: list[Exception | None] = thrown
        self.started: bool = False
        self.finished: bool = False

    def __next__(self) -> T | None:
        if self.finished:
            return None
        self.started = True
        if len(self.steps) > 0:
            f: () -> T | None = self.steps[0]
            r: T | None = f()
            if r is None:
                self.finished = True
            return r
        if self.pos >= len(self.items):
            self.finished = True
            return None
        v: T = self.items[self.pos]
        self.pos = self.pos + 1
        return v

    def __self__(self) -> __nox_Gen[T]:
        return self

    # `next(g)` / `next(g, varsayılan)` (checker bu yöntemlere yönlendirir)
    def __nox_next_raise__(self) -> T:
        v: T | None = self.__next__()
        if v is None:
            raise StopIteration("generator is exhausted")
        return v

    def __nox_next_or__(self, d: T) -> T:
        v: T | None = self.__next__()
        if v is None:
            return d
        return v

    # `g.close()`: askıdaki bir jeneratörün bekleyen `finally`/`with` temizliklerini çalıştırır (yield noktasında `GeneratorExit` fırlatılır)
    # ve jeneratörü bitirir. Hiç başlamamış ya da zaten bitmiş jeneratörde yapılacak bir şey yoktur.
    # Jeneratör nesnesi serbest bırakılınca (son referans kaybolunca) askıdaki temizlikler (`finally`/`with`) çalışır — CPython'un referans sayımıyla
    # anında kapatmasının karşılığı. Hiç başlamamış ya da bitmiş jeneratörde yapılacak bir şey yoktur; `close()` içindeki hatalar yutulur.
    def __del__(self) -> None:
        if self.started and not self.finished:
            try:
                self.close()
            except Exception as e:
                pass

    def close(self) -> None:
        if self.finished:
            return
        self.finished = True
        if self.started and len(self.closing) > 0 and len(self.steps) > 0:
            self.closing[0] = True
            f: () -> T | None = self.steps[0]
            ignored: bool = False
            try:
                r: T | None = f()
                if r is not None:
                    ignored = True
            except GeneratorExit as e:
                pass
            if ignored:
                raise RuntimeError("generator ignored GeneratorExit")

    # `g.throw(e)`: askıdaki jeneratörün yield noktasında `e` fırlatılır; jeneratör yakalayıp yeni bir değer verirse o değer döner, bitirirse
    # `StopIteration`, yakalamazsa `e` çağırana yükselir. Hiç başlamamış ya da bitmiş jeneratörde `e` doğrudan yükselir ve jeneratör biter.
    def throw(self, e: Exception) -> T:
        if self.finished or not self.started or len(self.steps) == 0 or len(self.thrown) == 0:
            self.finished = True
            raise e
        self.thrown[0] = e
        return self.__nox_next_raise__()

    def __iter__(self) -> list[T]:
        out: list[T] = []
        while True:
            v: T | None = self.__next__()
            if v is None:
                break
            out.append(v)
        return out

def __nox_gen_from_step[T](step: () -> T | None) -> __nox_Gen[T]:
    steps: list[() -> T | None] = [step]
    items: list[T] = []
    closing: list[bool] = []
    thrown: list[Exception | None] = []
    return __nox_Gen[T](steps, items, 0, closing, thrown)

# `try`/`with` içinde `yield` bulunan jeneratörler: `closing[0]` yield noktasında `GeneratorExit` fırlattırır, `thrown` `g.throw(e)`nin istisnasını taşır.
def __nox_gen_from_step_closable[T](step: () -> T | None, closing: list[bool], thrown: list[Exception | None]) -> __nox_Gen[T]:
    steps: list[() -> T | None] = [step]
    items: list[T] = []
    return __nox_Gen[T](steps, items, 0, closing, thrown)

def __nox_gen_from_list[T](xs: list[T]) -> __nox_Gen[T]:
    steps: list[() -> T | None] = []
    closing: list[bool] = []
    thrown: list[Exception | None] = []
    return __nox_Gen[T](steps, xs, 0, closing, thrown)

# `Generator[Y, S]`: `g.send(v)` ile jeneratöre değer gönderilebilen jeneratör (`x = yield e`). `Iterator[Y]`nin tüm davranışını `inner`a devreder; `Iterator[Y]`
# beklenen yere `g.iterator()` ile verilir.
class __nox_GenS[T, S]:
    def __init__(self, inner: __nox_Gen[T], senders: list[(S) -> None]) -> None:
        self.inner: __nox_Gen[T] = inner
        self.senders: list[(S) -> None] = senders

    def __next__(self) -> T | None:
        return self.inner.__next__()

    def __self__(self) -> __nox_GenS[T, S]:
        return self

    def iterator(self) -> __nox_Gen[T]:
        return self.inner

    def close(self) -> None:
        self.inner.close()

    def __iter__(self) -> list[T]:
        return self.inner.__iter__()

    def __nox_next_raise__(self) -> T:
        return self.inner.__nox_next_raise__()

    def __nox_next_or__(self, d: T) -> T:
        return self.inner.__nox_next_or__(d)

    # Değeri jeneratörün `x = yield ...` noktasına teslim eder ve bir sonraki yield'e kadar çalıştırır (bitince StopIteration).
    # Hiç başlamamış jeneratöre değer gönderilemez (önce `next(g)`).
    def throw(self, e: Exception) -> T:
        return self.inner.throw(e)

    def send(self, v: S) -> T:
        if not self.inner.started:
            raise ValueError("can't send a value to a just-started generator: call next(g) first")
        f: (S) -> None = self.senders[0]
        f(v)
        return self.inner.__nox_next_raise__()

def __nox_gens_from_step[T, S](step: () -> T | None, closing: list[bool], thrown: list[Exception | None], sender: (S) -> None) -> __nox_GenS[T, S]:
    steps: list[() -> T | None] = [step]
    items: list[T] = []
    senders: list[(S) -> None] = [sender]
    return __nox_GenS[T, S](__nox_Gen[T](steps, items, 0, closing, thrown), senders)

# Yields boyunca yaşayan FONKSİYON tipli yereller (`f: (int) -> int = ...`) için kutu: Optional fonksiyon tipi söz diziminde ifade edilemediğinden değer `f` alanında tutulur.
class __nox_FnBox[F]:
    def __init__(self, f: F) -> None:
        self.f: F = f

# Jeneratör yereli `int | None` gibi OPTIONAL SKALER ise (liste elemanı olamaz) hücre bu yuvanın tek elemanıdır.
class __nox_Slot[T]:
    def __init__(self, v: T | None) -> None:
        self.v: T | None = v

# Jeneratör gövdesinde "atanmadan okundu" (derleyici hatası dışında olmaması gereken) durumu.
def __nox_unwrap[T](o: T | None) -> T:
    if o is None:
        raise ValueError("generator variable used before assignment")
    return o

# `f(**d)` (checker `**kwargs` parametresine bağlar): `d`nin anahtarlarından biri çağrıda adıyla bağlanan bir parametrenin adıysa
# (`reserved`) Python'daki "multiple values for argument" hatası ValueError olarak fırlatılır; aksi halde `d`nin kopyası döner.
def __nox_kw_unpack[V](d: dict[str, V], reserved: list[str]) -> dict[str, V]:
    for name in reserved:
        if d.contains(name):
            raise ValueError("got multiple values for argument '" + name + "'")
    return d.copy()

# Birden çok `**d` ya da `**d` + açık anahtar-kelime argümanı: yinelenen anahtar ValueError.
def __nox_kw_merge[V](a: dict[str, V], b: dict[str, V]) -> dict[str, V]:
    out: dict[str, V] = a.copy()
    for k in b.keys():
        if out.contains(k):
            raise ValueError("got multiple values for keyword argument '" + k + "'")
        out[k] = b[k]
    return out

def __nox_round_digits(x: float, nd: int) -> float:
    return nox_float_round_digits_raw(x, nd)

# v1.164.0: `format(x, spec)` ve f-string biçim belirteçleri (`f"{x:.2f}"`) — checker tür-bazlı olarak bu üç işleve yönlendirir.
extern def nox_format_spec_check(kind: int, spec: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_format_int_raw(v: int, spec: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_format_float_raw(v: float, spec: str) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_format_str_raw(v: str, spec: str) -> str from "zig-out/lib/noxrt.o" with_rt

def __nox_format_int(v: int, spec: str) -> str:
    if nox_format_spec_check(0, spec) == 0:
        raise ValueError("invalid format specifier: " + spec)
    return nox_format_int_raw(v, spec)

def __nox_format_float(v: float, spec: str) -> str:
    if nox_format_spec_check(1, spec) == 0:
        raise ValueError("invalid format specifier: " + spec)
    return nox_format_float_raw(v, spec)

def __nox_format_str(v: str, spec: str) -> str:
    if nox_format_spec_check(2, spec) == 0:
        raise ValueError("invalid format specifier: " + spec)
    return nox_format_str_raw(v, spec)

def chr(cp: int) -> str:
    return nox_chr_raw(cp)

def ord(s: str) -> int:
    n: int = nox_ord_raw(s)
    if n < 0:
        raise ValueError("ord() cannot take an empty str")
    return n

def any(xs: list[bool]) -> bool:
    for x in xs:
        if x:
            return True
    return False

def all(xs: list[bool]) -> bool:
    for x in xs:
        if not x:
            return False
    return True

def divmod[T](a: T, b: T) -> tuple[T, T]:
    return a // b, a % b

# v1 kapsamı: `sum`/`sum_float` AYRI adlarla (Nox'ta dönüş-tipine göre
# overload YOK — `total = 0` ile `total = 0.0` FARKLI somut başlangıç
# qtype'ları gerektirdiğinden TEK bir generic `sum[T]` yazılamaz).
def sum(xs: list[int]) -> int:
    total: int = 0
    for x in xs:
        total = total + x
    return total

def sum_float(xs: list[float]) -> float:
    total: float = 0.0
    for x in xs:
        total = total + x
    return total

# v1.150.0 (list tam API): `sorted(xs)` yeni, sıralanmış bir liste döner (orijinal değişmez; `sort()` gibi yalnızca
# list[int]/list[float]/list[str] için). `reversed(xs)` Python'dan FARKLI olarak bir yineleyici değil, ters sıralı YENİ bir
# liste döner (`for x in reversed(xs):` olduğu gibi çalışır).
def sorted[T](xs: list[T], reverse: bool = False) -> list[T]:
    ys: list[T] = xs.copy()
    ys.sort()
    if reverse:
        ys.reverse()
    return ys

# v1.162.0: `sorted(xs, key=f, reverse=...)` bu kararlı birleştirme sıralamasına yönlendirilir (checker). `key` bir lambda ya da fonksiyon olabilir.
def __nox_sorted_key[T, K](xs: list[T], key: (T) -> K, reverse: bool = False) -> list[T]:
    n: int = len(xs)
    keys: list[K] = []
    for x in xs:
        keys.append(key(x))
    idx: list[int] = []
    tmp: list[int] = []
    i: int = 0
    while i < n:
        idx.append(i)
        tmp.append(i)
        i = i + 1
    width: int = 1
    while width < n:
        lo: int = 0
        while lo < n:
            mid: int = min(lo + width, n)
            hi: int = min(lo + 2 * width, n)
            a: int = lo
            b: int = mid
            k: int = lo
            while a < mid and b < hi:
                take_right: bool = keys[idx[b]] < keys[idx[a]]
                if reverse:
                    take_right = keys[idx[b]] > keys[idx[a]]
                if take_right:
                    tmp[k] = idx[b]
                    b = b + 1
                else:
                    tmp[k] = idx[a]
                    a = a + 1
                k = k + 1
            while a < mid:
                tmp[k] = idx[a]
                a = a + 1
                k = k + 1
            while b < hi:
                tmp[k] = idx[b]
                b = b + 1
                k = k + 1
            lo = lo + 2 * width
        i = 0
        while i < n:
            idx[i] = tmp[i]
            i = i + 1
        width = width * 2
    out: list[T] = []
    for j in idx:
        out.append(xs[j])
    return out

# `xs.sort(reverse=True)` / `xs.sort(key=f, reverse=...)` bu iki fonksiyona yönlendirilir (yerinde sıralar).
def __nox_sort_reverse_inplace[T](xs: list[T], reverse: bool = False) -> None:
    xs.sort()
    if reverse:
        xs.reverse()

def __nox_sort_key_inplace[T, K](xs: list[T], key: (T) -> K, reverse: bool = False) -> None:
    ys: list[T] = __nox_sorted_key(xs, key, reverse)
    i: int = 0
    while i < len(xs):
        xs[i] = ys[i]
        i = i + 1

# `max(xs)` / `min(xs)` (tek liste argümanı) ve `max(xs, key=f)` / `min(xs, key=f)` bu fonksiyonlara yönlendirilir (checker).
def __nox_max_list[T](xs: list[T]) -> T:
    if len(xs) == 0:
        raise ValueError("max() called with an empty sequence")
    best: T = xs[0]
    for x in xs:
        if x > best:
            best = x
    return best

def __nox_min_list[T](xs: list[T]) -> T:
    if len(xs) == 0:
        raise ValueError("min() called with an empty sequence")
    best: T = xs[0]
    for x in xs:
        if x < best:
            best = x
    return best

def __nox_max_key[T, K](xs: list[T], key: (T) -> K) -> T:
    if len(xs) == 0:
        raise ValueError("max() called with an empty sequence")
    best: T = xs[0]
    best_k: K = key(best)
    for x in xs:
        k: K = key(x)
        if k > best_k:
            best = x
            best_k = k
    return best

def __nox_min_key[T, K](xs: list[T], key: (T) -> K) -> T:
    if len(xs) == 0:
        raise ValueError("min() called with an empty sequence")
    best: T = xs[0]
    best_k: K = key(best)
    for x in xs:
        k: K = key(x)
        if k < best_k:
            best = x
            best_k = k
    return best

# `map`/`filter` Python'dan FARKLI olarak tembel yineleyici değil, YENİ bir liste döner (`for x in map(f, xs):` ve `list(map(f, xs))` çalışır).
def map[T, U](f: (T) -> U, xs: list[T]) -> list[U]:
    out: list[U] = []
    for x in xs:
        out.append(f(x))
    return out

def filter[T](f: (T) -> bool, xs: list[T]) -> list[T]:
    out: list[T] = []
    for x in xs:
        if f(x):
            out.append(x)
    return out

def reversed[T](xs: list[T]) -> list[T]:
    ys: list[T] = xs.copy()
    ys.reverse()
    return ys

# v1.157.0 (tuple): `d.items()` bu fonksiyona yeniden yazılır; `enumerate`/`zip` Python'dan FARKLI olarak tembel yineleyici değil, tuple listesi döner
# (`for i, x in enumerate(xs):` olduğu gibi çalışır).
def __nox_dict_items[K, V](d: dict[K, V]) -> list[tuple[K, V]]:
    out: list[tuple[K, V]] = []
    for k in d:
        out.append((k, d[k]))
    return out

def enumerate[T](xs: list[T]) -> list[tuple[int, T]]:
    out: list[tuple[int, T]] = []
    i: int = 0
    while i < len(xs):
        out.append((i, xs[i]))
        i = i + 1
    return out

def zip[A, B](a: list[A], b: list[B]) -> list[tuple[A, B]]:
    out: list[tuple[A, B]] = []
    n: int = len(a)
    if len(b) < n:
        n = len(b)
    i: int = 0
    while i < n:
        out.append((a[i], b[i]))
        i = i + 1
    return out


# ---- v1.168.0: `set[T]` — sözlük (T → bool) üzerine kurulu küme. Yüzey adı `set`; parser `set[T]`yi `__nox_Set[T]`ye, `{a, b}`/`{x for ...}`i
# `__nox_set_from_list([...])`e, checker `set()`/`set(it)`i buraya yönlendirir. Operatörler dunder protokolüyle (`|` `&` `-` `^` `<=` `>=` `<` `>` `==` `in` `len` `for`).
# Eleman tipi dict anahtarı kurallarına tabidir (int/float/bool/str). Yazdırma ekleme sırasıyla (Python'da sıra tanımsızdır).
class __nox_Set[T]:
    _d: dict[T, bool]

    def __init__(self) -> None:
        self._d = {}

    def add(self, v: T) -> None:
        self._d[v] = True

    def update(self, other: __nox_Set[T]) -> None:
        for k in other._d:
            self._d[k] = True

    def remove(self, v: T) -> None:
        if v not in self._d:
            raise KeyError("set.remove(x): x is not in the set")
        del self._d[v]

    def discard(self, v: T) -> None:
        if v in self._d:
            del self._d[v]

    def pop(self) -> T:
        ks: list[T] = list(self._d)
        if len(ks) == 0:
            raise KeyError("pop from an empty set")
        v: T = ks[0]
        del self._d[v]
        return v

    def clear(self) -> None:
        self._d.clear()

    def copy(self) -> __nox_Set[T]:
        r: __nox_Set[T] = __nox_Set[T]()
        r.update(self)
        return r

    def union(self, other: __nox_Set[T]) -> __nox_Set[T]:
        r: __nox_Set[T] = self.copy()
        r.update(other)
        return r

    def intersection(self, other: __nox_Set[T]) -> __nox_Set[T]:
        r: __nox_Set[T] = __nox_Set[T]()
        for k in self._d:
            if k in other._d:
                r._d[k] = True
        return r

    def difference(self, other: __nox_Set[T]) -> __nox_Set[T]:
        r: __nox_Set[T] = __nox_Set[T]()
        for k in self._d:
            if k not in other._d:
                r._d[k] = True
        return r

    def symmetric_difference(self, other: __nox_Set[T]) -> __nox_Set[T]:
        r: __nox_Set[T] = self.difference(other)
        for k in other._d:
            if k not in self._d:
                r._d[k] = True
        return r

    def issubset(self, other: __nox_Set[T]) -> bool:
        for k in self._d:
            if k not in other._d:
                return False
        return True

    def issuperset(self, other: __nox_Set[T]) -> bool:
        return other.issubset(self)

    def isdisjoint(self, other: __nox_Set[T]) -> bool:
        for k in self._d:
            if k in other._d:
                return False
        return True

    def __contains__(self, v: T) -> bool:
        return v in self._d

    def __len__(self) -> int:
        return len(self._d)

    def __iter__(self) -> list[T]:
        return list(self._d)

    def __or__(self, other: __nox_Set[T]) -> __nox_Set[T]:
        return self.union(other)

    def __and__(self, other: __nox_Set[T]) -> __nox_Set[T]:
        return self.intersection(other)

    def __sub__(self, other: __nox_Set[T]) -> __nox_Set[T]:
        return self.difference(other)

    def __xor__(self, other: __nox_Set[T]) -> __nox_Set[T]:
        return self.symmetric_difference(other)

    def __le__(self, other: __nox_Set[T]) -> bool:
        return self.issubset(other)

    def __ge__(self, other: __nox_Set[T]) -> bool:
        return other.issubset(self)

    def __lt__(self, other: __nox_Set[T]) -> bool:
        return len(self._d) < len(other._d) and self.issubset(other)

    def __gt__(self, other: __nox_Set[T]) -> bool:
        return len(self._d) > len(other._d) and other.issubset(self)

    def __eq__(self, other: __nox_Set[T]) -> bool:
        return len(self._d) == len(other._d) and self.issubset(other)

    def __str__(self) -> str:
        if len(self._d) == 0:
            return "set()"
        out: str = "{"
        first: bool = True
        for k in self._d:
            if not first:
                out = out + ", "
            out = out + repr(k)
            first = False
        return out + "}"

def __nox_set_from_list[T](xs: list[T]) -> __nox_Set[T]:
    s: __nox_Set[T] = __nox_Set[T]()
    for x in xs:
        s.add(x)
    return s

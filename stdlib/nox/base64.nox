# Aether NOX_LIMITATIONS.md yol haritası, Faz A.1 (bkz. nox-teknik-
# spesifikasyon.md ilgili bölüm) — `nox.base64`: standart + URL-safe
# base64 encode/decode. TAMAMEN SAF Nox — HİÇBİR yeni Zig shim/extern def
# GEREKMEDİ: bitwise operatörler (v1.109.0, `&`/`|`/`>>`/`<<`) + `nox.
# strings`in ZATEN var olan HAM bayt ilkelleri (`byte_at`/`byte_len`/
# `char_from_byte` — `str`i bir TEK karakter DİZİSİ değil, HAM BAYT
# dizisi olarak ele almak İçin) YETERLİ. Bu YÜZDEN `nox.json.dump()`nin
# ürettiği (ASCII-SAFE OLMAYAN — bkz. `json.nox`nin KENDİ belge notu)
# HERHANGİ bir UTF-8 metni DAHİL, HERHANGİ bir `str`nin HAM bayt
# temsilini DOĞRU kodlar/çözer (karakter-BAZLI bir yaklaşımın aksine).
#
# Modül capability-SİZDİR (HİÇBİR OS/ağ/dosya erişimi YOK) — freestanding
# DAHİL her profilde kullanılabilir.

class Base64Error(Exception):
    pass

# v2.1.56: çekirdek Zig kabuğunda (`runtime/stdlib_shims/base64.zig`); saf Nox uygulaması 4 MiB'ta CPython'dan 26x/36x yavaştı. Anlam AYNEN korunur.
extern def nox_base64_encode_raw(s: str, url_safe: int) -> str from "zig-out/lib/noxrt.o" with_rt
extern def nox_base64_check_raw(s: str) -> int from "zig-out/lib/noxrt.o"
extern def nox_base64_decode_raw(s: str) -> str from "zig-out/lib/noxrt.o" with_rt

# Standart base64 (RFC 4648 §4) — `+`/`/` alfabesi, `=` dolgulu.
def encode(data: str) -> str:
    return nox_base64_encode_raw(data, 0)

# URL-safe base64 (RFC 4648 §5) — `-`/`_` alfabesi, dolgu YOK (JWT'nin
# KENDİ sözleşmesiyle TUTARLI, bkz. `nox.jwt`).
def encode_url(data: str) -> str:
    return nox_base64_encode_raw(data, 1)

# HEM standart HEM URL-safe (HEM dolgulu HEM dolgusuz) girdiyi kabul
# eder; sondaki tüm `=` işaretleri atılır. Geçersiz karakter ya da
# geçersiz uzunlukta `Base64Error`.
def decode(s: str) -> str:
    code: int = nox_base64_check_raw(s)
    if code == 1:
        raise Base64Error("invalid base64 character")
    if code == 2:
        raise Base64Error("invalid base64 length")
    return nox_base64_decode_raw(s)

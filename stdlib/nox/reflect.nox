# nox.reflect — Faz 1 decorator (bkz. nox-teknik-spesifikasyon.md decorator
# bölümü, "Decorator sözdizimi + metadata-tabanlı metaprogramming" planı):
# derleyicinin topladığı decorator METADATA'sını (isim, literal argümanlar,
# varsa çağrılabilir bir "handler") sorgulamak için ince bir sarmalayıcı.
#
# **Tasarım ilkesi:** Derleyici decorator'ların ANLAMINI yorumlamaz — bir
# `@get("/users")` yalnızca (decorator adı: "get", argümanlar: ["/users"],
# hedef fonksiyon) üçlüsü olarak KAYDEDİLİR. Bu modül YALNIZCA bu ham
# veriyi açığa çıkarır; `router_from_decorators()` (aşağıda) BU ham veriyi
# YORUMLAYAN, framework-seviyesinde BİR ÖRNEK tüketicidir — kendi
# projeleriniz `decorator_name`/`decorator_arg` üzerine KENDİ yorumlayıcı
# mantığınızı (ör. `@inject`, `@cache`) inşa edebilir.
#
# `__nox_reflect_decorator_*` alttaki yerleşikler DERLEYİCİ TARAFINDAN ÖZEL
# TANINIR (bkz. `compiler/typecheck/checker.zig`/`compiler/codegen_qbe/
# calls.zig`) — kullanıcı kodu bunları DOĞRUDAN çağırmamalı, HER ZAMAN bu
# modülün sardığı isimler (`nox.reflect.decorator_count()` vb.) üzerinden
# erişmelidir.
from nox.router import Context, Router
from nox.http import HttpResponse
import nox.strings

def decorator_count() -> int:
    return __nox_reflect_decorator_count()

# Decorator'ın UYGULANDIĞI fonksiyonun adı (hata ayıklama/tanılama İçin).
def decorator_target_name(i: int) -> str:
    return __nox_reflect_decorator_target_name(i)

def decorator_name(i: int) -> str:
    return __nox_reflect_decorator_name(i)

def decorator_arg_count(i: int) -> int:
    return __nox_reflect_decorator_arg_count(i)

def decorator_arg(i: int, j: int) -> str:
    return __nox_reflect_decorator_arg(i, j)

# Aether NOX_LIMITATIONS.md yol haritası, Faz A.6 (bkz. nox-teknik-
# spesifikasyon.md ilgili bölüm, madde 2): `decorator_arg`in v1'i
# YALNIZCA string literali kabul ediyordu (ör. `@route.priority(5)`
# GİBİ bir int argümanı YAZMAK derleme hatasıydı) — artık decorator
# argümanları string/int/bool/string-listesi OLABİLİR. `decorator_arg_
# kind(i, j)` HANGİ erişimcinin GÜVENLE çağrılabileceğini söyler:
# `0`=string (`decorator_arg`), `1`=int (`decorator_arg_int`),
# `2`=bool (`decorator_arg_bool`), `3`=string-listesi (`decorator_arg_
# list_len`/`decorator_arg_list_item`). YANLIŞ erişimciyi çağırmak
# (ör. bir int argümanında `decorator_arg_bool`) ÇÖKMEZ — güvenli bir
# varsayılan (`0`/`False`/boş dize) döner, bkz. `decorators.zig`nin
# belge notu.
def decorator_arg_kind(i: int, j: int) -> int:
    return __nox_reflect_decorator_arg_kind(i, j)

def decorator_arg_int(i: int, j: int) -> int:
    return __nox_reflect_decorator_arg_int(i, j)

def decorator_arg_bool(i: int, j: int) -> bool:
    return __nox_reflect_decorator_arg_bool(i, j)

def decorator_arg_list_len(i: int, j: int) -> int:
    return __nox_reflect_decorator_arg_list_len(i, j)

def decorator_arg_list_item(i: int, j: int, k: int) -> str:
    return __nox_reflect_decorator_arg_list_item(i, j, k)

# Aether NOX_LIMITATIONS.md yol haritası, Faz B.5 (madde 3): dekore edilmiş
# fonksiyonun KENDİ imzası — salt BİLGİ (framework'ler parametre-decorator
# sarmalayıcıları üretmek İçin). Tip metinleri derleyicinin iç gösterimidir
# (`int`, `str`, `list[int]`; içe aktarılan sınıflar MANGLE edilmiş adla,
# ör. `nox_http_HttpRequest` — kullanıcı modülündeki sınıflar çıplak adla).
# `k` aralık dışıysa boş dize döner.
def decorator_param_count(i: int) -> int:
    return __nox_reflect_decorator_param_count(i)

def decorator_param_name(i: int, k: int) -> str:
    return __nox_reflect_decorator_param_name(i, k)

def decorator_param_type(i: int, k: int) -> str:
    return __nox_reflect_decorator_param_type(i, k)

def decorator_return_type(i: int) -> str:
    return __nox_reflect_decorator_return_type(i)

# Faz C.3 (madde 5): HER (generic olmayan) sınıfın `__init__` parametreleri
# (`self` HARİÇ) — bir DI container'ın KENDİ wiring mantığını yazabilmesi
# İçin yeterli ham metadata; Nox'un KENDİSİ bir DI çözücü SAĞLAMAZ (bilinçli
# sınır). Kendi `__init__`i olmayan sınıf TABANININ parametrelerini
# devralır. Sıra: modül sırası (içe aktarılan stdlib/paket sınıfları DAHİL).
def class_count() -> int:
    return __nox_reflect_class_count()

def class_name(i: int) -> str:
    return __nox_reflect_class_name(i)

def class_init_param_count(i: int) -> int:
    return __nox_reflect_class_init_param_count(i)

def class_init_param_name(i: int, k: int) -> str:
    return __nox_reflect_class_init_param_name(i, k)

def class_init_param_type(i: int, k: int) -> str:
    return __nox_reflect_class_init_param_type(i, k)

# `name` adlı sınıfın `class_*` indeksi, yoksa `-1`.
def class_index(name: str) -> int:
    n: int = class_count()
    i: int = 0
    while i < n:
        if class_name(i) == name:
            return i
        i = i + 1
    return -1

# `true` İSE `decorator_handler(i)` GÜVENLE çağrılabilir (fonksiyonun imzası
# TAM OLARAK `(ctx: Context) -> HttpResponse`dir) — `false` İKEN
# `decorator_handler(i)` ÇAĞRILMAMALIDIR (null bir kapanışa yol açar).
def decorator_is_handler(i: int) -> bool:
    return __nox_reflect_decorator_is_handler(i)

# YALNIZCA `decorator_is_handler(i)` `true` İKEN çağırın — bkz. yukarıdaki not.
def decorator_handler(i: int) -> (Context) -> HttpResponse:
    return __nox_reflect_decorator_handler(i)

# Framework tüketimi (bkz. plan dosyası §5): `@get`/`@post`/`@put`/`@delete`
# İLE decore edilmiş, `(Context) -> HttpResponse` imzalı TÜM üst-düzey
# fonksiyonlardan bir `Router` inşa eder — `Router.add(method, pattern,
# handler)`ın (stdlib/nox/router.nox, MEVCUT, hiçbir değişiklik GEREKMEDEN)
# ÜZERİNE. Kullanım:
# ```
# @get("/users/:id")
# def show_user(ctx: Context) -> HttpResponse:
#     ...
#
# r: Router = nox.reflect.router_from_decorators()
# def handle(req: HttpRequest) -> HttpResponse:
#     return r.dispatch(req)
# nox.http.serve(8080, handle, 1)
# ```
def router_from_decorators() -> Router:
    r: Router = Router()
    n: int = decorator_count()
    i: int = 0
    while i < n:
        name: str = decorator_name(i)
        is_route: bool = name == "get" or name == "post" or name == "put" or name == "delete"
        if is_route and decorator_is_handler(i):
            pattern: str = decorator_arg(i, 0)
            handler: (Context) -> HttpResponse = decorator_handler(i)
            r.add(nox.strings.upper(name), pattern, handler)
        i = i + 1
    return r

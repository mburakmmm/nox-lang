# nox.yaml — YAML 1.2 (çekirdek şema) ayrıştırma ve yazma, saf Nox. Satır-tabanlı, girinti-duyarlı ayrıştırıcı (TODO 8.8).
#
# Kapsam: blok eşlemeler/diziler (girintiyle iç içe, `- key: value` dahil); akış dizileri/eşlemeleri (çok satırlı, iç içe); düz,
# çift-tırnaklı (kaçışlar: \n \t \r \0 \" \\ \/ \xHH \uHHHH \UHHHHHHHH), tek-tırnaklı skalerler; çok satırlı düz/tırnaklı skalerler
# (satır katlama); blok skalerleri `|` ve `>` (kırpma işaretleri `-`/`+`, girinti göstergesi); satır içi (sondaki) yorumlar;
# çapalar `&a`, takma adlar `*a`, birleştirme anahtarı `<<`; etiketler `!!str !!int !!float !!bool !!null` (diğer etiketler yok sayılır);
# çok belgeli akışlar (`---`/`...`, bkz. `parse_all`); %YAML/%TAG yönergeleri atlanır.
# Eşleme anahtarları her zaman `str` olarak saklanır (skaler anahtarlar metinleriyle). Açık anahtar sözdizimi (`? key`) ve akış koleksiyonu
# anahtarları desteklenmez (YamlError).
#
# Güvenlik dersleri (nox.toml'dan): çıplak `return s[i]` ARC sızıntısı yapar → `"" + s[i]`; özyinelemeli yardımcılar `list[str]` döndürür.

import nox.strings

class YamlError(Exception):
    pass

# kind: 0=string, 1=int, 2=float, 3=bool, 4=null, 5=sequence, 6=mapping
class YamlValue:
    def __init__(self: YamlValue, kind: int, b: bool, i: int, f: float, s: str, arr: list[YamlValue], mapping: dict[str, YamlValue]) -> None:
        self.kind = kind
        self.b = b
        self.i = i
        self.f = f
        self.s = s
        self.arr = arr
        self.mapping = mapping

def _make_string(s: str) -> YamlValue:
    return YamlValue(0, False, 0, 0.0, s, [], {})

def _make_int(i: int) -> YamlValue:
    return YamlValue(1, False, i, 0.0, "", [], {})

def _make_float(f: float) -> YamlValue:
    return YamlValue(2, False, 0, f, "", [], {})

def _make_bool(b: bool) -> YamlValue:
    return YamlValue(3, b, 0, 0.0, "", [], {})

def _make_null() -> YamlValue:
    return YamlValue(4, False, 0, 0.0, "", [], {})

def _make_sequence(arr: list[YamlValue]) -> YamlValue:
    return YamlValue(5, False, 0, 0.0, "", arr, {})

def _make_mapping() -> YamlValue:
    return YamlValue(6, False, 0, 0.0, "", [], {})

def is_string(v: YamlValue) -> bool:
    return v.kind == 0

def is_int(v: YamlValue) -> bool:
    return v.kind == 1

def is_float(v: YamlValue) -> bool:
    return v.kind == 2

def is_bool(v: YamlValue) -> bool:
    return v.kind == 3

def is_null(v: YamlValue) -> bool:
    return v.kind == 4

def is_sequence(v: YamlValue) -> bool:
    return v.kind == 5

def is_mapping(v: YamlValue) -> bool:
    return v.kind == 6

class _Line:
    def __init__(self, indent: int, content: str) -> None:
        self.indent: int = indent
        self.content: str = content

# Ayrıştırma bağlamı: çapa tablosu (`&ad` → değer).
class _Ctx:
    def __init__(self) -> None:
        self.anchors: dict[str, YamlValue] = {}

# `&çapa` / `!etiket` önekleri ayrılmış değer metni.
class _Props:
    def __init__(self, anchor: str, tag: str, rest: str) -> None:
        self.anchor: str = anchor
        self.tag: str = tag
        self.rest: str = rest

def _char_at_or_empty(s: str, pos: int, n: int) -> str:
    if pos < n:
        return "" + s[pos]
    return ""

def _substr(s: str, start: int, end: int) -> str:
    result: str = ""
    i: int = start
    while i < end:
        result = result + s[i]
        i = i + 1
    return result

def _is_digit_char(c: str) -> bool:
    b: int = nox.strings.byte_at(c, 0)
    return b >= 48 and b <= 57

def _is_all_digits(s: str) -> bool:
    if len(s) == 0:
        return False
    for c in s:
        if not _is_digit_char(c):
            return False
    return True

# ---- satır yardımcıları: yorum kırpma, anahtar ayracı, değer başlangıcı ----

# Bir tırnağın AÇILABİLECEĞİ konum: değer başı, boşluk ya da `[ { , :` sonrası ("it's" içindeki ' tırnak açmaz).
def _can_open_quote(s: str, i: int) -> bool:
    if i == 0:
        return True
    p: str = s[i - 1]
    return p == " " or p == "[" or p == "{" or p == "," or p == ":" or p == "-" or p == "\t"

# Tırnak dışındaki ` #` yorumunu keser (sondaki boşluk da atılır).
def _strip_comment(s: str) -> str:
    n: int = len(s)
    i: int = 0
    quote: str = ""
    while i < n:
        c: str = s[i]
        if quote == "\"":
            if c == "\\":
                i = i + 1
            elif c == "\"":
                quote = ""
        elif quote == "'":
            if c == "'":
                if _char_at_or_empty(s, i + 1, n) == "'":
                    i = i + 1
                else:
                    quote = ""
        elif c == "#" and (i == 0 or s[i - 1] == " " or s[i - 1] == "\t"):
            return nox.strings.trim_end(_substr(s, 0, i))
        elif (c == "\"" or c == "'") and _can_open_quote(s, i):
            quote = c
        i = i + 1
    return nox.strings.trim_end(s)

# Anahtarı bitiren `:`nın indeksi (ardından boşluk ya da satır sonu gelen, tırnak dışı ilk `:`), yoksa -1.
def _find_key_sep(content: str) -> int:
    n: int = len(content)
    if n == 0:
        return -1
    first: str = content[0]
    i: int = 0
    if first == "\"":
        i = 1
        while i < n and content[i] != "\"":
            if content[i] == "\\":
                i = i + 1
            i = i + 1
        i = i + 1
        if i < n and content[i] == ":" and (i + 1 == n or content[i + 1] == " "):
            return i
        return -1
    if first == "'":
        i = 1
        closed: bool = False
        while i < n and not closed:
            if content[i] == "'":
                if _char_at_or_empty(content, i + 1, n) == "'":
                    i = i + 2
                else:
                    closed = True
            else:
                i = i + 1
        i = i + 1
        if i < n and content[i] == ":" and (i + 1 == n or content[i + 1] == " "):
            return i
        return -1
    if first == "[" or first == "{":
        return -1
    while i < n:
        if content[i] == ":" and (i + 1 == n or content[i + 1] == " "):
            return i
        i = i + 1
    return -1

def _is_sequence_line(content: str) -> bool:
    if len(content) == 0:
        return False
    if content[0] != "-":
        return False
    if len(content) == 1:
        return True
    return content[1] == " "

def _is_mapping_line(content: str) -> bool:
    return _find_key_sep(content) >= 0

def _count_leading_spaces(raw: str) -> int:
    count: int = 0
    n: int = len(raw)
    scanning: bool = True
    while scanning:
        if count >= n:
            scanning = False
        elif raw[count] == " ":
            count = count + 1
        else:
            scanning = False
    return count

extern def nox_strings_leading_tab_raw(s: str) -> int from "zig-out/lib/noxrt.o"

# ---- blok skalerleri ve çok satırlı değerler için ön işleme ----

def _escape_for_double_quotes(s: str) -> str:
    out: str = ""
    for c in s:
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif c == "\n":
            out = out + "\\n"
        elif c == "\t":
            out = out + "\\t"
        elif nox.strings.byte_at(c, 0) == 13:
            out = out + "\\r"
        else:
            out = out + c
    return out

class _BlockHeader:
    def __init__(self, found: bool, prefix: str, style: str, chomp: str, explicit: int) -> None:
        self.found: bool = found
        self.prefix: str = prefix
        self.style: str = style
        self.chomp: str = chomp
        self.explicit: int = explicit

# `key: |-`, `- >`, `- k: |2+` ... başlığını tanır; `prefix` başlık işaretinden öncesi (örn. "key: ").
def _block_header(content: str) -> _BlockHeader:
    none: _BlockHeader = _BlockHeader(False, "", "", "", 0)
    n: int = len(content)
    if n == 0:
        return none
    sp: int = n - 1
    while sp >= 0 and content[sp] != " ":
        sp = sp - 1
    token: str = _substr(content, sp + 1, n)
    if len(token) == 0 or (token[0] != "|" and token[0] != ">"):
        return none
    chomp: str = ""
    explicit: int = 0
    j: int = 1
    while j < len(token):
        c: str = token[j]
        if c == "+" or c == "-":
            chomp = c
        elif _is_digit_char(c):
            explicit = nox.strings.byte_at(c, 0) - 48
        else:
            return none
        j = j + 1
    prefix: str = _substr(content, 0, sp + 1)
    trimmed_prefix: str = nox.strings.trim_end(prefix)
    if sp < 0:
        # satırın tamamı yalnızca `|` (belge kökü blok skaleri)
        return _BlockHeader(True, "", _substr(token, 0, 1), chomp, explicit)
    if len(trimmed_prefix) == 0:
        return none
    last: str = trimmed_prefix[len(trimmed_prefix) - 1]
    if last != ":" and last != "-" and last != "&" and last != "!":
        # `key: &a |` gibi önekler: son sözcük `&ad` / `!etiket` ise de başlıktır
        words: list[str] = nox.strings.split(trimmed_prefix, " ")
        lastw: str = words[len(words) - 1]
        if len(lastw) == 0 or (lastw[0] != "&" and lastw[0] != "!"):
            return none
    return _BlockHeader(True, prefix, _substr(token, 0, 1), chomp, explicit)

def _fold_block(lines: list[str]) -> str:
    out: str = ""
    prev: int = 0
    breaks: int = 0
    for ln in lines:
        if ln == "":
            breaks = breaks + 1
        else:
            more: bool = ln[0] == " " or ln[0] == "\t"
            if prev == 0:
                out = nox.strings.repeat("\n", breaks) + ln
            else:
                if prev == 1 and not more:
                    if breaks == 0:
                        out = out + " " + ln
                    else:
                        out = out + nox.strings.repeat("\n", breaks) + ln
                else:
                    out = out + nox.strings.repeat("\n", breaks + 1) + ln
            if more:
                prev = 2
            else:
                prev = 1
            breaks = 0
    return out

# Başlıktan sonraki satırları (raw_lines[start:]) tüketir; (metin, tüketilen satır sayısı) yerine metni döndürür ve
# tüketilen son indeksi `consumed[0]`a yazar.
def _read_block_scalar(raw_lines: list[str], start: int, parent_indent: int, hdr: _BlockHeader, consumed: list[int]) -> str:
    block_indent: int = -1
    if hdr.explicit > 0:
        block_indent = parent_indent + hdr.explicit
    collected: list[str] = []
    j: int = start
    scanning: bool = True
    while scanning:
        if j >= len(raw_lines):
            scanning = False
        else:
            raw: str = nox.strings.trim_end(raw_lines[j])
            if raw == "":
                collected.append("")
                j = j + 1
            else:
                ind: int = _count_leading_spaces(raw)
                if block_indent < 0:
                    if ind > parent_indent:
                        block_indent = ind
                if block_indent < 0 or ind < block_indent:
                    scanning = False
                else:
                    collected.append(_substr(raw, block_indent, len(raw)))
                    j = j + 1
    # sondaki boş satırları ayır (kırpma kuralı için)
    trailing: int = 0
    while len(collected) > 0 and collected[len(collected) - 1] == "":
        collected.pop()
        trailing = trailing + 1
    # tüketilen sondaki boş satırlar tamamen blok sonundadır
    consumed[0] = j
    body: str = ""
    if hdr.style == "|":
        body = nox.strings.join(collected, "\n")
    else:
        body = _fold_block(collected)
    if len(collected) == 0:
        if hdr.chomp == "+":
            return nox.strings.repeat("\n", trailing)
        return ""
    if hdr.chomp == "-":
        return body
    if hdr.chomp == "+":
        return body + nox.strings.repeat("\n", trailing + 1)
    return body + "\n"

# Çift/tek tırnaklı ya da akış değeri satır sonunda açık kaldıysa true.
def _value_start(content: str) -> int:
    i: int = 0
    n: int = len(content)
    while i + 1 < n and content[i] == "-" and content[i + 1] == " ":
        i = i + 2
        while i < n and content[i] == " ":
            i = i + 1
    rest: str = _substr(content, i, n)
    sep: int = _find_key_sep(rest)
    if sep >= 0:
        j: int = i + sep + 1
        while j < n and content[j] == " ":
            j = j + 1
        return j
    return i

class _Open:
    def __init__(self, quote: str, depth: int) -> None:
        self.quote: str = quote
        self.depth: int = depth

def _open_state(s: str, start: int) -> _Open:
    n: int = len(s)
    # başlıklar: `&a`, `!t` önekleri atlanır
    i: int = start
    while i < n and (s[i] == "&" or s[i] == "!"):
        while i < n and s[i] != " ":
            i = i + 1
        while i < n and s[i] == " ":
            i = i + 1
    if i >= n:
        return _Open("", 0)
    first: str = s[i]
    if first == "\"":
        k: int = i + 1
        while k < n:
            if s[k] == "\\":
                k = k + 2
            elif s[k] == "\"":
                return _Open("", 0)
            else:
                k = k + 1
        return _Open("\"", 0)
    if first == "'":
        k2: int = i + 1
        while k2 < n:
            if s[k2] == "'":
                if _char_at_or_empty(s, k2 + 1, n) == "'":
                    k2 = k2 + 2
                else:
                    return _Open("", 0)
            else:
                k2 = k2 + 1
        return _Open("'", 0)
    if first == "[" or first == "{":
        depth: int = 0
        quote: str = ""
        k3: int = i
        while k3 < n:
            c: str = s[k3]
            if quote == "\"":
                if c == "\\":
                    k3 = k3 + 1
                elif c == "\"":
                    quote = ""
            elif quote == "'":
                if c == "'":
                    quote = ""
            elif (c == "\"" or c == "'") and _can_open_quote(s, k3):
                quote = c
            elif c == "[" or c == "{":
                depth = depth + 1
            elif c == "]" or c == "}":
                depth = depth - 1
            k3 = k3 + 1
        return _Open(quote, depth)
    return _Open("", 0)

def _is_open(st: _Open) -> bool:
    return st.quote != "" or st.depth > 0

# Ham metni belgelere/satırlara böler; blok skalerlerini ve çok satırlı değerleri tek satıra indirger.
def _tokenize_docs(text: str) -> list[list[_Line]]:
    raw_lines: list[str] = nox.strings.split(text, "\n")
    docs: list[list[_Line]] = []
    current: list[_Line] = []
    doc_open: bool = False
    i: int = 0
    n_lines: int = len(raw_lines)
    while i < n_lines:
        raw: str = nox.strings.trim_end(raw_lines[i])
        if nox_strings_leading_tab_raw(raw) != 0:
            raise YamlError("TAB cannot be used in YAML indentation")
        trimmed_content: str = nox.strings.trim(raw)
        if trimmed_content == "" or nox.strings.starts_with(trimmed_content, "#"):
            i = i + 1
        elif nox.strings.starts_with(raw, "%") and not doc_open and len(current) == 0:
            i = i + 1
        elif raw == "---" or nox.strings.starts_with(raw, "--- ") or nox.strings.starts_with(raw, "---\t"):
            if doc_open or len(current) > 0:
                docs.append(current)
                current = []
            doc_open = True
            rest: str = _strip_comment(nox.strings.trim(_substr(raw, 3, len(raw))))
            i = i + 1
            if rest != "":
                hdr0: _BlockHeader = _block_header(rest)
                if hdr0.found and hdr0.prefix == "":
                    consumed0: list[int] = [i]
                    body0: str = _read_block_scalar(raw_lines, i, -1, hdr0, consumed0)
                    current.append(_Line(0, "\"" + _escape_for_double_quotes(body0) + "\""))
                    i = consumed0[0]
                else:
                    current.append(_Line(0, rest))
        elif raw == "..." or nox.strings.starts_with(raw, "... "):
            if doc_open or len(current) > 0:
                docs.append(current)
            current = []
            doc_open = False
            i = i + 1
        else:
            indent: int = _count_leading_spaces(raw)
            content: str = _strip_comment(_substr(raw, indent, len(raw)))
            i = i + 1
            hdr: _BlockHeader = _block_header(content)
            if hdr.found:
                consumed: list[int] = [i]
                body: str = _read_block_scalar(raw_lines, i, indent + _parent_offset(hdr.prefix), hdr, consumed)
                i = consumed[0]
                content = hdr.prefix + "\"" + _escape_for_double_quotes(body) + "\""
            else:
                vs: int = _value_start(content)
                st: _Open = _open_state(content, vs)
                joined_blank: bool = False
                while _is_open(st):
                    if i >= n_lines:
                        raise YamlError("unterminated quoted string or flow collection")
                    nxt: str = _strip_comment(nox.strings.trim(raw_lines[i]))
                    i = i + 1
                    if st.quote == "\"" and nxt == "":
                        content = content + "\\n"
                        joined_blank = True
                    elif st.quote == "'" and nxt == "":
                        content = content + "\n"
                        joined_blank = True
                    elif joined_blank:
                        content = content + nxt
                        joined_blank = False
                    else:
                        content = content + " " + nxt
                    st = _open_state(content, vs)
            current.append(_Line(indent, content))
    if doc_open or len(current) > 0:
        docs.append(current)
    return docs

# Blok skaleri üst düğüm girintisi: `key: |` için 0, `- |` için 0, `- key: |` için "- " genişliği, `- - k: |` için ...
def _parent_offset(prefix: str) -> int:
    off: int = 0
    k: int = 0
    n: int = len(prefix)
    while k + 1 < n and prefix[k] == "-" and prefix[k + 1] == " ":
        off = off + 2
        k = k + 2
        while k < n and prefix[k] == " ":
            off = off + 1
            k = k + 1
    # `- |` : yalnızca tire öneki → üst düğüm tirenin kendi girintisi (0 ek)
    if k >= n:
        return 0
    return off

# ---- skalerler ----

def _hex_digit_value(c: str) -> int:
    b: int = nox.strings.byte_at(c, 0)
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 97 and b <= 102:
        return b - 97 + 10
    if b >= 65 and b <= 70:
        return b - 65 + 10
    return -1

def _hex_run(s: str, start: int, count: int, n: int) -> int:
    if start + count > n:
        raise YamlError("incomplete escape sequence")
    v: int = 0
    k: int = 0
    while k < count:
        d: int = _hex_digit_value(s[start + k])
        if d < 0:
            raise YamlError("invalid hex digit in an escape sequence")
        v = v * 16 + d
        k = k + 1
    return v

def _parse_double_quoted(s: str) -> str:
    inner: str = _substr(s, 1, len(s) - 1)
    result: str = ""
    i: int = 0
    n: int = len(inner)
    while i < n:
        c: str = inner[i]
        if c == "\\":
            nxt: str = _char_at_or_empty(inner, i + 1, n)
            i = i + 2
            if nxt == "n":
                result = result + "\n"
            elif nxt == "t":
                result = result + "\t"
            elif nxt == "r":
                result = result + chr(13)
            elif nxt == "0":
                result = result + chr(0)
            elif nxt == "a":
                result = result + chr(7)
            elif nxt == "b":
                result = result + chr(8)
            elif nxt == "e":
                result = result + chr(27)
            elif nxt == "f":
                result = result + chr(12)
            elif nxt == "v":
                result = result + chr(11)
            elif nxt == "x":
                result = result + chr(_hex_run(inner, i, 2, n))
                i = i + 2
            elif nxt == "u":
                result = result + chr(_hex_run(inner, i, 4, n))
                i = i + 4
            elif nxt == "U":
                result = result + chr(_hex_run(inner, i, 8, n))
                i = i + 8
            elif nxt == "N":
                result = result + chr(133)
            elif nxt == "_":
                result = result + chr(160)
            else:
                result = result + nxt
        else:
            result = result + c
            i = i + 1
    return result

def _parse_single_quoted(s: str) -> str:
    inner: str = _substr(s, 1, len(s) - 1)
    result: str = ""
    i: int = 0
    n: int = len(inner)
    while i < n:
        c: str = inner[i]
        if c == "'":
            nxt: str = _char_at_or_empty(inner, i + 1, n)
            if nxt == "'":
                result = result + "'"
                i = i + 2
            else:
                result = result + c
                i = i + 1
        else:
            result = result + c
            i = i + 1
    return result

def _strip_quotes_if_present(s: str) -> str:
    # `s[0] == X and nox.strings.ends_with(...)` tek bir `and`da birleştirilmez (eski QBE phi hatası) → iç içe if.
    if len(s) >= 2:
        if s[0] == "\"":
            if nox.strings.ends_with(s, "\""):
                return _parse_double_quoted(s)
        if s[0] == "'":
            if nox.strings.ends_with(s, "'"):
                return _parse_single_quoted(s)
    return s

def _is_int_text(s: str) -> bool:
    n: int = len(s)
    if n == 0:
        return False
    start: int = 0
    if s[0] == "-" or s[0] == "+":
        start = 1
    if start >= n:
        return False
    i: int = start
    while i < n:
        if not _is_digit_char(s[i]):
            return False
        i = i + 1
    return True

def _is_radix_text(s: str, prefix: str, base: int) -> bool:
    if len(s) <= 2 or not nox.strings.starts_with(s, prefix):
        return False
    i: int = 2
    while i < len(s):
        d: int = _hex_digit_value(s[i])
        if d < 0 or d >= base:
            return False
        i = i + 1
    return True

def _radix_value(s: str, base: int) -> int:
    v: int = 0
    i: int = 2
    while i < len(s):
        v = v * base + _hex_digit_value(s[i])
        i = i + 1
    return v

def _is_float_text(s: str) -> bool:
    n: int = len(s)
    i: int = 0
    if n == 0:
        return False
    if s[0] == "-" or s[0] == "+":
        i = 1
    int_digits: int = 0
    while i < n and _is_digit_char(s[i]):
        i = i + 1
        int_digits = int_digits + 1
    frac_digits: int = 0
    if i < n and s[i] == ".":
        i = i + 1
        while i < n and _is_digit_char(s[i]):
            i = i + 1
            frac_digits = frac_digits + 1
    if int_digits == 0 and frac_digits == 0:
        return False
    if i < n and (s[i] == "e" or s[i] == "E"):
        i = i + 1
        if i < n and (s[i] == "-" or s[i] == "+"):
            i = i + 1
        exp_digits: int = 0
        while i < n and _is_digit_char(s[i]):
            i = i + 1
            exp_digits = exp_digits + 1
        if exp_digits == 0:
            return False
    return i == n

def _parse_plain_scalar(s: str) -> YamlValue:
    if s == "null" or s == "Null" or s == "NULL" or s == "~" or s == "":
        return _make_null()
    if s == "true" or s == "True" or s == "TRUE":
        return _make_bool(True)
    if s == "false" or s == "False" or s == "FALSE":
        return _make_bool(False)
    if s == ".inf" or s == ".Inf" or s == ".INF" or s == "+.inf" or s == "+.Inf" or s == "+.INF":
        return _make_float(float("inf"))
    if s == "-.inf" or s == "-.Inf" or s == "-.INF":
        return _make_float(float("-inf"))
    if s == ".nan" or s == ".NaN" or s == ".NAN":
        return _make_float(float("nan"))
    if _is_int_text(s):
        try:
            return _make_int(int(s))
        except ValueError as e:
            return _make_float(float(s))
    if _is_radix_text(s, "0x", 16):
        return _make_int(_radix_value(s, 16))
    if _is_radix_text(s, "0o", 8):
        return _make_int(_radix_value(s, 8))
    if _is_float_text(s):
        try:
            return _make_float(float(s))
        except ValueError as e:
            pass
    return _make_string(s)

# ---- çapalar, etiketler ----

def _take_props(raw: str) -> _Props:
    anchor: str = ""
    tag: str = ""
    rest: str = nox.strings.trim(raw)
    scanning: bool = True
    while scanning:
        if len(rest) > 0 and rest[0] == "&":
            sp: int = nox.strings.index_of(rest, " ")
            if sp < 0:
                anchor = _substr(rest, 1, len(rest))
                rest = ""
            else:
                anchor = _substr(rest, 1, sp)
                rest = nox.strings.trim_start(_substr(rest, sp, len(rest)))
        elif len(rest) > 0 and rest[0] == "!":
            sp2: int = nox.strings.index_of(rest, " ")
            if sp2 < 0:
                tag = _substr(rest, 0, len(rest))
                rest = ""
            else:
                tag = _substr(rest, 0, sp2)
                rest = nox.strings.trim_start(_substr(rest, sp2, len(rest)))
        else:
            scanning = False
    return _Props(anchor, tag, rest)

def _apply_tag(tag: str, v: YamlValue, was_quoted: bool, raw_text: str) -> YamlValue:
    if tag == "!!str":
        if v.kind == 0:
            return v
        return _make_string(raw_text)
    if tag == "!!int":
        if v.kind == 1:
            return v
        raise YamlError("cannot convert to !!int: " + raw_text)
    if tag == "!!float":
        if v.kind == 2:
            return v
        if v.kind == 1:
            return _make_float(float(v.i))
        raise YamlError("cannot convert to !!float: " + raw_text)
    if tag == "!!bool":
        if v.kind == 3:
            return v
        raise YamlError("cannot convert to !!bool: " + raw_text)
    if tag == "!!null":
        return _make_null()
    return v

def _register_anchor(ctx: _Ctx, anchor: str, v: YamlValue) -> None:
    if anchor != "":
        ctx.anchors[anchor] = v

def _lookup_alias(ctx: _Ctx, name: str) -> YamlValue:
    if not ctx.anchors.contains(name):
        raise YamlError("unknown alias: *" + name)
    return ctx.anchors[name]

# ---- akış koleksiyonları ----

def _split_flow_items(inner: str) -> list[str]:
    if nox.strings.trim(inner) == "":
        return []
    parts: list[str] = []
    current: str = ""
    depth: int = 0
    in_single: bool = False
    in_double: bool = False
    i: int = 0
    n: int = len(inner)
    while i < n:
        c: str = inner[i]
        if in_double:
            current = current + c
            if c == "\\":
                nxt: str = _char_at_or_empty(inner, i + 1, n)
                current = current + nxt
                i = i + 1
            elif c == "\"":
                in_double = False
        elif in_single:
            current = current + c
            if c == "'":
                in_single = False
        elif c == "\"" and _can_open_quote(inner, i):
            in_double = True
            current = current + c
        elif c == "'" and _can_open_quote(inner, i):
            in_single = True
            current = current + c
        elif c == "[" or c == "{":
            depth = depth + 1
            current = current + c
        elif c == "]" or c == "}":
            depth = depth - 1
            current = current + c
        elif c == "," and depth == 0:
            parts.append(nox.strings.trim(current))
            current = ""
        else:
            current = current + c
        i = i + 1
    last: str = nox.strings.trim(current)
    if last != "":
        parts.append(last)
    return parts

def _merge_into(target: YamlValue, source: YamlValue) -> None:
    for k in source.mapping.keys():
        if not target.mapping.contains(k):
            target.mapping[k] = source.mapping[k]

# `<<` değeri: bir eşleme ya da eşlemeler dizisi.
def _apply_merge(target: YamlValue, merged: YamlValue) -> None:
    if merged.kind == 6:
        _merge_into(target, merged)
    elif merged.kind == 5:
        for m in merged.arr:
            if m.kind != 6:
                raise YamlError("a merge key '<<' needs mappings")
            _merge_into(target, m)
    else:
        raise YamlError("a merge key '<<' needs a mapping or a sequence of mappings")

def _parse_flow_sequence(s: str, ctx: _Ctx) -> YamlValue:
    if not nox.strings.ends_with(s, "]"):
        raise YamlError("invalid flow sequence (missing ']'): " + s)
    inner: str = _substr(s, 1, len(s) - 1)
    parts: list[str] = _split_flow_items(inner)
    items: list[YamlValue] = []
    i: int = 0
    while i < len(parts):
        part: str = parts[i]
        sep: int = _find_key_sep(part)
        if sep >= 0:
            # `[a: 1]` → tek çiftli eşleme
            single: YamlValue = _make_mapping()
            single.mapping[_strip_quotes_if_present(nox.strings.trim(_substr(part, 0, sep)))] = _parse_scalar_or_flow(nox.strings.trim(_substr(part, sep + 1, len(part))), ctx)
            items.append(single)
        else:
            items.append(_parse_scalar_or_flow(part, ctx))
        i = i + 1
    return _make_sequence(items)

def _parse_flow_mapping(s: str, ctx: _Ctx) -> YamlValue:
    if not nox.strings.ends_with(s, "}"):
        raise YamlError("invalid flow mapping (missing '}'): " + s)
    inner: str = _substr(s, 1, len(s) - 1)
    parts: list[str] = _split_flow_items(inner)
    result: YamlValue = _make_mapping()
    i: int = 0
    while i < len(parts):
        part: str = parts[i]
        sep_idx: int = _find_key_sep(part)
        key: str = ""
        val_raw: str = ""
        if sep_idx >= 0:
            key = _strip_quotes_if_present(nox.strings.trim(_substr(part, 0, sep_idx)))
            val_raw = nox.strings.trim(_substr(part, sep_idx + 1, len(part)))
        elif _find_flow_colon(part) >= 0:
            fc: int = _find_flow_colon(part)
            key = _strip_quotes_if_present(nox.strings.trim(_substr(part, 0, fc)))
            val_raw = nox.strings.trim(_substr(part, fc + 1, len(part)))
        else:
            key = _strip_quotes_if_present(part)
            val_raw = ""
        v: YamlValue = _parse_scalar_or_flow(val_raw, ctx)
        if key == "<<":
            _apply_merge(result, v)
        else:
            result.mapping[key] = v
        i = i + 1
    return result

# Akış eşlemesinde `"key":value` (boşluksuz) biçimi için: tırnaklı anahtardan hemen sonra gelen `:`.
def _find_flow_colon(part: str) -> int:
    n: int = len(part)
    if n < 3:
        return -1
    if part[0] == "\"":
        i: int = 1
        while i < n and part[i] != "\"":
            if part[i] == "\\":
                i = i + 1
            i = i + 1
        if i + 1 < n and part[i + 1] == ":":
            return i + 1
    return -1

def _parse_scalar_or_flow(raw: str, ctx: _Ctx) -> YamlValue:
    props: _Props = _take_props(raw)
    trimmed: str = props.rest
    value: YamlValue = _make_null()
    quoted: bool = False
    text_form: str = trimmed
    if trimmed == "":
        value = _make_null()
    else:
        first: str = _char_at_or_empty(trimmed, 0, len(trimmed))
        if first == "*":
            if props.anchor != "" or props.tag != "":
                raise YamlError("an alias cannot have an anchor or tag: " + raw)
            return _lookup_alias(ctx, _substr(trimmed, 1, len(trimmed)))
        if first == "[":
            value = _parse_flow_sequence(trimmed, ctx)
        elif first == "{":
            value = _parse_flow_mapping(trimmed, ctx)
        elif first == "\"":
            if not nox.strings.ends_with(trimmed, "\"") or len(trimmed) < 2:
                raise YamlError("unterminated double-quoted string: " + trimmed)
            text_form = _parse_double_quoted(trimmed)
            value = _make_string(text_form)
            quoted = True
        elif first == "'":
            if not nox.strings.ends_with(trimmed, "'") or len(trimmed) < 2:
                raise YamlError("unterminated single-quoted string: " + trimmed)
            text_form = _parse_single_quoted(trimmed)
            value = _make_string(text_form)
            quoted = True
        else:
            value = _parse_plain_scalar(trimmed)
    value = _apply_tag(props.tag, value, quoted, text_form)
    _register_anchor(ctx, props.anchor, value)
    return value

# ---- blok yapı ----

def _has_deeper_next_line(lines: list[_Line], pos: list[int], indent: int) -> bool:
    if pos[0] >= len(lines):
        return False
    return lines[pos[0]].indent > indent

def _parse_block(lines: list[_Line], pos: list[int], indent: int, ctx: _Ctx) -> YamlValue:
    if pos[0] >= len(lines):
        return _make_null()
    line: _Line = lines[pos[0]]
    if _is_sequence_line(line.content):
        return _parse_sequence(lines, pos, indent, ctx)
    if _is_mapping_line(line.content):
        return _parse_mapping(lines, pos, indent, ctx)
    # tek (çok satırlı) düz skaler blok
    text: str = line.content
    pos[0] = pos[0] + 1
    text = _fold_plain_continuation(lines, pos, indent - 1, text)
    return _parse_scalar_or_flow(text, ctx)

def _is_plain_text(raw: str) -> bool:
    t: str = nox.strings.trim(raw)
    if t == "":
        return False
    c: str = t[0]
    return c != "\"" and c != "'" and c != "[" and c != "{" and c != "&" and c != "*" and c != "!" and c != "|" and c != ">"

# Düz skalerin sonraki daha girintili satırlara devamı (satır katlama); bir anahtar/dizi satırı görünce hata.
def _fold_plain_continuation(lines: list[_Line], pos: list[int], indent: int, first: str) -> str:
    text: str = first
    if not _is_plain_text(first):
        return text
    scanning: bool = True
    while scanning:
        if not _has_deeper_next_line(lines, pos, indent):
            scanning = False
        else:
            nxt: _Line = lines[pos[0]]
            if _is_mapping_line(nxt.content):
                raise YamlError("mapping values are not allowed here: " + nxt.content)
            text = text + " " + nxt.content
            pos[0] = pos[0] + 1
    return text

def _parse_mapping(lines: list[_Line], pos: list[int], indent: int, ctx: _Ctx) -> YamlValue:
    result: YamlValue = _make_mapping()
    scanning: bool = True
    while scanning:
        if pos[0] >= len(lines):
            scanning = False
        elif lines[pos[0]].indent != indent:
            scanning = False
        elif _is_sequence_line(lines[pos[0]].content):
            scanning = False
        else:
            line: _Line = lines[pos[0]]
            if nox.strings.starts_with(line.content, "? "):
                raise YamlError("explicit keys ('? key') are not supported")
            sep_idx: int = _find_key_sep(line.content)
            if sep_idx < 0:
                raise YamlError("invalid mapping line: " + line.content)
            key: str = _strip_quotes_if_present(nox.strings.trim(_substr(line.content, 0, sep_idx)))
            raw_value: str = nox.strings.trim(_substr(line.content, sep_idx + 1, len(line.content)))
            pos[0] = pos[0] + 1
            value: YamlValue = _parse_block_value(lines, pos, indent, raw_value, ctx, True)
            if key == "<<":
                _apply_merge(result, value)
            else:
                result.mapping[key] = value
    return result

# `anahtar:` / `- ` sonrası değer: satır içi değer ya da (boşsa) daha girintili blok; `&çapa`/`!etiket` önekleri burada çözülür.
def _parse_block_value(lines: list[_Line], pos: list[int], indent: int, raw_value: str, ctx: _Ctx, same_indent_seq: bool) -> YamlValue:
    props: _Props = _take_props(raw_value)
    if props.rest == "":
        value: YamlValue = _make_null()
        if _has_deeper_next_line(lines, pos, indent):
            value = _parse_block(lines, pos, lines[pos[0]].indent, ctx)
        elif same_indent_seq and _same_indent_sequence_follows(lines, pos, indent):
            value = _parse_sequence(lines, pos, indent, ctx)
        value = _apply_tag(props.tag, value, False, "")
        _register_anchor(ctx, props.anchor, value)
        return value
    text: str = raw_value
    if _is_plain_text(props.rest):
        text = _fold_plain_continuation(lines, pos, indent, raw_value)
    return _parse_scalar_or_flow(text, ctx)

# `key:` ardından AYNI girintide `- x` dizisi (YAML'ın yaygın biçimi).
def _same_indent_sequence_follows(lines: list[_Line], pos: list[int], indent: int) -> bool:
    if pos[0] >= len(lines):
        return False
    nxt: _Line = lines[pos[0]]
    return nxt.indent == indent and _is_sequence_line(nxt.content)

def _parse_sequence(lines: list[_Line], pos: list[int], indent: int, ctx: _Ctx) -> YamlValue:
    items: list[YamlValue] = []
    scanning: bool = True
    while scanning:
        if pos[0] >= len(lines):
            scanning = False
        elif lines[pos[0]].indent != indent:
            scanning = False
        elif not _is_sequence_line(lines[pos[0]].content):
            scanning = False
        else:
            line: _Line = lines[pos[0]]
            after_dash: str = nox.strings.trim_start(_substr(line.content, 1, len(line.content)))
            item_indent: int = indent + (len(line.content) - len(after_dash))
            props: _Props = _take_props(after_dash)
            if after_dash == "":
                pos[0] = pos[0] + 1
                items.append(_parse_block_value(lines, pos, indent, "", ctx, False))
            elif _is_sequence_line(props.rest) and props.rest != "":
                # iç içe dizi: `- - a`
                lines[pos[0]] = _Line(item_indent + (len(after_dash) - len(props.rest)), props.rest)
                nested: YamlValue = _parse_sequence(lines, pos, lines[pos[0]].indent, ctx)
                nested = _apply_tag(props.tag, nested, False, "")
                _register_anchor(ctx, props.anchor, nested)
                items.append(nested)
            elif _is_mapping_line(props.rest) and not nox.strings.starts_with(props.rest, "*"):
                map_indent: int = item_indent + (len(after_dash) - len(props.rest))
                lines[pos[0]] = _Line(map_indent, props.rest)
                m: YamlValue = _parse_mapping(lines, pos, map_indent, ctx)
                m = _apply_tag(props.tag, m, False, "")
                _register_anchor(ctx, props.anchor, m)
                items.append(m)
            else:
                pos[0] = pos[0] + 1
                items.append(_parse_block_value(lines, pos, indent, after_dash, ctx, False))
    return _make_sequence(items)

def _parse_doc(lines: list[_Line]) -> YamlValue:
    if len(lines) == 0:
        return _make_null()
    ctx: _Ctx = _Ctx()
    pos: list[int] = [0]
    first: _Line = lines[0]
    value: YamlValue = _parse_block(lines, pos, first.indent, ctx)
    if pos[0] != len(lines):
        raise YamlError("unexpected or badly indented line: " + lines[pos[0]].content)
    return value

# Tek belge. Birden fazla belge varsa `YamlError` (hepsi için `parse_all`).
def parse(text: str) -> YamlValue:
    docs: list[list[_Line]] = _tokenize_docs(text)
    if len(docs) == 0:
        return _make_null()
    if len(docs) > 1:
        raise YamlError("multiple YAML documents: use parse_all")
    return _parse_doc(docs[0])

# `---` ile ayrılmış tüm belgeler.
def parse_all(text: str) -> list[YamlValue]:
    docs: list[list[_Line]] = _tokenize_docs(text)
    out: list[YamlValue] = []
    for d in docs:
        out.append(_parse_doc(d))
    return out

# "a.b.c" gibi noktalı yol; eşleme anahtarları ve dizi indeksleri (`servers.0.name`) üzerinden yürür.
def get(root: YamlValue, dotted_path: str) -> YamlValue:
    parts: list[str] = nox.strings.split(dotted_path, ".")
    current: YamlValue = root
    i: int = 0
    while i < len(parts):
        key: str = parts[i]
        if current.kind == 6 and current.mapping.contains(key):
            current = current.mapping[key]
        elif current.kind == 5 and _is_all_digits(key) and int(key) < len(current.arr):
            current = current.arr[int(key)]
        else:
            raise YamlError("path not found: " + dotted_path)
        i = i + 1
    return current

# ---- yazma ----

def _yaml_dump_escape(s: str) -> str:
    out: str = "\""
    i: int = 0
    n: int = len(s)
    while i < n:
        c: str = s[i]
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif c == "\n":
            out = out + "\\n"
        elif c == "\t":
            out = out + "\\t"
        elif nox.strings.byte_at(s, i) == 13:
            out = out + "\\r"
        else:
            out = out + c
        i = i + 1
    return out + "\""

def _yaml_dump_scalar(v: YamlValue) -> str:
    if is_null(v):
        return "null"
    if is_bool(v):
        if v.b:
            return "true"
        return "false"
    if is_int(v):
        return str(v.i)
    if is_float(v):
        s: str = str(v.f)
        if s == "inf":
            return ".inf"
        if s == "-inf":
            return "-.inf"
        if s == "nan":
            return ".nan"
        return s
    if is_string(v):
        return _yaml_dump_escape(v.s)
    raise YamlError("a sequence/mapping cannot be dumped in a scalar context")

def _yaml_indent(level: int) -> str:
    return nox.strings.repeat("  ", level)

# Anahtar: yalnızca güvenli düz karakterlerse olduğu gibi, değilse çift tırnaklı.
def _yaml_dump_key(k: str) -> str:
    if k == "":
        return "\"\""
    for c in k:
        b: int = nox.strings.byte_at(c, 0)
        ok: bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 45 or b == 46 or b >= 128
        if not ok:
            return _yaml_dump_escape(k)
    if _parse_plain_scalar(k).kind != 0:
        return _yaml_dump_escape(k)
    return k

def _yaml_dump_mapping(v: YamlValue, level: int) -> list[str]:
    lines: list[str] = []
    base: str = _yaml_indent(level)
    keys: list[str] = v.mapping.keys()
    i: int = 0
    n: int = len(keys)
    while i < n:
        k: str = _yaml_dump_key(keys[i])
        val: YamlValue = v.mapping[keys[i]]
        if is_mapping(val):
            child: list[str] = _yaml_dump_mapping(val, level + 1)
            if len(child) == 0:
                lines.append(base + k + ": {}")
            else:
                lines.append(base + k + ":")
                j: int = 0
                while j < len(child):
                    lines.append(child[j])
                    j = j + 1
        elif is_sequence(val):
            child2: list[str] = _yaml_dump_sequence(val, level + 1)
            if len(child2) == 0:
                lines.append(base + k + ": []")
            else:
                lines.append(base + k + ":")
                m: int = 0
                while m < len(child2):
                    lines.append(child2[m])
                    m = m + 1
        else:
            lines.append(base + k + ": " + _yaml_dump_scalar(val))
        i = i + 1
    return lines

def _yaml_dump_sequence(v: YamlValue, level: int) -> list[str]:
    lines: list[str] = []
    base: str = _yaml_indent(level)
    i: int = 0
    n: int = len(v.arr)
    while i < n:
        item: YamlValue = v.arr[i]
        if is_mapping(item):
            child: list[str] = _yaml_dump_mapping(item, level)
            if len(child) == 0:
                lines.append(base + "- {}")
            else:
                first: str = nox.strings.trim_start(child[0])
                lines.append(base + "- " + first)
                j: int = 1
                while j < len(child):
                    lines.append("  " + child[j])
                    j = j + 1
        elif is_sequence(item):
            child2: list[str] = _yaml_dump_sequence(item, level)
            if len(child2) == 0:
                lines.append(base + "- []")
            else:
                first2: str = nox.strings.trim_start(child2[0])
                lines.append(base + "- " + first2)
                k: int = 1
                while k < len(child2):
                    lines.append("  " + child2[k])
                    k = k + 1
        else:
            lines.append(base + "- " + _yaml_dump_scalar(item))
        i = i + 1
    return lines

# Kök bir eşleme ya da dizi (ya da skaler) YAML metnine çevrilir; `parse(dump(v))` değerce eşittir.
def dump(v: YamlValue) -> str:
    if is_mapping(v):
        lines: list[str] = _yaml_dump_mapping(v, 0)
        if len(lines) == 0:
            return "{}\n"
        return nox.strings.join(lines, "\n") + "\n"
    if is_sequence(v):
        lines2: list[str] = _yaml_dump_sequence(v, 0)
        if len(lines2) == 0:
            return "[]\n"
        return nox.strings.join(lines2, "\n") + "\n"
    return _yaml_dump_scalar(v) + "\n"

# Birden çok belgeyi `---` ile ayırarak yazar.
def dump_all(docs: list[YamlValue]) -> str:
    out: str = ""
    for d in docs:
        out = out + "---\n" + dump(d)
    return out

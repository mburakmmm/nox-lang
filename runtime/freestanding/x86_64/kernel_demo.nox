# Faz F.4 (bkz. plan dosyası "Gerçek bare-metal boot zinciri (x86_64)"):
# GERÇEK QEMU'da çalıştırılan demo çekirdek — `tests/golden/kernel_boot_
# x86_64_test.zig`nin `--profile freestanding` (x86_64 kernel-arch) ile
# derlediği TEK kaynak dosya. `nox_kernel_phys_base`/`_limit`/`_trigger_
# breakpoint`, `runtime/freestanding/x86_64/kernel.zig`nin (boot.S ile
# BİRLİKTE `noxrt-freestanding-x86_64.o`ya derlenir) dışa açtığı yardımcılardır.
#
# v3 sertleştirme yol haritası, madde 5 (bkz. nox-teknik-spesifikasyon.md
# ilgili bölüm) — `nox.arch.x86_64`nin (YENİ port G/Ç stdlib modülü)
# `ARCH_X86_64_OK` checkpoint'i İçİn import edilir. Bu modülün KENDİ
# `extern def`leri `noxrt-freestanding-generic-x86_64.o`yu ADRESLER, AMA
# o dosyanın KÖK Zig dosyası (`runtime/lib_freestanding.zig`) BURADAKİ
# `noxrt-freestanding-x86_64.o`nun (kernel.zig'in KÖK dosyası, `lib_
# freestanding_kernel.zig`, `lib_freestanding.zig`yi de force-ref EDER)
# İÇİNE de DERLENDİĞİNDEN, GERÇEK sembol ZATEN mevcuttur — bu dosyanın
# KENDİ manuel `zig cc` link satırı (`tests/golden/kernel_boot_x86_64_
# test.zig`) SADECE `noxrt-freestanding-x86_64.o`yu geçirir, BAŞKA bir
# nesne dosyası GEREKMEZ.
import nox.arch.x86_64

extern def nox_kernel_phys_base() -> int from "zig-out/lib/noxrt-freestanding-x86_64.o"
extern def nox_kernel_phys_limit() -> int from "zig-out/lib/noxrt-freestanding-x86_64.o"
extern def nox_kernel_trigger_breakpoint() -> None from "zig-out/lib/noxrt-freestanding-x86_64.o"

# v2.0 madde 9 (bkz. plan dosyası "Freestanding Allocator ABI"): AŞAĞIDAKİ
# 4 fonksiyon ÖNCEDEN SAF Nox'ta (`lowlevel:`+`ptr_*` ÜZERİNDEN, "kontrol
# sayfası" hilesiyle durum tutarak) yazılıydı — AMA bu gövdelerin DERLENMİŞ
# hali `nox_arena_create(rt)`/`nox_arena_destroy(rt)` ÇAĞIRIYOR (BU turda
# GERÇEK assembly OKUNARAK bulundu), yani GEÇERLİ bir `rt` OLMADAN ÇÖKER —
# TAM DA `rt`yi BOOTSTRAP ETMEK İçİn bunlardan bellek almak İSTEDİĞİMİZ
# İçİn bir tavuk-yumurta sorunu. Bu YÜZDEN İMZALARI/DAVRANIŞLARI/checkpoint
# etkileşimleri DEĞİŞMEDEN, İÇ implementasyonları `runtime/freestanding/
# x86_64/kernel.zig`nin `rt`-BAĞIMSIZ, GERÇEK serbest-listesine delege eden
# İNCE `extern def` sarmalayıcılarına ÇEVRİLDİ — `nox_allocator_install`
# ABI'sinin (aynı Zig dosyası) KULLANDIĞI AYNI havuz, bu YÜZDEN aşağıdaki
# `SHARED_POOL_OK` checkpoint'i managed heap'in GERÇEKTEN AYNI fiziksel
# sayfa havuzundan beslendiğini kanıtlayabilir.
extern def nox_page_init() -> int from "zig-out/lib/noxrt-freestanding-x86_64.o"
extern def nox_alloc_page() -> int from "zig-out/lib/noxrt-freestanding-x86_64.o"
extern def nox_free_page(addr: int) -> None from "zig-out/lib/noxrt-freestanding-x86_64.o"
extern def nox_free_pages() -> int from "zig-out/lib/noxrt-freestanding-x86_64.o"

def page_init() -> int:
    return nox_page_init()

def alloc_page() -> int:
    return nox_alloc_page()

def free_page(addr: int) -> None:
    nox_free_page(addr)

def free_pages() -> int:
    return nox_free_pages()

# --- Demo çekirdek: EN GÜVENLİ sıra (bkz. plan dosyasının madde 7'si) ---

print("Hello Nox")

nox_kernel_trigger_breakpoint()
print("IDT_OK")

total: int = page_init()
p1: int = alloc_page()
p2: int = alloc_page()
free_page(p1)
p3: int = alloc_page()
if p1 != 0 and p2 != 0 and p1 != p2 and p3 == p1:
    print("PAGE_ALLOC_OK")

xs: list[int] = [1, 2, 3]
xs.append(4)
print("HEAP_OK")

# v2.0 madde 9: managed heap'in (`list[int]`/ARC/RuntimeState'in KENDİSİ)
# GERÇEKTEN `page_init`/`alloc_page`in (YUKARIDAKİ `PAGE_ALLOC_OK`) AYNI
# fiziksel sayfa havuzundan beslendiğinin KANITI. `total` (`page_init()`nin
# döndürdüğü, HİÇ değişmeyen TOPLAM sayfa sayısı) İLE `free_pages()`i
# (ŞU AN müsait sayfa sayısı) karşılaştırmak — `nox_allocator_install`
# İLE kurulan kernel bump allocator'ın, Nox'un KENDİ `RuntimeState`sini
# bootstrap ETMEK İçİn `main`e atlanmadan HEMEN ÖNCE (BU turda GERÇEK bir
# QEMU çalıştırmasıyla, `DBG_ALLOC_PAGE` teşhis çıktısıyla DOĞRULANDI) EN
# AZINDAN BİR sayfayı ZATEN tükettiğinin dolaylı AMA KESİN kanıtı — bağlantı
# KOPUK olsaydı (eski, AYRI 4 MiB FBA'ya geri düşülseydi) `free_pages()`
# HİÇBİR ZAMAN `total`dan KÜÇÜK OLMAZDI (bu turda gerçekten ölçülerek
# doğrulandı — kararlı/tekrarlanabilir bir sinyal, `list[T]`nin İç
# tahsis boyutlarına BAĞIMLI DEĞİL).
if free_pages() < total:
    print("SHARED_POOL_OK")

# GERÇEK bir regresyon düzeltmesinin kalıcı kanıtı (bkz. nox-teknik-
# spesifikasyon.md §3.198): `nox_allocator_install` İLE enjekte edilen,
# SIKI PAKETLEYEN bir bump allocator ALTINDA, ART ARDA İKİ tek-karakterli
# `str` indekslemesi (`s[0]` sonrası `s[1]`) GERÇEK bir #UD (invalid
# opcode) çökmesine yol AÇIYORDU — `nox_alloc`/`nox_arena_alloc`nin
# `.alloc(u8, ...)` çağrısı `u8`nin DOĞAL (1 bayt) hizalamasını İSTEDİĞİ,
# AMA `nox_rc_alloc`nin `i64` ARC başlığının 8-bayt hizalama VARSAYDIĞI
# İçİn — sıkı-paketleyen BİR allocator'da (page_allocator/smp_allocator
# GİBİ diğerlerinin AKSİNE) BU varsayım BOZULUYORDU. Düzeltildi (`asap.
# nox_alloc_alignment`).
s: str = "ab"
if s[0] == "a" and s[1] == "b":
    print("STR_REPEAT_INDEX_OK")

# v3 sertleştirme yol haritası, madde 4 (bkz. nox-teknik-spesifikasyon.md
# ilgili bölüm) — "freestanding v0.1 dondurma": v3 madde 2'nin (bitwise
# operatörler) BİRAZ ÖNCE eklendiği göz önüne alındığında, bunların
# `--profile freestanding` altında da (hosted'daki AYNI codegen yolları
# GERÇEKTEN kullanılıyor mu, YOKSA freestanding'e ÖZGÜ bir dallanma
# eksik mi?) doğru çalıştığı GERÇEK QEMU'da KANITLANMALI — TAM DA bu
# operatörlerin asıl hedeflendiği alan (sayfa tablosu bayrakları/port-I/O
# maskeleri GİBİ) freestanding/kernel kodu olduğundan. `x=42, y=12` (küçük,
# elle doğrulanabilir sabitler — Nox'ta `0b`/`0x` literal ÖNEKİ YOK).
x: int = 42
y: int = 12
if (x & y) == 8 and (x | y) == 46 and (x ^ y) == 38 and (x << 2) == 168 and (x >> 1) == 21 and (~x) == -43:
    print("BITWISE_OK")

# v3 sertleştirme yol haritası, madde 5 — `nox.arch.x86_64`nin GERÇEK
# QEMU'da (bkz. AGENTS.md İlke #7, "ölç, varsayma" kültürü) çalıştığının
# kanıtı: CMOS RTC "saniye" yazmacının (port 0x70=112 İndeks, 0x71=113
# VERİ — HER x86 PC'de standart, q35 dahil) GÜVENLİ, YAN ETKİSİZ okunuşu
# — RTC erişimi sırasında kesmelerin `disable_interrupts`/`enable_
# interrupts` İLE çevrelenmesi de GERÇEK OSDev pratiğidir (registerın
# YARIM güncellenmiş HALDE okunmasını önler). Değer HER ZAMAN geçerli BCD
# olmalı (0-89 ONALIK aralığında = 0x00-0x59, alt nibble <= 9) — bu,
# `outb`/`inb`in DOĞRU çalıştığının dolaylı AMA KESİN kanıtıdır (yanlış
# çalışsaydı port 0x71 anlamsız/tutarsız bir bayt dönerdi). Port 0x300
# (768) BİLİNÇLİ OLARAK KULLANILMAYAN bir ISA G/Ç portu — donanımsız bir
# porttan okuma x86'da (GERÇEK donanım VE QEMU'da) HER ZAMAN 0xFF (255)
# döner, bu YÜZDEN `inl`/`inw`in aksine EN BASİT/EN DETERMİNİSTİK `inb`
# doğrulaması.
nox.arch.x86_64.disable_interrupts()
nox.arch.x86_64.outb(112, 0)
seconds_bcd: int = nox.arch.x86_64.inb(113)
nox.arch.x86_64.enable_interrupts()
unused_port_value: int = nox.arch.x86_64.inb(768)
if seconds_bcd >= 0 and seconds_bcd <= 89 and (seconds_bcd & 15) <= 9 and unused_port_value == 255:
    print("ARCH_X86_64_OK")

print("ALL_CHECKPOINTS_OK")

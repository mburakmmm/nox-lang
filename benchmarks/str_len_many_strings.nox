def build_strings(count: int) -> list[str]:
    out: list[str] = []
    i: int = 0
    while i < count:
        out.append("the quick brown fox jumps over the lazy dog " + str(i))
        i = i + 1
    return out

def sum_lengths(strs: list[str], reps: int) -> int:
    total: int = 0
    r: int = 0
    while r < reps:
        i: int = 0
        while i < len(strs):
            total = total + len(strs[i])
            i = i + 1
        r = r + 1
    return total

strs: list[str] = build_strings(500)
print(sum_lengths(strs, 20000))

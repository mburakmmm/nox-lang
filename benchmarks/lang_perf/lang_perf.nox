# Dil çekirdeği kıyas paketi (TODO 3.5.1): her satır "ad<TAB>ms<TAB>sağlama". lang_perf.py ve lang_perf.c AYNI işi yapar ve AYNI sağlama toplamlarını üretmelidir.
# Çalıştır: benchmarks/lang_perf/run.py  (ReleaseFast runtime ile ölç: `zig build -Doptimize=ReleaseFast`; düz `zig build` Debug runtime'dır ve ~100x yavaştır.)
import nox.os
import nox.time

def scale() -> int:
    if nox.os.arg_count() > 1:
        return int(nox.os.arg(1))
    return 1

def now_ms() -> float:
    return float(nox.time.monotonic_ns()) / 1000000.0

def report(name: str, t0: float, check: int) -> None:
    print(name + "\t" + str(now_ms() - t0) + "\t" + str(check))

def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

class Counter:
    total: int

    def __init__(self) -> None:
        self.total = 0

    def add(self, x: int) -> None:
        self.total = (self.total * 31 + x) % 1000000007

    def get(self) -> int:
        return self.total

class Shape:
    def area(self) -> int:
        return 0

class Sq(Shape):
    s: int

    def __init__(self, s: int) -> None:
        self.s = s

    def area(self) -> int:
        return self.s * self.s

class Rect(Shape):
    a: int
    b: int

    def __init__(self, a: int, b: int) -> None:
        self.a = a
        self.b = b

    def area(self) -> int:
        return self.a * self.b

class Tri(Shape):
    a: int
    b: int

    def __init__(self, a: int, b: int) -> None:
        self.a = a
        self.b = b

    def area(self) -> int:
        return self.a * self.b // 2

class Node:
    l: Node | None
    r: Node | None

    def __init__(self, l: Node | None, r: Node | None) -> None:
        self.l = l
        self.r = r

def build(d: int) -> Node:
    if d == 0:
        return Node(None, None)
    return Node(build(d - 1), build(d - 1))

def count(n: Node | None) -> int:
    if n is None:
        return 0
    return 1 + count(n.l) + count(n.r)

def apply(f: (int) -> int, x: int) -> int:
    return f(x)

def inc(x: int) -> int:
    return x + 1

def gen(n: int) -> Iterator[int]:
    i: int = 0
    while i < n:
        yield i
        i = i + 1

def risky(i: int) -> int:
    if i % 3 == 0:
        raise ValueError("x")
    return i

def lcg(seed: int) -> int:
    return (seed * 1103515245 + 12345) % 2147483648

def bench() -> None:
    S: int = scale()
    t: float = now_ms()
    s: int = 0
    for i in range(5000000 * S):
        s = s + (i * i) % 7 + (i ^ (i >> 3))
    report("loop_arith_5M", t, s)

    t = now_ms()
    fibt: int = 0
    for r0 in range(S):
        fibt = fibt + fib(30 + r0 % 3)
    report("fib_rec_30_32", t, fibt)

    t = now_ms()
    tot: int = 0
    n: int = 1
    while n <= 300000 * S:
        x: int = n
        steps: int = 0
        while x != 1:
            if x % 2 == 0:
                x = x // 2
            else:
                x = 3 * x + 1
            steps = steps + 1
        tot = tot + steps
        n = n + 1
    report("collatz_300k", t, tot)

    t = now_ms()
    sn: int = 4000000 * S
    sieve: list[bool] = [True] * sn
    sieve[0] = False
    sieve[1] = False
    i: int = 2
    while i * i < sn:
        if sieve[i]:
            j: int = i * i
            while j < sn:
                sieve[j] = False
                j = j + i
        i = i + 1
    primes: int = 0
    for v in sieve:
        if v:
            primes = primes + 1
    report("sieve_4M", t, primes)

    t = now_ms()
    m: int = 100
    a: list[list[float]] = []
    b: list[list[float]] = []
    c: list[list[float]] = []
    ii: int = 0
    while ii < m:
        ra: list[float] = []
        rb: list[float] = []
        rc: list[float] = []
        jj: int = 0
        while jj < m:
            ra.append(float((ii * jj) % 7) + 0.5)
            rb.append(float((ii + jj) % 5) - 1.25)
            rc.append(0.0)
            jj = jj + 1
        a.append(ra)
        b.append(rb)
        c.append(rc)
        ii = ii + 1
    tr: float = 0.0
    for rr in range(S):
        a[0][0] = float(rr) + 0.5
        i = 0
        while i < m:
            j2: int = 0
            while j2 < m:
                acc: float = 0.0
                k: int = 0
                while k < m:
                    acc = acc + a[i][k] * b[k][j2]
                    k = k + 1
                c[i][j2] = acc
                j2 = j2 + 1
            i = i + 1
        tr = 0.0
        i = 0
        while i < m:
            tr = tr + c[i][i]
            i = i + 1
    report("matmul_100", t, int(tr * 1000.0))

    t = now_ms()
    fx: float = 0.0
    fy: float = 1.0
    for q in range(3000000 * S):
        fx = fx * 0.999 + fy * 0.001
        fy = fy * 1.0001 - fx * 0.0001
    report("float_loop_3M", t, int(fx * 1000000.0) + int(fy * 1000000.0))

    t = now_ms()
    d: dict[int, int] = {}
    for q in range(1500000 * S):
        key: int = (q * 7919) % 100003
        if key in d:
            d[key] = d[key] + 1
        else:
            d[key] = 1
    report("dict_int_1.5M", t, len(d) * 1000 + d[5])

    t = now_ms()
    ds: dict[str, int] = {}
    for q in range(500000 * S):
        sk: str = "k" + str(q % 50000)
        if sk in ds:
            ds[sk] = ds[sk] + q
        else:
            ds[sk] = q
    report("dict_str_500k", t, len(ds) * 7 + ds["k123"])

    t = now_ms()
    xs: list[int] = []
    for q in range(2000000 * S):
        xs.append(q * 3)
    lt: int = 0
    for v2 in xs:
        lt = lt + v2
    while len(xs) > 1000000 * S:
        xs.pop()
    report("list_append_sum_pop_2M", t, lt + len(xs))

    t = now_ms()
    parts: list[str] = []
    for q in range(300000 * S):
        parts.append(str(q))
    joined: str = ",".join(parts)
    report("str_build_join_300k", t, len(joined))

    t = now_ms()
    cn: Counter = Counter()
    for q in range(3000000 * S):
        cn.add(q)
    report("method_calls_3M", t, cn.get())

    t = now_ms()
    shapes: list[Shape] = []
    for q in range(1000):
        if q % 3 == 0:
            shapes.append(Sq(q))
        elif q % 3 == 1:
            shapes.append(Rect(q, 2))
        else:
            shapes.append(Tri(q, 4))
    vt: int = 0
    for r in range(2000 * S):
        for sh in shapes:
            vt = vt + sh.area()
    report("virtual_dispatch_2M", t, vt)

    t = now_ms()
    ft: int = 0
    for q in range(2000000 * S):
        ft = ft + apply(inc, q)
    report("func_value_calls_2M", t, ft)

    t = now_ms()
    gt: int = 0
    for v3 in gen(1500000 * S):
        gt = gt + v3
    report("generator_1.5M", t, gt)

    t = now_ms()
    caught: int = 0
    et: int = 0
    for q in range(200000 * S):
        try:
            et = et + risky(q)
        except ValueError as err:
            caught = caught + 1
    report("exceptions_200k", t, caught * 1000003 + et)

    t = now_ms()
    at: int = 0
    for r in range(4 * S):
        at = at + count(build(17))
    report("alloc_tree_17x4", t, at)

    t = now_ms()
    seed: int = 7
    arr: list[int] = []
    for q in range(500000 * S):
        seed = lcg(seed)
        arr.append(seed)
    arr.sort()
    report("sort_500k", t, arr[0] + arr[250000 * S] + arr[500000 * S - 1])

    t = now_ms()
    ichk: int = 0
    for rr2 in range(S):
        seed = 11 + rr2
        small: list[int] = []
        for q in range(3000):
            seed = lcg(seed)
            small.append(seed % 10000)
        for q in range(1, len(small)):
            sv: int = small[q]
            sj: int = q - 1
            while sj >= 0 and small[sj] > sv:
                small[sj + 1] = small[sj]
                sj = sj - 1
            small[sj + 1] = sv
        ichk = small[0] + small[1500] + small[2999]
    report("insertion_sort_3k", t, ichk)

    t = now_ms()
    text: str = "abcab" * (200000 * S)
    ac: int = 0
    for q in range(len(text)):
        if text[q] == "a":
            ac = ac + 1
    report("str_index_loop_1M", t, ac)

bench()

# Bacon-Rajan duraklama ölçümü (tek iş parçacığı): her döngü yinelemesinin süresi; en uzun yineleme ≈ en uzun toplama duraklaması.
import nox.time
import nox.os

class N:
    other: N | None
    peer: N | None
    pad: int
    def __init__(self: N, pad: int) -> None:
        self.other = None
        self.peer = None
        self.pad = pad

def now_us() -> int:
    return nox.time.monotonic_ns() // 1000

def run(live: int, iters: int) -> None:
    # canlı döngüsel graf: halka (her düğüm sonrakini ve öncekini tutar)
    ring: list[N] = []
    i: int = 0
    while i < live:
        ring.append(N(i))
        i = i + 1
    i = 0
    while i < live:
        ring[i].other = ring[(i + 1) % live]
        ring[i].peer = ring[(i + live - 1) % live]
        i = i + 1
    # çöp döngüler üret (a<->b), halkaya hiç dokunmadan; her yineleme süresini ölç
    worst: int = 0
    over1ms: int = 0
    total: int = 0
    j: int = 0
    while j < iters:
        t0: int = now_us()
        a: N = N(j)
        b: N = N(j)
        a.other = b
        b.other = a
        # halkadan bir düğümü geçici olarak tutup bırak: olası-kök kaydı (canlı grafa kök)
        x: N = ring[j % live]
        t1: int = now_us()
        d: int = t1 - t0
        total = total + d
        if d > worst:
            worst = d
        if d > 1000:
            over1ms = over1ms + 1
        j = j + 1
    print("live", live, "iters", iters, "worst_us", worst, "over1ms", over1ms, "avg_ns", total * 1000 // iters)

run(0 + 1000, 300000)
run(50000, 300000)
run(500000, 300000)

# Stdlib mikro-benchmark paketi, 2. küme (2.2 aşama 2): koleksiyonlar, ek özetler, bigint, toml, fnmatch, unicode, zaman, fs. Satır biçimi stdlib_perf.nox ile aynı: "ad<TAB>ms<TAB>sağlama".
# stdlib_perf2.py AYNI işi Python standart kütüphanesiyle yapar ve AYNI sağlama toplamını üretmelidir. Çalıştır: python3 benchmarks/stdlib_perf/run.py --suite 2
import nox.time
import nox.crypto
import nox.bigint
import nox.toml
import nox.fnmatch
import nox.unicode
import nox.fs
from nox.collections import Deque, Counter, Heap, LRUCache
from nox.bigint import BigInt
from nox.toml import TomlValue

def now_ms() -> float:
    return float(nox.time.monotonic_ns()) / 1000000.0

def report(name: str, t0: float, check: int) -> None:
    print(name + "\t" + str(now_ms() - t0) + "\t" + str(check))

def bench() -> None:
    # ---------------- koleksiyonlar ----------------
    t: float = now_ms()
    dq: Deque[int] = Deque[int]()
    i: int = 0
    while i < 1000000:
        dq.push_back(i)
        i = i + 1
    s: int = 0
    while not dq.is_empty():
        s = s + dq.pop_front()
    report("deque_push_pop_1M", t, s)

    t = now_ms()
    h: Heap[int] = Heap[int]()
    i = 0
    while i < 200000:
        h.push((i * 7919) % 100003)
        i = i + 1
    s = 0
    while not h.is_empty():
        s = s + h.pop_min() % 7
    report("heap_push_pop_200k", t, s)

    t = now_ms()
    c: Counter[int] = Counter[int]()
    i = 0
    while i < 500000:
        c.add((i * 31) % 1009)
        i = i + 1
    report("counter_add_500k", t, c.count(5) * 1000 + c.size())

    t = now_ms()
    lru: LRUCache[int, int] = LRUCache[int, int](1000)
    i = 0
    s = 0
    while i < 300000:
        k: int = (i * 17) % 1500
        if i % 4 != 0:
            k = i % 300
        if lru.contains(k):
            s = s + lru.get(k)
        else:
            lru.put(k, i)
        i = i + 1
    report("lru_get_put_300k", t, s)

    # ---------------- özetler ----------------
    data: str = ""
    j: int = 0
    while j < 4096:
        data = data + "abcdefghijklmnop"
        j = j + 1
    t = now_ms()
    s = 0
    i = 0
    while i < 16:
        s = s + len(nox.crypto.sha512(data))
        i = i + 1
    report("sha512_64KiB_x16", t, s)

    t = now_ms()
    s = 0
    i = 0
    while i < 16:
        s = s + len(nox.crypto.sha1(data)) + len(nox.crypto.md5(data))
        i = i + 1
    report("sha1_md5_64KiB_x16", t, s)

    t = now_ms()
    s = 0
    i = 0
    while i < 20000:
        s = s + len(nox.crypto.hmac_sha256("key" + str(i % 10), "message-" + str(i)))
        i = i + 1
    report("hmac_sha256_20k", t, s)

    # ---------------- bigint ----------------
    t = now_ms()
    f: BigInt = nox.bigint.factorial(3000)
    txt: str = f.to_str()
    report("bigint_factorial_3000_str", t, len(txt))

    # ---------------- toml ----------------
    doc: str = ""
    i = 0
    while i < 3000:
        doc = doc + "[t" + str(i) + "]\nname = \"item" + str(i) + "\"\nvalue = " + str(i) + "\nflag = true\n"
        i = i + 1
    t = now_ms()
    root: TomlValue = nox.toml.parse(doc)
    report("toml_parse_3000_tables", t, len(doc))

    # ---------------- fnmatch ----------------
    t = now_ms()
    s = 0
    i = 0
    while i < 200000:
        if nox.fnmatch.fnmatch("file" + str(i) + ".txt", "file*9.t?t"):
            s = s + 1
        i = i + 1
    report("fnmatch_200k", t, s)

    # ---------------- unicode ----------------
    uni: str = "café résumé naïve " 
    big: str = ""
    j = 0
    while j < 2000:
        big = big + uni
        j = j + 1
    t = now_ms()
    s = 0
    i = 0
    while i < 20:
        s = s + len(nox.unicode.normalize(big, "NFC"))
        i = i + 1
    report("unicode_nfc_x20", t, s)

    # ---------------- zaman ----------------
    t = now_ms()
    s = 0
    i = 0
    while i < 100000:
        s = s + len(nox.time.from_epoch_ms(1700000000000 + i * 86400000).to_str())
        i = i + 1
    report("time_from_epoch_to_str_100k", t, s)

    # ---------------- fs ----------------
    body: str = ""
    j = 0
    while j < 65536:
        body = body + "0123456789abcdef"
        j = j + 1
    path: str = "/tmp/nox_stdlib_perf2.bin"
    t = now_ms()
    s = 0
    i = 0
    while i < 8:
        nox.fs.write_string(path, body)
        s = s + len(nox.fs.read_to_string(path))
        i = i + 1
    report("fs_write_read_1MiB_x8", t, s)

bench()

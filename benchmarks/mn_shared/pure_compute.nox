# 9.0.1 kontrol: modül düzeyinde DEĞİŞKEN durum YOK -> bugün de çok işçide ölçeklenir. Paylaşılan-durum sürümüyle aynı iş yükü.
async def work(id: int, out: Channel[int]) -> None:
    acc: int = 0
    i: int = 0
    while i < 20000000:
        acc = (acc * 31 + i + id) % 1000003
        i = i + 1
    await out.send(acc)

async def main_task() -> None:
    out: Channel[int] = Channel[int](64)
    k: int = 0
    while k < 32:
        t: Task[None] = spawn work(k, out)
        k = k + 1
    total: int = 0
    k = 0
    while k < 32:
        total = total + await out.recv()
        k = k + 1
    print(total)

mt: Task[None] = spawn main_task()
await mt

# 9.0.1: modül düzeyinde paylaşılan DEĞİŞKEN sözlük + liste + sınıf. Her görev KENDİ anahtarlarına yazar (sonuç belirleyici),
# ama kapsayıcılar görevler arasında ORTAKTIR. Bugün (v2.1.117) bu program tek işçiye sabitlenir.
counts: dict[int, int] = {}
log: list[int] = []

class Stats:
    hits: int
    def __init__(self, hits: int) -> None:
        self.hits = hits

stats: Stats = Stats(0)

async def work(id: int, out: Channel[int]) -> None:
    acc: int = 0
    i: int = 0
    while i < 20000000:
        acc = (acc * 31 + i + id) % 1000003
        if i % 2000 == 0:
            counts[id * 1000 + (i // 2000) % 1000] = acc
        i = i + 1
    log.append(acc)
    stats.hits = stats.hits + 1
    await out.send(acc)

async def main_task() -> None:
    out: Channel[int] = Channel[int](64)
    k: int = 0
    while k < 32:
        t: Task[None] = spawn work(k, out)
        k = k + 1
    total: int = 0
    k = 0
    while k < 32:
        total = total + await out.recv()
        k = k + 1
    print(total)
    print(len(counts))
    print(len(log))
    print(stats.hits)

mt: Task[None] = spawn main_task()
await mt
